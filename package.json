{
  "name": "profesionales-ecuador",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "prestart": "prisma generate",
    "start": "tsx src/server.ts",
    "build": "prisma generate && tsc",
    "prisma:migrate": "prisma db push --accept-data-loss",
    "db:push": "prisma db push --accept-data-loss",
    "db:baseline": "tsx prisma/baseline.ts",
    "db:setup": "prisma db push --accept-data-loss && prisma generate",
    "db:seed:test": "tsx prisma/seed-test-professional.ts",
    "seed:universities": "tsx prisma/seed-full-universities.ts",
    "backfill:professional-slugs": "node dist/scripts/backfill-professional-slugs.js",
    "test:auth-sessions": "node --import tsx --test src/tests/auth-sessions.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/socket.io": "^3.0.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ec-sri-invoice-signer": "^1.7.5",
    "ejs": "^6.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^5.8.0",
    "googleapis": "^174.0.1",
    "helmet": "^8.2.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.4",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "resend": "^6.14.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
