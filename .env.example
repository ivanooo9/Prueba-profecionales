NODE_ENV=production
PORT=3000

# Cross-origin browser access; exact origins only. Comma-separated list is optional.
FRONTEND_URL=https://prueba-profecionales.vercel.app
# FRONTEND_URLS=https://otro-frontend.example.com,https://admin.example.com

# Configure to match the hosting provider's trusted reverse-proxy hop count.
TRUST_PROXY_HOPS=1

# Use "none" only for cross-site cookie deployments over HTTPS; default is "lax".
AUTH_COOKIE_SAME_SITE=lax

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/profesionales_ecuador?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Optional startup behavior
PRISMA_DB_PUSH=false

# Optional explicit initial admin provisioning (npm run provision:admin)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Profesionales Ecuador
BASE_URL=http://localhost:3000

# Storage paths (configure persistent volume in containerized deployments)
LEGAL_STORAGE_DIR=/app/storage/legal
ARCHITECTURE_STORAGE_DIR=/app/storage/architecture

# Google OAuth / Gmail API (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=

# Redis cache (optional; leave unset to disable cache)
REDIS_URL=redis://localhost:6379