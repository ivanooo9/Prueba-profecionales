  <script>
    async function loadSpeakerQaList() {
      try {
        const conversatorioId = '<%= conversatorio.id %>';
        const speakerId = '<%= speaker.id %>';
        const res = await fetch(`/api/conversatorios/${conversatorioId}/questions/public?speakerId=${speakerId}`);
        const data = await res.json();
        const container = document.getElementById('speaker-qa-list');
        if (!container) return;

        if (data.success && data.qas && data.qas.length > 0) {
          container.innerHTML = data.qas.map(qa => `
            <div class="bg-white border border-slate-200/80 rounded-3xl p-5 md:p-6 flex flex-col gap-4 shadow-sm">
              <!-- Pregunta -->
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-xl bg-[#0252A4]/10 text-[#0252A4] flex items-center justify-center font-black text-xs shrink-0 mt-0.5">
                  Q
                </div>
                <div class="flex flex-col gap-1 min-w-0">
                  <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Pregunta de la comunidad</span>
                  <h4 class="text-xs md:text-sm font-extrabold text-slate-900 leading-snug">${qa.pregunta}</h4>
                </div>
              </div>

              <!-- Respuesta Oficial -->
              ${qa.respuesta ? `
                <div class="bg-emerald-50/60 border border-emerald-100 rounded-2xl p-4 md:p-5 flex items-start gap-3 shadow-inner ml-4 md:ml-6">
                  <div class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-black text-xs shrink-0 mt-0.5">
                    <i class="fa-solid fa-check"></i>
                  </div>
                  <div class="flex flex-col gap-1 min-w-0">
                    <span class="text-[10px] font-black text-emerald-700 uppercase tracking-widest">Respuesta Oficial del Ponente / Administración</span>
                    <p class="text-xs text-slate-700 font-medium leading-relaxed whitespace-pre-wrap">${qa.respuesta}</p>
                  </div>
                </div>
              ` : `
                <div class="text-[11px] text-amber-600 font-bold bg-amber-50 border border-amber-100 rounded-xl p-3 ml-4 md:ml-6 flex items-center gap-2">
                  <i class="fa-regular fa-clock animate-pulse"></i> Respuesta oficial en proceso de redacción...
                </div>
              `}
            </div>
          `).join('');
        } else {
          container.innerHTML = `
            <div class="p-8 text-center bg-white rounded-3xl border border-slate-200/60 text-slate-400 text-xs font-semibold shadow-xs">
              No hay preguntas respondidas publicadas aún para esta ponencia.
            </div>
          `;
        }
      } catch (err) {
        console.error("Error cargando Q&A:", err);
      }
    }

    async function submitSpeakerQaQuestion(e) {
      e.preventDefault();
      const btn = document.getElementById('speaker-qa-btn');
      const msgDiv = document.getElementById('speaker-qa-msg');
      const input = document.getElementById('speaker-qa-input');
      const conversatorioId = document.getElementById('speaker-qa-conversatorio-id').value;
      const speakerId = document.getElementById('speaker-qa-speaker-id').value;

      if (!input.value.trim() || input.value.trim().length < 5) {
        alert('Por favor escribe una pregunta de al menos 5 caracteres.');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Enviando...`;

      try {
        const res = await fetch(`/api/conversatorios/${conversatorioId}/questions`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pregunta: input.value.trim(), speakerId })
        });
        const data = await res.json();

        msgDiv.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'bg-rose-100', 'text-rose-800');
        if (data.success) {
          msgDiv.classList.add('bg-emerald-100', 'text-emerald-800');
          msgDiv.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600 mr-1.5"></i> ${data.message}`;
          input.value = '';
        } else {
          msgDiv.classList.add('bg-rose-100', 'text-rose-800');
          msgDiv.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-rose-600 mr-1.5"></i> ${data.error || 'No se pudo enviar la pregunta.'}`;
        }
      } catch (err) {
        msgDiv.classList.remove('hidden');
        msgDiv.classList.add('bg-rose-100', 'text-rose-800');
        msgDiv.innerHTML = `Error de red al enviar la pregunta.`;
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-paper-plane text-xs"></i> Enviar Pregunta`;
      }
    }

    document.addEventListener("DOMContentLoaded", function() {
      loadSpeakerQaList();
    });
  </script>

