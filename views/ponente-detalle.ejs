<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 flex flex-col min-h-screen text-slate-800 antialiased font-sans">
  <%- include('partials/header') %>

  <!-- Main Content Wrapper -->
  <main class="flex-grow max-w-5xl mx-auto w-full px-6 md:px-12 py-12 flex flex-col gap-8">
    <% 
      const isOnline = !conversatorio.ciudad || 
                       conversatorio.ciudad.toLowerCase().trim() === 'online' ||
                       conversatorio.ciudad.toLowerCase().includes('online') ||
                       conversatorio.ciudad.toLowerCase().includes('virtual') ||
                       (conversatorio.direccion && conversatorio.direccion.toLowerCase().includes('online')) ||
                       (conversatorio.direccion && conversatorio.direccion.toLowerCase().includes('virtual')) ||
                       (conversatorio.slogan && conversatorio.slogan.toLowerCase().includes('online')) ||
                       (conversatorio.slogan && conversatorio.slogan.toLowerCase().includes('virtual'));
      const isPast = conversatorio.estado === 'FINALIZADO' || new Date(conversatorio.fechaFin || conversatorio.fechaInicio) < new Date();
      const hasVideo = !!speaker.videoUrl;
      const isAccessGranted = conversatorio.gratuito || speaker.gratuita || hasCertificate || (typeof isEnrolled !== 'undefined' && isEnrolled);
      const supportResources = Array.isArray(speaker.resources) ? speaker.resources : [];
      const getDownloadUrl = function(url, name) {
        const value = String(url || '');
        if (!value || value.startsWith('data:') || !value.startsWith('http')) {
          return value;
        }
        const safeName = (name || 'Material_de_Apoyo').replace(/[^a-zA-Z0-9]/g, '_');
        return `/download/file?url=${encodeURIComponent(value)}&name=${encodeURIComponent(safeName)}`;
      };
    %>

    <!-- Back Button -->
    <div class="flex justify-start">
      <a href="/conversatorios/<%= conversatorio.slug || conversatorio.id %>" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-900 transition text-xs font-extrabold">
        <i class="fa-solid fa-arrow-left"></i> Volver al Conversatorio
      </a>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start mt-4">
      
      <!-- Left Column: Portrait Card -->
      <div class="md:col-span-4 flex flex-col items-center">
        <div class="w-full max-w-[280px] aspect-[4/5] rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/60 shadow-xl relative group">
          <img src="<%= speaker.foto || 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=400' %>" class="w-full h-full object-cover transition duration-300 group-hover:scale-103" alt="<%= speaker.nombre %>">
        </div>
        
        <!-- Social Networks Links -->
        <% if (speaker.redes && (speaker.redes.facebook || speaker.redes.twitter || speaker.redes.linkedin)) { %>
          <div class="flex justify-center gap-4 mt-6">
            <% if (speaker.redes.facebook) { %>
              <a href="<%= speaker.redes.facebook %>" target="_blank" class="w-10 h-10 rounded-full bg-white border border-slate-100 text-slate-400 hover:text-blue-600 hover:border-blue-100 hover:shadow-sm flex items-center justify-center transition" title="Facebook">
                <i class="fa-brands fa-facebook-f text-sm"></i>
              </a>
            <% } %>
            <% if (speaker.redes.twitter) { %>
              <a href="<%= speaker.redes.twitter %>" target="_blank" class="w-10 h-10 rounded-full bg-white border border-slate-100 text-slate-400 hover:text-sky-500 hover:border-sky-100 hover:shadow-sm flex items-center justify-center transition" title="Twitter">
                <i class="fa-brands fa-twitter text-sm"></i>
              </a>
            <% } %>
            <% if (speaker.redes.linkedin) { %>
              <a href="<%= speaker.redes.linkedin %>" target="_blank" class="w-10 h-10 rounded-full bg-white border border-slate-100 text-slate-400 hover:text-blue-700 hover:border-blue-100 hover:shadow-sm flex items-center justify-center transition" title="LinkedIn">
                <i class="fa-brands fa-linkedin-in text-sm"></i>
              </a>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Right Column: Speaker Info -->
      <div class="md:col-span-8 flex flex-col gap-6 text-left">
        
        <!-- Speaker Info Header -->
        <div>
          <span class="bg-emerald-50 text-emerald-700 text-[9px] font-black px-3.5 py-1.5 rounded-full uppercase tracking-wider border border-emerald-100 shadow-sm inline-block"><%= speaker.profesion || 'Experto Invitado' %></span>
          <h1 class="text-3xl md:text-4xl font-black text-slate-900 leading-snug uppercase tracking-tight mt-2"><%= speaker.nombre %></h1>
          <% if (speaker.slogan) { %>
            <p class="text-slate-450 text-xs font-bold mt-1 uppercase tracking-wide leading-none"><%= speaker.slogan %></p>
          <% } %>
        </div>

        <!-- Ponencia Details Card (Clean Static Card matching Image 1) -->
        <div class="flex flex-col gap-2">
          <span class="text-[10px] font-black text-slate-450 uppercase tracking-widest">Información de Ponencia</span>
          
          <div class="bg-slate-50 border border-slate-100 rounded-3xl p-5 shadow-sm flex items-center justify-between gap-4">
            <div class="flex items-center gap-3.5 min-w-0">
              <!-- Circular Check Badge -->
              <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-500 border border-emerald-100/60 flex items-center justify-center flex-shrink-0 shadow-inner">
                <i class="fa-solid fa-check text-sm font-black"></i>
              </div>
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="text-[9px] font-black text-emerald-600 uppercase tracking-widest font-sans"><%= isOnline ? 'Ponencia Online' : 'Ponencia Magistral' %></span>
                <h3 class="text-sm font-black text-slate-800 leading-snug uppercase tracking-tight truncate"><%= speaker.tema || 'Tema por definir' %></h3>
              </div>
            </div>
            
            <div class="flex items-center gap-1 bg-emerald-50 text-emerald-700 text-[9px] font-black px-3.5 py-1.5 rounded-full border border-emerald-100/50 uppercase tracking-wider font-sans flex-shrink-0">
              <i class="fa-regular fa-clock text-[9px] text-emerald-600 mr-0.5"></i>
              <span><%= speaker.horario || 'Por definir' %></span>
            </div>
          </div>
        </div>

        <!-- Biografía Section -->
        <div class="flex flex-col gap-2 mt-2">
          <span class="text-[10px] font-black text-slate-450 uppercase tracking-widest">Biografía</span>
          <p class="text-slate-650 text-sm leading-relaxed font-sans font-medium whitespace-pre-wrap"><%= speaker.descripcion || 'Información profesional próximamente.' %></p>
        </div>

        <!-- Especialidad Section -->
        <div class="flex flex-col gap-2">
          <span class="text-[10px] font-black text-slate-450 uppercase tracking-widest">Especialidades</span>
          <div class="flex flex-wrap gap-2 mt-1">
            <span class="bg-slate-100 text-slate-700 text-[10px] font-extrabold px-3 py-1.5 rounded-full border border-slate-200/60 uppercase shadow-inner"><%= speaker.profesion || 'Experto Invitado' %></span>
          </div>
        </div>

      </div>

    </div>

  </main>

  <% if (supportResources.length > 0 && isAccessGranted) { %>
    <section class="w-full bg-white py-14 px-6 md:px-12 border-t border-slate-100">
      <div class="max-w-5xl mx-auto w-full flex flex-col gap-6">
        <div class="flex items-end justify-between gap-4">
          <div class="flex flex-col gap-2">
            <span class="text-[#0252A4] text-[10px] font-black uppercase tracking-[0.22em]">Recursos</span>
            <h2 class="text-2xl md:text-3xl font-black text-slate-950 uppercase tracking-tight">Contenido de apoyo</h2>
            <p class="text-slate-500 text-sm font-semibold leading-relaxed">Material complementario de esta ponencia.</p>
          </div>
          <div class="hidden md:flex w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 items-center justify-center">
            <i class="fa-solid fa-folder-open text-xl"></i>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% supportResources.forEach(function(resource) { %>
            <% const resourceType = (resource.tipo || 'link').toLowerCase(); %>
            <% const isLinkResource = resourceType === 'link'; %>
            <a href="<%= isLinkResource ? resource.url : getDownloadUrl(resource.url, resource.nombre) %>" <%- isLinkResource ? 'target="_blank" rel="noopener"' : 'download' %> class="group bg-slate-50/80 hover:bg-white border border-slate-100 hover:border-emerald-200 rounded-3xl p-5 shadow-sm hover:shadow-md transition flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-white group-hover:bg-emerald-50 border border-slate-100 text-emerald-600 flex items-center justify-center flex-shrink-0 transition">
                <i class="fa-solid <%= isLinkResource ? 'fa-link' : 'fa-download' %> text-lg"></i>
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-black text-slate-900 truncate"><%= resource.nombre %></h3>
                <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mt-1"><%= resourceType %></p>
              </div>
              <i class="fa-solid <%= isLinkResource ? 'fa-arrow-up-right-from-square' : 'fa-download' %> text-slate-300 group-hover:text-emerald-600 transition"></i>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Dark Multimedia Video Section at the Bottom (Always Visible if hasVideo) Mockup 2 -->
  <% if (hasVideo) { %>
    <section class="w-full bg-[#090E1A] text-white py-20 border-t border-slate-900 shadow-inner">
      <div class="max-w-5xl mx-auto w-full px-6 md:px-12 flex flex-col items-center gap-8">
        
        <div class="flex flex-col items-center text-center gap-1.5">
          <span class="border border-emerald-500/30 text-emerald-400 bg-emerald-500/10 rounded-full px-5 py-1.5 text-[10px] uppercase font-black tracking-widest shadow-sm inline-block leading-none">MULTIMEDIA</span>
          <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tight mt-4 font-sans leading-tight">
            <% if (isPast) { %>
              <%= isOnline ? 'GRABACIÓN DE LA' : 'REVIVE LA' %> <span class="text-emerald-400"><%= isOnline ? 'PONENCIA' : 'EXPERIENCIA' %></span>
            <% } else { %>
              TRANSMISIÓN EN <span class="text-emerald-400">VIVO</span>
            <% } %>
          </h2>
        </div>

        <% if ((conversatorio.estado === 'ACTIVO' || conversatorio.estado === 'FINALIZADO') && !isAccessGranted) { %>
          <!-- Locked Screen -->
          <div class="w-full rounded-[24px] md:rounded-[32px] overflow-hidden bg-slate-950 border border-slate-900/60 flex flex-col items-center justify-center text-center relative z-0 py-8 px-4 sm:px-6 md:p-8 md:aspect-video" style="min-height: 380px;">
            <div class="absolute inset-0 bg-cover bg-center opacity-10 filter blur-sm" style="background-image: url('<%= speaker.foto || '' %>')"></div>
            
            <!-- Lock Badge -->
            <div class="w-16 h-16 rounded-full bg-slate-900/90 border border-slate-800 text-amber-400 flex items-center justify-center text-2xl shadow-xl relative mb-6">
              <i class="fa-solid fa-lock"></i>
            </div>
            
            <h3 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight relative max-w-lg font-sans">
              ACCESO A LA TRANSMISIÓN EXCLUSIVO PARA INSCRITOS
            </h3>
            
            <p class="text-slate-400 text-xs font-semibold mt-2 max-w-md relative font-sans leading-relaxed">
              Inscríbete para acceder al enlace de transmisión en vivo de esta ponencia y obtener tu certificado.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 mt-8 relative w-full max-w-sm justify-center">
              <% if (!locals.user) { %>
                <button type="button" onclick="openLoginModal()" class="w-full sm:w-auto bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold px-6 py-3.5 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-lg cursor-pointer font-sans">
                  <i class="fa-solid fa-right-to-bracket text-xs"></i>
                  <span>Iniciar Sesión</span>
                </button>
              <% } else { %>
                <button type="button" onclick="openPaymentModal()" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold px-6 py-3.5 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-lg cursor-pointer font-sans">
                  <i class="fa-solid fa-ticket text-xs"></i>
                  <span>Inscribirme Ahora</span>
                </button>
              <% } %>
            </div>
          </div>

        <% } else { %>
          <!-- Full Player Grid -->
          <div class="w-full flex flex-col gap-4">
            <div class="w-full aspect-video rounded-[24px] md:rounded-[32px] overflow-hidden bg-slate-950 border border-slate-800/80 shadow-2xl relative group">
              <% if (speaker.videoUrl || speaker.bunnyVideoId) { %>
                <%- include('partials/custom-video-player', {
                  sourceType: 'conversatorio-speaker',
                  sourceId: speaker.id,
                  title: speaker.tema || speaker.nombre,
                  autoplay: false
                }) %>
              <% } else { %>
                <!-- Custom Professional Ecuador Video Player UI Mockup matching Image 2 -->
                <div class="w-full h-full relative flex items-center justify-center bg-slate-950 overflow-hidden">
                  <!-- Video background overlay image -->
                  <div class="absolute inset-0 bg-cover bg-center opacity-30 filter blur-[2px] transition duration-500 group-hover:scale-105" style="background-image: url('<%= speaker.foto || 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=800' %>')"></div>
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-slate-950/60"></div>
                  
                  <!-- Watermark Logo Top Left -->
                  <div class="absolute top-6 left-6 flex items-center gap-3 z-10">
                    <div class="w-10 h-10 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white text-xs font-black">
                      P<span class="text-emerald-400">.ec</span>
                    </div>
                    <div class="flex flex-col text-left">
                      <span class="text-[9px] font-black text-white/80 uppercase tracking-widest leading-tight"><%= conversatorio.titulo %></span>
                      <span class="text-[8px] font-bold text-emerald-400 uppercase tracking-wider">Reproductor Oficial</span>
                    </div>
                  </div>

                  <!-- Center Play Button with pulse glow -->
                  <button type="button" onclick="alert('Iniciando reproductor multimedia...')" class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center text-2xl md:text-3xl shadow-2xl transition duration-300 transform group-hover:scale-110 cursor-pointer relative z-10 border border-blue-400/40">
                    <i class="fa-solid fa-play ml-1"></i>
                  </button>

                  <!-- Bottom Overlay Title Bar -->
                  <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between gap-4 z-10 text-left border-t border-white/10 pt-4 backdrop-blur-xs">
                    <div class="flex flex-col gap-0.5">
                      <span class="text-[9px] font-extrabold text-emerald-400 uppercase tracking-widest"><%= speaker.nombre %></span>
                      <h4 class="text-sm md:text-base font-black text-white uppercase tracking-tight"><%= speaker.tema || 'Ponencia Principal' %></h4>
                    </div>
                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider bg-slate-900/80 px-3 py-1.5 rounded-full border border-white/10">Reproductor Profesionales Ecuador</span>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

      </div>
    </section>
  <% } %>

  <!-- Control y Check de Asistencia de la Ponencia (Fondo Blanco) -->
  <% if (locals.user) { %>
    <section class="w-full bg-white py-12 px-6 md:px-12 flex justify-center border-t border-b border-slate-100" id="section-registro-asistencia">
      <div class="max-w-5xl w-full">
        <div class="bg-slate-50 border border-slate-200/80 rounded-3xl p-6 md:p-8 text-slate-800 shadow-sm flex flex-col gap-5" id="speaker-completion-box">
          <% const reqMinutes = (typeof requiredMinutes !== 'undefined' && requiredMinutes !== null) ? requiredMinutes : (conversatorio && conversatorio.usarTiempoMinimoPonencia && conversatorio.tiempoMinimoPonenciaMinutos ? conversatorio.tiempoMinimoPonenciaMinutos : ((typeof systemConfig !== 'undefined' && systemConfig && systemConfig.tiempoMinimoPonenciaMinutos !== null && systemConfig.tiempoMinimoPonenciaMinutos !== undefined) ? systemConfig.tiempoMinimoPonenciaMinutos : 3)); %>
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200/60 pb-5">
            <div class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs font-black text-emerald-600 uppercase tracking-widest flex items-center gap-1.5 font-sans">
                  <i class="fa-solid fa-list-check text-emerald-600"></i> REGISTRO DE ASISTENCIA
                </span>
                <% if (!conversatorio.certificadoInmediato) { %>
                  <span class="bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full font-sans">
                    Requerido: <%= conversatorio.porcentajeMinimoCertificado %>%
                  </span>
                <% } else { %>
                  <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full font-sans">
                    Emisión Inmediata
                  </span>
                <% } %>
              </div>
              <h4 class="text-xl font-black text-slate-900 mt-1 font-sans">
                Progreso de Asistencia: <span id="progress-pct-display" class="text-emerald-600"><%= typeof progressPct !== 'undefined' ? progressPct : 0 %>%</span>
              </h4>
              <p class="text-xs text-slate-500 font-semibold font-sans">
                Ponencias completadas: <strong id="completed-count-display" class="text-slate-800"><%= typeof completedCount !== 'undefined' ? completedCount : 0 %></strong> de <strong class="text-slate-800"><%= typeof totalSpeakers !== 'undefined' ? totalSpeakers : 1 %></strong>
              </p>
            </div>

            <!-- Checkbox / Button with 3-minute Countdown -->
            <div class="flex flex-col items-end gap-2" id="completion-btn-container">
              <% const nextSpeakerUrl = (typeof nextSpeaker !== 'undefined' && nextSpeaker) ? `/conversatorios/${conversatorio.slug || conversatorio.id}/ponentes/${nextSpeaker.slug || nextSpeaker.id}` : `/conversatorios/${conversatorio.slug || conversatorio.id}`; %>
              <% if (typeof isAlreadyCompleted !== 'undefined' && isAlreadyCompleted) { %>
                <div class="flex items-center gap-2 flex-wrap">
                  <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3 rounded-2xl text-xs font-black flex items-center gap-2 shadow-sm font-sans">
                    <i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>
                    <span>¡Ponencia Completada!</span>
                  </div>
                  <% if (typeof nextSpeaker !== 'undefined' && nextSpeaker) { %>
                    <a href="<%= nextSpeakerUrl %>" class="bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold px-5 py-3 rounded-2xl text-xs transition flex items-center gap-2 shadow-md cursor-pointer font-sans">
                      <span>Siguiente Ponencia</span>
                      <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                  <% } else { %>
                    <a href="/conversatorios/<%= conversatorio.slug || conversatorio.id %>" class="bg-blue-600 hover:bg-blue-700 text-white font-extrabold px-5 py-3 rounded-2xl text-xs transition flex items-center gap-2 shadow-md cursor-pointer font-sans">
                      <i class="fa-solid fa-flag-checkered text-xs"></i>
                      <span>Volver al Evento</span>
                    </a>
                  <% } %>
                </div>
              <% } else { %>
                <button id="btn-complete-speaker-check" disabled onclick="submitSpeakerCompletionCheck()" class="bg-slate-200/80 text-slate-500 font-black py-3.5 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-sm cursor-not-allowed border border-slate-300/60 opacity-90 font-sans">
                  <i class="fa-solid fa-clock text-amber-500 animate-pulse"></i>
                  <span id="btn-check-timer-label">Permanecer <%= String(reqMinutes).padStart(2, '0') %>:00 min para marcar ponencia</span>
                </button>
              <% } %>
            </div>
          </div>

          <!-- Dynamic Progress Bar -->
          <div class="w-full bg-slate-200/70 rounded-full h-3 overflow-hidden p-0.5 border border-slate-200">
            <div id="progress-bar-fill" class="bg-gradient-to-r from-emerald-500 to-teal-500 h-full rounded-full transition-all duration-700" style="width: <%= typeof progressPct !== 'undefined' ? progressPct : 0 %>%;"></div>
          </div>

          <!-- Certificate Unlocked Banner -->
          <div id="cert-earned-banner" class="<%= (typeof hasCertificate !== 'undefined' && hasCertificate) ? '' : 'hidden' %> bg-emerald-50 border border-emerald-200 rounded-2xl p-4 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl shadow-inner">
                <i class="fa-solid fa-award"></i>
              </div>
              <div>
                <h5 class="text-xs font-black text-emerald-900 uppercase tracking-wider font-sans">¡Certificado Desbloqueado!</h5>
                <p class="text-[11px] text-emerald-700 font-semibold font-sans">Has alcanzado el porcentaje mínimo de asistencia.</p>
              </div>
            </div>
            <% const certTargetUrl = (typeof acquiredCertificateCode !== 'undefined' && acquiredCertificateCode) ? '/certificados/' + acquiredCertificateCode : '/dashboard/cliente?tab=certificates'; %>
            <a id="cert-earned-link" href="<%= certTargetUrl %>" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold px-4 py-2 rounded-xl text-xs transition shadow-sm font-sans flex items-center gap-1.5 whitespace-nowrap">
              <i class="fa-solid fa-award text-xs"></i> Ver Certificado
            </a>
          </div>

        </div>
      </div>
    </section>
  <% } %>

  <!-- Q&A Section: Preguntas y Respuestas Oficiales (Ubicado justo debajo del Registro de Asistencia) -->
  <section class="w-full bg-white py-12 px-6 md:px-12 border-t border-slate-150">
    <div class="max-w-5xl mx-auto w-full flex flex-col gap-8">
      
      <!-- Header Q&A -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 border-b border-slate-100 pb-6">
        <div class="flex flex-col gap-1.5">
          <span class="text-[#0252A4] text-[10px] font-black uppercase tracking-[0.22em]">INTERACTIVA</span>
          <h2 class="text-2xl md:text-3xl font-black text-slate-900 uppercase tracking-tight">Preguntas & Respuestas Oficiales (Q&A)</h2>
          <p class="text-slate-500 text-xs font-semibold">Consultas frecuentes y respuestas verificadas por el equipo organizador y ponentes.</p>
        </div>
        <div class="flex items-center gap-2 bg-slate-100 text-slate-700 px-3.5 py-1.5 rounded-full text-xs font-bold border border-slate-200">
          <i class="fa-solid fa-circle-check text-emerald-500"></i>
          <span>Sección Oficial Verificada</span>
        </div>
      </div>

      <!-- Formulario para enviar preguntas (solo inscritos) -->
      <% if (isAccessGranted) { %>
        <div class="bg-white text-slate-900 rounded-3xl p-6 md:p-8 shadow-sm border border-slate-200/80 flex flex-col gap-4">
          <div class="flex items-center gap-3">
