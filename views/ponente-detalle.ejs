              <input type="file" id="transfer-comprobante" accept="image/*" class="sr-only">
              <div class="h-11 w-11 rounded-full bg-[#0252A4]/10 text-[#0252A4] flex items-center justify-center group-hover:scale-105 transition">
                <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
              </div>
              <div class="flex flex-col gap-0.5">
                <span id="transfer-comprobante-label" class="text-[11px] font-black text-slate-700 uppercase tracking-wide">Haz clic o arrastra tu comprobante aquí</span>
                <span class="text-[9px] text-slate-400 font-semibold">JPG, PNG o captura de pantalla</span>
              </div>
            </label>
            <div id="transfer-comprobante-preview-wrap" class="hidden rounded-2xl border border-slate-150 bg-white p-2">
              <img id="transfer-comprobante-preview" src="" alt="Vista previa del comprobante seleccionado" class="max-h-44 w-full object-contain rounded-xl">
            </div>
            <p class="text-[9px] text-slate-400 font-medium leading-tight">Suba una foto o captura clara del comprobante de transferencia bancaria (obligatorio).</p>
          </div>
        </div>

        <!-- Panel 2: PayPhone (redirect to real gateway) -->
        <div id="panel-payphone" class="flex flex-col gap-4 hidden">
          <p class="text-[10px] font-medium text-slate-500">
            Serás redirigido a la pasarela de pago segura de PayPhone para completar tu pago con tarjeta de crédito/débito.
          </p>
          <button onclick="iniciarPagoPayPhone({ itemType: 'CERTIFICATE', itemId: <%= conversatorio.id %>, baseAmount: Number('<%= modalPrice %>'), hasTax: true, productName: 'Certificado - <%= (conversatorio.titulo || '').replace(/'/g, "\\'") %>' })" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3 rounded-2xl text-xs transition shadow-sm text-center cursor-pointer">
            Pagar con PayPhone
          </button>
        </div>

        <!-- Panel 3: Kushki Card -->
        <div id="panel-kushki" class="flex flex-col gap-4 hidden">
          <div class="bg-red-50/50 border border-red-100/50 rounded-2xl p-4 flex flex-col gap-1 text-slate-700 text-xs font-semibold leading-relaxed">
            <div class="flex items-center gap-2 text-red-600 font-black text-[10px] uppercase tracking-wider mb-0.5">
              <i class="fa-solid fa-shield-halved"></i> Pasarela Segura Kushki
            </div>
            <p class="text-[10px] font-medium text-slate-500">Aceptamos todas las tarjetas de crédito y débito nacionales e internacionales.</p>
          </div>
          
          <div class="flex flex-col gap-1.5">
            <label class="text-[11px] font-black text-slate-500 uppercase">Nombre en la Tarjeta</label>
            <input type="text" id="kushki-name" placeholder="JUAN PEREZ" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-semibold outline-none focus:bg-white focus:border-red-500 transition uppercase font-bold">
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-[11px] font-black text-slate-500 uppercase">Número de Tarjeta</label>
            <div class="relative">
              <i class="fa-solid fa-credit-card absolute right-4 top-3.5 text-slate-400 text-sm"></i>
              <input type="text" id="kushki-number" placeholder="4000 1234 5678 9010" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-red-500 transition tracking-widest">
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label class="text-[11px] font-black text-slate-500 uppercase">Vencimiento</label>
              <input type="text" id="kushki-expiry" placeholder="MM/YY" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-semibold outline-none focus:bg-white focus:border-red-500 transition text-center font-bold">
            </div>
            <div class="flex flex-col gap-1.5">
              <label class="text-[11px] font-black text-slate-500 uppercase">CVV / CVC</label>
              <input type="password" id="kushki-cvv" placeholder="•••" maxlength="4" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-semibold outline-none focus:bg-white focus:border-red-500 transition text-center font-bold">
            </div>
          </div>
        </div>

        <!-- Checkout Action Button -->
        <button onclick="submitCheckoutPayment()" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-4 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer mt-2">
          <span id="checkout-btn-text">Confirmar y Registrar Pago</span>
          <i class="fa-solid fa-circle-check" id="checkout-btn-icon"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Style tag for animations and active modal classes -->
  <style>
    .active-modal-animation {
      animation: modalZoomIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    @keyframes modalZoomIn {
      from {
        transform: scale(0.95);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
    .text-amber-805 {
      color: #92400e;
    }
    .bg-emerald-650 {
      background-color: #059669;
    }
    .bg-emerald-650:hover {
      background-color: #047857;
    }
  </style>
  <%- include('partials/transfer-bank-account-js', { activeBankAccounts }) %>

  <script>
    let checkoutFlowTarget = 'buy';
    let activePaymentMethod = 'transfer';

    document.addEventListener('DOMContentLoaded', function() {
      const select = document.getElementById('transfer-bank-account');
      if (select) {
        select.addEventListener('change', function() { syncTransferBankAccountPaymentFields('transfer-bank-account', 'transfer-bank-account-card', 'transfer-ref', 'transfer-comprobante', 'transfer-comprobante-dropzone'); });
        syncTransferBankAccountPaymentFields('transfer-bank-account', 'transfer-bank-account-card', 'transfer-ref', 'transfer-comprobante', 'transfer-comprobante-dropzone');
      }
    });

    function openAuthModal(target) {
      checkoutFlowTarget = target;
      
      const modal = document.getElementById('auth-modal');
      const container = modal.querySelector('.transform');
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      
      setTimeout(() => {
        container.classList.remove('scale-95', 'opacity-0');
      }, 50);
      
      // Reset errors and inputs
      document.getElementById('auth-error-alert').classList.add('hidden');
      document.getElementById('login-email').value = '';
      document.getElementById('login-password').value = '';
      document.getElementById('register-name').value = '';
      document.getElementById('register-email').value = '';
      document.getElementById('register-password').value = '';
    }

    function closeAuthModal() {
      const modal = document.getElementById('auth-modal');
      const container = modal.querySelector('.active-modal-animation') || modal.querySelector('.transform');
      container.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 200);
    }

    function switchAuthTab(tab) {
      const loginTabBtn = document.getElementById('tab-btn-login');
      const registerTabBtn = document.getElementById('tab-btn-register');
      const loginForm = document.getElementById('form-login-container');
      const registerForm = document.getElementById('form-register-container');
      
      document.getElementById('auth-error-alert').classList.add('hidden');
      
      if (tab === 'login') {
        loginTabBtn.classList.add('border-[#0252A4]', 'text-[#0252A4]');
        loginTabBtn.classList.remove('border-transparent', 'text-slate-400');
        registerTabBtn.classList.remove('border-[#0252A4]', 'text-[#0252A4]');
        registerTabBtn.classList.add('border-transparent', 'text-slate-400');
        loginForm.classList.remove('hidden');
        registerForm.classList.add('hidden');
      } else {
        registerTabBtn.classList.add('border-[#0252A4]', 'text-[#0252A4]');
        registerTabBtn.classList.remove('border-transparent', 'text-slate-400');
        loginTabBtn.classList.remove('border-[#0252A4]', 'text-[#0252A4]');
        loginTabBtn.classList.add('border-transparent', 'text-slate-400');
        registerForm.classList.remove('hidden');
        loginForm.classList.add('hidden');
      }
    }

    async function submitLogin() {
      const email = document.getElementById('login-email').value.trim();
      const password = document.getElementById('login-password').value;
      const errorAlert = document.getElementById('auth-error-alert');
      const errorText = document.getElementById('auth-error-text');
      const btnText = document.getElementById('login-btn-text');
      const btnIcon = document.getElementById('login-btn-icon');

      if (!email || !password) {
        errorText.innerText = "Por favor, complete todos los campos.";
        errorAlert.classList.remove('hidden');
        return;
      }

      errorAlert.classList.add('hidden');
      btnText.innerText = "Iniciando...";
      btnIcon.className = "fa-solid fa-spinner animate-spin";

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const result = await response.json();

        if (result.success) {
          closeAuthModal();
          if (checkoutFlowTarget === 'free') {
            claimFreeCertificate();
          } else if (checkoutFlowTarget === 'buy' || checkoutFlowTarget === 'paid-cert') {
            setTimeout(() => { openPaymentModal(); }, 300);
          } else {
            window.location.reload();
          }
        } else {
          errorText.innerText = result.error || "Credenciales incorrectas.";
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        errorText.innerText = "Error de red al conectar al servidor.";
        errorAlert.classList.remove('hidden');
      } finally {
        btnText.innerText = "Iniciar Sesión";
        btnIcon.className = "fa-solid fa-arrow-right";
      }
    }

    async function submitRegister() {
      const name = document.getElementById('register-name').value.trim();
      const email = document.getElementById('register-email').value.trim();
      const password = document.getElementById('register-password').value;
      const errorAlert = document.getElementById('auth-error-alert');
      const errorText = document.getElementById('auth-error-text');
      const btnText = document.getElementById('register-btn-text');
      const btnIcon = document.getElementById('register-btn-icon');

      if (!name || !email || !password) {
        errorText.innerText = "Por favor, complete todos los campos.";
        errorAlert.classList.remove('hidden');
        return;
      }

      if (password.length < 6) {
        errorText.innerText = "La contraseña debe tener al menos 6 caracteres.";
        errorAlert.classList.remove('hidden');
        return;
      }

      errorAlert.classList.add('hidden');
      btnText.innerText = "Creando Cuenta...";
      btnIcon.className = "fa-solid fa-spinner animate-spin";

      try {
        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ name, email, password })
        });
        const result = await response.json();

        if (result.success) {
          closeAuthModal();
          if (checkoutFlowTarget === 'free') {
            claimFreeCertificate();
          } else if (checkoutFlowTarget === 'buy' || checkoutFlowTarget === 'paid-cert') {
            setTimeout(() => { openPaymentModal(); }, 300);
          } else {
            window.location.reload();
          }
        } else {
          errorText.innerText = result.error || "Error al crear la cuenta.";
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        errorText.innerText = "Error de red al conectar al servidor.";
        errorAlert.classList.remove('hidden');
      } finally {
        btnText.innerText = "Crear Cuenta";
        btnIcon.className = "fa-solid fa-user-plus";
      }
    }

    function openPaymentModal() {
      const modal = document.getElementById('payment-modal');
      const container = modal.querySelector('.transform');
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      
      setTimeout(() => {
        container.classList.remove('scale-95', 'opacity-0');
      }, 50);

      switchPaymentTab('transfer');
      document.getElementById('payment-error-alert').classList.add('hidden');
      document.getElementById('transfer-ref').value = '';
      const payphonePhone = document.getElementById('payphone-phone');
      if (payphonePhone) payphonePhone.value = '';
      document.getElementById('kushki-name').value = '';
      document.getElementById('kushki-number').value = '';
      document.getElementById('kushki-expiry').value = '';
      document.getElementById('kushki-cvv').value = '';
    }

    function closePaymentModal() {
      const modal = document.getElementById('payment-modal');
      const container = modal.querySelector('.active-modal-animation') || modal.querySelector('.transform');
      container.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 200);
    }

    function switchPaymentTab(method) {
      activePaymentMethod = method;
      
      const btnTransfer = document.getElementById('pay-tab-transfer');
      const btnPayphone = document.getElementById('pay-tab-payphone');
      const btnKushki = document.getElementById('pay-tab-kushki');
      
      const panelTransfer = document.getElementById('panel-transfer');
      const panelPayphone = document.getElementById('panel-payphone');
      const panelKushki = document.getElementById('panel-kushki');
      
      const activeBorder = 'border-[#0252A4]';
      const activeText = 'text-[#0252A4]';
      const inactiveBorder = 'border-slate-100';
      const inactiveText = 'text-slate-500';

      btnTransfer.className = btnTransfer.className.replace(activeBorder, inactiveBorder).replace(activeText, inactiveText);
      btnPayphone.className = btnPayphone.className.replace(activeBorder, inactiveBorder).replace(activeText, inactiveText);
      btnKushki.className = btnKushki.className.replace(activeBorder, inactiveBorder).replace(activeText, inactiveText);
      
      panelTransfer.classList.add('hidden');
      panelPayphone.classList.add('hidden');
      panelKushki.classList.add('hidden');
      
      if (method === 'transfer') {
        btnTransfer.classList.remove(inactiveBorder, inactiveText);
        btnTransfer.classList.add(activeBorder, activeText);
        panelTransfer.classList.remove('hidden');
      } else if (method === 'payphone') {
        btnPayphone.classList.remove(inactiveBorder, inactiveText);
        btnPayphone.classList.add(activeBorder, activeText);
        panelPayphone.classList.remove('hidden');
      } else if (method === 'kushki') {
        btnKushki.classList.remove(inactiveBorder, inactiveText);
        btnKushki.classList.add(activeBorder, activeText);
        panelKushki.classList.remove('hidden');
      }
    }

    async function claimFreeCertificate() {
      try {
        const response = await fetch('/conversatorios/<%= conversatorio.id %>/comprar-certificado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ paymentMethod: 'gratuito', ajax: true })
        });
        const result = await response.json();
        if (result.success && result.redirect) {
          window.location.href = result.redirect;
        } else {
          alert(result.error || "Ocurrió un error al obtener el certificado.");
        }
      } catch (err) {
        console.error(err);
        alert("Error al conectar con el servidor.");
      }
    }

    function readImageAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function submitCheckoutPayment() {
      const errorAlert = document.getElementById('payment-error-alert');
      const errorText = document.getElementById('payment-error-text');
      const btnText = document.getElementById('checkout-btn-text');
      const btnIcon = document.getElementById('checkout-btn-icon');

      let payload = {
        paymentMethod: activePaymentMethod,
        ajax: true
      };

      if (activePaymentMethod === 'transfer') {
        const bancoInput = document.getElementById('transfer-banco');
        const banco = bancoInput ? bancoInput.value : '';
        const bankAccountSelect = document.getElementById('transfer-bank-account');
        const reference = document.getElementById('transfer-ref').value.trim();
        const fileInput = document.getElementById('transfer-comprobante');
        if (bankAccountSelect && !bankAccountSelect.value) {
          errorText.innerText = "Seleccione la cuenta bancaria de destino.";
          errorAlert.classList.remove('hidden');
          return;
        }
        if (!reference) {
          errorText.innerText = "Por favor, ingrese el número de referencia bancaria.";
          errorAlert.classList.remove('hidden');
          return;
        }
        if (!fileInput.files || fileInput.files.length === 0) {
          errorText.innerText = "Por favor, suba la captura de su comprobante de pago.";
          errorAlert.classList.remove('hidden');
          return;
        }
        if (bancoInput) payload.banco = banco;
        if (bankAccountSelect) payload.bankAccountId = bankAccountSelect.value;
        payload.reference = reference;
        payload.paymentMethod = "transferencia";

        const file = fileInput.files[0];
        try {
          payload.comprobante = await readImageAsBase64(file);
        } catch (e) {
          errorText.innerText = "Error al procesar la imagen del comprobante.";
          errorAlert.classList.remove('hidden');
          return;
        }
      } else if (activePaymentMethod === 'payphone') {
        // PayPhone se procesa a través de la pasarela real → redirige.
        iniciarPagoPayPhone({
          itemType: 'CERTIFICATE',
          itemId: <%= conversatorio.id %>,
          baseAmount: Number('<%= modalPrice %>'),
          hasTax: true,
          productName: 'Certificado - <%= (conversatorio.titulo || '').replace(/'/g, "\\'") %>'
        });
        return;
      } else if (activePaymentMethod === 'kushki') {
        const name = document.getElementById('kushki-name').value.trim();
        const number = document.getElementById('kushki-number').value.trim();
        const expiry = document.getElementById('kushki-expiry').value.trim();
        const cvv = document.getElementById('kushki-cvv').value.trim();

        if (!name || !number || !expiry || !cvv) {
          errorText.innerText = "Por favor, complete todos los campos de su tarjeta.";
          errorAlert.classList.remove('hidden');
          return;
        }
        payload.reference = "KushkiCard-••••" + number.slice(-4);
      }

      errorAlert.classList.add('hidden');
      btnText.innerText = "Procesando pago...";
      btnIcon.className = "fa-solid fa-spinner animate-spin";

      try {
        const response = await fetch('/conversatorios/<%= conversatorio.id %>/comprar-certificado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await response.json();
        
        if (result.success && result.redirect) {
          closePaymentModal();
          window.location.href = result.redirect;
        } else {
          errorText.innerText = result.error || "Ocurrió un error al procesar el pago.";
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        errorText.innerText = "Error de red al conectar al servidor.";
        errorAlert.classList.remove('hidden');
      } finally {
        btnText.innerText = "Confirmar y Registrar Pago";
        btnIcon.className = "fa-solid fa-circle-check";
      }
    }

    function togglePasswordVisibility(id, btn) {
      const input = document.getElementById(id);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>

  <% if (locals.user) { %>
    <% const reqMinutes = (typeof requiredMinutes !== 'undefined' && requiredMinutes !== null) ? requiredMinutes : (conversatorio && conversatorio.usarTiempoMinimoPonencia && conversatorio.tiempoMinimoPonenciaMinutos ? conversatorio.tiempoMinimoPonenciaMinutos : ((typeof systemConfig !== 'undefined' && systemConfig && systemConfig.tiempoMinimoPonenciaMinutos !== null && systemConfig.tiempoMinimoPonenciaMinutos !== undefined) ? systemConfig.tiempoMinimoPonenciaMinutos : 3)); %>
    <% const reqSecondsTotal = reqMinutes * 60; %>
    <script>
      const requiredTotalSeconds = <%= reqSecondsTotal %>;
      const storageKey = `pec_timer_conv_<%= conversatorio.id %>_spk_<%= speaker.id %>`;
      const storageTotalKey = `pec_timer_total_conv_<%= conversatorio.id %>_spk_<%= speaker.id %>`;
      const isAlreadyCompleted = <%= JSON.stringify(typeof isAlreadyCompleted !== 'undefined' ? isAlreadyCompleted : false) %>;

      let secondsRemaining = requiredTotalSeconds;
      if (!isAlreadyCompleted) {
        const savedTotalReq = localStorage.getItem(storageTotalKey);
        if (savedTotalReq !== null && parseInt(savedTotalReq, 10) !== requiredTotalSeconds) {
          localStorage.removeItem(storageKey);
          localStorage.removeItem(storageTotalKey);
        } else {
          const savedTime = localStorage.getItem(storageKey);
          if (savedTime !== null) {
            const parsed = parseInt(savedTime, 10);
            if (!isNaN(parsed) && parsed >= 0 && parsed <= requiredTotalSeconds) {
              secondsRemaining = parsed;
            }
          }
        }
        localStorage.setItem(storageTotalKey, requiredTotalSeconds.toString());
      }

      function updateTimerUI() {
        const btn = document.getElementById('btn-complete-speaker-check');
        const label = document.getElementById('btn-check-timer-label');
        if (secondsRemaining <= 0) {
          if (btn && label) {
            btn.disabled = false;
            btn.classList.remove('bg-slate-200/80', 'text-slate-500', 'cursor-not-allowed', 'opacity-90', 'border-slate-300/60');
            btn.classList.add('bg-emerald-600', 'hover:bg-emerald-700', 'text-white', 'cursor-pointer', 'shadow-md', 'border-emerald-500');
            label.innerHTML = '<i class="fa-solid fa-check text-sm font-black"></i> Marcar Ponencia como Completada';
          }
        } else {
          const mins = Math.floor(secondsRemaining / 60);
          const secs = secondsRemaining % 60;
          const formatted = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
          if (label) {
            label.innerText = `Permanecer ${formatted} min para marcar ponencia`;
          }
        }
      }

      if (!isAlreadyCompleted) {
        updateTimerUI();
        const timerInterval = setInterval(() => {
          if (secondsRemaining > 0) {
            secondsRemaining--;
            localStorage.setItem(storageKey, secondsRemaining.toString());
            updateTimerUI();
            if (secondsRemaining <= 0) {
              clearInterval(timerInterval);
            }
          }
        }, 1000);
      }

      async function submitSpeakerCompletionCheck() {
        const btn = document.getElementById('btn-complete-speaker-check');
        if (btn) btn.disabled = true;

        try {
          const res = await fetch('/api/events/conversatorio/complete-speaker', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              conversatorioId: <%= conversatorio.id %>,
              speakerId: <%= speaker.id %>,
              durationWatchedSeconds: requiredTotalSeconds - Math.max(0, secondsRemaining)
            })
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            alert(data.error || 'No se pudo registrar el avance.');
            if (btn) btn.disabled = false;
            return;
          }

          localStorage.removeItem(storageKey);
          localStorage.removeItem(storageTotalKey);

          document.getElementById('progress-pct-display').innerText = data.progressPct + '%';
          document.getElementById('completed-count-display').innerText = data.completedCount;
          document.getElementById('progress-bar-fill').style.width = data.progressPct + '%';

          const nextSpeakerTargetUrl = "<%= (typeof nextSpeaker !== 'undefined' && nextSpeaker) ? '/conversatorios/' + (conversatorio.slug || conversatorio.id) + '/ponentes/' + (nextSpeaker.slug || nextSpeaker.id) : '/conversatorios/' + (conversatorio.slug || conversatorio.id) %>";
          const isFinalSpeaker = <%= (typeof nextSpeaker === 'undefined' || !nextSpeaker) ? 'true' : 'false' %>;

          const btnContainer = document.getElementById('completion-btn-container');
          if (btnContainer) {
            btnContainer.innerHTML = `
              <div class="flex items-center gap-2 flex-wrap animate-fade-in">
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3 rounded-2xl text-xs font-black flex items-center gap-2 shadow-sm font-sans">
                  <i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>
                  <span>¡Ponencia Completada!</span>
                </div>
                <a href="${nextSpeakerTargetUrl}" class="${isFinalSpeaker ? 'bg-blue-600 hover:bg-blue-700' : 'bg-emerald-600 hover:bg-emerald-700'} text-white font-extrabold px-5 py-3 rounded-2xl text-xs transition flex items-center gap-2 shadow-md cursor-pointer font-sans">
                  ${isFinalSpeaker ? '<i class="fa-solid fa-flag-checkered text-xs"></i> <span>Volver al Evento</span>' : '<span>Siguiente Ponencia</span> <i class="fa-solid fa-arrow-right text-xs"></i>'}
                </a>
              </div>
            `;
          }

          if (data.certificateGranted) {
            const certBanner = document.getElementById('cert-earned-banner');
            const certLink = document.getElementById('cert-earned-link');
            if (data.certCode && certLink) {
              certLink.href = '/certificados/' + data.certCode;
              certLink.target = '_blank';
            }
            if (certBanner) certBanner.classList.remove('hidden');

            const modalShownKey = `pec_cert_modal_shown_conv_<%= conversatorio.id %>`;
            const hasModalBeenShown = localStorage.getItem(modalShownKey);
            if (!hasModalBeenShown) {
              localStorage.setItem(modalShownKey, 'true');
              openCertUnlockedModal(data.certCode);
            }
          }
        } catch (err) {
          console.error(err);
          alert('Ocurrió un error al marcar la ponencia.');
          if (btn) btn.disabled = false;
        }
      }

      function openCertUnlockedModal(certCode) {
        const modal = document.getElementById('cert-unlocked-modal');
        const viewBtn = document.getElementById('cert-unlocked-modal-view-btn');
        if (viewBtn && certCode) {
          viewBtn.href = '/certificados/' + certCode;
        }
        if (modal) modal.classList.remove('hidden');
      }

      function closeCertUnlockedModal() {
        const modal = document.getElementById('cert-unlocked-modal');
        if (modal) modal.classList.add('hidden');
      }
    </script>
  <% } %>

  <!-- Modal: Certificado Desbloqueado (Aparición Única) -->
  <div id="cert-unlocked-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-sm p-4 hidden animate-fade-in font-sans">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 md:p-8 shadow-2xl border border-slate-100 flex flex-col items-center text-center relative overflow-hidden">
      <!-- Background glows -->
      <div class="absolute -top-12 -right-12 w-32 h-32 bg-emerald-100 rounded-full blur-2xl opacity-60"></div>
      <div class="absolute -bottom-12 -left-12 w-32 h-32 bg-amber-100 rounded-full blur-2xl opacity-60"></div>

      <!-- Trophy Icon -->
      <div class="w-20 h-20 rounded-3xl bg-gradient-to-tr from-amber-400 to-amber-200 text-amber-900 flex items-center justify-center text-4xl mb-4 shadow-lg shadow-amber-500/20 relative">
        <i class="fa-solid fa-trophy"></i>
      </div>

      <!-- Content -->
      <h3 class="text-xl font-black text-slate-900 uppercase tracking-tight">¡Felicitaciones!</h3>
      <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider mt-1">Certificado Desbloqueado</p>
      <p class="text-xs text-slate-600 font-medium leading-relaxed mt-3">
        Has alcanzado el porcentaje mínimo de asistencia requerido. Tu certificado oficial de participación ha sido generado con éxito.
      </p>

      <!-- Buttons -->
      <div class="w-full flex flex-col gap-2.5 mt-6">
        <a id="cert-unlocked-modal-view-btn" href="#" target="_blank" onclick="closeCertUnlockedModal()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-5 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer font-sans">
          <i class="fa-solid fa-award text-sm"></i>
          <span>Ver / Descargar Certificado</span>
        </a>
        <button type="button" onclick="closeCertUnlockedModal()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-extrabold py-3 px-5 rounded-2xl text-xs transition cursor-pointer font-sans">
          Continuar Viendo el Evento
        </button>
      </div>
    </div>
  </div>
</body>
</html>
