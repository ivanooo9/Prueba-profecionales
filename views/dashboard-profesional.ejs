    function handleEduImageUpload(input) {
      const file = input.files[0];
      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        alert('La imagen no debe superar los 5MB.');
        input.value = '';
        return;
      }

      const status = document.getElementById('edu-image-status');
      status.innerText = 'Cargando imagen...';

      const reader = new FileReader();
      reader.onload = function(e) {
        const base64 = e.target.result;
        document.getElementById('edu-imagen').value = base64;
        document.getElementById('edu-preview-img').src = base64;
        document.getElementById('edu-preview-container').classList.remove('hidden');
        status.innerText = file.name;
      };
      reader.readAsDataURL(file);
    }

    function editEducation(btn) {
      const id = btn.getAttribute('data-id');
      const tipo = btn.getAttribute('data-tipo');
      const titulo = btn.getAttribute('data-titulo');
      const institucion = btn.getAttribute('data-institucion');
      const nivelEstudio = btn.getAttribute('data-nivelestudio');
      const tipoCertificado = btn.getAttribute('data-tipocertificado');
      const horas = btn.getAttribute('data-horas');
      const anioEmision = btn.getAttribute('data-anioemision');
      const imagen = btn.getAttribute('data-imagen');

      document.getElementById('form-educacion').action = '/dashboard/profesional/educacion/editar/' + id;
      document.getElementById('edu-id').value = id;
      document.getElementById('edu-tipo').value = tipo;
      toggleEduFields();

      document.getElementById('edu-titulo').value = titulo;
      document.getElementById('edu-institucion').value = institucion;
      if (nivelEstudio) document.getElementById('edu-nivelEstudio').value = nivelEstudio;
      if (tipoCertificado) document.getElementById('edu-tipoCertificado').value = tipoCertificado;
      document.getElementById('edu-horas').value = horas;
      document.getElementById('edu-anioEmision').value = anioEmision;
      
      document.getElementById('edu-imagen').value = imagen;
      document.getElementById('edu-preview-img').src = imagen;
      document.getElementById('edu-preview-container').classList.remove('hidden');
      document.getElementById('edu-image-status').innerText = 'Imagen cargada previamente';

      document.getElementById('btn-save-edu').innerHTML = 'Actualizar Registro <i class="fa-solid fa-check ml-1"></i>';
      document.getElementById('btn-cancel-edu').classList.remove('hidden');

      document.getElementById('form-educacion').scrollIntoView({ behavior: 'smooth' });
    }

    function resetEduForm() {
      document.getElementById('form-educacion').action = '/dashboard/profesional/educacion';
      document.getElementById('form-educacion').reset();
      document.getElementById('edu-id').value = '';
      document.getElementById('edu-imagen').value = '';
      document.getElementById('edu-preview-container').classList.add('hidden');
      document.getElementById('edu-image-status').innerText = 'Ningún archivo seleccionado';
      document.getElementById('btn-save-edu').innerHTML = 'Guardar Registro <i class="fa-solid fa-plus ml-1"></i>';
      document.getElementById('btn-cancel-edu').classList.add('hidden');
      toggleEduFields();
    }

    // -------------------------------------------------------------
    // LÓGICA Y EDITOR DEL MÓDULO PROFESIONALES ID
    // -------------------------------------------------------------
    let currentProfIdData = null;

    async function loadProfIdData() {
      try {
        const res = await fetch('/api/professional/id/config');
        const data = await res.json();
        if (!data.success || !data.profId) return;

        currentProfIdData = data.profId;
        const p = data.profId;
        const stats = data.analytics || {};

        // 1. Header & Status
        const isActiveCheckbox = document.getElementById('prof-id-is-active');
        const activeLabel = document.getElementById('prof-id-active-label');
        const statusBadge = document.getElementById('prof-id-status-badge');
        
        if (isActiveCheckbox) isActiveCheckbox.checked = p.isActive;
        if (activeLabel) {
          activeLabel.innerText = p.isActive ? 'Activo' : 'Inactivo';
          activeLabel.className = p.isActive ? 'text-emerald-600 font-extrabold' : 'text-slate-400 font-extrabold';
        }
        if (statusBadge) {
          statusBadge.innerText = p.isActive ? 'Publicado' : 'Borrador / Inactivo';
          statusBadge.className = p.isActive ? 'bg-emerald-500 text-white text-[9px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider' : 'bg-slate-400 text-white text-[9px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider';
        }

        const urlDisplay = document.getElementById('prof-id-url-display');
        if (urlDisplay) urlDisplay.innerText = `profesionales.ec/@${p.slug}`;

        // 2. Form Inputs
        document.getElementById('prof-id-slug-input').value = p.slug || '';
        document.getElementById('prof-id-short-desc').value = p.shortDescription || '';

        document.getElementById('prof-id-primary-type').value = p.primaryActionType || 'WHATSAPP';
        document.getElementById('prof-id-primary-title').value = p.primaryActionTitle || 'Escríbeme por WhatsApp';
        document.getElementById('prof-id-primary-value').value = p.primaryActionValue || '';

        document.getElementById('prof-id-theme').value = p.theme || 'light';
        document.getElementById('prof-id-button-style').value = p.buttonStyle || 'rounded';
        document.getElementById('prof-id-alignment').value = p.alignment || 'center';

        onPrimaryTypeChange();

        // 3. Render Links List
        renderProfIdLinksList(p.links || []);

        // 4. Render Blocks List
        renderProfIdBlocksList(p.blocks || []);

        // 5. Render Analytics
        document.getElementById('prof-id-stat-visits').innerText = stats.totalVisits || 0;
        document.getElementById('prof-id-stat-clicks').innerText = stats.totalLinkClicks || 0;
        document.getElementById('prof-id-stat-primary').innerText = stats.primaryActionClicks || 0;
        document.getElementById('prof-id-stat-profile').innerText = stats.profileClicks || 0;

        renderProfIdStatBreakdown(stats.linksBreakdown || []);

        // 6. Refresh Preview Frame
        const iframe = document.getElementById('prof-id-preview-iframe');
        if (iframe) {
          iframe.src = `/@${p.slug}`;
        }
      } catch (err) {
        console.error('Error cargando Profesionales ID:', err);
      }
    }

    function onPrimaryTypeChange() {
      const type = document.getElementById('prof-id-primary-type').value;
      const titleInput = document.getElementById('prof-id-primary-title');
      const valInput = document.getElementById('prof-id-primary-value');
      const valLabel = document.getElementById('label-primary-value');
      const valContainer = document.getElementById('container-primary-value');

      if (type === 'WHATSAPP') {
        valContainer.classList.remove('hidden');
        valLabel.innerText = 'Número de WhatsApp (ej: 593999999999)';
        if (!titleInput.value) titleInput.value = 'Escríbeme por WhatsApp';
      } else if (type === 'AGENDA') {
        valContainer.classList.add('hidden');
        if (!titleInput.value) titleInput.value = 'Agendar una Cita Directa';
      } else if (type === 'SERVICES') {
        valContainer.classList.add('hidden');
        if (!titleInput.value) titleInput.value = 'Ver Mis Servicios';
      } else {
        valContainer.classList.remove('hidden');
        valLabel.innerText = 'URL / Enlace de Destino';
      }
    }

    async function saveProfIdGeneralConfig() {
      try {
        const isActive = document.getElementById('prof-id-is-active').checked;
        const slug = document.getElementById('prof-id-slug-input').value.trim();
        const shortDescription = document.getElementById('prof-id-short-desc').value.trim();
        const primaryActionType = document.getElementById('prof-id-primary-type').value;
        const primaryActionTitle = document.getElementById('prof-id-primary-title').value.trim();
        const primaryActionValue = document.getElementById('prof-id-primary-value').value.trim();
        const theme = document.getElementById('prof-id-theme').value;
        const buttonStyle = document.getElementById('prof-id-button-style').value;
        const alignment = document.getElementById('prof-id-alignment').value;

        const res = await fetch('/api/professional/id/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            isActive, slug, shortDescription,
            primaryActionType, primaryActionTitle, primaryActionValue,
            theme, buttonStyle, alignment
          })
        });

        const data = await res.json();
        if (data.success) {
          loadProfIdData();
        } else {
          alert('Error: ' + (data.error || 'No se pudo guardar la configuración.'));
        }
      } catch (err) {
        console.error('Error guardando configuración:', err);
      }
    }

    function renderProfIdLinksList(links) {
      const container = document.getElementById('prof-id-links-list');
      if (!container) return;

      if (!links || links.length === 0) {
        container.innerHTML = `
          <div class="p-6 text-center text-slate-400 text-xs bg-slate-50 border border-slate-100 rounded-2xl">
            Aún no has creado botones. Haz clic en "Crear Botón" o en las acciones rápidas superiores.
          </div>
        `;
        return;
      }

      container.innerHTML = links.map((l, index) => `
        <div class="p-3.5 bg-slate-50 border border-slate-200/80 rounded-2xl flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            <div class="flex flex-col gap-0.5 text-slate-400">
              <button type="button" onclick="moveProfIdLink(${l.id}, 'up')" ${index === 0 ? 'disabled class="opacity-30"' : 'class="hover:text-slate-700 cursor-pointer"'}><i class="fa-solid fa-chevron-up text-[10px]"></i></button>
              <button type="button" onclick="moveProfIdLink(${l.id}, 'down')" ${index === links.length - 1 ? 'disabled class="opacity-30"' : 'class="hover:text-slate-700 cursor-pointer"'}><i class="fa-solid fa-chevron-down text-[10px]"></i></button>
            </div>
            <div class="w-8 h-8 rounded-xl bg-white border border-slate-200 text-brand-blue flex items-center justify-center shrink-0 overflow-hidden">
              ${l.icon && (l.icon.startsWith('data:') || l.icon.startsWith('http') || l.icon.startsWith('/')) ? `<img src="${l.icon}" class="w-5 h-5 object-contain">` : `<i class="${l.icon || 'fa-solid fa-link'} text-xs"></i>`}
            </div>
            <div class="min-w-0 flex flex-col">
              <span class="font-extrabold text-xs text-slate-800 truncate">${l.title}</span>
              <span class="text-[10px] text-slate-400 font-mono truncate">${l.type} ${l.clicksCount ? `• ${l.clicksCount} clics` : ''}</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button type="button" onclick='openEditLinkModal(${JSON.stringify(l)})' class="p-2 rounded-xl text-slate-600 hover:bg-slate-200 transition cursor-pointer text-xs">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button type="button" onclick="deleteProfIdLink(${l.id})" class="p-2 rounded-xl text-rose-600 hover:bg-rose-50 transition cursor-pointer text-xs">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>
      `).join('');
    }

    function renderProfIdBlocksList(blocks) {
      const container = document.getElementById('prof-id-blocks-list');
      if (!container) return;

      if (!blocks || blocks.length === 0) {
        container.innerHTML = `
          <div class="p-6 text-center text-slate-400 text-xs bg-slate-50 border border-slate-100 rounded-2xl">
            No tienes promociones activas. Puedes publicar descuentos o noticias destacadas.
          </div>
        `;
        return;
      }

      container.innerHTML = blocks.map(b => `
        <div class="p-3.5 bg-amber-50/50 border border-amber-200/80 rounded-2xl flex items-center justify-between gap-3">
          <div class="flex items-center gap-3 min-w-0">
            ${b.image ? `<img src="${b.image}" class="w-10 h-10 rounded-xl object-cover border border-amber-200 shrink-0">` : `<div class="w-10 h-10 rounded-xl bg-amber-100/80 text-amber-700 font-black flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-bullhorn"></i></div>`}
            <div class="min-w-0 flex flex-col gap-0.5">
              <span class="font-extrabold text-xs text-slate-900 truncate">${b.title}</span>
              ${b.description ? `<span class="text-[10px] text-slate-500 truncate">${b.description}</span>` : ''}
            </div>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" onclick='openEditBlockModal(${JSON.stringify(b)})' class="p-2 rounded-xl text-slate-600 hover:bg-amber-100 transition cursor-pointer text-xs" title="Editar">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button type="button" onclick="deleteProfIdBlock(${b.id})" class="p-2 rounded-xl text-rose-600 hover:bg-rose-100 transition cursor-pointer text-xs" title="Eliminar">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>
      `).join('');
    }

    function renderProfIdStatBreakdown(items) {
      const container = document.getElementById('prof-id-stat-breakdown');
      if (!container) return;

      if (!items || items.length === 0) {
        container.innerHTML = `<span class="text-slate-400 text-[10px]">Sin datos de clics aún.</span>`;
        return;
      }

      const maxClicks = Math.max(1, ...items.map(i => i.clicksCount));

      container.innerHTML = items.map(i => {
        const pct = Math.round((i.clicksCount / maxClicks) * 100);
        return `
          <div class="flex flex-col gap-1 text-[10px] font-semibold">
            <div class="flex justify-between items-center text-slate-700">
              <span class="truncate max-w-[70%] font-bold"><i class="${i.icon || 'fa-solid fa-link'} mr-1 text-brand-blue"></i>${i.title}</span>
              <span class="font-black text-slate-900">${i.clicksCount} clics</span>
            </div>
            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
              <div class="bg-brand-blue h-full rounded-full transition-all duration-300" style="width: ${pct}%"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    function openAddLinkModal() {
      document.getElementById('prof-id-link-modal-title').innerText = 'Agregar Nuevo Botón';
      document.getElementById('link-form-id').value = '';
      document.getElementById('link-form-title').value = '';
      document.getElementById('link-form-icon').value = 'fa-solid fa-link';
      document.getElementById('link-form-url').value = '';
      document.getElementById('link-form-type').value = 'EXTERNAL_URL';
      updateIconPreview('');
      onLinkTypeChange(true);

      document.getElementById('prof-id-link-modal').classList.remove('hidden');
    }

    function openPresetLinkModal(type) {
      openAddLinkModal();
      document.getElementById('link-form-type').value = type;
      onLinkTypeChange(true);
    }

    function openEditLinkModal(l) {
      document.getElementById('prof-id-link-modal-title').innerText = 'Editar Botón';
      document.getElementById('link-form-id').value = l.id;
      document.getElementById('link-form-title').value = l.title;
      document.getElementById('link-form-icon').value = l.icon || 'fa-solid fa-link';
      document.getElementById('link-form-url').value = l.url || '';
      document.getElementById('link-form-type').value = l.type || 'EXTERNAL_URL';
      updateIconPreview(l.icon || '');
      onLinkTypeChange(false);

      document.getElementById('prof-id-link-modal').classList.remove('hidden');
    }

    function closeProfIdLinkModal() {
      document.getElementById('prof-id-link-modal').classList.add('hidden');
    }

    function onLinkTypeChange(forcePrefill = false) {
      const type = document.getElementById('link-form-type').value;
      const titleInput = document.getElementById('link-form-title');
      const iconInput = document.getElementById('link-form-icon');
      const urlInput = document.getElementById('link-form-url');

      const slug = (currentProfIdData && currentProfIdData.slug) ? currentProfIdData.slug : '';
      const prof = (currentProfIdData && currentProfIdData.professionalProfile) ? currentProfIdData.professionalProfile : {};
      const userObj = prof.user || {};
      const rawPhone = prof.whatsapp || prof.telefono || '';
      let phone = rawPhone.replace(/[^0-9]/g, '');
      if (phone && !phone.startsWith('593')) {
        phone = phone.startsWith('0') ? '593' + phone.substring(1) : '593' + phone;
      }

      if (forcePrefill) {
        if (type === 'PROFILE') {
          titleInput.value = 'Ver mi Perfil Profesional Completo';
          iconInput.value = 'fa-solid fa-address-card';
          urlInput.value = slug ? `/directorio/${slug}` : '';
        } else if (type === 'SERVICES') {
          titleInput.value = 'Consultar Mis Servicios';
          iconInput.value = 'fa-solid fa-stethoscope';
          urlInput.value = slug ? `/directorio/${slug}#servicios` : '';
        } else if (type === 'AGENDA') {
          titleInput.value = 'Agendar una Cita Directa';
          iconInput.value = 'fa-solid fa-calendar-check';
          urlInput.value = slug ? `/directorio/${slug}#agendamiento` : '';
        } else if (type === 'WHATSAPP') {
          titleInput.value = 'Contacto por WhatsApp';
          iconInput.value = 'fa-brands fa-whatsapp';
          const msg = encodeURIComponent(`Hola ${userObj.name || ''}, vi tu Profesionales ID y deseo solicitar información.`);
          urlInput.value = phone ? `https://wa.me/${phone}?text=${msg}` : 'https://wa.me/';
        } else if (type === 'PHONE') {
          titleInput.value = 'Llamada Telefónica';
          iconInput.value = 'fa-solid fa-phone';
          urlInput.value = phone ? `tel:${phone}` : 'tel:';
        } else if (type === 'EMAIL') {
          titleInput.value = 'Enviar Correo Electrónico';
          iconInput.value = 'fa-solid fa-envelope';
          urlInput.value = userObj.email ? `mailto:${userObj.email}` : 'mailto:';
        } else if (type === 'EXTERNAL_URL') {
          if (!titleInput.value) titleInput.value = 'Visitar mi sitio web';
          if (!iconInput.value) iconInput.value = 'fa-solid fa-globe';
          if (!urlInput.value) urlInput.value = prof.website || 'https://';
        }
        updateIconPreview(iconInput.value);
      }
    }

    function handleLinkIconUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const base64 = e.target.result;
        document.getElementById('link-form-icon').value = base64;
        updateIconPreview(base64);
      };
      reader.readAsDataURL(file);
    }

    function updateIconPreview(val) {
      const previewContainer = document.getElementById('link-icon-preview-container');
      const previewImg = document.getElementById('link-icon-preview-img');
      if (!previewContainer || !previewImg) return;
      if (val && (val.startsWith('data:') || val.startsWith('http') || val.startsWith('/'))) {
        previewImg.src = val;
        previewContainer.classList.remove('hidden');
      } else {
        previewContainer.classList.add('hidden');
      }
    }

    function clearCustomLinkIcon() {
      document.getElementById('link-form-icon').value = 'fa-solid fa-link';
      document.getElementById('link-icon-file-input').value = '';
      updateIconPreview('');
    }

    async function saveProfIdLink(e) {
      e.preventDefault();
      try {
        const id = document.getElementById('link-form-id').value;
        const type = document.getElementById('link-form-type').value;
        const title = document.getElementById('link-form-title').value;
        const icon = document.getElementById('link-form-icon').value;
        const url = document.getElementById('link-form-url').value;
        const isActive = document.getElementById('link-form-active').checked;

        const res = await fetch('/api/professional/id/links', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: id ? Number(id) : undefined, type, title, icon, url, isActive })
        });

        const data = await res.json();
        if (data.success) {
          closeProfIdLinkModal();
          loadProfIdData();
        } else {
          alert(data.error || 'Error guardando botón.');
        }
      } catch (err) {
        console.error('Error guardando botón:', err);
      }
    }

    async function addProfIdPresetLink(type) {
      try {
        await fetch('/api/professional/id/links', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, isActive: true })
        });
        loadProfIdData();
      } catch (err) {
        console.error('Error agregando botón predeterminado:', err);
      }
    }

    async function deleteProfIdLink(id) {
      if (!confirm('¿Deseas eliminar este botón?')) return;
      await fetch(`/api/professional/id/links/${id}`, { method: 'DELETE' });
      loadProfIdData();
    }

    async function moveProfIdLink(id, direction) {
      if (!currentProfIdData || !currentProfIdData.links) return;
      const links = [...currentProfIdData.links];
      const index = links.findIndex(l => l.id === id);
      if (index === -1) return;

      const targetIndex = direction === 'up' ? index - 1 : index + 1;
      if (targetIndex < 0 || targetIndex >= links.length) return;

      const temp = links[index];
      links[index] = links[targetIndex];
      links[targetIndex] = temp;

      const linkIds = links.map(l => l.id);

      await fetch('/api/professional/id/links/reorder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ linkIds })
      });

      loadProfIdData();
    }

    function openAddBlockModal() {
      document.getElementById('prof-id-block-modal-title').innerText = 'Nueva Promoción / Destacado';
      document.getElementById('block-form-id').value = '';
      document.getElementById('block-form-title').value = '';
      document.getElementById('block-form-desc').value = '';
      document.getElementById('block-form-image').value = '';
      document.getElementById('block-form-btn-text').value = 'Aprovechar Promoción';
      document.getElementById('block-form-url').value = '';
      clearCustomBlockImage();

      document.getElementById('prof-id-block-modal').classList.remove('hidden');
    }

    function openEditBlockModal(b) {
      document.getElementById('prof-id-block-modal-title').innerText = 'Editar Promoción / Destacado';
      document.getElementById('block-form-id').value = b.id;
      document.getElementById('block-form-title').value = b.title;
      document.getElementById('block-form-desc').value = b.description || '';
      document.getElementById('block-form-image').value = b.image || '';
      document.getElementById('block-form-btn-text').value = b.buttonText || 'Aprovechar Promoción';
      document.getElementById('block-form-url').value = b.url || '';
      document.getElementById('block-form-end-at').value = b.endAt ? b.endAt.split('T')[0] : '';
      document.getElementById('block-form-active').checked = b.isActive !== false;
      updateBlockImagePreview(b.image || '');

      document.getElementById('prof-id-block-modal').classList.remove('hidden');
    }

    function handleBlockImageUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const base64 = e.target.result;
        document.getElementById('block-form-image').value = base64;
        updateBlockImagePreview(base64);
      };
      reader.readAsDataURL(file);
    }

    function updateBlockImagePreview(val) {
      const previewContainer = document.getElementById('block-image-preview-container');
      const placeholderContainer = document.getElementById('block-image-placeholder-container');
      const previewImg = document.getElementById('block-image-preview-img');
      if (!previewContainer || !placeholderContainer || !previewImg) return;

      if (val && val.trim()) {
        previewImg.src = val;
        previewContainer.classList.remove('hidden');
        placeholderContainer.classList.add('hidden');
      } else {
        previewContainer.classList.add('hidden');
        placeholderContainer.classList.remove('hidden');
      }
    }

    function clearCustomBlockImage() {
      document.getElementById('block-form-image').value = '';
      const input = document.getElementById('block-image-file-input');
      if (input) input.value = '';
      updateBlockImagePreview('');
    }

    function closeProfIdBlockModal() {
      document.getElementById('prof-id-block-modal').classList.add('hidden');
    }

    async function saveProfIdBlock(e) {
      e.preventDefault();
      try {
        const id = document.getElementById('block-form-id').value;
        const title = document.getElementById('block-form-title').value;
        const description = document.getElementById('block-form-desc').value;
        const image = document.getElementById('block-form-image').value;
        const buttonText = document.getElementById('block-form-btn-text').value;
        const url = document.getElementById('block-form-url').value;
        const endAt = document.getElementById('block-form-end-at').value;
        const isActive = document.getElementById('block-form-active').checked;

        const res = await fetch('/api/professional/id/blocks', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: id ? Number(id) : undefined,
            type: 'PROMOTION',
            title, description, image, buttonText, url, endAt: endAt || null, isActive
          })
        });

        const data = await res.json();
        if (data.success) {
          closeProfIdBlockModal();
          loadProfIdData();
        } else {
          alert(data.error || 'Error guardando promoción.');
        }
      } catch (err) {
        console.error('Error guardando promoción:', err);
      }
    }

    async function deleteProfIdBlock(id) {
      if (!confirm('¿Deseas eliminar este bloque destacado?')) return;
      await fetch(`/api/professional/id/blocks/${id}`, { method: 'DELETE' });
      loadProfIdData();
    }

    function previewPublicId() {
      if (currentProfIdData && currentProfIdData.slug) {
        window.open(`/@${currentProfIdData.slug}`, '_blank');
      }
    }

    function copyProfIdLink() {
      if (currentProfIdData && currentProfIdData.slug) {
        const fullUrl = `${window.location.origin}/@${currentProfIdData.slug}`;
        navigator.clipboard.writeText(fullUrl);
        alert('¡Enlace copiado al portapapeles!\n' + fullUrl);
      }
    }

    function showProfIdQrModal() {
      if (currentProfIdData && currentProfIdData.slug) {
        const fullUrl = encodeURIComponent(`${window.location.origin}/@${currentProfIdData.slug}`);
        window.open(`https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${fullUrl}`, '_blank');
      }
    }
  </script>

  <!-- Modal Crear/Editar Botón de Profesionales ID -->
  <div id="prof-id-link-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[99] flex items-center justify-center hidden">
    <div class="bg-white rounded-3xl p-6 md:p-8 max-w-md w-full border border-slate-100 shadow-2xl relative mx-4 text-left">
      <button onclick="closeProfIdLinkModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-lg cursor-pointer">
        <i class="fa-solid fa-times"></i>
      </button>
      <h3 id="prof-id-link-modal-title" class="text-lg font-black text-slate-950 mb-1 font-sans">Agregar Nuevo Botón</h3>
      <p class="text-slate-500 text-xs mb-5 font-semibold">Configura la etiqueta, icono y destino de tu botón.</p>

      <form id="prof-id-link-form" onsubmit="saveProfIdLink(event)" class="flex flex-col gap-4">
