                    </div>

                    <!-- PayPhone Fields (real gateway) -->
                    <div id="membership-card-fields-2" class="hidden flex flex-col gap-3">
                      <p class="text-[11px] text-slate-500 font-medium leading-relaxed">
                        Serás redirigido a la pasarela de pago segura de PayPhone para completar tu pago con tarjeta de crédito/débito.
                      </p>
                      <button type="button" onclick="iniciarPagoPayPhone({ itemType: 'MEMBERSHIP', itemId: <%= (typeof profile.membershipPlanId !== 'undefined' && profile.membershipPlanId) ? profile.membershipPlanId : 1 %>, baseAmount: 15.00, hasTax: false, productName: 'Membresía Profesional' })" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-2.5 rounded-xl text-xs transition shadow-sm cursor-pointer text-center">
                        Pagar con PayPhone
                      </button>
                    </div>

                    <button type="submit" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-2.5 rounded-xl text-xs transition shadow-sm cursor-pointer text-center">
                      Registrar Pago <i class="fa-solid fa-paper-plane ml-1"></i>
                    </button>
                  </form>
                </div>
              </div>
            <% } %>
          </div>
        </div>

          <!-- TAB: PERFIL PÚBLICO -->
          <div id="tab-perfil" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            
            <!-- Header with View Profile Button -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-50 pb-4 mb-6">
              <div>
                <h2 class="text-xl font-extrabold text-slate-950 leading-none">Editar Perfil Público</h2>
                <p class="text-slate-500 text-xs mt-1.5 font-semibold">Esta información será visible en el directorio principal de profesionales para todos los clientes.</p>
              </div>
              <a href="<%= profile.slug ? '/directorio/' + profile.slug : '/directorio' %>" target="_blank" class="flex items-center justify-center gap-2 bg-[#5A7AF3] hover:bg-[#4E73DF] text-white text-xs font-bold py-2.5 px-4 rounded-xl transition shadow-md shadow-[#5A7AF3]/10 w-fit">
                <i class="fa-solid fa-eye"></i> Ver Perfil Público
              </a>
            </div>

            <form action="/dashboard/profesional/perfil" method="POST" class="flex flex-col gap-6 text-left">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Nombre del Profesional -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                  <label class="text-xs font-bold text-slate-700">Nombre de Perfil Profesional</label>
                  <input type="text" name="name" value="<%= user.name %>" required placeholder="Ej: Dr. Terry Mendieta" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
                </div>
                
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Slogan / Título Corto</label>
                  <input type="text" name="slogan" value="<%= profile.slogan %>" required placeholder="Ej: Especialista en Medicina Interna y Cardiología" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Precio de la Consulta (USD)</label>
                  <input type="number" step="0.01" name="tarifa" value="<%= profile.tarifa !== undefined && profile.tarifa !== null ? profile.tarifa : 0.0 %>" required placeholder="Ej: 35.00" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Provincia</label>
                  <input type="text" name="provincia" value="<%= profile.provincia %>" required placeholder="Ej: Loja" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Ciudad</label>
                  <input type="text" name="ciudad" value="<%= profile.ciudad %>" required placeholder="Ej: Loja" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
                </div>
                <div class="flex flex-col gap-1.5 md:col-span-2">
                  <label class="text-xs font-bold text-slate-700">Dirección de Consultorio / Oficina</label>
                  <input type="text" name="direccion" value="<%= profile.direccion %>" required placeholder="Ej: Av. Cuxibamba y 18 de Noviembre" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
                </div>
                <div class="flex flex-col gap-1.5 md:col-span-2">
                  <label class="text-xs font-bold text-slate-700">Diseño / Plantilla de Perfil</label>
                  <div class="flex gap-2 items-center">
                    <select name="templateId" class="flex-grow bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
                      <% if (typeof templates !== 'undefined' && templates && templates.length > 0) { %>
                        <% templates.forEach(function(tpl) { %>
                          <option value="<%= tpl.id %>" <%= profile.templateId === tpl.id ? 'selected' : '' %> data-thumbnail="<%= tpl.thumbnail %>" data-base-layout="<%= tpl.baseLayout %>"><%= tpl.name %></option>
                        <% }); %>
                      <% } else { %>
                        <option value="">Plantilla Original</option>
                      <% } %>
                    </select>
                    <button type="button" onclick="openProfilePreview(this)" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-4 rounded-xl transition text-xs flex-shrink-0 cursor-pointer">
                      <i class="fa-solid fa-eye mr-1"></i> Previsualizar
                    </button>
                  </div>
                </div>
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Biografía Profesional / Resumen Curricular</label>
                <textarea name="bio" rows="5" required placeholder="Describe tu experiencia, estudios y trayectoria profesional..." class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium leading-relaxed resize-none"><%= profile.bio %></textarea>
              </div>

              <!-- Photos Uploaders -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                  <label class="text-xs font-bold text-slate-700">Foto de Perfil</label>
                  <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-[16px] overflow-hidden bg-slate-50 border border-slate-200/60 flex items-center justify-center flex-shrink-0 shadow-inner">
                      <img id="profile-photo-preview" src="<%= profile.photo || 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=300' %>" class="w-full h-full object-cover">
                    </div>
                    <input type="file" id="profile-photo-file" accept="image/*" class="text-xs file:bg-slate-50 file:hover:bg-slate-100 file:border-none file:px-4 file:py-2 file:rounded-lg file:text-xs file:font-bold file:cursor-pointer">
                    <input type="hidden" name="photo" id="profile-photo-base64" value="<%= profile.photo || '' %>">
                  </div>
                </div>
                <div class="flex flex-col gap-2">
                  <label class="text-xs font-bold text-slate-700">Imagen de Portada (Banner)</label>
                  <div class="flex items-center gap-4">
                    <div class="w-24 h-12 rounded-lg overflow-hidden bg-slate-50 border border-slate-200/60 flex items-center justify-center flex-shrink-0 shadow-inner">
                      <img id="profile-banner-preview" src="<%= profile.banner || 'https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=1200' %>" class="w-full h-full object-cover">
                    </div>
                    <input type="file" id="profile-banner-file" accept="image/*" class="text-xs file:bg-slate-50 file:hover:bg-slate-100 file:border-none file:px-4 file:py-2 file:rounded-lg file:text-xs file:font-bold file:cursor-pointer">
                    <input type="hidden" name="banner" id="profile-banner-base64" value="<%= profile.banner || '' %>">
                  </div>
                </div>
              </div>

              <!-- Maps Geolocation picker -->
              <div class="flex flex-col gap-2">
                <div class="flex justify-between items-center">
                  <label class="text-xs font-bold text-slate-700">Geolocalización en el Mapa (Selecciona la ubicación de tu oficina)</label>
                  <button type="button" onclick="locateMeOnMap()" class="bg-[#5A7AF3] hover:bg-[#4765E2] text-white text-[10px] font-bold px-3 py-1.5 rounded-lg transition flex items-center gap-1 cursor-pointer">
                    <i class="fa-solid fa-location-crosshairs"></i> Localizarme
                  </button>
                </div>
                <div id="leaflet-picker-map" class="h-64 rounded-2xl border border-slate-100 z-0"></div>
                <div class="grid grid-cols-2 gap-4">
                  <input type="text" readonly name="latitud" id="picker-lat" value="<%= profile.latitud || -4.00789 %>" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-[10px] font-bold outline-none text-center">
                  <input type="text" readonly name="longitud" id="picker-lng" value="<%= profile.longitud || -79.2083 %>" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-[10px] font-bold outline-none text-center">
                </div>
              </div>

              <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3.5 rounded-xl text-xs transition shadow-md self-end px-6 cursor-pointer">
                Guardar Cambios <i class="fa-solid fa-save ml-1"></i>
              </button>
            </form>
          </div>

          <!-- TAB: MIS SERVICIOS -->
          <div id="tab-servicios" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <h2 class="text-xl font-extrabold text-slate-950 mb-1 font-sans leading-none">Gestión de Servicios</h2>
            <p class="text-slate-500 text-xs mb-8">Agrega los servicios y tarifas que ofreces a tus pacientes o clientes.</p>

            <form action="/dashboard/profesional/servicios" method="POST" class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-8 flex flex-col gap-4 text-left">
              <input type="hidden" name="serviceId" id="service-form-id">
              <h3 class="text-xs font-bold text-[#0A3C84] uppercase tracking-wider" id="service-form-title">Registrar Nuevo Servicio</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="flex flex-col gap-1.5 md:col-span-2">
                  <label class="text-[10px] font-bold text-slate-650">Nombre del Servicio</label>
                  <input type="text" name="nombre" required placeholder="Ej: Consulta general o consulta de valoración" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:border-[#0A3C84] transition">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-[10px] font-bold text-slate-650">Precio de Venta ($ USD)</label>
                  <input type="number" step="0.01" name="precio" placeholder="Ej: 35.00" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:border-[#0A3C84] transition">
                </div>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-650">Descripción detallada</label>
                <textarea name="descripcion" rows="3" placeholder="Ej: Consulta general en medicina interna, incluye receta médica y revisión de exámenes generales." class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:border-[#0A3C84] transition resize-none"></textarea>
              </div>
              
              <div class="flex justify-end gap-2 mt-2 self-end">
                <button type="button" id="service-form-cancel" class="hidden border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-4 rounded-xl transition text-xs cursor-pointer" onclick="cancelServiceEdit()">
                  Cancelar
                </button>
                <button type="submit" id="service-form-btn" class="bg-[#033E8C] hover:bg-[#022A60] text-white font-bold py-2.5 rounded-xl text-xs transition px-4 cursor-pointer">
                  Agregar Servicio <i class="fa-solid fa-plus ml-1"></i>
                </button>
              </div>
            </form>

            <!-- Services Lists -->
            <div class="grid grid-cols-1 gap-4 text-left">
              <% if (profile.services.length > 0) { %>
                <% profile.services.forEach(function(serv) { %>
                  <div class="flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm text-xs group hover:border-slate-200 transition">
                    <div class="flex flex-col gap-1">
                      <span class="font-extrabold text-slate-900 text-sm"><%= serv.nombre %></span>
                      <span class="text-slate-500 font-semibold max-w-md mt-0.5"><%= serv.descripcion || 'Sin descripción' %></span>
                      <span class="font-bold text-[#0A3C84] mt-1">$<%= serv.precio ? serv.precio.toFixed(2) : '0.00' %></span>
                    </div>
                    <div class="flex items-center gap-3 flex-shrink-0">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[9px] font-bold border <%= serv.estado === 'ACTIVO' ? 'bg-emerald-50 text-emerald-600 border-emerald-100' : 'bg-slate-100 text-slate-400 border-slate-200' %>">
                        <%= serv.estado %>
                      </span>
                      <button type="button" 
                              onclick="editService(this)" 
                              data-id="<%= serv.id %>" 
                              data-nombre="<%= serv.nombre.replace(/"/g, '&quot;') %>" 
                              data-precio="<%= serv.precio !== null && serv.precio !== undefined ? serv.precio : '' %>" 
                              data-descripcion="<%= (serv.descripcion || '').replace(/"/g, '&quot;') %>" 
                              class="text-blue-500 hover:text-blue-700 text-sm cursor-pointer p-1" 
                              title="Editar Servicio">
                        <i class="fa-solid fa-pen-to-square"></i>
                      </button>
                      <form action="/dashboard/profesional/servicios/eliminar/<%= serv.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este servicio?');">
                        <button type="submit" class="text-rose-500 hover:text-rose-700 text-sm cursor-pointer p-1">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-solid fa-clipboard-list text-2xl mb-2 text-slate-355 animate-pulse"></i>
                  <span class="text-xs font-bold">No tienes servicios agregados. Registra tu primer servicio arriba.</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- TAB: MIS PRODUCTOS (SRI) -->
          <div id="tab-productos" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            
            <div class="flex justify-between items-start mb-6">
              <div>
                <h2 class="text-xl font-extrabold text-slate-950 mb-1 font-sans leading-none">Catálogo de Productos y Facturación</h2>
                <p class="text-slate-500 text-xs mt-0.5">Administra los productos y servicios autorizados para tu facturación electrónica del SRI y POS.</p>
              </div>
              <button onclick="openProductModal()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-4 rounded-xl text-xs transition flex items-center gap-2 cursor-pointer shadow-sm">
                <i class="fa-solid fa-plus"></i> Agregar Producto
              </button>
            </div>

            <!-- MODAL: AGREGAR / EDITAR PRODUCTO -->
            <div id="product-crud-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-sm p-4">
              <div class="bg-white rounded-3xl border border-slate-100 shadow-2xl w-full max-w-4xl overflow-hidden animate-in fade-in zoom-in duration-250 flex flex-col">
                
                <!-- Header -->
                <div class="flex justify-between items-center px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                  <h3 class="font-extrabold text-slate-900 text-sm md:text-base" id="product-form-title">Registrar Nuevo Producto</h3>
                  <button type="button" onclick="closeProductModal()" class="text-slate-450 hover:text-slate-700 transition cursor-pointer">
                    <i class="fa-solid fa-xmark text-lg"></i>
                  </button>
                </div>

                <!-- Form -->
                <form id="product-crud-form" action="/dashboard/profesional/productos" method="POST" class="flex flex-col flex-1">
                  <input type="hidden" name="productId" id="product-form-id">
                  <input type="hidden" name="codigoAuxiliar" id="product-form-aux">
                  
                  <div class="p-6 overflow-y-auto max-h-[70vh] flex flex-col gap-6 text-left">
                    
                    <!-- Top Row: Image, Code, Name, Desc -->
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                      
                      <!-- Image Picker -->
                      <div class="md:col-span-3 flex flex-col gap-2">
                        <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Imagen (Opcional)</label>
                        <div class="flex flex-col items-center justify-center border-2 border-dashed border-slate-200 rounded-2xl p-4 w-full aspect-square text-center hover:bg-slate-50 transition cursor-pointer relative group overflow-hidden">
                          <input type="file" id="product-image-file" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer">
                          <input type="hidden" name="imagen" id="product-form-image">
                          <img id="product-image-preview" src="" class="hidden w-full h-full object-cover rounded-xl">
                          <div id="product-image-placeholder" class="flex flex-col items-center justify-center gap-1.5 text-slate-450">
                            <i class="fa-solid fa-camera text-2xl text-slate-400 group-hover:scale-110 transition duration-200"></i>
                            <span class="text-[10px] font-bold text-slate-550">Subir foto</span>
                          </div>
                        </div>
                      </div>
                      
                      <!-- Fields -->
                      <div class="md:col-span-9 grid grid-cols-1 sm:grid-cols-12 gap-4">
                        <div class="flex flex-col gap-1.5 sm:col-span-4">
                          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Código</label>
                          <input type="text" name="codigoPrincipal" id="product-form-code" required placeholder="Ej: PRD-01" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-bold outline-none focus:border-[#0A3C84] transition">
                        </div>
                        
                        <div class="flex flex-col gap-1.5 sm:col-span-8">
                          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Nombre del producto</label>
                          <input type="text" name="nombre" id="product-form-name" required placeholder="Ej: Consultoría" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-bold outline-none focus:border-[#0A3C84] transition">
                        </div>

                        <div class="flex flex-col gap-1.5 sm:col-span-12">
                          <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Descripción</label>
                          <textarea name="descripcion" id="product-form-desc" rows="3" placeholder="Detalles adicionales..." class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:border-[#0A3C84] transition"></textarea>
                        </div>
                      </div>

                    </div>

                    <hr class="border-slate-100">

                    <!-- Middle Section: Quantity, Tax, Unit Price, Final Price, Notes, Discount, Summary -->
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                      
                      <!-- Left inputs -->
                      <div class="md:col-span-8 flex flex-col gap-4">
                        
                        <!-- Row 1: Qty, Tax, Prices -->
                        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                          <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Cantidad</label>
                            <input type="number" name="defaultCantidad" id="product-form-qty" value="1" min="0.01" step="0.01" required class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-bold outline-none focus:border-[#0A3C84] transition">
                          </div>
                          
                          <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Impuesto IVA</label>
                            <select name="iva" id="product-form-iva" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3 text-xs font-bold outline-none">
                              <option value="15">IVA 15%</option>
                              <option value="12">IVA 12%</option>
                              <option value="13">IVA 13%</option>
                              <option value="14">IVA 14%</option>
                              <option value="5">IVA 5%</option>
                              <option value="8">IVA 8% FERIADOS</option>
                              <option value="0">IVA 0%</option>
                              <option value="-1">NO OBJETO DE IMP.</option>
                              <option value="-2">EXENTO IVA</option>
                            </select>
                          </div>
                          
                          <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">P. Unit. (Sin IVA)</label>
                            <div class="relative">
                              <span class="absolute left-3 top-2.5 text-xs text-slate-400 font-bold">$</span>
                              <input type="number" name="precio" id="product-form-price" value="0.00" min="0" step="0.01" required class="w-full bg-white border border-slate-200 rounded-xl py-2.5 pl-7 pr-3 text-xs font-bold outline-none focus:border-[#0A3C84] transition">
                            </div>
                          </div>

                          <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">P. Final (Con IVA)</label>
                            <div class="relative">
                              <span class="absolute left-3 top-2.5 text-xs text-slate-400 font-bold">$</span>
                              <input type="number" id="product-form-final-price" value="0.00" step="0.01" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 pl-7 pr-3 text-xs font-bold outline-none focus:border-[#0A3C84] transition">
                            </div>
                          </div>
                        </div>

                        <!-- Row 2: Note 1, Note 2 -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                          <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Nota 1</label>
                            <input type="text" name="defaultNota1" id="product-form-nota1" placeholder="Nota extra del producto en factura" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:border-[#0A3C84] transition">
                          </div>

                          <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Nota 2</label>
                            <input type="text" name="defaultNota2" id="product-form-nota2" placeholder="Nota extra secundaria en factura" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:border-[#0A3C84] transition">
                          </div>
                        </div>

                        <!-- Row 3: Discount -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                          <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Descuento aplicado</label>
                            <div class="relative">
                              <span class="absolute left-3 top-2.5 text-xs text-slate-400 font-bold">$</span>
                              <input type="number" name="defaultDescuento" id="product-form-discount" value="0.00" min="0" step="0.01" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 pl-7 pr-3 text-xs font-bold outline-none focus:border-[#0A3C84] transition">
                            </div>
                          </div>
                        </div>

                      </div>

                      <!-- Right totals panel -->
                      <div class="md:col-span-4 bg-slate-50 border border-slate-100 p-5 rounded-2xl flex flex-col gap-4 text-xs font-bold">
                        <h4 class="text-slate-550 uppercase tracking-wider text-[10px]">Cálculo Proyectado</h4>
                        <div class="flex justify-between items-center text-slate-650 pb-2 border-b border-slate-100">
                          <span>Subtotal</span>
                          <span id="product-calc-subtotal" class="text-slate-900 font-black">$0.00</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-650 pb-2 border-b border-slate-100">
                          <span>Descuento</span>
                          <span id="product-calc-discount" class="text-slate-900 font-black">-$0.00</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-650 pb-2 border-b border-slate-100">
                          <span id="product-calc-iva-label">IVA 15%</span>
                          <span id="product-calc-iva" class="text-slate-900 font-black">+$0.00</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-900 pt-2 text-sm">
                          <span>Total</span>
                          <span id="product-calc-total" class="text-xl font-black text-[#0A3C84]">$0.00</span>
                        </div>
                      </div>

                    </div>

                  </div>

                  <!-- Footer -->
                  <div class="flex justify-end gap-3 px-6 py-4 border-t border-slate-100 bg-slate-50/50">
                    <button type="button" onclick="closeProductModal()" class="border border-slate-250 hover:bg-slate-100 text-slate-705 font-bold py-2.5 px-5 rounded-xl text-xs transition cursor-pointer">
                      Cancelar
                    </button>
                    <button type="submit" id="product-form-btn" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-5 rounded-xl text-xs transition shadow-sm cursor-pointer">
                      Agregar Producto <i class="fa-solid fa-plus ml-1"></i>
                    </button>
                  </div>

                </form>
              </div>
            </div>

            <div class="flex flex-col gap-4 text-left">
              <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider"><i class="fa-solid fa-list text-[#0A3C84] mr-1"></i> Listado de Productos</h3>
              
              <% if (profile.products && profile.products.length > 0) { %>
                <div class="overflow-x-auto bg-white rounded-2xl border border-slate-100 p-4 shadow-sm">
                  <table class="w-full text-left text-xs border-collapse">
                    <thead>
                      <tr class="border-b border-slate-100 font-bold text-slate-500">
                        <th class="pb-3 pl-2">Código</th>
                        <th class="pb-3">Nombre del Producto / Servicio</th>
                        <th class="pb-3">Descripción</th>
                        <th class="pb-3 text-right">Precio Unitario</th>
                        <th class="pb-3 text-center">IVA</th>
                        <th class="pb-3 text-right pr-2">Acciones</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% profile.products.forEach(function(prod) { %>
                        <tr class="border-b border-slate-50 hover:bg-slate-50/40 transition">
                          <td class="py-3 pl-2 font-bold text-[#0A3C84]"><%= prod.codigoPrincipal %></td>
                          <td class="py-3 font-extrabold text-slate-900">
                            <div class="flex items-center gap-2">
                              <% if (prod.imagen) { %>
                                <img src="<%= prod.imagen %>" class="w-7 h-7 rounded-full object-cover border border-slate-150 shadow-sm">
                              <% } else { %>
                                <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 text-[10px]">
                                  <i class="fa-solid fa-box"></i>
                                </div>
                              <% } %>
                              <span><%= prod.nombre %></span>
                            </div>
                          </td>
                          <td class="py-3 text-slate-550 max-w-xs truncate"><%= prod.descripcion || '-' %></td>
                          <td class="py-3 text-right font-black text-slate-950">$<%= prod.precio.toFixed(2) %></td>
                          <td class="py-3 text-center font-bold">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] <%= prod.iva <= 0 ? 'bg-slate-100 text-slate-700' : 'bg-blue-50 text-blue-700' %>">
                              <% if (prod.iva === 15) { %>
                                IVA 15%
                              <% } else if (prod.iva === 12) { %>
                                IVA 12%
                              <% } else if (prod.iva === 13) { %>
                                IVA 13%
                              <% } else if (prod.iva === 14) { %>
                                IVA 14%
                              <% } else if (prod.iva === 5) { %>
                                IVA 5%
                              <% } else if (prod.iva === 8) { %>
                                IVA 8%
                              <% } else if (prod.iva === 0) { %>
                                IVA 0%
                              <% } else if (prod.iva === -1) { %>
                                NO OBJETO
                              <% } else if (prod.iva === -2) { %>
                                EXENTO
                              <% } else { %>
                                <%= prod.iva %>%
                              <% } %>
                            </span>
                          </td>
                          <td class="py-3 text-right pr-2">
                            <div class="flex justify-end gap-2">
                              <button type="button" 
                                      onclick="editProduct('<%= prod.id %>', '<%= prod.codigoPrincipal.replace(/'/g, '\\\'') %>', '<%= (prod.codigoAuxiliar || '').replace(/'/g, '\\\'') %>', '<%= prod.nombre.replace(/"/g, '&quot;') %>', '<%= prod.precio %>', '<%= (prod.iva || 15) %>', '<%= (prod.descripcion || '').replace(/"/g, '&quot;').replace(/\n/g, ' ') %>', '<%= (prod.defaultCantidad || 1) %>', '<%= (prod.defaultDescuento || 0) %>', '<%= (prod.defaultNota1 || '').replace(/'/g, '\\\'') %>', '<%= (prod.defaultNota2 || '').replace(/'/g, '\\\'') %>', '<%= prod.imagen || '' %>')" 
                                      class="text-[#5A7AF3] hover:text-blue-800 text-sm cursor-pointer p-1"
                                      title="Editar Producto">
                                <i class="fa-solid fa-pen-to-square"></i>
                              </button>
                              <form action="/dashboard/profesional/productos/eliminar/<%= prod.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este producto del catálogo?');">
                                <button type="submit" class="text-rose-500 hover:text-rose-700 text-sm cursor-pointer p-1" title="Eliminar Producto">
                                  <i class="fa-solid fa-trash-can"></i>
                                </button>
                              </form>
                            </div>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-solid fa-box-open text-2xl mb-2 text-slate-355 animate-bounce"></i>
                  <span class="text-xs font-bold">No tienes productos en tu catálogo. Registra tu primer producto arriba.</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- TAB: CONFIGURAR HORARIOS -->
          <div id="tab-horario" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <h2 class="text-xl font-extrabold text-slate-950 mb-1 font-sans leading-none">Horarios de Atención</h2>
            <p class="text-slate-500 text-xs mb-8">Define tus horas semanales de atención al público para que puedan reservar citas.</p>

            <form action="/dashboard/profesional/horarios" method="POST" class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-8 flex flex-col gap-4 text-left">
              <h3 class="text-xs font-bold text-[#0A3C84] uppercase tracking-wider">Añadir Rango Horario</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="flex flex-col gap-1.5">
                  <label class="text-[10px] font-bold text-slate-650">Día de la semana</label>
                  <select name="dia" required class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                    <option value="LUNES">Lunes</option>
                    <option value="MARTES">Martes</option>
                    <option value="MIERCOLES">Miércoles</option>
                    <option value="JUEVES">Jueves</option>
                    <option value="VIERNES">Viernes</option>
                    <option value="SABADO">Sábado</option>
                    <option value="DOMINGO">Domingo</option>
                  </select>
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-[10px] font-bold text-slate-650">Hora de Inicio</label>
                  <input type="time" name="horaInicio" required value="08:00" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-[10px] font-bold text-slate-650">Hora de Cierre</label>
                  <input type="time" name="horaFin" required value="17:00" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                </div>
              </div>

              <button type="submit" class="bg-[#033E8C] hover:bg-[#022A60] text-white font-bold py-2.5 rounded-xl text-xs transition px-4 self-end cursor-pointer">
                Agregar Rango <i class="fa-solid fa-plus ml-1"></i>
              </button>
            </form>

            <div class="grid grid-cols-1 gap-2 text-left">
              <% if (profile.schedules.length > 0) { %>
                <% 
                  const orderDays = { LUNES: 1, MARTES: 2, MIERCOLES: 3, JUEVES: 4, VIERNES: 5, SABADO: 6, DOMINGO: 7 };
                  const sortedScheds = [...profile.schedules].sort((a,b) => orderDays[a.dia] - orderDays[b.dia]);
                  sortedScheds.forEach(function(sched) { 
                %>
                  <div class="flex items-center justify-between p-3.5 bg-white border border-slate-100 rounded-2xl text-xs hover:border-slate-200 transition">
                    <div class="flex items-center gap-2">
                      <span class="bg-[#EAEFF8] text-[#033E8C] text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider"><%= sched.dia %></span>
                      <span class="font-extrabold text-slate-800 ml-2"><i class="fa-regular fa-clock text-slate-450 mr-1 text-[10px]"></i> <%= sched.horaInicio %> - <%= sched.horaFin %></span>
                    </div>
                    <form action="/dashboard/profesional/horarios/eliminar/<%= sched.id %>" method="POST">
                      <button type="submit" class="text-rose-500 hover:text-rose-700 text-sm cursor-pointer p-1">
                        <i class="fa-solid fa-times-circle"></i>
                      </button>
                    </form>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-regular fa-calendar-alt text-2xl mb-2 text-slate-355 animate-pulse"></i>
                  <span class="text-xs font-bold">No has definido tus horarios de atención. Agrega rangos arriba.</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- TAB: ARTÍCULOS CIENTÍFICOS -->
          <div id="tab-articulos" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <h2 class="text-xl font-extrabold text-slate-950 mb-1 font-sans leading-none">Artículos Científicos / Académicos</h2>
            <p class="text-slate-500 text-xs mb-8">Comparte publicaciones en formato PDF para dar a conocer tus investigaciones y ganar relevancia en la comunidad.</p>

            <form action="/dashboard/profesional/articulos" method="POST" class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-8 flex flex-col gap-4 text-left">
              <h3 class="text-xs font-bold text-[#0A3C84] uppercase tracking-wider">Subir Nuevo Artículo Científico</h3>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-600">Título del Artículo</label>
                <input type="text" name="titulo" required placeholder="Ej: Análisis de casos de síndrome coronario en adultos jóvenes..." class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:border-[#0A3C84] transition font-semibold text-slate-800">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-600">Resumen (Abstract)</label>
                <textarea name="resumen" rows="4" required placeholder="Resumen corto de los objetivos, metodología y conclusiones principales del artículo..." class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:border-[#0A3C84] transition resize-none"></textarea>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                  <label class="text-[10px] font-bold text-slate-600">Imagen de Portada (Opcional)</label>
                  <div class="flex items-center gap-4">
                    <input type="file" id="art-image-file" accept="image/*" class="text-xs file:bg-white file:border file:border-slate-200 file:px-3 file:py-1.5 file:rounded-lg file:text-[10px] file:font-bold file:cursor-pointer">
                    <input type="hidden" name="imagen" id="art-image-base64">
                  </div>
                </div>
                <div class="flex flex-col gap-2">
                  <label class="text-[10px] font-bold text-slate-600">Archivo PDF Científico (Obligatorio)</label>
                  <div class="flex items-center gap-4">
                    <input type="file" id="art-pdf-file" accept="application/pdf" required class="text-xs file:bg-white file:border file:border-slate-200 file:px-3 file:py-1.5 file:rounded-lg file:text-[10px] file:font-bold file:cursor-pointer">
                    <input type="hidden" name="pdfUrl" id="art-pdf-base64">
                  </div>
                </div>
              </div>

              <button type="submit" id="submit-article-btn" class="bg-[#033E8C] hover:bg-[#022A60] text-white font-bold py-2.5 rounded-xl text-xs transition px-4 self-end cursor-pointer">
                Publicar Artículo <i class="fa-solid fa-cloud-upload-alt ml-1"></i>
              </button>
            </form>

            <!-- Articles lists -->
            <div class="grid grid-cols-1 gap-4 text-left">
              <% if (profile.articles.length > 0) { %>
                <% profile.articles.forEach(function(art) { %>
                  <div class="flex items-center justify-between p-4 bg-white border border-slate-100 rounded-2xl shadow-sm text-xs hover:border-slate-200 transition">
                    <div class="flex flex-col gap-0.5 max-w-md">
                      <span class="font-extrabold text-slate-900 text-sm leading-snug"><%= art.titulo %></span>
                      <span class="text-slate-500 line-clamp-2 mt-1 leading-relaxed"><%= art.resumen %></span>
                      <div class="flex flex-wrap items-center gap-4 mt-2.5 text-[10px] font-bold">
                        <a href="/articulos/leer/<%= art.id %>" class="text-[#0A3C84] hover:text-sky-700 flex items-center gap-1">
                          <i class="fa-solid fa-book-open text-sky-500"></i> Leer en Lector
                        </a>
                        <% 
                          let convBadge = "";
                          let convLabel = "";
                          if (art.conversionStatus === "PENDING") {
                            convBadge = "bg-slate-50 text-slate-500 border-slate-150";
                            convLabel = "Conversión pendiente";
                          } else if (art.conversionStatus === "PROCESSING") {
                            convBadge = "bg-sky-50 text-sky-600 border-sky-150 animate-pulse";
                            convLabel = "Procesando...";
                          } else if (art.conversionStatus === "COMPLETED") {
                            convBadge = "bg-emerald-50 text-emerald-600 border-emerald-150";
                            convLabel = "Lector Activo";
                          } else if (art.conversionStatus === "FAILED") {
                            convBadge = "bg-rose-50 text-rose-600 border-rose-150";
                            convLabel = "Conversión fallida";
                          }
                        %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[8px] font-extrabold uppercase border <%= convBadge %>">
                          <i class="fa-solid fa-arrows-spin mr-1 <%= art.conversionStatus === 'PROCESSING' ? 'animate-spin' : '' %>"></i>
                          <%= convLabel %>
                        </span>
                        <span class="text-slate-400">Publicado: <%= art.createdAt.toDateString() %></span>
                      </div>
                    </div>
                    <div class="flex items-center gap-3 flex-shrink-0">
                      <% 
                        let artBadge = "";
                        if (art.estado === "PENDIENTE") artBadge = "bg-amber-50 text-amber-600 border-amber-100/60";
                        else if (art.estado === "APROBADO") artBadge = "bg-emerald-50 text-emerald-600 border-emerald-100/60";
                        else if (art.estado === "RECHAZADO") artBadge = "bg-rose-50 text-rose-600 border-rose-100/60";
                      %>
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[9px] font-bold border <%= artBadge %>">
                        <%= art.estado %>
                      </span>
                      <form action="/dashboard/profesional/articulos/eliminar/<%= art.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este artículo?');">
                        <button type="submit" class="text-rose-500 hover:text-rose-700 text-sm cursor-pointer p-1">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-solid fa-book-open text-2xl mb-2 text-slate-355 animate-pulse"></i>
                  <span class="text-xs font-bold">No has subido artículos académicos aún. Utiliza el formulario superior.</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- TAB: FORMACIÓN Y CERTIFICACIONES -->
          <div id="tab-educacion" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <h2 class="text-xl font-extrabold text-slate-950 mb-1 font-sans leading-none">Formación y Certificaciones</h2>
            <p class="text-slate-500 text-xs mb-8">Registra tus títulos universitarios, certificaciones internacionales y capacitaciones externas para validar tu perfil público.</p>

            <!-- Formulario para Agregar / Editar Formación -->
            <form id="form-educacion" action="/dashboard/profesional/educacion" method="POST" class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-8 flex flex-col gap-4 text-left">
              <input type="hidden" name="id" id="edu-id" value="">
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Tipo de Registro -->
                <div>
                  <label class="block text-slate-700 text-xs font-bold mb-1">Tipo de Registro <span class="text-rose-500">*</span></label>
                  <select name="tipo" id="edu-tipo" onchange="toggleEduFields()" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-[#0A3C84] transition" required>
                    <option value="TITULO_ACADEMICO">Título Académico (Universidad / Instituto)</option>
                    <option value="CERTIFICACION_INTERNACIONAL">Certificación Internacional</option>
                    <option value="CURSO_SEMINARIO">Curso, Seminario o Taller</option>
                  </select>
                </div>

                <!-- Nombre del Título / Certificado -->
                <div>
                  <label id="lbl-edu-titulo" class="block text-slate-700 text-xs font-bold mb-1">Nombre del Título <span class="text-rose-500">*</span></label>
                  <input type="text" name="titulo" id="edu-titulo" placeholder="Ej: Licenciado en Enfermería / AWS Certified Architect" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-[#0A3C84] transition" required>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Institución / Entidad -->
                <div>
                  <label id="lbl-edu-institucion" class="block text-slate-700 text-xs font-bold mb-1">Universidad / Instituto Tecnológico <span class="text-rose-500">*</span></label>
                  <input type="text" name="institucion" id="edu-institucion" placeholder="Ej: Universidad Central del Ecuador" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-[#0A3C84] transition" required>
                </div>

                <!-- Nivel de Estudio (Solo para Título Académico) -->
                <div id="field-nivel-estudio">
                  <label class="block text-slate-700 text-xs font-bold mb-1">Tipo de Título (Nivel)</label>
                  <select name="nivelEstudio" id="edu-nivelEstudio" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-[#0A3C84] transition">
                    <option value="Tecnológico Superior">Tecnológico Superior</option>
                    <option value="Tercer Nivel (Grado)" selected>Tercer Nivel (Grado)</option>
                    <option value="Especialización">Especialización</option>
                    <option value="Maestría">Maestría</option>
                    <option value="Doctorado">Doctorado</option>
                  </select>
                </div>

                <!-- Tipo de Certificado (Solo para Cursos / Seminarios) -->
                <div id="field-tipo-certificado" class="hidden">
                  <label class="block text-slate-700 text-xs font-bold mb-1">Tipo de Certificado</label>
                  <select name="tipoCertificado" id="edu-tipoCertificado" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-[#0A3C84] transition">
                    <option value="APROBACION" selected>Aprobación</option>
                    <option value="ASISTENCIA">Asistencia</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Horas Académicas (Opcional para Cursos) -->
                <div id="field-horas" class="hidden">
                  <label class="block text-slate-700 text-xs font-bold mb-1">Horas Académicas (Opcional)</label>
                  <input type="number" name="horas" id="edu-horas" placeholder="Ej: 40" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-[#0A3C84] transition" min="0">
                </div>

                <!-- Año de Emisión -->
                <div>
                  <label class="block text-slate-700 text-xs font-bold mb-1">Año de Emisión / Graduación <span class="text-rose-500">*</span></label>
                  <input type="number" name="anioEmision" id="edu-anioEmision" placeholder="Ej: 2022" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-[#0A3C84] transition" required min="1950" max="2030" value="<%= new Date().getFullYear() %>">
                </div>
              </div>

              <!-- Carga de Fotografía del Título / Certificado (OBLIGATORIA) -->
              <div>
                <label class="block text-slate-700 text-xs font-bold mb-1">Fotografía / Scan del Título o Certificado <span class="text-rose-500">* (Obligatorio)</span></label>
                <input type="hidden" name="imagen" id="edu-imagen" required>
                
                <div class="flex items-center gap-4">
                  <input type="file" id="edu-file-input" accept="image/*" onchange="handleEduImageUpload(this)" class="hidden">
                  <button type="button" onclick="document.getElementById('edu-file-input').click()" class="bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-upload"></i> Subir Imagen
                  </button>
                  <span id="edu-image-status" class="text-slate-400 text-xs font-semibold">Ningún archivo seleccionado</span>
                </div>

                <!-- Preview de la imagen -->
                <div id="edu-preview-container" class="mt-3 hidden">
                  <img id="edu-preview-img" src="" alt="Vista Previa" class="h-28 rounded-xl border border-slate-200 object-cover shadow-sm">
                </div>
              </div>

              <div class="flex items-center justify-end gap-3 mt-2">
                <button type="button" id="btn-cancel-edu" onclick="resetEduForm()" class="hidden bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-5 py-2.5 rounded-xl text-xs transition cursor-pointer">
                  Cancelar
                </button>
                <button type="submit" id="btn-save-edu" class="bg-[#0A3C84] hover:bg-[#08306b] text-white font-extrabold px-6 py-2.5 rounded-xl text-xs transition shadow-sm cursor-pointer">
                  Guardar Registro <i class="fa-solid fa-plus ml-1"></i>
                </button>
              </div>
            </form>

            <!-- Lista de Registros de Formación -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
              <% if (profile.education && profile.education.length > 0) { %>
                <% profile.education.forEach(function(edu) { %>
                  <div class="border border-slate-200 rounded-2xl p-4 flex flex-col justify-between bg-white hover:border-[#0A3C84]/30 transition group shadow-sm">
                    <div class="flex gap-3">
                      <!-- Cover Image -->
                      <img src="<%= edu.imagen %>" alt="<%= edu.titulo %>" class="w-16 h-16 rounded-xl object-cover border border-slate-100 flex-shrink-0 shadow-sm">
                      <div class="flex flex-col justify-center">
                        <div class="flex items-center gap-1.5 mb-1">
                          <% if (edu.tipo === 'TITULO_ACADEMICO') { %>
                            <span class="bg-blue-50 text-[#0A3C84] border border-blue-100 text-[9px] font-bold px-2 py-0.5 rounded">Título Académico</span>
                            <% if (edu.nivelEstudio) { %>
                              <span class="text-[9px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded"><%= edu.nivelEstudio %></span>
                            <% } %>
                          <% } else if (edu.tipo === 'CERTIFICACION_INTERNACIONAL') { %>
                            <span class="bg-emerald-50 text-emerald-700 border border-emerald-100 text-[9px] font-bold px-2 py-0.5 rounded">Certificación Intl.</span>
                          <% } else if (edu.tipo === 'PROYECTO_ESTUDIANTIL') { %>
                            <span class="bg-violet-50 text-violet-700 border border-violet-100 text-[9px] font-bold px-2 py-0.5 rounded">Proyecto Estudiantil</span>
                          <% } else if (edu.tipo === 'EXPERIENCIA_LABORAL') { %>
                            <span class="bg-orange-50 text-orange-700 border border-orange-100 text-[9px] font-bold px-2 py-0.5 rounded">Experiencia Laboral</span>
                          <% } else if (edu.tipo === 'PASANTIA_PREPROFESIONAL') { %>
                            <span class="bg-teal-50 text-teal-700 border border-teal-100 text-[9px] font-bold px-2 py-0.5 rounded">Pasantía Preprofesional</span>
                          <% } else { %>
                            <span class="bg-amber-50 text-amber-700 border border-amber-100 text-[9px] font-bold px-2 py-0.5 rounded">Curso / Seminario</span>
                          <% } %>
                        </div>
                        <h4 class="font-extrabold text-slate-900 text-xs line-clamp-1"><%= edu.titulo %></h4>
                        <p class="text-slate-500 text-[10px] font-semibold"><%= edu.institucion %> • <%= edu.anioEmision %></p>
                      </div>
                    </div>

                    <div class="flex items-center justify-between pt-3 border-t border-slate-100 mt-3">
                      <span class="text-[10px] text-slate-400 font-mono">ID: #<%= edu.id %></span>
                      <div class="flex items-center gap-2">
                        <button type="button" 
                                onclick="editEducation(this)" 
                                data-id="<%= edu.id %>" 
                                data-tipo="<%= edu.tipo %>" 
                                data-titulo="<%= edu.titulo.replace(/"/g, '&quot;') %>" 
                                data-institucion="<%= edu.institucion.replace(/"/g, '&quot;') %>" 
                                data-nivelestudio="<%= (edu.nivelEstudio || '').replace(/"/g, '&quot;') %>" 
                                data-tipocertificado="<%= (edu.tipoCertificado || '').replace(/"/g, '&quot;') %>" 
                                data-horas="<%= edu.horas || '' %>" 
                                data-anioemision="<%= edu.anioEmision %>" 
                                data-imagen="<%= edu.imagen %>" 
                                class="text-blue-500 hover:text-blue-700 text-xs cursor-pointer p-1" 
                                title="Editar">
                          <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                        <form action="/dashboard/profesional/educacion/eliminar/<%= edu.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este registro?');">
                          <button type="submit" class="text-rose-500 hover:text-rose-700 text-xs cursor-pointer p-1" title="Eliminar">
                            <i class="fa-solid fa-trash-can"></i>
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="col-span-2 text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-solid fa-graduation-cap text-2xl mb-2 text-slate-300"></i>
                  <span class="text-xs font-bold">No has registrado títulos o certificaciones externas aún. Completa el formulario arriba.</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- TAB: AGENDA DE CITAS -->
          <div id="tab-citas" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <h2 class="text-xl font-extrabold text-slate-950 mb-1 font-sans leading-none">Agenda de Citas Recibidas</h2>
            <p class="text-slate-500 text-xs mb-8">Administra tus reservaciones pendientes, citas confirmadas e historial de atención.</p>

            <div class="overflow-x-auto text-left">
              <% if (profile.appointments.length > 0) { %>
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr class="border-b border-slate-100 text-slate-500 font-bold uppercase tracking-wider text-[9px] pb-3">
                      <th class="pb-3 font-bold">Cliente</th>
                      <th class="pb-3 font-bold">Fecha / Hora</th>
                      <th class="pb-3 font-bold">Motivo de la Cita</th>
                      <th class="pb-3 font-bold">Estado</th>
                      <th class="pb-3 text-right font-bold">Cambiar Estado</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% profile.appointments.forEach(function(cita) { %>
                      <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                        <td class="py-4">
                          <div class="flex flex-col gap-0.5">
                            <span class="font-extrabold text-slate-950 text-xs"><%= cita.nombre %></span>
                            <span class="text-[10px] text-slate-450 font-semibold mt-0.5">Telf: <%= cita.telefono %></span>
                            <span class="text-[10px] text-slate-450 font-semibold">Email: <%= cita.correo %></span>
                          </div>
                        </td>
                        <td class="py-4 font-medium text-slate-900">
                          <div class="flex flex-col gap-0.5">
                            <span class="font-bold text-slate-800 text-xs"><i class="fa-regular fa-calendar text-[10px] text-slate-400"></i> <%= cita.fecha %></span>
                            <span class="text-slate-500 font-semibold text-[10px] mt-0.5"><i class="fa-regular fa-clock text-[10px] text-slate-400"></i> <%= cita.hora %></span>
                          </div>
                        </td>
                        <td class="py-4 text-slate-650 max-w-[200px] truncate font-medium">
                          <%= cita.motivo || 'Consulta general de evaluación' %>
                        </td>
                        <td class="py-4">
                          <% 
                            let badg = "";
                            if (cita.estado === "PENDIENTE") badg = "bg-amber-50 text-amber-600 border-amber-100/60";
                            else if (cita.estado === "CONFIRMADA") badg = "bg-emerald-50 text-emerald-600 border-emerald-100/60";
                            else if (cita.estado === "REPROGRAMADA") badg = "bg-sky-50 text-sky-600 border-sky-100/60";
                            else if (cita.estado === "ATENDIDA") badg = "bg-slate-100 text-slate-600 border-slate-200/60";
                            else if (cita.estado === "CANCELADA") badg = "bg-rose-50 text-rose-600 border-rose-100/60";
                          %>
                          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold border <%= badg %>">
                            <%= cita.estado %>
                          </span>
                        </td>
                        <td class="py-4 text-right">
                          <div class="flex items-center justify-end gap-1.5">
                            <% if (cita.estado !== 'ATENDIDA' && cita.estado !== 'CANCELADA') { %>
                              <form action="/dashboard/profesional/citas/estado/<%= cita.id %>" method="POST" class="inline">
                                <input type="hidden" name="estado" value="CONFIRMADA">
                                <button type="submit" title="Confirmar Cita" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-200 rounded-lg p-1.5 cursor-pointer text-xs transition">
                                  <i class="fa-solid fa-calendar-check"></i>
                                </button>
                              </form>
                              <form action="/dashboard/profesional/citas/estado/<%= cita.id %>" method="POST" class="inline">
                                <input type="hidden" name="estado" value="ATENDIDA">
                                <button type="submit" title="Marcar como Atendida" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-250 rounded-lg p-1.5 cursor-pointer text-xs transition">
                                  <i class="fa-solid fa-check-circle"></i>
                                </button>
                              </form>
                              <button type="button" onclick="openRescheduleModal('<%= cita.id %>', '<%= cita.fecha %>', '<%= cita.hora %>')" title="Reprogramar Cita" class="bg-sky-50 hover:bg-sky-100 text-sky-600 border border-sky-200 rounded-lg p-1.5 cursor-pointer text-xs transition">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                              </button>
                              <form action="/dashboard/profesional/citas/estado/<%= cita.id %>" method="POST" class="inline">
                                <input type="hidden" name="estado" value="CANCELADA">
                                <button type="submit" title="Cancelar Cita" class="bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-lg p-1.5 cursor-pointer text-xs transition" onsubmit="return confirm('¿Seguro de cancelar esta cita?');">
                                  <i class="fa-solid fa-times-circle"></i>
                                </button>
                              </form>
                            <% } else { %>
                              <span class="text-slate-400 font-bold">-</span>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              <% } else { %>
                <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-regular fa-clock text-2xl mb-2 text-slate-355 animate-pulse"></i>
                  <span class="text-xs font-bold">No tienes solicitudes de citas registradas aún.</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- TAB: FACTURACIÓN SRI -->
          <div id="tab-facturacion" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-50 pb-4 mb-6">
              <div>
                <h2 class="text-xl font-extrabold text-slate-950 font-sans leading-none">Módulo de Facturación SRI</h2>
                <p class="text-slate-500 text-xs mt-1.5">Envía tus facturas de servicios directamente al SRI y firma con tu archivo digital `.p12`.</p>
              </div>
              <button type="button" onclick="openIssuerConfigModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2.5 px-4 rounded-xl text-xs transition flex items-center gap-1.5 cursor-pointer shadow-sm">
                <i class="fa-solid fa-gear text-[#0A3C84]"></i> Configurar Emisor
              </button>
            </div>

            <!-- BANNER DE ESTADO Y CUOTA DE FACTURACIÓN ELECTRÓNICA -->
            <% if (typeof invoiceQuota !== 'undefined' && invoiceQuota) { %>
              <div class="mb-6 p-5 rounded-2xl border transition shadow-sm <%= invoiceQuota.isUnlimited ? 'bg-emerald-50/60 border-emerald-200' : (invoiceQuota.available === 0 ? 'bg-rose-50/70 border-rose-200' : 'bg-slate-50 border-slate-200') %>">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center text-xl flex-shrink-0 <%= invoiceQuota.isUnlimited ? 'bg-emerald-500 text-white shadow-emerald-200 shadow-md' : (invoiceQuota.available === 0 ? 'bg-rose-500 text-white shadow-rose-200 shadow-md' : 'bg-[#0A3C84] text-white shadow-blue-200 shadow-md') %>">
                      <i class="fa-solid <%= invoiceQuota.isUnlimited ? 'fa-infinity' : (invoiceQuota.available === 0 ? 'fa-circle-exclamation' : 'fa-receipt') %>"></i>
                    </div>
                    <div>
                      <div class="flex items-center gap-2">
                        <span class="text-xs font-black uppercase tracking-wider text-slate-800">Capacidad de Facturación SRI</span>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold <%= invoiceQuota.isUnlimited ? 'bg-emerald-100 text-emerald-800' : (invoiceQuota.available === 0 ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800') %>">
                          <%= invoiceQuota.source %>
                        </span>
                      </div>
                      <p class="text-xs text-slate-600 font-medium mt-1">
                        <% if (invoiceQuota.isUnlimited) { %>
                          Tienes <strong class="text-emerald-700 font-extrabold">Facturación Electrónica ILIMITADA</strong> activada.
                        <% } else { %>
                          Has emitido <strong class="text-slate-900 font-bold"><%= invoiceQuota.used %></strong> de <strong class="text-slate-900 font-bold"><%= invoiceQuota.limit %></strong> facturas autorizadas en tu plan.
                        <% } %>
                      </p>
                    </div>
                  </div>

                  <div class="flex items-center gap-3">
                    <% if (!invoiceQuota.isUnlimited) { %>
                      <div class="text-right hidden md:block mr-2">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Disponibles</span>
                        <span class="text-lg font-black <%= invoiceQuota.available === 0 ? 'text-rose-600' : 'text-[#0A3C84]' %>"><%= invoiceQuota.available %></span>
                      </div>
                    <% } %>
                    
                    <button type="button" onclick="openBillingPlansModal()" class="bg-[#0A3C84] hover:bg-[#08306b] text-white text-xs font-bold py-2.5 px-4 rounded-xl transition shadow-sm flex items-center gap-2 cursor-pointer">
                      <i class="fa-solid fa-rocket text-amber-300"></i> Ampliar Plan / Comprar Facturas
                    </button>
                  </div>
                </div>

                <% if (!invoiceQuota.isUnlimited) { %>
                  <div class="w-full bg-slate-200 h-2 rounded-full mt-4 overflow-hidden">
                    <% const pct = Math.min(100, Math.round((invoiceQuota.used / invoiceQuota.limit) * 100)); %>
                    <div class="h-full transition-all duration-500 <%= pct >= 100 ? 'bg-rose-500' : (pct >= 80 ? 'bg-amber-500' : 'bg-[#0A3C84]') %>" style="width: <%= pct %>%;"></div>
                  </div>
                <% } %>
              </div>
            <% } %>

            <!-- Subtabs for Invoicing -->
            <div class="flex flex-wrap gap-4 border-b border-slate-100 pb-3 mb-6 text-xs font-bold text-left">
              <button onclick="showSubTab('sri-pos')" id="btn-sri-pos" class="subtab-btn text-[#0A3C84] cursor-pointer">
                1. Punto de Venta (POS)
              </button>
              <button onclick="showSubTab('sri-emit')" id="btn-sri-emit" class="subtab-btn text-slate-500 hover:text-slate-900 cursor-pointer">
                2. Emitir Factura
              </button>
              <button onclick="showSubTab('sri-history')" id="btn-sri-history" class="subtab-btn text-slate-500 hover:text-slate-900 cursor-pointer">
                3. Historial de Facturas
              </button>
            </div>

            <!-- Subtab CONTENT: sri-emit -->
            <div id="subtab-sri-emit" class="subtab-content hidden flex flex-col gap-6 text-left">
              <% if (!profile.issuer || !profile.issuer.firmaElectronica) { %>
                <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-solid fa-triangle-exclamation text-2xl mb-2 text-amber-500"></i>
                  <span class="text-xs font-bold mb-1">Firma electrónica o emisor no configurado</span>
                  <span class="text-[10px] max-w-sm">Antes de emitir una factura, completa la pestaña de **Configuración de Emisor** y sube tu firma digital `.p12`.</span>
                </div>
              <% } else { %>
                <form id="form-emit-invoice" action="/dashboard/profesional/facturacion/emitir" method="POST" class="flex flex-col gap-6">
                  <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-4"><i class="fa-solid fa-user-tag text-[#0A3C84] mr-1"></i> Información del Cliente</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                      <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-650">Tipo de Documento</label>
                        <select name="client_tipoIdentificacion" required class="w-full bg-white border border-slate-100 rounded-xl py-2 px-3 text-xs outline-none">
                          <option value="05" selected>Cédula</option>
                          <option value="04">RUC (13 dígitos)</option>
                          <option value="06">Pasaporte</option>
                          <option value="07">Consumidor Final</option>
                        </select>
                      </div>
                      <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-650">Identificación (Cédula/RUC)</label>
                        <input type="text" name="client_identificacion" required placeholder="Ej: 1104829304" class="w-full bg-white border border-slate-100 rounded-xl py-2 px-3 text-xs outline-none">
                      </div>
                      <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-650">Razón Social / Nombre Completo</label>
                        <input type="text" name="client_nombres" required placeholder="Ej: Juan Pérez" class="w-full bg-white border border-slate-100 rounded-xl py-2 px-3 text-xs outline-none">
                      </div>
                      <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-650">Dirección</label>
                        <input type="text" name="client_direccion" required placeholder="Ej: Calle Olmedo y Rocafuerte" class="w-full bg-white border border-slate-100 rounded-xl py-2 px-3 text-xs outline-none">
                      </div>
                      <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-650">Correo Electrónico</label>
                        <input type="email" name="client_mail" required placeholder="Ej: juan@mail.com" class="w-full bg-white border border-slate-100 rounded-xl py-2 px-3 text-xs outline-none">
                      </div>
                      <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-650">Número de Celular</label>
                        <input type="text" name="client_celular" required placeholder="Ej: 0999999999" class="w-full bg-white border border-slate-100 rounded-xl py-2 px-3 text-xs outline-none">
                      </div>
                    </div>
                  </div>

                  <div class="bg-slate-50 p-5 rounded-2xl border border-slate-100">
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-4"><i class="fa-solid fa-list-check text-[#0A3C84] mr-1"></i> Detalle de la Factura</h3>
                    
                    <!-- Toggle Concepto no Registrado -->
                    <% if (profile.products && profile.products.length > 0) { %>
                      <div class="flex items-center gap-2 mb-4 bg-white p-3.5 rounded-xl border border-slate-100/80">
                        <input type="checkbox" id="toggle-manual-item" class="w-4 h-4 text-[#0A3C84] rounded border-slate-200 focus:ring-[#0A3C84] cursor-pointer" onchange="toggleManualItemFields()">
                        <label for="toggle-manual-item" class="text-xs font-bold text-slate-750 cursor-pointer select-none">
                          ¿El producto/servicio no está registrado en el catálogo? (Ingreso manual)
                        </label>
                      </div>
                    <% } else { %>
                      <!-- Auto-checked and hidden/disabled toggle when no products exist -->
                      <input type="checkbox" id="toggle-manual-item" checked class="hidden" onchange="toggleManualItemFields()">
                      <div class="mb-4 bg-amber-50 border border-amber-100 p-3.5 rounded-xl text-amber-800 text-[11px] flex items-center gap-2">
                        <i class="fa-solid fa-info-circle text-amber-600 text-sm"></i>
                        <span>No tienes productos en tu catálogo. Ingresa los detalles manualmente a continuación o regístralos en la sección <strong>Mis Productos</strong>.</span>
                      </div>
                    <% } %>

                    <div class="flex flex-col gap-4 text-xs font-semibold">
                      <!-- Row for adding items -->
                      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                        
                        <!-- Catalog Select (only if profile products exist) -->
                        <% if (profile.products && profile.products.length > 0) { %>
                          <div id="catalog-fields" class="flex flex-col gap-1.5 md:col-span-6">
                            <label class="text-[10px] font-bold text-slate-650">Producto / Servicio de tu Catálogo</label>
                            <select id="invoice-service-select" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none font-medium">
                              <option value="" disabled selected>-- Selecciona un producto --</option>
                              <% profile.products.forEach(function(prod) { %>
                                <option value="<%= prod.id %>" data-price="<%= prod.precio %>" data-name="<%= prod.nombre %>" data-iva="<%= prod.iva %>" data-qty="<%= prod.defaultCantidad || 1 %>" data-discount="<%= prod.defaultDescuento || 0 %>" data-nota1="<%= prod.defaultNota1 || '' %>" data-nota2="<%= prod.defaultNota2 || '' %>">
                                  <%= prod.nombre %> ($<%= prod.precio ? prod.precio.toFixed(2) : '0.00' %>) [<%= prod.iva === -1 ? 'NO OBJETO' : (prod.iva === -2 ? 'EXENTO' : 'IVA ' + prod.iva + '%') %>]
                                </option>
                              <% }); %>
                            </select>
                          </div>
                        <% } %>

                        <!-- Manual Fields (hidden by default unless toggle is checked or no catalog products exist) -->
                        <div id="manual-fields" class="<%= (profile.products && profile.products.length > 0) ? 'hidden' : '' %> md:col-span-6 grid grid-cols-1 sm:grid-cols-12 gap-4">
                          <div class="flex flex-col gap-1.5 sm:col-span-6">
                            <label class="text-[10px] font-bold text-slate-650">Descripción / Concepto del Servicio</label>
                            <input type="text" id="manual-item-name" placeholder="Ej: Consulta de Especialidad" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                          </div>
                          <div class="flex flex-col gap-1.5 sm:col-span-3">
                            <label class="text-[10px] font-bold text-slate-650">Precio Unitario ($)</label>
                            <input type="number" step="0.01" id="manual-item-price" placeholder="Ej: 50.00" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                          </div>
                          <div class="flex flex-col gap-1.5 sm:col-span-3">
                            <label class="text-[10px] font-bold text-slate-650">IVA</label>
                            <select id="manual-item-iva" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3 text-xs outline-none">
                              <option value="12" selected>12%</option>
                              <option value="0">0%</option>
                            </select>
                          </div>
                        </div>

                        <!-- Quantity -->
                        <div class="flex flex-col gap-1.5 md:col-span-2">
                          <label class="text-[10px] font-bold text-slate-650 text-center">Cantidad</label>
                          <input type="number" id="invoice-qty" value="1" min="1" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none text-center">
                        </div>

                        <!-- Add button -->
                        <div class="md:col-span-4">
                          <button type="button" onclick="addInvoiceItem()" class="w-full bg-[#033E8C] hover:bg-[#022A60] text-white font-bold py-2.5 px-4 rounded-xl text-xs cursor-pointer h-[40px] flex items-center justify-center gap-1.5 shadow-sm">
                            <i class="fa-solid fa-plus"></i> Añadir Item
                          </button>
                        </div>

                      </div>

                      <!-- Selected Items Table -->
                      <div class="overflow-x-auto mt-4 bg-white rounded-xl border border-slate-100 p-4">
                        <table class="w-full text-left text-xs border-collapse">
                          <thead>
                            <tr class="border-b border-slate-100 font-bold text-slate-500">
                              <th class="pb-2">Servicio / Descripción</th>
                              <th class="pb-2 text-right">Cantidad</th>
                              <th class="pb-2 text-right">Precio Unitario</th>
                              <th class="pb-2 text-right">Descuento</th>
                              <th class="pb-2 text-right">Impuestos</th>
                              <th class="pb-2 text-right">Subtotal</th>
                              <th class="pb-2 text-right">Acción</th>
                            </tr>
                          </thead>
                          <tbody id="invoice-items-body">
                            <!-- Injected JS -->
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>

                  <!-- Calculations and Totals -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-slate-50 p-5 rounded-2xl border border-slate-100 text-xs">
                    <div class="flex flex-col gap-4">
                      <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider"><i class="fa-solid fa-credit-card text-[#0A3C84] mr-1"></i> Forma de Pago</h3>
                      <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-650">Método de pago SRI</label>
                        <select name="formaPago" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                          <option value="01" selected>Sin utilización del sistema financiero (Efectivo/Caja)</option>
                          <option value="20">Otros con utilización del sistema financiero (Transferencia)</option>
                          <option value="19">Tarjeta de Crédito</option>
                          <option value="16">Tarjeta de Débito</option>
                        </select>
                      </div>
                      <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-650">Observaciones</label>
                        <input type="text" name="observaciones" placeholder="Ej: Servicios de consulta médica" class="w-full bg-white border border-slate-100 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                      </div>
                    </div>

                    <div class="flex flex-col gap-3 justify-end items-end pr-4 text-xs font-bold text-slate-800">
                      <div class="flex justify-between w-64 border-b border-slate-200 pb-1.5">
                        <span class="text-slate-500 font-semibold">Subtotal 0%:</span>
                        <span id="invoice-subtotal0">$0.00</span>
                        <input type="hidden" name="subtotal0" id="inp-subtotal0" value="0">
                      </div>
                      <div class="flex justify-between w-64 border-b border-slate-200 pb-1.5">
                        <span class="text-slate-500 font-semibold">Subtotal 12%:</span>
                        <span id="invoice-subtotal12">$0.00</span>
                        <input type="hidden" name="subtotalIva" id="inp-subtotal12" value="0">
                      </div>
                      <div class="flex justify-between w-64 border-b border-slate-200 pb-1.5">
                        <span class="text-slate-500 font-semibold">IVA 12%:</span>
                        <span id="invoice-valiva">$0.00</span>
                        <input type="hidden" name="valorIva" id="inp-valiva" value="0">
                      </div>
                      <div class="flex justify-between w-64 pt-1.5 text-sm text-slate-950">
                        <span>Importe Total:</span>
                        <span id="invoice-total" class="font-black text-[#0A3C84]">$0.00</span>
                        <input type="hidden" name="total" id="inp-total" value="0">
                      </div>

                      <input type="hidden" name="items" id="inp-invoice-items-json" value="[]">

                      <button type="button" onclick="submitInvoiceForm()" id="btn-submit-invoice" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3 px-6 rounded-xl text-xs transition shadow-md mt-4 flex items-center gap-1.5 cursor-pointer">
                        Firmar y Autorizar en SRI <i class="fa-solid fa-cloud-upload-alt text-sky-400"></i>
                      </button>
                    </div>
                  </div>
                </form>
              <% } %>
            </div>

            <!-- Subtab CONTENT: sri-pos -->
            <div id="subtab-sri-pos" class="subtab-content hidden flex flex-col gap-6 text-left">
              <% if (!profile.issuer || !profile.issuer.firmaElectronica) { %>
                <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-solid fa-triangle-exclamation text-2xl mb-2 text-amber-500"></i>
                  <span class="text-xs font-bold mb-1">Firma electrónica o emisor no configurado</span>
                  <span class="text-[10px] max-w-sm">Antes de emitir una factura, completa la pestaña de **Configuración de Emisor** y sube tu firma digital `.p12`.</span>
                </div>
              <% } else { %>
                <form id="form-emit-invoice-pos" action="/dashboard/profesional/facturacion/emitir" method="POST" class="flex flex-col gap-6">
                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                    
                    <!-- Left Panel: POS Grid (7 cols) -->
                    <div class="lg:col-span-7 flex flex-col gap-4">
                      <div class="flex justify-between items-center bg-slate-50 border border-slate-100 rounded-2xl p-4">
                        <div>
                          <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Productos / Servicios en Catálogo</h3>
                          <p class="text-[10px] text-slate-500 mt-0.5">Haz clic sobre un servicio para agregarlo al ticket de venta.</p>
                        </div>
                        <button type="button" onclick="posClearCart()" class="text-rose-500 hover:text-rose-700 text-xs font-bold transition flex items-center gap-1 cursor-pointer">
                          <i class="fa-solid fa-trash-can"></i> Vaciar Ticket
                        </button>
                      </div>

                      <% if (profile.products && profile.products.length > 0) { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                          <% profile.products.forEach(function(prod) { %>
                            <div onclick="posAddItem('<%= prod.id %>', '<%= prod.nombre.replace(/"/g, '&quot;') %>', <%= prod.precio || 0 %>, <%= prod.iva || 12 %>)" 
                                 class="pos-service-card bg-white hover:bg-slate-50/50 border border-slate-100 hover:border-slate-300 rounded-2xl p-4 shadow-sm cursor-pointer transition flex flex-col justify-between gap-4 relative group">
                              <div class="flex flex-col gap-1">
                                <span class="text-[9px] font-bold text-slate-400 bg-slate-100 self-start px-2 py-0.5 rounded-full"><%= prod.codigoPrincipal %></span>
                                <h4 class="font-extrabold text-slate-900 text-xs sm:text-sm group-hover:text-[#0A3C84] transition mt-1"><%= prod.nombre %></h4>
                                <p class="text-[10px] text-slate-500 line-clamp-2 leading-relaxed"><%= prod.descripcion || 'Sin descripción' %></p>
                              </div>
                              <div class="flex justify-between items-center pt-2 border-t border-slate-50">
                                <div class="flex flex-col">
                                  <span class="font-black text-xs sm:text-sm text-[#0A3C84]">$<%= prod.precio ? prod.precio.toFixed(2) : '0.00' %></span>
                                  <span class="text-[9px] text-slate-400 font-semibold">IVA <%= prod.iva %>%</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                  <span id="pos-badge-<%= prod.id %>" class="pos-badge hidden bg-[#0A3C84] text-white text-[9px] font-black px-2 py-0.5 rounded-full">0</span>
                                  <span class="text-[10px] font-bold text-slate-400 group-hover:text-[#0A3C84] transition"><i class="fa-solid fa-plus-circle"></i></span>
                                </div>
                              </div>
                            </div>
                          <% }); %>
                        </div>
                      <% } else { %>
                        <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                          <i class="fa-solid fa-box-open text-2xl mb-2 text-slate-355 animate-bounce"></i>
                          <span class="text-xs font-bold mb-1">Tu catálogo de productos está vacío</span>
                          <span class="text-[10px]">Crea productos en la pestaña **Mis Productos (SRI)** para poder usar el POS.</span>
                        </div>
                      <% } %>
                    </div>

                    <!-- Right Panel: Ticket & Client Selector (5 cols) -->
                    <div class="lg:col-span-5 flex flex-col gap-6 bg-slate-50 border border-slate-100 p-5 rounded-2xl">
                      
                      <!-- Customer Section -->
                      <div>
                        <div class="flex justify-between items-center mb-3">
                          <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider"><i class="fa-solid fa-user-tag text-[#0A3C84]"></i> Cliente</h3>
                          <button type="button" onclick="posFillFinalConsumer()" class="bg-[#5A7AF3] hover:bg-[#4765E2] text-white text-[9px] font-bold px-2.5 py-1.5 rounded-lg transition cursor-pointer">
                            <i class="fa-solid fa-users"></i> Consumidor Final
                          </button>
                        </div>

                        <div class="flex flex-col gap-3">
                          <div class="grid grid-cols-2 gap-2">
                            <div class="flex flex-col gap-1">
                              <label class="text-[9px] font-bold text-slate-650">Tipo Documento</label>
                              <select name="client_tipoIdentificacion" id="pos-client-tipo" required class="w-full bg-white border border-slate-100 rounded-lg py-1.5 px-2 text-[11px] outline-none">
                                <option value="05" selected>Cédula</option>
                                <option value="04">RUC (13 dígitos)</option>
                                <option value="06">Pasaporte</option>
                                <option value="07">Consumidor Final</option>
                              </select>
                            </div>
                            <div class="flex flex-col gap-1">
                              <label class="text-[9px] font-bold text-slate-650">Identificación</label>
                              <input type="text" name="client_identificacion" id="pos-client-id" required placeholder="Ej: 1104829304" class="w-full bg-white border border-slate-100 rounded-lg py-1.5 px-2 text-[11px] outline-none">
                            </div>
                          </div>

                          <div class="flex flex-col gap-1">
                            <label class="text-[9px] font-bold text-slate-650">Razón Social / Nombre Completo</label>
                            <input type="text" name="client_nombres" id="pos-client-name" required placeholder="Ej: Juan Pérez" class="w-full bg-white border border-slate-100 rounded-lg py-1.5 px-2 text-[11px] outline-none">
                          </div>

                          <div class="grid grid-cols-2 gap-2">
                            <div class="flex flex-col gap-1">
                              <label class="text-[9px] font-bold text-slate-650">Dirección</label>
                              <input type="text" name="client_direccion" id="pos-client-dir" required placeholder="Ej: Av. Cuxibamba" class="w-full bg-white border border-slate-100 rounded-lg py-1.5 px-2 text-[11px] outline-none">
                            </div>
                            <div class="flex flex-col gap-1">
                              <label class="text-[9px] font-bold text-slate-650">Correo</label>
                              <input type="email" name="client_mail" id="pos-client-mail" required placeholder="Ej: cliente@mail.com" class="w-full bg-white border border-slate-100 rounded-lg py-1.5 px-2 text-[11px] outline-none">
                            </div>
                          </div>

                          <div class="flex flex-col gap-1">
                            <label class="text-[9px] font-bold text-slate-650">Celular</label>
                            <input type="text" name="client_celular" id="pos-client-phone" required placeholder="Ej: 0999999999" class="w-full bg-white border border-slate-100 rounded-lg py-1.5 px-2 text-[11px] outline-none">
                          </div>
                        </div>
                      </div>

                      <!-- Ticket Summary Section -->
                      <div class="border-t border-slate-200 pt-4 flex flex-col gap-3">
                        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider"><i class="fa-solid fa-receipt text-[#0A3C84]"></i> Resumen del Ticket</h3>
                        
                        <div class="max-h-40 overflow-y-auto bg-white border border-slate-100 rounded-xl p-3 flex flex-col gap-2">
                          <div id="pos-ticket-empty" class="text-center py-6 text-slate-400 text-[10px] font-bold">
                            Ningún servicio en el ticket.
                          </div>
                          <div id="pos-ticket-list" class="flex flex-col gap-2.5">
                            <!-- Injected JS -->
                          </div>
                        </div>
                      </div>

                      <!-- Payment & Submit Section -->
                      <div class="border-t border-slate-200 pt-4 flex flex-col gap-3">
                        <div class="flex flex-col gap-1">
                          <label class="text-[9px] font-bold text-slate-650 font-bold">Método de pago SRI</label>
                          <select name="formaPago" class="w-full bg-white border border-slate-100 rounded-lg py-1.5 px-2 text-[11px] outline-none">
                            <option value="01" selected>Efectivo</option>
                            <option value="20">Transferencia Bancaria</option>
                            <option value="19">Tarjeta de Crédito</option>
                            <option value="16">Tarjeta de Débito</option>
                          </select>
                        </div>
                        <input type="hidden" name="observaciones" value="Punto de Venta POS">

                        <div class="flex flex-col gap-2 pt-2 text-[11px] font-bold text-slate-700">
                          <div class="flex justify-between border-b border-slate-200 pb-1">
                            <span class="text-slate-500 font-semibold">Subtotal 0%:</span>
                            <span id="pos-subtotal0">$0.00</span>
                            <input type="hidden" name="subtotal0" id="pos-inp-subtotal0" value="0">
                          </div>
                          <div class="flex justify-between border-b border-slate-200 pb-1">
                            <span class="text-slate-500 font-semibold">Subtotal 12%:</span>
                            <span id="pos-subtotal12">$0.00</span>
                            <input type="hidden" name="subtotalIva" id="pos-inp-subtotal12" value="0">
                          </div>
                          <div class="flex justify-between border-b border-slate-200 pb-1">
                            <span class="text-slate-500 font-semibold">IVA 12%:</span>
                            <span id="pos-valiva">$0.00</span>
                            <input type="hidden" name="valorIva" id="pos-inp-valiva" value="0">
                          </div>
                          <div class="flex justify-between pt-1 text-xs text-slate-950 font-black">
                            <span>TOTAL A COBRAR:</span>
                            <span id="pos-total" class="text-[#0A3C84]">$0.00</span>
                            <input type="hidden" name="total" id="pos-inp-total" value="0">
                          </div>
                        </div>

                        <input type="hidden" name="items" id="pos-inp-invoice-items-json" value="[]">

                        <button type="button" onclick="submitPosForm()" id="pos-btn-submit" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3.5 rounded-xl text-xs transition shadow-md flex items-center justify-center gap-1.5 mt-2 cursor-pointer">
                          <i class="fa-solid fa-cash-register"></i> Cobrar y Emitir Factura
                        </button>
                      </div>

                    </div>
                  </div>
                </form>
              <% } %>
            </div>

            <!-- Subtab CONTENT: sri-history -->
            <div id="subtab-sri-history" class="subtab-content hidden overflow-x-auto text-left">
              <% if (invoices && invoices.length > 0) { %>
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr class="border-b border-slate-100 text-slate-500 font-bold uppercase tracking-wider text-[9px] pb-3">
                      <th class="pb-3 font-bold">Secuencial</th>
                      <th class="pb-3 font-bold">Cliente / Comprador</th>
                      <th class="pb-3 font-bold">Fecha Emisión</th>
                      <th class="pb-3 font-bold">Total</th>
                      <th class="pb-3 font-bold">Estado SRI</th>
                      <th class="pb-3 text-right font-bold">Comprobantes</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% invoices.forEach(function(fac) { %>
                      <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                        <td class="py-4 font-bold text-slate-900"><%= fac.secuencial %></td>
                        <td class="py-4 font-bold text-slate-955"><%= fac.client ? fac.client.nombres : 'Consumidor Final' %></td>
                        <td class="py-4 text-slate-500 font-medium"><%= fac.fechaEmision.toDateString() %></td>
                        <td class="py-4 font-bold text-slate-950">$<%= fac.total.toFixed(2) %></td>
                        <td class="py-4">
                          <% 
                            let fBadg = "";
                            if (fac.estado === "CREADA" || fac.estado === "FIRMADA") fBadg = "bg-slate-100 text-slate-650 border-slate-200/60";
                            else if (fac.estado === "RECIBIDA") fBadg = "bg-amber-50 text-amber-600 border-amber-100/60";
                            else if (fac.estado === "AUTORIZADA") fBadg = "bg-emerald-50 text-emerald-600 border-emerald-100/60";
                            else fBadg = "bg-rose-50 text-rose-600 border-rose-100/60";
                          %>
                          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold border <%= fBadg %>">
                            <%= fac.estado %>
                          </span>
                        </td>
                        <td class="py-4 text-right">
                          <div class="flex items-center justify-end gap-1.5 font-bold">
                            <% if (fac.estado === 'AUTORIZADA') { %>
                              <a href="/dashboard/profesional/facturacion/descargar-xml/<%= fac.id %>" class="bg-sky-50 hover:bg-sky-100 border border-sky-200 text-sky-600 px-2 py-1 rounded-md text-[9px] flex items-center gap-1 transition">
                                <i class="fa-solid fa-code"></i> XML
                              </a>
                              <a href="/dashboard/profesional/facturacion/descargar-pdf/<%= fac.id %>" class="bg-rose-50 hover:bg-rose-100 border border-rose-250 text-rose-600 px-2 py-1 rounded-md text-[9px] flex items-center gap-1 transition">
                                <i class="fa-solid fa-file-pdf"></i> PDF RIDE
                              </a>
                            <% } else if (fac.estado === 'RECIBIDA' || fac.estado === 'CREADA') { %>
                              <form action="/dashboard/profesional/facturacion/consultar/<%= fac.id %>" method="POST" class="inline">
                                <button type="submit" class="bg-amber-50 hover:bg-amber-100 border border-amber-250 text-amber-700 px-2 py-1 rounded-md text-[9px] flex items-center gap-1 transition cursor-pointer">
                                  <i class="fa-solid fa-rotate"></i> Consultar SRI
                                </button>
                              </form>
                            <% } else { %>
                              <span class="text-slate-400 font-bold">-</span>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              <% } else { %>
                <div class="text-center py-10 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400 flex flex-col items-center justify-center">
                  <i class="fa-solid fa-file-invoice text-2xl mb-2 text-slate-355 animate-pulse"></i>
                  <span class="text-xs font-bold">No has emitido facturas electrónicas. Utiliza la pestaña de **Emitir Factura**.</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- TAB: MIS CERTIFICADOS -->
          <div id="tab-certificates" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <div class="flex flex-col gap-1 pb-4 border-b border-slate-50 mb-6">
              <h3 class="text-base font-extrabold text-slate-900 font-sans">Mis Certificados Académicos</h3>
              <span class="text-[10px] text-slate-400 font-semibold block">Descarga y verifica tus acreditaciones obtenidas en conversatorios y eventos académicos.</span>
            </div>

            <% if (certificates.length > 0) { %>
              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                <% certificates.forEach(function(cert) { %>
                  <div class="bg-white border border-slate-100 rounded-3xl p-5 hover:shadow-md transition duration-200 flex flex-col justify-between gap-4">
                    <div class="flex items-start justify-between gap-3">
                      <div class="w-10 h-10 rounded-2xl bg-[#0252A4]/5 text-[#0252A4] flex items-center justify-center text-sm shadow-inner flex-shrink-0">
                        <i class="fa-solid fa-award text-base"></i>
                      </div>
                      <div class="min-w-0 flex-1">
                        <span class="text-[8px] font-black text-slate-400 uppercase tracking-widest leading-none block">Acreditación Académica</span>
                        <h4 class="font-extrabold text-slate-900 text-xs mt-1.5 leading-snug line-clamp-2 uppercase" title="<%= cert.nombreEvento %>">
                          <%= cert.nombreEvento %>
                        </h4>
                        <p class="text-[9px] text-slate-400 font-bold uppercase mt-1 leading-none">A nombre de: <%= cert.nombreUsuario %></p>
                      </div>
                    </div>

                    <div class="border-t border-slate-100/60 pt-3 flex flex-col gap-2">
                      <div class="flex items-center justify-between text-[10px] font-bold text-slate-500">
                        <span class="flex items-center gap-1"><i class="fa-regular fa-clock text-slate-450"></i> <%= cert.horas %> Horas</span>
                        <span class="flex items-center gap-1 font-mono uppercase text-slate-400"><i class="fa-solid fa-barcode text-[9px]"></i> <%= cert.codigo %></span>
                      </div>

                      <div class="flex items-center justify-between mt-2 gap-2">
                        <% if (cert.estado === 'PENDIENTE') { %>
                          <span class="bg-amber-50 text-amber-600 border border-amber-100/50 text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-spinner animate-spin text-[8px]"></i>
                            En Validación
                          </span>
                          <span class="text-[9px] font-bold text-slate-400 italic">Pago en revisión</span>
                        <% } else if (cert.estado === 'RECHAZADO') { %>
                          <span class="bg-rose-50 text-rose-600 border border-rose-100/50 text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider flex items-center gap-1">
                            <i class="fa-solid fa-circle-xmark"></i>
                            Rechazado
                          </span>
                        <% } else { %>
                          <span class="bg-emerald-50 text-emerald-600 border border-emerald-100/50 text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider flex items-center gap-1">
                            <i class="fa-solid fa-circle-check"></i>
                            Aprobado
                          </span>
                          <a href="/certificados/<%= cert.codigo %>" target="_blank" class="bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold px-3.5 py-1.5 rounded-xl text-[9px] transition flex items-center gap-1 shadow-sm">
                            <i class="fa-solid fa-print"></i>
                            Ver Certificado
                          </a>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="flex flex-col items-center justify-center py-16 text-center">
                <div class="w-14 h-14 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-400 mb-4 text-xl">
                  <i class="fa-solid fa-award text-slate-350"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-900 mb-1">No tienes certificados adquiridos</h4>
                <p class="text-slate-400 text-xs max-w-sm mb-6">Participa en nuestros conversatorios y eventos académicos para obtener tus acreditaciones firmadas digitalmente.</p>
                <a href="/eventos" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-md transition">
                  Explorar Conversatorios
                </a>
              </div>
            <% } %>
          </div>

          <!-- TAB: MIS CURSOS -->
          <div id="tab-courses" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <div class="flex flex-col gap-1 pb-4 border-b border-slate-50 mb-6">
              <h3 class="text-base font-extrabold text-slate-900 font-sans">Mis Cursos Online</h3>
              <span class="text-[10px] text-slate-400 font-semibold block">Accede a las aulas virtuales de tus cursos y diplomados matriculados.</span>
            </div>

            <% 
              const courseEnrollments = enrollments.filter(e => e.curso);
            %>
            <% if (courseEnrollments.length > 0) { %>
              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                <% courseEnrollments.forEach(function(enroll) { %>
                  <% 
                    const cur = enroll.curso;
                    // Verify access similar to server logic (check if free, or if paid has approved certificate)
                    let isApproved = false;
                    let isPending = false;
                    
                    if (cur.gratuito) {
                      isApproved = true;
                    } else {
                      const cert = certificates.find(c => c.cursoId === cur.id);
                      if (cert) {
                        if (cert.estado === "APROBADO") {
                          isApproved = true;
                        } else if (cert.estado === "PENDIENTE") {
                          isPending = true;
                        }
                      }
                    }
                  %>
                  <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden hover:shadow-md transition duration-200 flex flex-col justify-between">
                    <!-- Banner Image -->
                    <div class="h-28 bg-slate-100 overflow-hidden relative flex-shrink-0">
                      <img src="<%= cur.banner || 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=400' %>" alt="<%= cur.titulo %>" class="w-full h-full object-cover">
                      <span class="absolute top-2 left-2 bg-[#0252A4]/90 text-white font-black text-[8px] px-2.5 py-1 rounded-md uppercase tracking-wider"><%= cur.gratuito ? 'Gratuito' : 'Certificado' %></span>
                    </div>

                    <!-- Content Body -->
                    <div class="p-5 flex-grow flex flex-col justify-between gap-4">
                      <div>
                        <h4 class="font-extrabold text-slate-900 text-xs uppercase leading-snug line-clamp-2" title="<%= cur.titulo %>">
                          <%= cur.titulo %>
                        </h4>
                        <p class="text-[10px] text-brand-blue font-bold mt-1 block truncate"><%= cur.slogan || 'Programa de Capacitación' %></p>
                      </div>

                      <div class="border-t border-slate-50 pt-3 flex flex-col gap-3 mt-auto">
                        <div class="flex items-center justify-between text-[9px] font-bold text-slate-400">
                          <span class="flex items-center gap-1"><i class="fa-regular fa-calendar"></i> Inició: <%= new Date(cur.fechaInicio).toLocaleDateString() %></span>
                          <% if (isApproved) { %>
                            <span class="bg-emerald-50 text-emerald-600 border border-emerald-100 px-2 py-0.5 rounded-full font-black text-[8px]">ACTIVO</span>
                          <% } else if (isPending) { %>
                            <span class="bg-amber-50 text-amber-600 border border-amber-100 px-2 py-0.5 rounded-full font-black text-[8px] animate-pulse">PENDIENTE</span>
                          <% } else { %>
                            <span class="bg-rose-50 text-rose-600 border border-rose-100 px-2 py-0.5 rounded-full font-black text-[8px]">FALTA PAGO</span>
                          <% } %>
                        </div>

                        <% if (isApproved) { %>
                          <a href="/cursos/<%= cur.id %>/aula" class="w-full bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-extrabold py-2.5 rounded-xl text-[10px] text-center transition flex items-center justify-center gap-1.5 shadow-sm shadow-[#5A7AF3]/10">
                            <i class="fa-solid fa-graduation-cap"></i> Ingresar al Aula
                          </a>
                        <% } else if (isPending) { %>
                          <div class="bg-amber-50 text-amber-800 border border-amber-100 rounded-xl py-2 px-3 text-[10px] font-bold text-center">
                            Validando transferencia...
                          </div>
                        <% } else { %>
                          <a href="/cursos/<%= cur.slug || cur.id %>" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold py-2.5 rounded-xl text-[10px] text-center transition flex items-center justify-center gap-1.5 border border-slate-200">
                            <i class="fa-solid fa-cart-shopping"></i> Completar Pago
                          </a>
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="flex flex-col items-center justify-center py-16 text-center">
                <div class="w-14 h-14 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-400 mb-4 text-xl">
                  <i class="fa-solid fa-graduation-cap text-slate-350"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-900 mb-1">No estás matriculado en ningún curso</h4>
                <p class="text-slate-400 text-xs max-w-sm mb-6">Explora nuestra oferta de cursos académicos de educación continua para iniciar tu formación.</p>
                <a href="/cursos" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-md transition">
                  Explorar Cursos Online
                </a>
              </div>
            <% } %>
          </div>

          <!-- TAB: PROMOCIONES -->
          <div id="tab-promociones" class="tab-content hidden flex flex-col gap-8">
            <div class="bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
              <h2 class="text-xl font-extrabold text-slate-950 mb-1 font-sans leading-none">Promocionar mi Perfil Profesional</h2>
              <p class="text-slate-505 text-xs mb-8">Destaca tu perfil profesional en la plataforma utilizando banners publicitarios, ventanas pop-up e importancia en las búsquedas del directorio.</p>
              
              <!-- GRID: PLANES DISPONIBLES -->
              <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-4">Planes de Promoción Disponibles</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 font-sans">
                <% if (promotionPlans && promotionPlans.length > 0) { %>
                  <% promotionPlans.forEach(function(plan) { %>
                    <div class="border border-slate-150 rounded-3xl p-6 bg-slate-50/30 hover:border-[#0A3C84] transition flex flex-col justify-between gap-6 shadow-sm">
                      <div class="flex flex-col gap-3">
                        <span class="bg-[#0A3C84]/10 text-[#0A3C84] text-[9px] font-black px-2.5 py-1 rounded-md self-start uppercase tracking-wider"><%= plan.nombre %></span>
                        <div class="flex items-baseline gap-1 mt-1">
                          <span class="text-3xl font-black text-slate-950">$<%= plan.precio.toFixed(2) %></span>
                          <span class="text-[10px] text-slate-400 font-bold">/ <%= plan.duracionDias %> días</span>
                        </div>
                        <p class="text-xs text-slate-550 font-medium leading-relaxed"><%= plan.descripcion || 'Sin descripción' %></p>
                        
                        <div class="flex flex-col gap-2 pt-2 border-t border-slate-100/70 text-[11px] font-bold text-slate-700">
                          <% if (plan.allowHomeBanner) { %>
                            <div class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-500"></i> Banner en Página de Inicio</div>
                          <% } %>
                          <% if (plan.allowCategoryBanner) { %>
                            <div class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-500"></i> Banner en Categoría de Profesión</div>
                          <% } %>
                          <% if (plan.allowPrioritySearch) { %>
                            <div class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-500"></i> Prioridad en Búsquedas (1° lugar)</div>
                          <% } %>
                          <% if (plan.allowPopupHome) { %>
                            <div class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-500"></i> Ventana Pop-up en Inicio</div>
                          <% } %>
                          <% if (plan.allowPopupCategory) { %>
                            <div class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-500"></i> Ventana Pop-up en Categoría</div>
                          <% } %>
                          <% if (plan.allowPopupSpecialty) { %>
                            <div class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-500"></i> Ventana Pop-up en Especialidad</div>
                          <% } %>
                        </div>
                      </div>
                      <button onclick="openPromotionCheckoutModal(<%= plan.id %>, '<%= plan.nombre %>', <%= plan.precio %>)" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3 rounded-2xl text-xs transition shadow-sm text-center cursor-pointer">
                        Adquirir Plan
                      </button>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="col-span-3 text-center py-10 border border-dashed border-slate-200 rounded-3xl text-slate-400 font-semibold">
                    No hay planes de promoción configurados en este momento.
                  </div>
                <% } %>
              </div>

              <!-- MIS PROMOCIONES ADQUIRIDAS -->
              <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-4">Mis Promociones Contratadas</h3>
              <div class="flex flex-col gap-6">
                <% if (promotions && promotions.length > 0) { %>
                  <% promotions.forEach(function(promo) { %>
                    <div class="border border-slate-100 rounded-3xl p-6 bg-white shadow-[0_4px_20px_rgba(0,0,0,0.01)] flex flex-col gap-6">
                      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-100">
                        <div class="flex flex-col gap-1">
                          <h4 class="font-black text-slate-900 text-sm"><%= promo.plan.nombre %></h4>
                          <span class="text-[10px] font-bold text-slate-450">
                            Adquirido: <%= new Date(promo.createdAt).toLocaleDateString('es-EC') %>
                            <% if (promo.startDate) { %>
                              | Vigencia: <%= new Date(promo.startDate).toLocaleDateString('es-EC') %> al <%= new Date(promo.endDate).toLocaleDateString('es-EC') %>
                            <% } %>
                          </span>
                        </div>
                        
                        <div class="flex items-center gap-3">
                          <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-wider 
                            <%= promo.status === 'ACTIVO' ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 
                                promo.status === 'PENDIENTE' ? 'bg-amber-50 text-amber-600 border border-amber-100' : 
                                'bg-rose-50 text-rose-600 border border-rose-100' %>">
                            <%= promo.status %>
                          </span>
                        </div>
                      </div>

                      <% if (promo.status === 'PENDIENTE') { %>
                        <div class="bg-amber-50 border border-amber-100 text-amber-800 rounded-2xl p-4 flex gap-3 text-[11px] font-semibold leading-relaxed">
                          <i class="fa-solid fa-clock-rotate-left text-sm mt-0.5"></i>
                          <div>
                            Su solicitud de pago está siendo verificada por el administrador.
                            <br><span class="text-[10px] text-amber-700">Podrá configurar y subir sus imágenes de publicidad una vez que el pago sea aprobado.</span>
                          </div>
                        </div>
                      <% } else if (promo.status === 'RECHAZADO') { %>
                        <div class="bg-rose-50 border border-rose-100 text-rose-800 rounded-2xl p-4 flex gap-3 text-[11px] font-semibold leading-relaxed">
                          <i class="fa-solid fa-circle-xmark text-sm mt-0.5"></i>
                          <div>
                            Su solicitud de pago ha sido rechazada por el administrador.
                            <br><span class="text-[10px] text-rose-700">Por favor, póngase en contacto con soporte o adquiera otro plan e ingrese el número de comprobante correcto.</span>
                          </div>
                        </div>
                      <% } else if (promo.status === 'ACTIVO') { %>
                        <!-- FORM TO UPLOAD MULTIMEDIA ASSETS -->
                        <form action="/dashboard/profesional/promociones/guardar-medios" method="POST" class="flex flex-col gap-6 text-left">
                          <input type="hidden" name="promotionId" value="<%= promo.id %>">
                          
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <% if (promo.plan.allowHomeBanner) { %>
                              <div class="border border-slate-100 rounded-2xl p-4 flex flex-col gap-3 shadow-sm bg-slate-50/20">
                                <span class="text-[11px] font-black text-slate-800 uppercase tracking-wide">Banner de Página Principal (Home)</span>
                                <span class="text-[10px] text-slate-400 font-semibold block leading-tight">Recomendado: 1920x450px (JPG/PNG). Se mostrará en el carrusel superior.</span>
                                
                                <div class="relative w-full aspect-[4/1] bg-slate-50 border border-slate-150 rounded-xl overflow-hidden flex items-center justify-center">
                                  <img id="preview-home-<%= promo.id %>" src="<%= promo.bannerHome || '' %>" class="w-full h-full object-cover <%= promo.bannerHome ? '' : 'hidden' %>">
                                  <div id="placeholder-home-<%= promo.id %>" class="flex flex-col items-center gap-1 text-slate-400 <%= promo.bannerHome ? 'hidden' : '' %>">
                                    <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                                    <span class="text-[9px] font-bold">Subir Banner Home</span>
                                  </div>
                                  <input type="file" accept="image/*" onchange="readBase64Image(event, 'preview-home-<%= promo.id %>', 'hidden-home-<%= promo.id %>', 'placeholder-home-<%= promo.id %>')" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                                </div>
                                <input type="hidden" name="bannerHome" id="hidden-home-<%= promo.id %>" value="<%= promo.bannerHome || '' %>">
                                
                                <button type="button" onclick="previewAdMarkup('home', 'preview-home-<%= promo.id %>')" class="border border-slate-200 hover:bg-slate-50 text-slate-700 font-extrabold py-2 px-4 rounded-xl text-[10px] text-center transition flex items-center justify-center gap-1.5 self-end">
                                  <i class="fa-solid fa-desktop"></i> Vista Previa en Vivo
                                </button>
                              </div>
                            <% } %>

                            <% if (promo.plan.allowCategoryBanner) { %>
                              <div class="border border-slate-100 rounded-2xl p-4 flex flex-col gap-3 shadow-sm bg-slate-50/20">
                                <span class="text-[11px] font-black text-slate-800 uppercase tracking-wide">Banner de Categoría (Profesión)</span>
                                <span class="text-[10px] text-slate-400 font-semibold block leading-tight">Recomendado: 1200x300px (JPG/PNG). Se mostrará en <%= profile.profesion || 'tu categoría' %>.</span>
                                
                                <div class="relative w-full aspect-[4/1] bg-slate-50 border border-slate-150 rounded-xl overflow-hidden flex items-center justify-center">
                                  <img id="preview-cat-<%= promo.id %>" src="<%= promo.bannerCategory || '' %>" class="w-full h-full object-cover <%= promo.bannerCategory ? '' : 'hidden' %>">
                                  <div id="placeholder-cat-<%= promo.id %>" class="flex flex-col items-center gap-1 text-slate-400 <%= promo.bannerCategory ? 'hidden' : '' %>">
                                    <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                                    <span class="text-[9px] font-bold">Subir Banner Categoría</span>
                                  </div>
                                  <input type="file" accept="image/*" onchange="readBase64Image(event, 'preview-cat-<%= promo.id %>', 'hidden-cat-<%= promo.id %>', 'placeholder-cat-<%= promo.id %>')" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                                </div>
                                <input type="hidden" name="bannerCategory" id="hidden-cat-<%= promo.id %>" value="<%= promo.bannerCategory || '' %>">
                                
                                <button type="button" onclick="previewAdMarkup('category', 'preview-cat-<%= promo.id %>')" class="border border-slate-200 hover:bg-slate-50 text-slate-700 font-extrabold py-2 px-4 rounded-xl text-[10px] text-center transition flex items-center justify-center gap-1.5 self-end">
                                  <i class="fa-solid fa-desktop"></i> Vista Previa en Vivo
                                </button>
                              </div>
                            <% } %>

                            <% const allowPopup = promo.plan.allowPopupHome || promo.plan.allowPopupCategory || promo.plan.allowPopupSpecialty; %>
                            <% if (allowPopup) { %>
                              <div class="border border-slate-100 rounded-2xl p-4 flex flex-col gap-3 shadow-sm bg-slate-50/20 md:col-span-2">
                                <span class="text-[11px] font-black text-slate-800 uppercase tracking-wide">Ventana Pop-up Promocional</span>
                                <span class="text-[10px] text-slate-400 font-semibold block leading-tight">Recomendado: 600x600px (Cuadrado). Se mostrará al cargar la página de destino.</span>
                                
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
                                  <div class="md:col-span-1">
                                    <div class="relative w-full aspect-square bg-slate-50 border border-slate-155 rounded-xl overflow-hidden flex items-center justify-center">
                                      <img id="preview-popup-<%= promo.id %>" src="<%= promo.popupImage || '' %>" class="w-full h-full object-cover <%= promo.popupImage ? '' : 'hidden' %>">
                                      <div id="placeholder-popup-<%= promo.id %>" class="flex flex-col items-center gap-1 text-slate-400 <%= promo.popupImage ? 'hidden' : '' %>">
                                        <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                                        <span class="text-[9px] font-bold">Subir Imagen Pop-up</span>
                                      </div>
                                      <input type="file" accept="image/*" onchange="readBase64Image(event, 'preview-popup-<%= promo.id %>', 'hidden-popup-<%= promo.id %>', 'placeholder-popup-<%= promo.id %>')" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                                    </div>
                                    <input type="hidden" name="popupImage" id="hidden-popup-<%= promo.id %>" value="<%= promo.popupImage || '' %>">
                                  </div>
                                  
                                  <div class="md:col-span-2 flex flex-col gap-3">
                                    <div class="flex flex-col gap-1.5">
                                      <label class="text-[10px] font-bold text-slate-700">Enlace de Destino al hacer Clic (Opcional)</label>
                                      <input type="url" name="popupLink" value="<%= promo.popupLink || '' %>" placeholder="https://profesionalesecuador.com/profesional/tu-nombre" class="bg-slate-50 border border-slate-150 rounded-xl py-2.5 px-3.5 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                                    </div>
                                    
                                    <div class="flex justify-between items-center mt-2">
                                      <div class="flex flex-wrap gap-1">
                                        <% if (promo.plan.allowPopupHome) { %>
                                          <span class="bg-purple-50 text-purple-700 text-[8px] font-black px-2 py-0.5 rounded-md">Vigente en Home</span>
                                        <% } %>
                                        <% if (promo.plan.allowPopupCategory) { %>
                                          <span class="bg-purple-50 text-purple-700 text-[8px] font-black px-2 py-0.5 rounded-md">Vigente en Categoría</span>
                                        <% } %>
                                        <% if (promo.plan.allowPopupSpecialty) { %>
                                          <span class="bg-purple-50 text-purple-700 text-[8px] font-black px-2 py-0.5 rounded-md">Vigente en Especialidad</span>
                                        <% } %>
                                      </div>
                                      <button type="button" onclick="previewAdMarkup('popup', 'preview-popup-<%= promo.id %>')" class="border border-slate-200 hover:bg-slate-50 text-slate-700 font-extrabold py-2 px-4 rounded-xl text-[10px] text-center transition flex items-center justify-center gap-1.5 self-end">
                                        <i class="fa-solid fa-desktop"></i> Vista Previa en Vivo
                                      </button>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            <% } %>
                          </div>

                          <div class="flex justify-end gap-3 border-t border-slate-100 pt-4 mt-2">
                            <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-2.5 px-6 rounded-xl text-xs transition shadow-sm cursor-pointer flex items-center gap-1.5">
                              <i class="fa-solid fa-save"></i> Guardar Piezas Publicitarias
                            </button>
                          </div>
                        </form>
                      <% } %>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="text-center py-12 border border-dashed border-slate-250 rounded-3xl text-slate-400 font-semibold font-sans">
                    Aún no has adquirido ningún plan de promoción para tu perfil.
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- TAB: CONFIGURACIÓN -->
          <div id="tab-configuracion" class="tab-content hidden bg-white rounded-[24px] border border-slate-100 p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
            <h2 class="text-xl font-extrabold text-slate-950 mb-1 font-sans leading-none">Configuración y Seguridad</h2>
            <p class="text-slate-500 text-xs mb-8">Administra tus enlaces de redes sociales, cambia tu contraseña de acceso o elimina tu cuenta permanentemente.</p>

            <!-- Social Networks Form -->
            <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-8 text-left">
              <h3 class="text-sm font-extrabold text-slate-900 mb-4 font-sans"><i class="fa-solid fa-share-nodes text-[#0252A4] mr-1"></i> Enlaces de Redes Sociales</h3>
              <form action="/dashboard/profesional/redes" method="POST" class="flex flex-col gap-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Facebook (URL)</label>
                    <input type="url" name="facebook" value="<%= profile.facebook || '' %>" placeholder="https://facebook.com/..." class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Instagram (URL)</label>
                    <input type="url" name="instagram" value="<%= profile.instagram || '' %>" placeholder="https://instagram.com/..." class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">X / Twitter (URL)</label>
                    <input type="url" name="xTwitter" value="<%= profile.xTwitter || '' %>" placeholder="https://x.com/..." class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">LinkedIn (URL)</label>
                    <input type="url" name="linkedin" value="<%= profile.linkedin || '' %>" placeholder="https://linkedin.com/in/..." class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">TikTok (URL)</label>
                    <input type="url" name="tiktok" value="<%= profile.tiktok || '' %>" placeholder="https://tiktok.com/@..." class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">YouTube (URL)</label>
                    <input type="url" name="youtube" value="<%= profile.youtube || '' %>" placeholder="https://youtube.com/..." class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Número de WhatsApp (Contacto Directo)</label>
                    <input type="tel" name="whatsapp" value="<%= profile.whatsapp || '' %>" placeholder="Ej: 0998765432 o 593998765432" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none">
                  </div>
                </div>
                <button type="submit" class="bg-[#033E8C] hover:bg-[#022A60] text-white font-bold py-2.5 rounded-xl text-xs transition px-4 self-end cursor-pointer">
                  Actualizar Enlaces <i class="fa-solid fa-save ml-1"></i>
                </button>
              </form>
            </div>

            <!-- Password Change Form -->
            <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-8 text-left">
              <h3 class="text-sm font-extrabold text-slate-900 mb-4 font-sans"><i class="fa-solid fa-lock text-[#0252A4] mr-1"></i> Cambiar Contraseña</h3>
              <form action="/dashboard/profesional/password/cambiar" method="POST" class="flex flex-col gap-4 max-w-md">
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Contraseña Actual</label>
                  <div class="relative">
                    <input type="password" id="current-password-input" name="currentPassword" required placeholder="••••••••" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 pl-3.5 pr-10 text-xs outline-none">
                    <button type="button" onclick="togglePasswordVisibility('current-password-input', this)" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none cursor-pointer bg-transparent border-none p-0 leading-none">
                      <i class="fa-solid fa-eye text-[11px]"></i>
                    </button>
                  </div>
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Nueva Contraseña</label>
                  <div class="relative">
                    <input type="password" id="new-password-input" name="newPassword" required placeholder="Mínimo 6 caracteres" class="w-full bg-white border border-slate-200 rounded-xl py-2.5 pl-3.5 pr-10 text-xs outline-none">
                    <button type="button" onclick="togglePasswordVisibility('new-password-input', this)" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none cursor-pointer bg-transparent border-none p-0 leading-none">
                      <i class="fa-solid fa-eye text-[11px]"></i>
                    </button>
                  </div>
                </div>
                <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 rounded-xl text-xs transition px-4 self-start cursor-pointer">
                  Cambiar Contraseña <i class="fa-solid fa-key ml-1"></i>
                </button>
              </form>
            </div>

            <!-- Dangerous Zone -->
            <div class="bg-rose-50 border border-rose-100 p-6 rounded-2xl text-left">
              <h3 class="text-sm font-extrabold text-rose-700 mb-2 flex items-center gap-1.5 font-sans"><i class="fa-solid fa-circle-exclamation text-rose-500"></i> Zona de Peligro</h3>
              <p class="text-xs text-rose-600 leading-normal mb-4 font-semibold">Al eliminar tu cuenta, se eliminarán de forma permanente todos tus datos, servicios, horarios, artículos y citas registradas. Esta acción no se puede deshacer.</p>
              <form action="/dashboard/profesional/cuenta/eliminar" method="POST" onsubmit="return confirm('¿ESTÁ TOTALMENTE SEGURO DE ELIMINAR SU CUENTA? Esta acción borrará permanentemente su usuario y perfil profesional en cascada.');">
                <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white font-bold py-2.5 rounded-xl text-xs transition px-4 cursor-pointer">
                  Eliminar Mi Cuenta Permanentemente <i class="fa-solid fa-trash-alt ml-1"></i>
                </button>
              </form>
            </div>

            <!-- Certificate Name Configuration -->
            <div class="bg-white border border-slate-100 p-6 rounded-2xl shadow-sm text-left mt-8">
              <h3 class="text-sm font-extrabold text-slate-900 mb-2 font-sans"><i class="fa-solid fa-signature text-[#0252A4] mr-1"></i> Nombre para Certificados Académicos</h3>
              <p class="text-xs text-slate-500 mb-6 font-semibold">Define cómo deseas que se imprima tu nombre en futuras acreditaciones oficiales de la plataforma.</p>

              <!-- Alert boxes -->
              <div class="flex flex-col gap-3 mb-6">
                <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl p-3 flex gap-3 text-[11px] font-semibold leading-relaxed">
                  <i class="fa-solid fa-circle-exclamation text-sm mt-0.5 flex-shrink-0 text-amber-600"></i>
                  <div>
                    Este nombre se guardará exclusivamente para **futuros certificados** que adquieras o reclames en la plataforma.
                  </div>
                </div>
                
                <div class="bg-slate-50 border border-slate-200 text-slate-700 rounded-xl p-3 flex gap-3 text-[11px] font-semibold leading-relaxed">
                  <i class="fa-solid fa-clock text-sm mt-0.5 flex-shrink-0 text-slate-500"></i>
                  <div>
                    Para asegurar la validez académica, **solo se permite actualizar este nombre una vez cada 60 días**.
                  </div>
                </div>
              </div>

              <!-- Configuration Input -->
              <% 
                let daysLeft = 0;
                if (user.lastCertNameUpdate) {
                  const lastUpdate = new Date(user.lastCertNameUpdate);
                  const diffTime = Math.abs(new Date().getTime() - lastUpdate.getTime());
                  const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
                  if (diffDays < 60) {
                    daysLeft = 60 - diffDays;
                  }
                }
              %>

              <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-1.5">
                  <label class="text-[11px] font-black text-slate-500 uppercase tracking-wide">Nombre Completo para Certificados</label>
                  <input type="text" id="config-cert-name" placeholder="Ej: Dr. Juan Pérez" 
                    value="<%= user.nombreCertificado || user.name %>" 
                    <%= daysLeft > 0 ? 'disabled' : '' %>
                    class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition uppercase <%= daysLeft > 0 ? 'opacity-65 cursor-not-allowed' : '' %>">
                  
                  <% if (daysLeft > 0) { %>
                    <span class="text-[10px] text-rose-600 font-bold mt-1 flex items-center gap-1.5">
                      <i class="fa-solid fa-lock"></i>
                      Cambio bloqueado. Faltan <strong class="underline"><%= daysLeft %> días</strong>.
                    </span>
                  <% } %>
                </div>

                <!-- Success Alert Container -->
                <div id="config-success-alert" class="hidden p-3 bg-emerald-50 border border-emerald-100 rounded-xl text-emerald-800 text-[11px] font-bold flex items-center gap-2">
                  <i class="fa-solid fa-circle-check text-emerald-600"></i>
                  <span id="config-success-text"></span>
                </div>

                <!-- Error Alert Container -->
                <div id="config-error-alert" class="hidden p-3 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-[11px] font-bold flex items-center gap-2">
                  <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
                  <span id="config-error-text"></span>
                </div>

                <button onclick="saveCertNameConfig()" id="btn-save-config" 
                  <%= daysLeft > 0 ? 'disabled' : '' %>
                  class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-extrabold py-2.5 px-5 rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md self-start <%= daysLeft > 0 ? 'opacity-65 cursor-not-allowed bg-slate-400 hover:bg-slate-400' : 'cursor-pointer' %>">
                  <span>Guardar Configuración de Nombre</span>
                  <i class="fa-solid fa-floppy-disk"></i>
                </button>
              </div>
            </div>
          </div>

      <!-- TAB: PROFESIONALES ID -->
      <section id="tab-profesional-id" class="tab-content hidden flex flex-col gap-6 font-sans pb-24 mb-16">
        
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-2.5">
                <i class="fa-solid fa-id-card-clip text-purple-600"></i> Módulo Profesionales ID
              </h2>
              <span id="prof-id-status-badge" class="bg-emerald-500 text-white text-[9px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                Publicado
              </span>
            </div>
            <p class="text-xs font-medium text-slate-500 mt-1">
              Tu enlace profesional único para compartir en redes sociales y tarjetas. 
              <strong id="prof-id-url-display" class="text-brand-blue font-mono">profesionales.ec/@cargando...</strong>
            </p>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <button type="button" onclick="previewPublicId()" class="bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 font-extrabold py-2.5 px-4 rounded-xl transition text-xs flex items-center gap-2 cursor-pointer">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> Ver mi ID Público
            </button>
            <button type="button" onclick="copyProfIdLink()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-extrabold py-2.5 px-4 rounded-xl transition text-xs flex items-center gap-2 cursor-pointer">
              <i class="fa-solid fa-copy"></i> Copiar Enlace
            </button>
            <button type="button" onclick="showProfIdQrModal()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-2.5 px-4 rounded-xl transition text-xs flex items-center gap-2 cursor-pointer shadow-sm">
              <i class="fa-solid fa-qrcode"></i> Código QR
            </button>
          </div>
        </div>

        <!-- Main Layout: Grid 2 Columns -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

          <!-- COLUMNA IZQUIERDA: CONFIGURADOR Y EDITOR (7 col) -->
          <div class="lg:col-span-7 flex flex-col gap-6">

            <!-- Card 1: Identidad & Acción Principal -->
            <div class="bg-white rounded-3xl p-6 border border-slate-150 shadow-sm flex flex-col gap-5">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                  <i class="fa-solid fa-user-pen text-brand-blue"></i> Identidad & Acción Principal
                </h3>
                <label class="flex items-center gap-2 text-xs font-bold text-slate-600 cursor-pointer select-none">
                  <span>Estado:</span>
                  <input type="checkbox" id="prof-id-is-active" onchange="saveProfIdGeneralConfig()" class="w-4 h-4 rounded text-brand-blue focus:ring-brand-blue">
                  <span id="prof-id-active-label" class="text-emerald-600 font-extrabold">Activo</span>
                </label>
              </div>

              <div class="flex flex-col gap-4">
                <!-- Slug personal -->
                <div class="flex flex-col gap-1">
                  <label class="text-[11px] font-black text-slate-500 uppercase tracking-wide">Enlace Personal / Slug</label>
                  <div class="flex items-center">
                    <span class="bg-slate-100 text-slate-500 px-3 py-2.5 rounded-l-xl text-xs font-mono font-bold border border-r-0 border-slate-200">profesionales.ec/@</span>
                    <input type="text" id="prof-id-slug-input" placeholder="tu-nombre" class="flex-1 bg-slate-50 border border-slate-200 rounded-r-xl py-2.5 px-3 text-xs font-mono font-bold outline-none focus:bg-white focus:border-brand-blue transition">
                  </div>
                  <span class="text-[10px] text-slate-400 font-medium">Ej: @terrymendieta. Solo letras, números y guiones.</span>
                </div>

                <!-- Descripción Corta -->
                <div class="flex flex-col gap-1">
                  <label class="text-[11px] font-black text-slate-500 uppercase tracking-wide">Descripción Corta del ID</label>
                  <textarea id="prof-id-short-desc" rows="2" maxlength="150" placeholder="Ej: Especialista en cardiología y salud cardiovascular integral." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-medium outline-none focus:bg-white focus:border-brand-blue transition"></textarea>
                  <span class="text-[10px] text-slate-400 font-medium text-right">Máximo 150 caracteres.</span>
                </div>

                <!-- Acción Principal Destacada -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/70 flex flex-col gap-3">
                  <span class="text-[11px] font-black text-slate-700 uppercase tracking-wide flex items-center gap-1.5">
                    <i class="fa-solid fa-bolt text-amber-500"></i> Botón de Acción Principal (Destacado)
                  </span>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="flex flex-col gap-1">
                      <label class="text-[10px] font-bold text-slate-600">Tipo de Acción</label>
                      <select id="prof-id-primary-type" onchange="onPrimaryTypeChange()" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-bold outline-none">
                        <option value="WHATSAPP">💬 Contacto por WhatsApp</option>
                        <option value="AGENDA">📅 Agendar Cita Directa</option>
                        <option value="SERVICES">💼 Mis Servicios</option>
                        <option value="WEBSITE">🌐 Sitio Web Externo</option>
                        <option value="CUSTOM">🔗 Enlace Personalizado</option>
                      </select>
                    </div>

                    <div class="flex flex-col gap-1">
                      <label class="text-[10px] font-bold text-slate-600">Título del Botón</label>
                      <input type="text" id="prof-id-primary-title" placeholder="Ej: Escríbeme por WhatsApp" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-bold outline-none">
                    </div>
                  </div>

                  <div class="flex flex-col gap-1" id="container-primary-value">
                    <label class="text-[10px] font-bold text-slate-600" id="label-primary-value">Número de WhatsApp / Enlace</label>
                    <input type="text" id="prof-id-primary-value" placeholder="Ej: 593999999999" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-medium outline-none">
                  </div>
                </div>

                <button type="button" onclick="saveProfIdGeneralConfig()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-2.5 px-5 rounded-xl text-xs transition shadow-sm self-end flex items-center gap-2 cursor-pointer">
                  <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios de Identidad
                </button>
              </div>
            </div>

