    }

    // Template preview logic
    let previewTemplateLastFocusedElement = null;
    let previewTemplateTriggerButton = null;

    function getPreviewTemplateModal() {
      return document.getElementById('preview-template-modal');
    }

    function getPreviewTemplateIframe() {
      return document.getElementById('preview-template-iframe');
    }

    function getPreviewTemplateTitle() {
      return document.getElementById('preview-template-title');
    }

    function getPreviewTemplateCloseButton() {
      return document.getElementById('preview-template-close-button');
    }

    function getSelectedTemplateData(selectEl) {
      const selectedOption = selectEl?.options?.[selectEl.selectedIndex];
      return {
        layout: selectedOption?.dataset?.baseLayout || 'default',
        name: selectedOption?.textContent?.trim() || 'Plantilla Original'
      };
    }

    function setProfilePreviewContent(layout, name) {
      const iframe = getPreviewTemplateIframe();
      const title = getPreviewTemplateTitle();

      if (!iframe || !title) {
        return;
      }

      iframe.dataset.currentTemplate = layout;
      iframe.src = '/dashboard/profesional/preview?template=' + encodeURIComponent(layout);
      title.innerText = 'Vista previa — ' + name;
    }

    function bindProfilePreviewSelect(selectEl) {
      if (!selectEl || selectEl.dataset.previewChangeBound === 'true') {
        return;
      }

      selectEl.dataset.previewChangeBound = 'true';
      selectEl.addEventListener('change', function handleProfilePreviewSelectChange() {
        const modal = getPreviewTemplateModal();
        if (!modal || modal.classList.contains('hidden')) {
          return;
        }

        const { layout, name } = getSelectedTemplateData(selectEl);
        const iframe = getPreviewTemplateIframe();
        if (!iframe) {
          return;
        }

        if ((iframe.dataset.currentTemplate || 'default') !== layout) {
          setProfilePreviewContent(layout, name);
          return;
        }

        const title = getPreviewTemplateTitle();
        if (title) {
          title.innerText = 'Vista previa — ' + name;
        }
      });
    }

    function openProfilePreview(buttonEl) {
      const selectEl = buttonEl?.closest('div')?.querySelector('select[name="templateId"]');
      const { layout, name } = getSelectedTemplateData(selectEl);
      const modal = getPreviewTemplateModal();
      const closeButton = getPreviewTemplateCloseButton();

      previewTemplateTriggerButton = buttonEl instanceof HTMLElement ? buttonEl : null;
      previewTemplateLastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : previewTemplateTriggerButton;

      if (selectEl) {
        bindProfilePreviewSelect(selectEl);
      }

      setProfilePreviewContent(layout, name);

      if (!modal) {
        return;
      }

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      if (closeButton) {
        closeButton.focus();
      }
    }

    function closeProfilePreview() {
      const modal = getPreviewTemplateModal();
      const iframe = getPreviewTemplateIframe();

      if (modal) {
        modal.classList.add('hidden');
      }

      if (iframe) {
        iframe.src = 'about:blank';
        iframe.dataset.currentTemplate = 'default';
      }

      document.body.style.overflow = '';

      const fallbackFocus = previewTemplateLastFocusedElement || previewTemplateTriggerButton;
      if (fallbackFocus && typeof fallbackFocus.focus === 'function') {
        fallbackFocus.focus();
      }

      previewTemplateLastFocusedElement = null;
      previewTemplateTriggerButton = null;
    }

    document.addEventListener('keydown', function handleProfilePreviewKeydown(event) {
      if (event.key !== 'Escape') {
        return;
      }

      const modal = getPreviewTemplateModal();
      if (!modal || modal.classList.contains('hidden')) {
        return;
      }

      event.preventDefault();
      closeProfilePreview();
    });

    document.addEventListener('click', function handleProfilePreviewBackdropClick(event) {
      const backdrop = event.target.closest?.('[data-close-on-click="true"]');

      if (backdrop && event.target === backdrop) {
        closeProfilePreview();
      }
    });
  </script>

