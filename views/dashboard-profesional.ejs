  <!-- Sidebar responsive javascript functionality -->
  <script>
    function togglePasswordVisibility(id, btn) {
      const input = document.getElementById(id);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const sidebar = document.getElementById('sidebar-menu');
      const backdrop = document.getElementById('mobile-sidebar-backdrop');

      function openMenu() {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
      }

      function closeMenu() {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
      }

      toggleBtn.addEventListener('click', openMenu);
      backdrop.addEventListener('click', closeMenu);
      
      // Close side drawer when clicking layout tabs on mobile
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (window.innerWidth < 1024) {
            closeMenu();
          }
        });
      });
    });

    // Toggle Professional Sidebar Categories (Smooth Accordion System)
    function toggleProfCategory(catId) {
      const target = document.getElementById(catId);
      const iconTarget = document.getElementById('icon-' + catId);
      if (!target) return;

      const isAlreadyOpen = target.classList.contains('open');

      // 1. Cerrar suavemente todas las categorías del perfil profesional
      const allCategories = document.querySelectorAll('.prof-category-content');
      allCategories.forEach(cat => {
        cat.classList.remove('open');
        const icon = document.getElementById('icon-' + cat.id);
        if (icon) {
          icon.classList.remove('rotate-180');
        }
      });

      // 2. Si la categoría cliqueada estaba cerrada, abrirla suavemente
      if (!isAlreadyOpen) {
        target.classList.add('open');
        if (iconTarget) {
          iconTarget.classList.add('rotate-180');
        }
      }
    }

    function openProfCategorySmooth(catId) {
      const target = document.getElementById(catId);
      const iconTarget = document.getElementById('icon-' + catId);
      if (!target) return;

      const allCategories = document.querySelectorAll('.prof-category-content');
      allCategories.forEach(cat => {
        if (cat.id !== catId) {
          cat.classList.remove('open');
          const icon = document.getElementById('icon-' + cat.id);
          if (icon) icon.classList.remove('rotate-180');
        }
      });

      target.classList.add('open');
      if (iconTarget) iconTarget.classList.add('rotate-180');
    }

    // Tab Controller
    function showTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-blue-50/80', 'text-[#0A3C84]', 'font-black', 'border-l-4', 'border-[#0A3C84]', 'shadow-sm');
        btn.classList.add('text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');
      });

      const targetTab = document.getElementById('tab-' + tabId);
      if (targetTab) targetTab.classList.remove('hidden');

      const activeBtn = document.getElementById('btn-' + tabId);
      if (activeBtn) {
        activeBtn.classList.add('bg-blue-50/80', 'text-[#0A3C84]', 'font-black', 'border-l-4', 'border-[#0A3C84]');
        activeBtn.classList.remove('text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');

        // Auto-expand parent category smoothly
        const parentCategory = activeBtn.closest('.prof-category-content');
        if (parentCategory) {
          openProfCategorySmooth(parentCategory.id);
        }
      }

      // Initialize Map if profile tab is clicked
      if (tabId === 'perfil') {
        setTimeout(initPickerMap, 100);
      }

      if (tabId === 'profesional-id') {
        loadProfIdData();
      }

      // Default to POS subtab if facturacion tab is loaded and no explicit subtab parameter is active
      if (tabId === 'facturacion') {
        const urlParams = new URLSearchParams(window.location.search);
        const sub = urlParams.get('subtab') || localStorage.getItem('profActiveSubTab');
        if (sub) {
          showSubTab(sub);
        } else {
          showSubTab('sri-pos');
        }
      }

      localStorage.setItem('profActiveTab', tabId);
    }

    // Subtab Controller (SRI Facturacion)
    function showSubTab(subTabId) {
      document.querySelectorAll('.subtab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.subtab-btn').forEach(btn => {
        btn.classList.remove('text-[#0A3C84]');
        btn.classList.add('text-slate-500', 'hover:text-slate-900');
      });

      const targetSub = document.getElementById('subtab-' + subTabId);
      if (targetSub) targetSub.classList.remove('hidden');

      const activeSubBtn = document.getElementById('btn-' + subTabId);
      if (activeSubBtn) {
        activeSubBtn.classList.add('text-[#0A3C84]');
        activeSubBtn.classList.remove('text-slate-500', 'hover:text-slate-900');
      }

      localStorage.setItem('profActiveSubTab', subTabId);
    }

    // Map geolocator
    function locateMeOnMap() {
      if (!navigator.geolocation) {
        alert("La geolocalización no es soportada por tu navegador.");
        return;
      }
      navigator.geolocation.getCurrentPosition(
        function (position) {
          const lat = position.coords.latitude;
          const lng = position.coords.longitude;
          
          document.getElementById('picker-lat').value = lat.toFixed(6);
          document.getElementById('picker-lng').value = lng.toFixed(6);
          
          if (map && marker) {
            map.setView([lat, lng], 16);
            marker.setLatLng([lat, lng]);
          } else {
            initPickerMap();
            if (map && marker) {
              map.setView([lat, lng], 16);
              marker.setLatLng([lat, lng]);
            }
          }
        },
        function (error) {
          console.error("Error obteniendo ubicación:", error);
          alert("No se pudo obtener tu ubicación. Por favor, asegúrate de dar permisos de ubicación a tu navegador.");
        },
        { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
      );
    }

    // Leaflet picker map initializer
    let map = null;
    let marker = null;
    function initPickerMap() {
      const latInput = document.getElementById('picker-lat');
      const lngInput = document.getElementById('picker-lng');
      const initialLat = parseFloat(latInput.value) || -4.00789;
      const initialLng = parseFloat(lngInput.value) || -79.2083;

      if (map !== null) {
        map.invalidateSize();
        return;
      }

      map = L.map('leaflet-picker-map').setView([initialLat, initialLng], 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

      marker.on('dragend', function (event) {
        const markerPos = marker.getLatLng();
        latInput.value = markerPos.lat.toFixed(6);
        lngInput.value = markerPos.lng.toFixed(6);
      });

      map.on('click', function(e) {
        marker.setLatLng(e.latlng);
        latInput.value = e.latlng.lat.toFixed(6);
        lngInput.value = e.latlng.lng.toFixed(6);
      });
    }

    // Base64 helper for image/p12 loads
    function setupBase64FileLoader(fileInputId, hiddenInputId, previewImgId) {
      const fileInput = document.getElementById(fileInputId);
      const hiddenInput = document.getElementById(hiddenInputId);
      if (!fileInput) return;

      fileInput.addEventListener('change', function(e) {
        const file = fileInput.files[0];
        if (!file) return;

