    function posRenderTicket() {
      document.querySelectorAll('.pos-badge').forEach(b => {
        b.innerText = '0';
        b.classList.add('hidden');
      });

      const listDiv = document.getElementById('pos-ticket-list');
      const emptyDiv = document.getElementById('pos-ticket-empty');
      
      listDiv.innerHTML = '';
      
      if (posSelectedItems.length === 0) {
        emptyDiv.classList.remove('hidden');
        listDiv.classList.add('hidden');
        
        document.getElementById('pos-subtotal0').innerText = '$0.00';
        document.getElementById('pos-subtotal12').innerText = '$0.00';
        document.getElementById('pos-valiva').innerText = '$0.00';
        document.getElementById('pos-total').innerText = '$0.00';
        
        document.getElementById('pos-inp-subtotal0').value = 0;
        document.getElementById('pos-inp-subtotal12').value = 0;
        document.getElementById('pos-inp-valiva').value = 0;
        document.getElementById('pos-inp-total').value = 0;
        document.getElementById('pos-inp-invoice-items-json').value = '[]';
        return;
      }

      emptyDiv.classList.add('hidden');
      listDiv.classList.remove('hidden');

      let subtotal0 = 0;
      let subtotal12 = 0;
      let totalIva = 0;

      posSelectedItems.forEach((item) => {
        const badge = document.getElementById(`pos-badge-${item.productId}`);
        if (badge) {
          badge.innerText = item.cantidad;
          badge.classList.remove('hidden');
        }

        const totalSinImp = item.precio * item.cantidad;
        const itemIvaVal = totalSinImp * (item.iva / 100);

        if (item.iva === 0) {
          subtotal0 += totalSinImp;
        } else {
          subtotal12 += totalSinImp;
          totalIva += itemIvaVal;
