    function getIVARate() {
      const ivaValStr = document.getElementById('product-form-iva').value;
      const ivaPercentage = parseFloat(ivaValStr) || 0;
      return ivaPercentage > 0 ? ivaPercentage / 100 : 0;
    }

    function calculateTotalsFromUnitPrice() {
      try {
        const qty = parseFloat(document.getElementById('product-form-qty').value) || 0;
        const price = parseFloat(document.getElementById('product-form-price').value) || 0;
        const discount = parseFloat(document.getElementById('product-form-discount').value) || 0;
        const taxRate = getIVARate();
        const ivaValStr = document.getElementById('product-form-iva').value;
        const ivaPercentage = parseFloat(ivaValStr) || 0;

        // Base Subtotal (Qty * Price)
        const subtotal = qty * price;
        
        // Calculate tax only on positive rates (No Objeto / Exento has 0 tax)
        const baseForTax = Math.max(0, subtotal - discount);
        const taxValue = baseForTax * taxRate;
        
        // Final price with tax (for single item)
        const finalPriceSingle = price * (1 + taxRate);
        
        const total = baseForTax + taxValue;

        // Update Con IVA Price unitarily without triggering recursive loops
        const finalPriceInput = document.getElementById('product-form-final-price');
        if (finalPriceInput) {
          finalPriceInput.value = finalPriceSingle.toFixed(2);
        }

        // Update right summary panel
        updateProjectedSummary(subtotal, discount, ivaPercentage, taxValue, total);
      } catch (err) {
        console.error("Error in calculateTotalsFromUnitPrice:", err);
      }
    }

    function calculateTotalsFromFinalPrice() {
      try {
        const qty = parseFloat(document.getElementById('product-form-qty').value) || 0;
        const finalPriceInput = document.getElementById('product-form-final-price');
        const finalPrice = parseFloat(finalPriceInput ? finalPriceInput.value : 0) || 0;
        const discount = parseFloat(document.getElementById('product-form-discount').value) || 0;
        const taxRate = getIVARate();
        const ivaValStr = document.getElementById('product-form-iva').value;
        const ivaPercentage = parseFloat(ivaValStr) || 0;

        // Calculate unit price: price = finalPrice / (1 + taxRate)
        const price = finalPrice / (1 + taxRate);
        
        // Update Unit Price input
        const priceInput = document.getElementById('product-form-price');
        if (priceInput) {
          priceInput.value = price.toFixed(2);
        }

        // Base Subtotal (Qty * Price)
        const subtotal = qty * price;
        
        // Calculate tax only on positive rates (No Objeto / Exento has 0 tax)
        const baseForTax = Math.max(0, subtotal - discount);
        const taxValue = baseForTax * taxRate;
        
        const total = baseForTax + taxValue;

        // Update right summary panel
        updateProjectedSummary(subtotal, discount, ivaPercentage, taxValue, total);
      } catch (err) {
        console.error("Error in calculateTotalsFromFinalPrice:", err);
      }
    }

    function updateProjectedSummary(subtotal, discount, ivaPercentage, taxValue, total) {
      const subtotalEl = document.getElementById('product-calc-subtotal');
      const discountEl = document.getElementById('product-calc-discount');
      const ivaLabelEl = document.getElementById('product-calc-iva-label');
      const ivaValEl = document.getElementById('product-calc-iva');
      const totalEl = document.getElementById('product-calc-total');

      if (subtotalEl) subtotalEl.innerText = '$' + subtotal.toFixed(2);
      if (discountEl) discountEl.innerText = '-$' + discount.toFixed(2);
      
      let taxLabel = 'IVA ' + ivaPercentage + '%';
      if (ivaPercentage === -1) taxLabel = 'NO OBJETO';
      if (ivaPercentage === -2) taxLabel = 'EXENTO';
      if (ivaLabelEl) ivaLabelEl.innerText = taxLabel;
      if (ivaValEl) ivaValEl.innerText = '+$' + taxValue.toFixed(2);
      
      if (totalEl) totalEl.innerText = '$' + total.toFixed(2);
    }

