              <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles text-purple-600"></i> Acciones Rápidas de Profesionales
              </h3>
              <p class="text-xs text-slate-500 font-medium leading-relaxed">
                Agrega botones inteligentes conectados automáticamente con tus módulos activos de la plataforma:
              </p>

              <div class="flex flex-wrap gap-2">
                <button type="button" onclick="addProfIdPresetLink('PROFILE')" class="px-3.5 py-2 bg-blue-50 hover:bg-blue-100 text-[#0A3C84] font-bold text-xs rounded-xl border border-blue-200 transition flex items-center gap-1.5 cursor-pointer">
                  <i class="fa-solid fa-plus text-[10px]"></i> <i class="fa-solid fa-address-card"></i> Perfil Profesional
                </button>
                <button type="button" onclick="addProfIdPresetLink('AGENDA')" class="px-3.5 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-xs rounded-xl border border-emerald-200 transition flex items-center gap-1.5 cursor-pointer">
                  <i class="fa-solid fa-plus text-[10px]"></i> <i class="fa-solid fa-calendar-check"></i> Agenda de Citas
                </button>
                <button type="button" onclick="addProfIdPresetLink('SERVICES')" class="px-3.5 py-2 bg-purple-50 hover:bg-purple-100 text-purple-800 font-bold text-xs rounded-xl border border-purple-200 transition flex items-center gap-1.5 cursor-pointer">
                  <i class="fa-solid fa-plus text-[10px]"></i> <i class="fa-solid fa-stethoscope"></i> Mis Servicios
                </button>
                <button type="button" onclick="addProfIdPresetLink('WHATSAPP')" class="px-3.5 py-2 bg-teal-50 hover:bg-teal-100 text-teal-800 font-bold text-xs rounded-xl border border-teal-200 transition flex items-center gap-1.5 cursor-pointer">
                  <i class="fa-solid fa-plus text-[10px]"></i> <i class="fa-brands fa-whatsapp"></i> WhatsApp Directo
                </button>
              </div>
            </div>

            <!-- Card 3: Lista de Botones Personalizados -->
            <div class="bg-white rounded-3xl p-6 border border-slate-150 shadow-sm flex flex-col gap-4">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                  <i class="fa-solid fa-list-check text-emerald-600"></i> Botones y Enlaces
                </h3>
                <button type="button" onclick="openAddLinkModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-2 px-3.5 rounded-xl text-xs transition shadow-sm flex items-center gap-1.5 cursor-pointer">
                  <i class="fa-solid fa-plus"></i> Crear Botón
                </button>
              </div>

              <!-- Links Container -->
              <div id="prof-id-links-list" class="flex flex-col gap-2.5">
                <div class="p-6 text-center text-slate-400 text-xs">Cargando botones...</div>
              </div>
            </div>

            <!-- Card 4: Promociones & Contenido Destacado -->
            <div class="bg-white rounded-3xl p-6 border border-slate-150 shadow-sm flex flex-col gap-4">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                  <i class="fa-solid fa-bullhorn text-amber-500"></i> Contenido Destacado / Promociones
                </h3>
                <button type="button" onclick="openAddBlockModal()" class="bg-amber-500 hover:bg-amber-600 text-white font-extrabold py-2 px-3.5 rounded-xl text-xs transition shadow-sm flex items-center gap-1.5 cursor-pointer">
                  <i class="fa-solid fa-plus"></i> Nueva Promoción
                </button>
              </div>

              <!-- Blocks Container -->
              <div id="prof-id-blocks-list" class="flex flex-col gap-3">
                <div class="p-6 text-center text-slate-400 text-xs">Cargando promociones...</div>
              </div>
            </div>

            <!-- Card 5: Apariencia & Estilos Visuales -->
            <div class="bg-white rounded-3xl p-6 border border-slate-150 shadow-sm flex flex-col gap-5">
              <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
                <i class="fa-solid fa-palette text-indigo-600"></i> Personalización de Apariencia
              </h3>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="flex flex-col gap-1.5">
                  <label class="text-[11px] font-black text-slate-500 uppercase tracking-wide">Tema Visual</label>
                  <select id="prof-id-theme" onchange="saveProfIdGeneralConfig()" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3 text-xs font-bold outline-none">
                    <option value="light">☀️ Claro (Recomendado)</option>
                    <option value="dark">🌙 Oscuro</option>
                    <option value="auto">💻 Automático (Sistema)</option>
                  </select>
                </div>

