  <script>
    function toTitleCase(str) {
      if (!str) return "";
      return str
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
    }

    function showCustomConfirm(name, callback) {
      const modal = document.getElementById('custom-confirm-modal');
      const container = modal.querySelector('.transform');
      const nameEl = document.getElementById('custom-confirm-name');
      const btnAccept = document.getElementById('custom-confirm-btn-accept');
      const btnCancel = document.getElementById('custom-confirm-btn-cancel');
      const btnCloseX = document.getElementById('custom-confirm-close-x');

      nameEl.innerText = `"${name}"`;
      
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      setTimeout(() => {
        container.classList.remove('scale-95', 'opacity-0');
      }, 50);

      const newAccept = btnAccept.cloneNode(true);
      const newCancel = btnCancel.cloneNode(true);
      const newCloseX = btnCloseX.cloneNode(true);
      
      btnAccept.parentNode.replaceChild(newAccept, btnAccept);
      btnCancel.parentNode.replaceChild(newCancel, btnCancel);
      btnCloseX.parentNode.replaceChild(newCloseX, btnCloseX);

      newAccept.focus();

      const closeModal = (confirmed) => {
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
          callback(confirmed);
        }, 200);
      };

      newAccept.addEventListener('click', () => {
        closeModal(true);
      });

      newCancel.addEventListener('click', () => {
        closeModal(false);
      });

      newCloseX.addEventListener('click', () => {
        closeModal(false);
      });

      const handleEscape = (e) => {
        if (e.key === 'Escape') {
          document.removeEventListener('keydown', handleEscape);
          closeModal(false);
        }
      };
      document.addEventListener('keydown', handleEscape);
    }

    async function saveCertNameConfig() {
      const rawName = document.getElementById('config-cert-name').value.trim();
      const name = toTitleCase(rawName);
      const successAlert = document.getElementById('config-success-alert');
      const successText = document.getElementById('config-success-text');
      const errorAlert = document.getElementById('config-error-alert');
      const errorText = document.getElementById('config-error-text');
      const btnSave = document.getElementById('btn-save-config');

      if (!name) {
        errorText.innerText = "Por favor, ingrese un nombre válido.";
        errorAlert.classList.remove('hidden');
        successAlert.classList.add('hidden');
        return;
      }

      showCustomConfirm(name, async (confirmed) => {
        if (!confirmed) return;

        errorAlert.classList.add('hidden');
        successAlert.classList.add('hidden');
        
        btnSave.disabled = true;
        btnSave.innerHTML = `<span>Guardando...</span><i class="fa-solid fa-spinner animate-spin"></i>`;

        try {
          const response = await fetch('/dashboard/profesional/configurar-nombre', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ nombreCertificado: name })
          });
          const result = await response.json();

          if (result.success) {
            successText.innerText = result.message || "Guardado exitosamente.";
            successAlert.classList.remove('hidden');
            setTimeout(() => {
              window.location.reload();
            }, 1500);
          } else {
            errorText.innerText = result.error || "Ocurrió un error al guardar.";
            errorAlert.classList.remove('hidden');
            btnSave.disabled = false;
            btnSave.innerHTML = `<span>Guardar Configuración de Nombre</span><i class="fa-solid fa-floppy-disk"></i>`;
          }
        } catch (err) {
          console.error(err);
          errorText.innerText = "Error al conectar con el servidor.";
          errorAlert.classList.remove('hidden');
          btnSave.disabled = false;
          btnSave.innerHTML = `<span>Guardar Configuración de Nombre</span><i class="fa-solid fa-floppy-disk"></i>`;
        }
      });
    }
  </script>

