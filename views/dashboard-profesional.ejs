  <script>
    function toggleMembershipPayMethod(formIndex) {
      const method = document.getElementById('membership-pay-method-' + formIndex).value;
      const transferFields = document.getElementById('membership-transfer-fields-' + formIndex);
      const cardFields = document.getElementById('membership-card-fields-' + formIndex);
      const bankSelect = document.querySelector('#membership-transfer-fields-' + formIndex + ' select');
      const refInput = document.querySelector('#membership-transfer-fields-' + formIndex + ' input');
      const fileInput = document.querySelector('#membership-transfer-fields-' + formIndex + ' input[type="file"]');
      const form = cardFields ? cardFields.closest('form') : null;
      const submitBtn = form ? form.querySelector('button[type="submit"]') : null;
      
      if (method === 'payphone') {
        transferFields.classList.add('hidden');
        cardFields.classList.remove('hidden');
        if (submitBtn) submitBtn.classList.add('hidden');
        if (bankSelect) bankSelect.removeAttribute('required');
        if (refInput) refInput.removeAttribute('required');
        if (fileInput) fileInput.removeAttribute('required');
      } else {
        transferFields.classList.remove('hidden');
        cardFields.classList.add('hidden');
        if (submitBtn) submitBtn.classList.remove('hidden');
        if (bankSelect) bankSelect.setAttribute('required', 'required');
        if (refInput) refInput.setAttribute('required', 'required');
        if (fileInput) fileInput.setAttribute('required', 'required');
      }
    }

    function togglePromoPayMethod() {
      const method = document.getElementById('promo-pay-method').value;
      const transferFields = document.getElementById('promo-transfer-fields');
      const cardFields = document.getElementById('promo-card-fields');
      const bankSelect = document.querySelector('#promo-transfer-fields select');
      const refInput = document.querySelector('#promo-transfer-fields input');
      const fileInput = document.querySelector('#promo-transfer-fields input[type="file"]');
      const form = cardFields ? cardFields.closest('form') : null;
      const submitBtn = form ? form.querySelector('button[type="submit"]') : null;
      
      if (method === 'payphone') {
        transferFields.classList.add('hidden');
        cardFields.classList.remove('hidden');
        if (submitBtn) submitBtn.classList.add('hidden');
        if (bankSelect) bankSelect.removeAttribute('required');
        if (refInput) refInput.removeAttribute('required');
        if (fileInput) fileInput.removeAttribute('required');
      } else {
        transferFields.classList.remove('hidden');
        cardFields.classList.add('hidden');
        if (submitBtn) submitBtn.classList.remove('hidden');
        if (bankSelect) bankSelect.setAttribute('required', 'required');
        if (refInput) refInput.setAttribute('required', 'required');
        if (fileInput) fileInput.setAttribute('required', 'required');
      }
    }

    function openPromotionCheckoutModal(planId, planName, planPrice) {
      document.getElementById('checkout-plan-id').value = planId;
      document.getElementById('checkout-plan-name').value = planName;
      document.getElementById('checkout-plan-price').value = '$' + planPrice.toFixed(2);
      // Guardamos el valor numérico crudo para que el botón de PayPhone lo consuma.
      document.getElementById('checkout-plan-price').dataset.raw = String(planPrice);
      
      // Reset promo pay method to transfer
      const payMethodSelect = document.getElementById('promo-pay-method');
      if (payMethodSelect) {
        payMethodSelect.value = 'transfer';
        togglePromoPayMethod();
      }
      
      document.getElementById('modal-checkout-promocion').classList.remove('hidden');
      document.getElementById('modal-checkout-promocion').classList.add('flex');
    }

