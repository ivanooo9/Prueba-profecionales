    function addInvoiceItem() {
      const toggle = document.getElementById('toggle-manual-item');
      const isManual = toggle && toggle.checked;

      const qtyInput = document.getElementById('invoice-qty');
      const qty = parseInt(qtyInput.value) || 1;

      let productId, nombre, precio, iva, descuento = 0, notaExtra1 = "", notaExtra2 = "";

      if (isManual) {
        const nameInput = document.getElementById('manual-item-name');
        const priceInput = document.getElementById('manual-item-price');
        const ivaSelect = document.getElementById('manual-item-iva');

        nombre = nameInput.value.trim();
        precio = parseFloat(priceInput.value) || 0;
        iva = parseFloat(ivaSelect.value) || 0;
        productId = 'MANUAL-' + Date.now() + '-' + Math.floor(Math.random() * 1000);

        if (!nombre) {
          alert('Ingresa una descripción para el servicio manual.');
          return;
        }
        if (precio <= 0) {
          alert('Ingresa un precio unitario válido mayor a cero.');
          return;
        }

        // Clean manual inputs
        nameInput.value = '';
        priceInput.value = '';
      } else {
        const select = document.getElementById('invoice-service-select');
        if (!select || !select.value) {
          alert('Selecciona un servicio para facturar.');
          return;
        }

        const selectedOpt = select.options[select.selectedIndex];
        productId = select.value;
        nombre = selectedOpt.getAttribute('data-name');
        precio = parseFloat(selectedOpt.getAttribute('data-price')) || 0;
        iva = parseFloat(selectedOpt.getAttribute('data-iva')) || 0;
        descuento = parseFloat(selectedOpt.getAttribute('data-discount')) || 0;
        notaExtra1 = selectedOpt.getAttribute('data-nota1') || "";
        notaExtra2 = selectedOpt.getAttribute('data-nota2') || "";

        select.value = "";
      }

      // Add to local array
      const existing = selectedItems.find(i => i.productId === productId && !productId.startsWith('MANUAL'));
      if (existing) {
        existing.cantidad += qty;
      } else {
        selectedItems.push({
          productId: productId,
          nombre: nombre,
          precio: precio,
          cantidad: qty,
          descuento: descuento,
          iva: iva,
          notaExtra1: notaExtra1,
          notaExtra2: notaExtra2
        });
      }

      renderInvoiceItems();
      qtyInput.value = "1";
    }

    function removeInvoiceItem(index) {
      selectedItems.splice(index, 1);
      renderInvoiceItems();
    }

    function renderInvoiceItems() {
      const tbody = document.getElementById('invoice-items-body');
      tbody.innerHTML = '';

      let subtotal0 = 0;
      let subtotal12 = 0;
      let totalIva = 0;

      selectedItems.forEach((item, index) => {
        const totalSinImp = item.precio * item.cantidad;
        const discount = parseFloat(item.descuento || 0) || 0;
        const baseImponible = totalSinImp - discount;
        const taxRate = item.iva > 0 ? item.iva / 100 : 0;
        const itemIvaVal = baseImponible * taxRate;
        const totalConImp = baseImponible + itemIvaVal;

        if (item.iva <= 0) {
          subtotal0 += baseImponible;
        } else {
          subtotal12 += baseImponible;
          totalIva += itemIvaVal;
        }

        let ivaLabel = item.iva + '%';
        if (item.iva === -1) ivaLabel = 'NO OBJETO';
        if (item.iva === -2) ivaLabel = 'EXENTO';

        tbody.innerHTML += `
          <tr class="border-b border-slate-50 font-medium">
            <td class="py-3 text-slate-900">
              <div class="flex flex-col gap-0.5">
                <span>${item.nombre}</span>
                ${item.notaExtra1 ? `<span class="text-[9px] text-slate-400">Nota 1: ${item.notaExtra1}</span>` : ''}
                ${item.notaExtra2 ? `<span class="text-[9px] text-slate-400">Nota 2: ${item.notaExtra2}</span>` : ''}
              </div>
            </td>
            <td class="py-3 text-right">${item.cantidad}</td>
            <td class="py-3 text-right">$${item.precio.toFixed(2)}</td>
            <td class="py-3 text-right">-$${discount.toFixed(2)}</td>
            <td class="py-3 text-right">${ivaLabel} ($${itemIvaVal.toFixed(2)})</td>
            <td class="py-3 text-right">$${totalConImp.toFixed(2)}</td>
            <td class="py-3 text-right">
              <button type="button" onclick="removeInvoiceItem(${index})" class="text-rose-500 hover:text-rose-700 cursor-pointer">
                <i class="fa-solid fa-times-circle"></i>
              </button>
            </td>
          </tr>
        `;
      });

      const total = subtotal0 + subtotal12 + totalIva;

      document.getElementById('invoice-subtotal0').innerText = `$${subtotal0.toFixed(2)}`;
      document.getElementById('invoice-subtotal12').innerText = `$${subtotal12.toFixed(2)}`;
      document.getElementById('invoice-valiva').innerText = `$${totalIva.toFixed(2)}`;
      document.getElementById('invoice-total').innerText = `$${total.toFixed(2)}`;

      // Update hidden form inputs
      document.getElementById('inp-subtotal0').value = subtotal0;
      document.getElementById('inp-subtotal12').value = subtotal12;
      document.getElementById('inp-valiva').value = totalIva;
      document.getElementById('inp-total').value = total;
      document.getElementById('inp-invoice-items-json').value = JSON.stringify(selectedItems);
    }

    function submitInvoiceForm() {
      if (selectedItems.length === 0) {
        alert('Añade al menos un servicio/ítem para poder emitir la factura.');
        return;
      }
      
      const form = document.getElementById('form-emit-invoice');
      const submitBtn = document.getElementById('btn-submit-invoice');

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = 'FIRMANDO Y AUTORIZANDO... <i class="fa-solid fa-spinner fa-spin ml-1"></i>';
      form.submit();
    }

    // Point of Sale (POS) logic
    const posSelectedItems = [];

    function posAddItem(serviceId, name, price, iva) {
      const existing = posSelectedItems.find(i => i.productId === serviceId);
      if (existing) {
        existing.cantidad += 1;
      } else {
        posSelectedItems.push({
          productId: serviceId,
          nombre: name,
          precio: parseFloat(price) || 0,
          cantidad: 1,
          descuento: 0,
          iva: parseFloat(iva) || 0
        });
      }
      posRenderTicket();
    }

    function posRemoveItem(serviceId) {
      const idx = posSelectedItems.findIndex(i => i.productId === serviceId);
      if (idx !== -1) {
        const item = posSelectedItems[idx];
        if (item.cantidad > 1) {
          item.cantidad -= 1;
        } else {
          posSelectedItems.splice(idx, 1);
        }
      }
      posRenderTicket();
    }

    // Wrap single quotes safely inside ticket renderer
    function safeSingleQuote(str) {
      return str.replace(/'/g, "\\'");
    }

    function posClearCart() {
      posSelectedItems.length = 0;
      posRenderTicket();
    }

