      const lblInstitucion = document.getElementById('lbl-edu-institucion');
      const fieldNivel = document.getElementById('field-nivel-estudio');
      const fieldTipoCert = document.getElementById('field-tipo-certificado');
      const fieldHoras = document.getElementById('field-horas');

      if (tipo === 'TITULO_ACADEMICO') {
        lblTitulo.innerHTML = 'Nombre del Título <span class="text-rose-500">*</span>';
        lblInstitucion.innerHTML = 'Universidad / Instituto Tecnológico <span class="text-rose-500">*</span>';
        fieldNivel.classList.remove('hidden');
        fieldTipoCert.classList.add('hidden');
        fieldHoras.classList.add('hidden');
      } else if (tipo === 'CERTIFICACION_INTERNACIONAL') {
        lblTitulo.innerHTML = 'Nombre de la Certificación <span class="text-rose-500">*</span>';
        lblInstitucion.innerHTML = 'Entidad / Empresa Acreditadora <span class="text-rose-500">*</span>';
