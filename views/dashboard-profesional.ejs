<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
  <!-- Leaflet CSS for Maps -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <!-- Leaflet JS for Maps -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <!-- Chart.js for data visualization -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    /* Professional Accordion Menu Smooth Transition System */
    .prof-category-content {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease-in-out;
    }

    .prof-category-content.open {
      max-height: 600px;
      opacity: 1;
    }

    .prof-category-header {
      transition: background-color 0.2s ease, color 0.2s ease;
      border-radius: 0.75rem;
      padding: 0.4rem 0.6rem;
    }

    .prof-category-header:hover {
      background-color: rgba(241, 245, 249, 0.8);
      color: #0f172a;
    }

    html.dark .prof-category-header:hover {
      background-color: rgba(31, 41, 55, 0.8);
      color: #f8fafc;
    }
  </style>
</head>
<body class="bg-[#FAFBFD] text-slate-800 antialiased font-sans flex flex-col h-screen overflow-hidden">
  <%- include('partials/impersonation-banner') %>
  <div class="flex flex-1 h-full overflow-hidden">

  <!-- Mobile Drawer Backdrop -->
  <div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden transition-all duration-300"></div>

  <!-- Left Sidebar Navigation -->
  <aside id="sidebar-menu" class="w-64 h-full bg-white border-r border-slate-100 flex-shrink-0 flex flex-col justify-between py-6 px-5 fixed lg:static inset-y-0 left-0 -translate-x-full lg:translate-x-0 z-50 transition-all duration-300 ease-in-out shadow-sm lg:shadow-none">
    
    <div class="flex flex-col gap-6 overflow-y-auto max-h-[85vh] pr-1">
      
      <!-- Profile Branding (Mockup Header) -->
      <div class="flex items-center gap-3 px-1">
        <div class="w-11 h-11 rounded-[16px] overflow-hidden bg-slate-50 border border-slate-200/50 flex-shrink-0 shadow-inner flex items-center justify-center">
          <% if (profile && profile.photo) { %>
            <img src="<%= profile.photo %>" class="w-full h-full object-cover">
          <% } else { %>
            <i class="fa-solid fa-user-doctor text-xl text-slate-400"></i>
          <% } %>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1">
            <h3 class="font-extrabold text-xs text-slate-900 leading-tight truncate"><%= user.name %></h3>
            <% if (profile.verified && new Date(profile.subscriptionEnds) > new Date()) { %>
              <span class="inline-flex items-center gap-1 bg-slate-50 border border-slate-100 text-slate-800 px-2 py-0.5 rounded-full shadow-sm" title="Profesional Destacado">
                <i class="fa-solid fa-medal text-amber-500 text-[9px]"></i>
                <span class="text-[8px] font-black uppercase tracking-wider">Destacado</span>
              </span>
            <% } %>
          </div>
          <span class="text-[9px] text-[#0A3C84] font-extrabold uppercase tracking-wider block mt-0.5"><%= profile.planType %></span>
        </div>
      </div>

      <!-- Navigation Tabs (Only active if approved) -->
      <% if (profile.status === 'APROBADO') { %>
        <% const pendCount = profile.appointments ? profile.appointments.filter(a => a.estado === 'PENDIENTE').length : 0; %>
        <nav class="flex flex-col gap-3">

          <!-- Categoría 1: Perfil y Formación -->
          <div class="flex flex-col gap-1">
            <button type="button" onclick="toggleProfCategory('prof-cat-profile')" class="prof-category-header w-full flex items-center justify-between px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-400 hover:text-slate-700 transition cursor-pointer select-none">
              <span class="flex items-center gap-2">
                <i class="fa-solid fa-user-circle text-slate-400"></i>
                <span>Perfil y Formación</span>
              </span>
              <i id="icon-prof-cat-profile" class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200"></i>
            </button>
            <div id="prof-cat-profile" class="prof-category-content flex flex-col gap-1">
              <button onclick="showTab('resumen')" id="btn-resumen" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="resumen">
                <i class="fa-solid fa-chart-line text-sm w-4 text-center"></i>
                <span>Resumen General</span>
              </button>

              <button onclick="showTab('perfil')" id="btn-perfil" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="perfil">
                <i class="fa-solid fa-address-card text-sm w-4 text-center"></i>
                <span>Mi Perfil Público</span>
              </button>

              <button onclick="showTab('educacion')" id="btn-educacion" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="educacion">
                <i class="fa-solid fa-user-graduate text-sm w-4 text-center"></i>
                <span>Formación Académica</span>
              </button>

              <button onclick="showTab('certificates')" id="btn-certificates" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="certificates">
                <i class="fa-solid fa-award text-sm w-4 text-center"></i>
                <span>Mis Certificados</span>
              </button>

              <button onclick="showTab('courses')" id="btn-courses" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="courses">
                <i class="fa-solid fa-graduation-cap text-sm w-4 text-center"></i>
                <span>Mis Cursos</span>
              </button>

              <button onclick="showTab('articulos')" id="btn-articulos" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="articulos">
                <i class="fa-solid fa-file-pdf text-sm w-4 text-center"></i>
                <span>Publicaciones</span>
              </button>

              <button onclick="showTab('configuracion')" id="btn-configuracion" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="configuracion">
                <i class="fa-solid fa-cog text-sm w-4 text-center"></i>
                <span>Ajustes de Cuenta</span>
              </button>
            </div>
          </div>

          <!-- Categoría 2: Consultorio y Citas -->
          <div class="flex flex-col gap-1">
            <button type="button" onclick="toggleProfCategory('prof-cat-services')" class="prof-category-header w-full flex items-center justify-between px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-400 hover:text-slate-700 transition cursor-pointer select-none">
              <span class="flex items-center gap-2">
                <i class="fa-solid fa-stethoscope text-slate-400"></i>
                <span>Consultorio y Citas</span>
                <% if (pendCount > 0) { %>
                  <span class="bg-amber-500 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded-full"><%= pendCount %></span>
                <% } %>
              </span>
              <i id="icon-prof-cat-services" class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200"></i>
            </button>
            <div id="prof-cat-services" class="prof-category-content flex flex-col gap-1">
              <button onclick="showTab('servicios')" id="btn-servicios" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="servicios">
                <i class="fa-solid fa-hand-holding-medical text-sm w-4 text-center"></i>
                <span>Mis Servicios</span>
              </button>

              <button onclick="showTab('horario')" id="btn-horario" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="horario">
                <i class="fa-solid fa-calendar-alt text-sm w-4 text-center"></i>
                <span>Horarios de Atención</span>
              </button>

              <button onclick="showTab('citas')" id="btn-citas" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer relative" data-tab="citas">
                <i class="fa-solid fa-clock text-sm w-4 text-center"></i>
                <span>Agenda de Citas</span>
                <% if (pendCount > 0) { %>
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 bg-amber-500 text-white text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center"><%= pendCount %></span>
                <% } %>
              </button>
            </div>
          </div>

          <!-- Categoría 3: Facturación SRI -->
          <div class="flex flex-col gap-1">
            <button type="button" onclick="toggleProfCategory('prof-cat-billing')" class="prof-category-header w-full flex items-center justify-between px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-400 hover:text-slate-700 transition cursor-pointer select-none">
              <span class="flex items-center gap-2">
                <i class="fa-solid fa-file-invoice-dollar text-slate-400"></i>
                <span>Facturación SRI</span>
              </span>
              <i id="icon-prof-cat-billing" class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200"></i>
            </button>
            <div id="prof-cat-billing" class="prof-category-content flex flex-col gap-1">
              <button onclick="showTab('facturacion')" id="btn-facturacion" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="facturacion">
                <i class="fa-solid fa-receipt text-sm w-4 text-center"></i>
                <span>Facturación Electrónica</span>
              </button>

              <button onclick="showTab('productos')" id="btn-productos" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="productos">
                <i class="fa-solid fa-box text-sm w-4 text-center"></i>
                <span>Mis Productos (SRI)</span>
              </button>
            </div>
          </div>

          <!-- Categoría 4: Marketing y Crecimiento -->
          <div class="flex flex-col gap-1">
            <button type="button" onclick="toggleProfCategory('prof-cat-marketing')" class="prof-category-header w-full flex items-center justify-between px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-slate-400 hover:text-slate-700 transition cursor-pointer select-none">
              <span class="flex items-center gap-2">
                <i class="fa-solid fa-rocket text-slate-400"></i>
                <span>Crecimiento</span>
              </span>
              <i id="icon-prof-cat-marketing" class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200"></i>
            </button>
            <div id="prof-cat-marketing" class="prof-category-content flex flex-col gap-1">
              <button onclick="showTab('profesional-id')" id="btn-profesional-id" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-between text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="profesional-id">
                <div class="flex items-center gap-3">
                  <i class="fa-solid fa-id-card-clip text-sm w-4 text-center text-purple-600"></i>
                  <span>Profesionales ID</span>
                </div>
                <span class="bg-purple-100 text-purple-700 text-[9px] font-black px-1.5 py-0.5 rounded-full uppercase tracking-wide">Nuevo</span>
              </button>
              <button onclick="showTab('promociones')" id="btn-promociones" class="tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-3 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="promociones">
                <i class="fa-solid fa-rectangle-ad text-sm w-4 text-center"></i>
                <span>Promocionar mi Perfil</span>
              </button>
            </div>
          </div>

        </nav>
      <% } else { %>
        <nav class="flex flex-col gap-1">
          <span class="px-4 py-2 text-[10px] uppercase font-bold text-slate-400 tracking-wider">Preinscripción</span>
        </nav>
      <% } %>
    </div>

    <!-- Log Out Link at Bottom -->
    <div class="flex flex-col gap-2">
      <div class="border-t border-slate-100 pt-4 flex flex-col gap-1">
        <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-bold text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition duration-200">
          <i class="fa-solid fa-globe text-sm w-4 text-center text-sky-500 animate-pulse"></i>
          <span>Volver a la Web</span>
        </a>
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-bold text-rose-500 hover:bg-rose-50/50 transition duration-200">
          <i class="fa-solid fa-right-from-bracket text-sm w-4 text-center"></i>
          <span>Cerrar Sesión</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Content View Area -->
  <div class="flex-1 flex flex-col h-screen overflow-hidden">
    
    <!-- Top Utility Header Bar -->
    <header class="h-20 bg-white border-b border-slate-100 flex items-center justify-between px-6 md:px-10 flex-shrink-0">
      
      <!-- Left side: Hamburger button + Title -->
      <div class="flex items-center gap-4">
        <button id="mobile-menu-toggle" class="lg:hidden w-10 h-10 rounded-xl bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-600 transition border border-slate-100 cursor-pointer">
          <i class="fa-solid fa-bars-staggered"></i>
        </button>
        <div>
          <h1 class="text-xl md:text-2xl font-black text-slate-900 leading-none">Mi Dashboard Profesional</h1>
          <span class="text-[10px] text-slate-400 font-extrabold mt-1.5 block uppercase tracking-wider"><%= new Date().toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' }) %></span>
        </div>
      </div>

      <!-- Right side: Actions -->
      <div class="flex items-center gap-4">
        <!-- Search input box (Mockup styling) -->
        <div class="relative max-w-xs hidden md:block search-container-wrapper">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
          <input type="text" id="dashboard-search-input" placeholder="Buscar..." class="w-48 xl:w-60 bg-slate-50 border border-slate-100 rounded-full py-2.5 pl-10 pr-4 text-xs font-semibold outline-none focus:bg-white focus:border-[#5A7AF3] transition duration-200">
          <div id="search-autocomplete-dropdown" class="absolute left-0 mt-2 w-80 rounded-2xl bg-white dark:bg-slate-900 border border-slate-150 dark:border-slate-800 shadow-xl p-4 z-50 hidden max-h-96 overflow-y-auto"></div>
        </div>

        <!-- Mode controls / Notification badges -->
        <div class="flex items-center gap-2">
          <button id="theme-toggle-btn" class="w-10 h-10 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 text-xs transition border border-slate-50 cursor-pointer" title="Modo Claro">
            <i id="theme-toggle-icon" class="fa-solid fa-sun text-amber-500"></i>
          </button>
          <div class="relative notification-container-wrapper">
            <button id="notification-toggle-btn" class="w-10 h-10 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 text-xs transition border border-slate-50 cursor-pointer relative" title="Notificaciones">
              <i class="fa-regular fa-bell"></i>
              <span id="notification-unread-dot" class="absolute top-2 right-2 w-2 h-2 rounded-full bg-rose-500"></span>
            </button>
            <div id="notifications-dropdown-menu" class="absolute right-0 mt-2 w-80 rounded-2xl bg-white dark:bg-slate-900 border border-slate-150 dark:border-slate-800 shadow-xl py-2 z-50 hidden max-h-96 overflow-y-auto">
              <!-- Dynamic notifications list -->
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div class="h-6 w-px bg-slate-100 hidden sm:block"></div>

        <!-- Quick Profile Link -->
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-[12px] overflow-hidden bg-slate-150 border border-slate-100 flex items-center justify-center shadow-inner flex-shrink-0">
            <% if (profile && profile.photo) { %>
              <img src="<%= profile.photo %>" class="w-full h-full object-cover">
            <% } else { %>
              <i class="fa-solid fa-user-doctor text-slate-450 text-sm"></i>
            <% } %>
          </div>
          <span class="text-xs font-black text-slate-800 hidden sm:inline"><%= user.name %></span>
        </div>
      </div>
    </header>

    <!-- Scrollable Content Area -->
    <main class="flex-1 overflow-y-auto bg-[#FAFBFD] p-6 md:p-10 flex flex-col gap-8">
      
      <!-- Alert Messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-rose-50 border border-rose-200 text-rose-700 px-5 py-3.5 rounded-2xl text-xs font-bold flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm"></i>
          <span>
            <% if (error === 'password_incorrect') { %>
              La contraseña actual es incorrecta.
            <% } else if (error === 'password_length') { %>
              La nueva contraseña debe tener al menos 6 caracteres.
            <% } else if (error === 'missing_issuer_config') { %>
              Antes de emitir una factura, completa la configuración de emisor SRI.
            <% } else if (error === 'no_items') { %>
              Debes añadir al menos un item para emitir la factura.
            <% } else if (error === 'signature_failed') { %>
              Error al firmar digitalmente la factura. Verifique su archivo .p12 y contraseña.
            <% } else if (error === 'sri_rejection') { %>
              La factura fue devuelta o rechazada por el SRI.
            <% } else if (error === 'config_failed') { %>
              Error al guardar la configuración del emisor.
            <% } else if (error === 'internal_invoice_error') { %>
              Error interno al procesar la factura.
            <% } else if (error === 'duplicate_product_code') { %>
              El código principal ingresado ya existe en tu catálogo.
            <% } else if (error === 'missing_fields') { %>
              Por favor complete todos los campos obligatorios.
            <% } else if (error === 'product_failed') { %>
              Error al guardar el producto. Intente nuevamente.
            <% } else if (error === 'delete_product_failed') { %>
              Error al eliminar el producto.
            <% } else if (error === 'profile_not_found') { %>
              No se encontró el perfil del profesional.
            <% } else if (error === 'past_date') { %>
              No se puede reprogramar a una fecha u hora del pasado.
            <% } else if (error === 'reschedule_failed') { %>
              Error al reprogramar la cita. Intente nuevamente.
            <% } else if (error === 'appointment_not_found') { %>
              La cita no existe.
            <% } else { %>
              Ha ocurrido un error en la operación.
            <% } %>
          </span>
        </div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-emerald-50 border border-emerald-250 text-emerald-700 px-5 py-3.5 rounded-2xl text-xs font-bold flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
          <span>
            <% if (success === 'payment_submitted') { %>
              Su comprobante de pago ha sido enviado con éxito para revisión del administrador.
            <% } else if (success === 'membership_activated') { %>
              ¡Felicidades! Su membresía ha sido activada de forma inmediata con su tarjeta de crédito. Su perfil ahora cuenta con la insignia de Verificado.
            <% } else if (success === 'promotion_activated') { %>
              ¡Felicidades! Su plan de promoción ha sido activado de forma inmediata con su tarjeta de crédito. Ya puede subir sus banners y pop-ups.
            <% } else if (success === 'password_changed') { %>
              Su contraseña ha sido cambiada con éxito.
            <% } else if (success === 'social_updated') { %>
              Sus enlaces de redes sociales se han actualizado con éxito.
            <% } else if (success === 'appointment_rescheduled') { %>
              La cita ha sido reprogramada con éxito. Se le notificó al cliente.
            <% } else if (success === 'config_success') { %>
              Configuración de emisor SRI guardada con éxito.
            <% } else if (success === 'invoice_authorized') { %>
              Factura firmada, autorizada y enviada con éxito al correo del cliente.
            <% } else if (success === 'product_created') { %>
              Producto agregado al catálogo con éxito.
            <% } else if (success === 'product_updated') { %>
              Producto actualizado con éxito.
            <% } else if (success === 'product_deleted') { %>
              Producto eliminado del catálogo con éxito.
            <% } else { %>
              Operación realizada con éxito.
            <% } %>
          </span>
        </div>
      <% } %>

      <% if (profile.status !== 'APROBADO') { %>
        <!-- Pending Approval / Pre-inscription Gate -->
        <div class="flex flex-col gap-8 max-w-4xl mx-auto w-full">
          <!-- Status Card -->
          <div class="bg-white rounded-3xl border border-slate-100 p-8 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-4 text-left">
              <div class="w-14 h-14 rounded-full flex items-center justify-center text-2xl <%= profile.status === 'RECHAZADO' ? 'bg-rose-50 text-rose-500' : 'bg-amber-50 text-amber-500' %> flex-shrink-0">
                <i class="<%= profile.status === 'RECHAZADO' ? 'fa-solid fa-circle-xmark' : 'fa-solid fa-clock' %>"></i>
              </div>
              <div>
                <h2 class="text-lg font-extrabold text-slate-900">Estado de Preinscripción: <%= profile.status %></h2>
                <p class="text-slate-500 text-xs font-semibold mt-1 leading-relaxed">
                  <% if (profile.status === 'RECHAZADO') { %>
                    Su solicitud ha sido rechazada por el administrador. Comuníquese con soporte para solventar los inconvenientes.
                  <% } else { %>
                    Su perfil se encuentra en revisión. Una vez aprobado por un administrador, tendrá acceso completo al sistema de citas y facturación.
                  <% } %>
                </p>
              </div>
            </div>
            <div class="flex flex-col items-center gap-2 flex-shrink-0">
              <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Plan Solicitado</span>
