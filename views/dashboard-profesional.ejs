          <div id="block-image-placeholder-container" class="border-2 border-dashed border-slate-200 hover:border-brand-blue rounded-2xl p-4 text-center cursor-pointer bg-slate-50/50 transition flex flex-col items-center gap-1.5" onclick="document.getElementById('block-image-file-input').click()">
            <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-400"></i>
            <span class="text-xs font-bold text-slate-700">Haz clic aquí para subir una imagen desde tus archivos</span>
            <span class="text-[10px] text-slate-400 font-medium">Archivos JPG, PNG, WebP o SVG</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Texto del Botón</label>
            <input type="text" id="block-form-btn-text" placeholder="Aprovechar" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none font-bold">
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Enlace de Destino</label>
            <input type="text" id="block-form-url" placeholder="https://wa.me/..." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none font-medium">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Fecha Expiración (Opcional)</label>
            <input type="date" id="block-form-end-at" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs outline-none font-medium">
          </div>
          <div class="flex flex-col gap-1.5 justify-end">
            <label class="flex items-center gap-2 mb-2 text-xs font-bold text-slate-700 cursor-pointer">
              <input type="checkbox" id="block-form-active" checked class="w-4 h-4 rounded text-brand-blue">
              <span>Activo</span>
            </label>
          </div>
        </div>

        <div class="flex justify-end gap-3 mt-3">
          <button type="button" onclick="closeProfIdBlockModal()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-5 rounded-xl text-xs transition cursor-pointer">Cancelar</button>
          <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white font-bold py-2.5 px-5 rounded-xl text-xs transition shadow-md cursor-pointer">Guardar Promoción</button>
        </div>
      </form>
    </div>
  </div>
  </div>

  <!-- MODAL: COMPRAR PLAN DE FACTURACIÓN ELECTRÓNICA -->
  <div id="modal-billing-plans" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-[28px] max-w-3xl w-full p-6 md:p-8 shadow-2xl border border-slate-100 max-h-[90vh] overflow-y-auto text-left relative">
      <button type="button" onclick="closeBillingPlansModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-700 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition cursor-pointer">
        <i class="fa-solid fa-times text-sm"></i>
      </button>

      <div class="mb-6">
        <span class="px-3 py-1 bg-blue-50 text-[#0A3C84] rounded-full text-[10px] font-extrabold uppercase tracking-wider">Amplía tu Capacidad</span>
        <h3 class="text-xl font-extrabold text-slate-900 mt-2 font-sans">Planes de Facturación Electrónica SRI</h3>
        <p class="text-xs text-slate-500 mt-1">Selecciona el plan de facturación que mejor se adapte al volumen de tu negocio.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
        <% if (typeof billingPlans !== 'undefined' && billingPlans && billingPlans.length > 0) { %>
          <% billingPlans.forEach(function(plan) { %>
            <div class="border border-slate-200 hover:border-[#0A3C84] rounded-2xl p-5 flex flex-col justify-between transition hover:shadow-lg bg-white relative">
              <% if (plan.invoiceLimit === -1) { %>
                <span class="absolute -top-3 right-4 bg-emerald-500 text-white text-[9px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-sm">Ilimitado</span>
              <% } %>
              <div>
                <h4 class="font-black text-slate-900 text-base mb-1"><%= plan.nombre %></h4>
                <p class="text-[11px] text-slate-500 mb-4 min-h-[32px]"><%= plan.descripcion || 'Ideal para emitir comprobantes autorizados.' %></p>
                
                <div class="mb-4">
                  <span class="text-2xl font-black text-[#0A3C84]">$<%= plan.precio.toFixed(2) %></span>
                  <span class="text-[10px] text-slate-400 font-bold">/ <%= plan.duracionDias %> días</span>
                </div>

                <ul class="text-xs text-slate-600 flex flex-col gap-2 mb-6">
                  <li class="flex items-center gap-2">
                    <i class="fa-solid fa-check text-emerald-500 text-xs"></i>
                    <span class="font-bold">
                      <%= plan.invoiceLimit === -1 ? 'Facturas Ilimitadas' : (plan.invoiceLimit + ' Facturas Electrónicas') %>
                    </span>
                  </li>
                  <li class="flex items-center gap-2">
                    <i class="fa-solid fa-check text-emerald-500 text-xs"></i>
                    <span>Firma Electrónica Incluida</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <i class="fa-solid fa-check text-emerald-500 text-xs"></i>
                    <span>Envío por Email + PDF RIDE</span>
                  </li>
                </ul>
              </div>

              <button type="button" onclick="selectBillingPlanForPurchase(<%= plan.id %>, '<%= plan.nombre.replace(/'/g, "\\'") %>', <%= plan.precio %>)" class="w-full bg-[#0A3C84] hover:bg-[#08306b] text-white font-bold py-2.5 rounded-xl text-xs transition cursor-pointer text-center">
                Seleccionar Plan
              </button>
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-span-3 text-center py-8 bg-slate-50 border border-slate-100 rounded-2xl text-slate-400">
            <i class="fa-solid fa-info-circle text-2xl mb-2 text-slate-300"></i>
            <p class="text-xs font-bold">No hay planes de facturación adicionales configurados por el momento.</p>
          </div>
        <% } %>
      </div>

      <!-- Formulario de Confirmación y Pago -->
      <div id="billing-plan-payment-form-container" class="hidden bg-slate-50 p-6 rounded-2xl border border-slate-200">
        <h4 class="font-black text-slate-900 text-sm mb-4 flex items-center gap-2">
          <i class="fa-solid fa-receipt text-[#0A3C84]"></i> Confirmar Adquisición: <span id="selected-billing-plan-title" class="text-[#0A3C84]"></span>
        </h4>

        <form action="/dashboard/profesional/facturacion/comprar-plan" method="POST" class="flex flex-col gap-4">
          <input type="hidden" name="planId" id="purchase-billing-plan-id">
          <input type="hidden" name="paymentMethod" value="transfer">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-slate-700 text-xs font-bold mb-1">Banco Destino</label>
              <select name="bank" required class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800">
                <option value="Banco Pichincha">Banco Pichincha - Ahorros 2200123456</option>
                <option value="Banco Guayaquil">Banco Guayaquil - Corriente 10293847</option>
              </select>
            </div>
            <div>
              <label class="block text-slate-700 text-xs font-bold mb-1">Número de Comprobante / Referencia</label>
              <input type="text" name="reference" required placeholder="Ej: 98765432" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800">
            </div>
          </div>

          <div>
            <label class="block text-slate-700 text-xs font-bold mb-1">Adjuntar Comprobante de Pago (Imagen)</label>
            <input type="file" accept="image/*" onchange="handleBillingPlanReceiptUpload(this)" class="text-xs file:bg-white file:border file:border-slate-200 file:px-3 file:py-1.5 file:rounded-lg file:text-[10px] file:font-bold file:cursor-pointer">
            <input type="hidden" name="comprobante" id="billing-plan-receipt-base64">
          </div>

          <div class="flex justify-end gap-3 mt-2">
            <button type="button" onclick="document.getElementById('billing-plan-payment-form-container').classList.add('hidden')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-4 py-2 rounded-xl text-xs transition cursor-pointer">
              Cancelar
            </button>
            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-2 rounded-xl text-xs transition shadow-sm cursor-pointer">
              Enviar Comprobante de Pago <i class="fa-solid fa-paper-plane ml-1"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openBillingPlansModal() {
      const modal = document.getElementById('modal-billing-plans');
      if (modal) modal.classList.remove('hidden');
    }

    function closeBillingPlansModal() {
      const modal = document.getElementById('modal-billing-plans');
      if (modal) modal.classList.add('hidden');
    }

    function selectBillingPlanForPurchase(planId, planName, price) {
      document.getElementById('purchase-billing-plan-id').value = planId;
      document.getElementById('selected-billing-plan-title').innerText = planName + ' ($' + price.toFixed(2) + ')';
      const formContainer = document.getElementById('billing-plan-payment-form-container');
      if (formContainer) {
        formContainer.classList.remove('hidden');
        formContainer.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function handleBillingPlanReceiptUpload(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('billing-plan-receipt-base64').value = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
      }
    }
  </script>
  <script src="/js/payphone-helper.js"></script>
</body>
</html>
