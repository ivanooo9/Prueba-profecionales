<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bgLight flex flex-col min-h-screen text-slate-800 antialiased font-sans">
  <!-- Header / Navbar -->
  <%- include('partials/header') %>

  <!-- Main Content -->
  <main class="flex-grow max-w-7xl mx-auto w-full px-6 md:px-12 py-16 space-y-16">
    
    <!-- 1. Hero / Header Section -->
    <div class="text-left space-y-3" data-reveal="fade-up">
      <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#0a66c2] block">Profesionales Ecuador</span>
      <h1 class="text-4xl md:text-5xl font-heading font-black tracking-tight text-slate-900 leading-tight">
        Sobre Nosotros
      </h1>
      <p class="text-slate-600 text-sm md:text-base font-semibold max-w-3xl leading-relaxed mt-4">
        <%= nosotrosData.subtitle %>
      </p>
    </div>

    <hr class="border-slate-200" data-reveal="fade-up">

    <!-- 2. Misión & Visión Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-left" data-reveal="fade-up">
      <!-- Misión -->
      <div class="space-y-3 p-6 bg-white rounded-2xl border border-slate-100 shadow-sm premium-card-hover" data-reveal="fade-right">
        <h3 class="text-lg font-black tracking-tight text-slate-950 font-heading flex items-center gap-2">
          <i class="fa-solid fa-bullseye text-[#0a66c2] text-base"></i> Misión
        </h3>
        <p class="text-xs md:text-sm font-semibold text-slate-650 leading-relaxed">
          <%= nosotrosData.mision %>
        </p>
      </div>

      <!-- Visión -->
      <div class="space-y-3 p-6 bg-white rounded-2xl border border-slate-100 shadow-sm premium-card-hover" data-reveal="fade-left">
        <h3 class="text-lg font-black tracking-tight text-slate-950 font-heading flex items-center gap-2">
          <i class="fa-solid fa-eye text-[#0a66c2] text-base"></i> Visión
        </h3>
        <p class="text-xs md:text-sm font-semibold text-slate-650 leading-relaxed">
          <%= nosotrosData.vision %>
        </p>
      </div>
    </div>

    <hr class="border-slate-200">

    <!-- 3. ¿Quiénes Somos? & Nuestra Historia -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-left">
      <!-- ¿Quiénes Somos? -->
      <div class="space-y-4">
        <h3 class="text-lg font-black tracking-tight text-slate-950 font-heading flex items-center gap-2">
          <i class="fa-solid fa-users text-[#0a66c2] text-base"></i> ¿Quiénes Somos?
        </h3>
        <div class="text-xs md:text-sm font-semibold text-slate-650 leading-relaxed space-y-4 whitespace-pre-line"><%= nosotrosData.quienesSomos %></div>
      </div>

      <!-- Nuestra Historia -->
      <div class="space-y-4">
        <h3 class="text-lg font-black tracking-tight text-slate-950 font-heading flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left text-[#0a66c2] text-base"></i> Nuestra Historia
        </h3>
        <div class="text-xs md:text-sm font-semibold text-slate-650 leading-relaxed space-y-4 whitespace-pre-line"><%= nosotrosData.historia %></div>
      </div>
    </div>

    <!-- 4. Fundadores Section -->
    <div class="text-left space-y-6">
      <h3 class="text-lg font-black tracking-tight text-slate-950 font-heading">
        Fundadores
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
        <% nosotrosData.fundadores.forEach(f => { %>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full border-2 border-brand-blue flex items-center justify-center font-black text-sm text-brand-blue bg-white flex-shrink-0 shadow-sm">
              <%= f.iniciales %>
            </div>
            <div>
              <div class="text-xs font-black text-slate-900 leading-tight"><%= f.nombre %></div>
              <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider mt-0.5"><%= f.cargo %></div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <hr class="border-slate-200">

    <!-- 5. Nuestros Valores Section -->
    <div class="text-left space-y-6">
      <h3 class="text-lg font-black tracking-tight text-slate-950 font-heading">
        Nuestros Valores
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <% nosotrosData.valores.forEach(val => { %>
          <div class="space-y-2 border-t border-slate-100 pt-4 text-left">
            <h4 class="text-xs font-black text-slate-950 font-heading flex items-center gap-2">
              <i class="<%= val.icon || 'fa-solid fa-check' %> text-[#0a66c2] text-xs"></i> <%= val.titulo %>
            </h4>
            <p class="text-[11px] font-bold text-slate-500 leading-relaxed"><%= val.descripcion %></p>
          </div>
        <% }); %>
      </div>
    </div>

    <hr class="border-slate-200">

    <!-- 6. ¿Por Qué Confiar? & Nuestro Compromiso -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-left">
      <!-- ¿Por qué confiar? -->
      <div class="space-y-4">
        <h3 class="text-lg font-black tracking-tight text-slate-955 font-heading">
          ¿Por Qué Confiar en Profesionales Ecuador?
        </h3>
        <ul class="space-y-3.5">
          <% (nosotrosData.porQueConfiar || []).forEach(item => { %>
            <li class="flex items-start gap-2.5 text-xs font-bold text-slate-650 leading-normal">
              <i class="fa-regular fa-circle-check text-blue-500 text-sm mt-0.5 flex-shrink-0"></i>
              <span><%= item %></span>
            </li>
          <% }); %>
        </ul>
      </div>

      <!-- Nuestro Compromiso -->
      <div class="space-y-4">
        <h3 class="text-lg font-black tracking-tight text-slate-955 font-heading">
          Nuestro Compromiso
        </h3>
        <ul class="space-y-3.5">
          <% (nosotrosData.compromiso || []).forEach(item => { %>
            <li class="flex items-start gap-3 text-xs font-bold text-slate-650 leading-normal">
              <span class="w-1.5 h-1.5 rounded-full bg-[#0a66c2] mt-2 flex-shrink-0"></span>
              <span><%= item %></span>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>

    <!-- 7. Conversatorios y Eventos Policy Block -->
    <% if (nosotrosData.eventosPolitica) { %>
      <div class="border-l-4 border-[#0a66c2] bg-slate-50 p-6 md:p-8 rounded-r-2xl text-left space-y-4">
        <h4 class="text-base font-black text-slate-950 font-heading">Conversatorios y Eventos</h4>
        <div class="text-xs font-semibold text-slate-600 leading-relaxed whitespace-pre-line space-y-3">
          <%= nosotrosData.eventosPolitica %>
        </div>
      </div>
    <% } %>

  </main>

  <!-- Footer -->
  <%- include('partials/footer') %>
</body>
</html>
