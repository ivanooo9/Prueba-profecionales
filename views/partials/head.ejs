<script>
  // Prevents dark mode flicker by running inline immediately
  if (localStorage.getItem('theme') === 'dark') {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }

  // DOMContentLoaded hook for interactive features
  document.addEventListener('DOMContentLoaded', () => {
    initThemeToggle();
    initNotifications();
    initSearchAutocomplete();
  });

  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    const icon = document.getElementById('theme-toggle-icon');
    if (!btn || !icon) return;

    // Sincronize UI on load
    const isDark = document.documentElement.classList.contains('dark');
    updateThemeUI(isDark);

    btn.addEventListener('click', () => {
      const darkActive = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', darkActive ? 'dark' : 'light');
      updateThemeUI(darkActive);
    });

    function updateThemeUI(darkActive) {
      if (darkActive) {
        icon.className = 'fa-solid fa-moon text-sky-400';
        btn.title = 'Modo Claro';
      } else {
        icon.className = 'fa-solid fa-sun text-amber-500';
        btn.title = 'Modo Oscuro';
      }
    }
  }

  function initNotifications() {
    const btn = document.getElementById('notification-toggle-btn');
    const menu = document.getElementById('notifications-dropdown-menu');
    const dot = document.getElementById('notification-unread-dot');
    if (!btn || !menu) return;

    let knownIds = new Set();
    let isFirstLoad = true;

    // Web Audio Synthesizer Chime
    function playChime() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.12);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.28);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.28);
      } catch (e) {}
    }

    // Floating Toast Notification Banner
    function showToast(notification) {
      let container = document.getElementById('live-toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'live-toast-container';
        container.className = 'fixed top-4 right-4 z-[9999] flex flex-col gap-3 max-w-sm pointer-events-none';
        document.body.appendChild(container);
      }

      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto bg-slate-900/95 dark:bg-slate-900/95 text-white border border-slate-700/80 p-4 rounded-2xl shadow-2xl backdrop-blur-md flex items-start gap-3 transform translate-x-12 opacity-0 transition-all duration-300 cursor-pointer hover:border-blue-500';
      toast.innerHTML = `
        <div class="w-8 h-8 rounded-xl bg-blue-600/30 text-blue-400 flex items-center justify-center shrink-0 text-sm mt-0.5 border border-blue-500/30">
          <i class="fa-solid fa-bell animate-bounce"></i>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <span class="font-extrabold text-xs text-white truncate">${notification.title}</span>
            <span class="text-[9px] bg-rose-500/80 text-white font-black px-1.5 py-0.5 rounded-full uppercase tracking-widest">En Vivo</span>
          </div>
          <p class="text-[11px] text-slate-300 font-medium mt-1 leading-snug">${notification.message}</p>
        </div>
        <button type="button" onclick="this.parentElement.remove(); event.stopPropagation();" class="text-slate-400 hover:text-white transition text-xs p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      `;

      toast.onclick = (e) => {
        if (!e.defaultPrevented) {
          handleNotificationNavigation(notification.link);
          toast.remove();
        }
      };

      container.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('translate-x-12', 'opacity-0');
      });

      setTimeout(() => {
        if (toast.parentElement) {
          toast.classList.add('translate-x-12', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }
      }, 7000);
    }

    // Load & Poll Notifications
    function fetchNotifications() {
      fetch('/api/notifications')
        .then(res => res.json())
        .then(data => {
          if (data.success && data.notifications) {
            const list = data.notifications;
            let hasNew = false;
            let newestItem = null;

            list.forEach(n => {
              if (!knownIds.has(n.id)) {
                if (!isFirstLoad) {
                  hasNew = true;
                  if (!newestItem) newestItem = n;
                }
                knownIds.add(n.id);
              }
            });

            if (hasNew && newestItem) {
              playChime();
              showToast(newestItem);
            }

            isFirstLoad = false;
            renderNotifications(list);
          }
        })
        .catch(err => console.error('Error fetching notifications:', err));
    }

    // Initial load + Real-time Live Interval (every 5s)
    fetchNotifications();
    const liveInterval = setInterval(fetchNotifications, 5000);

    // Toggle menu dropdown
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
      const searchMenu = document.getElementById('search-autocomplete-dropdown');
      if (searchMenu) searchMenu.classList.add('hidden');
    });

    // Close on clicking outside
    document.addEventListener('click', (e) => {
      if (!menu.classList.contains('hidden') && !menu.contains(e.target) && e.target !== btn) {
        menu.classList.add('hidden');
      }
    });

    function renderNotifications(list) {
      if (list.length > 0) {
        if (dot) {
          dot.classList.remove('hidden');
          dot.classList.add('animate-pulse');
        }
      } else {
        if (dot) {
          dot.classList.add('hidden');
          dot.classList.remove('animate-pulse');
        }
      }

      let html = `
        <div class="px-4 py-2.5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/50 dark:bg-slate-900/50">
          <div class="flex items-center gap-1.5">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="font-extrabold text-[10px] text-slate-800 dark:text-slate-200 uppercase tracking-wider">Notificaciones En Vivo</span>
          </div>
          <span class="text-[9px] bg-rose-500 text-white font-black px-2 py-0.5 rounded-full shadow-sm">${list.length}</span>
        </div>
        <div class="flex flex-col max-h-[320px] overflow-y-auto">
      `;

      if (list.length === 0) {
        html += `
          <div class="p-6 text-center text-slate-400 dark:text-slate-500 text-xs flex flex-col items-center gap-2">
            <i class="fa-regular fa-bell-slash text-xl opacity-60"></i>
            <span class="font-semibold">No tienes notificaciones pendientes</span>
          </div>
        `;
      } else {
        list.forEach(n => {
          let bgClass = 'bg-slate-50 text-slate-500 dark:bg-slate-800 dark:text-slate-400';
          let iconClass = 'fa-solid fa-bell';

          if (n.type === 'success') {
            bgClass = 'bg-emerald-50 text-emerald-500 dark:bg-emerald-950/30 dark:text-emerald-400';
            iconClass = 'fa-solid fa-circle-check';
          } else if (n.type === 'warning') {
            bgClass = 'bg-amber-50 text-amber-500 dark:bg-amber-950/30 dark:text-amber-400';
            iconClass = 'fa-solid fa-circle-exclamation';
          } else if (n.type === 'info') {
            bgClass = 'bg-blue-50 text-blue-500 dark:bg-blue-950/30 dark:text-blue-400';
            iconClass = 'fa-solid fa-circle-info';
          }

          html += `
            <a href="${n.link}" onclick="event.preventDefault(); handleNotificationNavigation('${n.link}');" class="flex gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-850 border-b border-slate-100/50 dark:border-slate-800/60 last:border-none transition">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 text-xs ${bgClass}">
                <i class="${iconClass}"></i>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-bold text-xs text-slate-800 dark:text-slate-200 truncate">${n.title}</span>
                  <span class="text-[8px] text-slate-400 font-bold shrink-0">${timeAgo(n.date)}</span>
                </div>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1 leading-normal font-medium">${n.message}</p>
              </div>
            </a>
          `;
        });
      }

      html += `</div>`;
      menu.innerHTML = html;
    }

    function timeAgo(dateStr) {
      const date = new Date(dateStr);
      const now = new Date();
      const diffMs = now.getTime() - date.getTime();
      const diffMins = Math.floor(diffMs / 60000);
      if (diffMins < 1) return 'Ahora';
      if (diffMins < 60) return `${diffMins}m`;
      const diffHours = Math.floor(diffMins / 60);
      if (diffHours < 24) return `${diffHours}h`;
      const diffDays = Math.floor(diffHours / 24);
      return `${diffDays}d`;
    }
  }

  // Global handler for smooth notification tab switching
  function handleNotificationNavigation(link) {
    const menu = document.getElementById('notifications-dropdown-menu');
    if (menu) menu.classList.add('hidden');

    if (!link) return;

    const url = new URL(link, window.location.origin);
    const targetTab = url.searchParams.get('tab');

    if (window.location.pathname === url.pathname && targetTab && typeof switchTab === 'function') {
      switchTab(targetTab);
    } else {
      window.location.href = link;
    }
  }

  function initSearchAutocomplete() {
    const input = document.getElementById('dashboard-search-input');
    const dropdown = document.getElementById('search-autocomplete-dropdown');
    if (!input || !dropdown) return;

    let debounceTimeout;

    input.addEventListener('input', () => {
      clearTimeout(debounceTimeout);
      const q = input.value.trim();
      if (!q) {
        dropdown.classList.add('hidden');
        return;
      }

      debounceTimeout = setTimeout(() => {
        fetch(`/api/dashboard/search?q=${encodeURIComponent(q)}`)
          .then(res => res.json())
          .then(data => {
            if (data.success && data.results) {
              renderResults(data.results);
            }
          })
          .catch(err => console.error('Error during autocomplete search:', err));
      }, 250);
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!dropdown.classList.contains('hidden') && !dropdown.contains(e.target) && e.target !== input) {
        dropdown.classList.add('hidden');
      }
    });

    // Re-open if input gets focus and has value
    input.addEventListener('focus', () => {
      if (input.value.trim()) {
        dropdown.classList.remove('hidden');
      }
    });

    function renderResults(results) {
      const categories = Object.keys(results);
      let hasAnyResult = false;
      let html = '';

      const catNames = {
        clients: 'Clientes',
        professionals: 'Profesionales',
        cursos: 'Cursos Académicos',
        conversatorios: 'Conversatorios',
        articles: 'Artículos',
        appointments: 'Mis Citas',
        certificates: 'Mis Certificados'
      };

      categories.forEach(cat => {
        const items = results[cat];
        if (items && items.length > 0) {
          hasAnyResult = true;
          html += `
            <div class="mb-4 last:mb-0">
              <span class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest block mb-2 border-b border-slate-50 dark:border-slate-850 pb-1">${catNames[cat] || cat}</span>
              <div class="flex flex-col gap-1">
          `;

          items.forEach(item => {
            let titleText = '';
            let subText = '';

            if (cat === 'clients') {
              titleText = item.name;
              subText = item.email;
            } else if (cat === 'professionals') {
              titleText = item.user.name;
              subText = item.user.email;
            } else if (cat === 'cursos') {
              titleText = item.titulo;
              subText = 'Curso Académico';
            } else if (cat === 'conversatorios') {
              titleText = item.titulo;
              subText = 'Conversatorio';
            } else if (cat === 'articles') {
              titleText = item.titulo;
              subText = 'Artículo';
            } else if (cat === 'appointments') {
              titleText = item.nombre;
              subText = `${item.fecha} - ${item.hora} (${item.motivo || 'Consulta'})`;
            } else if (cat === 'certificates') {
              titleText = item.nombreEvento;
              subText = `Código: ${item.codigo}`;
            }

            html += `
              <div onclick="handleSearchItemClick('${cat}', '${item.id}', '${item.slug || ''}')" class="flex flex-col p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 text-xs transition cursor-pointer text-slate-800 dark:text-slate-200">
                <span class="font-extrabold leading-snug">${titleText}</span>
                <span class="text-[9px] text-slate-455 dark:text-slate-500 font-semibold mt-0.5">${subText}</span>
              </div>
            `;
          });

          html += `
              </div>
            </div>
          `;
        }
      });

      if (!hasAnyResult) {
        html = `
          <div class="p-6 text-center text-slate-450 dark:text-slate-500 text-xs flex flex-col items-center gap-2">
            <i class="fa-solid fa-magnifying-glass-minus text-xl opacity-60"></i>
            <span>No se encontraron resultados</span>
          </div>
        `;
      }

      dropdown.innerHTML = html;
      dropdown.classList.remove('hidden');
    }
  }

  // Global handler for clicks on search suggestions
  function handleSearchItemClick(type, itemId, slug) {
    const dropdown = document.getElementById('search-autocomplete-dropdown');
    if (dropdown) dropdown.classList.add('hidden');
    
    if (type === 'cursos') {
      window.location.href = `/cursos/${slug || itemId}`;
    } else if (type === 'conversatorios') {
      window.location.href = `/conversatorios/${slug || itemId}`;
    } else if (type === 'articles') {
      window.location.href = `/articulos/leer/${itemId}`;
    } else if (type === 'professionals') {
      if (window.location.pathname.includes('/admin')) {
        if (typeof switchTab === 'function') switchTab('professionals');
      } else {
        window.location.href = slug ? `/directorio/${slug}` : '/directorio';
      }
    } else if (type === 'clients') {
      if (window.location.pathname.includes('/admin')) {
        if (typeof switchTab === 'function') switchTab('orders');
      }
    } else if (type === 'appointments') {
      if (typeof switchTab === 'function') {
        switchTab('dashboard');
      }
    } else if (type === 'certificates') {
      if (typeof switchTab === 'function') {
        switchTab('certificates');
      } else if (typeof showTab === 'function') {
        showTab('certificates');
      }
    }
  }
</script>
