              </label>
              <div id="transfer-comprobante-preview-wrap" class="hidden rounded-2xl border border-slate-150 bg-white p-2">
                <img id="transfer-comprobante-preview" src="" alt="Vista previa del comprobante seleccionado" class="max-h-44 w-full object-contain rounded-xl">
              </div>
              <p class="text-[9px] text-slate-400 font-medium leading-tight">Suba una foto o captura clara del comprobante de transferencia bancaria (obligatorio).</p>
            </div>
          </div>

          <!-- Panel 2: PayPhone (redirect to real gateway) -->
          <div id="panel-payphone" class="flex flex-col gap-4 hidden">
            <p class="text-[10px] font-medium text-slate-500">
              Serás redirigido a la pasarela de pago segura de PayPhone para completar tu pago con tarjeta de crédito/débito.
            </p>
            <button onclick="iniciarPagoPayPhone({ itemType: 'CERTIFICATE', itemId: <%= conversatorio.id %>, baseAmount: Number('<%= modalPrice %>'), hasTax: true, productName: 'Certificado - <%= (conversatorio.titulo || '').replace(/'/g, "\\'") %>' })" class="bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold py-3 rounded-2xl text-xs transition shadow-sm text-center cursor-pointer">
              Pagar con PayPhone
            </button>
          </div>

          <!-- Panel 3: Kushki Card -->
          <div id="panel-kushki" class="flex flex-col gap-4 hidden">
            <div class="bg-red-50/50 border border-red-100/50 rounded-2xl p-4 flex flex-col gap-1 text-slate-700 text-xs font-semibold leading-relaxed">
              <div class="flex items-center gap-2 text-red-600 font-black text-[10px] uppercase tracking-wider mb-0.5">
                <i class="fa-solid fa-shield-halved"></i> Pasarela Segura Kushki
              </div>
              <p class="text-[10px] font-medium text-slate-500">Aceptamos todas las tarjetas de crédito y débito nacionales e internacionales.</p>
            </div>
            
            <div class="flex flex-col gap-1.5">
              <label class="text-[11px] font-black text-slate-500 uppercase">Nombre en la Tarjeta</label>
              <input type="text" id="kushki-name" placeholder="JUAN PEREZ" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-semibold outline-none focus:bg-white focus:border-red-500 transition uppercase font-bold">
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-[11px] font-black text-slate-500 uppercase">Número de Tarjeta</label>
              <div class="relative">
                <i class="fa-solid fa-credit-card absolute right-4 top-3.5 text-slate-400 text-sm"></i>
                <input type="text" id="kushki-number" placeholder="4000 1234 5678 9010" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-red-500 transition tracking-widest">
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-black text-slate-500 uppercase">Vencimiento</label>
                <input type="text" id="kushki-expiry" placeholder="MM/YY" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-semibold outline-none focus:bg-white focus:border-red-500 transition text-center font-bold">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-black text-slate-500 uppercase">CVV / CVC</label>
                <input type="password" id="kushki-cvv" placeholder="•••" maxlength="4" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-semibold outline-none focus:bg-white focus:border-red-500 transition text-center font-bold">
              </div>
            </div>
          </div>

          <!-- Checkout Action Button (hidden for PayPhone, which has its own gateway button) -->
          <div class="sticky bottom-0 -mx-6 px-6 pt-3 pb-1 bg-white border-t border-slate-100">
            <button id="checkout-submit-btn" onclick="submitCheckoutPayment()" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-4 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
              <span id="checkout-btn-text">Confirmar y Registrar Pago</span>
              <i class="fa-solid fa-circle-check" id="checkout-btn-icon"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Free Certificate Name Prompt (mirrors paid Step 1, no payment step) -->
  <div id="free-cert-modal" class="fixed inset-0 z-[1200] flex items-center justify-center p-4 sm:p-6 overflow-x-hidden bg-slate-950/40 backdrop-blur-sm hidden">
    <div class="bg-white rounded-3xl max-w-lg w-full max-h-[calc(100dvh-8rem)] shadow-2xl overflow-hidden border border-slate-100 transform transition-all duration-300 scale-95 opacity-0 active-modal-animation flex flex-col">
      <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between bg-slate-50">
        <div>
          <h3 class="font-extrabold text-sm text-[#0A3C84] uppercase tracking-wide">Obtener Certificado Gratuito</h3>
          <p class="text-[10px] text-slate-500 font-bold uppercase mt-0.5"><%= conversatorio.titulo %></p>
        </div>
        <button onclick="closeFreeCertModal()" class="w-8 h-8 rounded-full bg-slate-200/50 hover:bg-slate-250 text-slate-500 hover:text-slate-800 flex items-center justify-center transition border border-slate-200/20 cursor-pointer">
          <i class="fa-solid fa-xmark text-xs"></i>
        </button>
      </div>

      <div class="bg-gradient-to-r from-emerald-700 to-emerald-600 text-white px-6 py-4 flex items-center justify-between">
        <div class="flex flex-col">
          <span class="text-[8px] font-black text-emerald-200 uppercase tracking-widest leading-none">Certificado Acreditado</span>
          <span class="text-[11px] font-bold text-slate-100 mt-1"><%= conversatorio.certificateDesign ? conversatorio.certificateDesign.horas : 40 %> Horas Académicas</span>
        </div>
        <div class="text-right">
          <span class="text-[9px] font-black text-slate-200 block uppercase leading-none">Costo</span>
          <span class="text-lg font-black text-white">GRATUITO</span>
        </div>
      </div>

      <div class="p-6 flex flex-col gap-4 overflow-y-auto overflow-x-hidden min-h-0 flex-1">
        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Nombre en el Certificado</span>

        <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-4 flex flex-col gap-1.5 text-slate-700 text-xs font-semibold leading-relaxed">
          <div class="flex items-center gap-2 text-emerald-700 font-black text-[10px] uppercase tracking-wider mb-0.5">
            <i class="fa-solid fa-user-pen"></i> Nombre Acreditado
          </div>
          <p class="text-[10px] font-medium text-slate-500">
            Escriba el nombre completo tal como desea que se imprima y registre en el código de verificación del certificado (incluyendo títulos como Dr., Ing., Lcdo., etc. si lo desea).
          </p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="free-cert-nombre-usuario" class="text-[11px] font-black text-slate-500 uppercase">Nombre para el Certificado</label>
          <input type="text" id="free-cert-nombre-usuario" placeholder="Ej: Dr. Juan Pérez" value="<%= user ? (user.nombreCertificado || user.name) : '' %>" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-emerald-600 transition uppercase">
        </div>

        <div id="free-cert-name-error-alert" class="hidden p-3 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-[11px] font-bold flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
          <span id="free-cert-name-error-text">Por favor, ingrese el nombre para el certificado.</span>
        </div>

        <div class="sticky bottom-0 -mx-6 px-6 pt-3 pb-1 bg-white border-t border-slate-100">
          <button id="free-cert-confirm-btn" onclick="submitFreeCertificate()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-4 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
            <span id="free-cert-btn-text">Obtener Certificado</span>
            <i class="fa-solid fa-award" id="free-cert-btn-icon"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Style tag for animations and active modal classes -->
  <style>
    .active-modal-animation {
      animation: modalZoomIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    @keyframes modalZoomIn {
      from {
        transform: scale(0.95);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
    .text-amber-805 {
      color: #92400e;
    }
    .bg-emerald-650 {
      background-color: #059669;
    }
    .bg-emerald-650:hover {
      background-color: #047857;
    }
  </style>
  <%- include('partials/transfer-bank-account-js', { activeBankAccounts }) %>

  <script>
    let checkoutFlowTarget = 'buy';
    let activePaymentMethod = 'transfer';

    function toTitleCase(str) {
      if (!str) return "";
      return str
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");
    }

    document.addEventListener('DOMContentLoaded', function() {
      const select = document.getElementById('transfer-bank-account');
      if (select) {
        select.addEventListener('change', function() { syncTransferBankAccountPaymentFields('transfer-bank-account', 'transfer-bank-account-card', 'transfer-ref', 'transfer-comprobante', 'transfer-comprobante-dropzone'); });
        syncTransferBankAccountPaymentFields('transfer-bank-account', 'transfer-bank-account-card', 'transfer-ref', 'transfer-comprobante', 'transfer-comprobante-dropzone');
      }
    });

    function openAuthModal(target) {
      checkoutFlowTarget = target;
      
      const modal = document.getElementById('auth-modal');
      const container = modal.querySelector('.transform');
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      
      setTimeout(() => {
        container.classList.remove('scale-95', 'opacity-0');
      }, 50);
      
      // Reset errors and inputs
      document.getElementById('auth-error-alert').classList.add('hidden');
      document.getElementById('login-email').value = '';
      document.getElementById('login-password').value = '';
      document.getElementById('register-name').value = '';
      document.getElementById('register-email').value = '';
      document.getElementById('register-password').value = '';
    }

    function closeAuthModal() {
      const modal = document.getElementById('auth-modal');
      const container = modal.querySelector('.active-modal-animation') || modal.querySelector('.transform');
      container.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 200);
    }

    function switchAuthTab(tab) {
      const loginTabBtn = document.getElementById('tab-btn-login');
      const registerTabBtn = document.getElementById('tab-btn-register');
      const loginForm = document.getElementById('form-login-container');
      const registerForm = document.getElementById('form-register-container');
      
      document.getElementById('auth-error-alert').classList.add('hidden');
      
      if (tab === 'login') {
        loginTabBtn.classList.add('border-[#0252A4]', 'text-[#0252A4]');
        loginTabBtn.classList.remove('border-transparent', 'text-slate-400');
        registerTabBtn.classList.remove('border-[#0252A4]', 'text-[#0252A4]');
        registerTabBtn.classList.add('border-transparent', 'text-slate-400');
        loginForm.classList.remove('hidden');
        registerForm.classList.add('hidden');
      } else {
        registerTabBtn.classList.add('border-[#0252A4]', 'text-[#0252A4]');
        registerTabBtn.classList.remove('border-transparent', 'text-slate-400');
        loginTabBtn.classList.remove('border-[#0252A4]', 'text-[#0252A4]');
        loginTabBtn.classList.add('border-transparent', 'text-slate-400');
        registerForm.classList.remove('hidden');
        loginForm.classList.add('hidden');
      }
    }

    async function submitLogin() {
      const email = document.getElementById('login-email').value.trim();
      const password = document.getElementById('login-password').value;
      const errorAlert = document.getElementById('auth-error-alert');
      const errorText = document.getElementById('auth-error-text');
      const btnText = document.getElementById('login-btn-text');
      const btnIcon = document.getElementById('login-btn-icon');

      if (!email || !password) {
        errorText.innerText = "Por favor, complete todos los campos.";
        errorAlert.classList.remove('hidden');
        return;
      }

      errorAlert.classList.add('hidden');
      btnText.innerText = "Iniciando...";
      btnIcon.className = "fa-solid fa-spinner animate-spin";

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const result = await response.json();

        if (result.success) {
          closeAuthModal();
          // Prefill name in certificate input if available
          if (result.user && (result.user.nombreCertificado || result.user.name)) {
            const certNameInput = document.getElementById('cert-nombre-usuario');
            if (certNameInput) {
              certNameInput.value = result.user.nombreCertificado || result.user.name;
            }
            const freeCertNameInput = document.getElementById('free-cert-nombre-usuario');
            if (freeCertNameInput) {
              freeCertNameInput.value = result.user.nombreCertificado || result.user.name;
            }
          }
          if (checkoutFlowTarget === 'free') {
            openFreeCertModal();
          } else if (checkoutFlowTarget === 'buy' || checkoutFlowTarget === 'paid-cert') {
            setTimeout(() => { openPaymentModal(); }, 300);
          } else {
            window.location.reload();
          }
        } else {
          errorText.innerText = result.error || "Credenciales incorrectas.";
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        errorText.innerText = "Error de red al conectar al servidor.";
        errorAlert.classList.remove('hidden');
      } finally {
        btnText.innerText = "Iniciar Sesión";
        btnIcon.className = "fa-solid fa-arrow-right";
      }
    }

    async function submitRegister() {
      const name = document.getElementById('register-name').value.trim();
      const email = document.getElementById('register-email').value.trim();
      const password = document.getElementById('register-password').value;
      const errorAlert = document.getElementById('auth-error-alert');
      const errorText = document.getElementById('auth-error-text');
      const btnText = document.getElementById('register-btn-text');
      const btnIcon = document.getElementById('register-btn-icon');

      if (!name || !email || !password) {
        errorText.innerText = "Por favor, complete todos los campos.";
        errorAlert.classList.remove('hidden');
        return;
      }

      if (password.length < 6) {
        errorText.innerText = "La contraseña debe tener al menos 6 caracteres.";
        errorAlert.classList.remove('hidden');
        return;
      }

      errorAlert.classList.add('hidden');
      btnText.innerText = "Creando Cuenta...";
      btnIcon.className = "fa-solid fa-spinner animate-spin";

      try {
        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ name, email, password })
        });
        const result = await response.json();

        if (result.success) {
          closeAuthModal();
          // Prefill name in certificate input if available
          if (result.user && (result.user.nombreCertificado || result.user.name)) {
            const certNameInput = document.getElementById('cert-nombre-usuario');
            if (certNameInput) {
              certNameInput.value = result.user.nombreCertificado || result.user.name;
            }
            const freeCertNameInput = document.getElementById('free-cert-nombre-usuario');
            if (freeCertNameInput) {
              freeCertNameInput.value = result.user.nombreCertificado || result.user.name;
            }
          }
          if (checkoutFlowTarget === 'free') {
            openFreeCertModal();
          } else if (checkoutFlowTarget === 'buy' || checkoutFlowTarget === 'paid-cert') {
            setTimeout(() => { openPaymentModal(); }, 300);
          } else {
            window.location.reload();
          }
        } else {
          errorText.innerText = result.error || "Error al crear la cuenta.";
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        errorText.innerText = "Error de red al conectar al servidor.";
        errorAlert.classList.remove('hidden');
      } finally {
        btnText.innerText = "Crear Cuenta";
        btnIcon.className = "fa-solid fa-user-plus";
      }
    }

    function openPaymentModal() {
      const modal = document.getElementById('payment-modal');
      const container = modal.querySelector('.transform');
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      
      setTimeout(() => {
        container.classList.remove('scale-95', 'opacity-0');
      }, 50);

      // Reset to Step 1
      goToNameStep();

      document.getElementById('payment-error-alert').classList.add('hidden');
      document.getElementById('payment-name-error-alert').classList.add('hidden');
      document.getElementById('transfer-ref').value = '';
      const payphonePhone = document.getElementById('payphone-phone');
      if (payphonePhone) payphonePhone.value = '';
      document.getElementById('kushki-name').value = '';
      document.getElementById('kushki-number').value = '';
      document.getElementById('kushki-expiry').value = '';
      document.getElementById('kushki-cvv').value = '';
    }

    function closePaymentModal() {
      const modal = document.getElementById('payment-modal');
      const container = modal.querySelector('.active-modal-animation') || modal.querySelector('.transform');
      container.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 200);
    }

    function goToNameStep() {
      document.getElementById('payment-step-name').classList.remove('hidden');
      document.getElementById('payment-step-details').classList.add('hidden');
    }

    function goToPaymentStep() {
      const rawNombreUsuario = document.getElementById('cert-nombre-usuario').value.trim();
      const nombreUsuario = toTitleCase(rawNombreUsuario);
      const nameErrorAlert = document.getElementById('payment-name-error-alert');
      
      if (!nombreUsuario) {
        nameErrorAlert.classList.remove('hidden');
        return;
      }
      
      nameErrorAlert.classList.add('hidden');
      
      // Update input field visual value to Title Case
      document.getElementById('cert-nombre-usuario').value = nombreUsuario;
      document.getElementById('summary-cert-name').innerText = nombreUsuario;
      
      document.getElementById('payment-step-name').classList.add('hidden');
      document.getElementById('payment-step-details').classList.remove('hidden');
      
      // Default to transfer tab when showing step 2
      switchPaymentTab('transfer');
    }

    function switchPaymentTab(method) {
      activePaymentMethod = method;
      
      const btnTransfer = document.getElementById('pay-tab-transfer');
      const btnPayphone = document.getElementById('pay-tab-payphone');
      const btnKushki = document.getElementById('pay-tab-kushki');
      
      const panelTransfer = document.getElementById('panel-transfer');
      const panelPayphone = document.getElementById('panel-payphone');
      const panelKushki = document.getElementById('panel-kushki');
      const checkoutSubmitBtn = document.getElementById('checkout-submit-btn');
      
      const activeBorder = 'border-[#0252A4]';
      const activeText = 'text-[#0252A4]';
      const inactiveBorder = 'border-slate-100';
      const inactiveText = 'text-slate-500';

      btnTransfer.className = btnTransfer.className.replace(activeBorder, inactiveBorder).replace(activeText, inactiveText);
      btnPayphone.className = btnPayphone.className.replace(activeBorder, inactiveBorder).replace(activeText, inactiveText);
      btnKushki.className = btnKushki.className.replace(activeBorder, inactiveBorder).replace(activeText, inactiveText);
      
      panelTransfer.classList.add('hidden');
      panelPayphone.classList.add('hidden');
      panelKushki.classList.add('hidden');
      
      if (method === 'transfer') {
        btnTransfer.classList.remove(inactiveBorder, inactiveText);
        btnTransfer.classList.add(activeBorder, activeText);
        panelTransfer.classList.remove('hidden');
        if (checkoutSubmitBtn) checkoutSubmitBtn.classList.remove('hidden');
      } else if (method === 'payphone') {
        btnPayphone.classList.remove(inactiveBorder, inactiveText);
        btnPayphone.classList.add(activeBorder, activeText);
        panelPayphone.classList.remove('hidden');
        if (checkoutSubmitBtn) checkoutSubmitBtn.classList.add('hidden');
      } else if (method === 'kushki') {
        btnKushki.classList.remove(inactiveBorder, inactiveText);
        btnKushki.classList.add(activeBorder, activeText);
        panelKushki.classList.remove('hidden');
        if (checkoutSubmitBtn) checkoutSubmitBtn.classList.remove('hidden');
      }
    }

    async function claimFreeCertificate(nombreUsuario) {
      try {
        const response = await fetch('/conversatorios/<%= conversatorio.id %>/comprar-certificado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ paymentMethod: 'gratuito', ajax: true, nombreUsuario: nombreUsuario || null })
        });
        const result = await response.json();
        if (result.success && result.redirect) {
          window.location.href = result.redirect;
        } else {
          alert(result.error || "Ocurrió un error al obtener el certificado.");
        }
      } catch (err) {
        console.error(err);
        alert("Error al conectar con el servidor.");
      }
    }

    function openFreeCertModal() {
      const modal = document.getElementById('free-cert-modal');
      const container = modal.querySelector('.transform');
      const nameInput = document.getElementById('free-cert-nombre-usuario');
      const fallback = '<%= user ? (user.nombreCertificado || user.name || "") : "" %>';
      const decoded = fallback.replace(/&#39;/g, "'").replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');
      if (nameInput && !nameInput.value && decoded) {
        nameInput.value = decoded;
      }
      document.getElementById('free-cert-name-error-alert').classList.add('hidden');
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      setTimeout(() => {
        container.classList.remove('scale-95', 'opacity-0');
        if (nameInput) nameInput.focus();
      }, 50);
    }

    function closeFreeCertModal() {
      const modal = document.getElementById('free-cert-modal');
      const container = modal.querySelector('.active-modal-animation') || modal.querySelector('.transform');
      container.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }, 200);
    }

    async function submitFreeCertificate() {
      const rawNombreUsuario = document.getElementById('free-cert-nombre-usuario').value.trim();
      const nombreUsuario = toTitleCase(rawNombreUsuario);
      const errorAlert = document.getElementById('free-cert-name-error-alert');
      const errorText = document.getElementById('free-cert-name-error-text');
      const btnText = document.getElementById('free-cert-btn-text');
      const btnIcon = document.getElementById('free-cert-btn-icon');

      if (!nombreUsuario) {
        errorText.innerText = "Por favor, ingrese el nombre para el certificado.";
        errorAlert.classList.remove('hidden');
        return;
      }

      document.getElementById('free-cert-nombre-usuario').value = nombreUsuario;
      errorAlert.classList.add('hidden');
      btnText.innerText = "Procesando...";
      btnIcon.className = "fa-solid fa-spinner animate-spin";

      try {
        const response = await fetch('/conversatorios/<%= conversatorio.id %>/comprar-certificado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ paymentMethod: 'gratuito', ajax: true, nombreUsuario })
        });
        const result = await response.json();
        if (result.success && result.redirect) {
          closeFreeCertModal();
          window.location.href = result.redirect;
        } else {
          errorText.innerText = result.error || "Ocurrió un error al obtener el certificado.";
          errorAlert.classList.remove('hidden');
          btnText.innerText = "Obtener Certificado";
          btnIcon.className = "fa-solid fa-award";
        }
      } catch (err) {
        console.error(err);
        errorText.innerText = "Error al conectar con el servidor.";
        errorAlert.classList.remove('hidden');
        btnText.innerText = "Obtener Certificado";
        btnIcon.className = "fa-solid fa-award";
      }
    }

    function readImageAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = error => reject(error);
        reader.readAsDataURL(file);
      });
    }

    async function submitCheckoutPayment() {
      const errorAlert = document.getElementById('payment-error-alert');
      const errorText = document.getElementById('payment-error-text');
      const btnText = document.getElementById('checkout-btn-text');
      const btnIcon = document.getElementById('checkout-btn-icon');
      const rawNombreUsuario = document.getElementById('cert-nombre-usuario').value.trim();
      const nombreUsuario = toTitleCase(rawNombreUsuario);

      if (!nombreUsuario) {
        errorText.innerText = "Por favor, especifique el nombre para el certificado.";
        errorAlert.classList.remove('hidden');
        return;
      }

      // Update input visually
      document.getElementById('cert-nombre-usuario').value = nombreUsuario;

      let payload = {
        paymentMethod: activePaymentMethod,
        nombreUsuario: nombreUsuario,
        ajax: true
      };

      if (activePaymentMethod === 'transfer') {
        const bancoInput = document.getElementById('transfer-banco');
        const banco = bancoInput ? bancoInput.value : '';
        const bankAccountSelect = document.getElementById('transfer-bank-account');
        const reference = document.getElementById('transfer-ref').value.trim();
        const fileInput = document.getElementById('transfer-comprobante');
        if (bankAccountSelect && !bankAccountSelect.value) {
          errorText.innerText = "Seleccione la cuenta bancaria de destino.";
          errorAlert.classList.remove('hidden');
          return;
        }
        if (!reference) {
          errorText.innerText = "Por favor, ingrese el número de referencia bancaria.";
          errorAlert.classList.remove('hidden');
          return;
        }
        if (!fileInput.files || fileInput.files.length === 0) {
          errorText.innerText = "Por favor, suba la captura de su comprobante de pago.";
          errorAlert.classList.remove('hidden');
          return;
        }
        if (bancoInput) payload.banco = banco;
        if (bankAccountSelect) payload.bankAccountId = bankAccountSelect.value;
        payload.reference = reference;
        payload.paymentMethod = "transferencia"; // Ensure correct backend mapping

        const file = fileInput.files[0];
        try {
          payload.comprobante = await readImageAsBase64(file);
        } catch (e) {
          errorText.innerText = "Error al procesar la imagen del comprobante.";
          errorAlert.classList.remove('hidden');
          return;
        }
      } else if (activePaymentMethod === 'payphone') {
        // PayPhone se procesa a través de la pasarela real → redirige.
        iniciarPagoPayPhone({
          itemType: 'CERTIFICATE',
          itemId: <%= conversatorio.id %>,
          baseAmount: Number('<%= modalPrice %>'),
          hasTax: true,
          productName: 'Certificado - <%= (conversatorio.titulo || '').replace(/'/g, "\\'") %>'
        });
        return;
      } else if (activePaymentMethod === 'kushki') {
        const name = document.getElementById('kushki-name').value.trim();
        const number = document.getElementById('kushki-number').value.trim();
        const expiry = document.getElementById('kushki-expiry').value.trim();
        const cvv = document.getElementById('kushki-cvv').value.trim();

        if (!name || !number || !expiry || !cvv) {
          errorText.innerText = "Por favor, complete todos los campos de su tarjeta.";
          errorAlert.classList.remove('hidden');
          return;
        }
        payload.reference = "KushkiCard-••••" + number.slice(-4);
      }

      errorAlert.classList.add('hidden');
      btnText.innerText = "Procesando pago...";
      btnIcon.className = "fa-solid fa-spinner animate-spin";

      try {
        const response = await fetch('/conversatorios/<%= conversatorio.id %>/comprar-certificado', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await response.json();
        
        if (result.success && result.redirect) {
          closePaymentModal();
          window.location.href = result.redirect;
        } else {
          errorText.innerText = result.error || "Ocurrió un error al procesar el pago.";
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        errorText.innerText = "Error de red al conectar al servidor.";
        errorAlert.classList.remove('hidden');
      } finally {
        btnText.innerText = "Confirmar y Registrar Pago";
        btnIcon.className = "fa-solid fa-circle-check";
      }
    }

    function togglePasswordVisibility(id, btn) {
      const input = document.getElementById(id);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>

  <!-- Modal de Progreso del Certificado (Antes de desbloqueo) -->
  <div id="cert-progress-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 md:p-8 shadow-2xl border border-slate-100 flex flex-col gap-6 relative animate-fade-in">
      <button type="button" onclick="closeCertProgressModal()" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition cursor-pointer">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>

      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl shadow-inner flex-shrink-0">
          <i class="fa-solid fa-award"></i>
        </div>
        <div class="flex flex-col">
          <h3 class="text-base font-black text-slate-900 uppercase tracking-tight">Requisitos del Certificado</h3>
          <span class="text-xs text-slate-500 font-semibold">Progreso actual de asistencia</span>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-5 flex flex-col gap-3">
        <div class="flex items-center justify-between text-xs font-black text-slate-800">
          <span>Avance de Asistencia</span>
          <span class="text-amber-600 font-mono text-sm"><%= typeof progressPct !== 'undefined' ? progressPct : 0 %>% / <%= conversatorio.porcentajeMinimoCertificado || 50 %>%</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden p-0.5 border border-slate-300/60">
          <div class="bg-gradient-to-r from-amber-500 to-emerald-500 h-full rounded-full transition-all duration-500" style="width: <%= typeof progressPct !== 'undefined' ? progressPct : 0 %>%;"></div>
        </div>
        <p class="text-xs text-slate-600 font-medium leading-relaxed mt-1 font-sans">
          Has completado <strong><%= typeof completedCount !== 'undefined' ? completedCount : 0 %></strong> de <strong><%= typeof totalSpeakers !== 'undefined' ? totalSpeakers : 0 %></strong> ponencias. Completa al menos el <strong><%= conversatorio.porcentajeMinimoCertificado || 50 %>%</strong> de las ponencias para desbloquear la emisión de tu certificado.
        </p>
      </div>

      <div class="flex flex-col gap-2">
        <% const modalTargetSpeakerId = typeof nextSpeakerId !== 'undefined' && nextSpeakerId ? nextSpeakerId : (conversatorio.speakers && conversatorio.speakers.length > 0 ? conversatorio.speakers[0].id : null); %>
        <% if (modalTargetSpeakerId) { %>
          <a href="/conversatorios/<%= conversatorio.id %>/ponentes/<%= modalTargetSpeakerId %>" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md">
            <i class="fa-solid fa-play"></i> <%= typeof ctaButtonLabel !== 'undefined' ? ctaButtonLabel : 'Continuar Evento' %>
          </a>
        <% } %>
        <button type="button" onclick="closeCertProgressModal()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold py-3 px-6 rounded-2xl text-xs transition text-center cursor-pointer">
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <script>
    function openCertProgressModal() {
      const modal = document.getElementById('cert-progress-modal');
      if (modal) modal.classList.remove('hidden');
    }
    function closeCertProgressModal() {
      const modal = document.getElementById('cert-progress-modal');
      if (modal) modal.classList.add('hidden');
    }
  </script>

  <script src="/js/comprobante-dropzone.js"></script>
  <script src="/js/payphone-helper.js"></script>
  <%- include('partials/footer') %>
</body>
</html>
