<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 flex flex-col min-h-screen text-slate-800 antialiased font-sans">
  <%- include('partials/header') %>

  <!-- Main Content Wrapper -->
  <main class="flex-grow max-w-7xl mx-auto w-full px-6 md:px-12 py-12 flex flex-col gap-10">
    <% 
      const isOnline = !conversatorio.ciudad || 
                       conversatorio.ciudad.toLowerCase().trim() === 'online' ||
                       conversatorio.ciudad.toLowerCase().includes('online') ||
                       conversatorio.ciudad.toLowerCase().includes('virtual') ||
                       (conversatorio.direccion && conversatorio.direccion.toLowerCase().includes('online')) ||
                       (conversatorio.direccion && conversatorio.direccion.toLowerCase().includes('virtual')) ||
                       (conversatorio.slogan && conversatorio.slogan.toLowerCase().includes('online')) ||
                       (conversatorio.slogan && conversatorio.slogan.toLowerCase().includes('virtual'));
    %>

    <!-- Back Button -->
    <div class="flex justify-start">
      <a href="/eventos" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-900 transition text-xs font-extrabold font-sans">
        <i class="fa-solid fa-arrow-left"></i> Volver a Conversatorios
      </a>
    </div>

    <!-- Header Section -->
    <div class="flex flex-col gap-2 max-w-4xl" data-reveal="fade-up">
      <% if (conversatorio.estado === 'PROGRAMADO') { %>
        <span class="self-start bg-amber-100 text-amber-800 text-[10px] font-extrabold px-3.5 py-1.5 rounded-full uppercase tracking-wider border border-amber-200">Evento Programado</span>
      <% } else if (conversatorio.estado === 'ACTIVO') { %>
        <span class="self-start bg-emerald-100 text-emerald-800 text-[10px] font-extrabold px-3.5 py-1.5 rounded-full uppercase tracking-wider border border-emerald-200">Evento Activo / En Curso</span>
      <% } else { %>
        <span class="self-start bg-slate-100 text-slate-600 text-[10px] font-extrabold px-3.5 py-1.5 rounded-full uppercase tracking-wider border border-slate-200">Evento Finalizado</span>
      <% } %>
      <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight tracking-tight mt-2 uppercase"><%= conversatorio.titulo %></h1>
      <p class="text-[#0252A4] text-xs md:text-sm font-bold mt-1 uppercase tracking-wide"><%= conversatorio.slogan || conversatorio.areaProfesional || 'Encuentro Académico de Profesionales' %></p>
    </div>

    <!-- Action / Enrollment / Certificate Purchase Banner -->
    <div class="bg-white border border-slate-150 rounded-3xl p-6 md:p-8 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6 premium-card-hover" data-reveal="fade-up" data-reveal-delay="100">
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center gap-2">
          <% if (conversatorio.estado === 'PROGRAMADO') { %>
            <span class="bg-amber-100 text-amber-800 text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider border border-amber-200">PROGRAMADO</span>
          <% } else if (conversatorio.estado === 'ACTIVO') { %>
            <span class="bg-emerald-100 text-emerald-800 text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider border border-emerald-200">ACTIVO</span>
          <% } else if (conversatorio.estado === 'FINALIZADO') { %>
            <span class="bg-slate-100 text-slate-600 text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider border border-slate-200">FINALIZADO</span>
          <% } %>
          <span class="text-xs text-slate-500 font-bold">Certificación Académica Avalada</span>
        </div>
        <h3 class="text-base font-black text-slate-900 leading-tight mt-1">
          <% if (conversatorio.estado === 'PROGRAMADO') { %>
            Inscripción Abierta - Obtenga su Certificado de <%= conversatorio.certificateDesign ? conversatorio.certificateDesign.horas : 40 %> Horas
          <% } else if (conversatorio.estado === 'ACTIVO') { %>
            Evento en Curso - Certificado de <%= conversatorio.certificateDesign ? conversatorio.certificateDesign.horas : 40 %> Horas Disponible
          <% } else { %>
            Evento Finalizado - Adquiera su Certificado con Tarifa Extemporánea
          <% } %>
        </h3>
        <p class="text-xs text-slate-500 font-medium">Asegure su acreditación curricular firmada digitalmente.</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <% 
          const design = conversatorio.certificateDesign;
          const isStudentUser = (typeof isEstudiante !== 'undefined' && isEstudiante) || (typeof user !== 'undefined' && user && user.role && user.role.name === 'STUDENT');
          const studentPriceVal = conversatorio.descuentoEstudianteUsd;
          const hasStudentDiscount = !conversatorio.gratuito && isStudentUser && studentPriceVal !== null && studentPriceVal !== undefined && studentPriceVal > 0 && studentPriceVal < (conversatorio.precio || 0);
          const price = conversatorio.gratuito ? 0 : (hasStudentDiscount ? Number(studentPriceVal) : (conversatorio.precio || 0));
        %>
        <%
          const freeSpeakers = (conversatorio.speakers || []).filter(s => s.gratuita);
          const firstFreeSpeaker = freeSpeakers.length > 0 ? freeSpeakers[0] : null;
          const firstFreeSpeakerSlug = firstFreeSpeaker ? (firstFreeSpeaker.slug || firstFreeSpeaker.id) : null;
        %>
        <% if (typeof user === 'undefined' || !user) { %>
          <!-- User not logged in -->
          <% if (conversatorio.estado === 'PROGRAMADO') { %>
            <button onclick="openAuthModal('enroll')" class="w-full sm:w-auto bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
              <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión para Participar
            </button>
          <% } else if (conversatorio.estado === 'ACTIVO' || conversatorio.estado === 'FINALIZADO') { %>
            <% if (conversatorio.gratuito) { %>
              <button onclick="openAuthModal('free')" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                <i class="fa-solid fa-award"></i> Obtener Certificado Gratuito
              </button>
            <% } else if (firstFreeSpeakerSlug) { %>
              <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
                <a href="/conversatorios/<%= conversatorio.slug || conversatorio.id %>/ponentes/<%= firstFreeSpeakerSlug %>" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                  <i class="fa-solid fa-play"></i> Ver Ponencia Gratuita
                </a>
                <button onclick="openAuthModal('buy')" class="w-full sm:w-auto bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                  <i class="fa-solid fa-cart-shopping"></i> Adquirir Certificado por $<%= price.toFixed(2) %>
                </button>
              </div>
            <% } else { %>
              <button onclick="openAuthModal('buy')" class="w-full sm:w-auto bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                <i class="fa-solid fa-cart-shopping"></i> Adquirir Certificado por $<%= price.toFixed(2) %>
              </button>
            <% } %>
          <% } %>
        <% } else { %>
          <!-- User logged in -->
          <% 
            const targetSpeakerObj = (typeof nextSpeakerId !== 'undefined' && nextSpeakerId) 
              ? (conversatorio.speakers || []).find(s => s.id === nextSpeakerId) 
              : (conversatorio.speakers && conversatorio.speakers.length > 0 ? conversatorio.speakers[0] : null);
            const targetSpeakerParam = targetSpeakerObj ? (targetSpeakerObj.slug || targetSpeakerObj.id) : null;
          %>
          <% const btnLabel = typeof ctaButtonLabel !== 'undefined' ? ctaButtonLabel : 'Acceder al Evento'; %>
          <% if (isEnrolled || hasCertificate) { %>
            <!-- User IS ENROLLED -->
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
              <% if (targetSpeakerParam) { %>
                <a href="/conversatorios/<%= conversatorio.slug || conversatorio.id %>/ponentes/<%= targetSpeakerParam %>" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md">
                  <i class="fa-solid fa-play"></i> <%= btnLabel %>
                </a>
              <% } %>

              <% if (hasCertificate) { %>
                <% if (typeof acquiredCertificateCode !== 'undefined' && acquiredCertificateCode) { %>
                  <a href="/certificados/<%= acquiredCertificateCode %>" target="_blank" class="w-full sm:w-auto bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-award"></i> Ver Certificado
                  </a>
                <% } else { %>
                  <div class="bg-emerald-50 border border-emerald-200 rounded-2xl py-3 px-5 text-emerald-800 text-xs font-bold flex items-center gap-2">
                    <i class="fa-solid fa-award text-emerald-600"></i> Certificado Obtenido
                  </div>
                <% } %>
              <% } else if (typeof certificatePending !== 'undefined' && certificatePending) { %>
                <div class="bg-amber-50 border border-amber-200 rounded-2xl py-3 px-5 text-amber-800 text-xs font-bold flex items-center gap-2">
                  <i class="fa-solid fa-clock-rotate-left text-amber-600 text-sm animate-pulse"></i> Validando Pago
                </div>
              <% } else { %>
                <button type="button" onclick="openCertProgressModal()" class="w-full sm:w-auto bg-amber-500 hover:bg-amber-600 text-slate-950 font-black py-3.5 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                  <i class="fa-solid fa-award"></i> Progreso del Certificado (<%= typeof progressPct !== 'undefined' ? progressPct : 0 %>%)
                </button>
              <% } %>
            </div>
          <% } else { %>
            <!-- User NOT ENROLLED -->
            <% if (conversatorio.gratuito) { %>
              <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
                <% if (targetSpeakerParam) { %>
                  <a href="/conversatorios/<%= conversatorio.slug || conversatorio.id %>/ponentes/<%= targetSpeakerParam %>" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-play"></i> Ver Ponencia Gratuita
                  </a>
                <% } %>
                <% if (locals.user) { %>
                  <form action="/conversatorios/<%= conversatorio.id %>/inscribirse" method="POST" class="w-full sm:w-auto">
                    <button type="submit" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                      <i class="fa-solid fa-user-plus"></i> Inscribirme Gratis
                    </button>
                  </form>
                <% } else { %>
                  <a href="/login?redirect=/conversatorios/<%= conversatorio.slug || conversatorio.id %>" class="w-full sm:w-auto bg-slate-800 hover:bg-slate-900 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión para Certificado
                  </a>
                <% } %>
              </div>
            <% } else if (firstFreeSpeakerSlug) { %>
              <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
                <a href="/conversatorios/<%= conversatorio.slug || conversatorio.id %>/ponentes/<%= firstFreeSpeakerSlug %>" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md">
                  <i class="fa-solid fa-play"></i> Ver Ponencia Gratuita
                </a>
                <button onclick="openPaymentModal()" class="w-full sm:w-auto bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                  <i class="fa-solid fa-award"></i> Adquirir Certificado por $<%= price.toFixed(2) %>
                </button>
              </div>
            <% } else { %>
              <button onclick="openPaymentModal()" class="w-full sm:w-auto bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                <i class="fa-solid fa-award"></i> Adquirir Certificado por $<%= price.toFixed(2) %>
              </button>
            <% } %>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Logistics Info Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      
      <!-- Lugar -->
      <div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm flex flex-col gap-2 hover:shadow-md transition">
        <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center text-sm shadow-sm">
          <i class="fa-solid fa-location-dot"></i>
        </div>
        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Lugar</span>
        <span class="text-xs font-black text-slate-800 leading-snug"><%= conversatorio.direccion || 'Por confirmar' %>, <%= conversatorio.ciudad %></span>
      </div>

      <!-- Fecha -->
      <div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm flex flex-col gap-2 hover:shadow-md transition">
        <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center text-sm shadow-sm">
          <i class="fa-regular fa-calendar"></i>
        </div>
        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Fecha</span>
        <span class="text-xs font-black text-slate-800 leading-snug">
          <%= new Date(conversatorio.fechaInicio).toLocaleDateString('es-ES', { day: 'numeric', month: 'numeric', year: 'numeric' }) %>
        </span>
      </div>

      <!-- Cupos -->
      <div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm flex flex-col gap-2 hover:shadow-md transition">
        <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-sm shadow-sm">
          <i class="fa-solid fa-users"></i>
        </div>
        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Cupos</span>
        <span class="text-xs font-black text-slate-800 leading-snug">
          <%= conversatorio.capacidadIlimitada ? 'SIN LÍMITE' : conversatorio.capacidad %>
        </span>
      </div>

      <!-- Inversion -->
      <div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm flex flex-col gap-2 hover:shadow-md transition">
        <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center text-sm shadow-sm">
          <i class="fa-solid fa-dollar-sign"></i>
        </div>
        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Inversión</span>
        <span class="text-xs font-black text-slate-800 leading-snug">
          <% if (conversatorio.gratuito) { %>
            GRATUITO
          <% } else if (hasStudentDiscount) { %>
            <div class="flex flex-col">
              <span class="line-through text-slate-400 text-[10px]">$<%= conversatorio.precio.toFixed(2) %></span>
              <span class="text-blue-600 font-extrabold">$<%= Number(studentPriceVal).toFixed(2) %> <i class="fa-solid fa-graduation-cap text-[10px]"></i></span>
            </div>
          <% } else { %>
            $<%= conversatorio.precio.toFixed(2) %>
          <% } %>
        </span>
      </div>

      <!-- Horario -->
      <div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm flex flex-col gap-2 hover:shadow-md transition">
        <div class="w-9 h-9 rounded-xl bg-rose-50 text-rose-500 flex items-center justify-center text-sm shadow-sm">
          <i class="fa-regular fa-clock"></i>
        </div>
        <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Horario</span>
        <span class="text-xs font-black text-slate-800 leading-snug"><%= conversatorio.horaInicio %> - <%= conversatorio.horaFin %></span>
      </div>

    </div>

    <!-- Justificación / Descripción (Black Background Card) -->
    <div class="bg-slate-950 text-white rounded-3xl p-8 md:p-12 shadow-xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center border border-slate-900">
      <div class="lg:col-span-6 flex flex-col gap-4">
        <span class="text-[10px] font-black text-emerald-400 uppercase tracking-widest">Análisis Académico</span>
        <h2 class="text-3xl font-black text-white leading-tight uppercase tracking-tight">Justificación del Evento</h2>
        <p class="text-slate-350 text-sm leading-relaxed mt-2 font-medium font-sans"><%= conversatorio.descripcion || 'Este conversatorio reúne a los mejores académicos, profesionales e investigadores.' %></p>
      </div>
      <div class="lg:col-span-6 w-full">
        <% if (conversatorio.youtube || conversatorio.bunnyVideoId) { %>
          <div class="w-full aspect-video rounded-2xl overflow-hidden bg-slate-900 shadow-md">
            <%- include('partials/custom-video-player', {
              sourceType: 'conversatorio',
              sourceId: conversatorio.id,
              title: conversatorio.titulo,
              autoplay: false
            }) %>
          </div>
        <% } else { %>
          <div class="w-full aspect-video rounded-2xl overflow-hidden bg-slate-900 shadow-md border border-slate-900">
            <img src="<%= conversatorio.banner || 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?q=80&w=800' %>" class="w-full h-full object-cover">
          </div>
        <% } %>
      </div>
    </div>

    <!-- Revista Científica Section (If Configured) -->
    <% if (conversatorio.revistaPortada || conversatorio.revistaPdf || conversatorio.revistaFlipbook) { %>
      <div class="bg-gradient-to-r from-slate-950 to-slate-900 text-white rounded-3xl p-8 md:p-12 shadow-xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center border border-slate-900">
        <div class="lg:col-span-8 flex flex-col gap-4">
          <h2 class="text-3xl font-black text-white leading-tight uppercase tracking-tight">Revista Científica Profesionales Ecuador</h2>
          <p class="text-slate-350 text-sm leading-relaxed max-w-xl font-medium font-sans">Investigación, innovación y conocimiento multidisciplinario desde Ecuador para el mundo.</p>
          
          <div class="flex flex-wrap gap-3 mt-4">
            <% if (conversatorio.revistaPdf) { %>
              <button onclick="openFlipbook('/conversatorios/<%= conversatorio.slug || conversatorio.id %>/revista.pdf')" class="bg-white hover:bg-slate-200 text-slate-950 font-black py-3.5 px-6 rounded-2xl transition text-xs flex items-center gap-2 shadow-md cursor-pointer">
                <i class="fa-solid fa-book-open text-emerald-600"></i> Leer Revista (Animación 3D)
              </button>
            <% } else if (conversatorio.revistaFlipbook) { %>
              <a href="<%= conversatorio.revistaFlipbook %>" target="_blank" class="bg-white hover:bg-slate-200 text-slate-950 font-black py-3.5 px-6 rounded-2xl transition text-xs flex items-center gap-2 shadow-md">
                <i class="fa-solid fa-book-open"></i> Leer Revista de Profesionales Ecuador
              </a>
            <% } %>
            <% if (conversatorio.revistaPdf) { %>
              <a href="/conversatorios/<%= conversatorio.slug || conversatorio.id %>/revista.pdf" download="Revista_Profesionales_Ecuador.pdf" class="bg-slate-800 hover:bg-slate-700 text-white font-black py-3.5 px-6 rounded-2xl transition text-xs flex items-center gap-2 border border-slate-750">
                <i class="fa-solid fa-file-pdf text-rose-500"></i> Descargar Revista PDF
              </a>
            <% } %>
          </div>
        </div>
        <div class="lg:col-span-4 flex justify-center">
          <% if (conversatorio.revistaPortada) { %>
            <div class="w-full max-w-[200px] aspect-[3/4] rounded-2xl overflow-hidden bg-slate-900 border border-slate-850 shadow-2xl hover:scale-102 transition duration-300">
              <img src="<%= conversatorio.revistaPortada %>" class="w-full h-full object-cover">
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Itinerary Schedule Section -->
    <section class="flex flex-col gap-6 mt-6">
      <div class="flex flex-col text-center gap-1.5 mb-2">
        <span class="text-[10px] font-black text-emerald-600 uppercase tracking-widest">Cronograma Detallado</span>
        <h2 class="text-3xl font-black text-slate-950 uppercase tracking-tight">
          <%= conversatorio.estado === 'FINALIZADO' ? (isOnline ? 'Grabaciones del Conversatorio' : 'Revive el Conversatorio') : 'Agenda y Cronograma' %>
        </h2>
      </div>

      <div class="flex flex-col gap-8" id="conversatorio-days-list">
        <% if (conversatorio.itinerary && conversatorio.itinerary.length > 0) { %>
          <% conversatorio.itinerary.forEach(function(day, idx) { %>
            
            <!-- Day Container -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 md:p-8 flex flex-col gap-6 shadow-sm hover:shadow transition duration-200">
              
              <!-- Day Header -->
              <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
                <div class="w-8 h-8 rounded-xl bg-emerald-500 text-white font-black text-sm flex items-center justify-center shadow-inner">
                  <%= idx + 1 %>
                </div>
                <div class="flex flex-col">
                  <h3 class="text-base font-black text-slate-900 leading-none uppercase"><%= day.nombre || 'Día ' + (idx + 1) %></h3>
                  <span class="text-[10px] font-extrabold text-slate-400 mt-1.5 flex items-center gap-1.5 uppercase">
                    <i class="fa-regular fa-clock text-[9px] text-slate-400"></i> Horario: <%= day.horaInicio %> - <%= day.horaFin %>
                  </span>
                </div>
              </div>
              
              <!-- Speakers Grid -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% 
                  // Strictly match speakers to their exact assigned dayIndex without cross-day leakage
                  const targetDayIndex = typeof day.computedIndex === 'number' ? day.computedIndex : ((typeof day.orden !== 'undefined' && day.orden !== null) ? Number(day.orden) : idx);
                  const daySpeakers = (conversatorio.speakers || []).filter(function(s) {
                    const sIndex = (s.dayIndex !== null && s.dayIndex !== undefined) ? Number(s.dayIndex) : 0;
                    return sIndex === targetDayIndex;
                  });
                %>
                <% if (daySpeakers && daySpeakers.length > 0) { %>
                  <% daySpeakers.forEach(function(sp) { %>
                    
                    <!-- Speaker Card Link -->
                    <a href="/conversatorios/<%= conversatorio.slug || conversatorio.id %>/ponentes/<%= sp.slug || sp.id %>" class="bg-slate-50/50 hover:bg-white border border-slate-100 hover:border-[#0252A4]/20 rounded-2xl p-4 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition duration-200 flex gap-4 cursor-pointer relative">
