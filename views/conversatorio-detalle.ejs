          <p class="text-[10px] font-medium text-slate-500">
            Escriba el nombre completo tal como desea que se imprima y registre en el código de verificación del certificado (incluyendo títulos como Dr., Ing., Lcdo., etc. si lo desea).
          </p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-[11px] font-black text-slate-500 uppercase">Nombre para el Certificado</label>
          <input type="text" id="cert-nombre-usuario" placeholder="Ej: Dr. Juan Pérez" value="<%= user ? (user.nombreCertificado || user.name) : '' %>" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#0252A4] transition uppercase">
        </div>

        <!-- Name Error Alert Container -->
        <div id="payment-name-error-alert" class="hidden p-3 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-[11px] font-bold flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
          <span id="payment-name-error-text">Por favor, ingrese el nombre para el certificado.</span>
        </div>

        <div class="sticky bottom-0 -mx-6 px-6 pt-3 pb-1 bg-white border-t border-slate-100">
          <button onclick="goToPaymentStep()" class="w-full bg-[#0252A4] hover:bg-[#023E7D] text-white font-extrabold py-4 px-6 rounded-2xl text-xs transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
            <span>Continuar al Pago</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>

      <!-- STEP 2: Payment Details -->
      <div id="payment-step-details" class="hidden flex flex-col gap-4 overflow-y-auto overflow-x-hidden min-h-0 flex-1">
        <!-- Display selected name for review -->
        <div class="px-6 py-3 bg-[#0252A4]/5 border-b border-slate-100 flex items-center justify-between text-xs">
          <div class="flex items-center gap-2 text-slate-600 font-medium">
            <i class="fa-solid fa-award text-[#0252A4]"></i>
            <span>Certificado para: <strong id="summary-cert-name" class="text-slate-800 uppercase"></strong></span>
          </div>
          <button onclick="goToNameStep()" class="text-[#0252A4] hover:text-[#023E7D] font-extrabold text-[10px] uppercase tracking-wider cursor-pointer">
            <i class="fa-solid fa-pen"></i> Cambiar
          </button>
        </div>

        <!-- Payment Method Selector Tabs -->
        <div class="p-6 border-b border-slate-100 flex flex-col gap-2 bg-slate-50/50">
          <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Seleccione método de pago</span>
          <div class="grid grid-cols-3 gap-3">
            <!-- Bank Transfer -->
            <button id="pay-tab-transfer" onclick="switchPaymentTab('transfer')" class="flex flex-col items-center justify-center gap-1.5 p-3 rounded-2xl border-2 border-[#0252A4] bg-white text-[#0252A4] hover:shadow transition cursor-pointer text-center">
              <i class="fa-solid fa-building-columns text-base"></i>
              <span class="text-[9px] font-black uppercase tracking-wide leading-none">Transferencia</span>
            </button>
            <!-- PayPhone -->
            <button id="pay-tab-payphone" onclick="switchPaymentTab('payphone')" class="flex flex-col items-center justify-center gap-1.5 p-3 rounded-2xl border-2 border-slate-100 bg-white text-slate-500 hover:text-orange-500 hover:border-orange-100 hover:shadow transition cursor-pointer text-center">
              <i class="fa-solid fa-mobile-screen-button text-base"></i>
              <span class="text-[9px] font-black uppercase tracking-wide leading-none">PayPhone</span>
            </button>
            <!-- Kushki -->
            <button id="pay-tab-kushki" onclick="switchPaymentTab('kushki')" class="flex flex-col items-center justify-center gap-1.5 p-3 rounded-2xl border-2 border-slate-100 bg-white text-slate-500 hover:text-red-500 hover:border-red-100 hover:shadow transition cursor-pointer text-center">
              <i class="fa-solid fa-credit-card text-base"></i>
              <span class="text-[9px] font-black uppercase tracking-wide leading-none">Kushki</span>
            </button>
          </div>
        </div>

        <!-- Error Alert Container -->
        <div id="payment-error-alert" class="hidden mx-6 mt-4 p-3 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-[11px] font-bold flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
          <span id="payment-error-text"></span>
        </div>

        <!-- Payment Method Content Panels -->
        <div class="p-6 flex flex-col gap-4">
          
          <!-- Panel 1: Bank Transfer -->
          <div id="panel-transfer" class="flex flex-col gap-4">
            <%- include('partials/transfer-bank-account-selector', { activeBankAccounts, legacyBankAccounts: systemConfig.bankAccounts, selectId: 'transfer-bank-account', cardId: 'transfer-bank-account-card', inputName: 'bankAccountId', selectedId: '' }) %>

            <div class="grid grid-cols-2 gap-4">
              <% if (!Array.isArray(activeBankAccounts) || activeBankAccounts.length === 0) { %>
              <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-black text-slate-500 uppercase">Banco Utilizado</label>
                <select id="transfer-banco" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-3.5 text-xs font-bold outline-none focus:bg-white focus:border-[#0252A4] transition cursor-pointer">
                  <option value="Banco Pichincha">Banco Pichincha</option>
                  <option value="Banco Guayaquil">Banco Guayaquil</option>
                  <option value="Banco del Pacífico">Banco del Pacífico</option>
                  <option value="Produbanco">Produbanco</option>
                  <option value="Cooperativa JEP">Cooperativa JEP</option>
                  <option value="Otro / Transferencia Directa">Otro / Cooperativa</option>
                </select>
              </div>
              <% } %>
              <div class="flex flex-col gap-1.5 col-span-2">
                <label class="text-[11px] font-black text-slate-500 uppercase">Referencia / Comprobante</label>
                <input type="text" id="transfer-ref" placeholder="Ej: 1293847" class="w-full bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-semibold outline-none focus:bg-white focus:border-[#0252A4] transition text-center font-bold">
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <label for="transfer-comprobante" class="text-[11px] font-black text-slate-500 uppercase">Comprobante de Pago (Imagen)</label>
              <label id="transfer-comprobante-dropzone" for="transfer-comprobante" class="group border-2 border-dashed border-slate-200 bg-slate-50 hover:bg-white hover:border-[#0252A4] rounded-2xl p-4 flex flex-col items-center justify-center gap-2 text-center cursor-pointer transition">
