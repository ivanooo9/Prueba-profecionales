  <style>
    #book-viewport:not(.hidden) {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 100%;
    }
    .fb-sheet {
      position: absolute;
      top: 0;
      right: 0;
      width: 50%;
      height: 100%;
      transform-origin: left center;
      transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
      transform-style: preserve-3d;
      z-index: 1;
    }
    .fb-sheet.flipped {
      transform: rotateY(-180deg);
    }
    .fb-page {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      background-color: white;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .fb-page::before {
      content: "CARGANDO PÁGINA...";
      position: absolute;
      color: #94a3b8;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.1em;
      z-index: 0;
    }
    .fb-page:has(> .fb-page-padding)::before,
    .fb-page > .fb-page-padding {
      content: none;
    }
    .fb-page > .fb-page-padding {
      position: relative;
      z-index: 1;
    }
    .fb-page-front {
      z-index: 2;
      border-radius: 0 16px 16px 0;
    }
    .fb-page-back {
      transform: rotateY(180deg);
      z-index: 1;
      border-radius: 16px 0 0 16px;
    }
    .fb-page canvas {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: white;
    }
  </style>

  <script>
    let pdfDoc = null;
    let currentSheetIndex = -1;
    let totalSheets = 0;
    let sheetsArray = [];
    let renderedPages = new Set();
    let pdfJsPromise = null;
    let flipbookZoom = 1;

    function loadScript(src) {
      return new Promise((resolve, reject) => {
        const existingScript = document.querySelector(`script[src="${src}"]`);
        if (existingScript) {
          existingScript.addEventListener('load', resolve, { once: true });
          existingScript.addEventListener('error', reject, { once: true });
          if (window.pdfjsLib) resolve();
          return;
        }

        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    async function ensurePdfJs() {
      if (!pdfJsPromise) {
        pdfJsPromise = loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js').then(() => {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
        });
      }

      return pdfJsPromise;
    }

    async function openFlipbook(pdfUrl) {
      document.getElementById('flipbook-modal').classList.remove('hidden');
      document.body.classList.add('overflow-hidden');

      // Reset components
      const loadingElement = document.getElementById('flipbook-loading');
      loadingElement.innerHTML = `
        <i class="fa-solid fa-spinner animate-spin text-4xl text-emerald-450"></i>
        <p class="text-sm font-black tracking-wide uppercase">Iniciando Revista 3D...</p>
      `;
      loadingElement.classList.remove('hidden');
      document.getElementById('book-viewport').classList.add('hidden');
      document.getElementById('flipbook-controls').classList.add('hidden');
      document.getElementById('book-container').innerHTML = '';
      renderedPages.clear();
      flipbookZoom = 1;
      updateFlipbookZoom();

      try {
        await ensurePdfJs();
        const loadingTask = window.pdfjsLib.getDocument(pdfUrl);
        pdfDoc = await loadingTask.promise;
        const numPages = pdfDoc.numPages;

        totalSheets = Math.ceil(numPages / 2);
        sheetsArray = [];

        // Dynamic adjustment for small screens
        const viewportWidth = Math.min(window.innerWidth - 24, 1400);
        const viewportHeight = Math.max(420, window.innerHeight - 132);
        const bookContainer = document.getElementById('book-container');
        bookContainer.style.width = viewportWidth + 'px';
        bookContainer.style.height = viewportHeight + 'px';

        // Create sheets structure
        for (let i = 0; i < totalSheets; i++) {
          const sheet = document.createElement('div');
          sheet.className = 'fb-sheet';
          sheet.style.zIndex = totalSheets - i;

          // Front Page (Right page when unflipped, i.e., page 2i+1)
          const pageFrontNum = 2 * i + 1;
          const pageFront = document.createElement('div');
          pageFront.className = 'fb-page fb-page-front';
          if (pageFrontNum <= numPages) {
            const canvas = document.createElement('canvas');
            canvas.id = `page-canvas-${pageFrontNum}`;
            pageFront.appendChild(canvas);
          } else {
            pageFront.innerHTML = '<div class="fb-page-padding w-full h-full bg-slate-50 border border-slate-200"></div>';
          }

          // Back Page (Left page when flipped, i.e., page 2i+2)
          const pageBackNum = 2 * i + 2;
          const pageBack = document.createElement('div');
          pageBack.className = 'fb-page fb-page-back';
          if (pageBackNum <= numPages) {
            const canvas = document.createElement('canvas');
            canvas.id = `page-canvas-${pageBackNum}`;
            pageBack.appendChild(canvas);
          } else {
            pageBack.innerHTML = '<div class="fb-page-padding w-full h-full bg-slate-50 border border-slate-200"></div>';
          }

          sheet.appendChild(pageFront);
          sheet.appendChild(pageBack);
          bookContainer.appendChild(sheet);
          sheetsArray.push(sheet);
        }

        currentSheetIndex = -1;
        updateSheetsZIndex();

        document.getElementById('flipbook-loading').classList.add('hidden');
        document.getElementById('book-viewport').classList.remove('hidden');
        document.getElementById('flipbook-controls').classList.remove('hidden');
        updatePageCounter();

        // Render visible pages immediately, rest in background
        await renderPageNum(1);
        if (numPages >= 2) await renderPageNum(2);
        if (numPages >= 3) await renderPageNum(3);

        renderRemainingPagesBackground(numPages);
      } catch (error) {
        console.error('Error initializing flipbook:', error);
        document.getElementById('flipbook-loading').innerHTML = `
          <i class="fa-solid fa-triangle-exclamation text-3xl text-rose-500 mb-2"></i>
          <p class="text-xs font-bold text-slate-300 uppercase">Error al procesar la revista PDF.</p>
        `;
      }
    }

    function updateFlipbookZoom() {
      const bookContainer = document.getElementById('book-container');
      const zoomDisplay = document.getElementById('zoom-display');
      bookContainer.style.transform = `scale(${flipbookZoom})`;
      bookContainer.style.transformOrigin = 'center center';
      zoomDisplay.innerText = `${Math.round(flipbookZoom * 100)}%`;
    }

    function zoomFlipbook(delta) {
      flipbookZoom = Math.min(1.8, Math.max(0.7, Number((flipbookZoom + delta).toFixed(2))));
      updateFlipbookZoom();
    }

    async function renderPageNum(pageNum) {
      if (renderedPages.has(pageNum)) return;
      renderedPages.add(pageNum);

      const canvas = document.getElementById(`page-canvas-${pageNum}`);
      if (!canvas) return;

      try {
        const page = await pdfDoc.getPage(pageNum);
        const viewport = page.getViewport({ scale: 1.5 });
        const context = canvas.getContext('2d');
        canvas.height = viewport.height;
        canvas.width = viewport.width;

        const renderContext = {
          canvasContext: context,
          viewport: viewport
        };
        await page.render(renderContext).promise;
      } catch (error) {
        console.error(`Error rendering page ${pageNum}:`, error);
        renderedPages.delete(pageNum);
      }
    }

    async function renderRemainingPagesBackground(numPages) {
      for (let p = 4; p <= numPages; p++) {
        await renderPageNum(p);
      }
    }

    function updateSheetsZIndex() {
      sheetsArray.forEach((sheet, idx) => {
        if (idx <= currentSheetIndex) {
          sheet.classList.add('flipped');
          sheet.style.zIndex = idx + 1;
        } else {
          sheet.classList.remove('flipped');
          sheet.style.zIndex = totalSheets - idx;
        }
      });
    }

    function updatePageCounter() {
      const pageDisplay = document.getElementById('page-num-display');
      if (currentSheetIndex === -1) {
        pageDisplay.innerText = 'Portada (Pág. 1)';
      } else {
        const leftPage = 2 * currentSheetIndex + 2;
        const rightPage = leftPage + 1;
        const total = pdfDoc.numPages;
        if (leftPage >= total) {
          pageDisplay.innerText = `Pág. ${total} / ${total}`;
        } else {
          pageDisplay.innerText = `Pág. ${leftPage} - ${Math.min(rightPage, total)} / ${total}`;
        }
      }
    }

    function nextPage() {
      if (currentSheetIndex < totalSheets - 1) {
        currentSheetIndex++;
        updateSheetsZIndex();
        updatePageCounter();
      }
    }

    function prevPage() {
      if (currentSheetIndex >= 0) {
        currentSheetIndex--;
        updateSheetsZIndex();
        updatePageCounter();
      }
    }

    function closeFlipbook() {
      document.getElementById('flipbook-modal').classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      document.getElementById('book-container').innerHTML = '';
      renderedPages.clear();
      sheetsArray = [];
      if (pdfDoc) {
        pdfDoc.destroy();
        pdfDoc = null;
      }
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !document.getElementById('flipbook-modal').classList.contains('hidden')) {
        closeFlipbook();
      }
    });
  </script>

