                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 to-transparent"></div>
                <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between z-10">
                  <% if (edu.tipo === 'TITULO_ACADEMICO') { %>
                    <span class="bg-blue-600/90 text-white text-[9px] font-bold px-2 py-0.5 rounded shadow-sm backdrop-blur-sm">Título Académico</span>
                  <% } else if (edu.tipo === 'CERTIFICACION_INTERNACIONAL') { %>
                    <span class="bg-emerald-600/90 text-white text-[9px] font-bold px-2 py-0.5 rounded shadow-sm backdrop-blur-sm">Certificación Intl.</span>
                  <% } else if (edu.tipo === 'PROYECTO_ESTUDIANTIL') { %>
                    <span class="bg-violet-600/90 text-white text-[9px] font-bold px-2 py-0.5 rounded shadow-sm backdrop-blur-sm">Proyecto Estudiantil</span>
