              <div id="leaflet-viewer-map" class="h-64 rounded-2xl border border-slate-100 shadow-inner z-0"></div>
            <% } else { %>
              <div class="h-64 bg-slate-50 border border-slate-100 rounded-2xl flex flex-col items-center justify-center text-slate-450">
                <i class="fa-solid fa-map-location text-3xl text-slate-400 mb-2"></i>
                <span class="text-xs font-bold text-slate-500">Mapa de ubicación no configurado</span>
              </div>
