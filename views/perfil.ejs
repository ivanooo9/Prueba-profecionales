<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
  <!-- Leaflet CSS for Maps -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <!-- Leaflet JS for Maps -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
</head>
<body class="bg-slate-50 flex flex-col min-h-screen text-slate-800 antialiased font-sans">
  <% if (!previewMode) { %>
    <%- include('partials/header') %>
  <% } %>

  <!-- Banner Cover -->
  <div class="relative w-full h-56 md:h-80 bg-cover bg-center" style="background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.1), rgba(15, 23, 42, 0.75)), url('<%= profile.banner || 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=1200' %>');">
  </div>

  <!-- Main Profile Container -->
  <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-0 md:py-8 flex-grow -mt-20 md:-mt-24 relative z-20">
    <% if (typeof previewMode !== 'undefined' && previewMode) { %>
      <div class="w-full mb-6 rounded-2xl border border-amber-200 bg-amber-50 text-amber-900 px-4 py-3.5 flex items-center justify-between gap-4 shadow-sm">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-eye text-amber-600"></i>
          <p class="text-sm font-semibold">Estás en vista previa — Los cambios aún no están publicados</p>
        </div>
        <a href="#" class="text-amber-500 hover:text-amber-700 transition" aria-label="Cerrar aviso de vista previa">
          <i class="fa-solid fa-xmark"></i>
        </a>
      </div>
    <% } %>

    <!-- Profile Header Card -->
    <div class="bg-white rounded-t-[32px] md:rounded-3xl border-0 md:border border-slate-150/80 shadow-xl p-6 md:p-10 mb-10 transition-transform duration-300 hover:shadow-2xl" data-reveal="fade-up">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6 md:gap-8 text-center md:text-left">
        <!-- Circular Avatar -->
        <div class="relative -mt-16 sm:-mt-20 md:mt-0 flex-shrink-0">
          <div class="w-36 h-36 sm:w-44 sm:h-44 md:w-40 md:h-40 rounded-full overflow-hidden bg-white border-4 border-white shadow-2xl group">
            <img src="<%= profile.photo || 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=300' %>" alt="<%= profile.user.name %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
          </div>
          <% if (profile.verified && new Date(profile.subscriptionEnds) > new Date()) { %>
            <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 bg-white border border-slate-100 text-slate-800 rounded-full h-7 px-3 flex items-center gap-1.5 shadow-lg z-10 whitespace-nowrap" title="Profesional Destacado">
              <i class="fa-solid fa-medal text-amber-500 text-[11px]"></i>
              <span class="text-[9px] font-black uppercase tracking-wider">Destacado</span>
            </div>
          <% } %>
        </div>

        <!-- Details -->
        <div class="flex-grow flex flex-col justify-between h-full pt-2">
          <div>
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-2">
              <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight leading-tight font-sans"><%= profile.user.name %></h1>
            </div>

            <!-- Dynamic Specialty Title -->
            <% 
              let specSubtitle = 'Profesional Afiliado';
              if (profile.specialties && profile.specialties.length > 0) {
                const spec = profile.specialties[0].specialty;
                if (spec.profession) {
                  specSubtitle = `${spec.profession.nombre} Especializada en ${spec.nombre}`;
                } else {
                  specSubtitle = spec.nombre;
                }
              }
            %>
            <p class="text-lg font-bold text-[#0A3C84] mb-3 leading-snug"><%= specSubtitle %></p>
            <p class="text-slate-505 font-medium italic text-sm mb-5 text-slate-500">"<%= profile.slogan || 'Brindando servicios de la más alta calidad y confianza.' %>"</p>
          </div>

          <!-- Quick Metadata Rows -->
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-6 gap-y-3 pt-4 border-t border-slate-100 text-xs font-semibold text-slate-650">
            <span class="flex items-center gap-2"><i class="fa-solid fa-location-dot text-[#0A3C84] text-sm"></i> <%= profile.ciudad || 'Quito' %>, <%= profile.provincia || 'Pichincha' %></span>
            <span class="flex items-center gap-2"><i class="fa-solid fa-wallet text-[#0A3C84] text-sm"></i> Tarifa: Desde $<%= profile.tarifa ? profile.tarifa.toFixed(2) : '0.00' %> / consulta</span>
            <span class="flex items-center gap-2"><i class="fa-solid fa-award text-[#0A3C84] text-sm"></i> Miembro: <%= profile.planType %></span>
          </div>

          <!-- Social Icons (moved under metadata) -->
          <% if (profile.facebook || profile.instagram || profile.linkedin || profile.xTwitter || profile.tiktok || profile.youtube || profile.website) { %>
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 mt-4 pt-3 border-t border-dashed border-slate-100">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 font-extrabold mr-1">Redes Sociales:</span>
              <% if (profile.facebook) { %>
                <a href="<%= profile.facebook.startsWith('http') ? profile.facebook : 'https://' + profile.facebook %>" target="_blank" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-600 hover:bg-[#1877F2] hover:text-white flex items-center justify-center transition-all duration-300 shadow-sm border border-slate-100" title="Facebook">
                  <i class="fa-brands fa-facebook-f text-xs"></i>
                </a>
              <% } %>
              <% if (profile.instagram) { %>
                <a href="<%= profile.instagram.startsWith('http') ? profile.instagram : 'https://' + profile.instagram %>" target="_blank" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-600 hover:bg-gradient-to-tr hover:from-amber-500 hover:via-red-500 hover:to-purple-600 hover:text-white flex items-center justify-center transition-all duration-300 shadow-sm border border-slate-100" title="Instagram">
                  <i class="fa-brands fa-instagram text-xs"></i>
                </a>
              <% } %>
              <% if (profile.linkedin) { %>
                <a href="<%= profile.linkedin.startsWith('http') ? profile.linkedin : 'https://' + profile.linkedin %>" target="_blank" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-600 hover:bg-[#0A66C2] hover:text-white flex items-center justify-center transition-all duration-300 shadow-sm border border-slate-100" title="LinkedIn">
                  <i class="fa-brands fa-linkedin-in text-xs"></i>
                </a>
              <% } %>
              <% if (profile.xTwitter) { %>
                <a href="<%= profile.xTwitter.startsWith('http') ? profile.xTwitter : 'https://' + profile.xTwitter %>" target="_blank" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-600 hover:bg-slate-900 hover:text-white flex items-center justify-center transition-all duration-300 shadow-sm border border-slate-100" title="X / Twitter">
                  <i class="fa-brands fa-x-twitter text-xs"></i>
                </a>
              <% } %>
              <% if (profile.tiktok) { %>
                <a href="<%= profile.tiktok.startsWith('http') ? profile.tiktok : 'https://' + profile.tiktok %>" target="_blank" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-600 hover:bg-black hover:text-white flex items-center justify-center transition-all duration-300 shadow-sm border border-slate-100" title="TikTok">
                  <i class="fa-brands fa-tiktok text-xs"></i>
                </a>
              <% } %>
              <% if (profile.youtube) { %>
                <a href="<%= profile.youtube.startsWith('http') ? profile.youtube : 'https://' + profile.youtube %>" target="_blank" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-600 hover:bg-red-600 hover:text-white flex items-center justify-center transition-all duration-300 shadow-sm border border-slate-100" title="YouTube">
                  <i class="fa-brands fa-youtube text-xs"></i>
                </a>
              <% } %>
              <% if (profile.website) { %>
                <a href="<%= profile.website.startsWith('http') ? profile.website : 'https://' + profile.website %>" target="_blank" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-600 hover:bg-[#0A3C84] hover:text-white flex items-center justify-center transition-all duration-300 shadow-sm border border-slate-100" title="Sitio Web">
                  <i class="fa-solid fa-globe text-xs"></i>
                </a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Booking Message Check -->
    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
      <div class="bg-emerald-50 border border-emerald-100 text-emerald-700 rounded-2xl p-4 text-sm font-bold mb-8 flex items-center gap-3 shadow-sm animate-pulse">
        <i class="fa-solid fa-circle-check text-xl text-emerald-500"></i>
        <span><%= successMsg %></span>
      </div>
    <% } %>

    <!-- Services Section -->
    <div class="mb-8">
      <% if (profile.services && profile.services.length > 0) { %>
        <div class="flex items-center gap-2 mb-5">
          <i class="fa-solid fa-briefcase text-[#0A3C84] text-lg"></i>
          <h2 class="text-lg font-black text-slate-900">SERVICIOS</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% profile.services.forEach(function(serv) { %>
            <div class="flex flex-col justify-between p-5 bg-slate-50 border border-slate-100 rounded-2xl hover:border-[#0A3C84]/30 hover:bg-white hover:shadow-md transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="bg-[#0A3C84] text-white text-[9px] font-black px-2 py-0.5 rounded shadow-sm">P.ec</span>
                    <h3 class="font-extrabold text-slate-900 text-sm group-hover:text-[#0A3C84] transition"><%= serv.nombre %></h3>
                  </div>
                  <span class="text-[#0A3C84] font-black text-sm">$<%= serv.precio ? serv.precio.toFixed(2) : '0.00' %></span>
                </div>
                <% if (serv.descripcion && serv.descripcion.trim()) { %>
                  <p class="text-slate-500 text-[11px] font-semibold leading-relaxed line-clamp-3"><%= serv.descripcion %></p>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-8 bg-slate-50 border border-slate-100 rounded-2xl">
          <i class="fa-solid fa-info-circle text-slate-400 text-2xl mb-2"></i>
          <p class="text-slate-500 text-xs font-bold">No hay servicios registrados actualmente.</p>
        </div>
      <% } %>
    </div>

    <!-- Main Two Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
      
      <!-- LEFT COLUMN: Booking Form (4 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        <% if (typeof previewMode === 'undefined' || !previewMode) { %>
        <div id="agendamiento" class="bg-white p-6 md:p-8 rounded-3xl border border-slate-150/80 shadow-md relative scroll-mt-24">
          <div class="absolute -top-3 right-6 bg-[#0A3C84] text-white text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
            Rápido & Seguro
          </div>
          <h2 class="text-lg font-black text-slate-900 mb-2 flex items-center gap-2">
            <i class="fa-solid fa-calendar-check text-[#0A3C84]"></i> AGENDA UNA CITA
          </h2>
          <p class="text-slate-500 text-[11px] font-bold mb-6">Elige tus detalles preferidos. El profesional se contactará contigo para confirmar o reajustar.</p>
          
          <form action="/citas/agendar" method="POST" class="flex flex-col gap-4" novalidate>
            <input type="hidden" name="profileId" value="<%= profile.id %>">
            
            <div class="flex flex-col gap-1.5">
              <label class="text-[10px] font-bold text-slate-700">Nombres Completos</label>
              <div class="relative">
                <i class="fa-solid fa-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="nombre" required maxlength="40" value="<%= user ? user.name : '' %>" placeholder="Ej: Juan Pérez" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-2.5 pl-9 pr-3 text-xs font-semibold outline-none focus:bg-white focus:border-[#0A3C84] transition">
              </div>
              <span data-appointment-error="nombre" class="hidden text-red-500 text-[10px] mt-0.5 font-semibold"></span>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-[10px] font-bold text-slate-700">Correo Electrónico</label>
              <div class="relative">
                <i class="fa-solid fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="email" name="correo" required value="<%= user ? user.email : '' %>" placeholder="Ej: correo@ejemplo.com" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-2.5 pl-9 pr-3 text-xs font-semibold outline-none focus:bg-white focus:border-[#0A3C84] transition">
              </div>
              <span data-appointment-error="correo" class="hidden text-red-500 text-[10px] mt-0.5 font-semibold"></span>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-[10px] font-bold text-slate-700">Número de Celular</label>
              <div class="relative">
                <i class="fa-solid fa-phone absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="telefono" inputmode="numeric" pattern="[0-9]*" maxlength="10" required placeholder="Ej: 0999999999" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-2.5 pl-9 pr-3 text-xs font-semibold outline-none focus:bg-white focus:border-[#0A3C84] transition">
              </div>
              <span data-appointment-error="telefono" class="hidden text-red-500 text-[10px] mt-0.5 font-semibold"></span>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-700">Fecha Tentativa</label>
                <div class="appointment-date-picker relative" data-primary-color="#0A3C84">
                  <input type="hidden" name="fecha" id="appointment-fecha" required>
                  <button type="button" id="appointment-fecha-trigger" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-bold text-center outline-none focus:bg-white focus:border-[#0A3C84] transition flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed">
                    <i class="fa-solid fa-calendar text-slate-400"></i>
                    <span id="appointment-fecha-display" class="text-slate-400">Selecciona una fecha</span>
                  </button>
                  <span data-appointment-error="fecha" class="hidden mt-1 text-[10px] font-bold text-red-500"></span>
                  <p id="appointment-fecha-hint" class="text-[9px] text-slate-500 mt-1 font-semibold">
                    Días disponibles: <span id="appointment-fecha-hint-days"></span>
                  </p>
                  <div id="appointment-fecha-calendar" class="hidden absolute z-50 mt-2 bg-white border border-slate-200 rounded-2xl shadow-2xl p-4 w-80 max-w-[calc(100vw-2rem)]" style="left: 0; top: 100%;">
                    <div class="flex items-center justify-between mb-3">
                      <button type="button" id="appointment-fecha-prev" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-600 transition cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent">
                        <i class="fa-solid fa-chevron-left text-xs"></i>
                      </button>
                      <div id="appointment-fecha-monthyear" class="text-sm font-black text-slate-800 capitalize"></div>
                      <button type="button" id="appointment-fecha-next" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-600 transition cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent">
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                      </button>
                    </div>
                    <div class="grid grid-cols-7 gap-1 mb-1">
                      <div class="text-[10px] font-bold text-slate-400 text-center py-1">D</div>
                      <div class="text-[10px] font-bold text-slate-400 text-center py-1">L</div>
                      <div class="text-[10px] font-bold text-slate-400 text-center py-1">M</div>
                      <div class="text-[10px] font-bold text-slate-400 text-center py-1">X</div>
                      <div class="text-[10px] font-bold text-slate-400 text-center py-1">J</div>
                      <div class="text-[10px] font-bold text-slate-400 text-center py-1">V</div>
                      <div class="text-[10px] font-bold text-slate-400 text-center py-1">S</div>
                    </div>
                    <div id="appointment-fecha-days" class="grid grid-cols-7 gap-1"></div>
                  </div>
                </div>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-700">Hora Tentativa</label>
                <select name="hora" required class="w-full bg-slate-50 border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-bold text-center outline-none focus:bg-white focus:border-[#0A3C84] transition cursor-pointer">
                  <option value="" disabled selected>Selecciona una hora</option>
                </select>
                <span data-appointment-error="hora" class="hidden text-red-500 text-[10px] mt-0.5 font-semibold"></span>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-[10px] font-bold text-slate-700">Motivo de la Cita</label>
              <textarea name="motivo" rows="4" required maxlength="100" placeholder="Describe brevemente el motivo de tu consulta..." class="w-full bg-slate-50 border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-semibold outline-none resize-none focus:bg-white focus:border-[#0A3C84] transition"></textarea>
              <div class="flex items-center justify-between mt-0.5">
                <span data-appointment-error="motivo" class="hidden text-red-500 text-[10px] font-semibold"></span>
                <span data-appointment-motivo-counter class="text-[10px] text-slate-400 font-semibold ml-auto">0/100</span>
              </div>
            </div>

            <button type="submit" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3.5 rounded-xl text-xs transition shadow-md hover:shadow-lg mt-2 cursor-pointer flex items-center justify-center gap-2">
              <i class="fa-solid fa-calendar-plus"></i> Solicitar Agendamiento
            </button>
          </form>

          <script>
            window.PROFESSIONAL_SCHEDULES = <%- JSON.stringify(profile.schedules || []) %>;
            window.APPOINTMENT_TODAY = "<%= new Date().toISOString().split('T')[0] %>";
          </script>
          <style>
            .appointment-input-error {
              border-color: rgb(248 113 113) !important;
              background-color: rgb(254 242 242) !important;
            }
          </style>
          <script>
            (function() {
              const SCHEDULES = Array.isArray(window.PROFESSIONAL_SCHEDULES) ? window.PROFESSIONAL_SCHEDULES : [];
              const TODAY_ISO = window.APPOINTMENT_TODAY || new Date().toISOString().split('T')[0];

              const JS_DAY_TO_DB = {
                0: 'DOMINGO', 1: 'LUNES', 2: 'MARTES', 3: 'MIERCOLES',
                4: 'JUEVES', 5: 'VIERNES', 6: 'SABADO'
              };
              const DB_DAY_LABEL = {
                LUNES: 'Lunes', MARTES: 'Martes', MIERCOLES: 'Miércoles',
                JUEVES: 'Jueves', VIERNES: 'Viernes', SABADO: 'Sábado', DOMINGO: 'Domingo'
              };
              const DAY_ORDER = ['LUNES','MARTES','MIERCOLES','JUEVES','VIERNES','SABADO','DOMINGO'];

              function timeToMin(t) {
                const [h, m] = t.split(':').map(Number);
                return h * 60 + (m || 0);
              }
              function minToTime(m) {
                return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');
              }

              const form = document.querySelector('form[action="/citas/agendar"]');
              if (!form) return;
              const fechaInput = form.querySelector('input[name="fecha"]');
              const horaSelect = form.querySelector('select[name="hora"]');

              function rebuildHoraOptions() {
                if (!horaSelect) return;
                const placeholder = horaSelect.querySelector('option[value=""]');
                horaSelect.innerHTML = '';
                if (placeholder) {
                  horaSelect.appendChild(placeholder);
                } else {
                  const ph = document.createElement('option');
                  ph.value = '';
                  ph.disabled = true;
                  ph.selected = true;
                  ph.textContent = 'Selecciona una hora';
                  horaSelect.appendChild(ph);
                }
                horaSelect.disabled = false;
                placeholder.selected = true;

                if (!SCHEDULES.length) {
                  const opt = document.createElement('option');
                  opt.value = '';
                  opt.disabled = true;
                  opt.textContent = 'Este profesional no tiene horarios configurados, contáctalo directamente';
                  horaSelect.appendChild(opt);
                  horaSelect.disabled = true;
                  return;
                }

                const fechaVal = fechaInput && fechaInput.value;
                if (!fechaVal) return;

                const [y, mo, d] = fechaVal.split('-').map(Number);
                const dt = new Date(y, mo - 1, d);
                if (isNaN(dt.getTime())) return;
                const dbDay = JS_DAY_TO_DB[dt.getDay()];
                const ranges = SCHEDULES.filter(s => s.dia === dbDay);
                if (!ranges.length) {
                  const opt = document.createElement('option');
                  opt.value = '';
                  opt.disabled = true;
                  opt.textContent = 'Este profesional no atiende ese día';
                  horaSelect.appendChild(opt);
                  horaSelect.disabled = true;
                  return;
                }

                const isToday = fechaVal === TODAY_ISO;
                const nowMin = isToday ? (new Date().getHours() * 60 + new Date().getMinutes()) : -1;
                const slotSet = new Set();
                ranges.forEach(r => {
                  const start = timeToMin(r.horaInicio);
                  const end = timeToMin(r.horaFin);
                  for (let t = start; t < end; t += 30) {
                    if (t < end && (!isToday || t > nowMin)) slotSet.add(t);
                  }
                });
                const slots = [...slotSet].sort((a, b) => a - b);
                if (!slots.length) {
                  const opt = document.createElement('option');
                  opt.value = '';
                  opt.disabled = true;
                  opt.textContent = isToday ? 'No quedan horarios disponibles para hoy' : 'No hay horarios disponibles para ese día';
                  horaSelect.appendChild(opt);
                  horaSelect.disabled = true;
                  return;
                }
                slots.forEach(s => {
                  const opt = document.createElement('option');
                  opt.value = minToTime(s);
                  opt.textContent = minToTime(s);
                  horaSelect.appendChild(opt);
                });
              }

              const datePicker = form.querySelector('.appointment-date-picker');
              if (datePicker && fechaInput) {
                const trigger = datePicker.querySelector('#appointment-fecha-trigger');
                const calendar = datePicker.querySelector('#appointment-fecha-calendar');
                const monthYearEl = datePicker.querySelector('#appointment-fecha-monthyear');
                const daysEl = datePicker.querySelector('#appointment-fecha-days');
                const prevBtn = datePicker.querySelector('#appointment-fecha-prev');
                const nextBtn = datePicker.querySelector('#appointment-fecha-next');
                const displayEl = datePicker.querySelector('#appointment-fecha-display');
                const hintDaysEl = datePicker.querySelector('#appointment-fecha-hint-days');
                const hintWrap = datePicker.querySelector('#appointment-fecha-hint');
                const primaryColor = datePicker.dataset.primaryColor || '#0A3C84';

                const validDays = new Set(SCHEDULES.map(s => s.dia));

                const todayParts = TODAY_ISO.split('-').map(Number);
                const today = new Date(todayParts[0], todayParts[1] - 1, todayParts[2]);
                today.setHours(0, 0, 0, 0);

                const maxMonth = new Date(today.getFullYear(), today.getMonth() + 6, 1);

                let currentMonth = new Date(today.getFullYear(), today.getMonth(), 1);
                let selectedDate = null;

                if (hintDaysEl && hintWrap) {
                  if (SCHEDULES.length) {
                    const unique = [...new Set(SCHEDULES.map(s => s.dia))];
                    unique.sort((a, b) => DAY_ORDER.indexOf(a) - DAY_ORDER.indexOf(b));
                    hintDaysEl.textContent = unique.map(d => DB_DAY_LABEL[d]).join(', ');
                  } else {
                    hintWrap.classList.add('hidden');
                  }
                }

                if (fechaInput.value && /^\d{4}-\d{2}-\d{2}$/.test(fechaInput.value)) {
                  const parts = fechaInput.value.split('-').map(Number);
                  const pre = new Date(parts[0], parts[1] - 1, parts[2]);
                  if (!isNaN(pre.getTime()) && pre.getTime() >= today.getTime()) {
                    selectedDate = pre;
                    currentMonth = new Date(pre.getFullYear(), pre.getMonth(), 1);
                  } else {
                    fechaInput.value = '';
                  }
                }

                function isSameDay(a, b) {
                  return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
                }

                function toISO(d) {
                  const y = d.getFullYear();
                  const m = String(d.getMonth() + 1).padStart(2, '0');
                  const day = String(d.getDate()).padStart(2, '0');
                  return `${y}-${m}-${day}`;
                }

                function updateDisplay() {
                  if (selectedDate) {
                    displayEl.textContent = selectedDate.toLocaleDateString('es-EC', {
                      day: 'numeric', month: 'long', year: 'numeric'
                    });
                    displayEl.classList.remove('text-slate-400');
                    displayEl.classList.add('text-slate-700');
                  } else {
                    displayEl.textContent = SCHEDULES.length ? 'Selecciona una fecha' : 'Sin horarios disponibles';
                    displayEl.classList.add('text-slate-400');
                    displayEl.classList.remove('text-slate-700');
                  }
                }

                function renderDays() {
                  const year = currentMonth.getFullYear();
                  const month = currentMonth.getMonth();
                  const firstDay = new Date(year, month, 1);
                  const startOffset = firstDay.getDay();
                  const startDate = new Date(year, month, 1 - startOffset);

                  monthYearEl.textContent = currentMonth.toLocaleDateString('es-EC', { month: 'long', year: 'numeric' });

                  const currentMonthStart = new Date(today.getFullYear(), today.getMonth(), 1);
                  prevBtn.disabled = currentMonth.getTime() <= currentMonthStart.getTime();
                  nextBtn.disabled = currentMonth.getTime() >= maxMonth.getTime();

                  daysEl.innerHTML = '';

                  for (let i = 0; i < 42; i++) {
                    const date = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate() + i);
                    const isCurrentMonth = date.getMonth() === month;
                    const isPast = date.getTime() < today.getTime();
                    const dbDay = JS_DAY_TO_DB[date.getDay()];
                    const isValidDay = validDays.has(dbDay);
                    const isToday = isSameDay(date, today);
                    const isSelected = selectedDate && isSameDay(date, selectedDate);

                    const cell = document.createElement('button');
                    cell.type = 'button';
                    cell.textContent = String(date.getDate());

                    let classes = 'h-9 w-full rounded-lg text-xs font-bold flex items-center justify-center transition';

                    if (!isCurrentMonth) {
                      classes += ' text-slate-300 cursor-default';
                    } else if (isPast) {
                      classes += ' text-slate-300 line-through cursor-not-allowed';
                    } else if (!isValidDay) {
                      classes += ' text-slate-300 cursor-not-allowed';
                    } else if (isSelected) {
                      classes += ' text-white';
                    } else if (isToday) {
                      classes += ' text-slate-700 cursor-pointer hover:bg-slate-100';
                    } else {
                      classes += ' text-slate-700 cursor-pointer hover:bg-slate-100';
                    }

                    cell.className = classes;

                    if (isSelected) {
                      cell.style.backgroundColor = primaryColor;
                    } else if (isCurrentMonth && !isPast && isValidDay && isToday) {
                      cell.style.boxShadow = `inset 0 0 0 2px ${primaryColor}55`;
                    }

                    if (isCurrentMonth && !isPast && isValidDay) {
                      cell.addEventListener('click', () => {
                        selectedDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());
                        fechaInput.value = toISO(selectedDate);
                        updateDisplay();
                        renderDays();
                        calendar.classList.add('hidden');
                        fechaInput.dispatchEvent(new Event('change', { bubbles: true }));
                      });
                    } else {
                      cell.disabled = true;
                    }

                    daysEl.appendChild(cell);
                  }
                }

                function openCalendar() {
                  if (!SCHEDULES.length) return;
                  calendar.classList.remove('hidden');
                  renderDays();
                }
                function closeCalendar() {
                  calendar.classList.add('hidden');
                }
                function toggleCalendar() {
                  if (calendar.classList.contains('hidden')) openCalendar();
                  else closeCalendar();
                }

                if (trigger) {
                  if (!SCHEDULES.length) {
                    trigger.disabled = true;
                  } else {
                    trigger.addEventListener('click', (e) => {
                      e.stopPropagation();
                      toggleCalendar();
                    });
                  }
                }

                if (prevBtn) {
                  prevBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (prevBtn.disabled) return;
                    currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1, 1);
                    renderDays();
                  });
                }
                if (nextBtn) {
                  nextBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (nextBtn.disabled) return;
                    currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1);
                    renderDays();
                  });
                }

                document.addEventListener('click', (e) => {
                  if (!datePicker.contains(e.target)) {
                    closeCalendar();
                  }
                });

                document.addEventListener('keydown', (e) => {
                  if (e.key === 'Escape') closeCalendar();
                });

                updateDisplay();
              }

              const validators = {
                nombre: (v) => {
                  const t = (v || '').trim();
                  if (!t) return { ok: false, msg: 'Ingresa tu nombre completo.' };
                  if (t.length > 40) return { ok: false, msg: 'Máximo 40 caracteres.' };
                  if (/\d/.test(t)) return { ok: false, msg: 'El nombre no puede contener números.' };
                  return { ok: true };
                },
                correo: (v) => {
                  const t = (v || '').trim();
                  if (!t) return { ok: false, msg: 'Ingresa tu correo electrónico.' };
                  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(t)) return { ok: false, msg: 'Formato de correo inválido. Ej: usuario@dominio.com' };
                  return { ok: true };
                },
                telefono: (v) => {
                  const t = (v || '').trim();
                  if (!t) return { ok: false, msg: 'Ingresa tu número de celular.' };
                  if (!/^\d{10}$/.test(t)) return { ok: false, msg: 'Debe tener exactamente 10 dígitos numéricos, sin espacios ni guiones.' };
                  return { ok: true };
                },
                fecha: (v) => {
                  if (!v) return { ok: false, msg: 'Selecciona una fecha.' };
                  if (v < TODAY_ISO) return { ok: false, msg: 'La fecha no puede ser anterior a hoy.' };
                  if (!SCHEDULES.length) return { ok: true };
                  const [y, mo, d] = v.split('-').map(Number);
                  const dt = new Date(y, mo - 1, d);
                  if (isNaN(dt.getTime())) return { ok: false, msg: 'Fecha inválida.' };
                  const dbDay = JS_DAY_TO_DB[dt.getDay()];
                  if (!SCHEDULES.some(s => s.dia === dbDay)) return { ok: false, msg: 'El profesional no atiende ese día. Elige otro día.' };
                  return { ok: true };
                },
                hora: (v) => {
                  if (!v) return { ok: false, msg: 'Selecciona una hora disponible.' };
                  if (!/^\d{2}:\d{2}$/.test(v)) return { ok: false, msg: 'Formato de hora inválido.' };
                  return { ok: true };
                },
                motivo: (v) => {
                  const t = (v || '').trim();
                  if (!t) return { ok: false, msg: 'Describe brevemente el motivo de tu consulta.' };
                  if (t.length > 100) return { ok: false, msg: 'El motivo no puede superar los 100 caracteres.' };
                  return { ok: true };
                }
              };

              function setFieldError(name, msg) {
                const input = form.querySelector('[name="' + name + '"]');
                const errEl = form.querySelector('[data-appointment-error="' + name + '"]');
                if (input) input.classList.add('appointment-input-error');
                if (errEl) {
                  errEl.textContent = msg || '';
                  errEl.classList.remove('hidden');
                }
              }
              function clearFieldError(name) {
                const input = form.querySelector('[name="' + name + '"]');
                const errEl = form.querySelector('[data-appointment-error="' + name + '"]');
                if (input) input.classList.remove('appointment-input-error');
                if (errEl) errEl.classList.add('hidden');
              }
              function clearAllErrors() {
                Object.keys(validators).forEach(clearFieldError);
              }

              const nombreInput = form.querySelector('input[name="nombre"]');
              if (nombreInput) {
                nombreInput.addEventListener('keydown', (e) => {
                  if (/^[0-9]$/.test(e.key)) {
                    e.preventDefault();
                  }
                });
                nombreInput.addEventListener('input', () => {
                  const cleaned = nombreInput.value.replace(/[0-9]/g, '');
                  if (nombreInput.value !== cleaned) nombreInput.value = cleaned;
                  if (nombreInput.classList.contains('appointment-input-error')) {
                    const res = validators.nombre(nombreInput.value);
                    if (res.ok) clearFieldError('nombre');
                    else setFieldError('nombre', res.msg);
                  }
                });
              }

              ['correo', 'motivo'].forEach(name => {
                const input = form.querySelector('[name="' + name + '"]');
                if (!input) return;
                input.addEventListener('input', () => {
                  if (input.classList.contains('appointment-input-error')) {
                    const res = validators[name](input.value);
                    if (res.ok) clearFieldError(name);
                    else setFieldError(name, res.msg);
                  }
                });
              });

              const motivoCounter = form.querySelector('[data-appointment-motivo-counter]');
              if (motivoCounter) {
                const motivoInput = form.querySelector('textarea[name="motivo"]');
                if (motivoInput) {
                  const updateCounter = () => {
                    motivoCounter.textContent = motivoInput.value.length + '/100';
                  };
                  motivoInput.addEventListener('input', updateCounter);
                  updateCounter();
                }
              }

              const telInput = form.querySelector('input[name="telefono"]');
              if (telInput) {
                telInput.addEventListener('input', () => {
                  const digits = telInput.value.replace(/\D/g, '').slice(0, 10);
                  if (telInput.value !== digits) telInput.value = digits;
                  if (telInput.classList.contains('appointment-input-error')) {
                    const res = validators.telefono(telInput.value);
                    if (res.ok) clearFieldError('telefono');
                    else setFieldError('telefono', res.msg);
                  }
                });
              }

              if (fechaInput) {
                fechaInput.addEventListener('change', () => {
                  const res = validators.fecha(fechaInput.value);
                  if (!res.ok) setFieldError('fecha', res.msg);
                  else clearFieldError('fecha');
                  rebuildHoraOptions();
                  const errHora = form.querySelector('[data-appointment-error="hora"]');
                  if (errHora) errHora.classList.add('hidden');
                  if (horaSelect) horaSelect.classList.remove('appointment-input-error');
                });
              }

              if (horaSelect) {
                horaSelect.addEventListener('change', () => {
                  const res = validators.hora(horaSelect.value);
                  if (!res.ok) setFieldError('hora', res.msg);
                  else clearFieldError('hora');
                });
              }

              form.addEventListener('submit', (e) => {
                clearAllErrors();
                let firstInvalid = null;
                Object.keys(validators).forEach(name => {
                  const input = form.querySelector('[name="' + name + '"]');
                  if (!input) return;
                  const res = validators[name](input.value);
                  if (!res.ok) {
                    setFieldError(name, res.msg);
                    if (!firstInvalid) firstInvalid = input;
                  }
                });
                if (firstInvalid) {
                  e.preventDefault();
                  firstInvalid.focus();
                  firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
              });

              rebuildHoraOptions();

              const serverError = document.getElementById('appointment-server-error');
              if (serverError) {
                const target = document.getElementById('agendar-cita') || form;
                if (target && target.scrollIntoView) {
                  target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
              }
            })();
          </script>
        </div>
        <% } %>

        <!-- Horarios de Atención (Sub-card in left column) -->
        <div class="bg-white p-6 rounded-3xl border border-slate-150/80 shadow-md">
          <h2 class="text-sm font-extrabold text-slate-905 mb-4 uppercase tracking-wider border-b border-slate-100 pb-2 flex items-center gap-1.5">
            <i class="fa-solid fa-clock text-[#0A3C84]"></i> Horarios Disponibles
          </h2>
          <div class="flex flex-col gap-3 text-xs font-bold">
            <% if (profile.schedules && profile.schedules.length > 0) { %>
              <% 
                const orderDays = { LUNES: 1, MARTES: 2, MIERCOLES: 3, JUEVES: 4, VIERNES: 5, SABADO: 6, DOMINGO: 7 };
                const sortedScheds = [...profile.schedules].sort((a,b) => orderDays[a.dia] - orderDays[b.dia]);
                sortedScheds.forEach(function(sched) { 
              %>
                <div class="flex items-center justify-between py-1.5 border-b border-slate-50 last:border-b-0">
                  <span class="text-slate-400 font-extrabold uppercase tracking-wide"><%= sched.dia %></span>
                  <span class="text-slate-800"><%= sched.horaInicio %> - <%= sched.horaFin %></span>
                </div>
              <% }); %>
            <% } else { %>
              <div class="text-slate-400 text-xs text-center py-4">
                <span>No se han configurado horarios semanales.</span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Biography, Location & Contact (7 Cols) -->
      <div class="lg:col-span-7 flex flex-col gap-8">
        
        <!-- Bio Card (CONÓCEME) -->
        <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-150/80 shadow-md">
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
            <i class="fa-solid fa-user-tie text-xl text-[#0A3C84]"></i>
            <h2 class="text-lg font-black text-slate-900">CONÓCEME</h2>
