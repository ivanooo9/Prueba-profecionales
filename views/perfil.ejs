            <a href="mailto:<%= profile.user.email %>?subject=Contacto%20Profesional%20-%20Directorio" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3.5 px-6 rounded-xl flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all text-xs">
              <i class="fa-solid fa-envelope text-sm"></i> Enviar Correo Electrónico
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Formación y Certificaciones (Externo) -->
    <% if (profile.education && profile.education.length > 0) { %>
      <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-150/80 shadow-md mt-10">
        <div class="flex items-center gap-2 mb-6 border-b border-slate-100 pb-4">
          <i class="fa-solid fa-graduation-cap text-xl text-[#0A3C84]"></i>
          <h2 class="text-xl font-extrabold text-slate-900">Formación y Certificaciones</h2>
        </div>

