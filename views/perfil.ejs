                </div>

                <div class="pt-3 border-t border-slate-100 mt-3 flex items-center justify-between text-[#0A3C84] text-xs font-bold">
                  <span>Ver Documento</span>
                  <i class="fa-solid fa-expand text-xs group-hover:translate-x-0.5 transition"></i>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- SECCIÓN E-COMMERCE: Cursos & Capacitaciones Colaborativas -->
    <% if (typeof collaboratedCursos !== 'undefined' && collaboratedCursos && collaboratedCursos.length > 0) { %>
      <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-150/80 shadow-md mt-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 border-b border-slate-100 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-brand-lightBlue text-[#0A3C84] flex items-center justify-center text-lg font-black shadow-xs">
              <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div>
              <span class="text-[10px] font-black tracking-widest text-[#0A3C84] uppercase block">Academia & Formación Continua</span>
              <h2 class="text-xl font-extrabold text-slate-900">Cursos e Instructivos por este Profesional</h2>
            </div>
          </div>
          <div class="text-xs font-bold text-slate-400">
            <%= collaboratedCursos.length %> <%= collaboratedCursos.length === 1 ? 'curso disponible' : 'cursos disponibles' %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% collaboratedCursos.forEach(function(cur) { %>
            <div class="bg-white rounded-2xl border border-slate-100 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col overflow-hidden group">
              
              <!-- Cover Image & Price Badge -->
              <div class="relative w-full h-44 bg-slate-900 overflow-hidden">
                <% if (cur.mediaUrl || cur.banner) { %>
                  <img src="<%= cur.mediaUrl || cur.banner %>" alt="<%= cur.titulo %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90">
                <% } else { %>
                  <div class="w-full h-full bg-gradient-to-br from-[#0A3C84] to-sky-900 flex items-center justify-center p-4 text-center">
                    <span class="text-white font-black text-sm tracking-tight"><%= cur.titulo %></span>
                  </div>
                <% } %>

                <!-- Price Badge -->
                <div class="absolute top-3 right-3 bg-white/95 backdrop-blur-md px-3 py-1.5 rounded-xl shadow-lg flex items-center gap-1.5 border border-slate-100">
                  <% if (cur.gratuito || cur.precio === 0) { %>
                    <span class="text-xs font-black text-emerald-600 uppercase tracking-wider">GRATUITO</span>
                  <% } else { %>
                    <span class="text-xs font-black text-slate-900">$<%= cur.precio.toFixed(2) %> USD</span>
                  <% } %>
                </div>

                <!-- Category Badge -->
                <% if (cur.category) { %>
                  <div class="absolute bottom-3 left-3 bg-[#0A3C84]/90 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-lg">
                    <%= cur.category.nombre %>
                  </div>
                <% } %>
              </div>

              <!-- Body Info -->
              <div class="p-5 flex flex-col flex-grow justify-between gap-4">
                <div class="flex flex-col gap-2">
                  <% if (cur.slogan) { %>
                    <span class="text-[10px] font-extrabold text-[#0A3C84] uppercase tracking-wider line-clamp-1"><%= cur.slogan %></span>
                  <% } %>
                  <h3 class="text-sm font-extrabold text-slate-900 group-hover:text-[#0A3C84] transition line-clamp-2 leading-snug"><%= cur.titulo %></h3>
                  <p class="text-xs text-slate-500 line-clamp-2 font-medium leading-relaxed">
                    <%= cur.descripcion || 'Formación académica de especialización práctica con certificación avalada.' %>
                  </p>
                </div>

                <!-- Features & Badges -->
                <div class="flex flex-col gap-3 pt-3 border-t border-slate-100">
                  <div class="flex items-center justify-between text-[11px] font-semibold text-slate-500">
                    <span class="flex items-center gap-1 text-emerald-600 font-bold">
                      <i class="fa-solid fa-certificate"></i> Certificado Oficial
                    </span>
                    <% if (cur.branch) { %>
                      <span class="text-slate-400 truncate max-w-[120px]"><%= cur.branch.nombre %></span>
                    <% } %>
                  </div>

                  <!-- Single CTA: Inscribirse al Curso -->
                  <% 
                    const courseSlug = cur.slug ? cur.slug : (cur.titulo ? cur.titulo.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : cur.id);
                  %>
                  <a href="/cursos/<%= courseSlug %>" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3 px-4 rounded-xl text-xs transition text-center flex items-center justify-center gap-2 shadow-md hover:shadow-lg mt-1 cursor-pointer">
                    <i class="fa-solid fa-arrow-right-to-bracket text-xs"></i> Inscribirse al Curso
                  </a>
                </div>
              </div>

            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Certificados de Profesionales Ecuador -->
    <% const approvedCertificates = profile.user && profile.user.acquiredCertificates ? profile.user.acquiredCertificates.filter(c => c.estado === 'APROBADO') : []; %>
    <% if (approvedCertificates.length > 0) { %>
      <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-150/80 shadow-md mt-10">
        <div class="flex items-center gap-2 mb-6 border-b border-slate-100 pb-4">
          <i class="fa-solid fa-award text-xl text-[#0A3C84]"></i>
          <h2 class="text-xl font-extrabold text-slate-900">Certificados de Profesionales Ecuador</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% approvedCertificates.forEach(function(cert) { %>
            <% 
              let coverImg = null;
              if (cert.conversatorio) {
                coverImg = cert.conversatorio.revistaPortada || cert.conversatorio.banner;
              } else if (cert.curso) {
                coverImg = cert.curso.revistaPortada || cert.curso.banner || cert.curso.mediaUrl;
              }
            %>
            <div class="border border-slate-100 rounded-2xl bg-slate-50 flex flex-col justify-between overflow-hidden shadow-sm hover:shadow-lg hover:border-[#0A3C84]/20 transition-all duration-300">
              <!-- Certificate Header (Cover Image or Gradient Fallback) -->
              <% if (coverImg) { %>
                <div class="w-full h-36 bg-slate-200 relative overflow-hidden">
                  <img src="<%= coverImg %>" alt="<%= cert.nombreEvento %>" class="w-full h-full object-cover">
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
                  <div class="absolute bottom-2 left-3 right-3 flex items-center justify-between z-10">
                    <span class="bg-[#0A3C84] text-white text-[9px] font-black px-2 py-0.5 rounded shadow-sm">Profesionales.ec</span>
                    <span class="text-white/90 text-[9px] font-bold bg-black/40 px-2 py-0.5 rounded backdrop-blur-sm uppercase">Certificado</span>
                  </div>
                </div>
              <% } else { %>
                <div class="w-full h-32 bg-gradient-to-br from-[#0A3C84] to-[#1e5bb5] flex items-center justify-center relative">
                  <i class="fa-solid fa-certificate text-white/20 text-6xl absolute"></i>
                  <div class="text-center z-10 px-4">
                    <i class="fa-solid fa-award text-white text-3xl mb-2"></i>
                    <p class="text-white/80 text-[10px] font-bold uppercase tracking-wider">Certificado</p>
                  </div>
                </div>
              <% } %>

              <!-- Content -->
              <div class="p-5 flex-grow flex flex-col justify-between">
                <div>
                  <h3 class="font-extrabold text-slate-900 text-sm leading-snug mb-2 line-clamp-2"><%= cert.nombreEvento %></h3>
                  
                  <% if (cert.horas && cert.horas > 0) { %>
                    <p class="text-slate-500 text-[11px] font-semibold mb-1">
                      <i class="fa-regular fa-clock text-sky-500"></i> <%= cert.horas %> horas académicas
                    </p>
                  <% } else { %>
                    <p class="text-amber-700 text-[11px] font-bold mb-1 flex items-center gap-1">
                      <i class="fa-solid fa-award text-amber-500"></i> Certificado de Asistencia
                    </p>
                  <% } %>

                  <p class="text-slate-400 text-[10px] font-mono mb-3">
                    <i class="fa-solid fa-fingerprint text-slate-300"></i> <%= cert.codigo %>
                  </p>
                </div>

                <div class="pt-3 border-t border-slate-100 mt-2">
                  <p class="text-slate-400 text-[10px] flex items-center gap-1">
                    <i class="fa-regular fa-calendar"></i>
                    <%= cert.fechaEmision instanceof Date ? cert.fechaEmision.toLocaleDateString('es-EC', { year: 'numeric', month: 'long', day: 'numeric' }) : new Date(cert.fechaEmision).toLocaleDateString('es-EC', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                  </p>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Approved Articles Cards (Footer Grid - Colocado al Último) -->
    <% const approvedArticles = profile.articles ? profile.articles.filter(a => a.estado === 'APROBADO') : []; %>
    <% if (approvedArticles.length > 0) { %>
      <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-150/80 shadow-md mt-10">
        <div class="flex items-center gap-2 mb-6 border-b border-slate-100 pb-4">
          <i class="fa-solid fa-book-open text-xl text-[#0A3C84]"></i>
          <h2 class="text-xl font-extrabold text-slate-900">Artículos Científicos Publicados</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% approvedArticles.forEach(function(art) { %>
            <div class="border border-slate-100 rounded-2xl bg-slate-50 flex flex-col justify-between overflow-hidden shadow-sm hover:shadow-lg hover:border-[#0A3C84]/20 transition-all duration-300">
              <!-- Article Portada/Image -->
              <div class="w-full h-40 bg-slate-200 overflow-hidden relative">
                <img src="<%= art.imagen || 'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?q=80&w=400' %>" alt="<%= art.titulo %>" class="w-full h-full object-cover">
                <div class="absolute bottom-3 left-3 bg-black/70 text-white text-[9px] font-black tracking-wider px-2 py-0.5 rounded shadow">
                  <%= art.createdAt instanceof Date ? art.createdAt.toLocaleDateString('es-EC', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Publicado' %>
                </div>
              </div>
              
              <!-- Content -->
              <div class="p-5 flex-grow flex flex-col justify-between">
                <div>
                  <h3 class="font-extrabold text-slate-900 text-sm leading-snug mb-2 line-clamp-2 hover:text-[#0A3C84] transition"><%= art.titulo %></h3>
                  <p class="text-slate-500 text-[11px] font-semibold leading-relaxed line-clamp-3 mb-4"><%= art.resumen %></p>
                </div>
                
                <a href="/articulos/leer/<%= art.slug || art.id %>" target="_blank" class="bg-white hover:bg-slate-50 border border-slate-150 text-slate-800 text-[10px] font-extrabold px-4 py-2.5 rounded-xl transition shadow-sm hover:shadow flex items-center justify-center gap-1.5 w-full mt-2">
                  <i class="fa-solid fa-book-open text-sky-500 text-sm"></i> Leer Artículo en Plataforma
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

  <!-- Modal Lightbox de Documentos Académicos -->
  <div id="modal-edu-lightbox" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4" onclick="closeEduModal()">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-6 relative overflow-hidden shadow-2xl animate-in fade-in zoom-in duration-200" onclick="event.stopPropagation()">
      <button onclick="closeEduModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center transition cursor-pointer">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
      <h3 id="modal-edu-titulo" class="font-extrabold text-slate-900 text-base mb-0.5"></h3>
      <p id="modal-edu-institucion" class="text-slate-500 text-xs font-semibold mb-4"></p>
      <div class="w-full max-h-[70vh] overflow-auto rounded-2xl border border-slate-100 bg-slate-50 flex items-center justify-center p-2">
        <img id="modal-edu-img" src="" alt="Documento Académico" class="max-w-full h-auto rounded-xl object-contain shadow-sm">
      </div>
    </div>
  </div>

  <script>
    function openEduModal(imgUrl, titulo, institucion) {
      document.getElementById('modal-edu-img').src = imgUrl;
      document.getElementById('modal-edu-titulo').innerText = titulo;
      document.getElementById('modal-edu-institucion').innerText = institucion;
      const modal = document.getElementById('modal-edu-lightbox');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closeEduModal() {
      const modal = document.getElementById('modal-edu-lightbox');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  </script>

  </main>

  <% if (!previewMode) { %>
    <%- include('partials/footer') %>
  <% } %>

  <!-- Leaflet Map Script -->
  <% if (profile.latitud && profile.longitud) { %>
    <script>
      const lat = <%= profile.latitud %>;
      const lng = <%= profile.longitud %>;
      const mapViewer = L.map('leaflet-viewer-map', {
        zoomControl: false,
        dragging: false,
        touchZoom: false,
        doubleClickZoom: false,
        scrollWheelZoom: false,
        boxZoom: false,
        keyboard: false
      }).setView([lat, lng], 15);
      
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(mapViewer);

      // Customize icon
      const mapIcon = L.divIcon({
        html: '<div class="w-8 h-8 rounded-full bg-[#0A3C84] border-2 border-white flex items-center justify-center shadow-lg"><i class="fa-solid fa-location-dot text-white text-sm"></i></div>',
        className: 'custom-leaflet-icon',
        iconSize: [32, 32],
        iconAnchor: [16, 32]
      });

      L.marker([lat, lng], { icon: mapIcon }).addTo(mapViewer)
        .bindPopup('<div class="p-2 text-center font-sans font-semibold"><b class="text-slate-900"><%= profile.user.name %></b><p class="text-[10px] text-slate-500"><%= profile.direccion || profile.callePrincipal %></p></div>')
        .openPopup();
    </script>
  <% } %>
</body>
</html>
