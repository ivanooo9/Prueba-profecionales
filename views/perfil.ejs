            <%
              let cleanPhone = (profile.whatsapp || profile.telefono) ? (profile.whatsapp || profile.telefono).replace(/\D/g, '') : '';
              if (cleanPhone && !cleanPhone.startsWith('593')) {
                if (cleanPhone.startsWith('0')) {
                  cleanPhone = '593' + cleanPhone.substring(1);
                } else {
                  cleanPhone = '593' + cleanPhone;
                }
              }
            %>
            
            <% if (cleanPhone) { %>
              <a href="https://wa.me/<%= cleanPhone %>?text=Hola%20<%= encodeURIComponent(profile.user.name) %>,%20te%20contacto%20desde%20Profesionales%20Ecuador." target="_blank" class="bg-[#25D366] hover:bg-[#20BA5A] text-white font-extrabold py-3.5 px-6 rounded-xl flex items-center justify-center gap-2 shadow-md hover:shadow-lg transition-all text-xs">
                <i class="fa-brands fa-whatsapp text-lg"></i> Contactar por WhatsApp
              </a>
            <% } else { %>
              <button disabled class="bg-slate-100 text-slate-400 font-extrabold py-3.5 px-6 rounded-xl flex items-center justify-center gap-2 text-xs cursor-not-allowed">
                <i class="fa-brands fa-whatsapp text-lg"></i> WhatsApp no disponible
              </button>
