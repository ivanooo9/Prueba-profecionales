                <span class="text-slate-400 uppercase text-[9px] tracking-wider block">Calle Principal</span>
                <span class="text-slate-800 leading-normal"><%= profile.callePrincipal || profile.direccion || 'No especificada' %></span>
              </div>
              <div>
                <span class="text-slate-400 uppercase text-[9px] tracking-wider block">Referencia</span>
                <span class="text-slate-800 leading-normal"><%= profile.referencia || 'Sin referencia registrada' %></span>
              </div>
            </div>
            
            <div class="text-xs font-bold space-y-3">
              <div>
                <span class="text-slate-400 uppercase text-[9px] tracking-wider block">Ciudad / Provincia</span>
                <span class="text-slate-800 leading-normal"><%= profile.ciudad || 'No especificada' %>, <%= profile.provincia || 'No especificada' %></span>
              </div>
              <div>
                <span class="text-slate-400 uppercase text-[9px] tracking-wider block">Contacto Directo</span>
