<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Billetera Virtual y Retiros | Profesionales Ecuador</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="h-full flex flex-col bg-slate-50 text-slate-800">

  <!-- Top Navbar -->
  <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center font-black text-white text-sm">PE</div>
          <span class="font-extrabold text-base tracking-tight text-white hidden sm:inline">Profesionales<span class="text-sky-400">Ecuador</span></span>
        </a>
        <span class="bg-blue-500/20 text-blue-300 text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full border border-blue-500/30">Módulo Referidos</span>
      </div>

      <nav class="hidden md:flex items-center gap-1">
        <a href="/dashboard/referido" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/60 transition flex items-center gap-2">
          <i class="fa-solid fa-chart-pie text-sky-400"></i> Dashboard
        </a>
        <a href="/dashboard/referido/ventas" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/60 transition flex items-center gap-2">
          <i class="fa-solid fa-cart-shopping text-emerald-400"></i> Mis Ventas
        </a>
        <a href="/dashboard/referido/billetera" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white bg-slate-800 border border-slate-700 flex items-center gap-2">
          <i class="fa-solid fa-wallet text-amber-400"></i> Billetera & Retiros
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/logout" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-rose-600/80 text-slate-300 hover:text-white text-xs font-bold transition flex items-center gap-1.5 border border-slate-700">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> <span class="hidden sm:inline">Salir</span>
        </a>
      </div>
    </div>
  </header>

  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 mb-16 md:mb-8 space-y-8">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-150 shadow-sm">
      <div>
        <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-wallet text-amber-500"></i> Billetera Virtual & Solicitudes de Retiro
        </h1>
        <p class="text-xs text-slate-500 mt-1">Consulta tus saldos acumulados por comisiones de ventas y solicita tus transferencias de retiro a fin de mes.</p>
      </div>

      <button onclick="openWithdrawalModal()" class="w-full sm:w-auto px-6 py-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/20 transition flex items-center justify-center gap-2">
        <i class="fa-solid fa-hand-holding-dollar text-base"></i> Solicitar Retiro de Fondos
      </button>
    </div>

    <!-- Feedback Alerts -->
    <% if (success === 'withdrawal_submitted') { %>
      <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 text-xs font-semibold flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-lg text-emerald-600"></i>
        <span>Solicitud de retiro registrada exitosamente. La administración revisará y procesará la transferencia bancaria.</span>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 text-xs font-semibold flex items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-lg text-rose-600"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Wallet Digital Card & Bank Details Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Virtual Card -->
      <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-950 p-6 sm:p-8 rounded-3xl text-white shadow-2xl relative overflow-hidden flex flex-col justify-between border border-slate-800 space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-[10px] font-black uppercase tracking-widest text-sky-400">Profesionales Ecuador</p>
            <p class="text-xs font-bold text-slate-300">Billetera de Comisiones</p>
          </div>
          <i class="fa-solid fa-wifi text-slate-600 text-lg"></i>
        </div>

        <div>
          <p class="text-[10px] text-slate-400 font-bold uppercase">Saldo Disponible</p>
          <p class="text-4xl font-black text-emerald-400 tracking-tight">$<%= wallet.saldoDisponible.toFixed(2) %></p>
        </div>

        <div class="grid grid-cols-2 gap-2 pt-4 border-t border-slate-800 text-xs">
          <div>
            <p class="text-[9px] text-slate-400 uppercase font-bold">En Proceso</p>
            <p class="font-extrabold text-amber-400">$<%= wallet.saldoPendiente.toFixed(2) %></p>
          </div>
          <div>
            <p class="text-[9px] text-slate-400 uppercase font-bold">Total Retirado</p>
            <p class="font-extrabold text-slate-200">$<%= wallet.saldoRetirado.toFixed(2) %></p>
          </div>
        </div>
      </div>

      <!-- Bank Details -->
      <div class="lg:col-span-2 bg-white p-6 rounded-3xl border border-slate-150 shadow-sm flex flex-col justify-between space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-building-columns text-blue-600"></i> Cuenta Bancaria Registrada para Retiros
          </h3>
          <span class="text-[10px] font-black uppercase text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">Verificada</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
            <p class="text-[10px] font-bold text-slate-400 uppercase">Banco / Entidad</p>
            <p class="text-sm font-black text-slate-900 mt-1"><%= profile.banco || 'No registrado' %></p>
          </div>
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
            <p class="text-[10px] font-bold text-slate-400 uppercase">Tipo de Cuenta</p>
            <p class="text-sm font-black text-slate-900 mt-1"><%= profile.tipoCuenta || 'Ahorros' %></p>
          </div>
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
            <p class="text-[10px] font-bold text-slate-400 uppercase">Número de Cuenta</p>
            <p class="text-sm font-black text-slate-900 mt-1"><%= profile.numeroCuenta || 'No registrado' %></p>
          </div>
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
            <p class="text-[10px] font-bold text-slate-400 uppercase">Titular / Identificación</p>
            <p class="text-sm font-black text-slate-900 mt-1"><%= profile.titularNombre || 'No registrado' %></p>
            <p class="text-[10px] text-slate-500 font-semibold"><%= profile.titularCedula %></p>
          </div>
        </div>

        <p class="text-[11px] text-slate-400 italic">Si necesitas actualizar tus datos bancarios, comunícate con soporte administrativo.</p>
      </div>

    </div>

    <!-- History Tables (Withdrawal Requests & Wallet Transactions) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Historial de Solicitudes de Retiro -->
      <div class="bg-white p-6 rounded-3xl border border-slate-150 shadow-sm space-y-4">
        <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left text-amber-600"></i> Historial de Solicitudes de Retiro
        </h3>

        <% if (withdrawals.length === 0) { %>
          <p class="text-xs text-slate-400 py-6 text-center">No has realizado solicitudes de retiro aún.</p>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs divide-y divide-slate-100">
              <thead class="text-[10px] text-slate-400 uppercase font-bold">
                <tr>
                  <th class="pb-2">Fecha</th>
                  <th class="pb-2">Monto</th>
                  <th class="pb-2 text-center">Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% withdrawals.forEach(function(w) { %>
                  <tr>
                    <td class="py-2.5 font-semibold text-slate-700"><%= new Date(w.createdAt).toLocaleDateString('es-EC') %></td>
                    <td class="py-2.5 font-black text-slate-900">$<%= w.monto.toFixed(2) %></td>
                    <td class="py-2.5 text-center">
                      <% if (w.estado === 'PAGADO') { %>
                        <span class="bg-emerald-100 text-emerald-800 text-[9px] font-black px-2 py-0.5 rounded-full">Pagado</span>
                      <% } else if (w.estado === 'PENDIENTE') { %>
                        <span class="bg-amber-100 text-amber-800 text-[9px] font-black px-2 py-0.5 rounded-full">En Revisión</span>
                      <% } else { %>
                        <span class="bg-rose-100 text-rose-800 text-[9px] font-black px-2 py-0.5 rounded-full">Rechazado</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Movimientos de Billetera -->
      <div class="bg-white p-6 rounded-3xl border border-slate-150 shadow-sm space-y-4">
        <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-list-numeric text-blue-600"></i> Movimientos de Billetera
        </h3>

        <% if (transactions.length === 0) { %>
          <p class="text-xs text-slate-400 py-6 text-center">No registras transacciones recientes.</p>
        <% } else { %>
          <div class="overflow-x-auto max-h-72">
            <table class="w-full text-left text-xs divide-y divide-slate-100">
              <tbody class="divide-y divide-slate-100">
                <% transactions.forEach(function(tx) { %>
                  <tr>
                    <td class="py-2.5">
                      <p class="font-bold text-slate-800"><%= tx.concepto %></p>
                      <p class="text-[9px] text-slate-400"><%= new Date(tx.createdAt).toLocaleString('es-EC') %></p>
                    </td>
                    <td class="py-2.5 text-right font-black <%= tx.monto > 0 ? 'text-emerald-600' : 'text-rose-600' %>">
                      <%= tx.monto > 0 ? '+' : '' %>$<%= tx.monto.toFixed(2) %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>

  </main>

  <!-- Modal Solicitar Retiro -->
  <div id="modalRetiro" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 relative shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-hand-holding-dollar text-amber-500"></i> Solicitar Retiro de Comisiones
        </h3>
        <button onclick="closeWithdrawalModal()" class="text-slate-400 text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form action="/dashboard/referido/retiros" method="POST" class="space-y-4 text-xs">
        <div class="bg-emerald-50 p-4 rounded-2xl border border-emerald-100 text-emerald-800">
          <p class="text-[10px] font-bold uppercase">Saldo Disponible para Retirar</p>
          <p class="text-2xl font-black">$<%= wallet.saldoDisponible.toFixed(2) %></p>
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase mb-1">Monto a Retirar ($ USD) *</label>
          <input type="number" step="0.01" max="<%= wallet.saldoDisponible %>" min="1" name="monto" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-black text-slate-900 text-base focus:outline-none focus:border-amber-500" placeholder="0.00">
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase mb-1">Observaciones (Opcional)</label>
          <textarea name="observacionesReferido" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-medium text-slate-800 focus:outline-none" placeholder="Nota adicional para contabilidad..."></textarea>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
          <button type="button" onclick="closeWithdrawalModal()" class="px-4 py-2 rounded-xl bg-slate-100 font-bold">Cancelar</button>
          <button type="submit" class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black shadow-md">Confirmar Retiro</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openWithdrawalModal() {
      document.getElementById('modalRetiro').classList.remove('hidden');
      document.getElementById('modalRetiro').classList.add('flex');
    }
    function closeWithdrawalModal() {
      document.getElementById('modalRetiro').classList.add('hidden');
      document.getElementById('modalRetiro').classList.remove('flex');
    }
  </script>

</body>
</html>
