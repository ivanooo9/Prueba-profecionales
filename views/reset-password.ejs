<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
  <%- include('partials/head') %>
</head>
<body class="h-full font-sans text-slate-800 bg-slate-50 flex flex-col min-h-screen">

  <%- include('partials/header') %>

  <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white rounded-3xl border border-slate-100 shadow-xl p-8 sm:p-10 space-y-6">
      
      <div class="text-center space-y-3">
        <div class="flex justify-center pb-2">
          <a href="/">
            <% const customLoginLogo = (typeof systemConfig !== 'undefined' && systemConfig) ? systemConfig.loginLogo : null; %>
            <% const navbarLogo = (typeof systemConfig !== 'undefined' && systemConfig) ? systemConfig.systemLogo : null; %>
            <% if (customLoginLogo) { %>
              <img src="<%= customLoginLogo %>" alt="<%= (systemConfig && systemConfig.systemName) || 'Profesionales Ecuador' %>" class="h-24 max-w-[300px] object-contain">
            <% } else if (navbarLogo) { %>
              <div class="inline-flex items-center justify-center px-5 py-3 rounded-2xl bg-slate-950 shadow-md border border-slate-800">
                <img src="<%= navbarLogo %>" alt="<%= (systemConfig && systemConfig.systemName) || 'Profesionales Ecuador' %>" class="h-16 max-w-[260px] object-contain">
              </div>
            <% } else { %>
              <span class="text-4xl font-extrabold tracking-tight text-slate-900">P<span class="text-[#0A3C84]">.</span>ec</span>
            <% } %>
          </a>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Nueva Contraseña</h1>
        <p class="text-slate-500 text-xs sm:text-sm font-medium">
          <% const emailDisplay = (typeof userEmail !== 'undefined' && userEmail) ? userEmail : ''; %>
          Ingresa tu nueva contraseña <%= emailDisplay ? 'para la cuenta de ' : '' %><% if (emailDisplay) { %><strong class="text-slate-800"><%= emailDisplay %></strong><% } %>.
        </p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-100 text-rose-800 text-xs font-semibold flex items-center gap-3">
          <i class="fa-solid fa-circle-exclamation text-rose-500 text-base"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Reset Password Form -->
      <form action="/reset-password/<%= token %>" method="POST" class="flex flex-col gap-5">
        <div class="flex flex-col gap-1.5">
          <label for="password" class="text-xs font-bold text-slate-700">Nueva Contraseña</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="password" id="password" name="password" required minlength="6" placeholder="Mínimo 6 caracteres" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3.5 pl-11 pr-10 text-sm font-semibold outline-none focus:bg-white focus:border-[#0A3C84] transition">
            <button type="button" onclick="toggleVisibility('password', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none cursor-pointer bg-transparent border-none p-0 leading-none">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="confirmPassword" class="text-xs font-bold text-slate-700">Confirmar Nueva Contraseña</label>
          <div class="relative">
            <i class="fa-solid fa-shield-check absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" placeholder="Repita la contraseña" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3.5 pl-11 pr-10 text-sm font-semibold outline-none focus:bg-white focus:border-[#0A3C84] transition">
            <button type="button" onclick="toggleVisibility('confirmPassword', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none cursor-pointer bg-transparent border-none p-0 leading-none">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3.5 rounded-xl transition text-sm shadow-md mt-2 cursor-pointer">
          Guardar Nueva Contraseña <i class="fa-solid fa-[#0A3C84] fa-check-circle ml-1.5"></i>
        </button>
      </form>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    function toggleVisibility(id, btn) {
      const input = document.getElementById(id);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>
</body>
</html>
