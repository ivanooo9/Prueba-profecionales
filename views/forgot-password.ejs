<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
  <%- include('partials/head') %>
</head>
<body class="h-full font-sans text-slate-800 bg-slate-50 flex flex-col min-h-screen">

  <%- include('partials/header') %>

  <main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white rounded-3xl border border-slate-100 shadow-xl p-8 sm:p-10 space-y-6">
      
      <div class="text-center space-y-3">
        <div class="flex justify-center pb-2">
          <a href="/">
            <% const customLoginLogo = (typeof systemConfig !== 'undefined' && systemConfig) ? systemConfig.loginLogo : null; %>
            <% const navbarLogo = (typeof systemConfig !== 'undefined' && systemConfig) ? systemConfig.systemLogo : null; %>
            <% if (customLoginLogo) { %>
              <img src="<%= customLoginLogo %>" alt="<%= (systemConfig && systemConfig.systemName) || 'Profesionales Ecuador' %>" class="h-24 max-w-[300px] object-contain">
            <% } else if (navbarLogo) { %>
              <div class="inline-flex items-center justify-center px-5 py-3 rounded-2xl bg-slate-950 shadow-md border border-slate-800">
                <img src="<%= navbarLogo %>" alt="<%= (systemConfig && systemConfig.systemName) || 'Profesionales Ecuador' %>" class="h-16 max-w-[260px] object-contain">
              </div>
            <% } else { %>
              <span class="text-4xl font-extrabold tracking-tight text-slate-900">P<span class="text-[#0A3C84]">.</span>ec</span>
            <% } %>
          </a>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Recuperar Contraseña</h1>
        <p class="text-slate-500 text-xs sm:text-sm font-medium">
          Ingresa tu correo electrónico registrado y te enviaremos un enlace seguro para restablecer tu clave.
        </p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-100 text-rose-800 text-xs font-semibold flex items-center gap-3">
          <i class="fa-solid fa-circle-exclamation text-rose-500 text-base"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-800 text-xs font-semibold flex items-center gap-3">
          <i class="fa-solid fa-circle-check text-emerald-500 text-base"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <!-- Forgot Password Form -->
      <form action="/forgot-password" method="POST" class="flex flex-col gap-5">
        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-xs font-bold text-slate-700">Correo Electrónico</label>
          <div class="relative">
            <i class="fa-solid fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="email" id="email" name="email" required placeholder="correo@ejemplo.com" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3.5 pl-11 pr-4 text-sm font-semibold outline-none focus:bg-white focus:border-[#0A3C84] transition">
          </div>
        </div>

        <button type="submit" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3.5 rounded-xl transition text-sm shadow-md mt-2 cursor-pointer">
          Enviar Enlace de Recuperación <i class="fa-solid fa-paper-plane ml-1.5"></i>
        </button>

        <div class="text-center text-xs font-semibold">
          <a href="/login" class="text-[#0A3C84] hover:text-[#082C62] flex items-center justify-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Volver a Iniciar Sesión
          </a>
        </div>
      </form>

    </div>
  </main>

  <%- include('partials/footer') %>

</body>
</html>
