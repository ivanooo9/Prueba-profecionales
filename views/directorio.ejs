<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bgLight flex flex-col min-h-screen text-slate-800 antialiased font-sans">

  <div id="directory-loading" class="fixed inset-0 z-50 hidden items-center justify-center bg-brand-bgLight/85 backdrop-blur-sm">
    <div class="rounded-3xl border border-white/70 bg-white shadow-2xl px-6 py-5 flex items-center gap-4">
      <div class="h-10 w-10 rounded-full border-4 border-slate-200 border-t-brand-blue animate-spin"></div>
      <div>
        <p class="text-sm font-extrabold text-slate-900">Buscando profesionales</p>
        <p class="text-[11px] font-semibold text-slate-500">Cargando resultados...</p>
      </div>
    </div>
  </div>

  <%- include('partials/header') %>

  <main class="flex-grow max-w-7xl mx-auto w-full px-6 md:px-12 py-16 flex flex-col gap-10">
    <div class="flex flex-col items-center text-center gap-2 mb-2" data-reveal="fade-up">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight text-slate-900 leading-none">
        Todos los <span class="text-brand-blue">Profesionales</span>
      </h1>
      <p class="text-brand-grayText text-sm max-w-xl leading-relaxed">
        Explora nuestra red completa de profesionales verificados. Busca arriba y abre filtros cuando necesites afinar resultados.
      </p>
    </div>

    <form action="/directorio" method="GET" id="filter-form" class="bg-white p-5 md:p-6 rounded-3xl border border-slate-100 shadow-sm" data-reveal="fade-up" data-reveal-delay="100">
      <div class="flex flex-col gap-4">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto_auto] gap-3 items-end">
          <div class="relative w-full">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input
              type="text"
              name="search"
              value="<%= query.search || '' %>"
              placeholder="Buscar por nombre, profesión o especialidad..."
              class="w-full bg-slate-50 border border-slate-100 rounded-2xl py-3.5 pl-11 pr-4 text-sm outline-none focus:bg-white focus:border-brand-blue transition"
            >
          </div>

          <button type="submit" class="inline-flex items-center justify-center gap-2 bg-[#053E8C] hover:bg-[#032A60] text-white font-bold px-5 py-3 rounded-2xl transition text-sm whitespace-nowrap">
            <i class="fa-solid fa-magnifying-glass"></i> Buscar
          </button>

          <a href="/directorio" class="inline-flex items-center justify-center gap-2 border border-[#0A3C84] hover:bg-slate-50 text-[#0A3C84] hover:text-[#082C62] font-bold px-5 py-3 rounded-2xl transition text-sm whitespace-nowrap">
            <i class="fa-solid fa-trash-can"></i> Limpiar
          </a>
        </div>

        <details class="group rounded-2xl border border-slate-100 bg-slate-50/70">
          <summary class="list-none cursor-pointer px-4 py-3 flex items-center justify-between gap-3">
            <div>
              <p class="text-sm font-black text-slate-900">Filtros y orden</p>
              <p class="text-[11px] font-semibold text-slate-500">Profesión, especialidad, ubicación y prioridad</p>
            </div>
            <span class="h-9 w-9 rounded-full bg-white border border-slate-100 flex items-center justify-center text-slate-500 transition group-open:rotate-180">
              <i class="fa-solid fa-chevron-down text-xs"></i>
            </span>
          </summary>

          <div class="px-4 pb-4 pt-1 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-3">
            <div class="flex flex-col gap-1.5">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Profesión</span>
              <select name="profession" class="w-full bg-white border border-slate-100 rounded-2xl py-3 px-4 text-sm outline-none focus:border-brand-blue transition font-semibold text-slate-700">
                <option value="">Todas</option>
                <% if (typeof professions !== 'undefined' && professions.length > 0) { %>
                  <% professions.forEach(function(p) { %>
                    <option value="<%= p.nombre %>" <%= query.profession === p.nombre ? 'selected' : '' %>><%= p.nombre %></option>
                  <% }); %>
                <% } else { %>
                  <option value="Tecnología e Ingeniería">Tecnología e Ingeniería</option>
                  <option value="Salud y Medicina">Salud y Medicina</option>
                  <option value="Derecho y Leyes">Derecho y Leyes</option>
                  <option value="Oficios y Servicios Técnicos">Oficios y Servicios Técnicos</option>
                <% } %>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Especialidad</span>
              <select name="specialty" <%= !query.profession ? 'disabled' : '' %> class="w-full bg-white border border-slate-100 rounded-2xl py-3 px-4 text-sm outline-none focus:border-brand-blue transition font-semibold text-slate-700 disabled:opacity-60 disabled:cursor-not-allowed">
                <% if (!query.profession) { %>
                  <option value="">Primero profesión</option>
                <% } else { %>
                  <option value="">Todas</option>
                  <% if (typeof specialties !== 'undefined' && specialties.length > 0) { %>
                    <% specialties.forEach(function(s) { %>
                      <option value="<%= s.nombre %>" <%= query.specialty === s.nombre ? 'selected' : '' %>><%= s.nombre %></option>
                    <% }); %>
                  <% } %>
                <% } %>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Provincia</span>
              <select name="provincia" class="w-full bg-white border border-slate-100 rounded-2xl py-3 px-4 text-sm outline-none focus:border-brand-blue transition font-semibold text-slate-700">
                <option value="">Todas</option>
                <% if (typeof provinces !== 'undefined' && provinces.length > 0) { %>
                  <% provinces.forEach(function(p) { %>
                    <option value="<%= p %>" <%= query.provincia === p ? 'selected' : '' %>><%= p %></option>
                  <% }); %>
                <% } else { %>
                  <option value="Loja">Loja</option>
                  <option value="Pichincha">Pichincha</option>
                  <option value="Guayas">Guayas</option>
                <% } %>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Ciudad</span>
              <select name="ciudad" class="w-full bg-white border border-slate-100 rounded-2xl py-3 px-4 text-sm outline-none focus:border-brand-blue transition font-semibold text-slate-700">
                <option value="">Todas</option>
                <% if (typeof cities !== 'undefined' && cities.length > 0) { %>
                  <% cities.forEach(function(c) { %>
                    <option value="<%= c %>" <%= query.ciudad === c ? 'selected' : '' %>><%= c %></option>
                  <% }); %>
                <% } else { %>
                  <option value="Loja">Loja</option>
                  <option value="Quito">Quito</option>
                  <option value="Guayaquil">Guayaquil</option>
                <% } %>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Ordenar</span>
              <select name="sort" class="w-full bg-white border border-slate-100 rounded-2xl py-3 px-4 text-sm outline-none focus:border-brand-blue transition text-slate-700 font-medium">
                <option value="destacados" <%= query.sort === 'destacados' ? 'selected' : '' %>>Destacados primero</option>
                <option value="precio_asc" <%= query.sort === 'precio_asc' ? 'selected' : '' %>>Precio menor</option>
                <option value="precio_desc" <%= query.sort === 'precio_desc' ? 'selected' : '' %>>Precio mayor</option>
              </select>
            </div>
          </div>
        </details>
      </div>
    </form>

    <div class="text-xs font-bold text-slate-400">
      <% if (profiles && profiles.length > 0) { %>
        <%= profiles.length %> <%= profiles.length === 1 ? 'profesional encontrado' : 'profesionales encontrados' %>
      <% } else { %>
        0 profesionales encontrados
      <% } %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-stagger="true" data-stagger-step="80">
      <% if (profiles && profiles.length > 0) { %>
        <% profiles.forEach(function(p) { %>
          <%
            const firstSpecLink = (p.specialties && p.specialties.length > 0) ? p.specialties[0] : null;
            const firstSpec = firstSpecLink ? firstSpecLink.specialty : null;
            const professionName = firstSpec && firstSpec.profession ? firstSpec.profession.nombre : '';
            const specialtyName = firstSpec ? firstSpec.nombre : '';
            const cardLabel = [professionName, specialtyName].filter(Boolean).join(' · ') || 'Servicios Generales';
            const hasFeaturedBadge = p.verified && p.subscriptionEnds && new Date(p.subscriptionEnds) > new Date();
          %>
          <a href="<%= p.slug ? '/directorio/' + p.slug : '#' %>" class="bg-white rounded-3xl border border-slate-100 overflow-hidden shadow-sm flex flex-col relative group cursor-pointer block premium-card-hover" data-reveal="fade-up">
            <div class="relative h-80 overflow-hidden bg-slate-100">
              <img src="<%= p.photo || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(p.user ? p.user.name : 'Profesional') + '&background=0A3C84&color=ffffff&size=500&font-size=0.38&bold=true') %>" alt="<%= p.user ? p.user.name : 'Profesional' %>" class="w-full h-full object-cover transition duration-300 group-hover:scale-105">

              <% if (hasFeaturedBadge) { %>
                <div class="absolute top-4 right-4 bg-white text-slate-800 px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-md border border-slate-100/50">
                  <i class="fa-solid fa-medal text-amber-500 text-xs"></i>
                  <span class="text-[10px] font-extrabold tracking-wide uppercase">Destacado</span>
                </div>
              <% } %>
            </div>

            <div class="p-5 flex flex-col flex-grow">
              <h3 class="font-extrabold text-base text-slate-900 group-hover:text-brand-blue transition mb-0.5 leading-snug">
                <%= p.user.name %>
              </h3>

              <span class="text-xs font-bold text-brand-blue mb-3 block">
                <%= cardLabel %>
              </span>

              <div class="border-t border-b border-slate-50 py-2.5 flex items-center justify-between mb-4">
                <div class="flex items-center gap-1.5 text-slate-400 text-xs font-medium">
                  <i class="fa-solid fa-location-dot text-slate-400"></i>
                  <span><%= p.ciudad %>, <%= p.provincia %></span>
                </div>
              </div>

              <div class="flex items-center justify-between mt-auto">
                <div class="flex flex-col">
                  <span class="text-[#053E8C] font-black text-xl leading-none">
                    $<%= p.tarifa ? p.tarifa.toFixed(2) : '0.00' %>
                  </span>
                  <span class="text-slate-400 text-[10px] font-bold mt-1">/ consulta</span>
                </div>
                <% if (p.slug) { %>
                  <div class="bg-[#053E8C] group-hover:bg-[#032A60] text-white font-bold py-2.5 px-4 rounded-xl transition text-xs flex items-center gap-1">
                    Ver Perfil <i class="fa-solid fa-arrow-right"></i>
                  </div>
                <% } else { %>
                  <span class="bg-slate-200 text-slate-500 font-bold py-2.5 px-4 rounded-xl text-xs flex items-center gap-1 cursor-not-allowed">
                    Perfil no disponible
                  </span>
                <% } %>
              </div>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <div class="col-span-full py-16 px-4 bg-white rounded-3xl border border-slate-100 flex flex-col items-center justify-center text-center shadow-sm">
          <div class="w-16 h-16 bg-slate-50 text-slate-400 rounded-full flex items-center justify-center mb-4 text-2xl">
            <i class="fa-solid fa-users-slash"></i>
          </div>
          <h3 class="font-extrabold text-slate-900 text-lg mb-1">No hay profesionales en esta categoría</h3>
          <p class="text-slate-500 text-xs max-w-sm">Prueba ajustando los filtros o limpiando la búsqueda para encontrar lo que necesitas.</p>
          <a href="/directorio" class="mt-6 inline-flex items-center gap-2 bg-[#053E8C] hover:bg-[#032A60] text-white font-bold py-2.5 px-6 rounded-xl transition text-xs">
            <i class="fa-solid fa-trash-can"></i> Limpiar filtros
          </a>
        </div>
      <% } %>
    </div>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <div class="flex items-center justify-center gap-2 mt-12 font-bold text-xs">
        <% if (currentPage > 1) { %>
          <a href="/directorio?<%= new URLSearchParams({...query, page: currentPage - 1}).toString() %>" class="w-10 h-10 rounded-xl bg-white border border-slate-150 flex items-center justify-center text-slate-700 hover:border-brand-blue hover:text-brand-blue transition">
            <i class="fa-solid fa-chevron-left"></i>
          </a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/directorio?<%= new URLSearchParams({...query, page: i}).toString() %>" class="w-10 h-10 rounded-xl flex items-center justify-center transition border <%= i === currentPage ? 'bg-[#053E8C] border-[#053E8C] text-white' : 'bg-white border-slate-150 text-slate-700 hover:border-brand-blue hover:text-brand-blue' %>">
            <%= i %>
          </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="/directorio?<%= new URLSearchParams({...query, page: currentPage + 1}).toString() %>" class="w-10 h-10 rounded-xl bg-white border border-slate-150 flex items-center justify-center text-slate-700 hover:border-brand-blue hover:text-brand-blue transition">
            <i class="fa-solid fa-chevron-right"></i>
          </a>
        <% } %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>

  <script>
    (function () {
      var form = document.getElementById('filter-form');
      var overlay = document.getElementById('directory-loading');

      if (!form || !overlay) return;

      function showLoading() {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
      }

      function hideLoading() {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      }

      form.addEventListener('submit', showLoading);
      window.addEventListener('pageshow', hideLoading);
    })();
  </script>
</body>
</html>
