  <script>
    function showRegistrationSuccess(options) {
      options = options || {};
      var overlay = document.getElementById('registration-success-overlay');
      var subtitleEl = document.getElementById('registration-success-subtitle');
      var redirectUrl = options.redirectUrl || null;
      var onComplete = typeof options.onComplete === 'function' ? options.onComplete : null;

      if (!overlay) {
        if (onComplete) onComplete();
        else if (redirectUrl) window.location.href = redirectUrl;
        return;
      }

      if (subtitleEl && options.subtitle) subtitleEl.textContent = options.subtitle;

      overlay.classList.remove('hidden', 'is-leaving');
      void overlay.offsetWidth;
      overlay.classList.add('is-visible');
      document.body.classList.add('overflow-hidden');

      var PHASE1_MS = 2100;
      var FADE_MS = 320;
      var SAFETY_MS = 3500;

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var done = false;
      var phase1Timer = null;
      var safetyTimer = null;

      function finish() {
        if (done) return;
        done = true;
        clearTimeout(phase1Timer);
        clearTimeout(safetyTimer);
        overlay.removeEventListener('animationend', onFadeEnd);
        document.body.classList.remove('overflow-hidden');
        if (onComplete) onComplete();
        else if (redirectUrl) window.location.href = redirectUrl;
      }

      function onFadeEnd(e) {
        if (e && e.animationName && e.animationName !== 'rs-overlay-out') return;
        finish();
      }

      phase1Timer = setTimeout(function() {
        if (done) return;
        if (reduceMotion) {
          finish();
          return;
        }
        overlay.classList.add('is-leaving');
        overlay.addEventListener('animationend', onFadeEnd);
      }, PHASE1_MS);

      safetyTimer = setTimeout(finish, SAFETY_MS);

      window.addEventListener('pagehide', function() {
        clearTimeout(phase1Timer);
        clearTimeout(safetyTimer);
        overlay.removeEventListener('animationend', onFadeEnd);
      });
      window.addEventListener('beforeunload', function() {
        clearTimeout(phase1Timer);
        clearTimeout(safetyTimer);
        overlay.removeEventListener('animationend', onFadeEnd);
      });
    }

    function showLoadingOverlay() {
      var overlay = document.getElementById('registration-loading-overlay');
      if (!overlay) return;
      overlay.classList.remove('hidden', 'is-leaving');
      void overlay.offsetWidth;
      overlay.classList.add('is-visible');
      document.body.classList.add('overflow-hidden');
    }

    function hideLoadingOverlay(onAfterFade) {
      var overlay = document.getElementById('registration-loading-overlay');
      if (!overlay) { if (typeof onAfterFade === 'function') onAfterFade(); return; }
      if (overlay.classList.contains('hidden')) { if (typeof onAfterFade === 'function') onAfterFade(); return; }
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var leavingMs = reduceMotion ? 0 : 320;
      var done = false;
      function finish() {
        if (done) return;
        done = true;
        overlay.classList.remove('is-visible');
        overlay.classList.add('hidden');
        overlay.classList.remove('is-leaving');
        document.body.classList.remove('overflow-hidden');
        if (typeof onAfterFade === 'function') onAfterFade();
      }
      overlay.classList.add('is-leaving');
      if (leavingMs === 0) {
        finish();
        return;
      }
      setTimeout(finish, leavingMs);
    }
  </script>
</body>
</html>
