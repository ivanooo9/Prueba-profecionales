<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bgLight flex flex-col min-h-screen text-slate-800 antialiased font-sans">
  
  <!-- Header / Navbar -->
  <%- include('partials/header') %>

  <!-- CMS Main Content Container -->
  <main class="flex-grow max-w-4xl mx-auto w-full px-6 md:px-12 py-16 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="text-[10px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
      <a href="/" class="hover:text-brand-blue transition">Inicio</a>
      <i class="fa-solid fa-chevron-right text-[8px]"></i>
      <span class="text-slate-500"><%= page.titulo %></span>
    </nav>

    <!-- Page Title Header -->
    <div class="border-b border-slate-100 pb-6 text-left">
      <h1 class="text-3xl md:text-4xl font-black tracking-tight text-slate-900 leading-tight">
        <%= page.titulo %>
      </h1>
      <p class="text-[10px] text-slate-400 font-bold tracking-wider mt-2 uppercase">
        Última actualización: <%= page.updatedAt.toDateString() %>
      </p>
    </div>

    <!-- HTML Content Body -->
    <article class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-xs md:text-sm text-left">
      <%- page.contenido %>
    </article>
  </main>

  <!-- Footer -->
  <%- include('partials/footer') %>
</body>
</html>
