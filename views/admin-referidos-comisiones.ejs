<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configuración de Comisiones - Referidos | Profesionales Ecuador</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="h-full flex flex-col bg-slate-50 text-slate-800">

  <!-- Top Admin Bar -->
  <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/dashboard/admin" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center font-black text-white text-sm">ADMIN</div>
          <span class="font-extrabold text-base tracking-tight text-white hidden sm:inline">Profesionales<span class="text-sky-400">Ecuador</span></span>
        </a>
        <span class="bg-sky-500/20 text-sky-300 text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full border border-sky-500/30">Módulo Referidos</span>
      </div>

      <nav class="hidden md:flex items-center gap-1">
        <a href="/dashboard/admin/referidos" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/60 transition flex items-center gap-2">
          <i class="fa-solid fa-users-gear text-blue-400"></i> Cuentas Referidos
        </a>
        <a href="/dashboard/admin/referidos/ventas" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/60 transition flex items-center gap-2">
          <i class="fa-solid fa-file-circle-check text-emerald-400"></i> Revisar Ventas
        </a>
        <a href="/dashboard/admin/referidos/comisiones" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white bg-slate-800 border border-slate-700 flex items-center gap-2">
          <i class="fa-solid fa-percent text-sky-400"></i> Reglas Comisiones
        </a>
        <a href="/dashboard/admin/referidos/retiros" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/60 transition flex items-center gap-2">
          <i class="fa-solid fa-money-bill-transfer text-amber-400"></i> Retiros
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/dashboard/admin" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition flex items-center gap-1.5">
          <i class="fa-solid fa-arrow-left"></i> Volver a Admin
        </a>
      </div>
    </div>
  </header>

  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-3xl border border-slate-150 shadow-sm space-y-3">
      <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
        <i class="fa-solid fa-percent text-sky-600"></i> Configuración de Reglas de Comisiones
      </h1>
      <p class="text-xs text-slate-500">Configura el porcentaje general de comisión y define porcentajes específicos para promociones o productos individuales.</p>
    </div>

    <!-- Priority Rule Card -->
    <div class="bg-gradient-to-r from-blue-900 via-slate-900 to-slate-900 text-white p-6 rounded-3xl border border-blue-800/50 shadow-xl space-y-3">
      <div class="flex items-center gap-2 text-sky-400 text-xs font-black uppercase tracking-wider">
        <i class="fa-solid fa-shield-halved text-base"></i> Regla de Prioridad de Comisiones
      </div>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        El motor de liquidación de comisiones evalúa siempre en el siguiente orden de prioridad:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-2">
        <div class="bg-slate-800/80 p-3.5 rounded-2xl border border-slate-700/80">
          <span class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 font-black inline-flex items-center justify-center text-xs mb-2">1</span>
          <p class="font-extrabold text-white">Comisión Específica de Producto</p>
          <p class="text-[11px] text-slate-400">Si existe para el producto X (ej. 50%), se aplica esta obligatoriamente.</p>
        </div>
        <div class="bg-slate-800/80 p-3.5 rounded-2xl border border-slate-700/80">
          <span class="w-6 h-6 rounded-full bg-sky-500/20 text-sky-400 font-black inline-flex items-center justify-center text-xs mb-2">2</span>
          <p class="font-extrabold text-white">Comisión por Tipo de Producto</p>
          <p class="text-[11px] text-slate-400">Si existe para la categoría (ej. Conversatorios 40%), se aplica a esa categoría.</p>
        </div>
        <div class="bg-slate-800/80 p-3.5 rounded-2xl border border-slate-700/80">
          <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 font-black inline-flex items-center justify-center text-xs mb-2">3</span>
          <p class="font-extrabold text-white">Comisión General Base</p>
          <p class="text-[11px] text-slate-400">Si no hay regla específica, se aplica el % general (ej. 30%).</p>
        </div>
      </div>
    </div>

    <!-- Feedback Alerts -->
    <% if (success === 'general_updated') { %>
      <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 text-xs font-semibold flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-lg text-emerald-600"></i>
        <span>Comisión general actualizada exitosamente.</span>
      </div>
    <% } %>
    <% if (success === 'specific_updated') { %>
      <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 text-xs font-semibold flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-lg text-emerald-600"></i>
        <span>Regla de comisión específica guardada exitosamente.</span>
      </div>
    <% } %>

    <!-- Settings Forms Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Form: Comisión General -->
      <div class="bg-white p-6 rounded-3xl border border-slate-150 shadow-sm space-y-4">
        <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-sliders text-amber-500"></i> Comisión General Base
        </h3>
        <p class="text-xs text-slate-500">Porcentaje que se aplicará a todos los productos que no tengan una regla específica activa.</p>

        <form action="/dashboard/admin/referidos/comisiones/general" method="POST" class="space-y-4 text-xs">
          <div>
            <label class="block font-bold text-slate-700 uppercase mb-1">Porcentaje General (% USD) *</label>
            <input type="number" step="0.5" min="0" max="100" name="porcentaje" value="<%= generalConfig ? generalConfig.porcentaje : 30 %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-black text-slate-900 text-lg focus:outline-none focus:border-amber-500" placeholder="30">
          </div>

          <button type="submit" class="w-full py-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black shadow-md transition">
            Guardar Comisión General
          </button>
        </form>
      </div>

      <!-- Form: Comisión Específica -->
      <div class="lg:col-span-2 bg-white p-6 rounded-3xl border border-slate-150 shadow-sm space-y-4">
        <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-plus-circle text-blue-600"></i> Asignar Comisión Específica por Producto o Categoría
        </h3>
        <p class="text-xs text-slate-500">Sobrescribe el porcentaje general para un conversatorio, curso o plan específico.</p>

        <form action="/dashboard/admin/referidos/comisiones/especifica" method="POST" class="space-y-4 text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold text-slate-700 uppercase mb-1">Tipo de Producto *</label>
              <select name="productType" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-bold text-slate-900 focus:outline-none">
                <option value="CONVERSATORIO">Conversatorios</option>
                <option value="CURSO">Cursos</option>
                <option value="PLAN_AFILIACION">Planes de Afiliación</option>
                <option value="PLAN_PROMOCION">Planes de Promoción</option>
              </select>
            </div>
            <div>
              <label class="block font-bold text-slate-700 uppercase mb-1">ID del Producto (Opcional - Vacío para Toda la Categoría)</label>
              <input type="number" name="productId" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-medium text-slate-900 focus:outline-none" placeholder="Ej. 12 (Dejar vacío para toda la categoría)">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block font-bold text-slate-700 uppercase mb-1">Porcentaje Específico (% USD) *</label>
              <input type="number" step="0.5" min="0" max="100" name="porcentaje" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-black text-emerald-600 text-sm focus:outline-none" placeholder="50">
            </div>
            <div>
              <label class="block font-bold text-slate-700 uppercase mb-1">Fecha de Inicio (Opcional)</label>
              <input type="date" name="startDate" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-medium text-slate-900 focus:outline-none">
            </div>
            <div>
              <label class="block font-bold text-slate-700 uppercase mb-1">Fecha de Fin (Opcional)</label>
              <input type="date" name="endDate" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-medium text-slate-900 focus:outline-none">
            </div>
          </div>

          <div class="flex justify-end pt-2">
            <button type="submit" class="px-6 py-3 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-extrabold shadow-md transition">
              Guardar Regla Específica
            </button>
          </div>
        </form>
      </div>

    </div>

    <!-- Active Configurations Table -->
    <div class="bg-white rounded-3xl border border-slate-150 shadow-sm overflow-hidden p-6 space-y-4">
      <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
        <i class="fa-solid fa-list text-slate-600"></i> Tabla de Reglas de Comisión Registradas
      </h3>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs divide-y divide-slate-100">
          <thead class="bg-slate-50 text-slate-400 uppercase text-[10px] tracking-wider font-bold">
            <tr>
              <th class="p-3">Tipo de Regla</th>
              <th class="p-3">Producto / Categoría</th>
              <th class="p-3">Porcentaje (% USD)</th>
              <th class="p-3">Vigencia</th>
              <th class="p-3 text-center">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% configs.forEach(function(c) { %>
              <tr class="hover:bg-slate-50/60 transition">
                <td class="p-3 font-bold">
                  <% if (c.isGeneral) { %>
                    <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-1 rounded-full">General Base</span>
                  <% } else if (c.productId) { %>
                    <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-1 rounded-full">Producto Específico</span>
                  <% } else { %>
                    <span class="bg-sky-100 text-sky-800 text-[10px] font-black px-2.5 py-1 rounded-full">Categoría</span>
                  <% } %>
                </td>
                <td class="p-3 font-extrabold text-slate-900">
                  <%= c.isGeneral ? 'Todos los Productos' : (c.productType + (c.productId ? (' (ID: ' + c.productId + ')') : '')) %>
                </td>
                <td class="p-3 font-black text-emerald-600 text-sm"><%= c.porcentaje %>%</td>
                <td class="p-3 text-slate-500 font-medium">
                  <%= (c.startDate || c.endDate) ? ((c.startDate ? new Date(c.startDate).toLocaleDateString('es-EC') : 'Inicio') + ' a ' + (c.endDate ? new Date(c.endDate).toLocaleDateString('es-EC') : 'Indefinido')) : 'Permanente' %>
                </td>
                <td class="p-3 text-center">
                  <span class="bg-emerald-100 text-emerald-800 text-[9px] font-black px-2 py-0.5 rounded-full">Activa</span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

</body>
</html>
