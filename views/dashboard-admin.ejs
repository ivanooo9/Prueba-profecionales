    document.getElementById('certificate-design-form').addEventListener('submit', function(e) {
      document.getElementById('cert-firmas-json').value = JSON.stringify(signaturesList);
      document.getElementById('cert-avales-json').value = JSON.stringify(avalesList);
    });

    // Manual Enrollment Functions
    function openDirectManualEnrollment(type, id) {
      document.getElementById('manual-enrollment-email').value = '';
      document.getElementById('manual-enrollment-type').value = type;
      document.getElementById('manual-enrollment-event-id').value = id;
      document.getElementById('manual-enrollment-error').classList.add('hidden');
      document.getElementById('manual-enrollment-success-card').classList.add('hidden');
