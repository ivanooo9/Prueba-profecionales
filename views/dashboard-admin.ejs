                    <div class="flex items-center gap-1">
                      <button type="button" onclick="editCursoBranch(${b.id}, ${cat.id}, '${b.nombre.replace(/'/g, "\\'")}', '${(b.descripcion || '').replace(/'/g, "\\'")}')" class="text-slate-400 hover:text-[#0A3C84] p-1 text-[11px]" title="Editar Rama"><i class="fa-solid fa-pen"></i></button>
                      <button type="button" onclick="deleteCursoBranch(${b.id})" class="text-slate-400 hover:text-rose-600 p-1 text-[11px]" title="Eliminar Rama"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        });

        container.innerHTML = html;
      }

      function onAdminProfFilterChange(profId) {
        currentAdminProfFilter = profId || "";
        const filterSelect = document.getElementById('admin-category-prof-filter');
        if (filterSelect) filterSelect.value = currentAdminProfFilter;
        populateBranchCategoryOptions();
        renderCursoCategoriesTree();
      }

      async function handleSaveCursoCategory(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);

        const payload = {
          id: formData.get('id'),
          nombre: formData.get('nombre'),
          descripcion: formData.get('descripcion'),
          professionId: formData.get('professionId')
        };

        try {
          const res = await fetch('/api/admin/curso-categories', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
            resetCursoCategoryForm();
            adminCursoCategoriesData = data.categories || [];
            populateBranchCategoryOptions();
            renderCursoCategoriesTree();
          } else {
            alert(data.error || 'Error al guardar la categoría.');
          }
        } catch (err) {
          console.error('Error saving category:', err);
          alert('Error al guardar la categoría.');
        }
      }

      async function handleSaveCursoBranch(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);

        const payload = {
          id: formData.get('id'),
          categoryId: formData.get('categoryId'),
          nombre: formData.get('nombre'),
          descripcion: formData.get('descripcion')
        };

        try {
          const res = await fetch('/api/admin/curso-branches', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
            resetCursoBranchForm();
            adminCursoCategoriesData = data.categories || [];
            populateBranchCategoryOptions();
            renderCursoCategoriesTree();
          } else {
            alert(data.error || 'Error al guardar la rama.');
          }
        } catch (err) {
          console.error('Error saving branch:', err);
          alert('Error al guardar la rama.');
        }
      }

      function editCursoCategory(id, nombre, descripcion, professionId) {
        document.getElementById('curso-cat-id').value = id;
        document.getElementById('curso-cat-nombre').value = nombre;
        document.getElementById('curso-cat-descripcion').value = descripcion || '';
        document.getElementById('curso-cat-professionId').value = professionId || '';
        document.getElementById('curso-category-form-title').innerText = 'Editar Categoría';
        document.getElementById('curso-category-cancel-btn').classList.remove('hidden');
      }

      function resetCursoCategoryForm() {
        document.getElementById('curso-category-form').reset();
        document.getElementById('curso-cat-id').value = '';
        document.getElementById('curso-category-form-title').innerText = 'Crear Nueva Categoría';
        document.getElementById('curso-category-cancel-btn').classList.add('hidden');
      }

      function editCursoBranch(id, categoryId, nombre, descripcion) {
        document.getElementById('curso-branch-id').value = id;
        document.getElementById('curso-branch-categoryId').value = categoryId;
        document.getElementById('curso-branch-nombre').value = nombre;
        document.getElementById('curso-branch-descripcion').value = descripcion || '';
        document.getElementById('curso-branch-form-title').innerText = 'Editar Rama de Enseñanza';
        document.getElementById('curso-branch-cancel-btn').classList.remove('hidden');
      }

      function quickAddBranch(categoryId) {
        resetCursoBranchForm();
        document.getElementById('curso-branch-categoryId').value = categoryId;
        document.getElementById('curso-branch-nombre').focus();
      }

      function resetCursoBranchForm() {
        document.getElementById('curso-branch-form').reset();
        document.getElementById('curso-branch-id').value = '';
        document.getElementById('curso-branch-form-title').innerText = 'Crear Rama de Enseñanza';
        document.getElementById('curso-branch-cancel-btn').classList.add('hidden');
      }

      async function deleteCursoCategory(id) {
        if (!confirm('¿Está seguro de eliminar esta categoría? Se eliminarán también sus ramas asociadas.')) return;
        try {
          const res = await fetch('/api/admin/curso-categories/' + id, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            adminCursoCategoriesData = data.categories || [];
            populateBranchCategoryOptions();
            renderCursoCategoriesTree();
          } else {
            alert(data.error || 'Error al eliminar la categoría.');
          }
        } catch (err) {
          console.error('Error deleting category:', err);
        }
      }

      async function deleteCursoBranch(id) {
        if (!confirm('¿Está seguro de eliminar esta rama de enseñanza?')) return;
        try {
          const res = await fetch('/api/admin/curso-branches/' + id, { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            adminCursoCategoriesData = data.categories || [];
            populateBranchCategoryOptions();
            renderCursoCategoriesTree();
          } else {
            alert(data.error || 'Error al eliminar la rama.');
          }
        } catch (err) {
          console.error('Error deleting branch:', err);
        }
      }

      async function fetchAdminCategoriesIfNeeded() {
        if (adminCursoCategoriesData && adminCursoCategoriesData.length > 0) {
          return adminCursoCategoriesData;
        }
        try {
          const res = await fetch('/api/admin/curso-categories');
          const data = await res.json();
          if (data.success) {
            adminCursoCategoriesData = data.categories || [];
            adminProfessionsData = data.professions || [];
            return adminCursoCategoriesData;
          }
        } catch (err) {
          console.error('Error fetching admin curso categories:', err);
        }
        return [];
      }

      async function populateAdminCourseCategories(profId, selectedCatId) {
        const catSelect = document.getElementById('curso-categoryId');
        if (!catSelect) return;
        
        const categoriesData = await fetchAdminCategoriesIfNeeded();
        let html = '<option value="">Seleccione categoría...</option>';

        let filtered = categoriesData;
        if (profId) {
          filtered = categoriesData.filter(c => !c.professionId || String(c.professionId) === String(profId));
        }

        filtered.forEach(c => {
          const isSel = (selectedCatId && String(selectedCatId) === String(c.id)) ? 'selected' : '';
          html += `<option value="${c.id}" ${isSel}>${c.nombre}</option>`;
        });

        catSelect.innerHTML = html;
        if (selectedCatId) {
          catSelect.value = selectedCatId;
        }

        await populateAdminCourseBranches(catSelect.value, null);
      }

      async function populateAdminCourseBranches(catId, selectedBranchId) {
        const branchSelect = document.getElementById('curso-branchId');
        if (!branchSelect) return;
        
        const categoriesData = await fetchAdminCategoriesIfNeeded();
        let html = '<option value="">Seleccione rama...</option>';

        let branches = [];
        const catObj = categoriesData.find(c => String(c.id) === String(catId));
        if (catObj && catObj.branches) {
          branches = catObj.branches;
        }

        branches.forEach(b => {
          const isSel = (selectedBranchId && String(selectedBranchId) === String(b.id)) ? 'selected' : '';
          html += `<option value="${b.id}" ${isSel}>${b.nombre}</option>`;
        });

        branchSelect.innerHTML = html;
        if (selectedBranchId) {
          branchSelect.value = selectedBranchId;
        }
      }

      async function onAdminCourseProfChange(profId) {
        const profSelect = document.getElementById('curso-professionId');
        const areaInput = document.getElementById('curso-area');
        if (profSelect && areaInput) {
          const selectedOpt = profSelect.options[profSelect.selectedIndex];
          if (selectedOpt) {
            areaInput.value = selectedOpt.getAttribute('data-nombre') || selectedOpt.text || '';
          }
        }
        await populateAdminCourseCategories(profId, null);
      }

      async function onAdminCourseCatChange(catId) {
        await populateAdminCourseBranches(catId, null);
      }

      function editBillingPlan(id, nombre, descripcion, precio, invoiceLimit, duracionDias, duracionTipo) {
        document.getElementById('billing-plan-form-title').innerText = 'Editar Paquete de Facturación';
        document.getElementById('billing-plan-id').value = id;
        document.getElementById('billing-plan-nombre').value = nombre;
        document.getElementById('billing-plan-descripcion').value = descripcion;
        document.getElementById('billing-plan-precio').value = precio;
        document.getElementById('billing-plan-limit').value = invoiceLimit;
        document.getElementById('billing-plan-duracion').value = duracionDias;
        document.getElementById('billing-plan-duracion-tipo').value = duracionTipo;
        document.getElementById('billing-plan-submit-btn-text').innerText = 'Actualizar Paquete';
        document.getElementById('billing-plan-cancel-btn').classList.remove('hidden');
      }

      function resetBillingPlanForm() {
        document.getElementById('billing-plan-form-title').innerText = 'Crear Nuevo Paquete de Facturas';
        document.getElementById('billing-plan-id').value = '';
        document.getElementById('billing-plan-form').reset();
        document.getElementById('billing-plan-submit-btn-text').innerText = 'Guardar Paquete';
        document.getElementById('billing-plan-cancel-btn').classList.add('hidden');
      }

      function openAdminIssuerModal(profId, profName, ruc, razonSocial, nombreComercial, direccion, email, celular, est, pto, sec, regimen, contabilidad, ambiente) {
        let p = null;
        if (typeof profId === 'object') {
          p = profId;
        } else if (window.professionalsMap && window.professionalsMap[profId]) {
          p = window.professionalsMap[profId];
        } else if (Array.isArray(window.allProfessionalsList)) {
          p = window.allProfessionalsList.find(x => x && x.id == profId);
        }

        if (p) {
          const u = p.user || {};
          const iss = p.issuer || {};
          profId = p.id;
          profName = profName || u.name || p.nombre || '';
          ruc = ruc || iss.ruc || '';
          razonSocial = razonSocial || iss.razonSocial || profName;
          nombreComercial = nombreComercial || iss.nombreComercial || '';
          direccion = direccion || iss.direccionMatriz || p.direccion || '';
          email = email || iss.email || u.email || p.email || '';
          celular = celular || iss.telefono || p.telefono || '';
          est = est || iss.establecimiento || '001';
          pto = pto || iss.puntoEmision || '001';
          sec = sec || iss.secuencialFactura || '000000001';
          regimen = regimen || iss.regimen || 'REGIMEN GENERAL';
          contabilidad = contabilidad !== undefined && contabilidad !== '' ? contabilidad : (iss.obligadoContabilidad ? 'true' : 'false');
          ambiente = ambiente || iss.ambiente || '1';
        }

        document.getElementById('admin-issuer-form').action = '/dashboard/admin/professionals/' + profId + '/issuer';
        document.getElementById('admin-issuer-prof-name').innerText = profName || '';
        document.getElementById('admin-issuer-ruc').value = ruc || '';
        document.getElementById('admin-issuer-razon').value = razonSocial || profName || '';
        document.getElementById('admin-issuer-comercial').value = nombreComercial || '';
        document.getElementById('admin-issuer-direccion').value = direccion || '';
        document.getElementById('admin-issuer-email').value = email || '';
        document.getElementById('admin-issuer-celular').value = celular || '';
        document.getElementById('admin-issuer-establecimiento').value = est || '001';
        document.getElementById('admin-issuer-punto-emision').value = pto || '001';
        document.getElementById('admin-issuer-secuencial').value = sec || '000000001';
        document.getElementById('admin-issuer-regimen').value = regimen || 'REGIMEN GENERAL';
        document.getElementById('admin-issuer-contabilidad').value = contabilidad === 'true' || contabilidad === true ? 'true' : 'false';
        document.getElementById('admin-issuer-ambiente').value = ambiente || '1';
        document.getElementById('admin-issuer-firma-status').innerHTML = '';
        const modal = document.getElementById('admin-issuer-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          modal.style.display = 'flex';
        }
      }

      function closeAdminIssuerModal() {
        const modal = document.getElementById('admin-issuer-modal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          modal.style.display = 'none';
        }
      }

      function handleAdminFirmaFile(input) {
        const file = input.files[0];
        const statusDiv = document.getElementById('admin-issuer-firma-status');
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) {
          statusDiv.innerHTML = '<span class="text-xs font-bold text-rose-600">El archivo de firma debe ser menor a 5MB</span>';
          input.value = '';
          return;
        }
        statusDiv.innerHTML = '<span class="text-xs font-bold text-emerald-600">✓ Archivo ' + file.name + ' listo para subir.</span>';
      }

      window.editBillingPlan = editBillingPlan;
      window.resetBillingPlanForm = resetBillingPlanForm;
      window.openAdminIssuerModal = openAdminIssuerModal;
      window.closeAdminIssuerModal = closeAdminIssuerModal;
      window.handleAdminFirmaFile = handleAdminFirmaFile;

      window.toggleCategory = toggleCategory;
      window.openCategorySmooth = openCategorySmooth;
      window.switchTab = switchTab;
      window.loadCursoCategoriesData = loadCursoCategoriesData;
      window.onAdminProfFilterChange = onAdminProfFilterChange;
      window.handleSaveCursoCategory = handleSaveCursoCategory;
      window.handleSaveCursoBranch = handleSaveCursoBranch;
      window.editCursoCategory = editCursoCategory;
      window.resetCursoCategoryForm = resetCursoCategoryForm;
      window.editCursoBranch = editCursoBranch;
      window.quickAddBranch = quickAddBranch;
      window.resetCursoBranchForm = resetCursoBranchForm;
      window.deleteCursoCategory = deleteCursoCategory;
      window.deleteCursoBranch = deleteCursoBranch;
      window.loadPaginatedUsers = loadPaginatedUsers;
      window.toggleUserStatusAjax = toggleUserStatusAjax;
      window.onAdminCourseProfChange = onAdminCourseProfChange;
      window.onAdminCourseCatChange = onAdminCourseCatChange;
      window.populateAdminCourseCategories = populateAdminCourseCategories;
      window.populateAdminCourseBranches = populateAdminCourseBranches;
  </script>

  <!-- Modal: Configuración de Emisor SRI para Profesional por Admin -->
  <div id="admin-issuer-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[2000] items-center justify-center p-4 hidden transition-opacity duration-300" style="display: none;">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-8 space-y-5 border border-slate-100 shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div>
          <h3 class="text-lg font-black text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-file-invoice text-emerald-600"></i> Configuración de Emisor SRI
          </h3>
          <p class="text-xs font-semibold text-slate-500 mt-0.5">Profesional: <span id="admin-issuer-prof-name" class="font-extrabold text-[#0A3C84]"></span></p>
        </div>
        <button type="button" onclick="closeAdminIssuerModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center text-xs font-bold transition cursor-pointer">
          ✕
        </button>
      </div>

      <form id="admin-issuer-form" action="" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">RUC Emisor (13 dígitos) *</label>
            <input type="text" name="ruc" id="admin-issuer-ruc" required maxlength="13" placeholder="1792000000001" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Razón Social *</label>
            <input type="text" name="razonSocial" id="admin-issuer-razon" required placeholder="Nombre fiscal completo" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Nombre Comercial</label>
          <input type="text" name="nombreComercial" id="admin-issuer-comercial" placeholder="Opcional" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Dirección Matriz *</label>
          <input type="text" name="direccion" id="admin-issuer-direccion" required placeholder="Av. Amazonas N24-15 y Colón" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Email Emisor SRI *</label>
            <input type="email" name="email" id="admin-issuer-email" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Celular Contacto *</label>
            <input type="text" name="celular" id="admin-issuer-celular" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">Establecimiento</label>
            <input type="text" name="establecimiento" id="admin-issuer-establecimiento" value="001" maxlength="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 text-center outline-none">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">Punto Emisión</label>
            <input type="text" name="puntoEmision" id="admin-issuer-punto-emision" value="001" maxlength="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 text-center outline-none">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">Secuencial Inicio</label>
            <input type="text" name="startSecuencial" id="admin-issuer-secuencial" value="000000001" maxlength="9" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 text-center outline-none">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
