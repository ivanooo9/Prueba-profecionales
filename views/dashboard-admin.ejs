    // Submissions review operations
    let courseSubmissionsList = [];

    async function loadSubmissions() {
      const tbody = document.getElementById('submissions-table-body');
      tbody.innerHTML = '<tr><td colspan="5" class="px-5 py-8 text-center text-slate-400"><i class="fa-solid fa-spinner animate-spin mr-1"></i> Cargando entregas...</td></tr>';

      try {
        const res = await fetch(`/api/cursos/${currentCursoId}/submissions`);
        const data = await res.json();
        if (data.success) {
          courseSubmissionsList = data.submissions;
          renderSubmissions(data.submissions);
        } else {
          tbody.innerHTML = `<tr><td colspan="5" class="px-5 py-8 text-center text-rose-500 font-bold">${data.error || 'Error al cargar entregas'}</td></tr>`;
        }
      } catch (err) {
        console.error(err);
        tbody.innerHTML = '<tr><td colspan="5" class="px-5 py-8 text-center text-rose-500 font-bold">Error de red al cargar entregas</td></tr>';
      }
    }

    function renderSubmissions(subs) {
      const tbody = document.getElementById('submissions-table-body');
      tbody.innerHTML = '';

      if (!subs || subs.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="px-5 py-12 text-center text-slate-450 font-bold">No hay entregas registradas para este curso.</td></tr>';
        return;
      }

      subs.forEach((sub, idx) => {
        let fileBtn = `<a href="${sub.archivoUrl}" target="_blank" class="w-8 h-8 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-[#5A7AF3] flex items-center justify-center border border-indigo-100 transition mx-auto" title="Ver archivo entregado"><i class="fa-solid fa-file-arrow-down text-sm"></i></a>`;
        
        let statusBadge = '';
        if (sub.estado === 'PENDIENTE') {
          statusBadge = '<span class="bg-amber-50 text-amber-600 border border-amber-100 text-[9px] font-black px-2 py-0.5 rounded-full">PENDIENTE</span>';
        } else if (sub.estado === 'APROBADA') {
          statusBadge = '<span class="bg-emerald-50 text-emerald-600 border border-emerald-100 text-[9px] font-black px-2 py-0.5 rounded-full">APROBADA</span>';
        } else {
          statusBadge = '<span class="bg-rose-50 text-rose-600 border border-rose-100 text-[9px] font-black px-2 py-0.5 rounded-full">RECHAZADA</span>';
        }

        let gradeInfo = sub.calificacion !== null ? `<span class="block mt-1 font-bold text-slate-700">${sub.calificacion} / ${sub.task.puntos} pts</span>` : '<span class="block mt-1 text-slate-400 italic text-[10px]">Sin nota</span>';

        tbody.innerHTML += `
          <tr class="hover:bg-slate-50/50 transition">
            <td class="px-5 py-4">
              <div class="font-extrabold text-slate-900 text-xs">${sub.user.name}</div>
              <div class="text-[9px] text-slate-400 font-bold mt-0.5">${sub.user.email}</div>
            </td>
            <td class="px-5 py-4">
              <div class="font-bold text-slate-700 text-xs">${sub.task.titulo}</div>
              <div class="text-[9px] text-slate-400 mt-0.5">Clase: ${sub.task.lesson.titulo}</div>
            </td>
            <td class="px-5 py-4 text-center">
              ${fileBtn}
              <span class="text-[9px] text-slate-400 mt-1 block">${new Date(sub.fechaEntrega).toLocaleDateString()}</span>
            </td>
            <td class="px-5 py-4 text-center">
              ${statusBadge}
              ${gradeInfo}
            </td>
            <td class="px-5 py-4 text-right">
              <button onclick="openGradeModal(${idx})" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-bold text-[10px] px-3 py-1.5 rounded-lg shadow-sm transition cursor-pointer">Calificar</button>
            </td>
          </tr>
        `;
      });
    }

    function openGradeModal(idx) {
      const sub = courseSubmissionsList[idx];
      document.getElementById('grade-modal-submissionId').value = sub.id;
      document.getElementById('grade-modal-estudiante').innerText = sub.user.name;
      document.getElementById('grade-modal-tarea').innerText = sub.task.titulo;
      document.getElementById('grade-modal-puntos-max').innerText = sub.task.puntos;
      document.getElementById('grade-modal-comentario-est').innerText = sub.comentario || 'Sin comentarios adicionales por el estudiante.';
      document.getElementById('grade-modal-calificacion').value = sub.calificacion || '';
      document.getElementById('grade-modal-estado').value = sub.estado === 'PENDIENTE' ? 'APROBADA' : sub.estado;
      document.getElementById('grade-modal-feedback').value = sub.comentarioFeedback || '';
      
      document.getElementById('grade-submission-modal').classList.remove('hidden');
    }

    function closeGradeModal() {
      document.getElementById('grade-submission-modal').classList.add('hidden');
      document.getElementById('grade-modal-form').reset();
    }

    document.getElementById('grade-modal-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const submissionId = document.getElementById('grade-modal-submissionId').value;
      const calificacion = document.getElementById('grade-modal-calificacion').value;
      const estado = document.getElementById('grade-modal-estado').value;
      const comentarioFeedback = document.getElementById('grade-modal-feedback').value;

      try {
        const res = await fetch(`/api/cursos/submissions/${submissionId}/grade`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ calificacion, estado, comentarioFeedback })
        });
        const data = await res.json();
        if (data.success) {
          closeGradeModal();
          loadSubmissions();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (err) {
        console.error(err);
        alert('Error de red al calificar entrega.');
      }
    });

