    window.closeAllAdminModals = function() {
      const ids = [
        'inspector-modal',
        'change-role-modal',
        'reset-password-modal',
        'send-temp-access-modal',
        'super-admin-profile-modal',
        'modalCreateProfessionalUser',
        'admin-issuer-modal'
      ];
      ids.forEach(id => {
        const m = document.getElementById(id);
        if (m) {
          m.classList.add('hidden');
          m.classList.remove('flex');
          m.style.display = 'none';
        }
      });
    };

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        window.closeAllAdminModals();
      }
    });

    document.addEventListener('click', function(e) {
      if (e.target && e.target.classList && e.target.classList.contains('fixed') && e.target.id) {
        const modalIds = [
          'inspector-modal',
          'change-role-modal',
          'reset-password-modal',
          'send-temp-access-modal',
          'super-admin-profile-modal',
          'modalCreateProfessionalUser',
          'admin-issuer-modal'
        ];
        if (modalIds.includes(e.target.id)) {
          window.closeAllAdminModals();
        }
      }
    });

    window.openCreateProfessionalModal = function() {
      window.closeAllAdminModals();
      const modal = document.getElementById('modalCreateProfessionalUser');
      if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); modal.style.display = 'flex'; }
    };
    window.closeCreateProfessionalModal = function() {
      window.closeAllAdminModals();
    };

    window.openSendTempAccessModal = function(userId, userName, userEmail, userRole) {
      window.closeAllAdminModals();
      const modal = document.getElementById('send-temp-access-modal');
      if (modal) {
        const form = document.getElementById('send-temp-access-form');
        if (form) form.action = '/dashboard/admin/users/' + userId + '/send-temporary-access';
        const nameDiv = document.getElementById('send-temp-access-user-name');
        if (nameDiv) nameDiv.textContent = userName || '';
        const emailDiv = document.getElementById('send-temp-access-user-email');
        if (emailDiv) emailDiv.textContent = (userEmail || '') + (userRole ? ' (' + userRole + ')' : '');
        const input = document.getElementById('send-temp-access-input');
        if (input) input.value = 'TEMP-' + Math.random().toString(36).substring(2, 10).toUpperCase();

        modal.classList.remove('hidden'); modal.classList.add('flex'); modal.style.display = 'flex';
      }
    };
    window.closeSendTempAccessModal = function() {
      window.closeAllAdminModals();
    };
    window.handleOpenSendTempAccessBtn = function(btn) {
      if (!btn || !btn.dataset) return;
      window.openSendTempAccessModal(btn.dataset.userId, btn.dataset.userName, btn.dataset.userEmail, btn.dataset.userRole);
    };

    window.openResetPasswordModal = function(userId, userName, userEmail) {
      window.closeAllAdminModals();
      const modal = document.getElementById('reset-password-modal');
      if (modal) {
        const form = document.getElementById('reset-password-form');
        if (form) form.action = '/dashboard/admin/users/' + userId + '/reset-password';
        const nameDiv = document.getElementById('reset-password-user-name');
        if (nameDiv) nameDiv.textContent = userName || '';
        const emailDiv = document.getElementById('reset-password-user-email');
        if (emailDiv) emailDiv.textContent = userEmail || '';
        const input = document.getElementById('reset-password-input');
        if (input) input.value = '';

        modal.classList.remove('hidden'); modal.classList.add('flex'); modal.style.display = 'flex';
      }
    };
    window.closeResetPasswordModal = function() {
      window.closeAllAdminModals();
    };
    window.handleOpenResetPasswordBtn = function(btn) {
      if (!btn || !btn.dataset) return;
      window.openResetPasswordModal(btn.dataset.userId, btn.dataset.userName, btn.dataset.userEmail);
    };

    window.openAdminIssuerModal = function(profId, profName, ruc, razonSocial, nombreComercial, direccion, email, celular, est, pto, sec, regimen, contabilidad, ambiente) {
      window.closeAllAdminModals();
      let p = null;
      if (typeof profId === 'object') {
        p = profId;
      } else if (window.professionalsMap && window.professionalsMap[profId]) {
        p = window.professionalsMap[profId];
      } else if (Array.isArray(window.allProfessionalsList)) {
        p = window.allProfessionalsList.find(x => x && x.id == profId);
      }

      if (p) {
        const u = p.user || {};
        const iss = p.issuer || {};
        profId = p.id;
        profName = profName || u.name || p.nombre || '';
        ruc = ruc || iss.ruc || '';
        razonSocial = razonSocial || iss.razonSocial || profName;
        nombreComercial = nombreComercial || iss.nombreComercial || '';
        direccion = direccion || iss.direccionMatriz || p.direccion || '';
        email = email || iss.email || u.email || p.email || '';
        celular = celular || iss.telefono || p.telefono || '';
        est = est || iss.establecimiento || '001';
        pto = pto || iss.puntoEmision || '001';
        sec = sec || iss.secuencialFactura || '000000001';
        regimen = regimen || iss.regimen || 'REGIMEN GENERAL';
        contabilidad = contabilidad !== undefined && contabilidad !== '' ? contabilidad : (iss.obligadoContabilidad ? 'true' : 'false');
        ambiente = ambiente || iss.ambiente || '1';
      }

      const modal = document.getElementById('admin-issuer-modal');
      if (modal) {
        const form = document.getElementById('admin-issuer-form');
        if (form) form.action = '/dashboard/admin/professionals/' + profId + '/issuer';
        const nameSpan = document.getElementById('admin-issuer-prof-name');
        if (nameSpan) nameSpan.innerText = profName || '';
        
        const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = (val !== null && val !== undefined) ? val : ''; };
        setVal('admin-issuer-ruc', ruc);
        setVal('admin-issuer-razon', razonSocial || profName);
        setVal('admin-issuer-comercial', nombreComercial);
        setVal('admin-issuer-direccion', direccion);
        setVal('admin-issuer-email', email);
        setVal('admin-issuer-celular', celular);
        setVal('admin-issuer-establecimiento', est || '001');
        setVal('admin-issuer-punto-emision', pto || '001');
        setVal('admin-issuer-secuencial', sec || '000000001');
        setVal('admin-issuer-regimen', regimen || 'REGIMEN GENERAL');
        setVal('admin-issuer-contabilidad', contabilidad === 'true' || contabilidad === true ? 'true' : 'false');
        setVal('admin-issuer-ambiente', ambiente || '1');
        const statusDiv = document.getElementById('admin-issuer-firma-status');
        if (statusDiv) statusDiv.innerHTML = '';
        
        modal.classList.remove('hidden'); modal.classList.add('flex'); modal.style.display = 'flex';
      }
    };
    window.closeAdminIssuerModal = function() {
      window.closeAllAdminModals();
    };
    window.handleOpenAdminIssuerBtn = function(btn) {
      if (!btn || !btn.dataset) return;
      const ds = btn.dataset;
      window.openAdminIssuerModal(
        ds.profId, ds.profName, ds.ruc, ds.razon, ds.comercial, ds.direccion,
        ds.email, ds.celular, ds.est, ds.pto, ds.sec, ds.regimen, ds.contabilidad, ds.ambiente
      );
    };

    window.openSuperAdminUserModal = async function(userId) {
      window.closeAllAdminModals();
      const modal = document.getElementById('super-admin-profile-modal');
      const form = document.getElementById('super-admin-profile-form');
      const impersonateForm = document.getElementById('super-admin-impersonate-form');
      const forceLogoutForm = document.getElementById('super-admin-force-logout-form');
      const sendTempAccessForm = document.getElementById('super-admin-send-temp-access-form');

      if (form) form.action = '/dashboard/admin/users/' + userId + '/update-full-profile';
      if (impersonateForm) impersonateForm.action = '/dashboard/admin/users/' + userId + '/impersonate';
      if (forceLogoutForm) forceLogoutForm.action = '/dashboard/admin/users/' + userId + '/force-logout';
      if (sendTempAccessForm) sendTempAccessForm.action = '/dashboard/admin/users/' + userId + '/send-temporary-access';

      const titleName = document.getElementById('super-user-name-title');
      const titleEmail = document.getElementById('super-user-email-title');
      if (titleName) titleName.innerText = 'Cargando datos del usuario...';
      if (titleEmail) titleEmail.innerText = 'Espere un momento...';
      
      if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); modal.style.display = 'flex'; }

      try {
        const res = await fetch('/dashboard/admin/users/' + userId + '/full-data');
        if (!res.ok) return;
        const data = await res.json();
        if (!data.success) return;

        const u = data.user || {};
        const prof = u.professionalProfile || {};
        const stud = u.studentProfile || {};
        const client = data.clientBilling || {};

        if (titleName) titleName.innerText = u.name || 'Usuario';
        if (titleEmail) titleEmail.innerText = (u.email || '') + ' (' + (u.role ? u.role.name : 'SIN ROL') + ')';

        const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = (val !== null && val !== undefined) ? val : ''; };
        setVal('super-u-name', u.name);
        setVal('super-u-email', u.email);
        setVal('super-u-telefono', u.telefono);
        setVal('super-u-ciudad', u.ciudad);
        setVal('super-u-nombreCertificado', u.nombreCertificado);
        setVal('super-u-status', u.status || 'ACTIVE');
        setVal('super-u-roleId', u.roleId || 3);
        setVal('super-u-requireProfileSetup', u.requireProfileSetup ? 'true' : 'false');
        setVal('super-u-newPassword', '');

        setVal('super-p-slogan', prof.slogan);
        setVal('super-p-bio', prof.bio);
        setVal('super-p-provincia', prof.provincia);
        setVal('super-p-ciudad', prof.ciudad);
        setVal('super-p-direccion', prof.direccion);
        setVal('super-p-cedula', prof.cedula);
        setVal('super-p-telefono', prof.telefono);
        setVal('super-p-tarifa', prof.tarifa || 0);
        setVal('super-p-whatsapp', prof.whatsapp);
        setVal('super-p-status', prof.status || 'APROBADO');
        setVal('super-p-verified', prof.verified ? 'true' : 'false');
        setVal('super-p-planType', prof.planType || 'PROFESIONAL');
        setVal('super-p-facebook', prof.facebook);
        setVal('super-p-instagram', prof.instagram);
        setVal('super-p-linkedin', prof.linkedin);
        setVal('super-p-tiktok', prof.tiktok);
        setVal('super-p-youtube', prof.youtube);
        setVal('super-p-website', prof.website);

        setVal('super-s-universityId', stud.universityId);
        setVal('super-s-carrera', stud.carrera);
        setVal('super-s-nivelSemestre', stud.nivelSemestre);
        setVal('super-s-carnetEstudiante', stud.carnetEstudiante);
        setVal('super-s-verificadoInstitucional', stud.verificadoInstitucional ? 'true' : 'false');
        setVal('super-s-biografia', stud.biografia);
        setVal('super-s-habilidades', stud.habilidades);
        setVal('super-s-linkedin', stud.linkedin);
        setVal('super-s-github', stud.github);
        setVal('super-s-portfolioWebsite', stud.portfolioWebsite);

        setVal('super-c-tipoIdentificacion', client.tipoIdentificacion || '05');
        setVal('super-c-identificacion', client.identificacion);
        setVal('super-c-direccion', client.direccion);
      } catch (err) {
        console.error(err);
      }
    };
    window.openSuperAdminProfileModal = function(userId) {
      return window.openSuperAdminUserModal(userId);
    };
    window.handleOpenSuperAdminProfileBtn = function(btn) {
      if (!btn || !btn.dataset) return;
      window.openSuperAdminUserModal(btn.dataset.userId);
    };

    // Global lists to prevent quotes and backslash escaping issues in HTML attributes
    window.allProfessionalsList = <%- JSON.stringify((typeof allProfessionals !== 'undefined' && Array.isArray(allProfessionals)) ? allProfessionals : ((typeof pendingProfessionals !== 'undefined' && Array.isArray(pendingProfessionals)) ? pendingProfessionals : [])) %>;
    window.professionalsMap = {};
    if (Array.isArray(window.allProfessionalsList)) {
      window.allProfessionalsList.forEach(p => {
        if (p && p.id) {
          window.professionalsMap[p.id] = p;
        }
      });
    }

    window.conversatoriosList = <%- JSON.stringify((typeof adminInitialConversatorios !== 'undefined' && adminInitialConversatorios) ? adminInitialConversatorios : []) %>;
    window.cursosList = <%- JSON.stringify((typeof adminInitialCursos !== 'undefined' && adminInitialCursos) ? adminInitialCursos : []) %>;
    window.professionsList = <%- JSON.stringify((typeof professions !== 'undefined' && professions) ? professions : []) %>;
    window.carouselsList = <%- JSON.stringify((typeof carousels !== 'undefined' && carousels) ? carousels : []) %>;
    window.plansList = <%- JSON.stringify((typeof plans !== 'undefined' && plans) ? plans : []) %>;
    window.promotionPlansList = <%- JSON.stringify((typeof promotionPlans !== 'undefined' && promotionPlans) ? promotionPlans : []) %>;
    window.agreementsList = <%- JSON.stringify((typeof agreements !== 'undefined' && agreements) ? agreements : []) %>;
    window.bankAccountsList = <%- JSON.stringify((typeof bankAccounts !== 'undefined' && bankAccounts) ? bankAccounts : []) %>;
    window.deferredAdminSystemConfigLoaded = false;

    function toggleBankAccountFields() {
      const type = document.getElementById('bank-account-type')?.value || 'normal';
      document.getElementById('bank-account-normal-fields')?.classList.toggle('hidden', type !== 'normal');
      document.getElementById('bank-account-qr-fields')?.classList.toggle('hidden', type !== 'qr');
      ['bank-account-account-type', 'bank-account-number', 'bank-account-tax-id', 'bank-account-beneficiary'].forEach((id) => {
        const field = document.getElementById(id);
        if (field) field.required = type === 'normal';
      });
    }

    ['bank-account-number', 'bank-account-tax-id'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', (event) => {
        event.target.value = event.target.value.replace(/\D+/g, '');
      });
    });
    toggleBankAccountFields();

    function readBankQrFile(input) {
      const file = input.files && input.files[0];
      if (!file) return;
      if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) {
        alert('El QR debe ser una imagen PNG, JPG o WEBP.');
        input.value = '';
        return;
      }
      if (file.size > 3 * 1024 * 1024) {
        alert('La imagen QR no puede superar 3MB.');
        input.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        const result = reader.result || '';
        document.getElementById('bank-account-qr-image').value = result;
        const preview = document.getElementById('bank-account-qr-preview');
        preview.src = result;
        preview.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    }

    function resetBankAccountForm() {
      const form = document.getElementById('bank-account-form');
      if (!form) return;
      form.action = '/dashboard/admin/bank-accounts';
      form.reset();
      document.getElementById('bank-account-form-title').innerText = 'Nueva cuenta';
      document.getElementById('bank-account-active').checked = true;
      document.getElementById('bank-account-qr-image').value = '';
      document.getElementById('bank-account-qr-preview').classList.add('hidden');
      toggleBankAccountFields();
    }

    function openBankAccountEdit(account) {
      const form = document.getElementById('bank-account-form');
      if (!form) return;
      form.action = `/dashboard/admin/bank-accounts/${account.id}`;
      document.getElementById('bank-account-form-title').innerText = `Editar cuenta #${account.id}`;
      document.getElementById('bank-account-type').value = account.type || 'normal';
      document.getElementById('bank-account-institution').value = account.institution || '';
      document.getElementById('bank-account-account-type').value = account.accountType || 'Ahorros';
      document.getElementById('bank-account-number').value = account.accountNumber || '';
      document.getElementById('bank-account-tax-id').value = account.taxId || '';
      document.getElementById('bank-account-beneficiary').value = account.beneficiaryName || '';
      document.getElementById('bank-account-active').checked = Boolean(account.isActive) && !account.deletedAt;
      document.getElementById('bank-account-qr-image').value = '';
      const preview = document.getElementById('bank-account-qr-preview');
      if (account.qrImageUrl) {
        preview.src = account.qrImageUrl;
        preview.classList.remove('hidden');
      } else {
        preview.classList.add('hidden');
      }
      toggleBankAccountFields();
      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function openBankAccountEditById(id) {
      const account = (window.bankAccountsList || []).find((item) => item.id === id);
      if (account) {
        openBankAccountEdit(account);
      }
    }

    async function loadDeferredAdminSystemConfig() {
      if (window.deferredAdminSystemConfigLoaded) {
        return true;
      }

      try {
        const response = await fetch('/api/admin/system-config/deferred', {
          headers: { 'Accept': 'application/json' }
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) {
          throw new Error(data.error || 'No se pudo cargar la configuración diferida.');
        }

        const youtubeInput = document.querySelector('[data-deferred-admin-field="youtubeUrl"]');
        if (youtubeInput && youtubeInput.dataset.userEdited !== 'true') {
          youtubeInput.value = data.youtubeUrl || '';
        }
        window.deferredAdminSystemConfigLoaded = true;
        return true;
      } catch (error) {
        console.error(error);
        return false;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
