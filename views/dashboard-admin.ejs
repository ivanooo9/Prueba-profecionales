    function updateColorHex(type) {
      const picker = document.getElementById(type + 'ColorPicker');
      const hexInput = document.getElementById(type + 'ColorHex');
      if (picker && hexInput) {
        hexInput.value = picker.value.toUpperCase();
      }
    }

    function updateColorPicker(type) {
      const picker = document.getElementById(type + 'ColorPicker');
      const hexInput = document.getElementById(type + 'ColorHex');
      if (picker && hexInput) {
        let val = hexInput.value.trim();
        if (val && !val.startsWith('#')) val = '#' + val;
        if (/^#[0-9A-F]{6}$/i.test(val)) {
          picker.value = val;
        }
      }
    }

    function applyPresetPalette(primary, secondary) {
      const pPicker = document.getElementById('primaryColorPicker');
      const pHex = document.getElementById('primaryColorHex');
      const sPicker = document.getElementById('secondaryColorPicker');
      const sHex = document.getElementById('secondaryColorHex');
      if (pPicker && pHex && sPicker && sHex) {
        pPicker.value = primary;
        pHex.value = primary.toUpperCase();
        sPicker.value = secondary;
        sHex.value = secondary.toUpperCase();
      }
    }

