      document.getElementById('manual-enrollment-submit-btn').classList.remove('hidden');
      document.getElementById('manual-enrollment-cancel-btn').classList.remove('hidden');

      const title = type === 'curso' ? 'Inscribir en Curso (Registro Manual)' : 'Inscribir en Conversatorio (Registro Manual)';
      document.getElementById('manual-enrollment-title').innerText = title;
      
      const typeLabel = type === 'curso' ? 'Curso Académico' : 'Conversatorio / Evento';
      document.getElementById('manual-enrollment-event-type-label').innerText = typeLabel;

      const list = type === 'curso' ? window.cursosList : window.conversatoriosList;
      const eventObj = list.find(item => item.id === id);
      const eventName = eventObj ? (eventObj.titulo || eventObj.nombre || `ID: ${id}`) : `ID: ${id}`;
      document.getElementById('manual-enrollment-event-name-label').innerText = eventName;

      document.getElementById('manual-enrollment-modal').classList.remove('hidden');
    }

