                    <th class="px-6 py-4">Estudiante</th>
                    <th class="px-6 py-4">Universidad / Instituto</th>
                    <th class="px-6 py-4">Carrera</th>
                    <th class="px-6 py-4 text-center">Estado Carrera</th>
                    <th class="px-6 py-4 text-center">Estado Cuenta</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="estudiantes-tbody" class="divide-y divide-slate-50 font-medium text-slate-700">
                  <% if (typeof studentsList !== 'undefined' && studentsList && studentsList.length > 0) { %>
                    <% studentsList.forEach(function(st) { %>
                      <tr class="hover:bg-slate-50/50 transition" data-name="<%= st.name.toLowerCase() %>" data-email="<%= st.email.toLowerCase() %>" data-status="<%= st.status %>">
                        <td class="px-6 py-4 flex items-center gap-3">
                          <div class="w-9 h-9 rounded-full bg-slate-100 overflow-hidden shrink-0 border border-slate-200">
                            <img src="<%= st.studentProfile && st.studentProfile.foto ? st.studentProfile.foto : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=200' %>" alt="<%= st.name %>" class="w-full h-full object-cover">
                          </div>
                          <div>
                            <div class="font-extrabold text-slate-900"><%= st.name %></div>
                            <div class="text-[10px] text-slate-400"><%= st.email %></div>
                          </div>
                        </td>
                        <td class="px-6 py-4 font-semibold text-slate-800">
                          <%= st.studentProfile ? st.studentProfile.institucionEducativa : 'No especificada' %>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                          <%= st.studentProfile ? st.studentProfile.carrera : 'No especificada' %>
                        </td>
                        <td class="px-6 py-4 text-center">
                          <span class="px-2.5 py-1 rounded-full text-[10px] font-black <%= st.studentProfile && st.studentProfile.estadoCarrera === 'EGRESADO' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %>">
                            <%= st.studentProfile && st.studentProfile.estadoCarrera === 'EGRESADO' ? 'EGRESADO' : 'EN CURSO' %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                          <span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= st.status === 'ACTIVE' ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %>">
                            <%= st.status === 'ACTIVE' ? 'Activo' : 'Suspendido' %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                          <button type="button" onclick="openSuperAdminProfileModal(<%= st.id %>)" class="px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition cursor-pointer flex items-center gap-1" title="Superpoderes de Administración">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> Edición Total
                          </button>

                          <% if (st.studentProfile && st.studentProfile.slug) { %>
                            <a href="/estudiantes/<%= st.studentProfile.slug %>" target="_blank" class="text-blue-600 hover:text-blue-800 bg-blue-50 font-bold px-2.5 py-1 rounded text-[10px]">
                              Ver Perfil
                            </a>
                          <% } %>
                          <button onclick="openChangeRoleModal(<%= st.id %>, '<%= st.name.replace(/'/g, "\\'") %>', <%= st.roleId %>)" class="text-[#0A3C84] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100 text-[10px] cursor-pointer">
                            Cambiar Rol
                          </button>

                          <button type="button" onclick="openSendTempAccessModal(<%= st.id %>, '<%= st.name.replace(/'/g, "\\'") %>', '<%= st.email %>', 'ESTUDIANTE')" class="text-emerald-800 hover:text-emerald-950 bg-emerald-50 hover:bg-emerald-100 font-extrabold px-2.5 py-1.5 rounded-lg border border-emerald-200 transition text-[10px] cursor-pointer flex items-center gap-1" title="Enviar clave temporal y accesos por correo">
                            <i class="fa-solid fa-paper-plane text-emerald-600"></i> Enviar Accesos
                          </button>

                          <button onclick="openResetPasswordModal(<%= st.id %>, '<%= st.name.replace(/'/g, "\\'") %>', '<%= st.email %>')" class="text-amber-700 hover:text-amber-900 bg-amber-50 hover:bg-amber-100 font-bold px-2.5 py-1.5 rounded-lg border border-amber-200 transition text-[10px] cursor-pointer flex items-center gap-1">
                            <i class="fa-solid fa-key"></i> Reset Clave
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="px-6 py-12 text-center text-slate-400 font-semibold">
                        No hay estudiantes registrados en la plataforma.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
            <!-- Pagination Bar Estudiantes -->
            <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 flex flex-col md:flex-row items-center justify-between gap-4">
