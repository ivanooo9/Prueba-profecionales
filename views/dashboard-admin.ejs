    async function handleBunnyVideoUpload(fileInput, targetInputId) {
      const file = fileInput.files[0];
      if (!file) return;

      const progressContainer = document.getElementById('bunny-upload-progress-container');
      const progressBar = document.getElementById('bunny-upload-progress-bar');
      const statusText = document.getElementById('bunny-upload-status');
      
      if (progressContainer) progressContainer.classList.remove('hidden');
      if (statusText) statusText.classList.remove('hidden');

      try {
        const sigRes = await fetch('/api/videos/bunny-signature');
        const sigData = await sigRes.json();

        if (!sigData.success) {
          throw new Error("No se pudo obtener firma de Bunny Stream");
        }

        const upload = new tus.Upload(file, {
          endpoint: "https://video.bunnycdn.com/tusupload",
          retryDelays: [0, 3000, 5000, 10000, 20000],
          headers: {
            AuthorizationSignature: sigData.signature,
            AuthorizationExpire: sigData.expirationTime,
            VideoId: sigData.videoId,
            LibraryId: sigData.libraryId,
          },
          metadata: {
            filename: file.name,
            filetype: file.type
          },
          onError: function(error) {
            console.error("Upload failed:", error);
            if (statusText) statusText.innerText = "Error: " + error.message;
            if (progressBar) progressBar.classList.add('bg-red-500');
          },
          onProgress: function(bytesUploaded, bytesTotal) {
            const percentage = ((bytesUploaded / bytesTotal) * 100).toFixed(2);
            if (progressBar) progressBar.style.width = percentage + "%";
            if (statusText) statusText.innerText = "Subiendo... " + percentage + "%";
          },
          onSuccess: function() {
            if (statusText) {
              statusText.innerText = "Subida completada con éxito.";
              statusText.classList.add("text-emerald-600");
            }
            if (progressContainer) setTimeout(() => progressContainer.classList.add('hidden'), 2000);

            // Guardar el video ID de bunny en el input de mediaUrl (que ahora sirve para url, base64 o bunnyId)
            const mediaUrlInput = document.getElementById(targetInputId);
            if (mediaUrlInput) {
              // we store the bunny iframe string or just a custom string identifying it as bunny
              mediaUrlInput.value = "bunny:" + sigData.libraryId + ":" + sigData.videoId;
            }

            const urlInput = document.getElementById('curso-media-video-url');
            if (urlInput) urlInput.value = 'Bunny Stream Video (' + sigData.videoId + ')';
            
            updateCursoMediaPreview("bunny:" + sigData.libraryId + ":" + sigData.videoId, 'video');
          }
        });

        upload.findPreviousUploads().then(function (previousUploads) {
          if (previousUploads.length) {
            upload.resumeFromPreviousUpload(previousUploads[0])
          }
          upload.start();
        });

      } catch (err) {
        console.error(err);
        if (statusText) statusText.innerText = "Error: " + err.message;
        if (progressBar) progressBar.classList.add('bg-red-500');
      }
    }

