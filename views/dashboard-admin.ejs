                <select id="estudiantes-pagesize-select" class="bg-white border border-slate-200 rounded-xl py-1 px-2 text-xs font-bold text-slate-700 outline-none">
                  <option value="10" selected>10 filas</option>
                  <option value="25">25 filas</option>
                  <option value="50">50 filas</option>
                  <option value="100">100 filas</option>
                </select>
                <span class="text-xs font-bold text-slate-500 ml-2" id="estudiantes-pagination-counter">
                  Mostrando 1 - 10 de <%= typeof studentsList !== 'undefined' ? studentsList.length : 0 %> estudiantes
                </span>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" id="estudiantes-prev-btn" class="px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-extrabold text-xs transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-sm flex items-center gap-1.5">
                  <i class="fa-solid fa-chevron-left text-[10px]"></i> Anterior
                </button>
                <span id="estudiantes-page-indicator" class="text-xs font-black px-3.5 py-1.5 bg-white border border-slate-200 rounded-xl text-slate-800 shadow-sm">
                  Página 1
                </span>
                <button type="button" id="estudiantes-next-btn" class="px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-extrabold text-xs transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-sm flex items-center gap-1.5">
                  Siguiente <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </button>
