        const previewImg = document.getElementById('curso-portada-preview');
        const previewPlaceholder = document.getElementById('curso-portada-placeholder');
        if (previewImg) {
          if (this.value) {
            previewImg.src = this.value;
            previewImg.classList.remove('hidden');
            if (previewPlaceholder) previewPlaceholder.classList.add('hidden');
          } else {
            previewImg.src = '';
            previewImg.classList.add('hidden');
            if (previewPlaceholder) previewPlaceholder.classList.remove('hidden');
          }
        }
      });
    }

    const imageUrlInput = document.getElementById('carousel-imageUrl');
    if (imageUrlInput) {
      imageUrlInput.addEventListener('input', function() {
        const previewImg = document.getElementById('carousel-image-preview');
        const previewPlaceholder = document.getElementById('carousel-preview-placeholder');
        if (previewImg) {
          if (this.value) {
            previewImg.src = this.value;
            previewImg.classList.remove('hidden');
            if (previewPlaceholder) previewPlaceholder.classList.add('hidden');
          } else {
            previewImg.src = '';
            previewImg.classList.add('hidden');
            if (previewPlaceholder) previewPlaceholder.classList.remove('hidden');
          }
        }
      });
    }

    // Client-side list filtering
    function filterCarousels() {
      const selectedValue = document.getElementById('carousel-filter-location').value;
      const rows = document.querySelectorAll('#carousel-table-body tr');
      const counterSpan = document.getElementById('carousel-counter');
      const emptyRow = document.getElementById('carousel-empty-row');
      
      let visibleCount = 0;
      
      rows.forEach(row => {
        if (row === emptyRow) return;
        
        const tipo = row.getAttribute('data-tipo');
        const profId = row.getAttribute('data-profesion-id');
        
        let show = false;
        
        if (selectedValue === 'all') {
          show = true;
        } else if (selectedValue === 'Inicio') {
          show = (tipo === 'Inicio');
        } else if (selectedValue === 'profesiones') {
          show = (tipo === 'Profesion');
        } else if (selectedValue.startsWith('prof-')) {
          const targetId = selectedValue.replace('prof-', '');
          show = (tipo === 'Profesion' && profId === targetId);
        }
        
        if (show) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Update counters dynamically
      if (counterSpan) {
        counterSpan.innerText = `${visibleCount} Filtrados`;
      }
      
      if (emptyRow) {
        if (visibleCount === 0) {
          emptyRow.style.display = '';
          emptyRow.cells[0].innerText = 'No hay sliders que coincidan con el filtro seleccionado.';
        } else {
          emptyRow.style.display = 'none';
        }
      }
    }

    // Check URL parameters or localStorage to switch tab on load and show notifications
    const urlParams = new URLSearchParams(window.location.search);
    const activeTab = urlParams.get('tab') || localStorage.getItem('adminActiveTab') || 'stats';
    if (activeTab) {
      switchTab(activeTab);
    }

    // Process Alert Messages
    const successParam = urlParams.get('success');
    const errorParam = urlParams.get('error');

    if (successParam || errorParam) {
      const container = document.getElementById('admin-alert-container');
      const alertDiv = document.getElementById('admin-alert');
      const iconDiv = document.getElementById('admin-alert-icon');
      const msgDiv = document.getElementById('admin-alert-message');

      let message = '';
      let isError = false;

      if (successParam) {
        isError = false;
        switch (successParam) {
          case 'carousel_saved': message = 'Slider guardado exitosamente.'; break;
          case 'carousel_deleted': message = 'Slider eliminado de forma permanente.'; break;
          case 'plan_saved': message = 'Plan de afiliación guardado exitosamente.'; break;
          case 'plan_deleted': message = 'Plan de afiliación eliminado correctamente.'; break;
          case 'payment_approved': message = 'Solicitud de cobro aprobada y saldo actualizado.'; break;
          case 'payment_rejected': message = 'Solicitud de cobro rechazada correctamente.'; break;
          case 'agreement_saved': message = 'Convenio guardado exitosamente.'; break;
          case 'agreement_deleted': message = 'Convenio eliminado de forma permanente.'; break;
          case 'profession_saved': message = 'Profesión guardada exitosamente.'; break;
          case 'profession_deleted': message = 'Profesión eliminada permanentemente con sus especialidades.'; break;
          case 'specialty_saved': message = 'Especialidad guardada exitosamente.'; break;
          case 'specialty_deleted': message = 'Especialidad eliminada correctamente.'; break;
          case 'design_saved': message = 'Plantilla de certificado guardada exitosamente.'; break;
          case 'payphone-configured': message = 'Configuración de PayPhone guardada exitosamente.'; break;
          case 'style_updated': message = 'Configuración de P.EC guardada exitosamente.'; break;
          case 'professional_deleted': message = 'Profesional eliminado correctamente de la base de datos.'; break;
          case 'referral_created': {
            const refEmail = urlParams.get('refEmail') || '';
            const refPass = urlParams.get('refPass') || '';
            message = `Cuenta de referido creada exitosamente${refEmail ? ' para ' + refEmail : ''}.${refPass ? ' Contraseña temporal: ' + refPass : ''}`;
            break;
          }
          case 'status_updated': message = 'Estado de la cuenta de referido actualizado exitosamente.'; break;
          case 'sale_approved': message = 'Venta de referido aprobada exitosamente y cliente habilitado.'; break;
          case 'sale_rejected': message = 'Venta de referido rechazada correctamente.'; break;
          case 'general_updated': message = 'Porcentaje de comisión general base actualizado.'; break;
          case 'specific_updated': message = 'Regla de comisión específica guardada exitosamente.'; break;
          case 'rule_deleted': message = 'Regla de comisión eliminada correctamente.'; break;
          case 'withdrawal_processed': message = 'Solicitud de retiro marcada como PAGADA exitosamente.'; break;
          case 'impersonation_ended': message = 'Modo Soporte Técnico finalizado con éxito. Has regresado a tu cuenta de Administrador.'; break;
          case 'sessions_revoked': message = 'Todas las sesiones activas del usuario fueron revocadas correctamente.'; break;
          default: message = 'Operación realizada con éxito.';
        }
      } else if (errorParam) {
        isError = true;
        switch (errorParam) {
          case 'email_already_exists': message = 'Este correo electrónico ya se encuentra registrado en el sistema.'; break;
          case 'invalid_email': message = 'Por favor ingrese un correo electrónico válido.'; break;
          case 'status_failed': message = 'Error al actualizar el estado del referido.'; break;
          case 'sale_approve_failed': message = 'Error al intentar aprobar la venta de referido.'; break;
          case 'sale_reject_failed': message = 'Error al intentar rechazar la venta de referido.'; break;
          case 'withdrawal_process_failed': message = 'Error al procesar la solicitud de retiro.'; break;
          case 'carousel_failed': message = 'Error al intentar guardar el slider.'; break;
          case 'carousel_delete_failed': message = 'Error al intentar eliminar el slider.'; break;
          case 'plan_failed': message = 'Error al procesar la solicitud del plan.'; break;
          case 'plan_delete_failed': message = 'No se pudo eliminar el plan de afiliación.'; break;
          case 'payment_approve_failed': message = 'Error al intentar aprobar la solicitud de pago.'; break;
          case 'payment_reject_failed': message = 'Error al intentar rechazar la solicitud de pago.'; break;
          case 'agreement_failed': message = 'Error al procesar el convenio.'; break;
          case 'agreement_delete_failed': message = 'Error al eliminar el convenio.'; break;
          case 'profession_failed': message = 'Error al intentar guardar la profesión.'; break;
          case 'specialty_failed': message = 'Error al intentar guardar la especialidad.'; break;
          case 'delete_profession_failed': message = 'Error al intentar eliminar la profesión.'; break;
          case 'delete_specialty_failed': message = 'Error al intentar eliminar la especialidad.'; break;
          case 'design_save_failed': message = 'Error al intentar guardar la plantilla del certificado.'; break;
          case 'payphone_config_failed': message = 'Error al guardar la configuración de PayPhone.'; break;
          case 'invalid_tax_rate': message = 'La tasa de IVA debe ser un número entre 0 y 100.'; break;
          case 'invalid_admin_email': message = 'El correo del admin no tiene un formato válido.'; break;
          case 'style_config_failed': message = 'Error al guardar la configuración de P.EC.'; break;
          case 'professional_delete_blocked_invoices': message = 'No se pudo eliminar el profesional porque tiene facturas emitidas asociadas a su emisor; se bloqueó el borrado para evitar inconsistencia de datos.'; break;
          case 'professional_delete_not_allowed': message = 'Solo se pueden eliminar usuarios con rol profesional desde este modal.'; break;
          case 'professional_delete_failed': message = 'Error al intentar eliminar el profesional.'; break;
          default: message = 'Ocurrió un error inesperado al procesar la solicitud.';
        }
      }

      if (container && alertDiv && iconDiv && msgDiv) {
        msgDiv.innerText = message;
        if (isError) {
          alertDiv.className = "flex items-center gap-3 p-4 rounded-2xl border border-rose-100 bg-rose-50 text-rose-700 font-sans text-xs font-bold transition shadow-sm";
          iconDiv.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
        } else {
          alertDiv.className = "flex items-center gap-3 p-4 rounded-2xl border border-emerald-100 bg-emerald-50 text-emerald-700 font-sans text-xs font-bold transition shadow-sm";
          iconDiv.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
        }
        container.classList.remove('hidden');
      }
    }

    function closeAdminAlert() {
      const container = document.getElementById('admin-alert-container');
      if (container) {
        container.classList.add('hidden');
      }
    }

    // Catalog edit/reset helpers
    function editProfession(p) {
      document.getElementById('profession-form-title').innerText = 'Editar Profesión';
      document.getElementById('profession-id').value = p.id;
      document.getElementById('profession-nombre').value = p.nombre;
      document.getElementById('profession-descripcion').value = p.descripcion || '';
      document.getElementById('profession-imagen').value = p.imagen || '';
      
      const preview = document.getElementById('profession-image-preview');
      const placeholder = document.getElementById('profession-image-placeholder');
      if (p.imagen) {
        if (preview) {
          preview.src = p.imagen;
          preview.classList.remove('hidden');
        }
        if (placeholder) {
          placeholder.classList.add('hidden');
        }
      } else {
        if (preview) {
          preview.src = '';
          preview.classList.add('hidden');
        }
        if (placeholder) {
          placeholder.classList.remove('hidden');
        }
      }
      
      document.getElementById('profession-form-btn').innerHTML = 'Guardar Cambios <i class="fa-solid fa-save ml-1"></i>';
      
      const cancelBtn = document.getElementById('profession-cancel-btn');
      if (cancelBtn) cancelBtn.classList.remove('hidden');

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function cancelProfessionEdit() {
      document.getElementById('profession-form-title').innerText = 'Crear Profesión';
      document.getElementById('profession-id').value = '';
      document.getElementById('profession-nombre').value = '';
      document.getElementById('profession-descripcion').value = '';
      document.getElementById('profession-imagen').value = '';
      
      const fileInput = document.getElementById('profession-image-file');
      if (fileInput) fileInput.value = '';
      
      const preview = document.getElementById('profession-image-preview');
      const placeholder = document.getElementById('profession-image-placeholder');
      if (preview) {
        preview.src = '';
        preview.classList.add('hidden');
      }
      if (placeholder) {
        placeholder.classList.remove('hidden');
      }
      
      document.getElementById('profession-form-btn').innerHTML = 'Guardar Profesión';
      
      const cancelBtn = document.getElementById('profession-cancel-btn');
      if (cancelBtn) cancelBtn.classList.add('hidden');
    }

    function editSpecialty(s) {
      document.getElementById('specialty-form-title').innerText = 'Editar Especialidad';
      document.getElementById('specialty-id').value = s.id;
      document.getElementById('specialty-professionId').value = s.professionId;
      document.getElementById('specialty-nombre').value = s.nombre;
      document.getElementById('specialty-form-btn').innerHTML = 'Guardar Cambios <i class="fa-solid fa-save ml-1"></i>';

      const cancelBtn = document.getElementById('specialty-cancel-btn');
      if (cancelBtn) cancelBtn.classList.remove('hidden');

      // Auto-select in the table filter and run filter to show context of what we are editing
      const filterSelect = document.getElementById('admin-specialty-filter');
      if (filterSelect) {
        filterSelect.value = s.professionId;
        filterAdminSpecialtiesTable();
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function cancelSpecialtyEdit() {
      document.getElementById('specialty-form-title').innerText = 'Crear Especialidad';
      document.getElementById('specialty-id').value = '';
      document.getElementById('specialty-nombre').value = '';
      document.getElementById('specialty-form-btn').innerHTML = 'Guardar Especialidad';

      const cancelBtn = document.getElementById('specialty-cancel-btn');
      if (cancelBtn) cancelBtn.classList.add('hidden');
    }

    function filterAdminSpecialtiesTable() {
      const selectedProfId = document.getElementById('admin-specialty-filter').value;
      const rows = document.querySelectorAll('#admin-specialties-tbody tr:not(.empty-state-row)');
      const emptyRow = document.getElementById('admin-specialties-empty-row');
      
      let visibleCount = 0;
      
      rows.forEach(row => {
        const profId = row.getAttribute('data-profession-id');
        if (!selectedProfId) {
          row.classList.add('hidden');
        } else if (profId === selectedProfId) {
          row.classList.remove('hidden');
          visibleCount++;
        } else {
          row.classList.add('hidden');
        }
      });

      if (!selectedProfId) {
        if (emptyRow) {
          emptyRow.querySelector('td').innerText = 'Seleccione una profesión arriba para ver sus especialidades.';
          emptyRow.classList.remove('hidden');
        }
      } else if (visibleCount === 0) {
        if (emptyRow) {
          emptyRow.querySelector('td').innerText = 'No hay especialidades registradas para esta profesión.';
          emptyRow.classList.remove('hidden');
        }
      } else {
        if (emptyRow) {
          emptyRow.classList.add('hidden');
        }
      }
    }

    document.addEventListener('DOMContentLoaded', filterAdminSpecialtiesTable);

    // Chart statistics configurations
    const ctx = document.getElementById('registrationChart');
    if (ctx) {
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
          datasets: [{
            label: 'Profesionales Registrados',
            data: [4, 5, 8, 12, 14, <%= stats.totalProfessionals %>],
            borderColor: '#0252A4',
            backgroundColor: 'rgba(2, 82, 164, 0.05)',
            borderWidth: 3,
            fill: true,
            tension: 0.4
          }, {
            label: 'Agendamientos Concretados',
            data: [2, 3, 5, 8, 9, <%= stats.totalAppointments %>],
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.05)',
            borderWidth: 3,
            fill: true,
            tension: 0.4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: {
                font: {
                  family: 'Outfit',
                  size: 11,
                  weight: '600'
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: '#f1f5f9'
              },
              ticks: {
                font: {
                  family: 'Outfit',
                  size: 10
                }
              }
            },
            x: {
              grid: {
                display: false
              },
              ticks: {
                font: {
                  family: 'Outfit',
                  size: 10
                }
              }
            }
          }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const sidebar = document.getElementById('sidebar-menu');
      const backdrop = document.getElementById('mobile-sidebar-backdrop');

      function openMenu() {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
      }

      function closeMenu() {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
      }

      if (toggleBtn && sidebar && backdrop) {
        toggleBtn.addEventListener('click', openMenu);
        backdrop.addEventListener('click', closeMenu);
      }

      // Close side drawer when clicking layout tabs on mobile
      document.querySelectorAll('.dash-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (window.innerWidth < 1024) {
            closeMenu();
          }
        });
      });
    });
  </script>

  <!-- Modal: Diseñar Certificado -->
  <div id="certificate-design-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-[28px] border border-slate-100 p-6 md:p-8 max-w-7xl w-full shadow-2xl flex flex-col gap-6 animate-scale-up text-left max-h-[90vh]">
      <!-- Load Fonts Specially for Certificate Preview -->
      <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Dancing+Script:wght@700&family=Great+Vibes&display=swap" rel="stylesheet">

      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-lg font-black text-slate-900 uppercase tracking-tight flex items-center gap-2">
          <i class="fa-solid fa-certificate text-amber-500"></i> Diseño de Certificado de Horas
        </h3>
        <button onclick="closeCertificateDesignModal()" class="w-8 h-8 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="certificate-design-form" action="/dashboard/admin/certificados/diseno" method="POST" class="flex flex-col gap-4 text-xs font-semibold overflow-y-auto pr-1">
        <input type="hidden" name="conversatorioId" id="cert-conversatorio-id">
        <input type="hidden" name="cursoId" id="cert-curso-id">
        <input type="hidden" name="firmaImagen" id="cert-firma-imagen"> <!-- Fallback for single signature legacy -->
        <input type="hidden" name="plantillaFondo" id="cert-plantilla-fondo">
        <input type="hidden" name="firmasJson" id="cert-firmas-json">
        <input type="hidden" name="avalesJson" id="cert-avales-json">
        <input type="hidden" name="firmaTexto" id="cert-firma-texto"> <!-- Fallback for single signature legacy -->

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 w-full items-start">
          
          <!-- Column 1: Config Form (5 cols) -->
          <div class="lg:col-span-5 flex flex-col gap-4 max-h-[60vh] overflow-y-auto pr-3">
            <div class="flex flex-col gap-1.5">
              <label class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Nombre del Evento en Certificado</label>
              <input type="text" name="nombreEvento" id="cert-nombre-evento" required class="bg-slate-550/5 border border-slate-100 rounded-xl py-2.5 px-3.5 outline-none focus:bg-white focus:border-[#0A3C84] transition" placeholder="Ej: I Congreso Internacional de Medicina y Derecho" oninput="updateCertPreview()">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Número de Horas Académicas</label>
                <input type="number" name="horas" id="cert-horas" min="0" class="bg-slate-550/5 border border-slate-100 rounded-xl py-2.5 px-3.5 outline-none focus:bg-white focus:border-[#0A3C84] transition" placeholder="Vacío = asistencia" oninput="updateCertPreview()">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Fondo del Certificado (JPG/PNG)</label>
                <div class="flex gap-2 items-center">
                  <input type="file" accept="image/*" onchange="loadCertBackground(this)" class="bg-slate-550/5 border border-slate-100 rounded-xl py-2 px-3 outline-none transition text-[10px] w-full">
                  <button type="button" onclick="clearCertBackground()" class="text-rose-600 bg-rose-50 hover:bg-rose-100 p-2.5 rounded-xl border border-rose-150 transition cursor-pointer" title="Eliminar fondo">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
                <span class="text-[8px] text-slate-400">Fondo recomendado: Proporción horizontal, 1100x770px.</span>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Precio Certificado (Estado ACTIVO)</label>
                <input type="number" name="precioActivo" id="cert-precio-activo" required min="0" step="0.01" class="bg-slate-550/5 border border-slate-100 rounded-xl py-2.5 px-3.5 outline-none focus:bg-white focus:border-[#0A3C84] transition" placeholder="Ej: 15.00">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-bold text-slate-550 uppercase tracking-wider">Precio Certificado (Estado FINALIZADO)</label>
                <input type="number" name="precioFinalizado" id="cert-precio-finalizado" required min="0" step="0.01" class="bg-slate-550/5 border border-slate-100 rounded-xl py-2.5 px-3.5 outline-none focus:bg-white focus:border-[#0A3C84] transition" placeholder="Ej: 25.00">
              </div>
            </div>

            <!-- Signers Section (firmasJson) -->
            <div class="border-t border-slate-100 pt-4 flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <label class="text-[10px] font-extrabold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                  <i class="fa-solid fa-signature text-blue-600"></i> Firmas de Autoridades (Máx. 4)
                </label>
                <button type="button" onclick="addSignerRow()" class="text-[#0A3C84] bg-blue-50 hover:bg-blue-100 border border-blue-100 font-bold px-2 py-1 rounded-lg transition text-[9px] cursor-pointer flex items-center gap-1">
                  <i class="fa-solid fa-plus"></i> Agregar Firma
                </button>
              </div>
              <div id="signers-list-container" class="flex flex-col gap-2.5 mt-1.5">
                <!-- Signer item blocks will be injected here -->
              </div>
            </div>

            <!-- Endorsement Logos Section (avalesJson) -->
            <div class="border-t border-slate-100 pt-4 flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <label class="text-[10px] font-extrabold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                  <i class="fa-solid fa-building-columns text-amber-600"></i> Logos de Avales Académicos (Máx. 5)
                </label>
                <button type="button" onclick="addAvalRow()" class="text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-100 font-bold px-2 py-1 rounded-lg transition text-[9px] cursor-pointer flex items-center gap-1">
                  <i class="fa-solid fa-plus"></i> Agregar Aval
                </button>
              </div>
              <div id="avales-list-container" class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-1.5">
                <!-- Aval item blocks will be injected here -->
              </div>
            </div>
          </div>

          <!-- Column 2: Live Preview (7 cols) -->
          <div class="lg:col-span-7 flex flex-col items-center justify-start bg-slate-50/70 border border-slate-200/50 rounded-2xl p-4 select-none w-full">
            <span class="text-[10px] font-black text-slate-500 uppercase tracking-wider mb-3 self-start flex items-center gap-1.5">
              <i class="fa-solid fa-eye text-emerald-500"></i> Vista Previa en Tiempo Real
            </span>
            
            <!-- Scale Wrapper Container -->
            <div id="preview-wrapper" class="w-full relative overflow-hidden bg-slate-200 border border-slate-300 rounded-xl flex items-start justify-start shadow-inner" style="min-height: 250px;">
              
              <!-- 1100x770 Certificate Canvas -->
              <div id="live-cert-container" style="width: 1100px; height: 770px; background-color: #fbfbf9; position: absolute; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; align-items: center; padding: 3.5rem 4rem; border: none; transform-origin: top left; transition: transform 0.15s ease-out;">
                <!-- Custom Background -->
                <img id="prev-custom-bg" src="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; display: none;">
                
                <!-- Default border frame -->
                <div id="prev-border-frame" style="position: absolute; inset: 1.5rem; border: 4px double #d97706; border-radius: 0.75rem; pointer-events: none; z-index: 1;">
                  <div style="position: absolute; inset: 2rem; border: 1px solid rgba(217, 119, 6, 0.35); border-radius: 0.5rem;"></div>
                  <!-- Corner decorations -->
                  <div style="position: absolute; width: 40px; height: 40px; border-color: #d97706; border-style: solid; border-width: 3px 0 0 3px; border-top-left-radius: 4px; top: 2rem; left: 2rem;"></div>
                  <div style="position: absolute; width: 40px; height: 40px; border-color: #d97706; border-style: solid; border-width: 3px 3px 0 0; border-top-right-radius: 4px; top: 2rem; right: 2rem;"></div>
                  <div style="position: absolute; width: 40px; height: 40px; border-color: #d97706; border-style: solid; border-width: 0 0 3px 3px; border-bottom-left-radius: 4px; bottom: 2rem; left: 2rem;"></div>
                  <div style="position: absolute; width: 40px; height: 40px; border-color: #d97706; border-style: solid; border-width: 0 3px 3px 0; border-bottom-right-radius: 4px; bottom: 2rem; right: 2rem;"></div>
                </div>

                <!-- Verification badge simulation in top left -->
                <div style="position: absolute; top: 2.5rem; left: 3rem; display: flex; align-items: center; gap: 0.5rem; z-index: 2;">
                  <div style="width: 48px; height: 48px; border: 1px solid #cbd5e1; padding: 1px; background: white; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                    <i class="fa-solid fa-qrcode text-slate-800 text-3xl"></i>
                  </div>
                  <div style="display: flex; flex-direction: column; text-align: left; line-height: 1;">
                    <span style="font-size: 0.45rem; font-weight: 800; color: #64748b; text-transform: uppercase;">Certificado Registro</span>
                    <span style="font-size: 0.55rem; font-weight: 700; color: #0A3C84; font-family: monospace;">PE-XXXXX-TEST</span>
                    <span style="font-size: 0.45rem; color: #d97706; font-weight: 600; text-decoration: none;">Verificar en línea</span>
                  </div>
                </div>

                <!-- 1. Header Section -->
                <div style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.25rem; width: 100%; z-index: 2; font-family: 'Montserrat', sans-serif;">
                  <span style="font-size: 1.1rem; font-weight: 900; color: #0A3C84; letter-spacing: 0.25em; text-transform: uppercase;">Profesionales Ecuador</span>
                  <h1 id="prev-cert-title" style="font-family: 'Playfair Display', serif; font-size: 2.85rem; font-weight: 800; color: #0c172d; letter-spacing: -0.01em; margin-top: 0.25rem; line-height: 1; text-transform: uppercase;">CERTIFICADO DE ASISTENCIA</h1>
                </div>

                <!-- 2. Body Text Section -->
                <div style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; width: 100%; margin: 1rem 0; z-index: 2; font-family: 'Montserrat', sans-serif;">
                  <p style="font-size: 0.8rem; font-weight: 600; color: #64748b; letter-spacing: 0.05em; margin: 0;">Se otorga el presente reconocimiento con honor y distinción a:</p>
                  <h2 style="font-family: 'Great Vibes', cursive; font-size: 3.5rem; font-weight: 500; color: #0A3C84; margin: 0; line-height: 1.1;">Erika Dejaneira Desintonio</h2>
                  <p id="prev-event-desc" style="font-size: 0.85rem; font-weight: 500; color: #334155; line-height: 1.7; max-width: 820px; text-align: justify; text-align-last: center; margin: 0;">
                    Se certifica que usted participó en el <strong id="prev-event-title" style="font-weight: 800; color: #0f172a;">Conversatorio Nacional Multidisciplinario Virtual de Profesionales Ecuador</strong>, demostrando compromiso, pasión por el aprendizaje y firme determinación de crecimiento. Su participación refleja el espíritu de superación que impulsa a los estudiantes y profesionales del Ecuador a prepararse mejor cada día, contribuyendo a la construcción de un país con más conocimiento, oportunidades y desarrollo.
                  </p>
                  <p style="font-size: 0.7rem; margin-top: 0.25rem; color: #64748b; font-weight: 600; margin: 0;">
                    Ecuador, <span id="prev-date-str">3 de junio de 2026</span> <span id="prev-hours-bullet">&bull; Duración: <span id="prev-hours-val">40</span> Horas Académicas.</span>
                  </p>
                </div>

                <!-- 3. Signatures Row -->
                <div id="prev-signatures-row" style="display: flex; justify-content: space-evenly; align-items: flex-end; width: 100%; margin-top: 1.5rem; gap: 1rem; z-index: 2; font-family: 'Montserrat', sans-serif;">
                  <!-- Dynamic JS -->
                </div>

                <!-- 4. Endorsement Logos Row -->
                <div id="prev-avales-row" style="display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 0.5rem; width: 100%; border-top: 1px solid rgba(226, 232, 240, 0.6); padding-top: 1rem; margin-top: 1.5rem; z-index: 2; font-family: 'Montserrat', sans-serif;">
                  <!-- Dynamic JS -->
                </div>
              </div>
            </div>
            
            <div class="w-full flex justify-between items-center mt-3 text-[10px] text-slate-400 font-medium">
              <span>Resolución base: 1100 x 770 px</span>
              <span class="text-emerald-600 font-bold flex items-center gap-1"><i class="fa-solid fa-arrows-rotate animate-spin"></i> Visualización interactiva</span>
            </div>
          </div>

        </div>

        <div class="flex justify-end gap-2 border-t border-slate-100 pt-4 mt-2">
          <button type="button" onclick="closeCertificateDesignModal()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-5 rounded-xl transition cursor-pointer">
            Cancelar
          </button>
          <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-6 rounded-xl transition shadow-md cursor-pointer flex items-center gap-1.5">
            Guardar Plantilla <i class="fa-solid fa-save"></i>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let signaturesList = [];
    let avalesList = [];
    const systemTemplatesList = <%- JSON.stringify(templates) %>;

    function updatePreviewScale() {
      const container = document.getElementById('preview-wrapper');
      const cert = document.getElementById('live-cert-container');
      if (!container || !cert) return;
      const scale = container.clientWidth / 1100;
      cert.style.transform = `scale(${scale})`;
      container.style.height = `${770 * scale}px`;
    }
    window.addEventListener('resize', updatePreviewScale);

    function openCertificateDesignModal(type, eventId, eventTitle, existingDesign) {
      document.getElementById('cert-conversatorio-id').value = type === 'conversatorio' ? eventId : '';
      document.getElementById('cert-curso-id').value = type === 'curso' ? eventId : '';
      
      document.getElementById('cert-nombre-evento').value = eventTitle;
      document.getElementById('cert-horas').value = '';
      document.getElementById('cert-firma-texto').value = '';
      document.getElementById('cert-precio-activo').value = '';
      document.getElementById('cert-precio-finalizado').value = '';
      document.getElementById('cert-firma-imagen').value = '';
      document.getElementById('cert-plantilla-fondo').value = '';
      
      signaturesList = [];
      avalesList = [];
      
      if (!existingDesign && window.certificateDesigns) {
        existingDesign = window.certificateDesigns[type + '-' + eventId];
      }
      if (existingDesign) {
        document.getElementById('cert-nombre-evento').value = existingDesign.nombreEvento || eventTitle;
        document.getElementById('cert-horas').value = existingDesign.horas || '';
        document.getElementById('cert-firma-texto').value = existingDesign.firmaTexto || '';
        document.getElementById('cert-precio-activo').value = existingDesign.precioActivo || '';
        document.getElementById('cert-precio-finalizado').value = existingDesign.precioFinalizado || '';
        document.getElementById('cert-firma-imagen').value = existingDesign.firmaImagen || '';
        document.getElementById('cert-plantilla-fondo').value = existingDesign.plantillaFondo || '';
        
        if (existingDesign.firmasJson) {
          try {
            signaturesList = JSON.parse(existingDesign.firmasJson);
          } catch (e) {
            console.error("Error parsing existing signatures JSON:", e);
          }
        }
        
        if (existingDesign.avalesJson) {
          try {
            avalesList = JSON.parse(existingDesign.avalesJson);
          } catch (e) {
            console.error("Error parsing existing avales JSON:", e);
          }
        }
      }
      
      // Render lists and preview
      renderSignersList();
      renderAvalesList();
      updateCertPreview();
      
      document.getElementById('certificate-design-modal').classList.remove('hidden');
      
      // Trigger preview scaling
      setTimeout(updatePreviewScale, 100);
    }

    function closeCertificateDesignModal() {
      document.getElementById('certificate-design-modal').classList.add('hidden');
    }

    function openCertificateDesignModalById(type, id) {
      let ev = null;
      if (type === 'conversatorio') {
        ev = window.conversatoriosList.find(c => c.id === id);
      } else if (type === 'curso') {
        ev = window.cursosList.find(c => c.id === id);
      }
      if (ev) {
        openCertificateDesignModal(type, ev.id, ev.titulo);
      }
    }

    function openCurriculumBuilderById(id) {
      const ev = window.cursosList.find(c => c.id === id);
      if (ev) {
        openCurriculumBuilder(ev.id, ev.titulo);
      }
    }

    function openSubmissionsViewerById(id) {
      const ev = window.cursosList.find(c => c.id === id);
      if (ev) {
        openSubmissionsViewer(ev.id, ev.titulo);
      }
    }

    function loadCertBackground(fileInput) {
      const file = fileInput.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('cert-plantilla-fondo').value = e.target.result;
          updateCertPreview();
        };
        reader.readAsDataURL(file);
      }
    }

    function clearCertBackground() {
      document.getElementById('cert-plantilla-fondo').value = '';
      updateCertPreview();
    }

    function addSignerRow() {
      if (signaturesList.length >= 4) {
        alert("Se permite un máximo de 4 firmas en el diseño.");
        return;
      }
      signaturesList.push({ name: '', role: '', img: '' });
      renderSignersList();
      updateCertPreview();
    }

    function removeSigner(index) {
      signaturesList.splice(index, 1);
      renderSignersList();
      updateCertPreview();
    }

    function updateSignerData(index, field, value) {
      signaturesList[index][field] = value;
      updateCertPreview();
    }

    function loadSignerImage(fileInput, index) {
      const file = fileInput.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          signaturesList[index].img = e.target.result;
          renderSignersList();
          updateCertPreview();
        };
        reader.readAsDataURL(file);
      }
    }

    function addAvalRow() {
      if (avalesList.length >= 5) {
        alert("Se permite un máximo de 5 logos de avales académicos.");
        return;
      }
      avalesList.push({ img: '' });
      renderAvalesList();
      updateCertPreview();
    }

    function removeAval(index) {
      avalesList.splice(index, 1);
      renderAvalesList();
      updateCertPreview();
    }

    function loadAvalImage(fileInput, index) {
      const file = fileInput.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          avalesList[index].img = e.target.result;
          renderAvalesList();
          updateCertPreview();
        };
        reader.readAsDataURL(file);
      }
    }

    function renderSignersList() {
      const container = document.getElementById('signers-list-container');
      container.innerHTML = '';
      signaturesList.forEach((sig, index) => {
        const div = document.createElement('div');
        div.className = "flex flex-col gap-2 p-3 bg-slate-50 border border-slate-200/60 rounded-xl relative";
        div.innerHTML = `
          <button type="button" onclick="removeSigner(${index})" class="absolute top-2 right-2 text-rose-500 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 p-1.5 rounded-lg border border-rose-100 transition cursor-pointer text-[10px]" title="Eliminar Firma">
            <i class="fa-solid fa-trash-can"></i>
          </button>
          <div class="grid grid-cols-2 gap-2 pr-6">
            <div class="flex flex-col gap-1">
              <span class="text-[9px] text-slate-500 font-bold uppercase">Nombre</span>
              <input type="text" value="${sig.name || ''}" placeholder="Ej: Ing. Juan Estrada" oninput="updateSignerData(${index}, 'name', this.value)" class="bg-white border border-slate-200 rounded-lg py-1.5 px-2 outline-none focus:border-[#0A3C84] transition text-[11px] font-medium">
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-[9px] text-slate-500 font-bold uppercase">Cargo</span>
              <input type="text" value="${sig.role || ''}" placeholder="Ej: Presidente PE" oninput="updateSignerData(${index}, 'role', this.value)" class="bg-white border border-slate-200 rounded-lg py-1.5 px-2 outline-none focus:border-[#0A3C84] transition text-[11px] font-medium">
            </div>
          </div>
          <div class="flex gap-2 items-center">
            <div class="flex flex-col gap-1 flex-1">
              <span class="text-[9px] text-slate-500 font-bold uppercase">Imagen Firma (PNG transparente)</span>
              <input type="file" accept="image/png" onchange="loadSignerImage(this, ${index})" class="bg-white border border-slate-200 rounded-lg py-1 px-1.5 outline-none transition text-[9px] font-semibold w-full">
            </div>
            ${sig.img ? `
              <div class="w-12 h-10 bg-white border border-slate-200 rounded-lg flex items-center justify-center overflow-hidden flex-shrink-0 mt-3.5 p-0.5">
                <img src="${sig.img}" class="max-h-full max-w-full object-contain">
              </div>
            ` : ''}
          </div>
        `;
        container.appendChild(div);
      });
    }

    function renderAvalesList() {
      const container = document.getElementById('avales-list-container');
      container.innerHTML = '';
      avalesList.forEach((aval, index) => {
        const div = document.createElement('div');
        div.className = "flex flex-col gap-2 p-2.5 bg-slate-50 border border-slate-200/60 rounded-xl relative";
        div.innerHTML = `
          <button type="button" onclick="removeAval(${index})" class="absolute top-1.5 right-1.5 text-rose-500 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 p-1.5 rounded-lg border border-rose-100 transition cursor-pointer text-[9px]" title="Eliminar Logo">
            <i class="fa-solid fa-trash-can text-[9px]"></i>
          </button>
          <div class="flex flex-col gap-1 flex-1">
            <span class="text-[9px] text-slate-500 font-bold uppercase">Logo del Aval</span>
            <input type="file" accept="image/*" onchange="loadAvalImage(this, ${index})" class="bg-white border border-slate-200 rounded-lg py-1 px-1.5 outline-none transition text-[9px] font-semibold w-full pr-7">
          </div>
          ${aval.img ? `
            <div class="w-full h-10 bg-white border border-slate-200 rounded-lg flex items-center justify-center overflow-hidden p-1 mt-1">
              <img src="${aval.img}" class="max-h-full max-w-full object-contain">
            </div>
          ` : ''}
        `;
        container.appendChild(div);
      });
    }

    function updateCertPreview() {
      // 1. Background Template
      const bgImg = document.getElementById('prev-custom-bg');
      const borderFrame = document.getElementById('prev-border-frame');
      const bgVal = document.getElementById('cert-plantilla-fondo').value;
      if (bgVal) {
        bgImg.src = bgVal;
        bgImg.style.display = 'block';
        borderFrame.style.display = 'none';
      } else {
        bgImg.src = '';
        bgImg.style.display = 'none';
        borderFrame.style.display = 'block';
      }

      // 2. Event Title & Description
      const evTitle = document.getElementById('cert-nombre-evento').value || 'Conversatorio Nacional Multidisciplinario Virtual de Profesionales Ecuador';
      document.getElementById('prev-event-title').innerText = evTitle;
      document.getElementById('prev-event-desc').innerHTML = `Se certifica que usted participó en el <strong style="font-weight: 800; color: #0f172a;">${evTitle}</strong>, demostrando compromiso, pasión por el aprendizaje y firme determinación de crecimiento. Su participación refleja el espíritu de superación que impulsa a los estudiantes y profesionales del Ecuador a prepararse mejor cada día, contribuyendo a la construcción de un país con más conocimiento, oportunidades y desarrollo.`;

      // 3. Hours and Bullet
      const hours = parseInt(document.getElementById('cert-horas').value) || 0;
      const certTitle = document.getElementById('prev-cert-title');
      const hoursVal = document.getElementById('prev-hours-val');
      const hoursBullet = document.getElementById('prev-hours-bullet');
      if (hours > 0) {
        certTitle.innerText = 'CERTIFICADO DE HORAS ACADEMICAS';
        hoursVal.innerText = hours;
        hoursBullet.style.display = 'inline';
      } else {
        certTitle.innerText = 'CERTIFICADO DE ASISTENCIA';
        hoursBullet.style.display = 'none';
      }

      // 4. Signatures
      const sigRow = document.getElementById('prev-signatures-row');
      sigRow.innerHTML = '';
      if (signaturesList.length === 0) {
        // Fallback default signature block matching legacy
        const text = document.getElementById('cert-firma-texto').value || 'Firma Autorizada';
        const img = document.getElementById('cert-firma-imagen').value;
        const block = document.createElement('div');
        block.style.cssText = "display: flex; flex-direction: column; align-items: center; text-align: center; min-width: 150px; max-width: 220px;";
        block.innerHTML = `
          <div style="height: 48px; display: flex; align-items: flex-end; justify-content: center; margin-bottom: 0.5rem; width: 100%;">
            ${img ? `<img src="${img}" style="max-height: 100%; max-width: 130px; object-fit: contain;">` : `<span style="font-family: 'Dancing Script', cursive; font-size: 1.15rem; color: #64748b; opacity: 0.4; font-weight: 500;">Directorio Nacional</span>`}
          </div>
          <div style="width: 150px; border-top: 1px solid #cbd5e1; margin-bottom: 0.4rem;"></div>
          <span style="font-size: 0.65rem; font-weight: 800; color: #1e293b; text-transform: uppercase; line-height: 1.2;">${text}</span>
          <span style="font-size: 0.55rem; font-weight: 600; color: #64748b; line-height: 1.2;">Profesionales Ecuador</span>
        `;
        sigRow.appendChild(block);
      } else {
        signaturesList.forEach((sig) => {
          const block = document.createElement('div');
          block.style.cssText = "display: flex; flex-direction: column; align-items: center; text-align: center; min-width: 150px; max-width: 220px;";
          block.innerHTML = `
            <div style="height: 48px; display: flex; align-items: flex-end; justify-content: center; margin-bottom: 0.5rem; width: 100%;">
              ${sig.img ? `<img src="${sig.img}" style="max-height: 100%; max-width: 130px; object-fit: contain;">` : `<span style="font-family: 'Dancing Script', cursive; font-size: 1.15rem; color: #64748b; opacity: 0.4; font-weight: 500;">Firma</span>`}
            </div>
            <div style="width: 150px; border-top: 1px solid #cbd5e1; margin-bottom: 0.4rem;"></div>
            <span style="font-size: 0.65rem; font-weight: 800; color: #1e293b; text-transform: uppercase; line-height: 1.2;">${sig.name || 'Autoridad'}</span>
            <span style="font-size: 0.55rem; font-weight: 600; color: #64748b; line-height: 1.2;">${sig.role || 'Cargo'}</span>
          `;
          sigRow.appendChild(block);
        });
      }

      // 5. Avales
      const avalRow = document.getElementById('prev-avales-row');
      avalRow.innerHTML = '';
      const avalesConLogo = avalesList.filter((aval) => aval && aval.img);
      if (avalesConLogo.length === 0) {
        avalRow.style.borderTop = 'none';
        avalRow.style.paddingTop = '0';
        avalRow.style.marginTop = '0';
      } else {
        avalRow.style.borderTop = '1px solid rgba(226, 232, 240, 0.6)';
        avalRow.style.paddingTop = '1rem';
        avalRow.style.marginTop = '1.5rem';

        const label = document.createElement('span');
        label.innerText = 'Con el aval de';
        label.style.cssText = "font-size: 0.6rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap;";
        avalRow.appendChild(label);

        const logosRow = document.createElement('div');
        logosRow.style.cssText = "display: flex; justify-content: center; align-items: center; gap: 2rem; width: 100%;";
        
        avalesConLogo.forEach((aval) => {
          const img = document.createElement('img');
          img.src = aval.img;
          img.style.cssText = "height: 28px; max-width: 90px; object-fit: contain; filter: grayscale(10%) contrast(90%); opacity: 0.85;";
          logosRow.appendChild(img);
        });
        avalRow.appendChild(logosRow);
      }

      // Scale dynamically
      updatePreviewScale();
    }

    // ==========================================
    // CURRICULUM BUILDER & SUBMISSIONS GRADINGS JS
    // ==========================================
    let currentCursoId = null;

    // View toggling
    function openCurriculumBuilder(cursoId, cursoTitle) {
      currentCursoId = cursoId;
      document.getElementById('curriculum-course-title').innerText = 'Gestión de Temario - ' + cursoTitle;
      
      // Toggle visibility
      document.getElementById('curso-list-container').classList.add('hidden');
      document.getElementById('curso-curriculum-container').classList.remove('hidden');
      document.getElementById('curso-form-container').classList.add('hidden');
      document.getElementById('curso-floating-bar').classList.add('hidden');
      document.getElementById('curso-submissions-container').classList.add('hidden');
      
      // Load curriculum
      loadCurriculum();
    }

    function closeCurriculumBuilder() {
      currentCursoId = null;
      document.getElementById('curso-list-container').classList.remove('hidden');
      document.getElementById('curso-curriculum-container').classList.add('hidden');
    }

    function openSubmissionsViewer(cursoId, cursoTitle) {
      currentCursoId = cursoId;
      document.getElementById('submissions-course-title').innerText = 'Revisión de Tareas - ' + cursoTitle;
      
      // Toggle visibility
      document.getElementById('curso-list-container').classList.add('hidden');
      document.getElementById('curso-submissions-container').classList.remove('hidden');
      document.getElementById('curso-form-container').classList.add('hidden');
      document.getElementById('curso-floating-bar').classList.add('hidden');
      document.getElementById('curso-curriculum-container').classList.add('hidden');
      
      // Load submissions
      loadSubmissions();
    }

    function closeSubmissionsViewer() {
      currentCursoId = null;
      document.getElementById('curso-list-container').classList.remove('hidden');
      document.getElementById('curso-submissions-container').classList.add('hidden');
    }

    // AJAX operations
    async function loadCurriculum() {
      const container = document.getElementById('curriculum-tree-container');
      container.innerHTML = '<div class="text-center py-8 text-slate-400"><i class="fa-solid fa-spinner animate-spin text-lg mr-2"></i> Cargando temario...</div>';
      
      try {
        const res = await fetch(`/api/cursos/${currentCursoId}/curriculum`);
        const data = await res.json();
        if (data.success) {
          renderCurriculum(data.modules);
        } else {
          container.innerHTML = `<div class="text-rose-600 font-bold text-center py-8">${data.error || 'Error al cargar temario'}</div>`;
        }
      } catch (err) {
        console.error(err);
        container.innerHTML = `<div class="text-rose-600 font-bold text-center py-8">Error al cargar temario</div>`;
      }
    }

    function renderCurriculum(modules) {
      const container = document.getElementById('curriculum-tree-container');
      container.innerHTML = '';

      if (!modules || modules.length === 0) {
        container.innerHTML = `
          <div class="border-2 border-dashed border-slate-150 rounded-2xl p-10 text-center text-slate-400">
            <i class="fa-solid fa-folder-open text-3xl mb-2 text-slate-300"></i>
            <h4 class="text-xs font-black text-slate-700">No hay módulos o unidades</h4>
            <p class="text-[10px] text-slate-450 mt-1">Haga clic en "Agregar Módulo / Unidad" para empezar a estructurar el curso.</p>
          </div>
        `;
        return;
      }

      modules.forEach(mod => {
        const modEl = document.createElement('div');
        modEl.className = "bg-slate-50 border border-slate-100 rounded-2xl p-5 flex flex-col gap-4";
        
        let lessonsHtml = '';
        if (mod.lessons && mod.lessons.length > 0) {
          mod.lessons.forEach(les => {
            let videoBadge = les.videoUrl ? `<span class="bg-indigo-50 border border-indigo-100 text-indigo-600 text-[9px] font-bold px-2 py-0.5 rounded-md flex items-center gap-1.5"><i class="fa-solid fa-video"></i> Video Clase</span>` : '';
            
            // Resources html list
            let resourcesHtml = '';
            if (les.resources && les.resources.length > 0) {
              resourcesHtml = `
                <div class="mt-2.5 pt-2 border-t border-slate-100 flex flex-col gap-1.5">
                  <div class="text-[9px] font-black uppercase text-slate-400 tracking-wider">Material de Apoyo:</div>
                  <div class="flex flex-wrap gap-2">
                    ${les.resources.map(r => `
                      <div class="bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg py-1 px-2.5 text-[9px] font-bold text-slate-700 flex items-center gap-1.5 transition">
                        <a href="${r.url}" target="_blank" class="flex items-center gap-1"><i class="fa-solid fa-file-arrow-down text-slate-500"></i> ${r.nombre}</a>
                        <button onclick="deleteResource(${r.id})" class="text-rose-500 hover:text-rose-700 ml-1 cursor-pointer"><i class="fa-solid fa-trash-can"></i></button>
                      </div>
                    `).join('')}
                  </div>
                </div>
              `;
            }

            // Tasks html list
            let tasksHtml = '';
            if (les.tasks && les.tasks.length > 0) {
              tasksHtml = `
                <div class="mt-3 pt-2.5 border-t border-slate-100 flex flex-col gap-2">
                  <div class="text-[9px] font-black uppercase text-slate-400 tracking-wider">Tareas de la clase:</div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    ${les.tasks.map(t => `
                      <div class="bg-white border border-slate-150 rounded-xl p-3.5 flex flex-col justify-between gap-3 shadow-inner">
                        <div>
                          <div class="flex justify-between items-start gap-2">
                            <span class="font-extrabold text-slate-900 text-xs uppercase"><i class="fa-solid fa-file-pen text-[#5A7AF3] mr-1"></i> ${t.titulo}</span>
                            <span class="bg-[#5A7AF3]/10 text-[#5A7AF3] font-bold text-[9px] px-2 py-0.5 rounded-full">${t.puntos} pts</span>
                          </div>
                          ${t.descripcion ? `<p class="text-[10px] text-slate-455 mt-1 font-semibold leading-relaxed">${t.descripcion}</p>` : ''}
                          ${t.archivoUrl ? `
                            <div class="mt-2.5">
                              <a href="${t.archivoUrl}" target="_blank" class="text-[9px] font-bold text-[#5A7AF3] hover:underline flex items-center gap-1">
                                <i class="fa-solid fa-paperclip"></i> Descargar Adjunto de Tarea
                              </a>
                            </div>
                          ` : ''}
                        </div>
                        <div class="flex justify-end gap-1.5 border-t border-slate-50 pt-2 mt-1">
                          <button onclick='openTaskModal(${les.id}, ${t.id}, "${t.titulo.replace(/"/g, "&quot;").replace(/\'/g, "\\\'")}", "${(t.descripcion || '').replace(/\n/g, '\\n').replace(/"/g, "&quot;").replace(/\'/g, "\\\'")}", "${t.archivoUrl || ''}", ${t.puntos})' class="text-brand-blue hover:text-sky-800 text-[9px] font-bold px-2 py-1 rounded bg-brand-lightBlue cursor-pointer">Editar</button>
                          <button onclick="deleteTask(${t.id})" class="text-rose-600 hover:text-rose-800 text-[9px] font-bold px-2 py-1 rounded bg-rose-50 cursor-pointer">Eliminar</button>
                        </div>
                      </div>
                    `).join('')}
                  </div>
                </div>
              `;
            }

            lessonsHtml += `
              <div class="bg-white border border-slate-150 rounded-xl p-4 flex flex-col gap-2 shadow-sm font-sans">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest leading-none block">Clase / Lección • Orden ${les.orden}</span>
                    <h5 class="font-extrabold text-slate-900 text-sm mt-1 flex items-center gap-2">${les.titulo} ${videoBadge}</h5>
                    ${les.descripcion ? `<p class="text-xs text-slate-500 font-semibold mt-1 leading-relaxed">${les.descripcion}</p>` : ''}
                  </div>
                  <div class="flex items-center gap-1.5 flex-shrink-0">
                    <button onclick="openResourceModal(${les.id})" class="text-slate-600 hover:text-slate-800 bg-slate-50 hover:bg-slate-100 border border-slate-200 px-2 py-1.5 rounded-lg text-[9px] font-bold transition flex items-center gap-1 cursor-pointer">
                      <i class="fa-solid fa-file-circle-plus"></i> + Material
                    </button>
                    <button onclick="openTaskModal(${les.id})" class="text-slate-600 hover:text-slate-800 bg-slate-50 hover:bg-slate-100 border border-slate-200 px-2 py-1.5 rounded-lg text-[9px] font-bold transition flex items-center gap-1 cursor-pointer">
                      <i class="fa-solid fa-file-signature"></i> + Tarea
                    </button>
                    <button onclick='openLessonModal(${mod.id}, ${les.id}, "${les.titulo.replace(/"/g, "&quot;").replace(/\'/g, "\\\'")}", "${(les.descripcion || '').replace(/\n/g, '\\n').replace(/"/g, "&quot;").replace(/\'/g, "\\\'")}", "${les.videoUrl || ''}", ${les.orden})' class="text-brand-blue hover:text-sky-800 bg-brand-lightBlue px-2.5 py-1.5 rounded-lg text-[9px] font-bold transition cursor-pointer">Editar</button>
                    <button onclick="deleteLesson(${les.id})" class="text-rose-600 hover:text-rose-800 bg-rose-50 px-2.5 py-1.5 rounded-lg text-[9px] font-bold transition cursor-pointer">Eliminar</button>
                  </div>
                </div>
                ${resourcesHtml}
                ${tasksHtml}
              </div>
            `;
          });
        } else {
          lessonsHtml = `
            <div class="text-center py-4 text-slate-400 text-xs italic font-semibold">
              No hay lecciones agregadas en esta unidad.
            </div>
          `;
        }

        modEl.innerHTML = `
          <div class="flex items-center justify-between border-b border-slate-150/60 pb-3 font-sans">
            <div class="min-w-0">
              <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest leading-none block">Unidad • Orden ${mod.orden}</span>
              <h4 class="font-black text-slate-900 text-base mt-1 uppercase leading-tight">${mod.titulo}</h4>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="openLessonModal(${mod.id})" class="bg-[#5A7AF3]/10 hover:bg-[#5A7AF3]/15 text-[#5A7AF3] font-extrabold px-3 py-2 rounded-xl text-[10px] transition flex items-center gap-1.5 cursor-pointer">
                <i class="fa-solid fa-plus text-[9px]"></i> Agregar Clase
              </button>
              <button onclick='openModuleModal(${mod.id}, "${mod.titulo.replace(/"/g, "&quot;").replace(/\'/g, "\\\'")}", ${mod.orden})' class="text-slate-600 hover:text-slate-900 bg-slate-100 px-2.5 py-2 rounded-xl text-[10px] font-bold transition cursor-pointer">Editar</button>
              <button onclick="deleteModule(${mod.id})" class="text-rose-600 hover:text-rose-800 bg-rose-50 px-2.5 py-2 rounded-xl text-[10px] font-bold transition cursor-pointer">Eliminar</button>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            ${lessonsHtml}
          </div>
        `;
        container.appendChild(modEl);
      });
    }

    // Modal Module actions
    function openModuleModal(id = '', titulo = '', orden = '1') {
      document.getElementById('module-modal-id').value = id;
      document.getElementById('module-modal-titulo').value = titulo;
      document.getElementById('module-modal-orden').value = orden;
      document.getElementById('module-modal-title').innerText = id ? 'Editar Unidad/Módulo' : 'Agregar Unidad/Módulo';
      document.getElementById('curriculum-module-modal').classList.remove('hidden');
    }
    function closeModuleModal() {
      document.getElementById('curriculum-module-modal').classList.add('hidden');
      document.getElementById('module-modal-form').reset();
    }
    document.getElementById('module-modal-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const id = document.getElementById('module-modal-id').value;
      const titulo = document.getElementById('module-modal-titulo').value;
      const orden = document.getElementById('module-modal-orden').value;

      try {
        const res = await fetch(`/api/cursos/${currentCursoId}/modules`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, titulo, orden })
        });
        const data = await res.json();
        if (data.success) {
          closeModuleModal();
          loadCurriculum();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (err) {
        console.error(err);
        alert('Error de red al guardar unidad.');
      }
    });
    async function deleteModule(id) {
      if (!confirm('¿Está seguro de eliminar esta unidad/módulo y todo su contenido?')) return;
      try {
        const res = await fetch(`/api/cursos/${currentCursoId}/modules/${id}/delete`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          loadCurriculum();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (err) {
        console.error(err);
      }
    }

