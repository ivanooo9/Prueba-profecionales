              statusText.classList.add("text-emerald-600");
            }
            if (progressBar) progressBar.style.width = "100%";
            if (progressWrap) setTimeout(() => progressWrap.classList.add('hidden'), 3000);

            conversatorioSpeakers[index].videoUrl = "bunny:" + sigData.libraryId + ":" + sigData.videoId;

            // Actualizar la vista previa del video Bunny en el admin (sin re-renderizar todo)
            const preview = document.getElementById('speaker-video-preview-' + index);
            if (preview) {
              preview.innerHTML = '<iframe src="https://iframe.mediadelivery.net/embed/' + sigData.libraryId + '/' + sigData.videoId + '" class="w-full h-40 rounded-xl border border-slate-100" allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;fullscreen" allowfullscreen></iframe>';
              preview.classList.remove('hidden');
            }

            // Limpiar el input de YouTube como respaldo (el video ahora es de Bunny)
            const ytInput = document.getElementById('speaker-youtube-input-' + index);
            if (ytInput) ytInput.value = '';

            serializeConversatorioItinerary();
          }
        });

        upload.findPreviousUploads().then(function (previousUploads) {
          if (previousUploads.length) {
            upload.resumeFromPreviousUpload(previousUploads[0])
          }
          upload.start();
        });

      } catch (err) {
        console.error(err);
        if (statusText) statusText.innerText = "Error: " + err.message;
        if (progressBar) progressBar.classList.add('bg-red-500');
      }
    }

