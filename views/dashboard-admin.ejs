    function selectContactMessage(msg) {
      if (!msg) return;
      
      // Update reading pane visibility
      document.getElementById('msg-reader-empty').classList.add('hidden');
      document.getElementById('msg-reader-content').classList.remove('hidden');

      // Populate text fields
      document.getElementById('read-subject').innerText = msg.asunto || 'Sin Asunto';
      document.getElementById('read-subject-badge').innerText = msg.asunto || 'Mensaje';
      document.getElementById('read-name').innerText = msg.nombre || 'Anónimo';
      document.getElementById('read-email').innerText = msg.email || '';
      document.getElementById('read-email').href = 'mailto:' + (msg.email || '');
      document.getElementById('read-body').innerText = msg.mensaje || '';
      
      // Avatar Initial
      const initial = (msg.nombre || 'A').charAt(0).toUpperCase();
      document.getElementById('read-avatar').innerText = initial;

      // Format Date
      const dateObj = new Date(msg.fecha);
      const formattedDate = dateObj.toLocaleDateString('es-EC', { 
        day: '2-digit', month: 'long', year: 'numeric', 
        hour: '2-digit', minute: '2-digit', second: '2-digit' 
      });
      document.getElementById('read-date').innerText = formattedDate;

      // Update forms actions
      document.getElementById('read-mark-form').action = '/dashboard/admin/mensajes/read/' + msg.id;
      document.getElementById('read-delete-form').action = '/dashboard/admin/mensajes/delete/' + msg.id;

      // Show/hide mark as read button
      const markForm = document.getElementById('read-mark-form');
      if (msg.leido) {
        markForm.classList.add('hidden');
      } else {
        markForm.classList.remove('hidden');
      }

      // Highlight active card
      document.querySelectorAll('.msg-card').forEach(card => {
        card.classList.remove('border-brand-blue', 'bg-slate-50/70', 'ring-2', 'ring-brand-blue/10');
      });
      const activeCard = document.getElementById('msg-card-' + msg.id);
      if (activeCard) {
        activeCard.classList.add('border-brand-blue', 'bg-slate-50/70', 'ring-2', 'ring-brand-blue/10');
      }
    }

    // Initialize CMS page on load
    document.addEventListener('DOMContentLoaded', function() {
      const select = document.getElementById('cms-slug-select');
      if (select) {
        loadCmsPageData(select.value);
      }
    });
  </script>

