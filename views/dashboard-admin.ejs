              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Características (Una por línea)</label>
                <textarea name="caracteristicas" id="plan-caracteristicas" rows="4" required placeholder="Perfil profesional completo&#10;Apareces en búsquedas&#10;Insignia de verificado destacada" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition resize-none leading-relaxed"></textarea>
              </div>

              <div class="flex items-center gap-2">
                <input type="checkbox" name="popular" value="true" id="plan-popular" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                <label for="plan-popular" class="text-xs font-bold text-slate-700">Marcar como Popular (Borde destacado)</label>
              </div>

              <div class="flex justify-end gap-2 mt-4 pt-4 border-t border-slate-100 font-sans">
                <button type="button" onclick="cancelPlanEdit()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-4 rounded-xl transition text-xs">
                  Cancelar
                </button>
                <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-5 rounded-xl transition text-xs shadow-md">
                  Guardar Plan
                </button>
              </div>
            </form>
          </div>

          <!-- Table of active plans -->
          <div class="lg:col-span-2 bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm flex flex-col justify-between">
            <div>
              <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
                <h3 class="font-extrabold text-sm text-slate-900">Listado de Planes de Afiliación</h3>
                <span class="bg-[#0A3C84] text-white text-[9px] font-black px-2.5 py-0.5 rounded-full"><%= plans.length %> Configurados</span>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                  <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                    <tr>
                      <th class="px-6 py-4">Nombre / Descripción</th>
                      <th class="px-6 py-4 text-center">Precio</th>
                      <th class="px-6 py-4 text-center">Destacado</th>
                      <th class="px-6 py-4 text-right">Acciones</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-50 font-medium">
                    <% if (plans && plans.length > 0) { %>
                      <% plans.forEach(function(plan) { %>
                        <tr class="hover:bg-slate-50/50 transition">
                          <td class="px-6 py-4">
                            <div class="font-extrabold text-slate-900 text-sm"><%= plan.nombre %></div>
                            <div class="text-[10px] text-slate-400 mt-0.5"><%= plan.descripcion || 'Sin descripción' %></div>
                          </td>
                          <td class="px-6 py-4 text-center font-extrabold text-slate-800">$<%= plan.precio.toFixed(2) %></td>
                          <td class="px-6 py-4 text-center">
                            <% if (plan.popular) { %>
                              <span class="bg-blue-50 text-[#0A3C84] text-[9px] font-black px-2.5 py-0.5 rounded-full">Sí</span>
                            <% } else { %>
                              <span class="text-slate-400 text-xs">-</span>
                            <% } %>
                          </td>
                          <td class="px-6 py-4 text-right flex items-center justify-end gap-2.5">
                            <button onclick="editPlanById(<%= plan.id %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100/50 transition text-[10px]">
                              Editar
                            </button>
                            <form action="/dashboard/admin/plans/delete/<%= plan.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este plan?')">
                              <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold px-2.5 py-1.5 rounded-lg border border-rose-100 transition text-[10px]">
                                Eliminar
                              </button>
                            </form>
                          </td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-slate-400 font-semibold">
                          No hay planes registrados.
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB: BILLING PLANS (FACTURACIÓN SRI) -->
      <section id="tab-billing-plans" class="dash-tab-pane hidden flex flex-col gap-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-2.5">
              <i class="fa-solid fa-file-invoice-dollar text-emerald-600"></i> Planes de Facturación Electrónica SRI
            </h2>
            <p class="text-xs font-medium text-slate-500 mt-1">Configura los paquetes de comprobantes electrónicos, precios y límites por defecto del sistema.</p>
          </div>
        </div>

        <!-- Global System Invoicing Limits Configuration -->
        <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-4">
          <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-sliders text-blue-600"></i> Límites de Facturas Gratuitas por Defecto (Membresías Base)
          </h3>
          <form action="/dashboard/admin/billing-plans/system-limits" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Facturas Gratuitas - Plan GRATUITO</label>
              <input type="number" name="freeInvoiceLimit" value="<%= (typeof systemConfig !== 'undefined' && systemConfig.freeInvoiceLimit) ? systemConfig.freeInvoiceLimit : 5 %>" required min="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Facturas Incluidas - Plan PREMIUM</label>
              <input type="number" name="premiumInvoiceLimit" value="<%= (typeof systemConfig !== 'undefined' && systemConfig.premiumInvoiceLimit) ? systemConfig.premiumInvoiceLimit : 50 %>" required min="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
            </div>
            <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-2.5 px-5 rounded-xl transition text-xs shadow-md flex items-center justify-center gap-2 cursor-pointer h-[42px]">
              <i class="fa-solid fa-floppy-disk"></i> Guardar Limites Base
            </button>
          </form>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Formulario de Crear/Editar Plan SRI -->
          <div class="lg:col-span-1 bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6 self-start">
            <h3 class="font-extrabold text-sm text-slate-900" id="billing-plan-form-title">Crear Nuevo Paquete de Facturas</h3>
            <form action="/dashboard/admin/billing-plans" method="POST" class="flex flex-col gap-4" id="billing-plan-form">
              <input type="hidden" name="planId" id="billing-plan-id">
              
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nombre del Paquete *</label>
                <input type="text" name="nombre" id="billing-plan-nombre" required placeholder="Ej. Paquete 100 Facturas" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Descripción</label>
                <textarea name="descripcion" id="billing-plan-descripcion" rows="2" placeholder="Detalles del paquete de facturación..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]"></textarea>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Precio (USD) *</label>
                  <input type="number" step="0.01" name="precio" id="billing-plan-precio" required placeholder="15.00" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Límite Facturas *</label>
                  <input type="number" name="invoiceLimit" id="billing-plan-limit" required placeholder="100 (-1 = ilimitado)" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
                  <span class="text-[9px] text-slate-400 font-semibold block mt-0.5">Usa -1 para ilimitado</span>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Duración (Valor)</label>
                  <input type="number" name="duracionDias" id="billing-plan-duracion" value="30" min="1" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Tipo Duración</label>
                  <select name="duracionTipo" id="billing-plan-duracion-tipo" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
                    <option value="DIAS">Días</option>
                    <option value="MESES">Meses</option>
                    <option value="ANIO">Años</option>
                  </select>
                </div>
              </div>

              <div class="flex items-center gap-3 pt-2">
                <button type="submit" class="flex-1 bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3 px-4 rounded-xl transition text-xs shadow-md flex items-center justify-center gap-2 cursor-pointer">
                  <i class="fa-solid fa-plus"></i> <span id="billing-plan-submit-btn-text">Guardar Paquete</span>
                </button>
                <button type="button" onclick="resetBillingPlanForm()" id="billing-plan-cancel-btn" class="hidden px-4 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition cursor-pointer">
                  Cancelar
                </button>
              </div>
            </form>
          </div>

          <!-- Listado de Planes SRI -->
          <div class="lg:col-span-2 bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm flex flex-col">
            <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
              <h3 class="font-extrabold text-sm text-slate-900">Paquetes Disponibles en la Plataforma</h3>
              <span class="bg-emerald-50 text-emerald-700 text-xs font-black px-3 py-1 rounded-full"><%= typeof billingPlans !== 'undefined' ? billingPlans.length : 0 %> Registrados</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-4">Paquete</th>
                    <th class="px-6 py-4 text-center">Facturas</th>
                    <th class="px-6 py-4 text-center">Precio</th>
                    <th class="px-6 py-4 text-center">Estado</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                  <% if (typeof billingPlans !== 'undefined' && billingPlans && billingPlans.length > 0) { %>
                    <% billingPlans.forEach(function(bp) { %>
                      <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-6 py-4">
                          <div class="font-extrabold text-slate-900"><%= bp.nombre %></div>
                          <div class="text-[10px] text-slate-400"><%= bp.descripcion || 'Sin descripción' %></div>
                        </td>
                        <td class="px-6 py-4 text-center font-black text-[#0A3C84]">
                          <%= bp.invoiceLimit === -1 ? '∞ ILIMITADAS' : bp.invoiceLimit %>
                        </td>
                        <td class="px-6 py-4 text-center font-extrabold text-emerald-600">
                          $<%= bp.precio.toFixed(2) %>
                        </td>
                        <td class="px-6 py-4 text-center">
                          <span class="px-2.5 py-1 rounded-full text-[10px] font-black <%= bp.isActive ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-rose-50 text-rose-600 border border-rose-100' %>">
                            <%= bp.isActive ? 'ACTIVO' : 'INACTIVO' %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                          <button onclick="editBillingPlan(<%= bp.id %>, '<%= bp.nombre.replace(/'/g, "\\'") %>', '<%= (bp.descripcion || '').replace(/'/g, "\\'") %>', <%= bp.precio %>, <%= bp.invoiceLimit %>, <%= bp.duracionDias %>, '<%= bp.duracionTipo %>')" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold px-2.5 py-1.5 rounded-lg border border-slate-200 transition cursor-pointer">
                            <i class="fa-solid fa-pen-to-square"></i> Editar
                          </button>

                          <form action="/dashboard/admin/billing-plans/toggle/<%= bp.id %>" method="POST" class="inline">
                            <button type="submit" class="text-xs <%= bp.isActive ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200' %> font-bold px-2.5 py-1.5 rounded-lg border transition cursor-pointer">
                              <%= bp.isActive ? 'Desactivar' : 'Activar' %>
                            </button>
                          </form>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="px-6 py-12 text-center text-slate-400 font-semibold">
                        No hay paquetes de facturación configurados.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB: PROMOTION PLANS -->
      <section id="tab-promotion-plans" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Gestión de Banners, Pop-ups y Planes de Promoción</h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Form to create/edit promotion plan -->
          <div class="lg:col-span-1 bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6 self-start">
            <h3 class="font-extrabold text-sm text-slate-900" id="promotion-plan-form-title">Crear Nuevo Plan de Promoción</h3>
            <form action="/dashboard/admin/promotion-plans" method="POST" class="flex flex-col gap-4" id="promotion-plan-form">
              <input type="hidden" name="id" id="promotion-plan-id">
              
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Nombre del Plan</label>
                <input type="text" name="nombre" id="promotion-plan-nombre" required placeholder="Ej: Plan Destacado Home" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Precio (USD)</label>
                <input type="number" step="0.01" name="precio" id="promotion-plan-precio" required placeholder="Ej: 25.00" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center text-slate-800 font-extrabold">
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Duración en Días</label>
                <input type="number" name="duracionDias" id="promotion-plan-duracion" required value="30" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center text-slate-800">
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Descripción Corta</label>
                <input type="text" name="descripcion" id="promotion-plan-descripcion" placeholder="Ej: Banner en la home e importancia en la búsqueda" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
              </div>

              <div class="flex flex-col gap-2.5 pt-2">
                <span class="text-xs font-black uppercase text-slate-400 tracking-wider">Beneficios y Permisos</span>
                
                <div class="flex items-center gap-2.5">
                  <input type="checkbox" name="allowHomeBanner" value="true" id="promotion-plan-allowHomeBanner" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                  <label for="promotion-plan-allowHomeBanner" class="text-xs font-bold text-slate-700">Permitir Banner en Home</label>
                </div>

                <div class="flex items-center gap-2.5">
                  <input type="checkbox" name="allowCategoryBanner" value="true" id="promotion-plan-allowCategoryBanner" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                  <label for="promotion-plan-allowCategoryBanner" class="text-xs font-bold text-slate-700">Permitir Banner en Categoría</label>
                </div>

                <div class="flex items-center gap-2.5">
                  <input type="checkbox" name="allowPrioritySearch" value="true" id="promotion-plan-allowPrioritySearch" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                  <label for="promotion-plan-allowPrioritySearch" class="text-xs font-bold text-slate-700">Prioridad en Búsquedas</label>
                </div>

                <div class="flex items-center gap-2.5">
                  <input type="checkbox" name="allowPopupHome" value="true" id="promotion-plan-allowPopupHome" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                  <label for="promotion-plan-allowPopupHome" class="text-xs font-bold text-slate-700">Permitir Pop-up en Home</label>
                </div>

                <div class="flex items-center gap-2.5">
                  <input type="checkbox" name="allowPopupCategory" value="true" id="promotion-plan-allowPopupCategory" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                  <label for="promotion-plan-allowPopupCategory" class="text-xs font-bold text-slate-700">Permitir Pop-up en Categoría</label>
                </div>

                <div class="flex items-center gap-2.5">
                  <input type="checkbox" name="allowPopupSpecialty" value="true" id="promotion-plan-allowPopupSpecialty" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                  <label for="promotion-plan-allowPopupSpecialty" class="text-xs font-bold text-slate-700">Permitir Pop-up en Especialidad</label>
                </div>
              </div>

              <div class="flex justify-end gap-2 mt-4 pt-4 border-t border-slate-100 font-sans">
                <button type="button" onclick="cancelPromotionPlanEdit()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-4 rounded-xl transition text-xs">
                  Cancelar
                </button>
                <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-5 rounded-xl transition text-xs shadow-md">
                  Guardar Plan
                </button>
              </div>
            </form>
          </div>

          <!-- Table of active promotion plans -->
          <div class="lg:col-span-2 bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm flex flex-col justify-between">
            <div>
              <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
                <h3 class="font-extrabold text-sm text-slate-900">Planes de Promoción Configurados</h3>
                <span class="bg-[#0A3C84] text-white text-[9px] font-black px-2.5 py-0.5 rounded-full"><%= promotionPlans.length %> Configurados</span>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                  <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                    <tr>
                      <th class="px-6 py-4">Nombre / Descripción</th>
                      <th class="px-6 py-4 text-center">Duración</th>
                      <th class="px-6 py-4 text-center">Precio</th>
                      <th class="px-6 py-4">Beneficios Habilitados</th>
                      <th class="px-6 py-4 text-right">Acciones</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-50 font-medium font-sans">
                    <% if (promotionPlans && promotionPlans.length > 0) { %>
                      <% promotionPlans.forEach(function(pPlan) { %>
                        <tr class="hover:bg-slate-50/50 transition">
                          <td class="px-6 py-4">
                            <div class="font-extrabold text-slate-900 text-sm"><%= pPlan.nombre %></div>
                            <div class="text-[10px] text-slate-400 mt-0.5"><%= pPlan.descripcion || 'Sin descripción' %></div>
                          </td>
                          <td class="px-6 py-4 text-center text-slate-700 font-bold"><%= pPlan.duracionDias %> días</td>
                          <td class="px-6 py-4 text-center font-extrabold text-slate-800">$<%= pPlan.precio.toFixed(2) %></td>
                          <td class="px-6 py-4">
                            <div class="flex flex-wrap gap-1">
                              <% if (pPlan.allowHomeBanner) { %>
                                <span class="bg-emerald-50 text-emerald-700 text-[8px] font-black px-2 py-0.5 rounded-md">Banner Home</span>
                              <% } %>
                              <% if (pPlan.allowCategoryBanner) { %>
                                <span class="bg-emerald-50 text-emerald-700 text-[8px] font-black px-2 py-0.5 rounded-md">Banner Cat</span>
                              <% } %>
                              <% if (pPlan.allowPrioritySearch) { %>
                                <span class="bg-blue-50 text-blue-700 text-[8px] font-black px-2 py-0.5 rounded-md">Prioridad Búsqueda</span>
                              <% } %>
                              <% if (pPlan.allowPopupHome) { %>
                                <span class="bg-purple-50 text-purple-700 text-[8px] font-black px-2 py-0.5 rounded-md">Popup Home</span>
                              <% } %>
                              <% if (pPlan.allowPopupCategory) { %>
                                <span class="bg-purple-50 text-purple-700 text-[8px] font-black px-2 py-0.5 rounded-md">Popup Cat</span>
                              <% } %>
                              <% if (pPlan.allowPopupSpecialty) { %>
                                <span class="bg-purple-50 text-purple-700 text-[8px] font-black px-2 py-0.5 rounded-md">Popup Esp</span>
                              <% } %>
                              <% if (!pPlan.allowHomeBanner && !pPlan.allowCategoryBanner && !pPlan.allowPrioritySearch && !pPlan.allowPopupHome && !pPlan.allowPopupCategory && !pPlan.allowPopupSpecialty) { %>
                                <span class="text-slate-400 text-xs">-</span>
                              <% } %>
                            </div>
                          </td>
                          <td class="px-6 py-4 text-right flex items-center justify-end gap-2.5">
                            <button onclick="editPromotionPlanById(<%= pPlan.id %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100/50 transition text-[10px]">
                              Editar
                            </button>
                            <form action="/dashboard/admin/promotion-plans/delete/<%= pPlan.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este plan de promoción?')">
                              <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold px-2.5 py-1.5 rounded-lg border border-rose-100 transition text-[10px]">
                                Eliminar
                              </button>
                            </form>
                          </td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400 font-semibold">
                          No hay planes de promoción registrados.
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB: TEMPLATES -->
      <section id="tab-templates" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Diseños de Perfil Profesional</h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Form to create/edit template -->
          <div class="lg:col-span-1 bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6 self-start">
            <h3 class="font-extrabold text-sm text-slate-900" id="template-form-title">Crear Nueva Plantilla</h3>
            <form action="/dashboard/admin/templates" method="POST" class="flex flex-col gap-4" id="template-form">
              <input type="hidden" name="id" id="template-id">
              
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Nombre del Diseño</label>
                <input type="text" name="name" id="template-nombre" required placeholder="Ej: Plantilla Original" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Identificador Único (Key)</label>
                <input type="text" name="key" id="template-key" required placeholder="Ej: default" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Diseño Base (Base Layout)</label>
                <select name="baseLayout" id="template-base-layout" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-medium">
                  <option value="default">Plantilla Original (Clásica)</option>
                  <option value="ejecutiva">Diseño Ejecutivo (Premium)</option>
                  <option value="medica">Estilo Médico</option>
                </select>
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Descripción</label>
                <textarea name="description" id="template-descripcion" rows="3" placeholder="Ej: El diseño original del perfil profesional..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition resize-none leading-relaxed font-medium"></textarea>
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Captura de Previsualización</label>
                <input type="file" id="template-file-input" accept="image/*" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-4 file:py-2.5 file:rounded-xl file:text-xs file:font-bold file:cursor-pointer bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-slate-700">
              </div>

              <input type="hidden" name="thumbnail" id="template-thumbnail">

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Previsualización de Imagen</label>
                <div class="w-full h-32 rounded-2xl overflow-hidden bg-slate-550/5 border border-slate-100 flex items-center justify-center relative shadow-inner">
                  <img id="template-image-preview" src="" class="w-full h-full object-cover hidden">
                  <div id="template-preview-placeholder" class="text-slate-400 text-[10px] font-bold flex flex-col items-center gap-1.5">
                    <i class="fa-solid fa-image text-xl text-slate-350"></i>
                    <span>Sin imagen seleccionada</span>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <input type="checkbox" name="activo" value="true" id="template-activo" checked class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                <label for="template-activo" class="text-xs font-bold text-slate-700">Marcar como Activa</label>
              </div>

              <div class="flex justify-end gap-2 mt-4 pt-4 border-t border-slate-100 font-sans">
                <button type="button" onclick="cancelTemplateEdit()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-4 rounded-xl transition text-xs">
                  Cancelar
                </button>
                <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-5 rounded-xl transition text-xs shadow-md">
                  Guardar Plantilla
                </button>
              </div>
            </form>
          </div>

          <!-- Cards grid of templates -->
          <div class="lg:col-span-2 bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm flex flex-col justify-between">
            <div>
              <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
                <h3 class="font-extrabold text-sm text-slate-900">Diseños Disponibles</h3>
                <span class="bg-[#0A3C84] text-white text-[9px] font-black px-2.5 py-0.5 rounded-full"><%= typeof templates !== 'undefined' ? templates.length : 0 %> Plantillas</span>
              </div>
              
              <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6 max-h-[70vh] overflow-y-auto">
                <% if (typeof templates !== 'undefined' && templates && templates.length > 0) { %>
                  <% templates.forEach(function(tpl) { %>
                    <div class="bg-slate-50 border border-slate-100 rounded-2xl overflow-hidden flex flex-col shadow-sm">
                      <div class="w-full h-36 bg-slate-200 relative overflow-hidden group">
                        <% if (tpl.thumbnail && tpl.thumbnail.trim() !== '') { %>
                          <img src="<%= tpl.thumbnail.split(',')[0].trim() %>" onerror="this.onerror=null; this.src='/default-template.png';" class="w-full h-full object-cover">
                        <% } else { %>
                          <div class="w-full h-full flex flex-col items-center justify-center text-slate-400 gap-1 bg-slate-100 shadow-inner">
                            <i class="fa-solid fa-image text-3xl text-slate-300"></i>
                            <span class="text-[9px] font-bold uppercase tracking-wider text-slate-350">Sin previsualización</span>
                          </div>
                        <% } %>
                        <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                          <button type="button" onclick="previewTemplateImage(<%= tpl.id %>)" class="bg-white hover:bg-slate-100 text-slate-900 font-extrabold px-3 py-1.5 rounded-lg text-xs transition cursor-pointer">
                            <i class="fa-solid fa-eye mr-1"></i> Previsualizar
                          </button>
                        </div>
                      </div>
                      <div class="p-4 flex-grow flex flex-col justify-between gap-3">
                        <div>
                          <div class="flex justify-between items-start gap-2">
                            <h4 class="font-extrabold text-slate-900 text-xs"><%= tpl.name %></h4>
                            <span class="bg-slate-200 text-slate-600 text-[8px] font-bold px-1.5 py-0.5 rounded-md font-mono"><%= tpl.key %></span>
                          </div>
                          <p class="text-[10px] text-slate-500 mt-1 font-semibold line-clamp-2"><%= tpl.description || 'Sin descripción' %></p>
                        </div>
                        <div class="flex items-center justify-between mt-2 pt-3 border-t border-slate-200/50">
                          <span class="<%= tpl.activo ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %> text-[8px] font-black px-2 py-0.5 rounded-full uppercase tracking-wide">
                            <%= tpl.activo ? 'Activa' : 'Inactiva' %>
                          </span>
                          <div class="flex gap-1.5">
                            <button onclick="editTemplateById(<%= tpl.id %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100/50 transition text-[9px] cursor-pointer">
                              Editar
                            </button>
                            <% if (tpl.key !== 'default') { %>
                              <form action="/dashboard/admin/templates/delete/<%= tpl.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar esta plantilla?')">
                                <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold px-2.5 py-1.5 rounded-lg border border-rose-100 transition text-[9px] cursor-pointer">
                                  Eliminar
                                </button>
                              </form>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="col-span-2 py-12 text-center text-slate-400 font-semibold flex flex-col items-center gap-2">
                    <i class="fa-solid fa-palette text-3xl text-slate-200 animate-bounce"></i>
                    <span>No hay plantillas registradas.</span>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Configurar P.EC (Site Style / Branding Configuration) -->
      <section id="tab-style-config" class="dash-tab-pane hidden flex flex-col gap-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900">Configurar P.EC</h2>
            <p class="text-xs font-semibold text-slate-500 mt-1">Personaliza la identidad visual de la plataforma (colores, logotipos y tipografía).</p>
          </div>
        </div>

        <form id="style-config-form" action="/dashboard/admin/style-config" method="POST" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Col 1 & 2: Main styling options -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Branding Details Card -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4 text-left">
              <h3 class="text-sm font-extrabold text-slate-900 border-b border-slate-50 pb-2">
                <i class="fa-solid fa-signature text-blue-500 mr-1.5"></i> Nombre y Logotipos
              </h3>
              
              <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Nombre de la Plataforma</label>
                    <input type="text" name="systemName" value="<%= systemConfig.systemName %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                  </div>
                  <div>
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Número de WhatsApp (Botón Flotante)</label>
                    <input type="text" name="adminWhatsapp" value="<%= systemConfig.adminWhatsapp || '593999999999' %>" required placeholder="Ej: 593999999999" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                  </div>
                  <div>
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Correo del admin</label>
                    <input type="email" name="adminEmail" value="<%= systemConfig.adminEmail || '' %>" placeholder="admin@profesionales.ec" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    <p class="text-[9px] text-slate-400 mt-1 font-semibold">Recibirá alertas de transferencias pendientes por más de 24 horas.</p>
                  </div>
                  <div>
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Tiempo Mínimo en Ponencias (Minutos)</label>
                    <input type="number" name="tiempoMinimoPonenciaMinutos" value="<%= typeof systemConfig.tiempoMinimoPonenciaMinutos !== 'undefined' && systemConfig.tiempoMinimoPonenciaMinutos !== null ? systemConfig.tiempoMinimoPonenciaMinutos : 3 %>" min="0" max="180" step="1" required class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    <p class="text-[9px] text-slate-400 mt-1 font-semibold">Minutos requeridos para habilitar el check de completar ponencia (Ej: 3 min).</p>
                  </div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <!-- Navbar Logo Uploader -->
                  <div>
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Logotipo del Navbar (Cabecera)</label>
                    <div class="border-2 border-dashed border-slate-200 rounded-xl p-4 flex flex-col items-center justify-center bg-slate-50 hover:bg-slate-100/50 transition relative overflow-hidden mt-1 min-h-[140px]">
                      <input type="file" id="style-logo-file" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                      <input type="hidden" name="systemLogo" id="style-logo-base64" value="<%= systemConfig.systemLogo || '' %>">
                      
                      <div id="style-logo-empty" class="<%= systemConfig.systemLogo ? 'hidden' : '' %> text-center space-y-2 pointer-events-none">
                        <i class="fa-solid fa-cloud-arrow-up text-slate-350 text-2xl"></i>
                        <p class="text-[10px] font-bold text-slate-500">Haz clic o arrastra un logo</p>
                        <p class="text-[8px] text-slate-400">Recomendado: PNG fondo transparente (150x40px)</p>
                      </div>
                      
                      <div id="style-logo-preview-box" class="<%= systemConfig.systemLogo ? '' : 'hidden' %> flex flex-col items-center gap-2 relative z-20">
                        <img id="style-logo-preview" src="<%= systemConfig.systemLogo || '' %>" class="h-10 object-contain rounded border border-slate-150 p-1 bg-white">
                        <button type="button" onclick="clearStyleLogo('logo')" class="bg-rose-50 text-rose-600 hover:bg-rose-100 text-[9px] font-extrabold px-2.5 py-1 rounded-lg transition flex items-center gap-1 cursor-pointer">
                          <i class="fa-solid fa-trash-can"></i> Quitar Logo
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Login Logo Uploader -->
                  <div>
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Logotipo de Login y Registro</label>
                    <div class="border-2 border-dashed border-slate-200 rounded-xl p-4 flex flex-col items-center justify-center bg-slate-50 hover:bg-slate-100/50 transition relative overflow-hidden mt-1 min-h-[140px]">
                      <input type="file" id="style-login-logo-file" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                      <input type="hidden" name="loginLogo" id="style-login-logo-base64" value="<%= systemConfig.loginLogo || '' %>">
                      
                      <div id="style-login-logo-empty" class="<%= systemConfig.loginLogo ? 'hidden' : '' %> text-center space-y-2 pointer-events-none">
                        <i class="fa-solid fa-cloud-arrow-up text-slate-350 text-2xl"></i>
                        <p class="text-[10px] font-bold text-slate-500">Haz clic o arrastra un logo</p>
                        <p class="text-[8px] text-slate-400">Recomendado: PNG fondo transparente (220x60px)</p>
                      </div>
                      
                      <div id="style-login-logo-preview-box" class="<%= systemConfig.loginLogo ? '' : 'hidden' %> flex flex-col items-center gap-2 relative z-20">
                        <img id="style-login-logo-preview" src="<%= systemConfig.loginLogo || '' %>" class="h-10 object-contain rounded border border-slate-150 p-1 bg-white">
                        <button type="button" onclick="clearStyleLogo('login-logo')" class="bg-rose-50 text-rose-600 hover:bg-rose-100 text-[9px] font-extrabold px-2.5 py-1 rounded-lg transition flex items-center gap-1 cursor-pointer">
                          <i class="fa-solid fa-trash-can"></i> Quitar Logo
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Footer Logo Uploader -->
                  <div>
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Logotipo del Footer (Pie de Página)</label>
                    <div class="border-2 border-dashed border-slate-200 rounded-xl p-4 flex flex-col items-center justify-center bg-slate-50 hover:bg-slate-100/50 transition relative overflow-hidden mt-1 min-h-[140px]">
                      <input type="file" id="style-footer-logo-file" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                      <input type="hidden" name="footerLogo" id="style-footer-logo-base64" value="<%= systemConfig.footerLogo || '' %>">
                      
                      <div id="style-footer-logo-empty" class="<%= systemConfig.footerLogo ? 'hidden' : '' %> text-center space-y-2 pointer-events-none">
                        <i class="fa-solid fa-cloud-arrow-up text-slate-350 text-2xl"></i>
                        <p class="text-[10px] font-bold text-slate-500">Haz clic o arrastra un logo</p>
                        <p class="text-[8px] text-slate-400">Recomendado: Logo blanco/monocromo (160x40px)</p>
                      </div>
                      
                      <div id="style-footer-logo-preview-box" class="<%= systemConfig.footerLogo ? '' : 'hidden' %> flex flex-col items-center gap-2 relative z-20">
                        <img id="style-footer-logo-preview" src="<%= systemConfig.footerLogo || '' %>" class="h-10 object-contain rounded border border-slate-800 p-1 bg-slate-900">
                        <button type="button" onclick="clearStyleLogo('footer-logo')" class="bg-rose-50 text-rose-600 hover:bg-rose-100 text-[9px] font-extrabold px-2.5 py-1 rounded-lg transition flex items-center gap-1 cursor-pointer">
                          <i class="fa-solid fa-trash-can"></i> Quitar Logo
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Redes Sociales (Footer) -->
                <div class="border-t border-slate-100 pt-5 mt-5">
                  <h4 class="text-[11px] font-extrabold text-slate-800 mb-3 uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fa-solid fa-share-nodes text-blue-500"></i> Enlaces a Redes Sociales (Footer)
                  </h4>
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Facebook URL</label>
                      <input type="url" name="facebookUrl" value="<%= systemConfig.facebookUrl || '' %>" placeholder="https://facebook.com/..." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Instagram URL</label>
                      <input type="url" name="instagramUrl" value="<%= systemConfig.instagramUrl || '' %>" placeholder="https://instagram.com/..." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">YouTube URL</label>
                      <input type="url" name="youtubeUrl" value="" data-deferred-admin-field="youtubeUrl" placeholder="youtube.com/..." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">TikTok URL</label>
                      <input type="url" name="tiktokUrl" value="<%= systemConfig.tiktokUrl || '' %>" placeholder="https://tiktok.com/@..." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">LinkedIn URL</label>
                      <input type="url" name="linkedinUrl" value="<%= systemConfig.linkedinUrl || '' %>" placeholder="https://linkedin.com/in/..." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-4 text-xs font-bold outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                  </div>
                </div>

              </div>
            </div>

            <!-- Color Customizer Card -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5 text-left">
              <h3 class="text-sm font-extrabold text-slate-900 border-b border-slate-50 pb-2">
                <i class="fa-solid fa-palette text-indigo-500 mr-1.5"></i> Gama de Colores
              </h3>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Primary Color Input -->
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 rounded-2xl border border-slate-200 overflow-hidden relative shadow-sm flex-shrink-0">
                    <input type="color" id="primaryColorPicker" value="<%= systemConfig.primaryColor || '#0A3C84' %>" oninput="updateColorHex('primary')" class="absolute inset-0 scale-150 cursor-pointer">
                  </div>
                  <div class="flex-grow">
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Color Principal (Primary)</label>
                    <input type="text" name="primaryColor" id="primaryColorHex" value="<%= systemConfig.primaryColor || '#0A3C84' %>" oninput="updateColorPicker('primary')" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2 px-3.5 text-xs font-bold mt-1 uppercase text-slate-800">
                  </div>
                </div>

                <!-- Secondary Color Input -->
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 rounded-2xl border border-slate-200 overflow-hidden relative shadow-sm flex-shrink-0">
                    <input type="color" id="secondaryColorPicker" value="<%= systemConfig.secondaryColor || '#0a66c2' %>" oninput="updateColorHex('secondary')" class="absolute inset-0 scale-150 cursor-pointer">
                  </div>
                  <div class="flex-grow">
                    <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Color Secundario (Secondary)</label>
