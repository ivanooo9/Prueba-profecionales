    function openReviewPaymentModal(paymentObj) {
      activeReviewPayment = paymentObj;
      document.getElementById('review-alumno-name').innerText = paymentObj.alumnoName;
      document.getElementById('review-alumno-email').innerText = paymentObj.alumnoEmail;
      document.getElementById('review-banco').innerText = paymentObj.bancoDestino;
      document.getElementById('review-referencia').innerText = paymentObj.referencia;
      document.getElementById('review-monto').innerText = '$' + paymentObj.monto.toFixed(2);
      
      const statusEl = document.getElementById('review-estado');
      statusEl.innerText = paymentObj.estado;
      if (paymentObj.estado === 'APROBADO') {
        statusEl.className = "px-2 py-0.5 rounded-full text-[8px] font-black uppercase inline-block bg-emerald-50 text-emerald-600 border border-emerald-100";
        document.getElementById('review-btn-approve').classList.add('hidden');
        document.getElementById('review-btn-reject').classList.add('hidden');
      } else if (paymentObj.estado === 'PENDIENTE') {
        statusEl.className = "px-2 py-0.5 rounded-full text-[8px] font-black uppercase inline-block bg-amber-50 text-amber-600 border border-amber-100";
        document.getElementById('review-btn-approve').classList.remove('hidden');
        document.getElementById('review-btn-reject').classList.remove('hidden');
      } else {
        statusEl.className = "px-2 py-0.5 rounded-full text-[8px] font-black uppercase inline-block bg-rose-50 text-rose-600 border border-rose-100";
        document.getElementById('review-btn-approve').classList.add('hidden');
        document.getElementById('review-btn-reject').classList.add('hidden');
      }

      const imgEl = document.getElementById('review-image-preview');
      const dlLink = document.getElementById('review-download-link');
      if (paymentObj.comprobante) {
        imgEl.src = paymentObj.comprobante;
        dlLink.href = paymentObj.comprobante;
        dlLink.classList.remove('hidden');
        imgEl.classList.remove('hidden');
        imgEl.parentNode.classList.remove('hidden');
      } else {
        imgEl.src = '';
        dlLink.href = '#';
        dlLink.classList.add('hidden');
        imgEl.classList.add('hidden');
        imgEl.parentNode.classList.add('hidden');
      }

      // Reset zoom
      imgEl.style.transform = 'none';
      imgEl.classList.remove('cursor-zoom-out');
      imgEl.classList.add('cursor-zoom-in');
      isZoomed = false;

      document.getElementById('review-error-alert').classList.add('hidden');
      document.getElementById('review-payment-modal').classList.remove('hidden');
    }

    function closeReviewPaymentModal() {
      document.getElementById('review-payment-modal').classList.add('hidden');
      activeReviewPayment = null;
    }

    function zoomReviewImage(img) {
      if (!isZoomed) {
        img.style.transform = 'scale(1.8)';
        img.classList.remove('cursor-zoom-in');
        img.classList.add('cursor-zoom-out');
        isZoomed = true;
      } else {
        img.style.transform = 'none';
        img.classList.remove('cursor-zoom-out');
        img.classList.add('cursor-zoom-in');
        isZoomed = false;
      }
    }

    async function processReviewPayment(action) {
      if (!activeReviewPayment) return;
      const paymentId = activeReviewPayment.id;
      
      const errorAlert = document.getElementById('review-error-alert');
      const errorMsg = document.getElementById('review-error-msg');
      errorAlert.classList.add('hidden');

      const btnApprove = document.getElementById('review-btn-approve');
      const btnReject = document.getElementById('review-btn-reject');
      
      btnApprove.disabled = true;
      btnReject.disabled = true;
      
      try {
        const response = await fetch(`/dashboard/admin/payments/${action}/${paymentId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ ajax: true })
        });
        
        const result = await response.json();
        if (result.success) {
          closeReviewPaymentModal();
          if (window.activeEventStatsId && window.activeEventStatsType) {
            openEventStatsModal(window.activeEventStatsType, window.activeEventStatsId, document.getElementById('stats-event-title').innerText);
            setTimeout(() => {
              switchStatsTab('orders');
            }, 300);
          } else {
            window.location.reload();
          }
        } else {
          errorMsg.innerText = result.error || 'Ocurrió un error al procesar el pago.';
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        errorMsg.innerText = 'Error de conexión con el servidor.';
        errorAlert.classList.remove('hidden');
      } finally {
        btnApprove.disabled = false;
        btnReject.disabled = false;
      }
    }

