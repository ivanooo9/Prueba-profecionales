                <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> Edición Total
              </button>
              <button type="button" onclick="openSendTempAccessModal(${u.id}, '${(u.name || '').replace(/'/g, "\\'")}', '${u.email || ''}', '${u.role ? u.role.name : 'CLIENTE'}')" class="text-emerald-800 hover:text-emerald-950 bg-emerald-50 hover:bg-emerald-100 font-extrabold px-2.5 py-1.5 rounded-lg border border-emerald-200 transition text-[10px] cursor-pointer flex items-center gap-1" title="Enviar clave temporal y accesos por correo">
