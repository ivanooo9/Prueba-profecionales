    function loadCmsPageData(slug) {
      const page = cmsPagesList.find(p => p.slug === slug);
      
      const standardEditor = document.getElementById('cms-standard-editor');
      const contactEditor = document.getElementById('cms-contact-editor');
      const aboutEditor = document.getElementById('cms-about-editor');
      const faqEditor = document.getElementById('cms-faq-editor');
      const titleContainer = document.getElementById('cms-title-container');
      const titleInput = document.getElementById('cms-title-input');
      const contentTextarea = document.getElementById('cms-content-textarea');

      if (!standardEditor || !contactEditor || !aboutEditor || !titleContainer) return;

      // Hide all editors first
      standardEditor.classList.add('hidden');
      contactEditor.classList.add('hidden');
      aboutEditor.classList.add('hidden');
      if (faqEditor) faqEditor.classList.add('hidden');
      titleContainer.classList.remove('hidden');
      titleInput.required = true;
      contentTextarea.required = true;

      if (slug === 'contacto') {
        contactEditor.classList.remove('hidden');
        titleContainer.classList.add('hidden');
        titleInput.required = false;
        contentTextarea.required = false;

