    async function saveCertName() {
      if (!activeEditCertId) return;

      const input = document.getElementById('edit-cert-name-input');
      const errorAlert = document.getElementById('edit-cert-name-error');
      const errorMsg = document.getElementById('edit-cert-name-error-msg');
      const btnSave = document.getElementById('edit-cert-name-btn-save');
      const nombre = input.value.trim();

      errorAlert.classList.add('hidden');

      if (!nombre) {
        errorMsg.innerText = 'El nombre no puede estar vacío.';
        errorAlert.classList.remove('hidden');
        return;
      }

      btnSave.disabled = true;

      try {
        const response = await fetch(`/dashboard/admin/certificates/${activeEditCertId}/nombre`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ nombre })
        });

        const result = await response.json();
        if (result.success) {
          closeEditCertNameModal();
          if (window.activeEventStatsId && window.activeEventStatsType) {
            openEventStatsModal(window.activeEventStatsType, window.activeEventStatsId, document.getElementById('stats-event-title').innerText);
          }
        } else {
          errorMsg.innerText = result.error || 'Ocurrió un error al actualizar el nombre.';
          errorAlert.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        errorMsg.innerText = 'Error de conexión con el servidor.';
        errorAlert.classList.remove('hidden');
      } finally {
        btnSave.disabled = false;
      }
    }

    // Template management functions
    function editTemplateById(tplOrId) {
      let tpl = typeof tplOrId === 'object' ? tplOrId : systemTemplatesList.find(t => t.id === parseInt(tplOrId));
      if (!tpl) return;
      document.getElementById('template-form-title').innerText = "Editar Plantilla: " + tpl.name;
      document.getElementById('template-id').value = tpl.id;
      document.getElementById('template-nombre').value = tpl.name;
      document.getElementById('template-key').value = tpl.key;
      document.getElementById('template-base-layout').value = tpl.baseLayout || 'default';
      if (tpl.key === 'default') {
        document.getElementById('template-key').readOnly = true;
        document.getElementById('template-key').classList.add('bg-slate-100', 'text-slate-400');
        document.getElementById('template-base-layout').disabled = true;
        document.getElementById('template-base-layout').classList.add('bg-slate-100', 'text-slate-400');
      } else {
        document.getElementById('template-key').readOnly = false;
        document.getElementById('template-key').classList.remove('bg-slate-100', 'text-slate-400');
        document.getElementById('template-base-layout').disabled = false;
        document.getElementById('template-base-layout').classList.remove('bg-slate-100', 'text-slate-400');
      }
      document.getElementById('template-descripcion').value = tpl.description || '';
      document.getElementById('template-thumbnail').value = tpl.thumbnail || '';
      
      const previewImg = document.getElementById('template-image-preview');
      const placeholder = document.getElementById('template-preview-placeholder');
      if (tpl.thumbnail && tpl.thumbnail.trim() !== '') {
        previewImg.src = tpl.thumbnail;
        previewImg.classList.remove('hidden');
        placeholder.classList.add('hidden');
      } else {
        previewImg.src = '';
        previewImg.classList.add('hidden');
        placeholder.classList.remove('hidden');
      }
      
      document.getElementById('template-activo').checked = tpl.activo;
    }

    function cancelTemplateEdit() {
      document.getElementById('template-form-title').innerText = "Crear Nueva Plantilla";
      document.getElementById('template-id').value = '';
      document.getElementById('template-nombre').value = '';
      document.getElementById('template-key').value = '';
      document.getElementById('template-key').readOnly = false;
      document.getElementById('template-key').classList.remove('bg-slate-100', 'text-slate-400');
      document.getElementById('template-base-layout').value = 'default';
      document.getElementById('template-base-layout').disabled = false;
      document.getElementById('template-base-layout').classList.remove('bg-slate-100', 'text-slate-400');
      document.getElementById('template-descripcion').value = '';
      document.getElementById('template-thumbnail').value = '';
      
      document.getElementById('template-image-preview').src = '';
      document.getElementById('template-image-preview').classList.add('hidden');
      document.getElementById('template-preview-placeholder').classList.remove('hidden');
      document.getElementById('template-activo').checked = true;
      document.getElementById('template-file-input').value = '';
    }

