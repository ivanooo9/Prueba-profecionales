      document.getElementById('manual-enrollment-modal').classList.add('hidden');
    }

    async function submitManualEnrollment() {
      const email = document.getElementById('manual-enrollment-email').value.trim();
      const type = document.getElementById('manual-enrollment-type').value;
      const eventId = document.getElementById('manual-enrollment-event-id').value;
      const errorDiv = document.getElementById('manual-enrollment-error');
      const errorMsg = document.getElementById('manual-enrollment-error-msg');
      const successCard = document.getElementById('manual-enrollment-success-card');
      const formFields = document.getElementById('manual-enrollment-form-fields');
      const submitBtn = document.getElementById('manual-enrollment-submit-btn');
      const cancelBtn = document.getElementById('manual-enrollment-cancel-btn');

      errorDiv.classList.add('hidden');

      if (!email) {
        errorMsg.innerText = 'Por favor, ingrese el correo electrónico.';
        errorDiv.classList.remove('hidden');
        return;
      }

      if (!eventId) {
        errorMsg.innerText = 'Error: ID del evento no encontrado.';
        errorDiv.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Matriculando...';

      try {
        const response = await fetch('/api/admin/enrollments/manual', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ email, type, eventId })
        });

        const data = await response.json();

        if (data.success) {
          formFields.classList.add('hidden');
          submitBtn.classList.add('hidden');
          cancelBtn.classList.add('hidden');

          document.getElementById('success-email').innerText = data.email;
          document.getElementById('success-message').innerText = data.isNewUser
            ? `Usuario registrado. Las credenciales fueron enviadas al correo ${data.email}.`
            : `El usuario ya estaba registrado y ha sido matriculado correctamente en el evento.`;

          successCard.classList.remove('hidden');

          if (window.activeEventStatsId && window.activeEventStatsType === type && String(window.activeEventStatsId) === String(eventId)) {
            const statsTitle = document.getElementById('stats-event-title').innerText;
            openEventStatsModal(type, window.activeEventStatsId, statsTitle);
          }
        } else {
          errorMsg.innerText = data.error || 'Ocurrió un error inesperado.';
          errorDiv.classList.remove('hidden');
        }
      } catch (error) {
        console.error('Error in manual enrollment AJAX:', error);
        errorMsg.innerText = 'Error de red. No se pudo completar la matrícula.';
        errorDiv.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Matricular Alumno';
      }
    }

