              <option value="REGIMEN GENERAL">Régimen General</option>
              <option value="RIMPE EMPRENDEDOR">RIMPE Emprendedor</option>
              <option value="RIMPE POPULAR">RIMPE Popular</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Obligado Contabilidad</label>
            <select name="obligadoContabilidad" id="admin-issuer-contabilidad" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
              <option value="false">NO</option>
              <option value="true">SÍ</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Ambiente SRI</label>
            <select name="ambiente" id="admin-issuer-ambiente" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none">
              <option value="1">1 - Pruebas</option>
              <option value="2">2 - Producción</option>
            </select>
          </div>
        </div>

        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-3">
          <h4 class="text-xs font-extrabold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-key text-amber-500"></i> Firma Electrónica SRI (.p12)
          </h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Clave de la Firma (.p12)</label>
              <input type="password" name="codigoSri" id="admin-issuer-codigo-sri" placeholder="••••••••" class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none focus:border-[#0A3C84]">
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Archivo de Firma (.p12)</label>
              <input type="file" accept=".p12,.pfx" onchange="handleAdminFirmaFile(this)" class="w-full bg-white border border-slate-200 rounded-xl px-2 py-1.5 text-xs text-slate-600 outline-none">
            </div>
          </div>
          <div id="admin-issuer-firma-status"></div>
        </div>

        <div class="pt-3 flex items-center justify-end gap-3 border-t border-slate-100">
          <button type="button" onclick="closeAdminIssuerModal()" class="px-5 py-2.5 rounded-xl font-bold text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer">
            Cancelar
          </button>
          <button type="submit" class="px-6 py-2.5 rounded-xl font-extrabold text-xs bg-[#0A3C84] hover:bg-[#062450] text-white shadow-md transition cursor-pointer flex items-center gap-2">
            <i class="fa-solid fa-floppy-disk"></i> Guardar Emisor SRI
          </button>
        </div>
      </form>
    </div>
  </div>
  </div>
