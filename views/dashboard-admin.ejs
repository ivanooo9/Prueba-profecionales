    function editCurso(ev) {
      const listContainer = document.getElementById('curso-list-container');
      const headerContainer = document.getElementById('curso-header-container');
      const formContainer = document.getElementById('curso-form-container');
      const floatingBar = document.getElementById('curso-floating-bar');
      if (listContainer) listContainer.classList.add('hidden');
      if (headerContainer) headerContainer.classList.add('hidden');
      if (formContainer) formContainer.classList.remove('hidden');
      if (floatingBar) floatingBar.classList.remove('hidden');
      
      const titleEl = document.getElementById('curso-form-title');
      if (titleEl) titleEl.innerText = 'Editar Curso Académico';
      setElVal('curso-id', ev.id);
      
      setElVal('curso-estado', ev.estado || 'ACTIVO');
      setElVal('curso-slogan', ev.slogan || '');
      setElVal('curso-title', ev.titulo || '');
      setElVal('curso-professionId', ev.professionId || '');
      setElVal('curso-area', ev.areaProfesional || '');
      setElVal('curso-keywords', ev.keywords || '');
      setElVal('curso-desc', ev.descripcion || '');

      if (typeof populateAdminCourseCategories === 'function') {
        populateAdminCourseCategories(ev.professionId || '', ev.categoryId || '').then(() => {
          if (ev.categoryId) {
            setElVal('curso-categoryId', ev.categoryId);
            populateAdminCourseBranches(ev.categoryId, ev.branchId || '').then(() => {
              if (ev.branchId) {
                setElVal('curso-branchId', ev.branchId);
              }
            });
          }
        });
      }
      
      setElVal('curso-price', ev.precio !== undefined ? ev.precio : '0.00');
      setElVal('curso-descuentoEstudianteUsd', ev.descuentoEstudianteUsd !== undefined && ev.descuentoEstudianteUsd !== null ? ev.descuentoEstudianteUsd : '0.00');
      setElChk('curso-free', !!ev.gratuito);
      setElChk('curso-certificadoInmediato', ev.certificadoInmediato !== false);
      setElVal('curso-porcentajeMinimoCertificado', ev.porcentajeMinimoCertificado || 100);
      setElVal('curso-tiempoMinimoPermanenciaClaseSegundos', ev.tiempoMinimoPermanenciaClaseSegundos || 5);
      toggleCursoCertMinPct();
      toggleCursoFree();

      setElChk('curso-dest', ev.destacado);

      // Populate media fields
      const mediaType = ev.mediaType || 'imagen';
      const mediaUrl = ev.mediaUrl || ev.banner || ev.youtube || '';
      
      const mediaTypeSelect = document.getElementById('curso-mediaType');
      if (mediaTypeSelect) mediaTypeSelect.value = mediaType;
      
      const mediaUrlInput = document.getElementById('curso-mediaUrl');
      if (mediaUrlInput) mediaUrlInput.value = mediaUrl;
      
      if (mediaType === 'imagen') {
        const imageUrlInput = document.getElementById('curso-media-image-url');
        if (imageUrlInput) imageUrlInput.value = (mediaUrl && !mediaUrl.startsWith('data:')) ? mediaUrl : '';
        const videoUrlInput = document.getElementById('curso-media-video-url');
        if (videoUrlInput) videoUrlInput.value = '';
      } else {
        const videoUrlInput = document.getElementById('curso-media-video-url');
        if (videoUrlInput) videoUrlInput.value = (mediaUrl && !mediaUrl.startsWith('data:')) ? mediaUrl : '';
        const imageUrlInput = document.getElementById('curso-media-image-url');
        if (imageUrlInput) imageUrlInput.value = '';
      }
      
      toggleCursoMediaType();
      updateCursoMediaPreview(mediaUrl, mediaType);

      // Populate arrays
      cursoDiscounts = ev.discounts || [];
      cursoModules = ev.modules || [];
      
      cursoSpeakers = (ev.speakers || []).map(sp => {
        let parsedRedes = { facebook: '', twitter: '', instagram: '', linkedin: '' };
        if (sp.redes) {
          try {
            parsedRedes = typeof sp.redes === 'string' ? JSON.parse(sp.redes) : sp.redes;
          } catch(e) {}
        }
        parsedRedes = {
          facebook: parsedRedes.facebook || '',
          twitter: parsedRedes.twitter || '',
          instagram: parsedRedes.instagram || '',
          linkedin: parsedRedes.linkedin || ''
        };
        return {
          ...sp,
          redes: parsedRedes
        };
      });

      renderCursoDiscounts();
      renderCursoStructure();
      renderCursoSpeakers();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

