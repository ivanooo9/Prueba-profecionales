        <!-- SUBTAB 3: PROFESIONALES -->
        <div id="subtab-cuentas-profesionales" class="hidden flex flex-col gap-6">
          <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
            <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
              <h3 class="font-extrabold text-sm text-slate-900">Profesionales Afiliados</h3>
              <span class="bg-emerald-50 text-emerald-700 text-xs font-black px-3 py-1 rounded-full"><%= typeof allProfessionals !== 'undefined' ? allProfessionals.length : 0 %> Registrados</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-4">Profesional</th>
                    <th class="px-6 py-4">Slogan</th>
                    <th class="px-6 py-4 text-center">Estado</th>
                    <th class="px-6 py-4 text-center">Plan</th>
                    <th class="px-6 py-4 text-center">Verificado</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="profesionales-tbody" class="divide-y divide-slate-50 font-medium text-slate-700">
                  <% if (typeof allProfessionals !== 'undefined' && allProfessionals && allProfessionals.length > 0) { %>
                    <% allProfessionals.forEach(function(p) { %>
                      <% const profUserName = (p.user && p.user.name) ? p.user.name : 'Sin Nombre'; %>
                      <% const profUserEmail = (p.user && p.user.email) ? p.user.email : ''; %>
                      <% const safeProfName = profUserName.replace(/'/g, "\\'"); %>
                      <% const safeRuc = (p.issuer && p.issuer.ruc) ? p.issuer.ruc : ''; %>
                      <% const safeRazonSocial = (p.issuer && p.issuer.razonSocial) ? p.issuer.razonSocial.replace(/'/g, "\\'") : safeProfName; %>
                      <% const safeNombreComercial = (p.issuer && p.issuer.nombreComercial) ? p.issuer.nombreComercial.replace(/'/g, "\\'") : ''; %>
                      <% const safeDireccion = (p.issuer && p.issuer.direccionMatriz) ? p.issuer.direccionMatriz.replace(/'/g, "\\'") : ''; %>
                      <% const safeIssuerEmail = (p.issuer && p.issuer.email) ? p.issuer.email.replace(/'/g, "\\'") : profUserEmail.replace(/'/g, "\\'"); %>
                      <% const safeCelular = (p.issuer && p.issuer.celularContacto) ? p.issuer.celularContacto : ''; %>
                      <% const safeEstablecimiento = (p.issuer && p.issuer.establecimiento) ? p.issuer.establecimiento : '001'; %>
                      <% const safePuntoEmision = (p.issuer && p.issuer.puntoEmision) ? p.issuer.puntoEmision : '001'; %>
                      <% const safeSecuencial = (p.issuer && p.issuer.startSecuencial) ? p.issuer.startSecuencial : '000000001'; %>
                      <% const safeRegimen = (p.issuer && p.issuer.regimen) ? p.issuer.regimen : 'REGIMEN GENERAL'; %>
                      <% const safeContabilidad = (p.issuer && typeof p.issuer.obligadoContabilidad !== 'undefined') ? p.issuer.obligadoContabilidad : false; %>
                      <% const safeAmbiente = (p.issuer && p.issuer.ambiente) ? p.issuer.ambiente : '1'; %>
                      <tr class="hover:bg-slate-50/50 transition" data-name="<%= profUserName.toLowerCase() %>" data-email="<%= profUserEmail.toLowerCase() %>" data-status="<%= p.status %>">
                        <td class="px-6 py-4">
                          <div class="font-bold text-slate-900 flex items-center gap-1.5">
                            <%= profUserName %>
                            <% if (p.isPonente) { %>
                              <span class="bg-amber-500 text-white text-[8px] font-black px-1.5 py-0.5 rounded-md shadow-xs flex items-center gap-0.5" title="Conferencista / Ponente Oficial (Facturación Electrónica Ilimitada)">
                                <i class="fa-solid fa-microphone text-[8px]"></i> PONENTE
                              </span>
                            <% } %>
                          </div>
                          <div class="text-[10px] text-slate-400"><%= profUserEmail %></div>
                        </td>
                        <td class="px-6 py-4 text-slate-600"><%= p.slogan || 'No especificado' %></td>
                        <td class="px-6 py-4 text-center">
                          <span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= p.status === 'APROBADO' ? 'bg-emerald-50 text-emerald-600' : p.status === 'RECHAZADO' ? 'bg-rose-50 text-rose-600' : 'bg-amber-50 text-amber-600' %>">
                            <%= p.status %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-center font-bold text-slate-700"><%= p.planType %></td>
                        <td class="px-6 py-4 text-center">
                          <% if (p.verified) { %>
                            <span class="bg-blue-50 text-brand-blue text-[9px] font-bold px-2.5 py-0.5 rounded-full"><i class="fa-solid fa-circle-check text-[10px]"></i> Sí</span>
                          <% } else { %>
                            <span class="bg-slate-100 text-slate-500 text-[9px] font-bold px-2.5 py-0.5 rounded-full">No</span>
                          <% } %>
                        </td>
                        <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                          <form action="/dashboard/admin/professionals/<%= p.id %>/toggle-ponente" method="POST" class="inline">
                            <button type="submit" class="px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] <%= p.isPonente ? 'bg-amber-100 text-amber-900 border border-amber-300' : 'bg-slate-100 text-slate-600 border border-slate-200' %> transition cursor-pointer flex items-center gap-1" title="Otorgar o quitar estatus de Ponente (Facturación Electrónica Ilimitada)">
                              <i class="fa-solid fa-microphone text-amber-600"></i> <%= p.isPonente ? 'Quitar Ponente' : '+ Ponente' %>
                            </button>
                          </form>

                          <button type="button" onclick="openAdminIssuerModal(<%= p.id %>)" class="px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition cursor-pointer flex items-center gap-1" title="Configurar Emisor SRI del Profesional">
                            <i class="fa-solid fa-file-invoice text-emerald-600"></i> Emisor SRI
                          </button>
                          <% if (p.status === 'PENDIENTE') { %>
                            <form action="/dashboard/admin/professionals/approve/<%= p.id %>" method="POST" class="inline">
                              <button type="submit" class="px-3 py-1.5 rounded-lg font-extrabold text-[10px] bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm transition cursor-pointer flex items-center gap-1">
                                <i class="fa-solid fa-check"></i> Aprobar
                              </button>
                            </form>
                            <form action="/dashboard/admin/professionals/reject/<%= p.id %>" method="POST" class="inline">
                              <button type="submit" class="px-3 py-1.5 rounded-lg font-extrabold text-[10px] bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 transition cursor-pointer flex items-center gap-1">
                                <i class="fa-solid fa-xmark"></i> Rechazar
                              </button>
                            </form>
                          <% } %>
                          <button type="button" onclick="openSendTempAccessModal(<%= p.user ? p.user.id : (p.userId || p.id) %>, '<%= safeProfName %>', '<%= profUserEmail.replace(/'/g, "\\'") %>', 'PROFESIONAL')" class="px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition cursor-pointer flex items-center gap-1" title="Enviar clave temporal y accesos por correo">
                            <i class="fa-solid fa-paper-plane text-emerald-600"></i> Enviar Accesos
                          </button>

                          <button onclick="openResetPasswordModal(<%= p.user ? p.user.id : (p.userId || p.id) %>, '<%= safeProfName %>', '<%= profUserEmail.replace(/'/g, "\\'") %>')" class="text-amber-700 hover:text-amber-900 bg-amber-50 hover:bg-amber-100 font-bold px-2.5 py-1.5 rounded-lg border border-amber-200 transition text-[10px] cursor-pointer flex items-center gap-1">
                            <i class="fa-solid fa-key"></i> Reset Clave
                          </button>

                          <button type="button" onclick="openSuperAdminProfileModal(<%= p.user ? p.user.id : (p.userId || p.id) %>)" class="px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition cursor-pointer flex items-center gap-1" title="Superpoderes de Administración">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> Edición Total
                          </button>
                          <button onclick="inspectProfile(<%= p.id %>)" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold px-3 py-1.5 rounded-lg border border-slate-200/50 transition cursor-pointer">
                            Inspeccionar / Editar
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                        No hay profesionales en el sistema.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
            <!-- Pagination Bar Profesionales -->
            <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 flex flex-col md:flex-row items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="text-xs font-bold text-slate-500">Mostrar:</span>
                <select id="profesionales-pagesize-select" class="bg-white border border-slate-200 rounded-xl py-1 px-2 text-xs font-bold text-slate-700 outline-none">
                  <option value="10" selected>10 filas</option>
                  <option value="25">25 filas</option>
                  <option value="50">50 filas</option>
                  <option value="100">100 filas</option>
                </select>
                <span class="text-xs font-bold text-slate-500 ml-2" id="profesionales-pagination-counter">
                  Mostrando 1 - 10 de <%= typeof allProfessionals !== 'undefined' ? allProfessionals.length : 0 %> profesionales
                </span>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" id="profesionales-prev-btn" class="px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-extrabold text-xs transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-sm flex items-center gap-1.5">
                  <i class="fa-solid fa-chevron-left text-[10px]"></i> Anterior
                </button>
                <span id="profesionales-page-indicator" class="text-xs font-black px-3.5 py-1.5 bg-white border border-slate-200 rounded-xl text-slate-800 shadow-sm">
                  Página 1
                </span>
                <button type="button" id="profesionales-next-btn" class="px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-extrabold text-xs transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed shadow-sm flex items-center gap-1.5">
                  Siguiente <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- SUBTAB 4: SOLICITUDES DE TRANSICIÓN DE ROL -->
        <div id="subtab-cuentas-solicitudes" class="hidden flex flex-col gap-6">
          <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
            <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
              <h3 class="font-extrabold text-sm text-slate-900">Solicitudes de Actualización de Rol</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-4">Usuario Solicitante</th>
                    <th class="px-6 py-4">Rol Solicitado</th>
                    <th class="px-6 py-4">Comprobante / Título</th>
                    <th class="px-6 py-4 text-center">Estado</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                  <% if (typeof roleTransitionRequests !== 'undefined' && roleTransitionRequests && roleTransitionRequests.length > 0) { %>
                    <% roleTransitionRequests.forEach(function(req) { %>
                      <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-6 py-4">
                          <div class="font-bold text-slate-900"><%= req.user.name %></div>
                          <div class="text-[10px] text-slate-400"><%= req.user.email %></div>
                        </td>
                        <td class="px-6 py-4 font-bold text-blue-800">
                          <%= req.targetRole %>
                        </td>
                        <td class="px-6 py-4">
                          <% if (req.documentUrl) { %>
                            <a href="<%= req.documentUrl %>" target="_blank" class="text-sky-600 hover:underline font-bold flex items-center gap-1 text-[10px]">
                              <i class="fa-solid fa-file-pdf"></i> Ver Documento
                            </a>
                          <% } else { %>
                            <span class="text-slate-400 text-[10px]">Sin adjunto</span>
                          <% } %>
                        </td>
                        <td class="px-6 py-4 text-center">
                          <span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= req.estado === 'APROBADA' ? 'bg-emerald-50 text-emerald-600' : req.estado === 'RECHAZADA' ? 'bg-rose-50 text-rose-600' : 'bg-amber-50 text-amber-600' %>">
                            <%= req.estado %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                          <button type="button" onclick="openSuperAdminProfileModal(<%= req.user.id %>)" class="px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition cursor-pointer flex items-center gap-1" title="Superpoderes de Administración">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> Edición Total
                          </button>
                          <% if (req.estado === 'PENDIENTE') { %>
                            <form action="/dashboard/admin/role-transitions/<%= req.id %>/approve" method="POST">
                              <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold px-3 py-1 rounded-lg text-[10px]">Aprobar</button>
                            </form>
                            <form action="/dashboard/admin/role-transitions/<%= req.id %>/reject" method="POST">
                              <button type="submit" class="bg-rose-50 text-rose-600 hover:bg-rose-100 font-extrabold px-3 py-1 rounded-lg text-[10px]">Rechazar</button>
                            </form>
                          <% } else { %>
                            <span class="text-slate-400 text-[10px]">Procesada</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="px-6 py-12 text-center text-slate-400 font-semibold">
                        No hay solicitudes de transición registradas.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- SUBTAB 5: RED DE REFERIDOS -->
        <div id="subtab-cuentas-referidos" class="hidden flex flex-col gap-6">
          <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
            <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
              <h3 class="font-extrabold text-sm text-slate-900">Afiliados Comerciales de la Red</h3>
              <span class="bg-amber-50 text-amber-800 text-xs font-black px-3 py-1 rounded-full"><%= typeof referralProfiles !== 'undefined' ? referralProfiles.length : 0 %> Afiliados</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-4">Afiliado</th>
                    <th class="px-6 py-4">Código Referido</th>
                    <th class="px-6 py-4 text-center">Ventas Realizadas</th>
                    <th class="px-6 py-4 text-center">Saldo Billetera</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                  <% if (typeof referralProfiles !== 'undefined' && referralProfiles && referralProfiles.length > 0) { %>
                    <% referralProfiles.forEach(function(ref) { %>
                      <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-6 py-4">
                          <div class="font-bold text-slate-900"><%= ref.user.name %></div>
                          <div class="text-[10px] text-slate-400"><%= ref.user.email %></div>
                        </td>
                        <td class="px-6 py-4 font-mono font-bold text-blue-700"><%= ref.code %></td>
                        <td class="px-6 py-4 text-center font-extrabold"><%= ref._count ? ref._count.sales : 0 %></td>
                        <td class="px-6 py-4 text-center font-black text-emerald-600">$<%= ref.wallet ? (typeof ref.wallet.saldoDisponible !== 'undefined' && ref.wallet.saldoDisponible !== null ? Number(ref.wallet.saldoDisponible).toFixed(2) : (typeof ref.wallet.balance !== 'undefined' && ref.wallet.balance !== null ? Number(ref.wallet.balance).toFixed(2) : '0.00')) : '0.00' %></td>
                        <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                          <button type="button" onclick="openSuperAdminProfileModal(<%= ref.user.id %>)" class="px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition cursor-pointer flex items-center gap-1" title="Superpoderes de Administración">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> Edición Total
                          </button>
                          <button onclick="switchTab('referidos')" class="text-amber-700 bg-amber-50 hover:bg-amber-100 font-bold px-2.5 py-1 rounded text-[10px]">
                            Ver Billetera
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="px-6 py-12 text-center text-slate-400 font-semibold">
                        No hay afiliados registrados en la red.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB: PROFESIONALES (Ver, Editar, Aprobaciones) -->
      <section id="tab-professionals" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Gestión de Profesionales</h2>
        
        <!-- Solicites pendientes -->
        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-slate-900">Solicitudes de Registro Pendientes</h3>
            <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full"><%= pendingProfessionals.length %> Pendientes</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                <tr>
                  <th class="px-6 py-4">Profesional</th>
                  <th class="px-6 py-4">Slogan</th>
                  <th class="px-6 py-4">Ubicación</th>
                  <th class="px-6 py-4 text-center">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium">
                <% if (pendingProfessionals.length > 0) { %>
                  <% pendingProfessionals.forEach(function(p) { %>
                    <tr class="hover:bg-slate-50/50 transition">
                      <td class="px-6 py-4">
                        <div class="font-bold text-slate-900"><%= p.user.name %></div>
                        <div class="text-[10px] text-slate-400"><%= p.user.email %></div>
                      </td>
                      <td class="px-6 py-4 text-slate-600"><%= p.slogan || 'No especificado' %></td>
                      <td class="px-6 py-4 text-slate-600"><%= p.ciudad %>, <%= p.provincia %></td>
                      <td class="px-6 py-4 flex items-center justify-center gap-2">
                        <button onclick="inspectProfile(<%= p.id %>)" class="text-xs bg-brand-lightBlue hover:bg-slate-200 text-brand-blue font-bold px-3 py-1.5 rounded-lg transition border border-brand-blue/10 cursor-pointer">
                          Revisar
                        </button>
                        <form action="/dashboard/admin/approve/<%= p.id %>" method="POST">
                          <button type="submit" class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 hover:bg-emerald-100 flex items-center justify-center transition border border-emerald-100/50">
                            <i class="fa-solid fa-check"></i>
                          </button>
                        </form>
                        <form action="/dashboard/admin/reject/<%= p.id %>" method="POST">
                          <button type="submit" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 flex items-center justify-center transition border border-rose-100/50">
                            <i class="fa-solid fa-xmark"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="px-6 py-12 text-center text-slate-400">
                      No hay solicitudes pendientes de aprobación.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Todos los profesionales -->
        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm mt-6">
          <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-slate-900">Listado General de Profesionales</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                <tr>
                  <th class="px-6 py-4">Profesional</th>
                  <th class="px-6 py-4">Slogan</th>
                  <th class="px-6 py-4 text-center">Estado</th>
                  <th class="px-6 py-4 text-center">Plan</th>
                  <th class="px-6 py-4 text-center">Verificado</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium">
                <% if (allProfessionals.length > 0) { %>
                  <% allProfessionals.forEach(function(p) { %>
                    <tr class="hover:bg-slate-50/50 transition">
                      <td class="px-6 py-4">
                        <div class="font-bold text-slate-900"><%= p.user.name %></div>
                        <div class="text-[10px] text-slate-400"><%= p.user.email %></div>
                      </td>
                      <td class="px-6 py-4 text-slate-600"><%= p.slogan || 'No especificado' %></td>
                      <td class="px-6 py-4 text-center">
                        <span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= p.status === 'APROBADO' ? 'bg-emerald-50 text-emerald-600' : p.status === 'RECHAZADO' ? 'bg-rose-50 text-rose-600' : 'bg-amber-50 text-amber-600' %>">
                          <%= p.status %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-center font-bold text-slate-700"><%= p.planType %></td>
                      <td class="px-6 py-4 text-center">
                        <% if (p.verified) { %>
                          <span class="bg-blue-50 text-brand-blue text-[9px] font-bold px-2.5 py-0.5 rounded-full"><i class="fa-solid fa-circle-check text-[10px]"></i> Sí</span>
                        <% } else { %>
                          <span class="bg-slate-100 text-slate-500 text-[9px] font-bold px-2.5 py-0.5 rounded-full">No</span>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                        <button type="button" onclick="openSuperAdminProfileModal(<%= p.user ? p.user.id : (p.userId || p.id) %>)" class="text-xs bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 font-extrabold px-3 py-1.5 rounded-lg transition shadow-sm flex items-center gap-1 cursor-pointer" title="Superpoderes de Administración">
                          <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> Edición Total
                        </button>
                        <button onclick="inspectProfile(<%= p.id %>)" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold px-3 py-1.5 rounded-lg border border-slate-200/50 transition cursor-pointer">
                          Inspeccionar
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                      No hay profesionales en el sistema.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB: ESTUDIANTES -->
      <section id="tab-students" class="dash-tab-pane hidden flex flex-col gap-6 font-sans">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-graduation-cap text-blue-600"></i> Gestión de Estudiantes Registrados
            </h2>
            <p class="text-xs text-slate-450 mt-1 font-medium">Listado de estudiantes universitarios y tecnológicos en la plataforma. Puedes suspender o reactivar su cuenta.</p>
          </div>
        </div>

        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                <tr>
                  <th class="px-6 py-4">Estudiante</th>
                  <th class="px-6 py-4">Universidad / Instituto</th>
                  <th class="px-6 py-4">Carrera</th>
                  <th class="px-6 py-4 text-center">Estado Carrera</th>
                  <th class="px-6 py-4 text-center">Estado Cuenta</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                <% if (typeof studentsList !== 'undefined' && studentsList && studentsList.length > 0) { %>
                  <% studentsList.forEach(function(st) { %>
                    <tr class="hover:bg-slate-50/50 transition">
                      <td class="px-6 py-4 flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-slate-100 overflow-hidden shrink-0 border border-slate-200">
                          <img src="<%= st.studentProfile && st.studentProfile.foto ? st.studentProfile.foto : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=200' %>" alt="<%= st.name %>" class="w-full h-full object-cover">
                        </div>
                        <div>
                          <div class="font-extrabold text-slate-900"><%= st.name %></div>
                          <div class="text-[10px] text-slate-400"><%= st.email %></div>
                        </div>
                      </td>
                      <td class="px-6 py-4 font-semibold text-slate-800">
                        <%= st.studentProfile ? st.studentProfile.institucionEducativa : 'No especificada' %>
                      </td>
                      <td class="px-6 py-4 text-slate-600">
                        <%= st.studentProfile ? st.studentProfile.carrera : 'No especificada' %>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black <%= st.studentProfile && st.studentProfile.estadoCarrera === 'EGRESADO' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800' %>">
                          <%= st.studentProfile && st.studentProfile.estadoCarrera === 'EGRESADO' ? 'EGRESADO' : 'EN CURSO' %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black <%= st.status === 'SUSPENDED' ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800' %>">
                          <%= st.status === 'SUSPENDED' ? 'SUSPENDIDA' : 'ACTIVA' %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <button type="button" onclick="openSuperAdminProfileModal(<%= st.id %>)" class="px-3 py-1.5 rounded-xl font-extrabold text-[11px] bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 shadow-sm transition cursor-pointer flex items-center gap-1" title="Superpoderes de Administración">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> Edición Total
                          </button>
                          <form action="/dashboard/admin/students/status/<%= st.id %>" method="POST" class="inline-block">
                            <input type="hidden" name="status" value="<%= st.status === 'SUSPENDED' ? 'ACTIVE' : 'SUSPENDED' %>">
                            <button type="submit" class="px-3 py-1.5 rounded-xl font-bold text-[11px] transition cursor-pointer <%= st.status === 'SUSPENDED' ? 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'bg-rose-50 text-rose-700 hover:bg-rose-100' %>">
                              <%= st.status === 'SUSPENDED' ? 'Reactivar' : 'Suspender' %>
                            </button>
                          </form>
                          <form action="/dashboard/admin/students/delete/<%= st.id %>" method="POST" class="inline-block" onsubmit="return confirm('¿Está seguro de eliminar definitivamente a este estudiante? Se borrarán sus proyectos, certificados y su correo quedará libre.');">
                            <button type="submit" class="px-3 py-1.5 rounded-xl font-bold text-[11px] bg-rose-600 hover:bg-rose-700 text-white shadow-sm transition cursor-pointer flex items-center gap-1">
                              <i class="fa-solid fa-trash-can text-[10px]"></i> Eliminar
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                      No hay estudiantes registrados actualmente.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB: GESTIÓN DE UNIVERSIDADES E INSTITUTOS SUPERIORES -->
      <section id="tab-universities" class="dash-tab-pane hidden flex flex-col gap-6 font-sans">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-building-columns text-blue-600"></i> Universidades e Institutos del Ecuador
            </h2>
            <p class="text-xs text-slate-450 mt-1 font-medium">Catálogo oficial de instituciones académicas disponibles para la vinculación y registro de estudiantes.</p>
          </div>
          <button onclick="openAddUniversityModal()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold text-xs px-5 py-3 rounded-2xl shadow-md transition flex items-center gap-2 cursor-pointer shrink-0">
            <i class="fa-solid fa-plus text-xs"></i> Nueva Institución
          </button>
        </div>

        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                <tr>
                  <th class="px-6 py-4">Institución</th>
                  <th class="px-6 py-4">Tipo</th>
                  <th class="px-6 py-4">Ubicación</th>
                  <th class="px-6 py-4 text-center">Estado</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                <% if (typeof universities !== 'undefined' && universities && universities.length > 0) { %>
                  <% universities.forEach(function(u) { %>
                    <tr class="hover:bg-slate-50/50 transition">
                      <td class="px-6 py-4">
                        <div class="font-extrabold text-slate-900 text-xs"><%= u.nombre %></div>
                        <% if (u.siglas) { %>
                          <span class="text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full inline-block mt-0.5"><%= u.siglas %></span>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 font-semibold text-slate-600">
                        <%= u.tipo === 'INSTITUTO_SUPERIOR' ? 'Instituto Superior' : 'Universidad' %>
                      </td>
                      <td class="px-6 py-4 text-slate-600">
                        <%= (u.ciudad || '') + (u.provincia ? ', ' + u.provincia : '') || 'Ecuador' %>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black <%= u.activo ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>">
                          <%= u.activo ? 'ACTIVO' : 'INACTIVO' %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                        <button onclick='openEditUniversityModal(<%- JSON.stringify(u) %>)' class="px-3 py-1.5 rounded-xl font-bold text-[11px] bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer">
                          <i class="fa-solid fa-pen text-[10px]"></i> Editar
                        </button>
                        <form action="/dashboard/admin/universities/<%= u.id %>/toggle" method="POST" class="inline-block">
                          <button type="submit" class="px-3 py-1.5 rounded-xl font-bold text-[11px] transition cursor-pointer <%= u.activo ? 'bg-amber-50 text-amber-700 hover:bg-amber-100' : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100' %>">
                            <%= u.activo ? 'Desactivar' : 'Activar' %>
                          </button>
                        </form>
                        <form action="/dashboard/admin/universities/<%= u.id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('¿Seguro que deseas eliminar esta institución?');">
                          <button type="submit" class="px-2.5 py-1.5 rounded-xl font-bold text-[11px] bg-rose-50 text-rose-700 hover:bg-rose-100 transition cursor-pointer">
                            <i class="fa-solid fa-trash-can"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                      No hay universidades o institutos registrados.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB: SOLICITUDES DE TRANSICIÓN DE ROL -->
      <section id="tab-role-transitions" class="dash-tab-pane hidden flex flex-col gap-6 font-sans">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-user-gear text-[#0a66c2]"></i> Solicitudes de Cambio de Rol (Estudiante / Profesional)
            </h2>
            <p class="text-xs text-slate-450 mt-1 font-medium">Revisión de solicitudes de clientes y estudiantes para actualizar sus perfiles en la plataforma.</p>
          </div>
        </div>

        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                <tr>
                  <th class="px-6 py-4">Usuario</th>
                  <th class="px-6 py-4 text-center">Rol Actual ➔ Solicitado</th>
                  <th class="px-6 py-4">Fecha</th>
                  <th class="px-6 py-4">Motivo / Título</th>
                  <th class="px-6 py-4 text-center">Estado</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                <% if (typeof roleTransitionRequests !== 'undefined' && roleTransitionRequests && roleTransitionRequests.length > 0) { %>
                  <% roleTransitionRequests.forEach(function(reqItem) { %>
                    <tr class="hover:bg-slate-50/50 transition">
                      <td class="px-6 py-4">
                        <div class="font-extrabold text-slate-900"><%= reqItem.user ? reqItem.user.name : 'Usuario' %></div>
                        <div class="text-[10px] text-slate-400"><%= reqItem.user ? reqItem.user.email : '' %></div>
                      </td>
                      <td class="px-6 py-4 text-center font-bold text-slate-800">
                        <span class="px-2 py-0.5 rounded bg-slate-100 text-[10px]"><%= reqItem.currentRole %></span>
                        ➔
                        <span class="px-2 py-0.5 rounded text-[10px] <%= reqItem.targetRole === 'STUDENT' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-[#0a66c2]' %>"><%= reqItem.targetRole || 'PROFESSIONAL' %></span>
                      </td>
                      <td class="px-6 py-4 text-slate-500">
                        <%= new Date(reqItem.fechaSolicitud).toLocaleDateString('es-EC') %>
                      </td>
                      <td class="px-6 py-4">
                        <div class="text-xs text-slate-800 font-semibold max-w-xs truncate"><%= reqItem.motivoSolicitud || 'Sin motivo' %></div>
                        <% if (reqItem.tituloCertificadoUrl) { %>
                          <a href="<%= reqItem.tituloCertificadoUrl %>" target="_blank" class="text-[10px] text-[#0a66c2] font-bold hover:underline">
                            <i class="fa-solid fa-file-pdf"></i> Ver Documento Adjunto
                          </a>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black <%= reqItem.estado === 'APROBADO' ? 'bg-emerald-100 text-emerald-800' : (reqItem.estado === 'RECHAZADO' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800') %>">
                          <%= reqItem.estado %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-right">
                        <% if (reqItem.estado === 'PENDIENTE') { %>
                          <div class="flex items-center justify-end gap-2">
                            <form action="/dashboard/admin/role-transitions/approve/<%= reqItem.id %>" method="POST" class="inline-block">
                              <button type="submit" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] transition shadow-sm cursor-pointer">
                                Aprobar
                              </button>
                            </form>
                            <form action="/dashboard/admin/role-transitions/reject/<%= reqItem.id %>" method="POST" class="inline-block">
                              <button type="submit" class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-[11px] transition cursor-pointer">
                                Rechazar
                              </button>
                            </form>
                          </div>
                        <% } else { %>
                          <span class="text-[11px] text-slate-400 italic">Procesada</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                      No hay solicitudes de cambio de rol actualmente.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB: CONVERSATORIOS -->
      <section id="tab-conversatorios" class="dash-tab-pane hidden flex flex-col gap-6 font-sans">
        
        <!-- List View Container -->
        <div id="conversatorios-list-container" class="flex flex-col gap-6">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-2xl font-black tracking-tight text-slate-900">Gestión de Conversatorios</h2>
              <p class="text-xs text-slate-450 mt-1 font-medium font-sans">Organice y administre sus eventos interactivos de capacitación continua.</p>
            </div>
            <button onclick="openConversatorioForm()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3 px-5 rounded-2xl transition text-xs shadow-md flex items-center gap-2 cursor-pointer font-sans">
              <i class="fa-solid fa-plus text-xs"></i> Nuevo Conversatorio
            </button>
          </div>

          <!-- Table of active conversatorios -->
          <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm flex flex-col justify-between self-start w-full">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse min-w-[900px]">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-4 py-3 w-[28%]">Título</th>
                    <th class="px-3 py-3 w-[12%]">Fecha</th>
                    <th class="px-3 py-3 text-center w-[10%]">Precio</th>
                    <th class="px-3 py-3 text-center w-[8%]">Cupo</th>
                    <th class="px-3 py-3 text-center w-[12%]">Estadísticas</th>
                    <th class="px-3 py-3 text-center w-[10%]">Estado</th>
                    <th class="px-3 py-3 text-right w-[20%]">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 font-medium text-slate-700">
                  <% if (typeof conversatorios !== 'undefined' && conversatorios && conversatorios.length > 0) { %>
                    <% conversatorios.forEach(function(ev) { %>
                      <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-4 py-3">
                          <div class="font-extrabold text-slate-900 text-sm truncate"><%= ev.titulo %></div>
                          <div class="text-[10px] text-slate-450 mt-0.5 truncate"><%= ev.slogan || 'Sin Slogan' %></div>
                        </td>
                        <td class="px-3 py-3">
                          <div class="flex flex-col gap-0.5">
                            <span class="text-slate-900 font-bold"><%= ev.fechaInicio ? new Date(ev.fechaInicio).toLocaleDateString() : '' %></span>
                            <span class="text-[10px] text-slate-400"><%= ev.horaInicio %> - <%= ev.horaFin %></span>
                          </div>
                        </td>
                        <td class="px-3 py-3 text-center">
                          <% if (ev.gratuito) { %>
                            <span class="bg-emerald-50 text-emerald-600 text-[9px] font-black px-2 py-0.5 rounded-full font-sans">Gratuito</span>
                          <% } else { %>
                            <div class="flex flex-col items-center">
                              <span class="font-extrabold text-slate-800">$<%= ev.precio.toFixed(2) %></span>
                              <% if (ev.descuentoEstudianteUsd && ev.descuentoEstudianteUsd > 0) { %>
                                <span class="text-[10px] font-black text-blue-600"><i class="fa-solid fa-graduation-cap text-[9px]"></i> Est: $<%= ev.descuentoEstudianteUsd.toFixed(2) %></span>
                              <% } %>
                            </div>
                          <% } %>
                        </td>
                        <td class="px-3 py-3 text-center font-extrabold">
                          <% if (ev.capacidadIlimitada) { %>
                            <span class="text-slate-450 text-[10px]">Ilimitado</span>
                          <% } else { %>
                            <span class="text-slate-850"><%= ev.capacidad %></span>
                          <% } %>
                        </td>
                        <td class="px-3 py-3 text-center">
                          <button type="button" onclick='openEventStatsModalById("conversatorio", <%= ev.id %>)' class="text-[#0A3C84] hover:underline font-extrabold flex items-center justify-center gap-1 mx-auto bg-blue-50/50 border border-blue-100/30 px-2 py-1 rounded-lg transition cursor-pointer">
                            <i class="fa-solid fa-chart-line text-[10px]"></i> Estadísticas
                          </button>
                        </td>
                        <td class="px-3 py-3 text-center">
                          <span class="px-2 py-0.5 rounded-full text-[9px] font-black <%= ev.estado === 'ACTIVO' ? 'bg-emerald-50 text-emerald-600' : ev.estado === 'FINALIZADO' ? 'bg-slate-100 text-slate-400' : 'bg-amber-50 text-amber-600' %>">
                            <%= ev.estado || 'ACTIVO' %>
                          </span>
                        </td>
                        <td class="px-3 py-3 text-right">
                          <div class="flex items-center justify-end gap-1.5">
                            <button type="button" onclick='openDirectManualEnrollment("conversatorio", <%= ev.id %>)' class="text-emerald-600 hover:text-emerald-800 bg-emerald-50 hover:bg-emerald-100 font-bold p-1.5 rounded-lg border border-emerald-150 transition flex items-center justify-center cursor-pointer" title="Matricular Alumno">
                              <i class="fa-solid fa-user-plus text-[10px]"></i>
                            </button>
                            <button type="button" onclick='openCertificateDesignModalById("conversatorio", <%= ev.id %>)' class="text-amber-600 hover:text-amber-800 bg-amber-50 hover:bg-amber-100 font-bold p-1.5 rounded-lg border border-amber-150 transition flex items-center justify-center cursor-pointer" title="Diseñar Certificado">
                              <i class="fa-solid fa-certificate text-[10px]"></i>
                            </button>
                            <a href="/eventos" target="_blank" class="text-slate-500 hover:text-slate-700 bg-slate-100 font-bold p-1.5 rounded-lg border border-slate-200/50 transition flex items-center justify-center" title="Ver en Web">
                              <i class="fa-solid fa-eye text-[10px]"></i>
                            </a>
                            <button onclick="editConversatorioById(<%= ev.id %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold p-1.5 rounded-lg border border-blue-100/50 transition flex items-center justify-center cursor-pointer" title="Editar">
                              <i class="fa-solid fa-pencil text-[10px]"></i>
                            </button>
                            <form action="/dashboard/admin/events/delete/conversatorio/<%= ev.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este conversatorio?')" class="inline">
                              <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold p-1.5 rounded-lg border border-rose-100 transition flex items-center justify-center cursor-pointer" title="Eliminar">
                                <i class="fa-solid fa-trash text-[10px]"></i>
                              </button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="px-4 py-12 text-center text-slate-400 font-semibold">
                        No hay conversatorios programados en el sistema.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Form View Container -->
        <div id="conversatorios-form-container" class="hidden flex flex-col gap-6 pb-20">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-2xl font-black tracking-tight text-slate-900" id="conversatorio-form-title">Nuevo Conversatorio</h2>
              <p class="text-xs text-slate-450 mt-1 font-medium font-sans">Complete la información detallada para crear o modificar el evento.</p>
            </div>
            <button onclick="closeConversatorioForm()" class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold py-3 px-5 rounded-2xl transition text-xs flex items-center gap-2 cursor-pointer font-sans border border-slate-200/50">
              <i class="fa-solid fa-arrow-left text-xs"></i> Volver al listado
            </button>
          </div>

          <form action="/dashboard/admin/conversatorios/save" method="POST" class="flex flex-col gap-6" id="conversatorio-form" onsubmit="serializeConversatorioData()">
            <input type="hidden" name="id" id="conversatorio-form-id">
            <input type="hidden" name="itineraryJson" id="conversatorio-itinerary-json">
            <input type="hidden" name="conveniosJson" id="conversatorio-convenios-json">

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              
              <!-- Left Card: Identidad del Evento -->
              <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-5 animate-fade-in">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2 border-b border-slate-50 pb-3">
                  <i class="fa-solid fa-id-card text-brand-blue"></i> Identidad del Evento
                </h3>
                
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Slogan / Lema</label>
                  <input type="text" name="slogan" id="conversatorio-slogan" placeholder="Ej: Innovando en el Sector Legal" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Título del Conversatorio</label>
                  <input type="text" name="titulo" id="conversatorio-titulo" required placeholder="Ej: Congreso Nacional de Medicina Legal" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Área Profesional / Profesión</label>
                  <select name="areaProfesional" id="conversatorio-area" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-800 font-semibold">
                    <option value="">Seleccione un área...</option>
                    <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
                      <% professions.forEach(function(p) { %>
                        <option value="<%= p.nombre %>"><%= p.nombre %></option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Descripción / Objetivos</label>
                  <textarea name="descripcion" id="conversatorio-descripcion" rows="4" placeholder="Detalle los objetivos del conversatorio, temarios generales y público dirigido..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition resize-none leading-relaxed"></textarea>
                </div>
              </div>

              <!-- Right Card: Logística del Evento -->
              <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-5 self-start w-full">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2 border-b border-slate-50 pb-3">
                  <i class="fa-solid fa-clock text-brand-blue"></i> Logística del Evento
                </h3>

                <div class="grid grid-cols-2 gap-4">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Fecha de Inicio</label>
                    <input type="date" name="fechaInicio" id="conversatorio-fechaInicio" onchange="autoGenerateItineraryDays()" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-850 font-bold">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Fecha de Fin</label>
                    <input type="date" name="fechaFin" id="conversatorio-fechaFin" onchange="autoGenerateItineraryDays()" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-850 font-bold">
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700 flex items-center gap-1"><i class="fa-regular fa-clock text-slate-450"></i> Hora de Inicio</label>
                    <input type="time" name="horaInicio" id="conversatorio-horaInicio" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center font-bold">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700 flex items-center gap-1"><i class="fa-regular fa-clock text-slate-450"></i> Hora de Fin</label>
                    <input type="time" name="horaFin" id="conversatorio-horaFin" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center font-bold">
                  </div>
                </div>

                <div class="border-t border-slate-50 pt-4 flex flex-col gap-4">
                  <div class="grid grid-cols-2 gap-4 items-end">
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs font-bold text-slate-700 flex items-center gap-1"><i class="fa-solid fa-dollar-sign text-slate-450"></i> Inversión General ($)</label>
                      <input type="number" step="0.01" name="precio" id="conversatorio-precio" value="0.00" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center text-slate-850 font-black">
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs font-bold text-blue-700 flex items-center gap-1"><i class="fa-solid fa-graduation-cap text-blue-600"></i> Precio Estudiantes ($)</label>
                      <input type="number" step="0.01" name="descuentoEstudianteUsd" id="conversatorio-descuentoEstudianteUsd" value="0.00" placeholder="0.00" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center text-blue-800 font-black">
                    </div>
                  </div>

                  <div class="flex flex-col gap-2 pt-1 justify-end">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" name="gratuito" value="true" id="conversatorio-gratuito" onchange="toggleConversatorioFree()" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                      <label for="conversatorio-gratuito" class="text-xs font-bold text-slate-700">¿Es gratuita?</label>
                    </div>
                    <div class="flex items-center gap-2 hidden" id="free-cert-container">
                      <input type="checkbox" name="permitirCertificadoGratuito" value="true" id="conversatorio-permitirCertificadoGratuito" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                      <label for="conversatorio-permitirCertificadoGratuito" class="text-[11px] font-bold text-slate-500">¿Permitir Certificado Gratuito?</label>
                    </div>
                  </div>

                  <div class="border-t border-slate-100 pt-3 flex flex-col gap-3">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" name="certificadoInmediato" value="true" id="conversatorio-certificadoInmediato" checked onchange="toggleConversatorioCertMinPct()" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                      <label for="conversatorio-certificadoInmediato" class="text-xs font-bold text-slate-800">Otorgar certificado inmediatamente al inscribirse/comprar</label>
                    </div>
                    <div class="flex flex-col gap-1 hidden pl-6" id="conversatorio-certMinPctContainer">
                      <label class="text-[11px] font-extrabold text-amber-700 flex items-center gap-1">
                        <i class="fa-solid fa-percent text-amber-500"></i> Porcentaje mínimo de asistencia/visualización para certificado (%)
                      </label>
                      <input type="number" name="porcentajeMinimoCertificado" id="conversatorio-porcentajeMinimoCertificado" value="100" min="1" max="100" class="bg-amber-50/50 border border-amber-200 rounded-xl py-2 px-3 text-xs outline-none focus:bg-white focus:border-amber-500 transition text-center font-black text-amber-900 w-36">
                    </div>
                  </div>

                  <div class="border-t border-slate-100 pt-3 flex flex-col gap-3">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" name="usarTiempoMinimoPonencia" value="true" id="conversatorio-usarTiempoMinimoPonencia" checked onchange="toggleConversatorioTiempoMinimo()" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                      <label for="conversatorio-usarTiempoMinimoPonencia" class="text-xs font-bold text-slate-800">Requerir tiempo mínimo de permanencia por ponencia</label>
                    </div>
                    <div class="flex flex-col gap-1 pl-6" id="conversatorio-tiempoMinimoContainer">
                      <label class="text-[11px] font-extrabold text-blue-700 flex items-center gap-1">
                        <i class="fa-solid fa-clock text-blue-500"></i> Tiempo mínimo por ponencia (minutos)
                      </label>
                      <input type="number" name="tiempoMinimoPonenciaMinutos" id="conversatorio-tiempoMinimoPonenciaMinutos" placeholder="3 (por defecto global)" min="1" max="300" class="bg-blue-50/50 border border-blue-200 rounded-xl py-2 px-3 text-xs outline-none focus:bg-white focus:border-blue-500 transition text-center font-black text-blue-900 w-48">
                      <span class="text-[9px] text-slate-450">Dejar en blanco para usar el estándar del sistema (<%= (typeof systemConfig !== 'undefined' && systemConfig && systemConfig.tiempoMinimoPonenciaMinutos) ? systemConfig.tiempoMinimoPonenciaMinutos : 3 %> min).</span>
                    </div>
                  </div>

                  <div class="grid grid-cols-2 gap-4 items-end">
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs font-bold text-slate-700 flex items-center gap-1"><i class="fa-solid fa-users-viewfinder text-slate-450"></i> Capacidad / Aforo</label>
                      <input type="number" name="capacidad" id="conversatorio-capacidad" placeholder="100" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center font-bold">
                    </div>
                    <div class="flex items-center gap-2 mb-3">
                      <input type="checkbox" name="capacidadIlimitada" value="true" id="conversatorio-capacidadIlimitada" onchange="toggleConversatorioUnlimited()" checked class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                      <label for="conversatorio-capacidadIlimitada" class="text-xs font-bold text-slate-700">¿Es ilimitada?</label>
                    </div>
                  </div>
                </div>

                <div class="border-t border-slate-50 pt-4 flex flex-col gap-4">
                  <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs font-bold text-slate-700">Provincia</label>
                      <input type="text" name="provincia" id="conversatorio-provincia" placeholder="Loja" class="bg-slate-50 border border-slate-100 rounded-xl py-2.5 px-4 text-xs outline-none">
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs font-bold text-slate-700">Ciudad</label>
