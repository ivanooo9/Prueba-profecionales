          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900">Mensajes de Contacto</h2>
            <p class="text-xs text-slate-500 font-medium">Buzón de entrada del formulario de contáctanos de la plataforma.</p>
          </div>
        </div>

        <% if (contactMessages.length === 0) { %>
          <div class="bg-white border border-slate-100 rounded-3xl p-12 text-center shadow-sm flex flex-col items-center justify-center gap-4">
            <div class="w-16 h-16 bg-slate-50 border border-slate-100 rounded-2xl flex items-center justify-center text-slate-300 text-2xl">
              <i class="fa-solid fa-inbox"></i>
            </div>
            <div>
              <h4 class="font-bold text-slate-800 text-sm">Buzón vacío</h4>
              <p class="text-xs text-slate-400 font-semibold mt-1">Aún no has recibido ningún mensaje desde el formulario de contacto.</p>
            </div>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Messages List -->
            <div class="lg:col-span-1 bg-white border border-slate-100 rounded-3xl p-4 shadow-sm flex flex-col gap-3 max-h-[600px] overflow-y-auto">
              <h3 class="font-black text-xs text-slate-900 uppercase tracking-wider px-2 pb-2 border-b border-slate-50">Lista de Mensajes</h3>
              <div class="flex flex-col gap-2">
                <% contactMessages.forEach(function(msg, index) { %>
                  <div onclick="selectContactMessage(<%= JSON.stringify(msg) %>)" id="msg-card-<%= msg.id %>" class="msg-card p-4 rounded-2xl border border-slate-100/80 hover:bg-slate-50/50 hover:border-slate-200 transition duration-200 cursor-pointer text-left relative flex flex-col gap-2 <%= !msg.leido ? 'bg-blue-50/20 border-blue-100' : '' %>">
                    <!-- Unread dot -->
                    <% if (!msg.leido) { %>
                      <div class="absolute top-4 right-4 w-2 h-2 rounded-full bg-blue-500" id="msg-dot-<%= msg.id %>"></div>
                    <% } %>
                    
                    <div class="pr-6">
                      <div class="text-xs font-black text-slate-800"><%= msg.nombre %></div>
                      <div class="text-[10px] text-slate-400 font-semibold mt-0.5"><%= msg.email %></div>
                    </div>
                    
                    <div class="text-[11px] font-bold text-slate-700 mt-1 line-clamp-1"><%= msg.asunto %></div>
                    
                    <div class="flex items-center justify-between mt-1 pt-2 border-t border-slate-50">
                      <span class="text-[9px] text-slate-400 font-semibold">
                        <%= new Date(msg.fecha).toLocaleDateString('es-EC', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                      </span>
                      <span class="text-[9px] px-2 py-0.5 rounded-full font-black uppercase <%= !msg.leido ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-500' %>" id="msg-badge-<%= msg.id %>">
                        <%= !msg.leido ? 'Nuevo' : 'Leído' %>
                      </span>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Reading Pane -->
            <div class="lg:col-span-2 bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6 min-h-[450px]">
              <!-- Empty state inside reader -->
              <div id="msg-reader-empty" class="flex-1 flex flex-col items-center justify-center text-center gap-4 py-12">
                <div class="w-16 h-16 bg-slate-50 border border-slate-100 rounded-2xl flex items-center justify-center text-slate-300 text-2xl">
                  <i class="fa-solid fa-envelope-open"></i>
                </div>
                <div>
                  <h4 class="font-bold text-slate-800 text-sm">Selecciona un mensaje</h4>
                  <p class="text-xs text-slate-400 font-semibold mt-1">Haz clic en cualquier mensaje de la lista de la izquierda para leer su contenido completo.</p>
                </div>
              </div>

              <!-- Content state inside reader -->
              <div id="msg-reader-content" class="hidden flex-1 flex flex-col gap-6 text-left">
                <!-- Header -->
                <div class="border-b border-slate-100 pb-5 flex flex-col gap-3">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <span class="bg-blue-50 border border-blue-100 text-blue-700 text-[10px] font-black uppercase px-2.5 py-1 rounded-lg" id="read-subject-badge">Soporte</span>
                      <h3 class="text-lg font-black text-slate-900 mt-2 font-sans" id="read-subject">Asunto del Mensaje</h3>
                    </div>
                    <div class="text-[10px] text-slate-400 font-bold text-right" id="read-date">Fecha de envío</div>
                  </div>

                  <div class="flex items-center gap-3 mt-1">
                    <div class="w-10 h-10 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-650 font-bold text-sm" id="read-avatar">
                      N
                    </div>
                    <div>
                      <div class="text-xs font-black text-slate-800" id="read-name">Nombre del Remitente</div>
                      <a href="" class="text-[10px] text-sky-500 hover:underline font-bold mt-0.5" id="read-email">correo@ejemplo.com</a>
                    </div>
                  </div>
                </div>

                <!-- Body -->
                <div class="flex-1 text-xs text-slate-705 leading-relaxed font-medium bg-slate-50/50 p-6 rounded-2xl border border-slate-100/60 whitespace-pre-wrap font-sans" id="read-body">
                  Contenido del mensaje aquí...
                </div>

                <!-- Footer / Actions -->
                <div class="border-t border-slate-100 pt-5 flex items-center justify-between gap-4">
                  <!-- Mark as read form -->
                  <form action="" method="POST" id="read-mark-form">
                    <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-2.5 px-4 rounded-xl transition text-xs flex items-center gap-2 cursor-pointer" id="read-mark-btn">
                      <i class="fa-solid fa-check"></i> Marcar como Leído
                    </button>
                  </form>

                  <!-- Delete form -->
                  <form action="" method="POST" id="read-delete-form" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este mensaje de forma permanente?')">
                    <button type="submit" class="bg-rose-50 border border-rose-100 hover:bg-rose-100 text-rose-600 font-extrabold py-2.5 px-4 rounded-xl transition text-xs flex items-center gap-2 cursor-pointer">
                      <i class="fa-solid fa-trash-can"></i> Eliminar Mensaje
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </section>

      <!-- TAB: PLANS -->
      <section id="tab-plans" class="dash-tab-pane hidden flex flex-col gap-6">
