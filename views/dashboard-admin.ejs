                    <input type="text" value="${sp.redes?.twitter || ''}" oninput="conversatorioSpeakers[${globalIndex}].redes.twitter = this.value" placeholder="X" title="X (Twitter)" class="bg-slate-50 border border-slate-100 rounded-lg py-1.5 pl-5 pr-1.5 text-[9px] outline-none w-full text-slate-700">
