    async function searchSpeakerProfile(index, queryInput) {
      const query = queryInput.value.trim();
      const dropdown = document.getElementById(`speaker-search-dropdown-${index}`);
      if (!dropdown) return;

      if (!query || query.length < 2) {
        dropdown.innerHTML = '';
        dropdown.classList.add('hidden');
        return;
      }

      try {
        const res = await fetch(`/api/admin/professionals/search?q=${encodeURIComponent(query)}`);
        const data = await res.json();
        if (data.success && data.professionals && data.professionals.length > 0) {
          dropdown.innerHTML = '';
          dropdown.classList.remove('hidden');

          data.professionals.forEach(p => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = "w-full text-left px-3 py-2 hover:bg-slate-50 transition font-sans text-[11px] font-bold text-slate-800 border-b border-slate-100 flex items-center gap-2 cursor-pointer";
            btn.innerHTML = `
              <div class="w-6 h-6 rounded-full overflow-hidden bg-slate-200">
                <img src="${p.photo || 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=100'}" class="w-full h-full object-cover">
              </div>
              <div class="flex-grow">
                <div>${p.user.name}</div>
                <div class="text-[9px] text-slate-400 font-medium">${p.user.email}</div>
              </div>
            `;
            btn.onclick = () => {
              selectSpeakerProfile(index, p);
              dropdown.innerHTML = '';
              dropdown.classList.add('hidden');
              queryInput.value = '';
            };
            dropdown.appendChild(btn);
          });
        } else {
          dropdown.innerHTML = '<div class="px-3 py-2 text-slate-400 text-[10px] italic">No se encontraron perfiles.</div>';
          dropdown.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
      }
    }

