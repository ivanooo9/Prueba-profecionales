                    <input type="file" id="conversatorio-portada-file" accept="image/*" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-3 file:py-2 file:rounded-lg file:text-[10px] file:font-bold file:cursor-pointer bg-slate-50 border border-slate-100 rounded-xl py-1.5 px-2 text-slate-700">
                    <input type="text" name="revistaPortada" id="conversatorio-revistaPortada" placeholder="O ingresa URL de portada" class="bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-[10px] outline-none">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Miniatura Portada</label>
                    <div class="w-full h-28 rounded-2xl overflow-hidden bg-slate-50 border border-slate-100 flex items-center justify-center relative shadow-inner">
                      <img id="conversatorio-portada-preview" src="" class="w-full h-full object-cover hidden">
                      <div id="conversatorio-portada-placeholder" class="text-slate-400 text-[10px] font-bold flex flex-col items-center gap-1 text-center">
                        <i class="fa-solid fa-file-invoice text-xl text-slate-350"></i>
                        <span>SIN PORTADA</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card: Itinerario y Ponentes -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6">
              <div class="flex items-center justify-between border-b border-slate-50 pb-3">
                <div class="flex flex-col">
                  <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-calendar-day text-[#0A3C84]"></i> Itinerario y Ponentes
                  </h3>
                  <span class="text-[11px] text-slate-450 mt-1 italic">Los días se generan automáticamente según las fechas del evento</span>
                </div>
              </div>

              <!-- Itinerary and speakers nested list -->
              <div class="flex flex-col gap-6" id="conversatorio-days-list">
                <!-- Dynamic rendering nested by days -->
              </div>
              
              <div class="flex justify-start">
                <button type="button" onclick="addConversatorioDay()" class="bg-slate-100 hover:bg-slate-200 text-[#0A3C84] font-bold px-4 py-2 rounded-xl border border-slate-200/50 text-xs transition cursor-pointer flex items-center gap-2 font-sans">
                  <i class="fa-solid fa-plus"></i> Añadir Día Manualmente
                </button>
              </div>
            </div>

            <!-- Card: Estado del Conversatorio -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-4">
              <div class="flex flex-col gap-1">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                  <i class="fa-solid fa-toggle-on text-[#0A3C84]"></i> Estado del Conversatorio
                </h3>
                <span class="text-[11px] text-slate-450 italic">Seleccione el estado inicial o actual del conversatorio.</span>
              </div>
              <div class="flex flex-col gap-1.5 max-w-sm">
                <label class="text-xs font-bold text-slate-700" for="conversatorio-estado">Estado</label>
                <select name="estado" id="conversatorio-estado" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-bold text-slate-800">
                  <option value="PROGRAMADO">Programado</option>
                  <option value="ACTIVO" selected>Activo</option>
                  <option value="FINALIZADO">Finalizado</option>
                </select>
              </div>
            </div>

            <!-- Card: Convenios -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-5">
              <div class="flex flex-col gap-1 border-b border-slate-50 pb-3">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                  <i class="fa-solid fa-handshake text-[#0A3C84]"></i> Convenios
                </h3>
                <span class="text-[11px] text-slate-450 italic">Use los convenios globales de Profesionales Ecuador o configure aliados específicos para este conversatorio.</span>
              </div>

              <div class="flex items-center gap-2 bg-slate-50 border border-slate-100 rounded-2xl px-4 py-3">
                <input type="checkbox" name="usePecConvenios" value="true" id="conversatorio-usePecConvenios" onchange="toggleConversatorioConveniosMode()" checked class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                <label for="conversatorio-usePecConvenios" class="text-xs font-black text-slate-800">Usar convenios de P.EC</label>
              </div>

              <div id="conversatorio-scoped-convenios-panel" class="flex flex-col gap-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-slate-50/60 border border-slate-100 rounded-2xl p-4">
                  <input type="hidden" id="conv-agreement-edit-index" value="">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Título / Nombre</label>
                    <input type="text" id="conv-agreement-titulo" placeholder="Ej: Academia Rodar" class="bg-white border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:border-brand-blue transition">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Categoría</label>
                    <select id="conv-agreement-categoria" class="bg-white border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:border-brand-blue transition">
                      <option value="Patrocinador">Patrocinador</option>
                      <option value="Aval Académico">Aval Académico</option>
                      <option value="Aliado Estratégico">Aliado Estratégico</option>
                      <option value="Institución">Institución</option>
                      <option value="Empresa">Empresa</option>
                    </select>
                  </div>
                  <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label class="text-xs font-bold text-slate-700">Descripción</label>
                    <textarea id="conv-agreement-descripcion" rows="2" class="bg-white border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:border-brand-blue transition resize-none"></textarea>
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Enlace Web</label>
                    <input type="url" id="conv-agreement-link" placeholder="https://..." class="bg-white border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:border-brand-blue transition">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Orden de Visualización</label>
                    <input type="number" id="conv-agreement-orden" value="0" class="bg-white border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:border-brand-blue transition">
                  </div>
                  <div class="flex flex-col gap-2 md:col-span-2">
                    <label class="text-xs font-bold text-slate-700">Logo de la Empresa / Convenio</label>
                    <input type="file" id="conv-agreement-logo-file" accept="image/*" onchange="loadConversatorioAgreementLogo(this)" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-4 file:py-2 file:rounded-xl file:text-xs file:font-bold file:cursor-pointer bg-white border border-slate-100 rounded-xl py-2 px-3 text-slate-700">
                    <input type="hidden" id="conv-agreement-logo" value="">
                    <div class="h-20 rounded-xl bg-white border border-slate-100 flex items-center justify-center overflow-hidden">
                      <img id="conv-agreement-logo-preview" src="" class="max-h-16 object-contain hidden">
                      <span id="conv-agreement-logo-placeholder" class="text-[10px] font-bold text-slate-400">SIN LOGO</span>
                    </div>
                  </div>
                  <div class="md:col-span-2 flex justify-end gap-2 border-t border-slate-100 pt-4">
                    <button type="button" onclick="resetConversatorioAgreementForm()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-5 rounded-xl transition text-xs">Cancelar</button>
                    <button type="button" onclick="saveConversatorioAgreement()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-5 rounded-xl transition text-xs shadow-md">Guardar Convenio</button>
                  </div>
                </div>

                <div id="conversatorio-agreements-list" class="border border-slate-100 rounded-2xl overflow-hidden bg-white">
                </div>
              </div>
            </div>


          </form>
        </div>

        <!-- Floating Save Bar - Conversatorios -->
        <div id="conversatorio-floating-bar" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] px-6 py-3">
          <div class="max-w-7xl mx-auto flex items-center justify-end gap-3">
            <button type="button" onclick="closeConversatorioForm()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-5 rounded-xl transition text-xs cursor-pointer">
              Cancelar
            </button>
            <button type="submit" form="conversatorio-form" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-6 rounded-xl transition text-xs shadow-md cursor-pointer font-sans flex items-center gap-2">
              <i class="fa-solid fa-save text-[10px]"></i> Guardar Conversatorio
            </button>
          </div>
        </div>

      </section>

      <!-- TAB: CURSOS ACADEMICOS (Filtered view) -->
      <section id="tab-cursos" class="dash-tab-pane hidden flex flex-col gap-6 font-sans">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4" id="curso-header-container">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900" id="curso-tab-title">Cursos Académicos</h2>
            <p class="text-xs text-slate-450 mt-1 font-medium font-sans">Gestione y organice los Cursos Académicos de Educación Continua.</p>
          </div>
          <button onclick="openCursoForm()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3 px-5 rounded-2xl transition text-xs shadow-md flex items-center gap-2 cursor-pointer font-sans">
            <i class="fa-solid fa-plus text-xs"></i> Crear Nuevo Curso
          </button>
        </div>

        <!-- Form for Cursos (Toggle view) -->
        <div class="hidden flex flex-col gap-6 pb-20" id="curso-form-container">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-2xl font-black tracking-tight text-slate-900" id="curso-form-title">Nuevo Curso Académico</h2>
              <p class="text-xs text-slate-450 mt-1 font-medium font-sans">Complete la información detallada para crear o modificar el curso académico.</p>
            </div>
            <button onclick="closeCursoForm()" class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-extrabold py-3 px-5 rounded-2xl transition text-xs flex items-center gap-2 cursor-pointer font-sans border border-slate-200/50">
              <i class="fa-solid fa-arrow-left text-xs"></i> Volver al listado
            </button>
          </div>

          <form action="/dashboard/admin/cursos/save" method="POST" class="flex flex-col gap-6" id="curso-form" onsubmit="serializeCursoData(event)">
            <input type="hidden" name="id" id="curso-id">
            <input type="hidden" name="discountsJson" id="curso-discounts-json">
            <input type="hidden" name="structureJson" id="curso-structure-json">
            <input type="hidden" name="speakersJson" id="curso-speakers-json">
            <input type="hidden" name="includesJson" id="curso-includes-json">

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              
              <!-- Left Card: Identidad del Curso -->
              <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-5 animate-fade-in">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2 border-b border-slate-50 pb-3">
                  <i class="fa-solid fa-id-card text-brand-blue"></i> Identidad del Curso
                </h3>
                
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Estado del Curso</label>
                  <select name="estado" id="curso-estado" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-bold text-slate-800">
                    <option value="ACTIVO" selected>ACTIVO</option>
                    <option value="INACTIVO">INACTIVO</option>
                  </select>
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Slogan / Lema</label>
                  <input type="text" name="slogan" id="curso-slogan" placeholder="Ej: Especialización en Litigio Oral" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Título del Curso</label>
                  <input type="text" name="titulo" id="curso-title" required placeholder="Ej: Diplomado de Litigación Penal" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Profesión / Área Principal</label>
                    <select name="professionId" id="curso-professionId" onchange="onAdminCourseProfChange(this.value)" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-800 font-semibold">
                      <option value="">Seleccione profesión...</option>
                      <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
                        <% professions.forEach(function(p) { %>
                          <option value="<%= p.id %>" data-nombre="<%= p.nombre %>"><%= p.nombre %></option>
                        <% }); %>
                      <% } %>
                    </select>
                    <input type="hidden" name="areaProfesional" id="curso-area">
                  </div>

                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Categoría del Curso</label>
                    <select name="categoryId" id="curso-categoryId" onchange="onAdminCourseCatChange(this.value)" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-800 font-semibold">
                      <option value="">Seleccione categoría...</option>
                    </select>
                  </div>

                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">Rama de Enseñanza</label>
                    <select name="branchId" id="curso-branchId" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-800 font-semibold">
                      <option value="">Seleccione rama...</option>
                    </select>
                  </div>
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Palabras Clave de Búsqueda</label>
                  <input type="text" name="keywords" id="curso-keywords" placeholder="Ej: Gemini, Inteligencia Artificial, Prompting, Python" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                  <span class="text-[10px] text-slate-400 font-semibold">Separe palabras clave por comas para mejorar la búsqueda acelerada en el catálogo.</span>
                </div>

                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Descripción / Objetivos</label>
                  <textarea name="descripcion" id="curso-desc" rows="4" placeholder="Detalle los objetivos del curso, módulos generales y público dirigido..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition resize-none leading-relaxed"></textarea>
                </div>
              </div>

              <!-- Right Card: Logística y Descuentos -->
              <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-5 self-start w-full animate-fade-in">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2 border-b border-slate-50 pb-3">
                  <i class="fa-solid fa-calculator text-brand-blue"></i> Logística e Inversión
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700 flex items-center gap-1"><i class="fa-solid fa-dollar-sign text-slate-450"></i> Inversión General ($)</label>
                    <input type="number" step="0.01" name="precio" id="curso-price" value="0.00" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center text-slate-850 font-black">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-blue-700 flex items-center gap-1"><i class="fa-solid fa-graduation-cap text-blue-600"></i> Precio Estudiantes ($)</label>
                    <input type="number" step="0.01" name="descuentoEstudianteUsd" id="curso-descuentoEstudianteUsd" value="0.00" placeholder="0.00" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center text-blue-800 font-black">
                  </div>
                </div>

                <div class="flex items-center gap-2 pt-1">
                  <input type="checkbox" name="gratuito" value="true" id="curso-free" onchange="toggleCursoFree()" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                  <label for="curso-free" class="text-xs font-bold text-slate-700">¿Es gratuito?</label>
                </div>

                <div class="border-t border-slate-100 pt-3 flex flex-col gap-3">
                  <div class="flex items-center gap-2">
                    <input type="checkbox" name="certificadoInmediato" value="true" id="curso-certificadoInmediato" checked onchange="toggleCursoCertMinPct()" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                    <label for="curso-certificadoInmediato" class="text-xs font-bold text-slate-800">Otorgar certificado inmediatamente al inscribirse/comprar</label>
                  </div>
                  <div class="flex flex-col gap-1 hidden pl-6" id="curso-certMinPctContainer">
                    <label class="text-[11px] font-extrabold text-amber-700 flex items-center gap-1">
                      <i class="fa-solid fa-percent text-amber-500"></i> Porcentaje mínimo de clases vistas para certificado (%)
                    </label>
                    <input type="number" name="porcentajeMinimoCertificado" id="curso-porcentajeMinimoCertificado" value="100" min="1" max="100" class="bg-amber-50/50 border border-amber-200 rounded-xl py-2 px-3 text-xs outline-none focus:bg-white focus:border-amber-500 transition text-center font-black text-amber-900 w-36">

                    <label class="text-[11px] font-extrabold text-slate-700 flex items-center gap-1 mt-2">
                      <i class="fa-solid fa-clock text-slate-500"></i> Tiempo mínimo por clase (segundos)
                    </label>
                    <span class="text-[10px] text-slate-500">Tiempo de permanencia en la vista de la clase para que el sistema la marque automáticamente como vista. Por defecto: 5 segundos.</span>
                    <input type="number" name="tiempoMinimoPermanenciaClaseSegundos" id="curso-tiempoMinimoPermanenciaClaseSegundos" value="5" min="1" max="3600" class="bg-slate-50 border border-slate-200 rounded-xl py-2 px-3 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center font-black text-slate-900 w-36">
                  </div>
                </div>

                <div class="border-t border-slate-100 pt-4 flex flex-col gap-4">
                  <div class="flex items-center justify-between">
                    <h4 class="text-xs font-black uppercase text-slate-700 tracking-wider">Descuentos por Fechas</h4>
                    <button type="button" onclick="addCursoDiscountRow()" class="text-brand-blue hover:text-sky-850 font-bold text-xs transition cursor-pointer flex items-center gap-1">
                      <i class="fa-solid fa-plus text-[10px]"></i> Agregar Descuento
                    </button>
                  </div>

                  <div class="flex flex-col gap-3" id="curso-discounts-list">
                    <!-- Dynamic rendering of discount rows -->
                  </div>
                </div>
              </div>
            </div>

            <!-- Card: Multimedia Premium -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-5 animate-fade-in">
              <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2 border-b border-slate-50 pb-3">
                <i class="fa-solid fa-photo-film text-brand-blue"></i> Multimedia Premium
              </h3>

              <div class="flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                  <input type="checkbox" name="destacado" value="true" id="curso-dest" class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
                  <label for="curso-dest" class="text-xs font-black text-slate-800">Marcar como Curso Destacado (Banner en inicio)</label>
                </div>

                <div class="flex flex-col gap-1.5 w-full md:w-48">
                  <label class="text-[10px] font-black uppercase tracking-wider text-slate-500">Tipo de Multimedia</label>
                  <select name="mediaType" id="curso-mediaType" onchange="toggleCursoMediaType()" class="bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-800 font-bold">
                    <option value="imagen">Imagen</option>
                    <option value="video">Video</option>
                  </select>
                </div>
              </div>

              <!-- Main Media Url field -->
              <input type="hidden" name="mediaUrl" id="curso-mediaUrl">

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Inputs column -->
                <div class="flex flex-col gap-4">
                  <!-- Image Inputs -->
                  <div id="curso-media-image-group" class="flex flex-col gap-4">
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs font-bold text-slate-700">Subir Imagen de Portada</label>
                      <input type="file" id="curso-media-image-file" accept="image/*" onchange="handleCursoMediaFileSelect(this, 'imagen')" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-4 file:py-2.5 file:rounded-xl file:text-xs file:font-bold file:cursor-pointer bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-slate-700">
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs font-bold text-slate-700">O ingresa URL de Imagen</label>
                      <input type="text" id="curso-media-image-url" oninput="handleCursoMediaUrlInput(this.value, 'imagen')" placeholder="https://images.unsplash.com/... o Base64 cargada" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                    </div>
                  </div>

                  <!-- Video Inputs (Hidden by default) -->
                  <div id="curso-media-video-group" class="flex flex-col gap-4 hidden">
                    <div class="flex flex-col gap-1.5 relative">
                      <label class="text-xs font-bold text-slate-700">Subir Video a Bunny Stream</label>
                      <input type="file" id="curso-media-video-file" accept="video/*" onchange="handleBunnyVideoUpload(this, 'curso-mediaUrl')" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-4 file:py-2.5 file:rounded-xl file:text-xs file:font-bold file:cursor-pointer bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-slate-700">
                      
                      <div id="bunny-upload-progress-container" class="hidden absolute w-full top-full mt-2 bg-slate-100 rounded-full h-2 overflow-hidden">
                        <div id="bunny-upload-progress-bar" class="bg-blue-600 h-full w-0 transition-all duration-300"></div>
                      </div>
                      <span id="bunny-upload-status" class="text-[10px] text-slate-500 font-medium hidden mt-1">Subiendo...</span>
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label class="text-xs font-bold text-slate-700">O ingresa URL de Video (YouTube/MP4)</label>
                      <input type="text" id="curso-media-video-url" oninput="handleCursoMediaUrlInput(this.value, 'video')" placeholder="https://www.youtube.com/watch?v=... o enlace MP4" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                    </div>
                  </div>
                </div>

                <!-- Preview Column -->
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Vista Previa de Multimedia</label>
                  <div class="w-full h-40 rounded-2xl overflow-hidden bg-slate-50 border border-slate-100 flex items-center justify-center relative shadow-inner">
                    <!-- Image Preview -->
                    <img id="curso-media-image-preview" src="" class="w-full h-full object-cover hidden">
                    <!-- Video Preview -->
                    <video id="curso-media-video-preview" src="" controls class="w-full h-full object-cover hidden"></video>
                    <!-- Bunny Preview -->
                    <iframe id="curso-media-bunny-preview" src="" class="w-full h-full object-cover hidden border-none" allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;fullscreen;" allowfullscreen></iframe>
                    <!-- YouTube Preview Placeholder (no native YouTube iframe in admin HTML) -->
                    <div id="curso-media-yt-preview" class="w-full h-full hidden flex bg-slate-900 text-white flex-col items-center justify-center gap-2 text-center px-4">
                      <i class="fa-solid fa-circle-play text-3xl text-[#5A7AF3]"></i>
                      <span class="text-[10px] font-black uppercase tracking-wider">Vista previa YouTube / Bunny Stream</span>
                      <span class="text-[9px] text-slate-300 font-semibold">Al guardar, se mostrará con el reproductor propio de P.EC.</span>
                    </div>
                    
                    <div id="curso-media-placeholder" class="text-slate-400 text-[10px] font-bold flex flex-col items-center gap-1.5">
                      <i class="fa-solid fa-photo-film text-2xl text-slate-350"></i>
                      <span>SIN MULTIMEDIA CARGADA</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card: Estructura del Curso (Modules, Lessons, Resources) -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6">
              <div class="flex items-center justify-between border-b border-slate-50 pb-3">
                <div class="flex flex-col">
                  <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-folder-tree text-[#0A3C84]"></i> Estructura del Curso
                  </h3>
                  <span class="text-[11px] text-slate-450 mt-1 italic">Organice las unidades y lecciones del curso. Agregue videos y material de apoyo.</span>
                </div>
                <button type="button" onclick="addCursoModule()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold px-4 py-2.5 rounded-xl text-xs transition cursor-pointer flex items-center gap-1.5 font-sans">
                  <i class="fa-solid fa-plus"></i> Añadir Unidad / Módulo
                </button>
              </div>

              <!-- Module hierarchy container -->
              <div class="flex flex-col gap-6" id="curso-modules-list">
                <!-- Dynamic modules list -->
              </div>
            </div>

            <!-- Card: Docentes del Curso -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6">
              <div class="flex items-center justify-between border-b border-slate-50 pb-3">
                <div class="flex flex-col">
                  <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-user-tie text-[#0A3C84]"></i> Docentes del Curso
                  </h3>
                  <span class="text-[11px] text-slate-450 mt-1 italic">Agregue docentes e instructores. Busque perfiles registrados o ingréselos manualmente.</span>
                </div>
                <button type="button" onclick="addCursoSpeakerRow()" class="bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200/50 font-bold px-4 py-2.5 rounded-xl text-xs transition cursor-pointer flex items-center gap-1.5 font-sans">
                  <i class="fa-solid fa-plus"></i> Agregar Docente
                </button>
              </div>

              <div class="flex flex-col gap-5" id="curso-speakers-list">
                <!-- Dynamic flat list of speakers -->
              </div>
            </div>

          </form>
        </div>

        <!-- Floating Save Bar - Cursos -->
        <div id="curso-floating-bar" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] px-6 py-3">
          <div class="max-w-7xl mx-auto flex items-center justify-end gap-3">
            <button type="button" onclick="cancelCursoEdit()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-5 rounded-xl transition text-xs cursor-pointer">
              Cancelar
            </button>
            <button type="submit" form="curso-form" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-6 rounded-xl transition text-xs shadow-md cursor-pointer font-sans flex items-center gap-2">
              <i class="fa-solid fa-save text-[10px]"></i> Guardar Curso
            </button>
          </div>
        </div>

        <!-- Table Listing only Courses -->
        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm" id="curso-list-container">
          <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-slate-900">Cursos Activos</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                <tr>
                  <th class="px-6 py-4">Título</th>
                  <th class="px-6 py-4">Fecha</th>
                  <th class="px-6 py-4 text-center">Precio</th>
                  <th class="px-6 py-4 text-center">Estado</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium">
                <% if (typeof cursos !== 'undefined' && cursos && cursos.length > 0) { %>
                  <% cursos.forEach(function(ev) { %>
                    <tr class="hover:bg-slate-50/50 transition">
                      <td class="px-6 py-4">
                        <div class="font-bold text-slate-900 text-sm"><%= ev.titulo %></div>
                        <div class="text-[10px] text-slate-400 mt-0.5"><%= ev.slogan || '' %></div>
                      </td>
                      <td class="px-6 py-4 text-slate-500"><%= ev.fechaInicio ? new Date(ev.fechaInicio).toLocaleDateString() : '' %></td>
                      <td class="px-6 py-4 text-center font-bold">
                        <% if (ev.gratuito) { %>
                          <span class="bg-emerald-50 text-emerald-600 text-[9px] font-black px-2.5 py-0.5 rounded-full font-sans">Gratis</span>
                        <% } else { %>
                          <div class="flex flex-col items-center">
                            <span class="font-extrabold text-slate-800">$<%= Number(ev.precio).toFixed(2) %></span>
                            <% if (ev.descuentoEstudianteUsd && ev.descuentoEstudianteUsd > 0) { %>
                              <span class="text-[10px] font-black text-blue-600"><i class="fa-solid fa-graduation-cap text-[9px]"></i> Est: $<%= Number(ev.descuentoEstudianteUsd).toFixed(2) %></span>
                            <% } %>
                          </div>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black <%= ev.estado === 'ACTIVO' ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %>">
                          <%= ev.estado || 'ACTIVO' %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-right flex items-center justify-end gap-2 flex-wrap">
                        <button type="button" onclick='openDirectManualEnrollment("curso", <%= ev.id %>)' class="text-emerald-600 hover:text-emerald-800 bg-emerald-50 px-2 py-1 rounded-lg border border-emerald-100 cursor-pointer text-[9px] font-bold transition flex items-center gap-1" title="Matricular Alumno">
                          <i class="fa-solid fa-user-plus"></i> Inscribir
                        </button>
                        <button type="button" onclick='openCertificateDesignModalById("curso", <%= ev.id %>)' class="text-amber-600 hover:text-amber-800 bg-amber-50 px-2 py-1 rounded-lg border border-amber-150 cursor-pointer text-[9px] font-bold transition flex items-center gap-1">
                          <i class="fa-solid fa-certificate"></i> Certificado
                        </button>
                        <button type="button" onclick='openCurriculumBuilderById(<%= ev.id %>)' class="text-indigo-600 hover:text-indigo-800 bg-indigo-50 px-2 py-1 rounded-lg border border-indigo-100 cursor-pointer text-[9px] font-bold transition flex items-center gap-1">
                          <i class="fa-solid fa-list-check"></i> Temario
                        </button>
                        <button type="button" onclick='openSubmissionsViewerById(<%= ev.id %>)' class="text-emerald-600 hover:text-emerald-800 bg-emerald-50 px-2 py-1 rounded-lg border border-emerald-100 cursor-pointer text-[9px] font-bold transition flex items-center gap-1">
                          <i class="fa-solid fa-file-signature"></i> Entregas
                        </button>
                        <button type="button" onclick='openEventStatsModalById("curso", <%= ev.id %>)' class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 px-2 py-1 rounded-lg border border-blue-100 cursor-pointer text-[9px] font-bold transition flex items-center gap-1">
                          <i class="fa-solid fa-chart-line"></i> Estadísticas
                        </button>
                        <button onclick="editCursoById(<%= ev.id %>)" class="text-brand-blue hover:text-sky-800 bg-brand-lightBlue px-2 py-1 rounded-lg border border-brand-blue/10 cursor-pointer text-[9px] font-bold transition">Editar</button>
                        <form action="/dashboard/admin/events/delete/curso/<%= ev.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este curso?')" class="inline">
                          <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 px-2 py-1 rounded-lg border border-rose-100 cursor-pointer text-[9px] font-bold transition">Eliminar</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="px-6 py-12 text-center text-slate-400">
                      No hay cursos registrados en el sistema.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Curriculum Builder Container -->
        <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6 hidden" id="curso-curriculum-container">
          <div class="flex items-center justify-between border-b border-slate-50 pb-4">
            <div>
              <span class="text-[10px] font-black text-[#5A7AF3] uppercase tracking-widest">Currículum del Curso</span>
              <h3 class="text-xl font-black text-slate-900 mt-1" id="curriculum-course-title">Gestión de Temario</h3>
            </div>
            <button onclick="closeCurriculumBuilder()" class="bg-slate-50 hover:bg-slate-100 text-slate-700 font-extrabold py-2 px-4 rounded-xl border border-slate-100 transition text-xs flex items-center gap-1.5 cursor-pointer">
              <i class="fa-solid fa-arrow-left"></i> Volver a Cursos
            </button>
          </div>

          <div class="flex items-center gap-3">
            <button onclick="openModuleModal()" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-extrabold py-2.5 px-4 rounded-xl text-xs shadow-md transition flex items-center gap-2 cursor-pointer">
              <i class="fa-solid fa-folder-plus text-xs"></i> Agregar Módulo / Unidad
            </button>
          </div>

          <!-- Modules List Tree -->
          <div class="flex flex-col gap-4 mt-2" id="curriculum-tree-container">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Course Submissions Container -->
        <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6 hidden" id="curso-submissions-container">
          <div class="flex items-center justify-between border-b border-slate-50 pb-4">
            <div>
              <span class="text-[10px] font-black text-[#5A7AF3] uppercase tracking-widest">Entregas de Estudiantes</span>
              <h3 class="text-xl font-black text-slate-900 mt-1" id="submissions-course-title">Revisión de Tareas</h3>
            </div>
            <button onclick="closeSubmissionsViewer()" class="bg-slate-50 hover:bg-slate-100 text-slate-700 font-extrabold py-2 px-4 rounded-xl border border-slate-100 transition text-xs flex items-center gap-1.5 cursor-pointer">
              <i class="fa-solid fa-arrow-left"></i> Volver a Cursos
            </button>
          </div>

          <!-- Submissions Table -->
          <div class="overflow-x-auto border border-slate-100 rounded-2xl shadow-inner mt-2">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase border-b border-slate-100">
                <tr>
                  <th class="px-5 py-3.5">Estudiante</th>
                  <th class="px-5 py-3.5">Lección / Tarea</th>
                  <th class="px-5 py-3.5 text-center">Entrega</th>
                  <th class="px-5 py-3.5 text-center">Estado / Nota</th>
                  <th class="px-5 py-3.5 text-right">Acción</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium" id="submissions-table-body">
                <!-- Dynamically populated -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- MODALS FOR CURRICULUM CRUD -->
        
        <!-- Module Modal -->
        <div id="curriculum-module-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/40 backdrop-blur-sm hidden">
          <div class="bg-white rounded-[24px] max-w-md w-full p-6 shadow-xl border border-slate-100 flex flex-col gap-4 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between border-b border-slate-50 pb-3">
              <h4 class="font-black text-slate-900 text-sm" id="module-modal-title">Agregar Unidad/Módulo</h4>
              <button onclick="closeModuleModal()" class="w-7 h-7 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-400 transition cursor-pointer">
                <i class="fa-solid fa-xmark text-xs"></i>
              </button>
            </div>
            <form id="module-modal-form" class="flex flex-col gap-3">
              <input type="hidden" id="module-modal-id">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Título de la Unidad</label>
                <input type="text" id="module-modal-titulo" required placeholder="Ej: Unidad 1: Fundamentos de Derecho" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Orden / Posición</label>
                <input type="number" id="module-modal-orden" value="1" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none">
              </div>
              <div class="flex justify-end gap-2 border-t border-slate-50 pt-3 mt-2">
                <button type="button" onclick="closeModuleModal()" class="border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold px-4 py-2.5 rounded-xl text-xs transition cursor-pointer">Cancelar</button>
                <button type="submit" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-md transition cursor-pointer">Guardar Unidad</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Lesson Modal -->
        <div id="curriculum-lesson-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/40 backdrop-blur-sm hidden">
          <div class="bg-white rounded-[24px] max-w-lg w-full p-6 shadow-xl border border-slate-100 flex flex-col gap-4 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between border-b border-slate-50 pb-3">
              <h4 class="font-black text-slate-900 text-sm" id="lesson-modal-title">Agregar Lección</h4>
              <button onclick="closeLessonModal()" class="w-7 h-7 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-400 transition cursor-pointer">
                <i class="fa-solid fa-xmark text-xs"></i>
              </button>
            </div>
            <form id="lesson-modal-form" class="flex flex-col gap-3">
              <input type="hidden" id="lesson-modal-id">
              <input type="hidden" id="lesson-modal-moduleId">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Título de la Lección</label>
                <input type="text" id="lesson-modal-titulo" required placeholder="Ej: Clase 1.1: Introducción General" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Descripción / Contenido</label>
                <textarea id="lesson-modal-descripcion" placeholder="Resumen o guía breve..." rows="3" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition resize-none"></textarea>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">URL de Video (YouTube)</label>
                <input type="url" id="lesson-modal-videoUrl" placeholder="https://www.youtube.com/watch?v=..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Orden</label>
                <input type="number" id="lesson-modal-orden" value="1" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none">
              </div>
              <div class="flex justify-end gap-2 border-t border-slate-50 pt-3 mt-2">
                <button type="button" onclick="closeLessonModal()" class="border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold px-4 py-2.5 rounded-xl text-xs transition cursor-pointer">Cancelar</button>
                <button type="submit" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-md transition cursor-pointer">Guardar Lección</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Resource Modal -->
        <div id="curriculum-resource-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/40 backdrop-blur-sm hidden">
          <div class="bg-white rounded-[24px] max-w-md w-full p-6 shadow-xl border border-slate-100 flex flex-col gap-4 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between border-b border-slate-50 pb-3">
              <h4 class="font-black text-slate-900 text-sm">Agregar Recurso (Material de Apoyo)</h4>
              <button onclick="closeResourceModal()" class="w-7 h-7 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-400 transition cursor-pointer">
                <i class="fa-solid fa-xmark text-xs"></i>
              </button>
            </div>
            <form id="resource-modal-form" class="flex flex-col gap-3">
              <input type="hidden" id="resource-modal-lessonId">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Nombre del Recurso</label>
                <input type="text" id="resource-modal-nombre" required placeholder="Ej: Diapositivas - Introducción" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Subir Archivo o Documento</label>
                <input type="file" id="resource-modal-file" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-3 file:py-2 file:rounded-lg file:text-[10px] file:font-bold file:cursor-pointer bg-slate-50 border border-slate-100 rounded-xl py-1.5 px-2 text-slate-700 mb-1">
                <input type="hidden" id="resource-modal-base64">
                <input type="text" id="resource-modal-url" placeholder="O ingresa una URL externa" class="bg-slate-50 border border-slate-100 rounded-xl py-2.5 px-3 text-[10px] outline-none font-sans">
              </div>
              <div class="flex justify-end gap-2 border-t border-slate-50 pt-3 mt-2">
                <button type="button" onclick="closeResourceModal()" class="border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold px-4 py-2.5 rounded-xl text-xs transition cursor-pointer">Cancelar</button>
                <button type="submit" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-md transition cursor-pointer">Agregar Recurso</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Task Modal -->
        <div id="curriculum-task-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/40 backdrop-blur-sm hidden">
          <div class="bg-white rounded-[24px] max-w-lg w-full p-6 shadow-xl border border-slate-100 flex flex-col gap-4 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between border-b border-slate-50 pb-3">
              <h4 class="font-black text-slate-900 text-sm" id="task-modal-title">Agregar Tarea / Actividad</h4>
              <button onclick="closeTaskModal()" class="w-7 h-7 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-400 transition cursor-pointer">
                <i class="fa-solid fa-xmark text-xs"></i>
              </button>
            </div>
            <form id="task-modal-form" class="flex flex-col gap-3">
              <input type="hidden" id="task-modal-id">
              <input type="hidden" id="task-modal-lessonId">
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Título de la Tarea</label>
                <input type="text" id="task-modal-titulo" required placeholder="Ej: Trabajo Práctico: Análisis de Caso" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Instrucciones</label>
                <textarea id="task-modal-descripcion" placeholder="Explique los requerimientos..." rows="3" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition resize-none"></textarea>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Archivo Adjunto (Guía/Plantilla)</label>
                <input type="file" id="task-modal-file" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-3 file:py-2 file:rounded-lg file:text-[10px] file:font-bold file:cursor-pointer bg-slate-50 border border-slate-100 rounded-xl py-1.5 px-2 text-slate-700 mb-1">
                <input type="hidden" id="task-modal-base64">
                <input type="text" id="task-modal-archivoUrl" placeholder="O ingresa una URL del adjunto" class="bg-slate-50 border border-slate-100 rounded-xl py-2.5 px-3 text-[10px] outline-none font-sans">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Puntos Máximos</label>
                <input type="number" id="task-modal-puntos" value="100" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none">
              </div>
              <div class="flex justify-end gap-2 border-t border-slate-50 pt-3 mt-2">
                <button type="button" onclick="closeTaskModal()" class="border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold px-4 py-2.5 rounded-xl text-xs transition cursor-pointer">Cancelar</button>
                <button type="submit" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-md transition cursor-pointer">Guardar Tarea</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Grade Submission Modal -->
        <div id="grade-submission-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/40 backdrop-blur-sm hidden">
          <div class="bg-white rounded-[24px] max-w-md w-full p-6 shadow-xl border border-slate-100 flex flex-col gap-4 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between border-b border-slate-50 pb-3">
              <h4 class="font-black text-slate-900 text-sm">Calificar Entrega de Estudiante</h4>
              <button onclick="closeGradeModal()" class="w-7 h-7 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-400 transition cursor-pointer">
                <i class="fa-solid fa-xmark text-xs"></i>
              </button>
            </div>
            <form id="grade-modal-form" class="flex flex-col gap-3">
              <input type="hidden" id="grade-modal-submissionId">
              <div class="bg-slate-50 p-4 rounded-xl flex flex-col gap-1.5 text-xs text-slate-700 font-bold">
                <div>Estudiante: <span id="grade-modal-estudiante" class="text-slate-900"></span></div>
                <div>Tarea: <span id="grade-modal-tarea" class="text-slate-900"></span></div>
                <div>Nota Máxima: <span id="grade-modal-puntos-max" class="text-[#5A7AF3]"></span> puntos</div>
                <div class="mt-2 text-[10px] text-slate-400 font-semibold uppercase">Comentario del estudiante:</div>
                <div id="grade-modal-comentario-est" class="text-slate-500 italic mt-0.5 leading-relaxed"></div>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Calificación (Puntos)</label>
                <input type="number" step="0.1" id="grade-modal-calificacion" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Estado</label>
                <select id="grade-modal-estado" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition">
                  <option value="APROBADA">APROBADA</option>
                  <option value="RECHAZADA">RECHAZADA</option>
                </select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Retroalimentación / Feedback</label>
                <textarea id="grade-modal-feedback" placeholder="Comentarios del docente sobre el trabajo..." rows="3" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition resize-none"></textarea>
              </div>
              <div class="flex justify-end gap-2 border-t border-slate-50 pt-3 mt-2">
                <button type="button" onclick="closeGradeModal()" class="border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold px-4 py-2.5 rounded-xl text-xs transition cursor-pointer">Cancelar</button>
                <button type="submit" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-md transition cursor-pointer">Guardar Nota</button>
              </div>
            </form>
          </div>
        </div>
      </section>

      <!-- TAB: ARTICULOS CIENTIFICOS -->
      <section id="tab-articles" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Aprobación de Artículos Científicos</h2>
        
        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-slate-900">Artículos Recibidos</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                <tr>
                  <th class="px-6 py-4">Autor / Profesional</th>
                  <th class="px-6 py-4">Título del Artículo</th>
                  <th class="px-6 py-4">Resumen</th>
                  <th class="px-6 py-4 text-center">PDF</th>
                  <th class="px-6 py-4 text-center">Estado</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium">
                <% if (allArticles.length > 0) { %>
                  <% allArticles.forEach(function(art) { %>
                    <tr class="hover:bg-slate-50/50 transition">
                      <td class="px-6 py-4">
                        <div class="font-bold text-slate-900"><%= art.profile.user.name %></div>
                        <div class="text-[10px] text-slate-400"><%= art.profile.slogan %></div>
                      </td>
                      <td class="px-6 py-4 text-slate-900 font-bold truncate max-w-[180px]"><%= art.titulo %></td>
                      <td class="px-6 py-4 text-slate-500 truncate max-w-[200px]" title="<%= art.resumen %>"><%= art.resumen %></td>
                      <td class="px-6 py-4 text-center">
                        <div class="flex flex-col items-center gap-1.5">
                          <a href="/articulos/leer/<%= art.id %>" target="_blank" class="w-8 h-8 rounded-lg bg-sky-50 hover:bg-sky-100 text-sky-600 flex items-center justify-center border border-sky-100 transition mx-auto animate-duration-150" title="Leer en Lector">
                            <i class="fa-solid fa-book-open"></i>
                          </a>
                          <form action="/dashboard/admin/articles/reprocess/<%= art.id %>" method="POST">
                            <button type="submit" class="text-[9px] font-bold text-slate-400 hover:text-[#0A3C84] flex items-center gap-0.5 border-b border-transparent hover:border-[#0A3C84] cursor-pointer" title="Re-procesar PDF">
                              <i class="fa-solid fa-arrows-spin"></i> Re-procesar
                            </button>
                          </form>
                        </div>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <div class="flex flex-col items-center gap-1.5">
                          <span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= art.estado === 'APROBADO' ? 'bg-emerald-50 text-emerald-600' : art.estado === 'RECHAZADO' ? 'bg-rose-50 text-rose-600' : 'bg-amber-50 text-amber-600' %>">
                            <%= art.estado %>
                          </span>

                          <% if (art.estado === 'APROBADO') { %>
                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[8px] font-bold <%= art.displayMode === 'HTML' ? 'bg-sky-50 text-sky-700 border border-sky-100' : 'bg-purple-50 text-purple-700 border border-purple-100' %>">
                              <%= art.displayMode === 'HTML' ? 'Modo: HTML' : 'Modo: Visor PDF' %>
                            </span>
                          <% } %>

                          <% 
                            let convBadge = "";
                            let convLabel = "";
                            if (art.conversionStatus === "PENDING") {
                              convBadge = "bg-slate-50 text-slate-500 border-slate-100";
                              convLabel = "Pendiente";
                            } else if (art.conversionStatus === "PROCESSING") {
                              convBadge = "bg-sky-50 text-sky-600 border-sky-100 animate-pulse";
                              convLabel = "Procesando...";
                            } else if (art.conversionStatus === "COMPLETED") {
                              convBadge = "bg-emerald-50 text-emerald-600 border-emerald-100";
                              convLabel = "Lector OK";
                            } else if (art.conversionStatus === "FAILED") {
                              convBadge = "bg-rose-50 text-rose-600 border-rose-100";
                              convLabel = "Fallo";
                            }
                          %>
                          <% if (art.displayMode === 'HTML' || art.conversionStatus === 'COMPLETED') { %>
                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[8px] font-bold border <%= convBadge %>" title="<%= art.conversionError || '' %>">
                              <%= convLabel %>
                            </span>
                          <% } %>
                        </div>
                      </td>
                      <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                        <% if (art.estado === 'PENDIENTE') { %>
                          <!-- Aprobar como PDF Directo -->
                          <form action="/dashboard/admin/articles/approve/<%= art.id %>" method="POST">
                            <input type="hidden" name="displayMode" value="PDF">
                            <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-purple-50 text-purple-700 hover:bg-purple-100 border border-purple-100 text-[10px] font-bold flex items-center gap-1 transition cursor-pointer" title="Aprobar como PDF Directo (Visor)">
                              <i class="fa-solid fa-file-pdf"></i> Aprobar PDF
                            </button>
                          </form>
                          
                          <!-- Aprobar con Conversión HTML -->
                          <form action="/dashboard/admin/articles/approve/<%= art.id %>" method="POST">
                            <input type="hidden" name="displayMode" value="HTML">
                            <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-100 text-[10px] font-bold flex items-center gap-1 transition cursor-pointer" title="Aprobar con Conversión HTML (Lector)">
                              <i class="fa-solid fa-code"></i> Aprobar HTML
                            </button>
                          </form>
                          
                          <!-- Rechazar -->
                          <form action="/dashboard/admin/articles/reject/<%= art.id %>" method="POST">
                            <button type="submit" class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 flex items-center justify-center transition border border-rose-100/50 cursor-pointer" title="Rechazar artículo">
                              <i class="fa-solid fa-xmark"></i>
                            </button>
                          </form>
                        <% } else if (art.estado === 'APROBADO') { %>
                          <!-- Alternar entre PDF y HTML -->
                          <form action="/dashboard/admin/articles/toggle-mode/<%= art.id %>" method="POST">
                            <input type="hidden" name="displayMode" value="<%= art.displayMode === 'PDF' ? 'HTML' : 'PDF' %>">
                            <button type="submit" class="px-2.5 py-1 rounded-lg text-[9px] font-bold transition flex items-center gap-1 cursor-pointer <%= art.displayMode === 'PDF' ? 'bg-sky-50 text-sky-700 hover:bg-sky-100 border border-sky-100' : 'bg-purple-50 text-purple-700 hover:bg-purple-100 border border-purple-100' %>" title="Cambiar modo de publicación">
                              <i class="fa-solid fa-arrows-rotate"></i> Cambiar a <%= art.displayMode === 'PDF' ? 'HTML' : 'PDF' %>
                            </button>
                          </form>
                        <% } else { %>
                          <span class="text-slate-400 text-[10px]">Rechazado</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                      No hay artículos cargados por los profesionales.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
      <!-- TAB: COBROS / PAGOS CONFIG -->
      <section id="tab-payments" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Métodos de Cobro y Cuentas</h2>
        
        <div class="bg-white border border-slate-100 rounded-3xl p-8 shadow-sm flex flex-col gap-6">
          <h3 class="font-extrabold text-sm text-slate-900 border-b border-slate-50 pb-4">Cuentas bancarias para transferencias</h3>

          <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
            <div class="xl:col-span-2 overflow-x-auto border border-slate-100 rounded-2xl">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-400 uppercase tracking-wider font-black">
                  <tr>
                    <th class="px-4 py-3">Cuenta</th>
                    <th class="px-4 py-3">Datos</th>
                    <th class="px-4 py-3 text-center">Estado</th>
                    <th class="px-4 py-3 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                  <% if (typeof bankAccounts !== 'undefined' && bankAccounts.length > 0) { %>
                    <% bankAccounts.forEach(function(account) { %>
                      <tr class="align-top hover:bg-slate-50/50 transition">
                        <td class="px-4 py-4">
                          <div class="font-black text-slate-900"><%= account.institution %></div>
                          <div class="text-[9px] font-black uppercase tracking-widest <%= account.type === 'qr' ? 'text-purple-600' : 'text-blue-600' %>"><%= account.type === 'qr' ? 'QR' : 'Normal' %></div>
                        </td>
                        <td class="px-4 py-4 text-slate-600 font-semibold">
                          <% if (account.type === 'qr') { %>
                            <% if (account.qrImageUrl) { %>
                              <img src="<%= account.qrImageUrl %>" alt="QR <%= account.institution %>" class="w-20 h-20 object-contain rounded-xl border border-slate-100 bg-white p-1">
                            <% } else { %>
                              <span class="text-slate-400">Sin imagen QR</span>
                            <% } %>
                          <% } else { %>
                            <div><%= account.accountType %> · <%= account.accountNumber %></div>
                            <% if (account.taxId) { %>
                              <div class="text-[10px] text-slate-400">RUC/Cédula: <%= account.taxId %></div>
                            <% } %>
                            <div class="text-[10px] text-slate-400">Beneficiario: <%= account.beneficiaryName %></div>
                          <% } %>
                        </td>
                        <td class="px-4 py-4 text-center">
                          <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black <%= account.isActive && !account.deletedAt ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>">
                            <%= account.isActive && !account.deletedAt ? 'ACTIVA' : 'INACTIVA' %>
                          </span>
                        </td>
                        <td class="px-4 py-4">
                          <div class="flex justify-end gap-2 flex-wrap">
                            <button type="button" onclick="openBankAccountEditById(<%= account.id %>)" class="bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-150 font-black px-3 py-1.5 rounded-lg text-[10px] cursor-pointer">Editar</button>
                            <form action="/dashboard/admin/bank-accounts/<%= account.id %>/toggle" method="POST">
                              <button type="submit" class="bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-100 font-black px-3 py-1.5 rounded-lg text-[10px] cursor-pointer"><%= account.isActive ? 'Desactivar' : 'Activar' %></button>
                            </form>
                            <form action="/dashboard/admin/bank-accounts/<%= account.id %>/delete" method="POST" onsubmit="return confirm('¿Eliminar esta cuenta? Si tiene pagos asociados se marcará inactiva.')">
                              <button type="submit" class="bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-100 font-black px-3 py-1.5 rounded-lg text-[10px] cursor-pointer">Eliminar</button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" class="px-4 py-10 text-center text-slate-400 font-bold">No hay cuentas administrables. El sistema mantiene el texto legado como fallback público.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <form id="bank-account-form" action="/dashboard/admin/bank-accounts" method="POST" class="bg-slate-50/70 border border-slate-100 rounded-2xl p-5 flex flex-col gap-4">
              <div>
                <h4 id="bank-account-form-title" class="font-black text-sm text-slate-900">Nueva cuenta</h4>
                <p class="text-[10px] text-slate-450 font-semibold mt-1">Use normal para datos bancarios o QR para imagen de pago.</p>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <label class="flex flex-col gap-1.5 text-[10px] font-black text-slate-600 uppercase tracking-wider">Tipo
                  <select name="type" id="bank-account-type" onchange="toggleBankAccountFields()" class="bg-white border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-bold outline-none">
                    <option value="normal">Normal</option>
                    <option value="qr">QR</option>
                  </select>
                </label>
                <label class="flex items-end gap-2 text-[10px] font-black text-slate-600 uppercase tracking-wider pb-2">
                  <input type="checkbox" name="isActive" id="bank-account-active" checked class="rounded border-slate-300 text-[#0A3C84]"> Activa
                </label>
              </div>
              <label class="flex flex-col gap-1.5 text-[10px] font-black text-slate-600 uppercase tracking-wider">Institución financiera
                <input type="text" name="institution" id="bank-account-institution" required class="bg-white border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-bold outline-none" placeholder="Banco Pichincha">
              </label>
              <div id="bank-account-normal-fields" class="flex flex-col gap-3">
                <label class="flex flex-col gap-1.5 text-[10px] font-black text-slate-600 uppercase tracking-wider">Tipo de cuenta
                  <select name="accountType" id="bank-account-account-type" class="bg-white border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-bold outline-none">
                    <option value="Ahorros">Ahorros</option>
                    <option value="Corriente">Corriente</option>
                  </select>
                </label>
                <label class="flex flex-col gap-1.5 text-[10px] font-black text-slate-600 uppercase tracking-wider">Número de cuenta
                  <input type="text" name="accountNumber" id="bank-account-number" inputmode="numeric" pattern="[0-9]+" class="bg-white border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-bold outline-none" placeholder="2200123456">
                </label>
                <label class="flex flex-col gap-1.5 text-[10px] font-black text-slate-600 uppercase tracking-wider">RUC o cédula
                  <input type="text" name="taxId" id="bank-account-tax-id" inputmode="numeric" pattern="[0-9]+" class="bg-white border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-bold outline-none" placeholder="1790012345001">
                </label>
                <label class="flex flex-col gap-1.5 text-[10px] font-black text-slate-600 uppercase tracking-wider">Beneficiario
                  <input type="text" name="beneficiaryName" id="bank-account-beneficiary" class="bg-white border border-slate-100 rounded-xl py-2.5 px-3 text-xs font-bold outline-none" placeholder="Profesionales Ecuador">
                </label>
              </div>
              <div id="bank-account-qr-fields" class="hidden flex flex-col gap-3">
                <label class="flex flex-col gap-1.5 text-[10px] font-black text-slate-600 uppercase tracking-wider">Imagen QR
                  <input type="file" id="bank-account-qr-file" accept="image/png,image/jpeg,image/webp" onchange="readBankQrFile(this)" class="text-[10px] file:bg-white file:border-none file:px-3 file:py-2 file:rounded-lg file:font-black">
                  <input type="hidden" name="qrImage" id="bank-account-qr-image">
                </label>
                <img id="bank-account-qr-preview" src="" class="hidden w-28 h-28 object-contain bg-white rounded-xl border border-slate-100 p-1" alt="Vista previa QR">
              </div>
              <div class="flex gap-2 pt-2">
                <button type="submit" class="flex-1 bg-[#0A3C84] hover:bg-[#082C62] text-white font-black py-3 rounded-xl text-xs shadow-md cursor-pointer">Guardar cuenta</button>
                <button type="button" onclick="resetBankAccountForm()" class="bg-white hover:bg-slate-100 text-slate-600 border border-slate-150 font-black px-4 rounded-xl text-xs cursor-pointer">Limpiar</button>
              </div>
            </form>
          </div>

          <details class="border-t border-slate-50 pt-4">
            <summary class="text-[10px] font-black text-slate-500 uppercase tracking-wider cursor-pointer">Fallback legado de cuentas bancarias</summary>
            <form action="/dashboard/admin/payment-config" method="POST" class="flex flex-col gap-4 mt-4">
              <textarea id="pay-bank" name="bankAccounts" rows="3" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-mono"><%= systemConfig.bankAccounts %></textarea>
              <input type="hidden" name="payphoneToken" value="<%= systemConfig.payphoneToken || '' %>">
              <input type="hidden" name="kushkiPublicKey" value="<%= systemConfig.kushkiPublicKey || '' %>">
              <input type="hidden" name="kushkiPrivateKey" value="<%= systemConfig.kushkiPrivateKey || '' %>">
              <div class="flex justify-end">
                <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-2.5 px-5 rounded-xl transition text-[10px] cursor-pointer">Guardar fallback legado</button>
              </div>
            </form>
          </details>
        </div>

        <div class="bg-white border border-slate-100 rounded-3xl p-8 shadow-sm flex flex-col gap-6">
          <h3 class="font-extrabold text-sm text-slate-900 border-b border-slate-50 pb-4">Configurar pasarelas de pago</h3>
          
          <form action="/dashboard/admin/payment-config" method="POST" class="flex flex-col gap-6">
            
            <input type="hidden" name="bankAccounts" value="<%= systemConfig.bankAccounts %>">

            <!-- Kushki keys -->
            <div class="border-t border-slate-50 pt-6 flex flex-col gap-4">
              <h4 class="text-xs font-bold text-slate-700 flex items-center gap-1">
                <i class="fa-solid fa-key text-slate-400"></i>
                Credenciales de Kushki Pagos
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                  <label for="kush-pub" class="text-[10px] font-bold text-slate-650">Public Key</label>
                  <input type="text" id="kush-pub" name="kushkiPublicKey" value="<%= systemConfig.kushkiPublicKey || '' %>" placeholder="Public Merchant ID..." class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="kush-priv" class="text-[10px] font-bold text-slate-650">Private Key</label>
                  <input type="password" id="kush-priv" name="kushkiPrivateKey" value="<%= systemConfig.kushkiPrivateKey || '' %>" placeholder="••••••••" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition">
                </div>
              </div>
            </div>

            <div class="flex justify-end pt-4 border-t border-slate-50">
              <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3.5 px-8 rounded-xl transition text-xs shadow-md cursor-pointer">
                Guardar Configuración de Cobros
              </button>
            </div>
          </form>
        </div>

        <!-- PayPhone Dedicated Config Card -->
        <div class="bg-white border border-slate-100 rounded-3xl p-8 shadow-sm flex flex-col gap-6">
          <h3 class="font-extrabold text-sm text-slate-900 border-b border-slate-50 pb-4 flex items-center gap-2">
            <i class="fa-solid fa-mobile-screen-button text-slate-400"></i>
            Configuración PayPhone
          </h3>

          <% const ppToken = systemConfig.payphoneToken || ''; %>
          <% const ppTokenHint = ppToken ? 'Token guardado (\u2022\u2022\u2022\u2022' + (ppToken.length >= 4 ? ppToken.slice(-4) : ppToken) + '). Escriba uno nuevo para reemplazarlo.' : 'Ingresa tu Bearer Token de PayPhone...'; %>

          <form action="/dashboard/admin/config/payphone" method="POST" class="flex flex-col gap-6">
            <!-- Token -->
            <div class="flex flex-col gap-2">
              <label for="pp-token" class="text-xs font-bold text-slate-700 flex items-center gap-1">
                <i class="fa-solid fa-key text-slate-400"></i>
                Token de PayPhone (Bearer Token)
              </label>
              <p class="text-[10px] text-slate-450">Obtenido desde PayPhone Developer. Por seguridad, el token no se muestra completo una vez guardado.</p>
              <input type="password" id="pp-token" name="payphoneToken" placeholder="<%= ppTokenHint %>" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Store ID -->
              <div class="flex flex-col gap-1.5">
                <label for="pp-store" class="text-[10px] font-bold text-slate-650">Store ID</label>
                <input type="text" id="pp-store" name="payphoneStoreId" value="<%= systemConfig.payphoneStoreId || '' %>" placeholder="Ej: 123456" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition">
              </div>
              <!-- Tax Rate -->
              <div class="flex flex-col gap-1.5">
                <label for="pp-tax" class="text-[10px] font-bold text-slate-650">Tasa de IVA (%)</label>
                <input type="number" id="pp-tax" name="taxRate" value="<%= systemConfig.taxRate || 0 %>" min="0" max="100" step="0.01" placeholder="15" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition">
                <p class="text-[10px] text-slate-450">Ej: 15 para 15% de IVA en Ecuador.</p>
              </div>
            </div>

            <div class="flex justify-end pt-4 border-t border-slate-50">
              <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3.5 px-8 rounded-xl transition text-xs shadow-md cursor-pointer">
                Guardar Configuración PayPhone
              </button>
            </div>
          </form>
        </div>
      </section>

      <!-- TAB: MÓDULO REFERIDOS & COMISIONES (Cuentas, Creación, Ventas, Reglas, Retiros) -->
      <section id="tab-referidos" class="dash-tab-pane hidden flex flex-col gap-6">
        
        <!-- Header & Quick Action Card -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 p-6 sm:p-8 rounded-3xl text-white shadow-xl border border-blue-900/40">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-black uppercase tracking-wider mb-2 border border-amber-500/30">
              <i class="fa-solid fa-users-gear text-amber-400"></i> Control Maestro de Referidos
            </div>
            <h2 class="text-2xl font-black text-white">Módulo de Referidos & Comisiones</h2>
            <p class="text-xs text-slate-300 mt-1 max-w-xl">
              Crea comerciales externos en segundos ingresando únicamente su correo electrónico, aprueba ventas con alta automática de clientes, gestiona comisiones y autoriza retiros.
            </p>
          </div>

          <button onclick="openAdminCreateReferralModal()" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-500 hover:to-sky-400 text-white font-black text-xs shadow-lg shadow-blue-600/30 transition flex items-center justify-center gap-2 cursor-pointer">
            <i class="fa-solid fa-user-plus text-base"></i> Crear Nuevo Referido
          </button>
        </div>

        <!-- Sub-Tabs Navigation Inside Referidos -->
        <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-3 font-extrabold text-xs">
          <button onclick="switchReferralSubTab('cuentas')" id="ref-subtab-btn-cuentas" class="px-4 py-2 rounded-xl bg-blue-600 text-white shadow-sm cursor-pointer">
            <i class="fa-solid fa-users text-xs mr-1.5"></i> Cuentas de Referidos (<%= referralProfiles.length %>)
          </button>
          <button onclick="switchReferralSubTab('ventas')" id="ref-subtab-btn-ventas" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer">
            <i class="fa-solid fa-file-circle-check text-xs mr-1.5"></i> Revisar Ventas (<%= referralSales.filter(s => s.estado === 'PENDIENTE').length %>)
          </button>
          <button onclick="switchReferralSubTab('comisiones')" id="ref-subtab-btn-comisiones" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer">
            <i class="fa-solid fa-percent text-xs mr-1.5"></i> Reglas de Comisión
          </button>
          <button onclick="switchReferralSubTab('retiros')" id="ref-subtab-btn-retiros" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer">
            <i class="fa-solid fa-money-bill-transfer text-xs mr-1.5"></i> Solicitudes de Retiro (<%= referralWithdrawals.filter(w => w.estado === 'PENDIENTE').length %>)
          </button>
        </div>

        <!-- SUBTAB 1: Cuentas de Referidos -->
        <div id="ref-subtab-cuentas" class="space-y-6">
          <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-50 pb-3">
              <div>
                <h3 class="font-extrabold text-sm text-slate-900">Listado de Referidos Creados</h3>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Cuentas comerciales creadas desde este panel</p>
              </div>
              <button onclick="openAdminCreateReferralModal()" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-sm cursor-pointer flex items-center gap-1.5">
                <i class="fa-solid fa-plus"></i> Crear Referido (Ingresar Solo Email)
              </button>
            </div>

            <% if (referralProfiles.length === 0) { %>
              <div class="text-center py-12 text-slate-400">
                <i class="fa-solid fa-users text-3xl mb-2 text-slate-300"></i>
                <p class="text-xs font-semibold">No hay referidos creados aún en el sistema.</p>
                <button onclick="openAdminCreateReferralModal()" class="mt-3 px-4 py-2 bg-blue-50 text-blue-600 rounded-xl text-xs font-bold">Crear primer referido ahora</button>
              </div>
            <% } else { %>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs divide-y divide-slate-100">
                  <thead class="bg-slate-50 text-slate-400 font-bold uppercase text-[10px] tracking-wider">
                    <tr>
                      <th class="p-3">Referido</th>
                      <th class="p-3">Correo Acceso</th>
                      <th class="p-3">Banco Registrado</th>
                      <th class="p-3">Ventas</th>
                      <th class="p-3">Saldo Billetera</th>
                      <th class="p-3 text-center">Estado</th>
                      <th class="p-3 text-center">Acciones</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <% referralProfiles.forEach(function(ref) { %>
                      <tr class="hover:bg-slate-50/60 transition">
                        <td class="p-3 font-extrabold text-slate-900"><%= ref.nombres ? (ref.nombres + ' ' + (ref.apellidos || '')) : ref.user.name %></td>
                        <td class="p-3 font-bold text-blue-600"><%= ref.user.email %></td>
                        <td class="p-3 font-semibold text-slate-700"><%= ref.banco ? (ref.banco + ' - ' + ref.numeroCuenta) : 'Pendiente config' %></td>
                        <td class="p-3 font-black text-slate-900"><%= ref._count.sales %></td>
                        <td class="p-3 font-black text-emerald-600">$<%= (ref.wallet?.saldoDisponible || 0).toFixed(2) %></td>
                        <td class="p-3 text-center">
                          <% if (ref.status === 'ACTIVE') { %>
                            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Activo</span>
                          <% } else if (ref.status === 'PENDING_CONFIG') { %>
                            <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Pendiente Config</span>
                          <% } else { %>
                            <span class="bg-rose-100 text-rose-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Suspendido</span>
                          <% } %>
                        </td>
                        <td class="p-3 text-center">
                          <form action="/dashboard/admin/referidos/<%= ref.id %>/estado" method="POST" class="inline" onsubmit="event.preventDefault(); confirmToggleReferralStatus(this, <%= ref.status === 'SUSPENDED' %>, '<%= ref.user.email %>');">
                            <% if (ref.status === 'SUSPENDED') { %>
                              <input type="hidden" name="nuevoEstado" value="ACTIVE">
                              <button type="submit" class="px-2.5 py-1 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 rounded text-[10px] font-bold cursor-pointer">Reactivar</button>
                            <% } else { %>
                              <input type="hidden" name="nuevoEstado" value="SUSPENDED">
                              <button type="submit" class="px-2.5 py-1 bg-rose-50 text-rose-700 hover:bg-rose-100 rounded text-[10px] font-bold cursor-pointer">Suspender</button>
                            <% } %>
                          </form>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>

        <!-- SUBTAB 2: Ventas de Referidos -->
        <div id="ref-subtab-ventas" class="space-y-6 hidden">
          <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden p-6 space-y-4">
            <h3 class="font-extrabold text-sm text-slate-900">Revisión y Aprobación de Ventas</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs divide-y divide-slate-100">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase text-[10px] tracking-wider">
                  <tr>
                    <th class="p-3">ID / Fecha</th>
                    <th class="p-3">Referido (Vendedor)</th>
                    <th class="p-3">Cliente Final</th>
                    <th class="p-3">Producto Adquirido</th>
                    <th class="p-3">Monto / Comisión</th>
                    <th class="p-3 text-center">Estado</th>
                    <th class="p-3 text-center">Acciones Admin</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% referralSales.forEach(function(s) { %>
                    <tr class="hover:bg-slate-50/60 transition">
                      <td class="p-3 font-black text-slate-900">#<%= s.id %></td>
                      <td class="p-3 font-bold text-slate-800"><%= s.referral.user.email %></td>
                      <td class="p-3 font-semibold text-slate-700"><%= s.clienteNombre %> (<%= s.clienteEmail %>)</td>
                      <td class="p-3 font-bold text-slate-900"><%= s.productName %></td>
                      <td class="p-3 font-black text-emerald-600">$<%= s.valorPagado.toFixed(2) %> (Com: $<%= s.comisionCalculada.toFixed(2) %>)</td>
                      <td class="p-3 text-center">
                        <% if (s.estado === 'APROBADO') { %>
                          <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Aprobado</span>
                        <% } else if (s.estado === 'PENDIENTE') { %>
                          <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Pendiente</span>
                        <% } else { %>
                          <span class="bg-rose-100 text-rose-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Rechazado</span>
                        <% } %>
                      </td>
                      <td class="p-3 text-center">
                        <% if (s.estado !== 'APROBADO') { %>
                          <form action="/dashboard/admin/referidos/ventas/<%= s.id %>/aprobar" method="POST" class="inline" onsubmit="event.preventDefault(); abrirConfirmacionModal({ title: 'Aprobar Venta de Referido', message: '¿Aprobar venta #<%= s.id %>? Se creará/inscribirá al cliente y se acreditará la comisión de $<%= s.comisionCalculada.toFixed(2) %> al referido.', icon: 'fa-solid fa-circle-check text-emerald-600 text-lg', btnText: 'Aprobar Venta', btnClass: 'px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5', form: this });">
                            <button type="submit" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded text-[10px] font-black cursor-pointer shadow-sm transition">Aprobar</button>
                          </form>
                        <% } else { %>
                          <span class="text-[10px] text-slate-400 font-semibold">Procesada</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- SUBTAB 3: Reglas de Comisiones -->
        <div id="ref-subtab-comisiones" class="space-y-6 hidden">
          
          <div class="bg-blue-50/80 border border-blue-100 p-4 rounded-2xl flex items-center gap-3 text-blue-900 text-xs">
            <i class="fa-solid fa-circle-info text-blue-600 text-base flex-shrink-0"></i>
            <div>
              <span class="font-extrabold">Productos y Servicios Pagados Comercializables:</span>
              <p class="text-[11px] text-blue-800 leading-normal">
                Las comisiones aplican exclusivamente a <strong>productos y servicios pagados</strong> (Conversatorios de pago, Cursos de pago, Planes de Afiliación y Promoción). Los eventos gratuitos no requieren configuración de comisiones.
              </p>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Form Comisión General -->
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-4">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                  <i class="fa-solid fa-globe"></i>
                </div>
                <div>
                  <h4 class="font-extrabold text-sm text-slate-900">Comisión General Base</h4>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">Se aplica a cualquier producto sin regla específica</p>
                </div>
              </div>

              <form action="/dashboard/admin/referidos/comisiones/general" method="POST" class="space-y-3 text-xs">
                <% const genCfg = commissionConfigs.find(c => c.isGeneral); %>
                <div>
                  <label class="block font-bold text-slate-700 uppercase mb-1">Porcentaje General (% USD)</label>
                  <input type="number" step="0.5" name="porcentaje" value="<%= genCfg ? genCfg.porcentaje : 30 %>" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-black text-slate-900 text-base">
                </div>
                <button type="submit" class="w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black rounded-xl cursor-pointer">Actualizar Comisión General</button>
              </form>
            </div>

            <!-- Form Comisión Específica por Producto/Conversatorio/Curso -->
            <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-4">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                  <i class="fa-solid fa-bullseye"></i>
                </div>
                <div>
                  <h4 class="font-extrabold text-sm text-slate-900">Comisión Específica por Producto</h4>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">Asigna porcentaje a un conversatorio, curso o plan específico</p>
                </div>
              </div>

              <form action="/dashboard/admin/referidos/comisiones/especifica" method="POST" class="space-y-3 text-xs">
                <div class="space-y-3">
                  <div>
                    <label class="block font-bold text-slate-700 uppercase mb-1">Tipo de Producto *</label>
                    <select id="comm-product-type" name="productType" onchange="updateCommissionProductOptions()" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 font-bold text-slate-800">
                      <option value="CONVERSATORIO">Conversatorio</option>
                      <option value="CURSO">Curso Académico</option>
                      <option value="PLAN_AFILIACION">Plan de Afiliación</option>
                      <option value="PLAN_PROMOCION">Plan de Promoción</option>
                    </select>
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 uppercase mb-1">Producto / Evento Específico *</label>
                    <select id="comm-product-id" name="productId" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 font-bold text-slate-800">
                      <!-- Populated dynamically via JS -->
                    </select>
                  </div>

                  <div>
                    <label class="block font-bold text-slate-700 uppercase mb-1">Porcentaje de Comisión (%) *</label>
                    <input type="number" step="0.5" name="porcentaje" placeholder="Ej: 35.0" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-black text-emerald-600 text-base">
                  </div>
                </div>

                <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-black rounded-xl cursor-pointer shadow-md">Guardar Regla Específica</button>
              </form>
            </div>
          </div>

          <!-- Tabla de Reglas Específicas Configuradas -->
          <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden p-6 space-y-4">
            <h4 class="font-extrabold text-sm text-slate-900">Reglas Específicas Activas</h4>
            
            <% const specificConfigs = commissionConfigs.filter(c => !c.isGeneral); %>
            <% if (specificConfigs.length === 0) { %>
              <p class="text-center py-6 text-slate-400 font-semibold text-xs">No hay reglas específicas configuradas. Se aplicará la Comisión General Base.</p>
            <% } else { %>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs divide-y divide-slate-100">
                  <thead class="bg-slate-50 text-slate-400 font-bold uppercase text-[10px] tracking-wider">
                    <tr>
                      <th class="p-3">Tipo Producto</th>
                      <th class="p-3">Producto / Evento Específico</th>
                      <th class="p-3">Porcentaje Asignado</th>
                      <th class="p-3 text-center">Nivel de Prioridad</th>
                      <th class="p-3 text-center">Acciones</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <% specificConfigs.forEach(function(cfg) { %>
                      <% 
                        let pName = 'Todos los productos de este tipo';
                        if (cfg.productId) {
                          if (cfg.productType === 'CONVERSATORIO') {
                            const match = conversatorios.find(c => c.id === cfg.productId);
                            if (match) pName = match.titulo;
                          } else if (cfg.productType === 'CURSO') {
                            const match = cursos.find(c => c.id === cfg.productId);
                            if (match) pName = match.titulo;
                          } else if (cfg.productType === 'PLAN_AFILIACION') {
                            const match = plans.find(p => p.id === cfg.productId);
                            if (match) pName = match.nombre;
                          } else if (cfg.productType === 'PLAN_PROMOCION') {
                            const match = promotionPlans.find(p => p.id === cfg.productId);
                            if (match) pName = match.nombre;
                          }
                        }
                      %>
                      <tr class="hover:bg-slate-50/60 transition">
                        <td class="p-3 font-extrabold text-slate-900">
                          <% if (cfg.productType === 'CONVERSATORIO') { %>
                            <span class="text-blue-600"><i class="fa-solid fa-comments mr-1"></i> Conversatorio</span>
                          <% } else if (cfg.productType === 'CURSO') { %>
                            <span class="text-purple-600"><i class="fa-solid fa-graduation-cap mr-1"></i> Curso</span>
                          <% } else if (cfg.productType === 'PLAN_AFILIACION') { %>
                            <span class="text-emerald-600"><i class="fa-solid fa-id-card mr-1"></i> Plan Afiliación</span>
                          <% } else { %>
                            <span class="text-amber-600"><i class="fa-solid fa-rectangle-ad mr-1"></i> Plan Promoción</span>
                          <% } %>
                        </td>
                        <td class="p-3 font-bold text-slate-800"><%= pName %></td>
                        <td class="p-3 font-black text-emerald-600 text-sm"><%= cfg.porcentaje %>%</td>
                        <td class="p-3 text-center">
                          <% if (cfg.productId) { %>
                            <span class="bg-blue-100 text-blue-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Prioridad Máxima (Producto Específico)</span>
                          <% } else { %>
                            <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Prioridad Media (Por Categoría)</span>
                          <% } %>
                        </td>
                        <td class="p-3 text-center">
                          <form action="/dashboard/admin/referidos/comisiones/eliminar/<%= cfg.id %>" method="POST" class="inline" onsubmit="event.preventDefault(); abrirConfirmacionModal({ title: 'Eliminar Regla de Comisión', message: '¿Está seguro de eliminar esta regla de comisión?', icon: 'fa-solid fa-trash-can text-rose-600 text-lg', btnText: 'Eliminar Regla', btnClass: 'px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5', form: this });">
                            <button type="submit" class="px-2.5 py-1 bg-rose-50 text-rose-700 hover:bg-rose-100 rounded text-[10px] font-bold cursor-pointer">Eliminar</button>
                          </form>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>

        </div>

        <!-- SUBTAB 4: Solicitudes de Retiro -->
        <div id="ref-subtab-retiros" class="space-y-6 hidden">
          <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden p-6 space-y-4">
            <h3 class="font-extrabold text-sm text-slate-900">Solicitudes de Retiro Bancario</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs divide-y divide-slate-100">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase text-[10px] tracking-wider">
                  <tr>
                    <th class="p-3">ID / Fecha</th>
                    <th class="p-3">Referido</th>
                    <th class="p-3">Cuenta Bancaria</th>
                    <th class="p-3">Monto</th>
                    <th class="p-3 text-center">Estado</th>
                    <th class="p-3 text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% referralWithdrawals.forEach(function(w) { %>
                    <tr class="hover:bg-slate-50/60 transition">
                      <td class="p-3 font-black text-slate-900">#<%= w.id %></td>
                      <td class="p-3 font-bold text-slate-800"><%= w.referral.user.email %></td>
                      <td class="p-3">
                        <div class="space-y-0.5 text-xs">
                          <p class="font-extrabold text-slate-900 text-xs"><%= w.banco || (w.referral && w.referral.banco) || 'Banco no registrado' %></p>
                          <p class="text-[11px] font-mono text-slate-800"><span class="font-bold text-slate-500">Número de cuenta:</span> <%= w.numeroCuenta || (w.referral && w.referral.numeroCuenta) || '-' %></p>
                          <p class="text-[11px] text-slate-700"><span class="font-bold text-slate-500">Cédula:</span> <%= w.titularCedula || (w.referral && (w.referral.titularCedula || w.referral.cedula)) || '-' %></p>
                          <p class="text-[11px] text-slate-700">
                            <span class="font-bold text-slate-500">Tipo de cuenta:</span> <%= w.tipoCuenta || (w.referral && w.referral.tipoCuenta) || 'Cuenta de ahorros' %> 
                            <span class="text-[9px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200/60 ml-1">
                              <%= (w.referral && (w.referral.status === 'ACTIVE' || w.referral.status === 'ACTIVA')) ? 'cuenta activa' : (w.referral ? w.referral.status : 'cuenta activa') %>
                            </span>
                          </p>
                          <p class="text-[11px] font-bold text-slate-900"><span class="font-normal text-slate-500">Nombre titular:</span> <%= w.titularNombre || (w.referral && (w.referral.titularNombre || (w.referral.nombres ? (w.referral.nombres + ' ' + (w.referral.apellidos || '')) : w.referral.user.name))) %></p>
                        </div>
                      </td>
                      <td class="p-3 font-black text-emerald-600">$<%= w.monto.toFixed(2) %></td>
                      <td class="p-3 text-center">
                        <% if (w.estado === 'PAGADO') { %>
                          <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Pagado</span>
                        <% } else if (w.estado === 'PENDIENTE') { %>
                          <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Pendiente</span>
                        <% } else { %>
                          <span class="bg-rose-100 text-rose-800 text-[10px] font-black px-2.5 py-0.5 rounded-full">Rechazado</span>
                        <% } %>
                      </td>
                      <td class="p-3 text-center">
                        <% if (w.estado !== 'PAGADO') { %>
                          <form action="/dashboard/admin/referidos/retiros/<%= w.id %>/procesar" method="POST" class="inline" onsubmit="event.preventDefault(); abrirConfirmacionModal({ title: 'Confirmar Pago de Retiro', message: '¿Marcar el retiro #<%= w.id %> de $<%= w.monto.toFixed(2) %> como PAGADO?', icon: 'fa-solid fa-circle-check text-emerald-600 text-lg', btnText: 'Sí, Marcar Pagado', btnClass: 'px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5', form: this });">
                            <input type="hidden" name="estado" value="PAGADO">
                            <button type="submit" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded text-[10px] font-black cursor-pointer shadow-sm transition">Marcar Pagado</button>
                          </form>
                        <% } else { %>
                          <span class="text-[10px] text-slate-400 font-semibold">Completado</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </section>

      <!-- TAB: PEDIDOS (Órdenes de Pago) -->
      <section id="tab-orders" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Listado de Pedidos y Transacciones</h2>
        <p class="text-xs text-slate-500 -mt-3">Visualice, apruebe o rechace las transferencias bancarias de las membresías de profesionales o la adquisición de certificaciones académicas en la plataforma.</p>

        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-slate-900">Pedidos Recibidos</h3>
            <span class="bg-sky-100 text-[#0A3C84] text-[10px] font-bold px-2.5 py-0.5 rounded-full"><%= paymentRequests.length %> Totales</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                <tr>
                  <th class="px-6 py-4">Usuario / Profesional</th>
                  <th class="px-6 py-4">Concepto</th>
                  <th class="px-6 py-4 text-center">Monto</th>
                  <th class="px-6 py-4">Detalle Pago</th>
                  <th class="px-6 py-4 text-center">Estado</th>
                  <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50 font-medium">
                <% if (typeof paymentRequests !== 'undefined' && paymentRequests.length > 0) { %>
                  <% paymentRequests.forEach(function(req) { %>
                    <% 
                      const profName = req.issuer && req.issuer.professionalProfile && req.issuer.professionalProfile.user 
                        ? req.issuer.professionalProfile.user.name 
                        : (req.certificate && req.certificate.user ? req.certificate.user.name : (req.promotion && req.promotion.profile && req.promotion.profile.user ? req.promotion.profile.user.name : req.razonSocial));
                      const paymentUserEmail = req.issuer
                        ? req.issuer.email
                        : (req.certificate && req.certificate.user
                          ? req.certificate.user.email
                          : (req.promotion && req.promotion.profile && req.promotion.profile.user ? req.promotion.profile.user.email : ''));
                      let concept = 'Recarga Saldo';
                      if (req.tipo === 'MEMBERSHIP') {
                        concept = 'Mensualidad / Verificación';
                      } else if (req.tipo === 'CERTIFICATE') {
                        concept = 'Adquisición de Certificado';
                      } else if (req.tipo === 'PROMOTION') {
                        concept = 'Promoción de Perfil';
                      }
                      const snapshot = req.bankAccountSnapshot || null;
                      const snapshotLabel = snapshot && snapshot.institution
                        ? (snapshot.type === 'qr'
                          ? `${snapshot.institution} - QR`
                          : [snapshot.institution, snapshot.accountType, snapshot.accountNumber, snapshot.taxId ? `RUC/Cédula: ${snapshot.taxId}` : null, snapshot.beneficiaryName ? `Beneficiario: ${snapshot.beneficiaryName}` : null].filter(Boolean).join(' - '))
                        : '';
                      const bankDisplay = req.bankAccountLabel || snapshotLabel || req.bancoDestino || systemConfig.bankAccounts || 'Transferencia';
                    %>
                    <tr class="hover:bg-slate-50/50 transition">
                      <td class="px-6 py-4">
                        <div class="font-extrabold text-slate-900"><%= profName %></div>
                        <% if (req.tipo === 'CERTIFICATE') { %>
                          <div class="text-[10px] text-[#0252A4] font-bold"><%= req.certificate ? req.certificate.nombreEvento : 'Evento' %></div>
                        <% } else if (req.tipo === 'PROMOTION' && req.promotion && req.promotion.plan) { %>
                          <div class="text-[10px] text-indigo-600 font-bold">Plan: <%= req.promotion.plan.nombre %></div>
                        <% } else { %>
                          <div class="text-[10px] text-slate-400">RUC: <%= req.ruc %></div>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 text-slate-600 font-bold">
                        <span class="px-2 py-1 rounded text-[9px] font-black uppercase <%= req.tipo === 'CERTIFICATE' ? 'bg-purple-100 text-purple-800' : req.tipo === 'MEMBERSHIP' ? 'bg-blue-100 text-blue-800' : req.tipo === 'PROMOTION' ? 'bg-indigo-100 text-indigo-800' : 'bg-slate-150 text-slate-700' %>">
                          <%= concept %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-center font-extrabold text-slate-800">$<%= req.monto.toFixed(2) %></td>
                      <td class="px-6 py-4">
                        <div class="text-slate-700 font-bold"><%= bankDisplay %></div>
                        <div class="text-[10px] text-slate-400">Ref: <%= req.referencia %></div>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black <%= req.estado === 'APROBADO' ? 'bg-emerald-50 text-emerald-600' : req.estado === 'RECHAZADO' ? 'bg-rose-50 text-rose-600' : 'bg-amber-50 text-amber-600' %>">
                          <%= req.estado %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-right flex items-center justify-end">
                        <button onclick="openReviewPaymentModal({
                          id: <%= req.id %>,
                          alumnoName: '<%= profName.replace(/'/g, "\\'") %>',
                          alumnoEmail: '<%= paymentUserEmail.replace(/'/g, "\\'") %>',
                          bancoDestino: '<%= bankDisplay.replace(/'/g, "\\'") %>',
                          referencia: '<%= req.referencia.replace(/'/g, "\\'") %>',
                          monto: <%= req.monto %>,
                          estado: '<%= req.estado %>',
                          comprobante: '<%= req.comprobante || '' %>'
                        })" class="<%= req.estado === 'PENDIENTE' ? 'bg-[#0A3C84] hover:bg-[#082C62] text-white' : 'bg-slate-50 hover:bg-slate-100 text-slate-500 border border-slate-100' %> text-[10px] font-extrabold px-3 py-1.5 rounded-lg transition cursor-pointer flex items-center gap-1.5">
                          <i class="fa-solid fa-magnifying-glass text-[9px]"></i> 
                          <%= req.estado === 'PENDIENTE' ? 'Revisar' : 'Ver Detalle' %>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-slate-400 font-semibold">
                      No hay solicitudes de pago registradas.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB: CATALOGS -->
      <section id="tab-catalogs" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Especialidades & Categorías</h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Professions -->
          <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6">
            <h3 class="font-extrabold text-sm text-slate-900" id="profession-form-title">Crear Profesión</h3>
            <form action="/dashboard/admin/professions" method="POST" class="flex flex-col gap-4">
              <input type="hidden" name="id" id="profession-id">
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Nombre de Profesión</label>
                <input type="text" name="nombre" id="profession-nombre" required placeholder="Ej: Medicina, Psicología" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Descripción</label>
                <textarea name="descripcion" id="profession-descripcion" rows="2" placeholder="Detalle..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition resize-none"></textarea>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Imagen del Carrusel (Fondo)</label>
                <div class="flex items-center gap-3 bg-slate-50 border border-slate-100 p-3 rounded-2xl">
                  <div class="w-12 h-12 rounded-xl border border-slate-100 bg-white flex items-center justify-center overflow-hidden flex-shrink-0">
                    <img id="profession-image-preview" src="" class="w-full h-full object-cover hidden">
                    <span id="profession-image-placeholder" class="text-[10px] font-bold text-slate-400 uppercase text-center"><i class="fa-solid fa-image text-sm"></i></span>
                  </div>
                  <div class="flex-grow flex flex-col gap-1">
                    <input type="file" id="profession-image-file" accept="image/*" class="text-[10px] w-full file:bg-slate-100 file:border-none file:px-2 file:py-1 file:rounded-md file:cursor-pointer file:font-bold">
                    <input type="hidden" name="imagen" id="profession-imagen">
                    <span class="text-[9px] text-slate-400 font-semibold">Resolución recomendada: 500x500 px.</span>
                  </div>
                </div>
              </div>
              <div class="flex gap-2">
                <button type="button" id="profession-cancel-btn" onclick="cancelProfessionEdit()" class="hidden border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-3 px-4 rounded-xl transition text-xs cursor-pointer flex-1">
                  Cancelar
                </button>
                <button type="submit" id="profession-form-btn" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3 rounded-xl transition text-xs shadow-md flex-grow">
                  Guardar Profesión
                </button>
              </div>
            </form>
          </div>

          <!-- Specialties -->
          <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6">
            <h3 class="font-extrabold text-sm text-slate-900" id="specialty-form-title">Crear Especialidad</h3>
            <form action="/dashboard/admin/specialties" method="POST" class="flex flex-col gap-4">
              <input type="hidden" name="id" id="specialty-id">
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Profesión Asociada</label>
                <select name="professionId" id="specialty-professionId" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                  <% if (professions && professions.length > 0) { %>
                    <% professions.forEach(function(p) { %>
                      <option value="<%= p.id %>"><%= p.nombre %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Nombre de Especialidad</label>
                <input type="text" name="nombre" id="specialty-nombre" required placeholder="Ej: Cardiología, Penal" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
              </div>
              <div class="flex gap-2">
                <button type="button" id="specialty-cancel-btn" onclick="cancelSpecialtyEdit()" class="hidden border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-3 px-4 rounded-xl transition text-xs cursor-pointer flex-1">
                  Cancelar
                </button>
                <button type="submit" id="specialty-form-btn" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3 rounded-xl transition text-xs shadow-md flex-grow">
                  Guardar Especialidad
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Listing Tables for Professions and Specialties -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">
          <!-- Professions Table -->
          <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
            <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
              <h3 class="font-extrabold text-sm text-slate-900">Profesiones Registradas</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-4">Nombre</th>
                    <th class="px-6 py-4">Descripción</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 font-medium">
                  <% if (professions && professions.length > 0) { %>
                    <% professions.forEach(function(p) { %>
                      <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-6 py-4 text-slate-900 font-bold"><%= p.nombre %></td>
                        <td class="px-6 py-4 text-slate-500"><%= p.descripcion || 'Sin descripción' %></td>
                        <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                          <button type="button" onclick="editProfessionById(<%= p.id %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100/50 transition text-[10px] cursor-pointer">
                            Editar
                          </button>
                          <form action="/dashboard/admin/professions/delete/<%= p.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar esta profesión? Se eliminarán todas sus especialidades asociadas.')" class="inline">
                            <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold px-2.5 py-1.5 rounded-lg border border-rose-100 transition text-[10px] cursor-pointer">
                              Eliminar
                            </button>
                          </form>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="3" class="px-6 py-12 text-center text-slate-400">
                        No hay profesiones registradas.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Specialties Table -->
          <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
            <div class="px-6 py-5 border-b border-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <h3 class="font-extrabold text-sm text-slate-900">Especialidades Registradas</h3>
              <div class="flex items-center gap-2">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-wider whitespace-nowrap">Filtrar por Profesión:</label>
                <select id="admin-specialty-filter" onchange="filterAdminSpecialtiesTable()" class="bg-slate-50 border border-slate-100 rounded-xl py-1.5 px-3 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-700 font-semibold">
                  <option value="">Seleccione una profesión...</option>
                  <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
                    <% professions.forEach(function(p) { %>
                      <option value="<%= p.id %>"><%= p.nombre %></option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-4">Nombre</th>
                    <th class="px-6 py-4">Profesión</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="admin-specialties-tbody" class="divide-y divide-slate-50 font-medium">
                  <% 
                    let hasSpecialties = false;
                    if (professions && professions.length > 0) {
                      professions.forEach(function(p) {
                        if (p.specialties && p.specialties.length > 0) {
                          hasSpecialties = true;
                        }
                      });
                    }
                  %>
                  <% if (hasSpecialties) { %>
                    <% professions.forEach(function(p) { %>
                      <% if (p.specialties && p.specialties.length > 0) { %>
                        <% p.specialties.forEach(function(s) { %>
                          <tr class="hover:bg-slate-50/50 transition hidden" data-profession-id="<%= p.id %>">
                            <td class="px-6 py-4 text-slate-900 font-bold"><%= s.nombre %></td>
                            <td class="px-6 py-4 text-slate-500 font-semibold"><%= p.nombre %></td>
                            <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                              <button type="button" onclick="editSpecialtyById(<%= p.id %>, <%= s.id %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100/50 transition text-[10px] cursor-pointer">
                                Editar
                              </button>
                              <form action="/dashboard/admin/specialties/delete/<%= s.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar esta especialidad?')" class="inline">
                                <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold px-2.5 py-1.5 rounded-lg border border-rose-100 transition text-[10px] cursor-pointer">
                                  Eliminar
                                </button>
                              </form>
                            </td>
                          </tr>
                        <% }); %>
                      <% } %>
                    <% }); %>
                    <tr id="admin-specialties-empty-row" class="empty-state-row">
                      <td colspan="3" class="px-6 py-12 text-center text-slate-400 font-semibold">
                        Seleccione una profesión arriba para ver sus especialidades.
                      </td>
                    </tr>
                  <% } else { %>
                    <tr id="admin-specialties-empty-row" class="empty-state-row">
                      <td colspan="3" class="px-6 py-12 text-center text-slate-400">
                        No hay especialidades registradas.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB: CATEGORÍAS & RAMAS DE ENSEÑANZA PARA CURSOS -->
      <section id="tab-curso-categories" class="dash-tab-pane hidden flex flex-col gap-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900">Categorías & Ramas de Enseñanza para Cursos</h2>
            <p class="text-xs font-semibold text-slate-500 mt-1">Organice la estructura académica por Profesión para evitar mezclar categorías entre distintas carreras.</p>
          </div>
          <div class="flex items-center gap-3 bg-slate-50 p-2.5 rounded-2xl border border-slate-100 min-w-[280px]">
            <i class="fa-solid fa-filter text-[#0A3C84] text-xs pl-1"></i>
            <div class="flex flex-col gap-0.5 w-full">
              <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Filtrar por Profesión</span>
              <select id="admin-category-prof-filter" onchange="onAdminProfFilterChange(this.value)" class="bg-transparent text-xs font-extrabold text-slate-800 outline-none w-full cursor-pointer">
                <option value="">Todas las Profesiones</option>
                <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
                  <% professions.forEach(function(p) { %>
                    <option value="<%= p.id %>"><%= p.nombre %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          <!-- Left Column: Form to Create/Edit Category or Branch -->
          <div class="lg:col-span-5 flex flex-col gap-6">
            <!-- Form 1: Categorías de Cursos -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-5">
              <div class="flex items-center justify-between">
                <h3 class="font-extrabold text-sm text-slate-900" id="curso-category-form-title">Crear Nueva Categoría</h3>
                <button type="button" onclick="resetCursoCategoryForm()" id="curso-category-cancel-btn" class="hidden text-[10px] text-slate-400 hover:text-slate-600 font-bold">Cancelar edición</button>
              </div>
              <form id="curso-category-form" onsubmit="handleSaveCursoCategory(event)" class="flex flex-col gap-4">
                <input type="hidden" name="id" id="curso-cat-id">
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Profesión Asociada</label>
                  <select name="professionId" id="curso-cat-professionId" onchange="onAdminProfFilterChange(this.value)" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-semibold text-slate-700">
                    <option value="">Todas / Sin profesión específica</option>
                    <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
                      <% professions.forEach(function(p) { %>
                        <option value="<%= p.id %>"><%= p.nombre %></option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Nombre de Categoría <span class="text-rose-500">*</span></label>
                  <input type="text" name="nombre" id="curso-cat-nombre" required placeholder="Ej: Inteligencia Artificial, Cirugía General" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Descripción (Opcional)</label>
                  <textarea name="descripcion" id="curso-cat-descripcion" rows="2" placeholder="Breve descripción..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition resize-none"></textarea>
                </div>
                <button type="submit" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3 rounded-xl text-xs transition shadow-sm cursor-pointer">
                  Guardar Categoría
                </button>
              </form>
            </div>

            <!-- Form 2: Ramas de Enseñanza -->
            <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-5">
              <div class="flex items-center justify-between">
                <h3 class="font-extrabold text-sm text-slate-900" id="curso-branch-form-title">Crear Rama de Enseñanza</h3>
                <button type="button" onclick="resetCursoBranchForm()" id="curso-branch-cancel-btn" class="hidden text-[10px] text-slate-400 hover:text-slate-600 font-bold">Cancelar edición</button>
              </div>
              <form id="curso-branch-form" onsubmit="handleSaveCursoBranch(event)" class="flex flex-col gap-4">
                <input type="hidden" name="id" id="curso-branch-id">
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Categoría Padre <span class="text-rose-500">*</span></label>
                  <select name="categoryId" id="curso-branch-categoryId" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition font-semibold text-slate-700">
                    <option value="">Seleccione categoría...</option>
                  </select>
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Nombre de la Rama de Enseñanza <span class="text-rose-500">*</span></label>
                  <input type="text" name="nombre" id="curso-branch-nombre" required placeholder="Ej: Gemini, IA para Profesionales, ChatGPT" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-xs font-bold text-slate-700">Descripción (Opcional)</label>
                  <textarea name="descripcion" id="curso-branch-descripcion" rows="2" placeholder="Detalle de la rama..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition resize-none"></textarea>
                </div>
                <button type="submit" class="w-full bg-purple-700 hover:bg-purple-800 text-white font-extrabold py-3 rounded-xl text-xs transition shadow-sm cursor-pointer">
                  Guardar Rama de Enseñanza
                </button>
              </form>
            </div>
          </div>

          <!-- Right Column: Tree List of Categories and Branches -->
          <div class="lg:col-span-7 bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6">
            <div class="flex items-center justify-between border-b border-slate-50 pb-4">
              <h3 class="font-extrabold text-sm text-slate-900">Estructura Actual de Categorías & Ramas</h3>
              <button type="button" onclick="loadCursoCategoriesData()" class="text-xs text-[#0A3C84] hover:underline font-bold"><i class="fa-solid fa-arrows-rotate mr-1"></i> Actualizar</button>
            </div>
            <div id="curso-categories-tree-container" class="flex flex-col gap-4">
              <div class="text-center py-12 text-slate-400 font-semibold text-xs">
                <i class="fa-solid fa-spinner fa-spin mr-2"></i> Cargando categorías y ramas de enseñanza...
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB: CONVENIOS -->
      <section id="tab-agreements" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Convenios Comerciales y Aliados</h2>
        <p class="text-xs text-slate-450 font-medium">Administre convenios comerciales que ofrecen descuentos y beneficios económicos a los usuarios.</p>
        
        <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6">
          <h3 class="font-extrabold text-sm text-slate-900" id="agreement-form-title">Agregar / Editar Convenio Comercial</h3>
          <form action="/dashboard/admin/agreements/save" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4" id="agreement-form">
            <input type="hidden" name="id" id="agreement-id">
            
            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Nombre de la Empresa / Aliado</label>
              <input type="text" name="empresa" id="agreement-empresa" required placeholder="Ej: Total Flex / Arnold Gym" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Título del Convenio</label>
              <input type="text" name="titulo" id="agreement-titulo" required placeholder="Ej: Descuento Exclusivo Fitness" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Detalle del Beneficio ($ / Texto)</label>
              <input type="text" name="beneficio" id="agreement-beneficio" required placeholder="Ej: $10 de descuento en la membresía" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Monto Descuento</label>
                <input type="number" step="0.01" name="descuento" id="agreement-descuento" placeholder="10.00" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-slate-700">Tipo Descuento</label>
                <select name="tipoDescuento" id="agreement-tipoDescuento" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
                  <option value="USD">Monto Fijo ($ USD)</option>
                  <option value="PORCENTAJE">Porcentaje (%)</option>
                </select>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Usuarios Elegibles</label>
              <select name="usuariosElegibles" id="agreement-usuariosElegibles" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
                <option value="TODOS">TODOS (Profesionales y Estudiantes)</option>
                <option value="PROFESIONALES">Solo PROFESIONALES</option>
                <option value="ESTUDIANTES">Solo ESTUDIANTES</option>
              </select>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Categoría</label>
              <select name="categoria" id="agreement-categoria" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
                <option value="Empresa Aliada">Empresa Aliada</option>
                <option value="Patrocinador">Patrocinador</option>
                <option value="Aval Académico">Aval Académico</option>
                <option value="Aliado Estratégico">Aliado Estratégico</option>
              </select>
            </div>

            <div class="flex flex-col gap-1.5 md:col-span-2">
              <label class="text-xs font-bold text-slate-700">Condición para Canjear Beneficio</label>
              <input type="text" name="condiciones" id="agreement-condiciones" placeholder="Ej: Presentar tarjeta digital de Profesionales Ecuador." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>

            <div class="flex flex-col gap-1.5 md:col-span-2">
              <label class="text-xs font-bold text-slate-700">Descripción / Detalles</label>
              <textarea name="descripcion" id="agreement-descripcion" rows="2" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition resize-none font-semibold"></textarea>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Enlace Web del Aliado</label>
              <input type="url" name="link" id="agreement-link" placeholder="https://..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Orden de Visualización</label>
              <input type="number" name="orden" id="agreement-orden" value="0" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>

            <div class="flex items-center gap-2 pt-2 md:col-span-2">
              <input type="checkbox" name="activo" id="agreement-activo" value="true" checked class="w-4 h-4 rounded text-brand-blue border-slate-300">
              <label for="agreement-activo" class="text-xs font-bold text-slate-700">Convenio Activo</label>
            </div>

            <div class="md:col-span-2 flex justify-end gap-2 mt-4 pt-4 border-t border-slate-100 font-sans">
              <button type="button" onclick="cancelAgreementEdit()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-5 rounded-xl transition text-xs">
                Cancelar
              </button>
              <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-5 rounded-xl transition text-xs shadow-md">
                Guardar Convenio
              </button>
            </div>
          </form>
        </div>

        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-400 font-bold uppercase border-b border-slate-100">
              <tr>
                <th class="px-6 py-4">Empresa / Convenio</th>
                <th class="px-6 py-4">Beneficio / Descuento</th>
                <th class="px-6 py-4">Elegibles</th>
                <th class="px-6 py-4 text-center">Estado</th>
                <th class="px-6 py-4 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <% if (agreements && agreements.length > 0) { %>
                <% agreements.forEach(function(a) { %>
                  <tr>
                    <td class="px-6 py-4">
                      <p class="text-slate-900 font-extrabold"><%= a.empresa || a.titulo %></p>
                      <p class="text-[11px] text-slate-500 font-medium"><%= a.titulo %></p>
                    </td>
                    <td class="px-6 py-4">
                      <span class="bg-amber-50 text-amber-800 font-bold px-2.5 py-1 rounded-lg text-xs border border-amber-200/50">
                        <%= a.beneficio || (a.descuento ? (a.tipoDescuento === 'PORCENTAJE' ? a.descuento + '%' : '$' + a.descuento + ' USD') : 'Descuento Convenio') %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-slate-600 font-bold">
                      <%= a.usuariosElegibles || 'TODOS' %>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase <%= a.activo !== false ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-400' %>">
                        <%= a.activo !== false ? 'ACTIVO' : 'INACTIVO' %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                      <button onclick="editAgreementById(<%= a.id %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1 rounded-lg border border-blue-100/50 transition text-[10px]">
                        Editar
                      </button>
                      <form action="/dashboard/admin/agreements/toggle/<%= a.id %>" method="POST">
                        <button type="submit" class="text-blue-600 hover:text-blue-800 bg-blue-50 font-bold px-2.5 py-1 rounded-lg border border-blue-100 text-[10px]">
                          <%= a.activo !== false ? 'Desactivar' : 'Activar' %>
                        </button>
                      </form>
                      <form action="/dashboard/admin/agreements/delete/<%= a.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este convenio?')">
                        <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold px-2.5 py-1 rounded-lg border border-rose-100 transition text-[10px]">
                          Eliminar
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="px-6 py-6 text-center text-slate-400 font-bold">No hay convenios comerciales registrados.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- TAB: BENEFICIOS DEL SISTEMA -->
      <section id="tab-benefits" class="dash-tab-pane hidden flex flex-col gap-6">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Beneficios del Sistema</h2>
        <p class="text-xs text-slate-450 font-medium">Administre el catálogo de beneficios visibles para usuarios y visitantes.</p>
        
        <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-6">
          <h3 class="font-extrabold text-sm text-slate-900" id="benefit-form-title">Agregar Nuevo Beneficio</h3>
          <form action="/dashboard/admin/benefits/save" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4" id="benefit-form">
            <input type="hidden" name="id" id="benefit-id">
            <input type="hidden" name="imagenBase64" id="benefit-imagenBase64">
            <input type="hidden" name="imagen" id="benefit-imagen-url">
            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Título del Beneficio</label>
              <input type="text" name="titulo" id="benefit-titulo" required placeholder="Ej: Tarjeta Digital &amp; QR" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>
            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Categoría Elegible</label>
              <select name="categoria" id="benefit-categoria" required class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
                <option value="GENERAL">GENERAL (Todos)</option>
                <option value="PROFESIONALES">PROFESIONALES</option>
                <option value="ESTUDIANTES">ESTUDIANTES</option>
              </select>
            </div>
            <div class="flex flex-col gap-1.5 md:col-span-2">
              <label class="text-xs font-bold text-slate-700">Descripción del Beneficio</label>
              <textarea name="descripcion" id="benefit-descripcion" rows="2" required placeholder="Descripción clara y concisa de lo que obtiene el usuario..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition resize-none font-semibold"></textarea>
            </div>

            <!-- Imagen / Logo del Beneficio -->
            <div class="flex flex-col gap-1.5 md:col-span-2">
              <label class="text-xs font-bold text-slate-700">Imagen / Logo del Beneficio</label>
              <div class="flex items-start gap-4">
                <div class="flex-1 flex flex-col gap-2">
                  <label class="flex items-center justify-center gap-2 bg-blue-50 border border-dashed border-blue-300 hover:bg-blue-100 rounded-xl py-3 px-4 text-xs font-bold text-blue-600 cursor-pointer transition">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Seleccionar imagen
                    <input type="file" accept="image/*" class="hidden" onchange="handleBenefitImageUpload(this)">
                  </label>
                  <span class="text-[9px] text-slate-400 font-medium">PNG, JPG o WebP. Se sube automáticamente al guardar.</span>
                </div>
                <div id="benefit-image-preview-wrap" class="w-20 h-20 rounded-xl overflow-hidden bg-slate-50 border border-slate-100 flex items-center justify-center flex-shrink-0 shadow-inner">
                  <img id="benefit-image-preview" src="" class="w-full h-full object-contain hidden">
                  <i id="benefit-image-placeholder" class="fa-solid fa-image text-2xl text-slate-300"></i>
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Ícono FontAwesome (si no hay imagen)</label>
              <input type="text" name="icono" id="benefit-icono" placeholder="Ej: fa-solid fa-star" value="fa-solid fa-star" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>
            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Plan Requerido</label>
              <select name="requierePlan" id="benefit-requierePlan" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
                <option value="GRATUITO">GRATUITO (Incluido para todos)</option>
                <option value="PREMIUM">PREMIUM (Plan Pago)</option>
              </select>
            </div>
            <div class="flex flex-col gap-1.5">
              <label class="text-xs font-bold text-slate-700">Orden de Visualización</label>
              <input type="number" name="orden" id="benefit-orden" value="0" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-brand-blue transition font-semibold">
            </div>
            <div class="flex items-center gap-2 pt-4">
              <input type="checkbox" name="activo" id="benefit-activo" value="true" checked class="w-4 h-4 rounded text-brand-blue border-slate-300">
              <label for="benefit-activo" class="text-xs font-bold text-slate-700">Beneficio Activo</label>
            </div>
            <div class="md:col-span-2 flex justify-end gap-2 mt-4 pt-4 border-t border-slate-100">
              <button type="button" onclick="resetBenefitForm()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2.5 px-5 rounded-xl transition text-xs">
                Cancelar / Limpiar
              </button>
              <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-5 rounded-xl transition text-xs shadow-md">
                Guardar Beneficio
              </button>
            </div>
          </form>
        </div>

        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-400 font-bold uppercase border-b border-slate-100">
              <tr>
                <th class="px-6 py-4">Beneficio</th>
                <th class="px-6 py-4">Categoría</th>
                <th class="px-6 py-4">Plan Requerido</th>
                <th class="px-6 py-4 text-center">Estado</th>
                <th class="px-6 py-4 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <% if (typeof benefits !== 'undefined' && benefits && benefits.length > 0) { %>
                <% benefits.forEach(function(b) { %>
                  <tr>
                    <td class="px-6 py-4 text-slate-900 font-bold">
                      <div class="flex items-center gap-3">
                        <% if (b.imagen) { %>
                          <div class="w-10 h-10 rounded-xl overflow-hidden bg-slate-50 border border-slate-100 flex items-center justify-center flex-shrink-0">
                            <img src="<%= b.imagen %>" alt="<%= b.titulo %>" class="w-full h-full object-contain">
                          </div>
                        <% } else { %>
                          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm flex-shrink-0">
                            <i class="<%= b.icono %>"></i>
                          </div>
                        <% } %>
                        <span><%= b.titulo %></span>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-slate-600"><%= b.categoria %></td>
                    <td class="px-6 py-4 text-slate-600 font-bold"><%= b.requierePlan %></td>
                    <td class="px-6 py-4 text-center">
                      <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase <%= b.activo ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-400' %>">
                        <%= b.activo ? 'ACTIVO' : 'INACTIVO' %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <button type="button" onclick='editBenefit(<%= JSON.stringify({id: b.id, titulo: b.titulo, descripcion: b.descripcion, icono: b.icono, imagen: b.imagen || "", categoria: b.categoria, requierePlan: b.requierePlan, orden: b.orden, activo: b.activo}) %>)' class="text-sky-600 hover:text-sky-800 bg-sky-50 font-bold px-2.5 py-1 rounded-lg border border-sky-100 text-[10px] cursor-pointer">
                          Editar
                        </button>
                        <form action="/dashboard/admin/benefits/toggle/<%= b.id %>" method="POST">
                          <button type="submit" class="text-blue-600 hover:text-blue-800 bg-blue-50 font-bold px-2.5 py-1 rounded-lg border border-blue-100 text-[10px]">
                            <%= b.activo ? 'Desactivar' : 'Activar' %>
                          </button>
                        </form>
                        <form action="/dashboard/admin/benefits/delete/<%= b.id %>" method="POST" onsubmit="return confirm('¿Eliminar este beneficio?')">
                          <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 font-bold px-2.5 py-1 rounded-lg border border-rose-100 text-[10px]">
                            Eliminar
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="px-6 py-6 text-center text-slate-400 font-bold">No hay beneficios registrados en el sistema.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <script>
          function handleBenefitImageUpload(fileInput) {
            const file = fileInput.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
              const base64 = e.target.result;
              document.getElementById('benefit-imagenBase64').value = base64;
              document.getElementById('benefit-imagen-url').value = '';
              const preview = document.getElementById('benefit-image-preview');
              const placeholder = document.getElementById('benefit-image-placeholder');
              if (preview) { preview.src = base64; preview.classList.remove('hidden'); }
              if (placeholder) placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
          }

          function editBenefit(b) {
            document.getElementById('benefit-id').value = b.id;
            document.getElementById('benefit-titulo').value = b.titulo || '';
            document.getElementById('benefit-descripcion').value = b.descripcion || '';
            document.getElementById('benefit-icono').value = b.icono || 'fa-solid fa-star';
            document.getElementById('benefit-categoria').value = b.categoria || 'GENERAL';
            document.getElementById('benefit-requierePlan').value = b.requierePlan || 'GRATUITO';
            document.getElementById('benefit-orden').value = b.orden || 0;
            document.getElementById('benefit-activo').checked = !!b.activo;
            document.getElementById('benefit-imagenBase64').value = '';
            document.getElementById('benefit-imagen-url').value = b.imagen || '';
            document.getElementById('benefit-form-title').innerText = 'Editar Beneficio: ' + b.titulo;

            const preview = document.getElementById('benefit-image-preview');
            const placeholder = document.getElementById('benefit-image-placeholder');
            if (b.imagen) {
              preview.src = b.imagen;
              preview.classList.remove('hidden');
              placeholder.classList.add('hidden');
            } else {
              preview.src = '';
              preview.classList.add('hidden');
              placeholder.classList.remove('hidden');
            }
            document.getElementById('benefit-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
          }

          function resetBenefitForm() {
            document.getElementById('benefit-id').value = '';
            document.getElementById('benefit-titulo').value = '';
            document.getElementById('benefit-descripcion').value = '';
            document.getElementById('benefit-icono').value = 'fa-solid fa-star';
            document.getElementById('benefit-categoria').value = 'GENERAL';
            document.getElementById('benefit-requierePlan').value = 'GRATUITO';
            document.getElementById('benefit-orden').value = '0';
            document.getElementById('benefit-activo').checked = true;
            document.getElementById('benefit-imagenBase64').value = '';
            document.getElementById('benefit-imagen-url').value = '';
            document.getElementById('benefit-form-title').innerText = 'Agregar Nuevo Beneficio';
            const preview = document.getElementById('benefit-image-preview');
            const placeholder = document.getElementById('benefit-image-placeholder');
            preview.src = ''; preview.classList.add('hidden');
            placeholder.classList.remove('hidden');
          }
        </script>
      </section>

      <!-- TAB: CAROUSELS HERO -->
      <section id="tab-carousels" class="dash-tab-pane hidden flex flex-col gap-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900">Sliders & Publicidad Hero</h2>
            <p class="text-xs text-slate-450 mt-1 font-medium font-sans">Administre las imágenes destacadas y anuncios para la página de inicio y las páginas de cada profesión.</p>
          </div>
          <button onclick="openCarouselModal()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3 px-5 rounded-2xl transition text-xs shadow-md flex items-center gap-2 cursor-pointer font-sans">
            <i class="fa-solid fa-plus text-xs"></i> Crear Nuevo Slider
          </button>
        </div>

        <!-- Filters Section -->
        <div class="bg-white border border-slate-100 rounded-3xl p-5 shadow-sm flex flex-col md:flex-row items-center gap-4 justify-between font-sans">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-slate-50 text-slate-500 flex items-center justify-center text-xs border border-slate-100">
              <i class="fa-solid fa-filter"></i>
            </div>
            <div>
              <span class="text-xs font-extrabold text-slate-800">Filtrar por ubicación</span>
              <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider">Organice la visualización de banners</p>
            </div>
          </div>
          <div class="flex items-center gap-3 w-full md:w-auto">
            <select id="carousel-filter-location" onchange="filterCarousels()" class="w-full md:w-auto bg-slate-50 border border-slate-100 rounded-xl py-2.5 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-700 font-extrabold">
              <option value="all">Ver Todos los Banners</option>
              <option value="Inicio">Página Principal (Inicio)</option>
              <option value="profesiones">Todas las Profesiones (General)</option>
              <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
                <% professions.forEach(function(p) { %>
                  <option value="prof-<%= p.id %>">Profesión: <%= p.nombre %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <!-- Table of active sliders (Full Width) -->
        <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm flex flex-col justify-between self-start w-full">
          <div>
            <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
              <h3 class="font-extrabold text-sm text-slate-900">Listado de Banners / Sliders</h3>
              <span id="carousel-counter" class="bg-[#0A3C84] text-white text-[9px] font-black px-2.5 py-0.5 rounded-full"><%= carousels.length %> Configurados</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-4">Miniatura</th>
                    <th class="px-6 py-4">Título / Ubicación</th>
                    <th class="px-6 py-4 text-center">Tipo / Destino</th>
                    <th class="px-6 py-4 text-center">Orden</th>
                    <th class="px-6 py-4 text-center">Estado</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="carousel-table-body" class="divide-y divide-slate-50 font-medium text-slate-700">
                  <% if (carousels && carousels.length > 0) { %>
                    <% carousels.forEach(function(slide) { %>
                      <%
                        let belongsToName = "Inicio";
                        if (slide.tipo === "Profesion" && typeof professions !== 'undefined' && professions) {
                          const matchingProf = professions.find(p => p.id === slide.profesionId);
                          if (matchingProf) {
                            belongsToName = matchingProf.nombre;
                          } else {
                            belongsToName = "Profesión Indefinida";
                          }
                        }
                      %>
                      <tr class="hover:bg-slate-50/50 transition" data-tipo="<%= slide.tipo %>" data-profesion-id="<%= slide.profesionId || '' %>">
                        <td class="px-6 py-4">
                          <div class="w-16 h-10 rounded-lg overflow-hidden bg-slate-100 border border-slate-100 flex-shrink-0">
                            <img src="<%= slide.imageUrl %>" class="w-full h-full object-cover">
                          </div>
                        </td>
                        <td class="px-6 py-4">
                          <div class="font-extrabold text-slate-900 text-sm max-w-sm truncate"><%= slide.titulo || 'Sin Título' %></div>
                          <div class="text-[10px] text-slate-450 mt-0.5 max-w-sm truncate"><%= slide.subtitulo || 'Sin subtítulo' %></div>
                        </td>
                        <td class="px-6 py-4 text-center">
                          <span class="bg-blue-50 text-[#0A3C84] text-[9px] font-black px-2.5 py-0.5 rounded-full whitespace-nowrap">
                            <%= belongsToName %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-center font-extrabold"><%= slide.orden %></td>
                        <td class="px-6 py-4 text-center">
                          <span class="px-2 py-0.5 rounded-full text-[9px] font-bold <%= slide.activo ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-400' %>">
                            <%= slide.activo ? 'Activo' : 'Inactivo' %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                          <button onclick="editCarouselById(<%= slide.id %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100/50 transition text-[10px] cursor-pointer">
                            Editar
                          </button>
                          <form action="/dashboard/admin/carousels/delete/<%= slide.id %>" method="POST" onsubmit="return confirm('¿Está seguro de eliminar este banner?')" class="inline">
                            <button type="submit" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold px-2.5 py-1.5 rounded-lg border border-rose-100 transition text-[10px] cursor-pointer">
                              Eliminar
                            </button>
                          </form>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr id="carousel-empty-row">
                      <td colspan="6" class="px-6 py-12 text-center text-slate-400 font-semibold">
                        No hay sliders de publicidad registrados.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB: CMS -->
      <!-- CMS & Páginas Legales -->
      <section id="tab-cms" class="dash-tab-pane hidden flex flex-col gap-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900">CMS & Páginas Legales</h2>
            <p class="text-xs font-semibold text-slate-500 mt-1">Administra y edita el contenido informativo del sitio web de forma modular o en HTML.</p>
          </div>
        </div>
        
        <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm">
          <form action="/dashboard/admin/cms" method="POST" class="flex flex-col gap-5 text-left">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="flex flex-col gap-1">
                <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Página a Editar</label>
                <select name="slug" id="cms-slug-select" onchange="loadCmsPageData(this.value)" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 text-xs font-bold outline-none cursor-pointer focus:bg-white focus:border-brand-blue transition text-slate-800">
                  <option value="nosotros">Sobre Nosotros</option>
                  <option value="contacto">Contáctanos</option>
                  <option value="faq">FAQ (Preguntas Frecuentes)</option>
                  <option value="terminos">Términos y Condiciones</option>
                  <option value="privacidad">Políticas de Privacidad</option>
                </select>
              </div>
              
              <!-- Standard Title Input (Hidden for nosotros & contacto since their titles are fixed) -->
              <div class="flex flex-col gap-1" id="cms-title-container">
                <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Título de la Página</label>
                <input type="text" name="titulo" id="cms-title-input" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-brand-blue transition text-slate-800">
              </div>
            </div>

            <!-- 1. STANDARD TEXT / HTML EDITOR (For terminos, privacidad) -->
            <div id="cms-standard-editor" class="space-y-2">
              <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Contenido (HTML / Texto Plano)</label>
              <textarea name="contenido" id="cms-content-textarea" rows="12" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs font-bold outline-none focus:bg-white focus:border-brand-blue transition font-mono text-slate-800" placeholder="Escribe el código HTML o texto plano aquí..."></textarea>
            </div>

            <!-- 1B. MODULAR FAQ CUSTOMIZER (For faq) -->
            <div id="cms-faq-editor" class="hidden space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
                
                <!-- Column 1: FAQS Profesionales -->
                <div class="space-y-4">
                  <h3 class="text-xs font-black text-[#0A3C84] uppercase tracking-wider border-b border-slate-100 pb-2">FAQS Profesionales (FAQS PROF.)</h3>
                  
                  <!-- Pregunta 1 -->
                  <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/60 space-y-2">
                    <label class="text-[9px] font-bold text-slate-400 uppercase block">Pregunta 1</label>
                    <input type="text" name="faq_prof_q1" id="cms-faq-prof-q1" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-bold text-slate-800">
                    <label class="text-[8px] font-bold text-slate-400 uppercase block">Respuesta 1</label>
                    <textarea name="faq_prof_a1" id="cms-faq-prof-a1" rows="3" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-800"></textarea>
                  </div>

                  <!-- Pregunta 2 -->
                  <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/60 space-y-2">
                    <label class="text-[9px] font-bold text-slate-400 uppercase block">Pregunta 2</label>
                    <input type="text" name="faq_prof_q2" id="cms-faq-prof-q2" class="w-full bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-bold text-slate-800">
                    <label class="text-[8px] font-bold text-slate-400 uppercase block">Respuesta 2</label>
                    <textarea name="faq_prof_a2" id="cms-faq-prof-a2" rows="3" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-800"></textarea>
                  </div>

