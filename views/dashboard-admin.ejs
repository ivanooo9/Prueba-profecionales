    async function fetchAdminEditableEventDetail(type, id) {
      const endpoint = type === 'curso'
        ? `/api/admin/cursos/${encodeURIComponent(id)}/detail`
        : `/api/admin/conversatorios/${encodeURIComponent(id)}/detail`;

      const response = await fetch(endpoint, {
        headers: { 'Accept': 'application/json' }
      });
      const data = await response.json().catch(() => ({}));

      if (!response.ok || !data.success) {
        throw new Error(data.error || 'No se pudo cargar el detalle editable.');
      }

      const ev = type === 'curso' ? data.curso : data.conversatorio;
      const list = type === 'curso' ? window.cursosList : window.conversatoriosList;
      const index = list.findIndex(item => item.id === ev.id);
      if (index >= 0) {
        list[index] = { ...list[index], ...ev };
      } else {
        list.push(ev);
      }

      return ev;
    }

    async function editConversatorioById(id) {
      try {
        let ev = (window.conversatoriosList || []).find(item => item.id == id);
        if (ev) {
          editConversatorio(ev);
        }
        try {
          const fetchedEv = await fetchAdminEditableEventDetail('conversatorio', id);
          if (fetchedEv) {
            editConversatorio(fetchedEv);
          }
        } catch (fetchErr) {
          console.warn("Aviso al obtener detalle expandido del conversatorio:", fetchErr);
          if (!ev) {
            throw fetchErr;
          }
        }
      } catch (error) {
        console.error("Error al cargar conversatorio para edición:", error);
        alert('No se pudo cargar el conversatorio para edición: ' + (error.message || error));
      }
    }

