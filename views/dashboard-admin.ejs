    function addSpeakerToDay(dayIndex) {
      conversatorioSpeakers.push({
        id: null,
        dayIndex: dayIndex,
        nombre: '',
        foto: '',
        profesion: '',
        horario: '',
        slogan: '',
        tema: '',
        descripcion: '',
        videoUrl: '',
        gratuita: false,
        resources: [],
        redes: { facebook: '', twitter: '', instagram: '', linkedin: '' }
      });
      renderConversatorioDays();
    }

    function removeConversatorioSpeaker(index) {
      conversatorioSpeakers.splice(index, 1);
      renderConversatorioDays();
    }

    function uploadSpeakerPhoto(index, fileInput) {
      const file = fileInput.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        conversatorioSpeakers[index].foto = e.target.result;
        const imgPreview = document.getElementById(`sp-preview-${index}`);
        if (imgPreview) {
          imgPreview.src = e.target.result;
          imgPreview.classList.remove('hidden');
        }
        const placeholder = document.getElementById(`sp-placeholder-${index}`);
        if (placeholder) {
          placeholder.classList.add('hidden');
        }
      };
      reader.readAsDataURL(file);
    }

    function setSpeakerResources(index, resources) {
      conversatorioSpeakers[index].resources = Array.isArray(resources) ? resources : [];
      const list = document.getElementById(`speaker-resources-${index}`);
      if (list) list.innerHTML = renderSpeakerResources(conversatorioSpeakers[index].resources);
    }

    async function refreshSpeakerResources(index) {
      const speaker = conversatorioSpeakers[index];
      if (!speaker?.id) return;

      const response = await fetch(`/api/admin/conversatorios/speakers/${speaker.id}/resources`, {
        headers: { 'Accept': 'application/json' }
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.success) {
        throw new Error(data.error || 'No se pudieron cargar los recursos.');
      }
      setSpeakerResources(index, data.resources || []);
    }

    function handleSpeakerResourceDrop(event, index) {
      event.preventDefault();
      event.currentTarget.classList.remove('border-emerald-400');
      const file = event.dataTransfer?.files?.[0];
      uploadSpeakerResourceFile(index, file);
    }

    async function uploadSpeakerResourceFile(index, file) {
      const speaker = conversatorioSpeakers[index];
      if (!speaker?.id) {
        alert('Guarda el conversatorio antes de subir recursos para este ponente.');
        return;
      }
      if (!file) return;

      const tipo = getSpeakerResourceType(file.name);
      if (!tipo) {
        alert('Tipo no permitido. Use pdf, xlsx, csv, docx, pptx, jpg, jpeg o png.');
        return;
      }
      if (file.size > maxSpeakerResourceSize) {
        alert('El archivo no puede superar 10 MB.');
        return;
      }

      const reader = new FileReader();
      reader.onload = async function(e) {
        try {
          const response = await fetch(`/api/admin/conversatorios/speakers/${speaker.id}/resources`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ nombre: file.name, url: e.target.result, tipo, tamano: file.size })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.success) throw new Error(data.error || 'No se pudo subir el recurso.');
          await refreshSpeakerResources(index);
        } catch (error) {
          alert(error.message || 'No se pudo subir el recurso.');
        }
      };
      reader.readAsDataURL(file);
    }

    async function addSpeakerResourceLink(index) {
      const speaker = conversatorioSpeakers[index];
      const input = document.getElementById(`speaker-resource-link-${index}`);
      const link = input?.value?.trim();
      if (!speaker?.id) {
        alert('Guarda el conversatorio antes de agregar recursos para este ponente.');
        return;
      }
      if (!link || !/^https?:\/\//i.test(link)) {
        alert('Ingrese un link válido que inicie con http:// o https://.');
        return;
      }

      try {
        const response = await fetch(`/api/admin/conversatorios/speakers/${speaker.id}/resources`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ nombre: link, url: link, tipo: 'link' })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.error || 'No se pudo agregar el link.');
        input.value = '';
        await refreshSpeakerResources(index);
      } catch (error) {
        alert(error.message || 'No se pudo agregar el link.');
      }
    }

    async function deleteSpeakerResource(speakerId, resourceId) {
      if (!confirm('¿Eliminar este recurso?')) return;
      try {
        const response = await fetch(`/api/admin/conversatorios/speakers/${speakerId}/resources/${resourceId}/delete`, {
          method: 'POST',
          headers: { 'Accept': 'application/json' }
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.error || 'No se pudo eliminar el recurso.');
        const index = conversatorioSpeakers.findIndex(sp => Number(sp.id) === Number(speakerId));
        if (index >= 0) await refreshSpeakerResources(index);
      } catch (error) {
        alert(error.message || 'No se pudo eliminar el recurso.');
      }
    }

    function autoGenerateItineraryDays() {
      const startInput = document.getElementById('conversatorio-fechaInicio');
      const endInput = document.getElementById('conversatorio-fechaFin');
      if (!startInput || !endInput) return;
      
      const startVal = startInput.value;
      const endVal = endInput.value;
      if (!startVal || !endVal) return;
      
      const startDate = new Date(startVal + 'T00:00:00');
      const endDate = new Date(endVal + 'T00:00:00');
      if (isNaN(startDate.getTime()) || isNaN(endDate.getTime())) return;
      
      const diffTime = endDate.getTime() - startDate.getTime();
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
      
      if (diffDays <= 0) return;
      
      const originalDays = [...conversatorioDays];
      conversatorioDays = [];
      
      for (let i = 0; i < diffDays; i++) {
        const currentDayDate = new Date(startDate.getTime() + i * 24 * 60 * 60 * 1000);
        const yyyy = currentDayDate.getFullYear();
        const mm = String(currentDayDate.getMonth() + 1).padStart(2, '0');
        const dd = String(currentDayDate.getDate()).padStart(2, '0');
        const dateStr = `${yyyy}-${mm}-${dd}`;
        
        const existingDay = originalDays[i];
        conversatorioDays.push({
          nombre: existingDay ? existingDay.nombre : `Día ${i + 1}`,
          fecha: dateStr,
          horaInicio: existingDay ? existingDay.horaInicio : (document.getElementById('conversatorio-horaInicio')?.value || '09:00'),
          horaFin: existingDay ? existingDay.horaFin : (document.getElementById('conversatorio-horaFin')?.value || '18:00')
        });
      }
      
      renderConversatorioDays();
    }

    function serializeConversatorioItinerary() {
      const data = {
        days: conversatorioDays,
        speakers: conversatorioSpeakers
      };
      document.getElementById('conversatorio-itinerary-json').value = JSON.stringify(data);
    }

    function serializeConversatorioData() {
      serializeConversatorioItinerary();
      document.getElementById('conversatorio-convenios-json').value = JSON.stringify(conversatorioAgreements);
    }

    function toggleConversatorioConveniosMode() {
      const usePec = document.getElementById('conversatorio-usePecConvenios')?.checked;
      const panel = document.getElementById('conversatorio-scoped-convenios-panel');
      if (!panel) return;

      panel.classList.toggle('opacity-50', !!usePec);
      panel.classList.toggle('pointer-events-none', !!usePec);
    }

    function resetConversatorioAgreementForm() {
      document.getElementById('conv-agreement-edit-index').value = '';
      document.getElementById('conv-agreement-titulo').value = '';
      document.getElementById('conv-agreement-categoria').value = 'Patrocinador';
      document.getElementById('conv-agreement-descripcion').value = '';
      document.getElementById('conv-agreement-link').value = '';
      document.getElementById('conv-agreement-orden').value = '0';
      document.getElementById('conv-agreement-logo').value = '';
      const fileInput = document.getElementById('conv-agreement-logo-file');
      if (fileInput) fileInput.value = '';
      const preview = document.getElementById('conv-agreement-logo-preview');
      const placeholder = document.getElementById('conv-agreement-logo-placeholder');
      if (preview && placeholder) {
        preview.src = '';
        preview.classList.add('hidden');
        placeholder.classList.remove('hidden');
      }
    }

    function loadConversatorioAgreementLogo(fileInput) {
      const file = fileInput.files && fileInput.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const logo = e.target.result || '';
        document.getElementById('conv-agreement-logo').value = logo;
        document.getElementById('conv-agreement-logo-preview').src = logo;
        document.getElementById('conv-agreement-logo-preview').classList.remove('hidden');
        document.getElementById('conv-agreement-logo-placeholder').classList.add('hidden');
      };
      reader.readAsDataURL(file);
    }

    function saveConversatorioAgreement() {
      const titulo = document.getElementById('conv-agreement-titulo').value.trim();
      if (!titulo) {
        alert('Ingrese el título del convenio.');
        return;
      }

      const editIndexValue = document.getElementById('conv-agreement-edit-index').value;
      const agreement = {
        titulo,
        categoria: document.getElementById('conv-agreement-categoria').value,
        descripcion: document.getElementById('conv-agreement-descripcion').value.trim(),
        link: document.getElementById('conv-agreement-link').value.trim(),
        orden: parseInt(document.getElementById('conv-agreement-orden').value || '0', 10) || 0,
        logo: document.getElementById('conv-agreement-logo').value
      };

      if (editIndexValue !== '') {
        conversatorioAgreements[parseInt(editIndexValue, 10)] = agreement;
      } else {
        conversatorioAgreements.push(agreement);
      }

      conversatorioAgreements.sort((a, b) => (a.orden || 0) - (b.orden || 0));
      resetConversatorioAgreementForm();
      renderConversatorioAgreements();
    }

    function editConversatorioAgreement(index) {
      const agreement = conversatorioAgreements[index];
      if (!agreement) return;

      document.getElementById('conv-agreement-edit-index').value = String(index);
      document.getElementById('conv-agreement-titulo').value = agreement.titulo || '';
      document.getElementById('conv-agreement-categoria').value = agreement.categoria || 'Patrocinador';
      document.getElementById('conv-agreement-descripcion').value = agreement.descripcion || '';
      document.getElementById('conv-agreement-link').value = agreement.link || '';
      document.getElementById('conv-agreement-orden').value = agreement.orden || 0;
      document.getElementById('conv-agreement-logo').value = agreement.logo || '';

      const preview = document.getElementById('conv-agreement-logo-preview');
      const placeholder = document.getElementById('conv-agreement-logo-placeholder');
      if (agreement.logo) {
        preview.src = agreement.logo;
        preview.classList.remove('hidden');
        placeholder.classList.add('hidden');
      } else {
        preview.src = '';
        preview.classList.add('hidden');
        placeholder.classList.remove('hidden');
      }
    }

    function deleteConversatorioAgreement(index) {
      if (!confirm('¿Está seguro de eliminar este convenio del conversatorio?')) return;
      conversatorioAgreements.splice(index, 1);
      renderConversatorioAgreements();
      resetConversatorioAgreementForm();
    }

    function renderConversatorioAgreements() {
      const container = document.getElementById('conversatorio-agreements-list');
      if (!container) return;

      if (conversatorioAgreements.length === 0) {
        container.innerHTML = `
          <div class="px-6 py-8 text-center text-slate-400 font-bold text-xs">
            No hay convenios específicos para este conversatorio.
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-400 font-bold uppercase border-b border-slate-100">
            <tr>
              <th class="px-6 py-4">Convenio</th>
              <th class="px-6 py-4">Categoría</th>
              <th class="px-6 py-4 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            ${conversatorioAgreements.map((agreement, index) => `
              <tr>
                <td class="px-6 py-4 text-slate-900 font-bold">
                  <div class="flex items-center gap-3">
                    ${agreement.logo ? `<img src="${escapeAdminHtml(agreement.logo)}" class="w-9 h-9 rounded-lg object-contain border border-slate-100 bg-white">` : ''}
                    <span>${escapeAdminHtml(agreement.titulo)}</span>
                  </div>
                </td>
                <td class="px-6 py-4 text-slate-600">${escapeAdminHtml(agreement.categoria)}</td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-2.5">
                    <button type="button" onclick="editConversatorioAgreement(${index})" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100/50 transition text-[10px]">Editar</button>
                    <button type="button" onclick="deleteConversatorioAgreement(${index})" class="text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 font-bold px-2.5 py-1.5 rounded-lg border border-rose-100 transition text-[10px]">Eliminar</button>
                  </div>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    }

    function setElVal(id, val) {
      const el = document.getElementById(id);
      if (el) el.value = (val !== undefined && val !== null) ? val : '';
    }
    function setElChk(id, val) {
      const el = document.getElementById(id);
      if (el) el.checked = !!val;
    }

    function editConversatorio(ev) {
      const listContainer = document.getElementById('conversatorios-list-container');
      const formContainer = document.getElementById('conversatorios-form-container');
      const floatingBar = document.getElementById('conversatorio-floating-bar');
      if (listContainer) listContainer.classList.add('hidden');
      if (formContainer) formContainer.classList.remove('hidden');
      if (floatingBar) floatingBar.classList.remove('hidden');
      
      const titleEl = document.getElementById('conversatorio-form-title');
      if (titleEl) titleEl.innerText = 'Editar Conversatorio';
      setElVal('conversatorio-form-id', ev.id);
      
      setElVal('conversatorio-estado', ev.estado || 'ACTIVO');
      setElVal('conversatorio-slogan', ev.slogan || '');
      setElVal('conversatorio-titulo', ev.titulo || '');
      setElVal('conversatorio-area', ev.areaProfesional || '');
      setElVal('conversatorio-descripcion', ev.descripcion || '');
      
      setElVal('conversatorio-fechaInicio', ev.fechaInicio ? ev.fechaInicio.split('T')[0] : '');
      setElVal('conversatorio-fechaFin', ev.fechaFin ? ev.fechaFin.split('T')[0] : '');
      setElVal('conversatorio-horaInicio', ev.horaInicio || '');
      setElVal('conversatorio-horaFin', ev.horaFin || '');
      
      setElVal('conversatorio-precio', ev.precio || '0.00');
      setElVal('conversatorio-descuentoEstudianteUsd', ev.descuentoEstudianteUsd !== undefined && ev.descuentoEstudianteUsd !== null ? ev.descuentoEstudianteUsd : '0.00');
      setElChk('conversatorio-gratuito', ev.gratuito);
      setElChk('conversatorio-permitirCertificadoGratuito', ev.permitirCertificadoGratuito || false);
      setElChk('conversatorio-certificadoInmediato', ev.certificadoInmediato !== false);
      setElVal('conversatorio-porcentajeMinimoCertificado', ev.porcentajeMinimoCertificado || 100);
      toggleConversatorioCertMinPct();
      toggleConversatorioFree();
      setElChk('conversatorio-usarTiempoMinimoPonencia', ev.usarTiempoMinimoPonencia !== false);
      setElVal('conversatorio-tiempoMinimoPonenciaMinutos', (ev.tiempoMinimoPonenciaMinutos !== null && ev.tiempoMinimoPonenciaMinutos !== undefined) ? ev.tiempoMinimoPonenciaMinutos : '');
      toggleConversatorioTiempoMinimo();
      setElVal('conversatorio-capacidad', ev.capacidad || '');
      setElChk('conversatorio-capacidadIlimitada', ev.capacidadIlimitada);
      setElChk('conversatorio-usePecConvenios', ev.usePecConvenios !== false);

      setElVal('conversatorio-provincia', ev.provincia || '');
      setElVal('conversatorio-ciudad', ev.ciudad || '');
      setElVal('conversatorio-direccion', ev.direccion || '');

      setElChk('conversatorio-destacado', ev.destacado);
      setElVal('conversatorio-banner', ev.banner || '');
      setElVal('conversatorio-youtube', ev.youtube || '');
      setElVal('conversatorio-galeria', ev.galeria || '');

      setElVal('conversatorio-revistaPdf', ev.revistaPdf || '');
      setElVal('conversatorio-revistaFlipbook', ev.revistaFlipbook || '');
      setElVal('conversatorio-revistaPortada', ev.revistaPortada || '');

      // Banner Preview update
      const bannerPreview = document.getElementById('conversatorio-banner-preview');
      const bannerPlaceholder = document.getElementById('conversatorio-banner-placeholder');
      if (bannerPreview && bannerPlaceholder) {
        if (ev.banner) {
          bannerPreview.src = ev.banner;
          bannerPreview.classList.remove('hidden');
          bannerPlaceholder.classList.add('hidden');
        } else {
          bannerPreview.src = '';
          bannerPreview.classList.add('hidden');
          bannerPlaceholder.classList.remove('hidden');
        }
      }

      // Magazine Cover Preview update
      const portadaPreview = document.getElementById('conversatorio-portada-preview');
      const portadaPlaceholder = document.getElementById('conversatorio-portada-placeholder');
      if (portadaPreview && portadaPlaceholder) {
        if (ev.revistaPortada) {
          portadaPreview.src = ev.revistaPortada;
          portadaPreview.classList.remove('hidden');
          portadaPlaceholder.classList.add('hidden');
        } else {
          portadaPreview.src = '';
          portadaPreview.classList.add('hidden');
          portadaPlaceholder.classList.remove('hidden');
        }
      }

      // Parse nested objects sorted strictly by orden
      conversatorioDays = [...(ev.itinerary || [])].sort((a, b) => {
        const ordA = typeof a.orden === 'number' ? a.orden : 0;
        const ordB = typeof b.orden === 'number' ? b.orden : 0;
        if (ordA !== ordB) return ordA - ordB;
        return (a.id || 0) - (b.id || 0);
      });
      
      // Parse speakers with redes safety
      conversatorioSpeakers = (ev.speakers || []).map(sp => {
        let parsedRedes = { facebook: '', twitter: '', instagram: '', linkedin: '' };
        if (sp.redes) {
          try {
            parsedRedes = JSON.parse(sp.redes);
          } catch(e) {
            try {
              parsedRedes = typeof sp.redes === 'object' ? sp.redes : JSON.parse(JSON.stringify(sp.redes));
            } catch(err){}
          }
        }
        parsedRedes = {
          facebook: parsedRedes.facebook || '',
          twitter: parsedRedes.twitter || '',
          instagram: parsedRedes.instagram || '',
          linkedin: parsedRedes.linkedin || ''
        };
        return {
          ...sp,
          dayIndex: sp.dayIndex !== null && sp.dayIndex !== undefined ? parseInt(sp.dayIndex) : 0,
          videoUrl: sp.bunnyVideoId ? ('bunny:' + (window.BUNNY_STREAM_LIBRARY_ID || '') + ':' + sp.bunnyVideoId) : (sp.videoUrl || ''),
          gratuita: !!sp.gratuita,
          redes: parsedRedes
        };
      });

      conversatorioAgreements = (ev.agreements || []).map(agreement => ({
        titulo: agreement.titulo || '',
        categoria: agreement.categoria || 'Patrocinador',
        descripcion: agreement.descripcion || '',
        link: agreement.link || '',
        orden: agreement.orden || 0,
        logo: agreement.logo || ''
      })).sort((a, b) => (a.orden || 0) - (b.orden || 0));

      renderConversatorioDays();
      renderConversatorioAgreements();
      resetConversatorioAgreementForm();
      toggleConversatorioConveniosMode();
      toggleConversatorioFree();
      toggleConversatorioUnlimited();

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Event Statistics Modal Logic
    let currentStatsTab = 'enrollments';
    window.eventStatsQaItems = [];

    function escapeStatsHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function switchStatsTab(tab) {
      currentStatsTab = tab;
      document.querySelectorAll('.stats-pane').forEach(p => p.classList.add('hidden'));
      document.getElementById('stats-pane-' + tab).classList.remove('hidden');

      const btns = ['enrollments', 'access', 'tasks', 'qa', 'orders'];
      btns.forEach(b => {
        const btn = document.getElementById('tab-btn-' + b);
        if (btn) {
          const shouldHide = (b === 'tasks' && window.activeEventStatsType !== 'curso') || (b === 'qa' && window.activeEventStatsType !== 'conversatorio');
          const hiddenClass = shouldHide ? ' hidden' : '';
          if (b === tab) {
            btn.className = "px-4 py-2 font-bold text-xs rounded-t-xl transition border-b-2 border-[#0A3C84] text-[#0A3C84] cursor-pointer" + hiddenClass;
          } else {
            btn.className = "px-4 py-2 font-bold text-xs rounded-t-xl transition border-b-2 border-transparent text-slate-400 hover:text-slate-650 cursor-pointer" + hiddenClass;
          }
        }
      });
    }

    function openEventStatsModalById(type, id) {
      let ev = null;
      if (type === 'conversatorio') {
        ev = window.conversatoriosList.find(c => c.id === id);
      } else if (type === 'curso') {
        ev = window.cursosList.find(c => c.id === id);
      }
      if (ev) {
        openEventStatsModal(type, ev.id, ev.titulo);
      }
    }

    function openEventStatsModal(type, id, title) {
      window.activeEventStatsId = id;
      window.activeEventStatsType = type;

      document.getElementById('stats-event-type').innerText = type === 'curso' ? 'Curso Académico' : 'Conversatorio';
      document.getElementById('stats-event-type').className = type === 'curso' 
        ? "bg-purple-100 text-purple-700 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider"
        : "bg-blue-100 text-blue-700 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider";
      
      document.getElementById('stats-event-title').innerText = title;
      
      document.getElementById('stats-kpi-enrolled').innerText = '...';
      document.getElementById('stats-kpi-revenue-approved').innerText = '...';
      document.getElementById('stats-kpi-revenue-pending').innerText = '...';
      document.getElementById('stats-kpi-views').innerText = '...';
      
      const enrollmentsBody = document.getElementById('stats-table-enrollments-body');
      enrollmentsBody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-slate-450 font-bold"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Cargando datos...</td></tr>`;
      
      const accessList = document.getElementById('stats-list-access');
      accessList.innerHTML = `<div class="text-center py-6 text-slate-450 font-bold"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Cargando analíticas...</div>`;
      
      const ordersBody = document.getElementById('stats-table-orders-body');
      ordersBody.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-slate-450 font-bold"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Cargando pedidos...</td></tr>`;
      window.eventStatsQaItems = [];
      renderStatsQa();
      resetStatsQaForm();

      const tasksBtn = document.getElementById('tab-btn-tasks');
      const qaBtn = document.getElementById('tab-btn-qa');
      if (type === 'curso') {
        tasksBtn.classList.remove('hidden');
        qaBtn.classList.add('hidden');
      } else {
        tasksBtn.classList.add('hidden');
        qaBtn.classList.remove('hidden');
      }

      switchStatsTab('enrollments');
      document.getElementById('event-stats-modal').classList.remove('hidden');

      fetch(`/api/admin/stats/event/${type}/${id}`)
        .then(res => res.json())
        .then(data => {
          if (!data.success) {
            alert("Error al cargar estadísticas: " + (data.error || 'error desconocido'));
            closeEventStatsModal();
            return;
          }

          document.getElementById('stats-kpi-enrolled').innerText = data.enrolledCount;
          document.getElementById('stats-kpi-revenue-approved').innerText = '$' + data.approvedRevenue.toFixed(2);
          document.getElementById('stats-kpi-revenue-pending').innerText = '$' + data.pendingRevenue.toFixed(2);
          document.getElementById('stats-kpi-views').innerText = data.totalViews;
          window.eventStatsQaItems = Array.isArray(data.qas) ? data.qas : [];
          window.eventStatsSpeakers = Array.isArray(data.speakers) ? data.speakers : [];
          updateStatsQaSpeakerOptions();
          renderStatsQa();

          window.statsEnrollmentsData = data.enrollments || [];

          if (data.enrollments && data.enrollments.length > 0) {
            enrollmentsBody.innerHTML = '';
            data.enrollments.forEach((en, idx) => {
              let statusClass = "bg-slate-100 text-slate-450";
              let statusText = "No Solicitado";
              
              if (en.certStatus === 'APROBADO') {
                statusClass = "bg-emerald-50 text-emerald-600 border border-emerald-100";
                statusText = "Certificado Emitido";
              } else if (en.certStatus === 'PENDIENTE') {
                statusClass = "bg-amber-50 text-amber-600 border border-amber-100";
                statusText = "Pago en Validación";
              } else if (en.certStatus === 'RECHAZADO') {
                statusClass = "bg-rose-50 text-rose-600 border border-rose-100";
                statusText = "Pago Rechazado";
              }

              enrollmentsBody.innerHTML += `
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-2.5">
                      <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-650 flex items-center justify-center font-bold text-xs uppercase">
                        ${en.name.substring(0, 2)}
                      </div>
                      <div class="flex flex-col">
                        <span class="font-extrabold text-slate-900">${en.name}</span>
                        <span class="text-[9px] text-slate-400 font-bold">ID: ${en.userId}</span>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex flex-col">
                      <span class="text-slate-700">${en.email}</span>
                      <span class="text-[9px] text-slate-400 font-bold">Cel: ${en.celular}</span>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-slate-450 font-bold">
                    ${new Date(en.createdAt).toLocaleDateString()}
                  </td>
                  <td class="px-4 py-3 text-center">
                    <div class="inline-flex items-center gap-1.5">
                      <span class="px-2.5 py-0.5 rounded-full text-[8px] font-black uppercase ${statusClass}">
                        ${statusText}
                      </span>
                      ${en.certStatus === 'APROBADO' && en.certId ? `
                        <button onclick="openEditCertNameModal(${idx})" title="Editar nombre del beneficiario"
                                class="w-6 h-6 rounded-md bg-slate-100 hover:bg-blue-50 text-slate-500 hover:text-blue-600 transition inline-flex items-center justify-center shrink-0">
                          <i class="fa-solid fa-pen text-[9px]"></i>
                        </button>
                      ` : ''}
                    </div>
                  </td>
                  <td class="px-4 py-3 text-right font-black text-slate-800">
                    $${en.certPrice.toFixed(2)}
                  </td>
                </tr>
              `;
            });
          } else {
            enrollmentsBody.innerHTML = `<tr><td colspan="5" class="px-4 py-12 text-center text-slate-400 font-bold"><i class="fa-solid fa-users-slash text-xl mb-1 text-slate-350 block"></i> No hay alumnos registrados aún.</td></tr>`;
          }

          if (data.items && data.items.length > 0) {
            accessList.innerHTML = '';
            const maxViews = Math.max(...data.items.map(i => i.totalViews), 1);
            
            data.items.forEach(it => {
              const viewsPct = Math.min((it.totalViews / maxViews) * 100, 100);
              const uniquePct = Math.min((it.uniqueViewers / maxViews) * 100, 100);

              accessList.innerHTML += `
                <div class="flex flex-col gap-2 p-3 bg-slate-50 border border-slate-100 rounded-xl hover:bg-slate-100/30 transition">
                  <div class="flex justify-between items-center">
                    <span class="font-extrabold text-slate-800 text-xs">${it.title}</span>
                    <div class="flex gap-4">
                      <span class="text-[10px] text-slate-500 font-bold">Total Vistas: <strong class="text-slate-900">${it.totalViews}</strong></span>
                      <span class="text-[10px] text-slate-500 font-bold">Espectadores Únicos: <strong class="text-slate-900">${it.uniqueViewers}</strong></span>
                    </div>
                  </div>
                  
                  <div class="flex flex-col gap-1.5 mt-1">
                    <div class="flex items-center gap-2">
                      <span class="text-[8px] text-slate-400 font-bold uppercase tracking-wider w-16 text-right font-sans">Totales</span>
                      <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                        <div class="bg-purple-500 h-full rounded-full transition-all duration-500" style="width: ${viewsPct}%"></div>
                      </div>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-[8px] text-slate-400 font-bold uppercase tracking-wider w-16 text-right font-sans">Únicos</span>
                      <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                        <div class="bg-indigo-500 h-full rounded-full transition-all duration-500" style="width: ${uniquePct}%"></div>
                      </div>
                    </div>
                  </div>
                </div>
              `;
            });
          } else {
            accessList.innerHTML = `<div class="text-center py-12 text-slate-400 font-bold"><i class="fa-solid fa-video-slash text-xl mb-1 text-slate-350 block"></i> No hay registros de visualizaciones aún.</div>`;
          }

          if (type === 'curso' && data.tasksSummary) {
            document.getElementById('stats-tasks-total').innerText = data.tasksSummary.totalTasks;
            document.getElementById('stats-tasks-submissions').innerText = data.tasksSummary.totalSubmissions;
            document.getElementById('stats-tasks-pending').innerText = data.tasksSummary.pendingGrades;
            document.getElementById('stats-tasks-approved').innerText = data.tasksSummary.approvedSubmissions;
            document.getElementById('stats-tasks-rejected').innerText = data.tasksSummary.rejectedSubmissions;
          }

          const ordersBody = document.getElementById('stats-table-orders-body');
          ordersBody.innerHTML = '';
          if (data.orders && data.orders.length > 0) {
            data.orders.forEach(ord => {
              let statusClass = "bg-slate-100 text-slate-450";
              let statusText = "Desconocido";
              if (ord.estado === 'APROBADO') {
                statusClass = "bg-emerald-50 text-emerald-600 border border-emerald-100";
                statusText = "Aprobado";
              } else if (ord.estado === 'PENDIENTE') {
                statusClass = "bg-amber-50 text-amber-600 border border-amber-100";
                statusText = "Pendiente";
              } else if (ord.estado === 'RECHAZADO') {
                statusClass = "bg-rose-50 text-rose-600 border border-rose-100";
                statusText = "Rechazado";
              }

              let actionButton = '';
              const escOrd = JSON.stringify(ord).replace(/"/g, '&quot;');
              if (ord.estado === 'PENDIENTE') {
                actionButton = `
                  <button onclick="openReviewPaymentModal(${escOrd})" class="bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-extrabold px-3 py-1.5 rounded-lg shadow-sm transition cursor-pointer">
                    Revisar
                  </button>
                `;
              } else {
                actionButton = `
                  <button onclick="openReviewPaymentModal(${escOrd})" class="bg-slate-100 hover:bg-slate-200 text-slate-650 text-[10px] font-bold px-3 py-1.5 rounded-lg transition cursor-pointer">
                    Ver
                  </button>
                `;
              }

              ordersBody.innerHTML += `
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="px-4 py-3">
                    <div class="flex flex-col">
                      <span class="font-extrabold text-slate-900">${ord.alumnoName}</span>
                      <span class="text-[9px] text-slate-450 font-bold">${ord.alumnoEmail}</span>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-slate-600 font-bold capitalize">
                    ${ord.bancoDestino}
                  </td>
                  <td class="px-4 py-3 font-black text-slate-800">
                    $${ord.monto.toFixed(2)}
                  </td>
                  <td class="px-4 py-3 text-slate-450 font-bold font-mono">
                    ${ord.referencia}
                  </td>
                  <td class="px-4 py-3 text-center">
                    <span class="px-2.5 py-0.5 rounded-full text-[8px] font-black uppercase ${statusClass}">
                      ${statusText}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    ${actionButton}
                  </td>
                </tr>
              `;
            });
          } else {
            ordersBody.innerHTML = `<tr><td colspan="6" class="px-4 py-12 text-center text-slate-400 font-bold"><i class="fa-solid fa-receipt text-xl mb-1 text-slate-350 block"></i> No hay pedidos de certificados registrados.</td></tr>`;
          }
        })
        .catch(err => {
          console.error(err);
          alert("Error de red al cargar estadísticas.");
          closeEventStatsModal();
        });
    }

    window.eventStatsSpeakersList = [];

    function toggleStatsQaCombobox() {
      const menu = document.getElementById('stats-qa-combobox-menu');
      const arrow = document.getElementById('stats-qa-combobox-arrow');
      const search = document.getElementById('stats-qa-combobox-search');

      if (!menu) return;
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        if (arrow) arrow.classList.add('rotate-180');
        renderStatsQaComboboxItems();
        if (search) {
          search.value = '';
          search.focus();
        }
      } else {
        menu.classList.add('hidden');
        if (arrow) arrow.classList.remove('rotate-180');
      }
    }

    function filterStatsQaComboboxOptions() {
      renderStatsQaComboboxItems();
    }

    function renderStatsQaComboboxItems() {
      const container = document.getElementById('stats-qa-combobox-options');
      if (!container) return;

      const searchInput = document.getElementById('stats-qa-combobox-search');
      const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
      const currentVal = document.getElementById('stats-qa-speaker-filter') ? document.getElementById('stats-qa-speaker-filter').value : 'ALL';

      const options = Array.isArray(window.eventStatsSpeakersList) ? window.eventStatsSpeakersList : [];
      const filtered = options.filter(opt => (opt.label || '').toLowerCase().includes(query));

      if (filtered.length === 0) {
        container.innerHTML = `<div class="p-3 text-center text-slate-400 text-xs font-semibold">No se encontraron ponentes con "${escapeStatsHtml(query)}"</div>`;
        return;
      }

      container.innerHTML = filtered.map(opt => {
        const isSelected = String(opt.id) === String(currentVal);
        const escLabel = escapeStatsHtml(opt.label).replace(/'/g, "\\'");
        return `
          <button type="button" onclick="selectStatsQaComboboxOption('${opt.id}', '${escLabel}')" class="w-full text-left p-2.5 rounded-xl transition flex items-center justify-between gap-2 text-xs font-bold ${isSelected ? 'bg-blue-50 text-[#0A3C84]' : 'hover:bg-slate-50 text-slate-700'}">
            <span class="truncate">${escapeStatsHtml(opt.label)}</span>
            ${isSelected ? '<i class="fa-solid fa-circle-check text-[#0A3C84] text-xs shrink-0"></i>' : ''}
          </button>
        `;
      }).join('');
    }

    function selectStatsQaComboboxOption(val, label) {
      const input = document.getElementById('stats-qa-speaker-filter');
      const labelSpan = document.getElementById('stats-qa-combobox-label');
      const menu = document.getElementById('stats-qa-combobox-menu');
      const arrow = document.getElementById('stats-qa-combobox-arrow');

      if (input) input.value = val;
      if (labelSpan) labelSpan.innerText = label;
      if (menu) menu.classList.add('hidden');
      if (arrow) arrow.classList.remove('rotate-180');

      renderStatsQa();
    }

    function updateStatsQaSpeakerOptions() {
      const formSelect = document.getElementById('stats-qa-speaker-id');

      const speakerMap = new Map();
      if (Array.isArray(window.eventStatsSpeakers)) {
        window.eventStatsSpeakers.forEach(sp => {
          if (sp && sp.id) speakerMap.set(Number(sp.id), sp);
        });
      }
      if (Array.isArray(window.eventStatsQaItems)) {
        window.eventStatsQaItems.forEach(qa => {
          if (qa && qa.speaker && qa.speaker.id && !speakerMap.has(Number(qa.speaker.id))) {
            speakerMap.set(Number(qa.speaker.id), qa.speaker);
          }
        });
      }
      const speakers = Array.from(speakerMap.values());

      window.eventStatsSpeakersList = [
        { id: 'ALL', label: '-- Ver Todas las Ponencias --' },
        { id: 'GENERAL', label: 'Ponencia General (Sin ponente específico)' },
        ...speakers.map(sp => ({
          id: String(sp.id),
          label: `${sp.nombre || 'Ponente'}${sp.tema ? ' — ' + sp.tema : ''}`
        }))
      ];

      const currentVal = document.getElementById('stats-qa-speaker-filter') ? document.getElementById('stats-qa-speaker-filter').value : 'ALL';
      const activeOpt = window.eventStatsSpeakersList.find(o => String(o.id) === String(currentVal)) || window.eventStatsSpeakersList[0];
      const labelSpan = document.getElementById('stats-qa-combobox-label');
      if (labelSpan && activeOpt) {
        labelSpan.innerText = activeOpt.label;
      }

      if (formSelect) {
        const currentFormVal = formSelect.value || '';
        formSelect.innerHTML = `
          <option value="">-- Ponencia General --</option>
          ${speakers.map(sp => `<option value="${sp.id}">${escapeStatsHtml(sp.nombre)}${sp.tema ? ' — ' + escapeStatsHtml(sp.tema) : ''}</option>`).join('')}
        `;
        formSelect.value = currentFormVal;
      }

      renderStatsQaComboboxItems();
    }

    document.addEventListener('click', function(e) {
      const wrapper = document.getElementById('stats-qa-combobox-wrapper');
      const menu = document.getElementById('stats-qa-combobox-menu');
      const arrow = document.getElementById('stats-qa-combobox-arrow');
      if (wrapper && menu && !wrapper.contains(e.target)) {
        menu.classList.add('hidden');
        if (arrow) arrow.classList.remove('rotate-180');
      }
    });

    function renderStatsQa() {
      const list = document.getElementById('stats-qa-list');
      if (!list) return;

      if (window.activeEventStatsType !== 'conversatorio') {
        list.innerHTML = `<div class="text-center py-10 text-slate-400 font-bold bg-slate-50 border border-slate-100 rounded-2xl">Q&amp;A solo está disponible para conversatorios.</div>`;
        return;
      }

      const allQas = Array.isArray(window.eventStatsQaItems) ? window.eventStatsQaItems : [];
      const filterVal = document.getElementById('stats-qa-speaker-filter') ? document.getElementById('stats-qa-speaker-filter').value : 'ALL';

      let qas = allQas;
      if (filterVal === 'GENERAL') {
        qas = allQas.filter(qa => !qa.speakerId && (!qa.speaker || !qa.speaker.id));
      } else if (filterVal !== 'ALL') {
        const selectedSpeakerId = Number(filterVal);
        qas = allQas.filter(qa => Number(qa.speakerId) === selectedSpeakerId || (qa.speaker && Number(qa.speaker.id) === selectedSpeakerId));
      }

      if (qas.length === 0) {
        list.innerHTML = `
          <div class="text-center py-10 text-slate-400 font-bold bg-slate-50 border border-slate-100 rounded-2xl">
            <i class="fa-solid fa-circle-question text-xl mb-1 text-slate-350 block"></i>
            ${filterVal !== 'ALL' ? 'No hay preguntas registradas para la ponencia seleccionada.' : 'Aún no hay preguntas y respuestas para este conversatorio.'}
          </div>
        `;
        return;
      }

      list.innerHTML = qas.map(qa => {
        const estado = qa.estado || (qa.activo ? 'APROBADO' : 'PENDIENTE');
        let statusClass = 'bg-amber-50 text-amber-700 border border-amber-200';
        if (estado === 'APROBADO') statusClass = 'bg-emerald-50 text-emerald-700 border border-emerald-200';
        if (estado === 'DUPLICADO') statusClass = 'bg-slate-100 text-slate-600 border border-slate-200';
        if (estado === 'RECHAZADO') statusClass = 'bg-rose-50 text-rose-700 border border-rose-200';

        let speakerInfo = 'Ponencia General';
        if (qa.speaker) {
          speakerInfo = `${qa.speaker.nombre || 'Ponente'}${qa.speaker.tema ? ' — ' + qa.speaker.tema : ''}`;
        }
        
        let userInfo = '';
        if (qa.user) {
          userInfo = `${qa.user.name || 'Alumno'}${qa.user.email ? ' (' + qa.user.email + ')' : ''}`;
        }

        return `
          <div class="bg-white border border-slate-200/80 rounded-2xl p-5 flex flex-col gap-3 shadow-sm">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div class="flex flex-col gap-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase ${statusClass}">${estado}</span>
                  <span class="text-[9px] font-black uppercase tracking-wider text-[#0252A4] bg-blue-50 border border-blue-100 px-2.5 py-0.5 rounded-full">
                    <i class="fa-solid fa-microphone text-[8px] mr-1"></i> Ponencia: ${escapeStatsHtml(speakerInfo)}
                  </span>
                  ${userInfo ? `<span class="text-[9px] font-bold text-slate-500 bg-slate-50 border border-slate-100 px-2 py-0.5 rounded-full"><i class="fa-solid fa-user text-[8px] mr-1 text-slate-400"></i> ${escapeStatsHtml(userInfo)}</span>` : ''}
                  ${qa.destacado ? '<span class="text-[9px] font-black uppercase text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200"><i class="fa-solid fa-star text-amber-400 mr-1"></i> Destacado</span>' : ''}
                </div>
                <h5 class="font-black text-slate-900 text-sm leading-snug mt-1.5">${escapeStatsHtml(qa.pregunta)}</h5>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <button type="button" onclick="editStatsQa(${Number(qa.id)})" class="bg-blue-50 hover:bg-blue-100 text-[#0A3C84] font-extrabold text-[10px] px-3 py-2 rounded-xl transition cursor-pointer">
                  <i class="fa-solid fa-pen mr-1"></i> Responder / Editar
                </button>
                <button type="button" onclick="quickModerateQa(${Number(qa.id)}, 'DUPLICADO')" class="bg-slate-100 hover:bg-slate-200 text-slate-600 font-extrabold text-[10px] px-3 py-2 rounded-xl transition cursor-pointer" title="Marcar como pregunta repetida">
                  Duplicado
                </button>
                <button type="button" onclick="deleteStatsQa(${Number(qa.id)})" class="bg-rose-50 hover:bg-rose-100 text-rose-600 font-extrabold text-[10px] px-3 py-2 rounded-xl transition cursor-pointer">
                  Eliminar
                </button>
              </div>
            </div>
            ${qa.respuesta ? `
              <div class="bg-emerald-50/70 border border-emerald-100 rounded-xl p-3.5 text-xs text-slate-700 font-medium">
                <span class="text-[9px] font-black uppercase tracking-wider text-emerald-700 block mb-1">Respuesta Oficial del Administrador / Ponente:</span>
                ${escapeStatsHtml(qa.respuesta)}
              </div>
            ` : `
              <div class="text-[11px] text-amber-600 font-bold bg-amber-50 border border-amber-100 rounded-xl p-2.5 flex items-center gap-2">
                <i class="fa-regular fa-clock"></i> Pendiente de respuesta por la administración
              </div>
            `}
          </div>
        `;
      }).join('');
    }

    function resetStatsQaForm() {
      const qaId = document.getElementById('stats-qa-id');
      const question = document.getElementById('stats-qa-question');
      const answer = document.getElementById('stats-qa-answer');
      const order = document.getElementById('stats-qa-order');
      const active = document.getElementById('stats-qa-active');
      const speakerIdInput = document.getElementById('stats-qa-speaker-id');
      const submitBtn = document.getElementById('stats-qa-submit-btn');

      if (qaId) qaId.value = '';
      if (question) question.value = '';
      if (answer) answer.value = '';
      if (order) order.value = '0';
      if (speakerIdInput) speakerIdInput.value = '';
      if (active) active.checked = true;
      if (submitBtn) submitBtn.innerText = 'Guardar Q&A';
    }

    function editStatsQa(id) {
      const qa = (window.eventStatsQaItems || []).find(item => Number(item.id) === Number(id));
      if (!qa) return;

      document.getElementById('stats-qa-id').value = qa.id;
      document.getElementById('stats-qa-question').value = qa.pregunta || '';
      document.getElementById('stats-qa-answer').value = qa.respuesta || '';
      document.getElementById('stats-qa-order').value = Number(qa.orden || 0);
      document.getElementById('stats-qa-active').checked = !!qa.activo;
      const speakerIdInput = document.getElementById('stats-qa-speaker-id');
      if (speakerIdInput) speakerIdInput.value = qa.speakerId || (qa.speaker ? qa.speaker.id : '');
      document.getElementById('stats-qa-submit-btn').innerText = 'Actualizar Q&A';
      switchStatsTab('qa');
    }

    async function submitStatsQa(event) {
      event.preventDefault();

      if (window.activeEventStatsType !== 'conversatorio' || !window.activeEventStatsId) {
        alert('Selecciona un conversatorio válido para gestionar Q&A.');
        return;
      }

      const submitBtn = document.getElementById('stats-qa-submit-btn');
      const originalText = submitBtn.innerText;
      submitBtn.disabled = true;
      submitBtn.innerText = 'Guardando...';

      try {
        const response = await fetch(`/api/admin/conversatorios/${window.activeEventStatsId}/qa`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: document.getElementById('stats-qa-id').value || null,
            speakerId: document.getElementById('stats-qa-speaker-id') ? document.getElementById('stats-qa-speaker-id').value : null,
            pregunta: document.getElementById('stats-qa-question').value,
            respuesta: document.getElementById('stats-qa-answer').value,
            orden: document.getElementById('stats-qa-order').value,
            activo: document.getElementById('stats-qa-active').checked
          })
        });
        const data = await response.json();
        if (!data.success) {
          alert(data.error || 'No se pudo guardar el Q&A.');
          return;
        }

        window.eventStatsQaItems = Array.isArray(data.qas) ? data.qas : [];
        renderStatsQa();
        resetStatsQaForm();
      } catch (error) {
        console.error(error);
        alert('Error de red al guardar Q&A.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = document.getElementById('stats-qa-id').value ? originalText : 'Guardar Q&A';
      }
    }

    async function deleteStatsQa(id) {
      if (window.activeEventStatsType !== 'conversatorio' || !window.activeEventStatsId) {
        alert('Selecciona un conversatorio válido para gestionar Q&A.');
        return;
      }

      if (!confirm('¿Eliminar esta pregunta y respuesta?')) {
        return;
      }

      try {
        const response = await fetch(`/api/admin/conversatorios/${window.activeEventStatsId}/qa/${id}`, {
          method: 'DELETE'
        });
        const data = await response.json();
        if (!data.success) {
          alert(data.error || 'No se pudo eliminar el Q&A.');
          return;
        }

        window.eventStatsQaItems = Array.isArray(data.qas) ? data.qas : [];
        renderStatsQa();
        resetStatsQaForm();
      } catch (error) {
        console.error(error);
        alert('Error de red al eliminar Q&A.');
      }
    }

    async function quickModerateQa(id, estado) {
      if (window.activeEventStatsType !== 'conversatorio' || !window.activeEventStatsId) return;
      try {
        const res = await fetch(`/api/admin/conversatorios/questions/${id}/moderate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ estado })
        });
        const data = await res.json();
        if (data.success) {
          if (typeof fetchEventStats === 'function') {
            fetchEventStats(window.activeEventStatsId, 'conversatorio');
          }
        } else {
          alert(data.error || 'Error al moderar la pregunta.');
        }
      } catch (err) {
        console.error(err);
        alert('Error de red al moderar la pregunta.');
      }
    }

    function closeEventStatsModal() {
      document.getElementById('event-stats-modal').classList.add('hidden');
    }

    // Curso Dynamic Scheduler State & Logic
    let cursoDiscounts = [];
    let cursoModules = [];
    let cursoSpeakers = [];

    function openCursoForm() {
      document.getElementById('curso-list-container').classList.add('hidden');
      document.getElementById('curso-header-container').classList.add('hidden');
      document.getElementById('curso-form-container').classList.remove('hidden');
      document.getElementById('curso-floating-bar').classList.remove('hidden');
      document.getElementById('curso-form-title').innerText = 'Nuevo Curso Académico';
      document.getElementById('curso-id').value = '';
      document.getElementById('curso-form').reset();
      
      // Reset images & previews
      const mediaUrlInput = document.getElementById('curso-mediaUrl');
      if (mediaUrlInput) mediaUrlInput.value = '';
      const mediaTypeSelect = document.getElementById('curso-mediaType');
      if (mediaTypeSelect) mediaTypeSelect.value = 'imagen';
      
      const imageUrlInput = document.getElementById('curso-media-image-url');
      if (imageUrlInput) imageUrlInput.value = '';
      const videoUrlInput = document.getElementById('curso-media-video-url');
      if (videoUrlInput) videoUrlInput.value = '';
      
      toggleCursoMediaType();
      updateCursoMediaPreview('', 'imagen');

      cursoDiscounts = [];
      cursoModules = [];
      cursoSpeakers = [];
      renderCursoDiscounts();
      renderCursoStructure();
      renderCursoSpeakers();
      toggleCursoFree();
      if (typeof populateAdminCourseCategories === 'function') {
        populateAdminCourseCategories('', null);
      }
