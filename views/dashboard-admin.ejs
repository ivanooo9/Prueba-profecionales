          <h3 class="font-extrabold text-sm text-slate-900" id="preview-design-title">Diseño de Perfil</h3>
          <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider">Vista previa de la plantilla de perfil</p>
        </div>
        <button onclick="closePreviewDesignModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 transition cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="p-6 overflow-y-auto flex flex-col gap-4 items-center max-h-[70vh]">
        <div id="preview-design-img-container" class="w-full flex flex-col gap-4">
          <!-- Images will be dynamically loaded here -->
        </div>
      </div>
      <div class="px-6 py-4 border-t border-slate-100 flex justify-end bg-slate-50">
        <button onclick="closePreviewDesignModal()" class="border border-slate-200 hover:bg-slate-50 text-slate-800 font-bold px-4 py-2 rounded-xl text-xs transition cursor-pointer">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Crear Nuevo Referido (ADMIN DASHBOARD) -->
  <div id="modalAdminCreateReferral" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 relative shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-user-plus text-blue-600"></i> Crear Cuenta de Referido
        </h3>
        <button onclick="closeAdminCreateReferralModal()" class="text-slate-400 text-lg cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form action="/dashboard/admin/referidos/crear" method="POST" class="space-y-4 text-xs">
        <div class="bg-blue-50/70 p-4 rounded-2xl border border-blue-100 text-blue-900">
          <p class="font-extrabold text-xs mb-1"><i class="fa-solid fa-circle-info text-blue-600"></i> Creación Ultra Simplificada</p>
          <p class="text-[11px] leading-relaxed text-blue-800">Ingresa únicamente el <strong>correo electrónico</strong> del referido. El sistema generará la contraseña temporal y enviará el correo automático con el enlace de acceso.</p>
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase mb-1">Correo Electrónico del Referido *</label>
          <input type="email" name="email" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-bold text-slate-900 focus:outline-none focus:border-blue-500 text-sm" placeholder="comercial@profesionales.ec">
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
          <button type="button" onclick="closeAdminCreateReferralModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 font-bold cursor-pointer">Cancelar</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-extrabold shadow-md cursor-pointer">Crear y Enviar Credenciales</button>
