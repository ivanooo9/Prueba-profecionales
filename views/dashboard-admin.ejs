        cursoModules.splice(mIdx, 1);
        renderCursoStructure();
      }
    }

    function addCursoLesson(mIdx) {
      cursoModules[mIdx].lessons.push({
        titulo: `Lección ${cursoModules[mIdx].lessons.length + 1}`,
        descripcion: '',
        videoUrl: '',
        resources: []
      });
      renderCursoStructure();
    }

    function removeCursoLesson(mIdx, lIdx) {
      if (confirm('¿Está seguro de eliminar esta lección?')) {
        cursoModules[mIdx].lessons.splice(lIdx, 1);
        renderCursoStructure();
      }
    }

    function addCursoResource(mIdx, lIdx) {
      cursoModules[mIdx].lessons[lIdx].resources.push({
        nombre: 'Material de Apoyo',
        url: ''
      });
      renderCursoStructure();
    }

    function removeCursoResource(mIdx, lIdx, rIdx) {
      cursoModules[mIdx].lessons[lIdx].resources.splice(rIdx, 1);
      renderCursoStructure();
    }

    function uploadCursoResourceFile(mIdx, lIdx, rIdx, fileInput) {
      const file = fileInput.files[0];
      if (!file) return;

      const badge = document.getElementById(`resource-badge-${mIdx}-${lIdx}-${rIdx}`);
      if (badge) {
        badge.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i> Cargando...';
        badge.className = "text-[9px] font-bold text-amber-600 bg-amber-50 px-2 py-1 rounded border border-amber-200";
      }

      const reader = new FileReader();
      reader.onload = function(e) {
        cursoModules[mIdx].lessons[lIdx].resources[rIdx].url = e.target.result;
        const nameInput = document.getElementById(`resource-name-${mIdx}-${lIdx}-${rIdx}`);
        if (nameInput && (nameInput.value === 'Material de Apoyo' || !nameInput.value)) {
          nameInput.value = file.name;
          cursoModules[mIdx].lessons[lIdx].resources[rIdx].nombre = file.name;
        }
        if (badge) {
          badge.innerHTML = '<i class="fa-solid fa-check"></i> Cargado';
          badge.className = "text-[9px] font-bold text-emerald-650 bg-emerald-50 px-2 py-1 rounded border border-emerald-200";
        }
      };
      reader.readAsDataURL(file);
    }

