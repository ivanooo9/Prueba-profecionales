<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
  <!-- Chart.js for statistics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- tus-js-client for Bunny Stream uploads -->
  <script src="https://cdn.jsdelivr.net/npm/tus-js-client@3.1.0/dist/tus.js"></script>
  <script>
    window.BUNNY_STREAM_LIBRARY_ID = "<%= typeof bunnyStreamLibraryId !== 'undefined' ? bunnyStreamLibraryId : '' %>";
  </script>

  <style>
    /* Accordion Menu Smooth Transition System */
    .dash-category-content {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease-in-out;
    }

    .dash-category-content.open {
      max-height: 600px;
      opacity: 1;
    }

    .dash-category-header {
      transition: background-color 0.2s ease, color 0.2s ease;
      border-radius: 0.75rem;
      padding: 0.4rem 0.6rem;
    }

    .dash-category-header:hover {
      background-color: rgba(241, 245, 249, 0.8);
      color: #0f172a;
    }

    html.dark .dash-category-header:hover {
      background-color: rgba(31, 41, 55, 0.8);
      color: #f8fafc;
    }
  </style>
</head>
<body class="bg-[#FAFBFD] text-slate-800 antialiased font-sans flex flex-col h-screen overflow-hidden">
  <%- include('partials/impersonation-banner') %>
  <div class="flex flex-1 h-full overflow-hidden">

  <!-- Mobile Drawer Backdrop -->
  <div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden transition-all duration-300"></div>

  <!-- Left Sidebar Navigation -->
  <aside id="sidebar-menu" class="w-64 h-full bg-white border-r border-slate-100 flex-shrink-0 flex flex-col justify-between py-6 px-5 fixed lg:static inset-y-0 left-0 -translate-x-full lg:translate-x-0 z-50 transition-all duration-300 ease-in-out shadow-sm lg:shadow-none">
    
    <div class="flex flex-col gap-6 overflow-y-auto max-h-[85vh] pr-1">
      
      <!-- Profile Branding (Mockup Header) -->
      <div class="flex items-center gap-3 px-1">
        <div class="w-11 h-11 rounded-[16px] bg-rose-100 text-rose-600 flex items-center justify-center font-extrabold shadow-sm flex-shrink-0">
          A
        </div>
        <div class="min-w-0">
          <h3 class="font-extrabold text-sm text-slate-900 leading-none">Administrador</h3>
          <span class="text-[9px] text-[#0A3C84] font-extrabold uppercase tracking-wider block mt-0.5">Control Maestro</span>
        </div>
      </div>

      <!-- Navigation Menu with Categories -->
      <nav class="flex flex-col gap-3" id="dash-tabs">

        <!-- CATEGORIA 1: ANALITICA Y RESUMEN -->
        <div class="dash-category-group">
          <div onclick="toggleCategory('cat-analitica')" class="flex items-center justify-between px-2.5 py-1.5 text-[10px] font-black text-slate-400 uppercase tracking-wider cursor-pointer hover:text-slate-700 transition select-none">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-chart-line text-slate-400 text-xs"></i> Analítica y Resumen</span>
            <i id="icon-cat-analitica" class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200"></i>
          </div>
          <div id="cat-analitica" class="dash-category-content flex flex-col gap-1 mt-1 pl-1">
            <button onclick="switchTab('stats')" id="btn-stats" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="stats">
              <i class="fa-solid fa-chart-line text-sm w-4 text-center text-[#5A7AF3]"></i> <span>Estadísticas</span>
            </button>
          </div>
        </div>

        <!-- CATEGORIA 2: USUARIOS Y ROLES -->
        <div class="dash-category-group">
          <% 
            const pendingUserAlertsCount = (typeof pendingProfessionalsCount !== 'undefined' ? pendingProfessionalsCount : 0) 
              + (typeof stats !== 'undefined' && stats.pendingRoleTransitions ? stats.pendingRoleTransitions : 0);
          %>
          <div onclick="toggleCategory('cat-usuarios')" class="flex items-center justify-between px-2.5 py-1.5 text-[10px] font-black text-slate-400 uppercase tracking-wider cursor-pointer hover:text-slate-700 transition select-none">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-users-gear text-slate-400 text-xs"></i> Usuarios y Roles</span>
            <div class="flex items-center gap-1.5">
              <% if (pendingUserAlertsCount > 0) { %>
                <span class="bg-amber-500 text-white text-[9px] font-black px-1.5 py-0.5 rounded-full"><%= pendingUserAlertsCount %></span>
              <% } %>
              <i id="icon-cat-usuarios" class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200"></i>
            </div>
          </div>
          <div id="cat-usuarios" class="dash-category-content flex flex-col gap-1 mt-1 pl-1">
            <button onclick="switchTab('cuentas')" id="btn-cuentas" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-between text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="cuentas">
              <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-users-gear text-sm w-4 text-center text-[#0A3C84]"></i> 
                <span>Gestión Unificada de Cuentas</span>
              </div>
              <% if (pendingUserAlertsCount > 0) { %>
                <span class="bg-amber-500 text-white text-[9px] font-black px-2 py-0.5 rounded-full"><%= pendingUserAlertsCount %></span>
              <% } %>
            </button>
            <% const pendingRoleTransitionsCount = (typeof stats !== 'undefined' && stats.pendingRoleTransitions) || 0; %>
            <button onclick="switchTab('role-transitions')" id="btn-role-transitions" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-between text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="role-transitions">
              <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-user-gear text-sm w-4 text-center text-sky-600"></i> <span>Solicitudes de Rol</span>
              </div>
              <% if (pendingRoleTransitionsCount > 0) { %>
                <span class="bg-amber-500 text-white text-[9px] font-black px-2 py-0.5 rounded-full"><%= pendingRoleTransitionsCount %></span>
              <% } %>
            </button>
            <button onclick="switchTab('universities')" id="btn-universities" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="universities">
              <i class="fa-solid fa-building-columns text-sm w-4 text-center text-purple-600"></i> <span>Universidades e Inst.</span>
            </button>
          </div>
        </div>

        <!-- CATEGORIA 3: CONTENIDO Y ACADEMIA -->
        <div class="dash-category-group">
          <div onclick="toggleCategory('cat-contenido')" class="flex items-center justify-between px-2.5 py-1.5 text-[10px] font-black text-slate-400 uppercase tracking-wider cursor-pointer hover:text-slate-700 transition select-none">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-book-open text-slate-400 text-xs"></i> Contenido y Academia</span>
            <i id="icon-cat-contenido" class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200"></i>
          </div>
          <div id="cat-contenido" class="dash-category-content flex flex-col gap-1 mt-1 pl-1">
            <button onclick="switchTab('conversatorios')" id="btn-conversatorios" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="conversatorios">
              <i class="fa-solid fa-comments text-sm w-4 text-center text-purple-600"></i> <span>Conversatorios</span>
            </button>
            <button onclick="switchTab('cursos')" id="btn-cursos" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="cursos">
              <i class="fa-solid fa-graduation-cap text-sm w-4 text-center text-[#0A3C84]"></i> <span>Cursos Académicos</span>
            </button>
            <button onclick="switchTab('articles')" id="btn-articles" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="articles">
              <i class="fa-solid fa-newspaper text-sm w-4 text-center text-amber-600"></i> <span>Artículos</span>
            </button>
            <button onclick="switchTab('agreements')" id="btn-agreements" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="agreements">
              <i class="fa-solid fa-handshake text-sm w-4 text-center text-emerald-600"></i> <span>Convenios</span>
            </button>
            <button onclick="switchTab('benefits')" id="btn-benefits" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="benefits">
              <i class="fa-solid fa-star text-sm w-4 text-center text-amber-500"></i> <span>Beneficios del Sistema</span>
            </button>
          </div>
        </div>

        <!-- CATEGORIA 4: VENTAS Y FINANZAS -->
        <div class="dash-category-group">
          <% const pendingRefAlerts = ((typeof stats !== 'undefined' && stats.pendingReferralSales) || 0) + ((typeof stats !== 'undefined' && stats.pendingWithdrawals) || 0); %>
          <div onclick="toggleCategory('cat-finanzas')" class="flex items-center justify-between px-2.5 py-1.5 text-[10px] font-black text-slate-400 uppercase tracking-wider cursor-pointer hover:text-slate-700 transition select-none">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-wallet text-slate-400 text-xs"></i> Ventas y Comisiones</span>
            <div class="flex items-center gap-1.5">
              <% if (pendingRefAlerts > 0) { %>
                <span class="bg-amber-500 text-white text-[9px] font-black px-1.5 py-0.5 rounded-full"><%= pendingRefAlerts %></span>
              <% } %>
              <i id="icon-cat-finanzas" class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200"></i>
            </div>
          </div>
          <div id="cat-finanzas" class="dash-category-content flex flex-col gap-1 mt-1 pl-1">
            <button onclick="switchTab('orders')" id="btn-orders" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="orders">
              <i class="fa-solid fa-receipt text-sm w-4 text-center text-slate-700"></i> <span>Pedidos / Ventas</span>
            </button>
            <button onclick="switchTab('payments')" id="btn-payments" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="payments">
              <i class="fa-solid fa-credit-card text-sm w-4 text-center text-teal-600"></i> <span>Cobros / Cuentas</span>
            </button>
            <button onclick="switchTab('referidos')" id="btn-referidos" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-between text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="referidos">
              <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-users-gear text-sm w-4 text-center text-amber-500"></i> <span>Módulo Referidos</span>
              </div>
              <% if (pendingRefAlerts > 0) { %>
                <span class="bg-amber-500 text-white text-[9px] font-black px-2 py-0.5 rounded-full"><%= pendingRefAlerts %></span>
              <% } %>
            </button>
          </div>
        </div>

        <!-- CATEGORIA 5: CONFIGURACION, MARKETING Y SISTEMA -->
        <div class="dash-category-group">
          <% const unreadMessagesCount = (typeof contactMessages !== 'undefined' && Array.isArray(contactMessages)) ? contactMessages.filter(m => !m.leido).length : 0; %>
          <div onclick="toggleCategory('cat-sistema')" class="flex items-center justify-between px-2.5 py-1.5 text-[10px] font-black text-slate-400 uppercase tracking-wider cursor-pointer hover:text-slate-700 transition select-none">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-sliders text-slate-400 text-xs"></i> Configuración y Sistema</span>
            <div class="flex items-center gap-1.5">
              <% if (unreadMessagesCount > 0) { %>
                <span class="bg-red-500 text-white text-[9px] font-black px-1.5 py-0.5 rounded-full"><%= unreadMessagesCount %></span>
              <% } %>
              <i id="icon-cat-sistema" class="fa-solid fa-chevron-down text-[9px] transition-transform duration-200"></i>
            </div>
          </div>
          <div id="cat-sistema" class="dash-category-content flex flex-col gap-1 mt-1 pl-1">
            <button onclick="switchTab('plans')" id="btn-plans" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="plans">
              <i class="fa-solid fa-tags text-sm w-4 text-center text-blue-500"></i> <span>Planes Afiliación</span>
            </button>
            <button onclick="switchTab('billing-plans')" id="btn-billing-plans" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="billing-plans">
              <i class="fa-solid fa-file-invoice-dollar text-sm w-4 text-center text-emerald-600"></i> <span>Planes Facturación SRI</span>
            </button>
            <button onclick="switchTab('promotion-plans')" id="btn-promotion-plans" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="promotion-plans">
              <i class="fa-solid fa-rectangle-ad text-sm w-4 text-center text-amber-500"></i> <span>Planes Promoción</span>
            </button>
            <button onclick="switchTab('carousels')" id="btn-carousels" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="carousels">
              <i class="fa-solid fa-images text-sm w-4 text-center text-indigo-500"></i> <span>Publicidad / Hero</span>
            </button>
            <button onclick="switchTab('catalogs')" id="btn-catalogs" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="catalogs">
              <i class="fa-solid fa-folder-tree text-sm w-4 text-center text-cyan-600"></i> <span>Especialidades</span>
            </button>
            <button onclick="switchTab('curso-categories')" id="btn-curso-categories" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="curso-categories">
              <i class="fa-solid fa-graduation-cap text-sm w-4 text-center text-purple-600"></i> <span>Categorías de Cursos</span>
            </button>
            <button onclick="switchTab('templates')" id="btn-templates" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="templates">
              <i class="fa-solid fa-palette text-sm w-4 text-center text-rose-500"></i> <span>Diseños de Perfil</span>
            </button>
            <button onclick="switchTab('cms')" id="btn-cms" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="cms">
              <i class="fa-solid fa-file-pen text-sm w-4 text-center text-slate-600"></i> <span>CMS Legal</span>
            </button>
            <button onclick="switchTab('messages')" id="btn-messages" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center justify-between text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="messages">
              <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-envelope text-sm w-4 text-center text-rose-500"></i> <span>Mensajes Contacto</span>
              </div>
              <% if (unreadMessagesCount > 0) { %>
                <span class="bg-red-500 text-white text-[9px] font-black px-2 py-0.5 rounded-full" id="messages-badge"><%= unreadMessagesCount %></span>
              <% } %>
            </button>
            <button onclick="switchTab('style-config')" id="btn-style-config" class="dash-tab-btn w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2.5 text-slate-600 hover:bg-slate-50 hover:text-slate-900 cursor-pointer" data-tab="style-config">
              <i class="fa-solid fa-sliders text-sm w-4 text-center text-[#0A3C84]"></i> <span>Configurar P.EC</span>
            </button>
          </div>
        </div>

      </nav>
    </div>

    <!-- Log Out Link at Bottom -->
    <div class="flex flex-col gap-2">
      <div class="border-t border-slate-100 pt-4 flex flex-col gap-1">
        <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-bold text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition duration-200">
          <i class="fa-solid fa-globe text-sm w-4 text-center text-sky-500 animate-pulse"></i>
          <span>Volver a la Web</span>
        </a>
        <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-bold text-rose-500 hover:bg-rose-50/50 transition duration-200">
          <i class="fa-solid fa-right-from-bracket text-sm w-4 text-center"></i>
          <span>Cerrar Sesión</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Content View Area -->
  <div class="flex-1 flex flex-col h-screen overflow-hidden">
    
    <!-- Top Utility Header Bar -->
    <header class="h-20 bg-white border-b border-slate-100 flex items-center justify-between px-6 md:px-10 flex-shrink-0">
      
      <!-- Left side: Hamburger button + Title -->
      <div class="flex items-center gap-4">
        <button id="mobile-menu-toggle" class="lg:hidden w-10 h-10 rounded-xl bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-600 transition border border-slate-100 cursor-pointer">
          <i class="fa-solid fa-bars-staggered"></i>
        </button>
        <div>
          <h1 class="text-xl md:text-2xl font-black text-slate-900 leading-none">Mi Dashboard Admin</h1>
          <span class="text-[10px] text-slate-400 font-extrabold mt-1.5 block uppercase tracking-wider"><%= new Date().toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' }) %></span>
        </div>
      </div>

      <!-- Right side: Actions -->
      <div class="flex items-center gap-4">
        <!-- Search input box (Mockup styling) -->
        <div class="relative max-w-xs hidden md:block search-container-wrapper">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
          <input type="text" id="dashboard-search-input" placeholder="Buscar..." class="w-48 xl:w-60 bg-slate-50 border border-slate-100 rounded-full py-2.5 pl-10 pr-4 text-xs font-semibold outline-none focus:bg-white focus:border-[#5A7AF3] transition duration-200">
          <div id="search-autocomplete-dropdown" class="absolute left-0 mt-2 w-80 rounded-2xl bg-white dark:bg-slate-900 border border-slate-150 dark:border-slate-800 shadow-xl p-4 z-50 hidden max-h-96 overflow-y-auto"></div>
        </div>

        <!-- Mode controls / Notification badges -->
        <div class="flex items-center gap-2">
          <button id="theme-toggle-btn" class="w-10 h-10 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 text-xs transition border border-slate-50 cursor-pointer" title="Modo Claro">
            <i id="theme-toggle-icon" class="fa-solid fa-sun text-amber-500"></i>
          </button>
          <div class="relative notification-container-wrapper">
            <button id="notification-toggle-btn" class="w-10 h-10 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 text-xs transition border border-slate-50 cursor-pointer relative" title="Notificaciones">
              <i class="fa-regular fa-bell"></i>
              <span id="notification-unread-dot" class="absolute top-2 right-2 w-2 h-2 rounded-full bg-rose-500"></span>
            </button>
            <div id="notifications-dropdown-menu" class="absolute right-0 mt-2 w-80 rounded-2xl bg-white dark:bg-slate-900 border border-slate-150 dark:border-slate-800 shadow-xl py-2 z-50 hidden max-h-96 overflow-y-auto">
              <!-- Dynamic notifications list -->
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div class="h-6 w-px bg-slate-100 hidden sm:block"></div>

        <!-- Quick Profile Link -->
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-full overflow-hidden bg-rose-500 text-white border border-slate-100 flex items-center justify-center shadow-inner flex-shrink-0 font-extrabold text-sm">
            A
          </div>
          <span class="text-xs font-black text-slate-800 hidden sm:inline">Admin</span>
        </div>
      </div>
    </header>

    <!-- Scrollable Content Area -->
    <main class="flex-1 overflow-y-auto bg-[#FAFBFD] p-6 md:p-10 flex flex-col gap-8">
      
      <!-- Alert Notifications -->
      <div id="admin-alert-container" class="hidden mb-2">
        <div id="admin-alert" class="flex items-center gap-3 p-4 rounded-2xl border font-sans text-xs font-bold transition shadow-sm">
          <div id="admin-alert-icon" class="text-base shrink-0"></div>
          <div id="admin-alert-message" class="flex-grow"></div>
          <button onclick="closeAdminAlert()" class="text-slate-400 hover:text-slate-650 transition text-sm cursor-pointer">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>

      <% if (typeof stats !== 'undefined') { %>
        <% const pendingTransitions = (stats.pendingRoleTransitions || 0); %>
        <% const pendingProfs = (stats.pendingProfessionalsCount || 0); %>
        <% if (pendingTransitions > 0 || pendingProfs > 0) { %>
          <div class="bg-amber-500/10 border border-amber-300/80 rounded-2xl p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-sm font-sans mb-2">
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center text-lg flex-shrink-0 shadow-sm animate-pulse">
                <i class="fa-solid fa-bell"></i>
              </div>
              <div>
                <h4 class="font-extrabold text-xs text-amber-950 uppercase tracking-wide">Solicitudes y Registros Pendientes de Atención</h4>
                <p class="text-xs text-amber-900 font-semibold mt-0.5">
                  <% if (pendingTransitions > 0 && pendingProfs > 0) { %>
                    Tienes <strong><%= pendingTransitions %> solicitud(es) de cambio de rol a Profesional</strong> y <strong><%= pendingProfs %> nuevo(s) profesional(es) registrado(s)</strong> por revisar y aprobar.
                  <% } else if (pendingTransitions > 0) { %>
                    Tienes <strong><%= pendingTransitions %> solicitud(es) de cambio de rol a Profesional</strong> pendiente(s) de aprobación.
                  <% } else { %>
                    Tienes <strong><%= pendingProfs %> nuevo(s) profesional(es) registrado(s)</strong> pendiente(s) de revisión y aprobación.
                  <% } %>
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2 self-end md:self-auto flex-wrap">
              <% if (pendingTransitions > 0) { %>
                <button onclick="switchTab('role-transitions')" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold rounded-xl transition cursor-pointer shadow-sm flex items-center gap-1.5">
                  <i class="fa-solid fa-user-gear text-xs"></i> Ver Solicitudes de Rol (<%= pendingTransitions %>)
                </button>
              <% } %>
              <% if (pendingProfs > 0) { %>
                <button onclick="switchTab('professionals')" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition cursor-pointer shadow-sm flex items-center gap-1.5">
                  <i class="fa-solid fa-user-check text-xs"></i> Revisar Profesionales (<%= pendingProfs %>)
                </button>
              <% } %>
            </div>
          </div>
        <% } %>
      <% } %>
      
      <!-- TAB: ESTADISTICAS -->
      <section id="tab-stats" class="dash-tab-pane flex flex-col gap-6">
        
        <!-- Two Column Layout: Main Section (Left, 3/4) & Widgets Section (Right, 1/4) -->
        <div class="grid grid-cols-1 xl:grid-cols-4 gap-6 items-start">
          
          <!-- LEFT COLUMN: KPI Cards + Chart + Transactions Table -->
          <div class="xl:col-span-3 flex flex-col gap-6">
            
            <!-- Three KPI Cards Row -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              
              <!-- Card 1: Blue Background (Total Projects mockup style) -->
              <div class="bg-[#5A7AF3] text-white p-6 rounded-[24px] shadow-lg shadow-[#5A7AF3]/20 flex flex-col justify-between h-40 font-sans relative overflow-hidden">
                <div class="absolute right-[-10px] top-[-10px] w-24 h-24 rounded-full bg-white/10 blur-xl"></div>
                <div>
                  <span class="text-xs font-bold opacity-80 uppercase tracking-wider">Total Profesionales</span>
                  <h4 class="text-3xl font-black mt-2"><%= stats.totalProfessionals %></h4>
                </div>
                <div class="flex items-center gap-1.5 text-xs font-bold mt-4 bg-white/15 px-3 py-1 rounded-full w-fit">
                  <i class="fa-solid fa-arrow-trend-up"></i>
                  <span>+12% este mes</span>
                </div>
              </div>
              
              <!-- Card 2: White Background -->
              <div class="bg-white border border-slate-100 p-6 rounded-[24px] shadow-[0_8px_20px_rgba(0,0,0,0.02)] flex flex-col justify-between h-40 font-sans">
                <div>
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Citas Agendadas</span>
                  <h4 class="text-3xl font-black text-slate-900 mt-2"><%= stats.totalAppointments %></h4>
                </div>
                <div class="flex items-center gap-1.5 text-xs font-bold text-emerald-600 mt-4 bg-emerald-50 px-3 py-1 rounded-full w-fit">
                  <i class="fa-solid fa-arrow-trend-up"></i>
                  <span>+8% completados</span>
                </div>
              </div>
              
              <!-- Card 3: White Background -->
              <div class="bg-white border border-slate-100 p-6 rounded-[24px] shadow-[0_8px_20px_rgba(0,0,0,0.02)] flex flex-col justify-between h-40 font-sans">
                <div>
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Facturas Emitidas</span>
                  <h4 class="text-3xl font-black text-slate-900 mt-2"><%= stats.totalInvoices %></h4>
                </div>
                <div class="flex items-center gap-1.5 text-xs font-bold text-blue-600 mt-4 bg-blue-50 px-3 py-1 rounded-full w-fit">
                  <i class="fa-solid fa-arrow-trend-up"></i>
                  <span>+15% facturación</span>
                </div>
              </div>
              
            </div>

            <!-- Revenue Chart Card -->
            <div class="bg-white border border-slate-100 rounded-[28px] p-6 shadow-[0_8px_20px_rgba(0,0,0,0.02)] flex flex-col gap-4 font-sans">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-extrabold text-sm text-slate-900">Métricas de Crecimiento del Sistema</h3>
                  <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Registros y Citas por Mes</p>
                </div>
                <select class="bg-slate-50 border border-slate-100 rounded-xl px-3 py-1.5 text-[10px] font-bold text-slate-650 outline-none cursor-pointer">
                  <option>Este Año</option>
                  <option>Mes Pasado</option>
                </select>
              </div>
              <div class="h-80">
                <canvas id="registrationChart"></canvas>
              </div>
            </div>

            <!-- Solicitudes de Registro Recientes Table -->
            <div class="bg-white border border-slate-100 rounded-[28px] p-6 shadow-[0_8px_20px_rgba(0,0,0,0.02)] flex flex-col gap-4 font-sans">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-extrabold text-sm text-slate-900">Solicitudes de Registro Recientes</h3>
                  <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Últimos Profesionales Pendientes</p>
                </div>
                <button onclick="switchTab('professionals')" class="text-[10px] font-bold text-[#5A7AF3] hover:underline">
                  Ver Todos
                </button>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                  <thead class="bg-slate-50 text-slate-450 font-bold uppercase tracking-wider border-b border-slate-100">
                    <tr>
                      <th class="px-4 py-3 text-[10px]">Nombre</th>
                      <th class="px-4 py-3 text-[10px]">Especialidad/Slogan</th>
                      <th class="px-4 py-3 text-[10px]">Estado</th>
                      <th class="px-4 py-3 text-right text-[10px]">Acción</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-50 font-medium text-slate-600">
                    <% if (pendingProfessionals.length > 0) { %>
                      <% pendingProfessionals.slice(0, 3).forEach(function(p) { %>
                        <tr class="hover:bg-slate-50/50 transition">
                          <td class="px-4 py-3.5 flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-[#5A7AF3]/10 text-[#5A7AF3] flex items-center justify-center font-extrabold text-xs">
                              <%= p.user.name.charAt(0) %>
                            </div>
                            <div>
                              <div class="font-bold text-slate-900"><%= p.user.name %></div>
                              <div class="text-[9px] text-slate-400"><%= p.user.email %></div>
                            </div>
                          </td>
                          <td class="px-4 py-3.5 max-w-[200px] truncate"><%= p.slogan || 'No especificado' %></td>
                          <td class="px-4 py-3.5">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-50 border border-amber-100 text-amber-600">
                              PENDIENTE
                            </span>
                          </td>
                          <td class="px-4 py-3.5 text-right">
                            <button onclick="inspectProfile(<%= p.id %>)" class="text-[10px] bg-slate-50 hover:bg-[#5A7AF3]/10 text-slate-600 hover:text-[#5A7AF3] font-bold px-2.5 py-1.5 rounded-lg border border-slate-150 transition cursor-pointer">
                              Revisar
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr>
                        <td colspan="4" class="px-4 py-8 text-center text-slate-400">
                          No hay solicitudes pendientes de aprobación.
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>

          </div>

          <!-- RIGHT COLUMN: Sidebar Column Cards -->
          <div class="flex flex-col gap-6">
            
            <!-- Card 1: Team Review (Mockup style) -->
            <div class="bg-white border border-slate-100 rounded-[28px] p-6 shadow-[0_8px_20px_rgba(0,0,0,0.02)] flex flex-col gap-4 font-sans">
              <span class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400 bg-slate-50 px-2.5 py-1 rounded-full w-fit">Control de Afiliaciones</span>
              <div>
                <h4 class="font-extrabold text-sm text-slate-900">Planes del Sistema</h4>
                <p class="text-xs text-slate-400 mt-1 leading-normal font-semibold">Configuración de los planes de suscripción para los profesionales de salud.</p>
              </div>
              <div class="flex items-center justify-between border-t border-slate-50 pt-4 mt-1">
                <span class="text-[10px] text-slate-400 font-bold"><%= plans.length %> Planes Configurados</span>
                <button onclick="switchTab('plans')" class="bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold py-1.5 px-3 rounded-xl border border-slate-200 transition text-[10px]">
                  Gestionar
                </button>
              </div>
            </div>

            <!-- Card 2: Upcoming Event (Mockup style) -->
            <div class="bg-white border border-slate-100 rounded-[28px] p-6 shadow-[0_8px_20px_rgba(0,0,0,0.02)] flex flex-col gap-4 font-sans">
              <span class="text-[9px] font-extrabold uppercase tracking-wider text-[#5A7AF3] bg-[#5A7AF3]/10 px-2.5 py-1 rounded-full w-fit">Próximos Conversatorios</span>
              <div>
                <h4 class="font-extrabold text-sm text-slate-900">Agenda Académica</h4>
                <p class="text-xs text-slate-450 mt-1 leading-normal font-semibold">Visualiza y añade conversatorios y cursos para la formación continua.</p>
              </div>
              
              <div class="bg-slate-50/50 border border-slate-100 p-3 rounded-2xl flex flex-col gap-1.5">
                <span class="text-[9px] font-black text-slate-400 uppercase tracking-wider">Próximo Evento</span>
                <% if (conversatorios.length > 0) { %>
                  <div class="font-bold text-slate-800 text-xs truncate"><%= conversatorios[0].titulo %></div>
                  <div class="text-[9px] text-slate-500 font-medium"><%= new Date(conversatorios[0].fechaInicio).toISOString().split('T')[0] %></div>
                <% } else { %>
                  <div class="font-bold text-slate-450 text-xs">Sin eventos programados</div>
                <% } %>
              </div>

              <button onclick="switchTab('conversatorios')" class="bg-[#5A7AF3] hover:bg-[#4E73DF] text-white font-bold py-2 rounded-xl text-[10px] transition text-center shadow-md shadow-[#5A7AF3]/10">
                Ver Agenda
              </button>
            </div>

            <!-- Card 3: Team Performance Chart (Mockup style) -->
            <div class="bg-white border border-slate-100 rounded-[28px] p-6 shadow-[0_8px_20px_rgba(0,0,0,0.02)] flex flex-col gap-4 font-sans">
              <div>
                <h4 class="font-extrabold text-sm text-slate-900">Estructura del Directorio</h4>
                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Especialidades por Profesión</p>
              </div>
              
              <div class="flex flex-col gap-3">
                <div class="flex items-center justify-between text-xs font-bold text-slate-700">
                  <span>Profesionales Activos</span>
                  <span><%= stats.totalProfessionals %></span>
                </div>
                <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                  <div class="bg-[#5A7AF3] h-full" style="width: <%= Math.min(100, (stats.totalProfessionals / 100) * 100) + '%' %>"></div>
                </div>

                <div class="flex items-center justify-between text-xs font-bold text-slate-700 mt-1">
                  <span>Especialidades</span>
                  <span><%= stats.totalAgreements %></span>
                </div>
                <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                  <div class="bg-emerald-500 h-full" style="width: 75%"></div>
                </div>
              </div>
            </div>

          </div>

        </div>

      </section>

      <!-- TAB: GESTIÓN UNIFICADA DE CUENTAS -->
      <section id="tab-cuentas" class="dash-tab-pane hidden flex flex-col gap-6 font-sans">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-2.5">
              <i class="fa-solid fa-users-gear text-[#0A3C84]"></i> Gestión Unificada de Cuentas
            </h2>
            <p class="text-xs font-medium text-slate-500 mt-1">Administra y audita el listado completo de clientes, estudiantes, profesionales, solicitudes de rol y afiliados comerciales.</p>
          </div>
          <button onclick="openCreateProfessionalModal()" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3 px-5 rounded-2xl transition text-xs shadow-md flex items-center gap-2 cursor-pointer self-start md:self-auto">
            <i class="fa-solid fa-user-plus text-xs"></i> Crear Usuario / Profesional
          </button>
        </div>

        <!-- Buscador Global Rápido de Cuentas -->
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-center gap-3">
          <div class="relative flex-1 w-full">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-slate-400 text-sm"></i>
            <input type="text" id="global-accounts-search" oninput="filterAllAccountsGlobal()" placeholder="⚡ Buscar cualquier persona instantáneamente por nombre, correo, RUC o teléfono..." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 pl-11 pr-10 text-xs font-bold text-slate-800 outline-none focus:bg-white focus:border-[#0A3C84] focus:ring-2 focus:ring-[#0A3C84]/10 transition shadow-inner">
            <button type="button" onclick="clearGlobalAccountsSearch()" id="clear-global-search-btn" class="hidden absolute right-3.5 top-3 text-slate-400 hover:text-slate-700 text-xs font-black p-1 rounded-full hover:bg-slate-200 transition cursor-pointer">
              ✕
            </button>
          </div>
          <div id="global-search-count-badge" class="hidden bg-blue-50 text-[#0A3C84] border border-blue-100 text-xs font-black px-4 py-2.5 rounded-xl whitespace-nowrap flex items-center gap-1.5 shadow-sm">
            <i class="fa-solid fa-filter text-[10px]"></i> <span id="global-search-count-text">0 Coincidencias</span>
          </div>
        </div>

        <!-- Pill Subtabs Navigation Bar -->
        <div class="flex flex-wrap items-center gap-2 bg-white p-2 rounded-2xl border border-slate-100 shadow-sm">
          <button type="button" id="btn-subtab-clientes" onclick="switchAccountSubtab('clientes')" class="px-4 py-2.5 font-black text-xs rounded-xl transition bg-[#0A3C84] text-white shadow-sm flex items-center gap-2 cursor-pointer">
            <i class="fa-solid fa-user"></i> Clientes / Pacientes
            <span class="bg-blue-100 text-[#0A3C84] text-[10px] font-black px-2 py-0.5 rounded-full ml-1"><%= typeof clientUsers !== 'undefined' ? clientUsers.length : 0 %></span>
          </button>
          
          <button type="button" id="btn-subtab-estudiantes" onclick="switchAccountSubtab('estudiantes')" class="px-4 py-2.5 font-bold text-xs rounded-xl transition bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center gap-2 cursor-pointer">
            <i class="fa-solid fa-graduation-cap text-blue-600"></i> Estudiantes
            <span class="bg-slate-200 text-slate-700 text-[10px] font-black px-2 py-0.5 rounded-full ml-1"><%= typeof studentsList !== 'undefined' ? studentsList.length : 0 %></span>
          </button>

          <button type="button" id="btn-subtab-profesionales" onclick="switchAccountSubtab('profesionales')" class="px-4 py-2.5 font-bold text-xs rounded-xl transition bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center gap-2 cursor-pointer">
            <i class="fa-solid fa-user-tie text-emerald-600"></i> Profesionales
            <span class="bg-slate-200 text-slate-700 text-[10px] font-black px-2 py-0.5 rounded-full ml-1"><%= typeof allProfessionals !== 'undefined' ? allProfessionals.length : 0 %></span>
          </button>

          <% const pendingTransCount = (typeof roleTransitionRequests !== 'undefined' ? roleTransitionRequests.filter(r => r.estado === 'PENDIENTE').length : 0); %>
          <button type="button" id="btn-subtab-solicitudes" onclick="switchTab('role-transitions')" class="px-4 py-2.5 font-bold text-xs rounded-xl transition bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center gap-2 cursor-pointer">
            <i class="fa-solid fa-arrows-rotate text-purple-600"></i> Solicitudes de Rol
            <% if (pendingTransCount > 0) { %>
              <span class="bg-amber-500 text-white text-[10px] font-black px-2 py-0.5 rounded-full ml-1"><%= pendingTransCount %></span>
            <% } %>
          </button>

          <button type="button" id="btn-subtab-referidos" onclick="switchAccountSubtab('referidos')" class="px-4 py-2.5 font-bold text-xs rounded-xl transition bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center gap-2 cursor-pointer">
            <i class="fa-solid fa-users-rectangle text-amber-500"></i> Red de Referidos
            <span class="bg-slate-200 text-slate-700 text-[10px] font-black px-2 py-0.5 rounded-full ml-1"><%= typeof referralProfiles !== 'undefined' ? referralProfiles.length : 0 %></span>
          </button>
        </div>

        <!-- SUBTAB 1: CLIENTES / PACIENTES -->
        <div id="subtab-cuentas-clientes" class="flex flex-col gap-6">
          <!-- Filters & Search Bar -->
          <div class="bg-white border border-slate-100 rounded-3xl p-5 shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="relative w-full md:w-80">
              <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
              <input type="text" id="search-clientes-input" oninput="filterClientesTable()" placeholder="Buscar cliente por nombre o correo..." class="w-full bg-slate-50 border border-slate-100 rounded-2xl py-2.5 pl-10 pr-4 text-xs font-semibold outline-none focus:bg-white focus:border-[#0A3C84] transition">
            </div>

            <div class="flex items-center gap-3 w-full md:w-auto justify-end">
              <span class="text-xs font-extrabold text-slate-500">Filtrar Estado:</span>
              <select id="filter-clientes-status" onchange="filterClientesTable()" class="bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-xs font-bold outline-none text-slate-700">
                <option value="all">Todos los Estados</option>
                <option value="ACTIVE">Cuentas Activas</option>
                <option value="INACTIVE">Cuentas Suspendidas</option>
              </select>
            </div>
          </div>

          <!-- Table of Clients -->
          <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden shadow-sm">
            <div class="px-6 py-5 border-b border-slate-50 flex items-center justify-between">
              <h3 class="font-extrabold text-sm text-slate-900">Listado de Clientes y Pacientes Registrados</h3>
              <span class="text-xs text-slate-400 font-bold">Total: <%= typeof clientUsers !== 'undefined' ? clientUsers.length : 0 %> cuentas</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-100">
                  <tr>
                    <th class="px-6 py-4">Cliente / Usuario</th>
                    <th class="px-6 py-4">Teléfono / Ubicación</th>
                    <th class="px-6 py-4">Fecha Registro</th>
                    <th class="px-6 py-4 text-center">Estado Cuenta</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="clientes-tbody" class="divide-y divide-slate-50 font-medium text-slate-700">
                  <% if (typeof clientUsers !== 'undefined' && clientUsers && clientUsers.length > 0) { %>
                    <% clientUsers.forEach(function(u) { %>
                      <tr class="hover:bg-slate-50/50 transition" data-name="<%= u.name.toLowerCase() %>" data-email="<%= u.email.toLowerCase() %>" data-status="<%= u.status %>">
                        <td class="px-6 py-4 flex items-center gap-3">
                          <div class="w-10 h-10 rounded-full bg-blue-50 text-[#0A3C84] border border-blue-100 flex items-center justify-center font-black text-sm shrink-0 shadow-sm">
                            <%= u.name ? u.name.charAt(0).toUpperCase() : 'U' %>
                          </div>
                          <div>
                            <div class="font-extrabold text-slate-900 text-xs"><%= u.name %></div>
                            <div class="text-[10px] text-slate-400 font-semibold mt-0.5"><%= u.email %></div>
                          </div>
                        </td>
                        <td class="px-6 py-4">
                          <div class="font-bold text-slate-800"><%= u.telefono || 'Sin teléfono' %></div>
                          <div class="text-[10px] text-slate-400"><%= u.ciudad || 'Sin ciudad' %></div>
                        </td>
                        <td class="px-6 py-4 text-slate-500 font-semibold">
                          <%= new Date(u.createdAt).toLocaleDateString('es-EC', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                        </td>
                        <td class="px-6 py-4 text-center">
                          <span class="px-2.5 py-1 rounded-full text-[10px] font-black <%= u.status === 'ACTIVE' ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-rose-50 text-rose-600 border border-rose-100' %>">
                            <%= u.status === 'ACTIVE' ? 'ACTIVA' : 'SUSPENDIDA' %>
                          </span>
                        </td>
                        <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                          <button type="button" onclick="openSuperAdminProfileModal(<%= u.id %>)" class="px-2.5 py-1.5 rounded-lg font-extrabold text-[10px] bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition cursor-pointer flex items-center gap-1" title="Superpoderes de Administración">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-600"></i> Edición Total
                          </button>

                          <button onclick="openChangeRoleModal(<%= u.id %>, '<%= u.name.replace(/'/g, "\\'") %>', <%= u.roleId %>)" class="text-[#0A3C84] hover:text-[#082C62] bg-blue-50 hover:bg-blue-100 font-bold px-2.5 py-1.5 rounded-lg border border-blue-100 transition text-[10px] cursor-pointer flex items-center gap-1">
                            <i class="fa-solid fa-user-gear"></i> Cambiar Rol
                          </button>

