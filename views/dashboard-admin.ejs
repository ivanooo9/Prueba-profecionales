    function updateCursoMediaPreview(url, type) {
      const imgPreview = document.getElementById('curso-media-image-preview');
      const vidPreview = document.getElementById('curso-media-video-preview');
      const ytPreview = document.getElementById('curso-media-yt-preview');
      const bunnyPreview = document.getElementById('curso-media-bunny-preview');
      const placeholder = document.getElementById('curso-media-placeholder');
      
      if (imgPreview) imgPreview.classList.add('hidden');
      if (vidPreview) vidPreview.classList.add('hidden');
      if (ytPreview) ytPreview.classList.add('hidden');
      if (bunnyPreview) bunnyPreview.classList.add('hidden');
      if (placeholder) placeholder.classList.add('hidden');
      
      if (!url) {
        if (placeholder) placeholder.classList.remove('hidden');
        return;
      }
      
      if (type === 'imagen') {
        if (imgPreview) {
          imgPreview.src = url;
          imgPreview.classList.remove('hidden');
        }
      } else {
        // Video type
        if (url.startsWith('bunny:')) {
          const parts = url.split(':');
          const libraryId = parts[1];
          const videoId = parts[2];
          if (bunnyPreview) {
            bunnyPreview.src = `https://iframe.mediadelivery.net/embed/${libraryId}/${videoId}?autoplay=true&preload=true`;
            bunnyPreview.classList.remove('hidden');
          }
        } else {
          const ytRegExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
          const match = url.match(ytRegExp);
          if (match && match[2].length === 11) {
            if (ytPreview) {
              ytPreview.classList.remove('hidden');
            }
          } else {
            if (vidPreview) {
              vidPreview.src = url;
              vidPreview.classList.remove('hidden');
            }
          }
        }
      }
    }

    // Modal Inspect Professional details
    function escapeInspectorHtml(value) {
      return String(value || '').replace(/[&<>"]/g, function(char) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;'
        }[char];
      });
    }

    function getSafeUploadedImageUrl(value) {
      if (typeof value !== 'string') return '';

      const url = value.trim();
      if (!url) return '';

      if (url.startsWith('data:image/')) return url;
      if (url.startsWith('/') && !url.startsWith('//')) return url;

      try {
        const parsed = new URL(url);
        if (parsed.protocol === 'https:' || parsed.protocol === 'http:') return url;
      } catch (error) {
        return '';
      }

      return '';
    }

