    function toggleCategory(catId) {
      const target = document.getElementById(catId);
      const iconTarget = document.getElementById('icon-' + catId);
      if (!target) return;

      const isAlreadyOpen = target.classList.contains('open');

      const allCategories = document.querySelectorAll('.dash-category-content');
      allCategories.forEach(cat => {
        cat.classList.remove('open');
        const icon = document.getElementById('icon-' + cat.id);
        if (icon) {
          icon.classList.remove('rotate-180');
        }
      });

      if (!isAlreadyOpen) {
        target.classList.add('open');
        if (iconTarget) {
          iconTarget.classList.add('rotate-180');
        }
      }
    }

    function openCategorySmooth(catId) {
      const target = document.getElementById(catId);
      const iconTarget = document.getElementById('icon-' + catId);
      if (!target) return;

      const allCategories = document.querySelectorAll('.dash-category-content');
      allCategories.forEach(cat => {
        if (cat.id !== catId) {
          cat.classList.remove('open');
          const icon = document.getElementById('icon-' + cat.id);
          if (icon) icon.classList.remove('rotate-180');
        }
      });

      target.classList.add('open');
      if (iconTarget) iconTarget.classList.add('rotate-180');
    }

    function switchTab(tabId) {
      if (tabId === 'accounts') tabId = 'cuentas';
      document.querySelectorAll('.dash-tab-pane').forEach(pane => pane.classList.add('hidden'));
      const targetPane = document.getElementById('tab-' + tabId);
      if (targetPane) targetPane.classList.remove('hidden');

      document.querySelectorAll('.dash-tab-btn').forEach(btn => {
        btn.classList.remove('bg-blue-50/80', 'text-[#0A3C84]', 'font-black', 'border-l-4', 'border-[#0A3C84]', 'bg-slate-100', 'text-slate-900');
        btn.classList.add('text-slate-600');
      });

      const activeBtn = document.querySelector(`.dash-tab-btn[data-tab="${tabId}"]`) || document.getElementById('btn-' + tabId);
      if (activeBtn) {
        activeBtn.classList.remove('text-slate-600');
        activeBtn.classList.add('bg-blue-50/80', 'text-[#0A3C84]', 'font-black', 'border-l-4', 'border-[#0A3C84]');

        // Expand parent category if collapsed
        const parentCategory = activeBtn.closest('.dash-category-content');
        if (parentCategory) {
          openCategorySmooth(parentCategory.id);
        }
      }

      if (tabId === 'curso-categories' && typeof window.loadCursoCategoriesData === 'function') {
        window.loadCursoCategoriesData();
      }

      localStorage.setItem('adminActiveTab', tabId);
    }

