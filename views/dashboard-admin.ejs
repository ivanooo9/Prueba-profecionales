    function uploadCursoSpeakerPhoto(index, fileInput) {
      const file = fileInput.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        cursoSpeakers[index].foto = e.target.result;
        const imgEl = document.getElementById(`speaker-photo-preview-${index}`);
        if (imgEl) {
          imgEl.src = e.target.result;
