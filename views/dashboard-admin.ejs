    function previewTemplateImage(tplOrId) {
      let tpl = typeof tplOrId === 'object' ? tplOrId : systemTemplatesList.find(t => t.id === parseInt(tplOrId));
      if (!tpl) return;
      
      document.getElementById('preview-design-title').innerText = tpl.name;
      const imgContainer = document.getElementById('preview-design-img-container');
      imgContainer.innerHTML = ''; // clear previous
      
      const isDefault = tpl.baseLayout === 'default';
      const isEjecutiva = tpl.baseLayout === 'ejecutiva';
      const isMedica = tpl.baseLayout === 'medica';
      
      if (isDefault) {
        imgContainer.innerHTML = generateDefaultProfileMockup();
      } else if (isEjecutiva) {
        imgContainer.innerHTML = generateEjecutivaProfileMockup();
      } else if (isMedica) {
        imgContainer.innerHTML = generateMedicaProfileMockup();
      } else if (tpl.thumbnail && tpl.thumbnail.trim() !== '') {
        const parts = tpl.thumbnail.split(',');
        parts.forEach(part => {
          const img = document.createElement('img');
          img.src = part.trim();
          img.alt = tpl.name;
          img.className = 'w-full object-contain rounded-2xl border border-slate-100 shadow-sm';
          imgContainer.appendChild(img);
        });
      } else {
        const img = document.createElement('img');
        img.src = 'https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?q=80&w=600';
        img.alt = tpl.name;
        img.className = 'w-full object-contain rounded-2xl border border-slate-100';
        imgContainer.appendChild(img);
      }
      document.getElementById('preview-design-modal').classList.remove('hidden');
    }

