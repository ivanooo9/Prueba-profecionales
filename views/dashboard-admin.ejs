      let currentAdminProfFilter = "";

      async function loadCursoCategoriesData() {
        const container = document.getElementById('curso-categories-tree-container');
        if (!container) return;
        container.innerHTML = `<div class="text-center py-12 text-slate-400 font-semibold text-xs"><i class="fa-solid fa-spinner fa-spin mr-2"></i> Cargando categorías y ramas...</div>`;

        try {
          const res = await fetch('/api/admin/curso-categories');
          const data = await res.json();
          if (data.success) {
            adminCursoCategoriesData = data.categories || [];
            adminProfessionsData = data.professions || [];
            populateBranchCategoryOptions();
            renderCursoCategoriesTree();
          } else {
            container.innerHTML = `<div class="text-center py-8 text-rose-500 text-xs font-bold">${data.error || 'Error al cargar categorías'}</div>`;
          }
        } catch (err) {
          console.error('Error fetching curso categories:', err);
          container.innerHTML = `<div class="text-center py-8 text-rose-500 text-xs font-bold">Error de conexión al obtener categorías.</div>`;
        }
      }

      function populateBranchCategoryOptions() {
        const branchCatSelect = document.getElementById('curso-branch-categoryId');
        if (!branchCatSelect) return;
        const currentVal = branchCatSelect.value;
        let html = '<option value="">Seleccione categoría...</option>';

        let filtered = adminCursoCategoriesData;
        if (currentAdminProfFilter) {
          filtered = adminCursoCategoriesData.filter(c => !c.professionId || String(c.professionId) === String(currentAdminProfFilter));
        }

        filtered.forEach(c => {
          const profName = c.profession ? ` (${c.profession.nombre})` : '';
          html += `<option value="${c.id}">${c.nombre}${profName}</option>`;
        });

        branchCatSelect.innerHTML = html;
        if (currentVal) branchCatSelect.value = currentVal;
      }

