  <!-- MODAL: CREAR USUARIO / PROFESIONAL (SUPER-ADMIN) -->
  <div id="modalCreateProfessionalUser" class="fixed inset-0 z-[2000] bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4" style="display: none;">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 relative shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-200 border border-slate-100 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-user-plus text-[#0A3C84]"></i> Crear Nuevo Usuario / Profesional
        </h3>
        <button type="button" onclick="closeCreateProfessionalModal()" class="text-slate-400 hover:text-slate-600 cursor-pointer text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form action="/dashboard/admin/users/create" method="POST" class="space-y-4 text-xs font-sans">
        <div class="p-3.5 bg-blue-50/70 border border-blue-100 rounded-2xl text-blue-900 text-[11px] leading-relaxed">
          <i class="fa-solid fa-circle-info text-blue-600 mr-1"></i>
          Completa los datos del nuevo usuario. Si seleccionas el rol <strong>Profesional</strong> o <strong>Estudiante</strong>, se generará automáticamente su perfil correspondiente.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          <div class="md:col-span-2">
            <label class="block text-slate-700 font-bold mb-1">Nombre Completo *</label>
            <input type="text" name="name" required placeholder="Ej: Dr. Carlos Andrade" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
          </div>

          <div>
            <label class="block text-slate-700 font-bold mb-1">Correo Electrónico *</label>
            <input type="email" name="email" required placeholder="correo@ejemplo.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
          </div>

          <div>
            <label class="block text-slate-700 font-bold mb-1">Contraseña *</label>
            <input type="password" name="password" required placeholder="••••••••" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
          </div>

          <div>
            <label class="block text-slate-700 font-bold mb-1">Rol de Usuario *</label>
            <select name="roleId" id="create-user-roleId" onchange="toggleCreateRoleFields()" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
              <option value="3">Cliente / Paciente</option>
              <option value="4">Estudiante</option>
              <option value="2" selected>Profesional</option>
              <option value="1">Administrador</option>
            </select>
          </div>

          <div>
            <label class="block text-slate-700 font-bold mb-1">Estado de Cuenta</label>
            <select name="status" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
              <option value="ACTIVE">Activa</option>
              <option value="SUSPENDED">Suspendida</option>
            </select>
          </div>

          <div>
            <label class="block text-slate-700 font-bold mb-1">Teléfono / WhatsApp</label>
            <input type="text" name="telefono" placeholder="0991234567" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
          </div>

          <div>
            <label class="block text-slate-700 font-bold mb-1">Ciudad</label>
            <input type="text" name="ciudad" placeholder="Quito / Loja / Guayaquil" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
          </div>
        </div>

        <!-- Seccion Especial Profesional -->
        <div id="create-prof-section" class="border-t border-slate-100 pt-3 space-y-3">
          <h4 class="font-extrabold text-xs text-[#0A3C84] flex items-center gap-1.5">
            <i class="fa-solid fa-user-tie"></i> Datos del Perfil Profesional
          </h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-slate-700 font-bold mb-1">Tipo de Plan</label>
              <select name="planType" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
                <option value="PROFESIONAL">PROFESIONAL</option>
                <option value="PREMIUM">PREMIUM</option>
              </select>
            </div>
            <div>
              <label class="block text-slate-700 font-bold mb-1">Estado de Registro</label>
              <select name="profStatus" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
                <option value="APROBADO">APROBADO</option>
                <option value="PENDIENTE">PENDIENTE</option>
              </select>
            </div>
            <div class="md:col-span-2">
              <label class="block text-slate-700 font-bold mb-1">Slogan / Título Breve</label>
              <input type="text" name="slogan" placeholder="Ej: Especialista en Derecho Laboral" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 outline-none focus:border-[#0A3C84] focus:bg-white text-xs font-bold text-slate-800">
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
          <button type="button" onclick="closeCreateProfessionalModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2.5 px-5 rounded-xl transition cursor-pointer">
            Cancelar
          </button>
          <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-2.5 px-6 rounded-xl shadow-md transition cursor-pointer">
            <i class="fa-solid fa-user-plus mr-1"></i> Crear Usuario
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    async function openSuperAdminUserModal(userId) {
      if (window.closeAllAdminModals) window.closeAllAdminModals();
      try {
        const modal = document.getElementById('super-admin-profile-modal');
        const form = document.getElementById('super-admin-profile-form');
        const impersonateForm = document.getElementById('super-admin-impersonate-form');
        const forceLogoutForm = document.getElementById('super-admin-force-logout-form');
