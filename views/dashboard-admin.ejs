    function updateSuperAdminTabsVisibility() {
      const roleSelect = document.getElementById('super-u-roleId');
      if (!roleSelect) return;
      const selectedOption = roleSelect.options[roleSelect.selectedIndex];
      const selectedText = (selectedOption ? selectedOption.text : '').toUpperCase();
      const val = String(roleSelect.value);

      const btnProf = document.getElementById('super-tab-btn-profesional');
      const btnStud = document.getElementById('super-tab-btn-estudiantil');

      const isStudent = selectedText.includes('ESTUDIANTE') || selectedText.includes('STUDENT') || val === '17';
      const isProfessional = selectedText.includes('PROFESIONAL') || selectedText.includes('PROFESSIONAL') || val === '2';
      const isAdmin = selectedText.includes('ADMIN');

      if (btnProf) {
        if (isProfessional || isAdmin) {
          btnProf.classList.remove('hidden');
        } else {
          btnProf.classList.add('hidden');
        }
      }

      if (btnStud) {
        if (isStudent || isAdmin) {
          btnStud.classList.remove('hidden');
        } else {
          btnStud.classList.add('hidden');
        }
      }
    }

