                    <input type="file" id="conversatorio-revistaPdf-file" accept="application/pdf" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-3 file:py-2 file:rounded-lg file:text-[10px] file:font-bold file:cursor-pointer bg-slate-50 border border-slate-100 rounded-xl py-1.5 px-2 text-slate-700 mb-1">
                    <span id="conversatorio-revistaPdf-status" class="text-[9px] text-emerald-600 font-bold hidden mb-1 flex items-center gap-1"><i class="fa-solid fa-circle-check"></i> <span>Archivo PDF seleccionado</span></span>
                    <input type="text" name="revistaPdf" id="conversatorio-revistaPdf" placeholder="O ingresa URL de la Revista PDF" class="bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-[10px] outline-none">
                  </div>
                  <div class="flex flex-col gap-1.5">
                    <label class="text-xs font-bold text-slate-700">URL de Flipbook Interactivo (Heyzine, etc)</label>
                    <input type="url" name="revistaFlipbook" id="conversatorio-revistaFlipbook" placeholder="https://heyzine.com/flip-book/..." class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none font-sans">
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
