          role: currentUsersRole,
          status: currentUsersStatus,
          search: currentUsersSearch
        });

        const res = await fetch('/api/admin/users?' + query.toString());
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const json = await res.json();
        if (!json.success) return;

        const users = json.data || [];
        const pag = json.pagination || {};

        if (users.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-12 text-center text-slate-400 font-semibold">No se encontraron usuarios con los filtros seleccionados.</td></tr>`;
