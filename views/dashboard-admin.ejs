    // Modal Resource actions
    function openResourceModal(lessonId) {
      document.getElementById('resource-modal-lessonId').value = lessonId;
      document.getElementById('resource-modal-nombre').value = '';
      document.getElementById('resource-modal-file').value = '';
      document.getElementById('resource-modal-base64').value = '';
      document.getElementById('resource-modal-url').value = '';
      document.getElementById('curriculum-resource-modal').classList.remove('hidden');
    }
    function closeResourceModal() {
      document.getElementById('curriculum-resource-modal').classList.add('hidden');
      document.getElementById('resource-modal-form').reset();
    }
    
    // File reader to Base64
    document.getElementById('resource-modal-file').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          document.getElementById('resource-modal-base64').value = evt.target.result;
        };
        reader.readAsDataURL(file);
      }
    });

    document.getElementById('resource-modal-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const lessonId = document.getElementById('resource-modal-lessonId').value;
      const nombre = document.getElementById('resource-modal-nombre').value;
      const fileBase64 = document.getElementById('resource-modal-base64').value;
      const externalUrl = document.getElementById('resource-modal-url').value;

      const url = fileBase64 || externalUrl;
      if (!url) {
        alert('Debe adjuntar un archivo o ingresar una URL.');
        return;
      }

      try {
        const res = await fetch(`/api/cursos/${currentCursoId}/resources`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lessonId, nombre, url })
        });
        const data = await res.json();
        if (data.success) {
          closeResourceModal();
          loadCurriculum();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (err) {
        console.error(err);
        alert('Error de red al guardar recurso.');
      }
    });

