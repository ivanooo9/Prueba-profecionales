  <!-- Modal de Confirmación Elegante del Sistema -->
  <div id="modalConfirmacionSistema" class="fixed inset-0 z-[100] bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-7 relative shadow-2xl space-y-4 animate-in fade-in zoom-in-95 duration-200 border border-slate-100">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
          <i id="sysConfirmIcon" class="fa-solid fa-circle-question text-blue-600 text-lg"></i>
          <span id="sysConfirmTitle">Confirmación de Acción</span>
        </h3>
        <button type="button" onclick="closeSysConfirmModal()" class="text-slate-400 text-lg hover:text-slate-600 cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <p id="sysConfirmMessage" class="text-xs text-slate-600 leading-relaxed font-semibold"></p>

      <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
        <button type="button" onclick="closeSysConfirmModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs cursor-pointer transition">
          Cancelar
        </button>
        <button type="button" id="sysConfirmSubmitBtn" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5">
          <i class="fa-solid fa-check"></i> <span id="sysConfirmBtnText">Confirmar</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    let activeConfirmForm = null;

    function abrirConfirmacionModal(options) {
      document.getElementById('sysConfirmTitle').innerText = options.title || 'Confirmar Acción';
      document.getElementById('sysConfirmMessage').innerText = options.message || '¿Deseas proceder con esta acción?';
      document.getElementById('sysConfirmIcon').className = options.icon || 'fa-solid fa-circle-question text-blue-600 text-lg';
      document.getElementById('sysConfirmBtnText').innerText = options.btnText || 'Confirmar';
      
      const submitBtn = document.getElementById('sysConfirmSubmitBtn');
      submitBtn.className = options.btnClass || 'px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5';
      
      activeConfirmForm = options.form || null;

      const modal = document.getElementById('modalConfirmacionSistema');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeSysConfirmModal() {
      const modal = document.getElementById('modalConfirmacionSistema');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      activeConfirmForm = null;
    }

    function confirmToggleReferralStatus(form, isSuspended, email) {
      abrirConfirmacionModal({
        title: isSuspended ? 'Reactivar Cuenta de Referido' : 'Suspender Cuenta de Referido',
        message: '¿Estás seguro de ' + (isSuspended ? 'reactivar' : 'suspender') + ' la cuenta del referido ' + email + '?',
        icon: isSuspended ? 'fa-solid fa-user-check text-emerald-600 text-lg' : 'fa-solid fa-user-xmark text-rose-600 text-lg',
        btnText: isSuspended ? 'Reactivar Cuenta' : 'Suspender Cuenta',
        btnClass: isSuspended ? 'px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5' : 'px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5',
        form: form
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('sysConfirmSubmitBtn')?.addEventListener('click', function() {
        if (activeConfirmForm) {
          const f = activeConfirmForm;
          activeConfirmForm = null;
          closeSysConfirmModal();
          f.submit();
        }
      });
    });

    function openAdminCreateReferralModal() {
      document.getElementById('modalAdminCreateReferral').classList.remove('hidden');
      document.getElementById('modalAdminCreateReferral').classList.add('flex');
    }
    function closeAdminCreateReferralModal() {
      document.getElementById('modalAdminCreateReferral').classList.add('hidden');
      document.getElementById('modalAdminCreateReferral').classList.remove('flex');
    }
    function switchReferralSubTab(subTabName) {
      const tabs = ['cuentas', 'ventas', 'comisiones', 'retiros'];
      tabs.forEach(t => {
        const pane = document.getElementById('ref-subtab-' + t);
        const btn = document.getElementById('ref-subtab-btn-' + t);
        if (pane) {
          if (t === subTabName) {
            pane.classList.remove('hidden');
          } else {
            pane.classList.add('hidden');
          }
        }
        if (btn) {
          if (t === subTabName) {
            btn.className = 'px-4 py-2 rounded-xl bg-blue-600 text-white shadow-sm cursor-pointer';
          } else {
            btn.className = 'px-4 py-2 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 cursor-pointer';
          }
        }
      });
    }

    const systemConversatorios = <%- JSON.stringify((typeof conversatorios !== 'undefined' && Array.isArray(conversatorios)) ? conversatorios.filter(c => c && (!c.gratuito || (c.precio && c.precio > 0))).map(c => ({ id: c.id, titulo: c.titulo, precio: c.precio })) : []) %>;
    const systemCursos = <%- JSON.stringify((typeof cursos !== 'undefined' && Array.isArray(cursos)) ? cursos.filter(c => c && (!c.gratuito || (c.precio && c.precio > 0))).map(c => ({ id: c.id, titulo: c.titulo, precio: c.precio })) : []) %>;
    const systemPlans = <%- JSON.stringify((typeof plans !== 'undefined' && Array.isArray(plans)) ? plans.filter(p => p && p.precio > 0).map(p => ({ id: p.id, nombre: p.nombre, precio: p.precio })) : []) %>;
    const systemPromotionPlans = <%- JSON.stringify((typeof promotionPlans !== 'undefined' && Array.isArray(promotionPlans)) ? promotionPlans.filter(p => p && (p.precio || 0) >= 0).map(p => ({ id: p.id, nombre: p.nombre, precio: p.precio })) : []) %>;

    function updateCommissionProductOptions() {
      const typeSelect = document.getElementById('comm-product-type');
      const productSelect = document.getElementById('comm-product-id');
      if (!typeSelect || !productSelect) return;

      const type = typeSelect.value;
      productSelect.innerHTML = '';

      if (type === 'CONVERSATORIO') {
        productSelect.innerHTML = '<option value="">-- Todos los Conversatorios de Pago --</option>';
        if (systemConversatorios.length === 0) {
          productSelect.innerHTML += '<option value="" disabled>(No existen conversatorios pagados)</option>';
        } else {
          systemConversatorios.forEach(c => {
            productSelect.innerHTML += `<option value="${c.id}">Conversatorio: ${c.titulo} ($${Number(c.precio || 0).toFixed(2)})</option>`;
          });
        }
      } else if (type === 'CURSO') {
        productSelect.innerHTML = '<option value="">-- Todos los Cursos de Pago --</option>';
        if (systemCursos.length === 0) {
          productSelect.innerHTML += '<option value="" disabled>(No existen cursos pagados)</option>';
        } else {
          systemCursos.forEach(c => {
            productSelect.innerHTML += `<option value="${c.id}">Curso: ${c.titulo} ($${Number(c.precio || 0).toFixed(2)})</option>`;
          });
        }
      } else if (type === 'PLAN_AFILIACION') {
        productSelect.innerHTML = '<option value="">-- Todos los Planes de Afiliación --</option>';
        systemPlans.forEach(p => {
          productSelect.innerHTML += `<option value="${p.id}">Plan: ${p.nombre} ($${Number(p.precio || 0).toFixed(2)})</option>`;
        });
      } else if (type === 'PLAN_PROMOCION') {
        productSelect.innerHTML = '<option value="">-- Todos los Planes de Promoción --</option>';
        systemPromotionPlans.forEach(p => {
          productSelect.innerHTML += `<option value="${p.id}">Promoción: ${p.nombre} ($${Number(p.precio || 0).toFixed(2)})</option>`;
        });
      }
    }

    // University & Institute Admin Helpers
    function openAddUniversityModal() {
      document.getElementById('university-modal-title').innerText = "Nueva Universidad o Instituto Superior";
      document.getElementById('university-form').action = "/dashboard/admin/universities";
      document.getElementById('uni-nombre').value = "";
      document.getElementById('uni-siglas').value = "";
      document.getElementById('uni-tipo').value = "UNIVERSIDAD";
      document.getElementById('uni-provincia').value = "";
      document.getElementById('uni-ciudad').value = "";
      document.getElementById('uni-sitioWeb').value = "";
      document.getElementById('uni-orden').value = "0";
      document.getElementById('university-modal').classList.remove('hidden');
    }

    function openEditUniversityModal(uni) {
      document.getElementById('university-modal-title').innerText = "Editar Universidad o Instituto";
      document.getElementById('university-form').action = "/dashboard/admin/universities/" + uni.id + "/edit";
      document.getElementById('uni-nombre').value = uni.nombre || "";
      document.getElementById('uni-siglas').value = uni.siglas || "";
      document.getElementById('uni-tipo').value = uni.tipo || "UNIVERSIDAD";
      document.getElementById('uni-provincia').value = uni.provincia || "";
      document.getElementById('uni-ciudad').value = uni.ciudad || "";
      document.getElementById('uni-sitioWeb').value = uni.sitioWeb || "";
      document.getElementById('uni-orden').value = uni.orden || 0;
      document.getElementById('university-modal').classList.remove('hidden');
    }

    function closeUniversityModal() {
      document.getElementById('university-modal').classList.add('hidden');
    }

    function closeAdminAlert() {
      const container = document.getElementById('admin-alert-container');
      if (container) container.classList.add('hidden');
    }

    document.addEventListener('DOMContentLoaded', function() {
      updateCommissionProductOptions();

      // Handling query parameters for admin alerts
      const urlParams = new URLSearchParams(window.location.search);
      const successParam = urlParams.get('success');
      const errorParam = urlParams.get('error');

      const alertContainer = document.getElementById('admin-alert-container');
      const alertBox = document.getElementById('admin-alert');
      const alertIcon = document.getElementById('admin-alert-icon');
      const alertMessage = document.getElementById('admin-alert-message');

      const successMessages = {
        'transition_approved': '¡Solicitud de cambio de rol APROBADA! Los datos del estudiante se han migrado al Perfil Profesional.',
        'transition_rejected': 'La solicitud de cambio de rol ha sido rechazada.',
        'student_deleted': 'Estudiante eliminado permanentemente. Su correo y cédula han sido liberados.',
        'student_status_active': 'Cuenta de estudiante reactivada exitosamente.',
        'student_status_suspended': 'Cuenta de estudiante suspendida.',
        'professional_approved': 'Perfil profesional aprobado con éxito.',
        'professional_rejected': 'Perfil profesional rechazado.',
        'university_created': 'Institución educativa creada correctamente.',
        'university_updated': 'Institución educativa actualizada.',
        'university_deleted': 'Institución educativa eliminada.',
        'university_toggled': 'Estado de institución actualizado.',
        'user_created': '¡Nuevo usuario registrado con éxito en la plataforma!',
        'impersonation_ended': 'Modo Soporte Técnico finalizado con éxito. Has regresado a tu cuenta de Administrador.',
        'sessions_revoked': 'Todas las sesiones activas del usuario fueron revocadas correctamente.'
      };

      if ((successParam || errorParam) && alertContainer && alertBox && alertIcon && alertMessage) {
        alertContainer.classList.remove('hidden');
        if (successParam) {
          alertBox.className = "flex items-center gap-3 p-4 rounded-2xl border border-emerald-200 bg-emerald-50 text-emerald-900 font-sans text-xs font-bold transition shadow-sm";
          alertIcon.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>';
          alertMessage.innerText = successMessages[successParam] || successParam.replace(/_/g, ' ');
        } else if (errorParam) {
          alertBox.className = "flex items-center gap-3 p-4 rounded-2xl border border-rose-200 bg-rose-50 text-rose-900 font-sans text-xs font-bold transition shadow-sm";
          alertIcon.innerHTML = '<i class="fa-solid fa-circle-exclamation text-rose-600 text-base"></i>';
          alertMessage.innerText = decodeURIComponent(errorParam);
        }
      }
    });

    function switchAccountSubtab(subtabName) {
      const subtabs = ['clientes', 'estudiantes', 'profesionales', 'solicitudes', 'referidos'];
      subtabs.forEach(st => {
        const pane = document.getElementById(`subtab-cuentas-${st}`);
        const btn = document.getElementById(`btn-subtab-${st}`);
        if (pane) {
          if (st === subtabName) {
            pane.classList.remove('hidden');
          } else {
            pane.classList.add('hidden');
          }
        }
        if (btn) {
          if (st === subtabName) {
            btn.className = "px-4 py-2.5 font-black text-xs rounded-xl transition bg-[#0A3C84] text-white shadow-sm flex items-center gap-2 cursor-pointer";
          } else {
            btn.className = "px-4 py-2.5 font-bold text-xs rounded-xl transition bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center gap-2 cursor-pointer";
          }
        }
      });
    }

    function openChangeRoleModal(userId, userName, currentRoleId) {
      const modal = document.getElementById('change-role-modal');
      const form = document.getElementById('change-role-form');
      const nameDiv = document.getElementById('change-role-user-name');
      const select = document.getElementById('change-role-select');
      
      if (form) form.action = `/dashboard/admin/users/${userId}/change-role`;
      if (nameDiv) nameDiv.textContent = userName;
      if (select && currentRoleId) select.value = currentRoleId;
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.style.display = 'flex';
      }
    }

    function closeChangeRoleModal() {
      const modal = document.getElementById('change-role-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.style.display = 'none';
      }
    }

    function showAdminToast(title, message, isSuccess = true) {
      let toast = document.getElementById('admin-global-toast');
      if (toast) toast.remove();

      toast = document.createElement('div');
      toast.id = 'admin-global-toast';
      toast.className = `fixed top-5 right-5 z-[9999] max-w-md w-full p-4 rounded-2xl shadow-2xl transition-all duration-300 border font-sans text-xs font-bold ${
        isSuccess ? 'bg-slate-900 text-white border-emerald-500/50' : 'bg-rose-950 text-white border-rose-500/50'
      } flex items-start gap-3`;

      toast.innerHTML = `
        <div class="w-8 h-8 rounded-full ${isSuccess ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'} flex items-center justify-center shrink-0 text-base">
          <i class="fa-solid ${isSuccess ? 'fa-circle-check text-emerald-400' : 'fa-triangle-exclamation text-rose-400'}"></i>
        </div>
        <div class="flex-1">
          <h4 class="font-extrabold text-sm ${isSuccess ? 'text-emerald-400' : 'text-rose-300'} mb-0.5">${title}</h4>
          <p class="text-slate-200 font-medium leading-relaxed">${message}</p>
        </div>
        <button onclick="document.getElementById('admin-global-toast').remove()" class="text-slate-400 hover:text-white transition cursor-pointer">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      `;

      document.body.appendChild(toast);

      setTimeout(() => {
        const activeToast = document.getElementById('admin-global-toast');
        if (activeToast) {
          activeToast.style.opacity = '0';
          setTimeout(() => activeToast.remove(), 300);
        }
      }, 7000);
    }
    window.showAdminToast = showAdminToast;

    function openResetPasswordModal(userId, userName, userEmail) {
      const modal = document.getElementById('reset-password-modal');
      const form = document.getElementById('reset-password-form');
      const nameDiv = document.getElementById('reset-password-user-name');
      const emailDiv = document.getElementById('reset-password-user-email');
      const input = document.getElementById('reset-password-input');

      if (form) form.action = `/dashboard/admin/users/${userId}/reset-password`;
      if (nameDiv) nameDiv.textContent = userName;
      if (emailDiv) emailDiv.textContent = userEmail;
      if (input) input.value = '';
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.style.display = 'flex';
      }
    }
    window.openResetPasswordModal = openResetPasswordModal;

    function closeResetPasswordModal() {
      const modal = document.getElementById('reset-password-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.style.display = 'none';
      }
    }
    window.closeResetPasswordModal = closeResetPasswordModal;

    function openSendTempAccessModal(userId, userName, userEmail, userRole) {
      const modal = document.getElementById('send-temp-access-modal');
      const form = document.getElementById('send-temp-access-form');
      const nameDiv = document.getElementById('send-temp-access-user-name');
      const emailDiv = document.getElementById('send-temp-access-user-email');
      const input = document.getElementById('send-temp-access-input');

      if (form) form.action = `/dashboard/admin/users/${userId}/send-temporary-access`;
      if (nameDiv) nameDiv.textContent = userName;
      if (emailDiv) emailDiv.textContent = userEmail + (userRole ? ` (${userRole})` : '');
      if (input) input.value = 'TEMP-' + Math.random().toString(36).substring(2, 10).toUpperCase();
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.style.display = 'flex';
      }
    }
    window.openSendTempAccessModal = openSendTempAccessModal;

    function closeSendTempAccessModal() {
      const modal = document.getElementById('send-temp-access-modal');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.style.display = 'none';
      }
    }
    window.closeSendTempAccessModal = closeSendTempAccessModal;

    // Attach AJAX Submit Handlers for Instant User Feedback
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Check URL parameters for alerts
      const urlParams = new URLSearchParams(window.location.search);
      const successMsg = urlParams.get('success');
      const errorMsg = urlParams.get('error');

      if (successMsg) {
        let cleanSuccess = successMsg;
        if (successMsg === 'password_reset_success') cleanSuccess = 'Contraseña restablecida y accesos enviados por correo.';
        if (successMsg === 'user_created') cleanSuccess = 'Usuario creado exitosamente con credenciales enviadas por correo.';
        showAdminToast('¡Operación Exitosa!', cleanSuccess, true);
      } else if (errorMsg) {
        showAdminToast('Error en la Operación', errorMsg, false);
      }

      // 2. Handle send-temp-access-form AJAX submission
      const tempForm = document.getElementById('send-temp-access-form');
      if (tempForm) {
        tempForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = tempForm.querySelector('button[type="submit"]');
          const input = document.getElementById('send-temp-access-input');
          const actionUrl = tempForm.action;
          const customPassword = input ? input.value : '';

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Enviando correo de accesos...';
          }

          try {
            const res = await fetch(actionUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({ customPassword, ajax: true })
            });

            const data = await res.json();
            if (res.ok && data.success) {
              closeSendTempAccessModal();
              showAdminToast('¡Accesos Enviados por Correo!', data.message || `Clave temporal asignada: ${data.tempPassword}`, true);
            } else {
              showAdminToast('Error al Enviar Accesos', data.error || 'No se pudo enviar el correo de accesos.', false);
            }
          } catch (err) {
            console.error('Error submitting send-temp-access-form:', err);
            showAdminToast('Error de Red', 'No se pudo conectar con el servidor para enviar accesos.', false);
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Enviar Accesos por Email';
            }
          }
        });
      }

      // 3. Handle reset-password-form AJAX submission
      const resetForm = document.getElementById('reset-password-form');
      if (resetForm) {
        resetForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = resetForm.querySelector('button[type="submit"]');
          const input = document.getElementById('reset-password-input');
          const actionUrl = resetForm.action;
          const newPassword = input ? input.value : '';

          if (!newPassword || newPassword.trim().length < 6) {
            showAdminToast('Contraseña Inválida', 'La contraseña debe tener al menos 6 caracteres.', false);
            return;
          }

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Actualizando y notificando...';
          }

          try {
            const res = await fetch(actionUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'Accept': 'application/json'
              },
              body: new URLSearchParams({ newPassword })
            });

            closeResetPasswordModal();
            showAdminToast('¡Clave Restablecida!', 'Contraseña actualizada y correo de notificación enviado.', true);
          } catch (err) {
            console.error('Error submitting reset-password-form:', err);
            showAdminToast('Error al Restablecer', 'Fallo de conexión al actualizar contraseña.', false);
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = '<i class="fa-solid fa-[#0a66c2] fa-key"></i> Guardar y Notificar';
            }
          }
        });
      }
    });

    function filterAllAccountsGlobal() {
      const query = (document.getElementById('global-accounts-search')?.value || '').toLowerCase().trim();
      const clearBtn = document.getElementById('clear-global-search-btn');
      const countBadge = document.getElementById('global-search-count-badge');
      const countText = document.getElementById('global-search-count-text');

      if (clearBtn) {
        if (query) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }

      let totalMatches = 0;
      const subtabs = ['clientes', 'estudiantes', 'profesionales', 'referidos', 'solicitudes'];

      subtabs.forEach(st => {
        const rows = document.querySelectorAll(`#${st}-tbody tr`);
        rows.forEach(row => {
          const name = (row.getAttribute('data-name') || '').toLowerCase();
          const email = (row.getAttribute('data-email') || '').toLowerCase();
          const fullText = (row.innerText || '').toLowerCase();

          const matches = !query || name.includes(query) || email.includes(query) || fullText.includes(query);
          if (matches) {
            row.classList.remove('hidden');
            totalMatches++;
          } else {
            row.classList.add('hidden');
          }
        });
      });

      if (countBadge && countText) {
        if (query) {
          countBadge.classList.remove('hidden');
          countText.innerText = `${totalMatches} Coincidencia${totalMatches === 1 ? '' : 's'}`;
        } else {
          countBadge.classList.add('hidden');
        }
      }
    }

    function clearGlobalAccountsSearch() {
      const input = document.getElementById('global-accounts-search');
      if (input) {
        input.value = '';
        filterAllAccountsGlobal();
        input.focus();
      }
    }

    window.filterAllAccountsGlobal = filterAllAccountsGlobal;
    window.clearGlobalAccountsSearch = clearGlobalAccountsSearch;

    function filterClientesTable() {
      const query = (document.getElementById('search-clientes-input')?.value || document.getElementById('global-accounts-search')?.value || '').toLowerCase().trim();
      const statusFilter = document.getElementById('filter-clientes-status')?.value || 'all';
      const rows = document.querySelectorAll('#clientes-tbody tr');

      rows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        const email = row.getAttribute('data-email') || '';
        const status = row.getAttribute('data-status') || '';

        const matchesQuery = !query || name.includes(query) || email.includes(query);
        const matchesStatus = statusFilter === 'all' || status === statusFilter;

        if (matchesQuery && matchesStatus) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    }
  </script>

