    function setupBase64FileLoader(fileInputId, hiddenInputId, previewImgId, placeholderId) {
      const fileInput = document.getElementById(fileInputId);
      const hiddenInput = document.getElementById(hiddenInputId);
      if (!fileInput) return;

      fileInput.addEventListener('change', function(e) {
        const file = fileInput.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(evt) {
          if (hiddenInput) hiddenInput.value = evt.target.result;
          if (previewImgId) {
            const previewImg = document.getElementById(previewImgId);
            if (previewImg) {
              previewImg.src = evt.target.result;
              previewImg.classList.remove('hidden');
            }
          }
          if (placeholderId) {
            const placeholder = document.getElementById(placeholderId);
            if (placeholder) {
              placeholder.classList.add('hidden');
            }
          }
          const statusEl = document.getElementById(fileInputId.replace('-file', '-status'));
          if (statusEl) {
            statusEl.innerHTML = '<i class="fa-solid fa-circle-check"></i> <span>' + file.name + ' (' + (file.size / (1024 * 1024)).toFixed(2) + ' MB) listo para guardar</span>';
            statusEl.classList.remove('hidden');
          }
        };
        reader.readAsDataURL(file);
      });
    }

