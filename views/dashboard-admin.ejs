            </div>

            <!-- External Credentials Card (Cloudinary & Resend) -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5 text-left">
              <h3 class="text-sm font-extrabold text-slate-900 border-b border-slate-50 pb-2">
                <i class="fa-solid fa-key text-amber-500 mr-1.5"></i> Credenciales de Servicios Externos
              </h3>
              <div class="space-y-4">
                <div class="border-b border-slate-50 pb-4">
                  <h4 class="text-xs font-bold text-slate-800 mb-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-cloud text-blue-500"></i> Almacenamiento en la Nube (Cloudinary)
                  </h4>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Cloud Name</label>
                      <input type="text" name="cloudinaryCloudName" value="<%= systemConfig.cloudinaryCloudName || '' %>" placeholder="dnzkwg8qv" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">API Key</label>
                      <input type="text" name="cloudinaryApiKey" value="<%= systemConfig.cloudinaryApiKey || '' %>" placeholder="515919775771587" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">API Secret</label>
                      <div class="relative mt-1">
                        <input type="password" id="cloudinaryApiSecret" name="cloudinaryApiSecret" value="<%= systemConfig.cloudinaryApiSecret || '' %>" placeholder="••••••••••••••••" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 pr-10 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition text-slate-800">
                        <button type="button" onclick="togglePasswordVisibility('cloudinaryApiSecret', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition focus:outline-none flex items-center justify-center">
                          <i class="fa-solid fa-eye text-xs"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-800 mb-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-paper-plane text-emerald-500"></i> Proveedor de Correo (Resend & SMTP Tradicional)
                  </h4>

                  <!-- Resend API Settings -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Resend API Key</label>
                      <div class="relative mt-1">
                        <input type="password" id="resendApiKey" name="resendApiKey" value="<%= systemConfig.resendApiKey || '' %>" placeholder="••••••••••••••••" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 pr-10 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition text-slate-800">
                        <button type="button" onclick="togglePasswordVisibility('resendApiKey', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition focus:outline-none flex items-center justify-center">
                          <i class="fa-solid fa-eye text-xs"></i>
                        </button>
                      </div>
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Correo Remitente (From)</label>
                      <input type="email" name="resendFromEmail" value="<%= systemConfig.resendFromEmail || '' %>" placeholder="onboarding@resend.dev" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                  </div>

                  <!-- Servidor SMTP Tradicional (Fallback / Alternativo) -->
                  <div class="mt-4 pt-3 border-t border-slate-100 space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-extrabold text-slate-700 flex items-center gap-1.5">
                        <i class="fa-solid fa-server text-blue-600"></i> Servidor SMTP Tradicional (Hostinger, cPanel, Gmail, Outlook, etc.)
                      </span>
                      <span class="text-[9px] bg-blue-50 text-blue-700 font-extrabold px-2 py-0.5 rounded-full">Alternativa / Fallback</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                      <div class="md:col-span-2">
                        <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Servidor SMTP (Host)</label>
                        <input type="text" name="smtpHost" value="<%= systemConfig.smtpHost || '' %>" placeholder="smtp.gmail.com o mail.tu-dominio.com" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2 px-3 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                      </div>
                      <div>
                        <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Puerto SMTP</label>
                        <input type="number" name="smtpPort" value="<%= systemConfig.smtpPort || 587 %>" placeholder="587" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2 px-3 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                      </div>
                      <div class="flex items-end pb-1.5">
                        <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700">
                          <input type="checkbox" name="smtpSecure" value="true" <%= systemConfig.smtpSecure ? 'checked' : '' %> class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500">
                          <span>Usar SSL/TLS (Port 465)</span>
                        </label>
                      </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                      <div>
                        <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Usuario SMTP (Email / Login)</label>
                        <input type="text" name="smtpUser" value="<%= systemConfig.smtpUser || '' %>" placeholder="notificaciones@profesionales.ec" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2 px-3 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                      </div>
                      <div>
                        <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Contraseña SMTP</label>
                        <div class="relative mt-1">
                          <input type="password" id="smtpPass" name="smtpPass" value="<%= systemConfig.smtpPass || '' %>" placeholder="••••••••••••••••" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2 px-3 pr-9 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition text-slate-800">
                          <button type="button" onclick="togglePasswordVisibility('smtpPass', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition focus:outline-none">
                            <i class="fa-solid fa-eye text-xs"></i>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Test Email Tool -->
                  <div class="bg-gradient-to-br from-emerald-50/80 to-teal-50/50 border border-emerald-200/80 p-5 rounded-2xl mt-5 space-y-4 shadow-sm">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-black text-emerald-950 flex items-center gap-2">
                        <i class="fa-solid fa-paper-plane text-emerald-600 text-sm"></i> Prueba Rápida de Envío de Correo (Diagnóstico Live)
                      </span>
                      <span class="text-[10px] bg-emerald-100/80 text-emerald-800 font-extrabold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                        Gmail API / SMTP Active
                      </span>
                    </div>

                    <p class="text-[11px] text-emerald-800/80 font-medium">
                      Prueba el envío en tiempo real hacia cualquier correo electrónico para verificar plantillas, entrega y conectividad sin salir del panel.
                    </p>

                    <div id="quick-email-test-box-container" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
                      <select id="quickEmailType" class="bg-white border border-emerald-200 rounded-xl py-2 px-3 text-xs font-bold text-slate-800 outline-none focus:border-emerald-600 transition">
                        <option value="standard">📩 Correo Estándar (Diagnóstico)</option>
                        <option value="welcome">🚀 Plantilla: Bienvenida de Cuenta</option>
                        <option value="reset">🔐 Plantilla: Restablecer Contraseña</option>
                        <option value="appointment">📅 Plantilla: Notificación de Cita</option>
                      </select>

                      <input type="email" id="quickRecipientEmail" placeholder="mateocastillo039@gmail.com..." class="flex-grow bg-white border border-emerald-200 rounded-xl py-2 px-3.5 text-xs font-semibold text-slate-800 outline-none focus:border-emerald-600 transition">

                      <button type="button" onclick="executeQuickEmailTest(event)" id="btn-quick-email-test" class="bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black px-5 py-2 rounded-xl text-xs shadow-md transition whitespace-nowrap cursor-pointer flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane" id="quick-email-icon"></i>
                        <span>Enviar Prueba</span>
                      </button>
                    </div>

                    <!-- Real-time Feedback Box -->
                    <div id="quick-email-result-box" class="hidden p-3.5 rounded-xl text-xs font-bold transition-all duration-300"></div>
                  </div>

                  <script>
                    async function executeQuickEmailTest(event) {
                      event.preventDefault();
                      const emailInput = document.getElementById('quickRecipientEmail');
                      const typeSelect = document.getElementById('quickEmailType');
                      const btn = document.getElementById('btn-quick-email-test');
                      const icon = document.getElementById('quick-email-icon');
                      const resultBox = document.getElementById('quick-email-result-box');

                      const email = emailInput ? emailInput.value.trim() : '';
                      const emailType = typeSelect ? typeSelect.value : 'standard';

                      if (!email || !email.includes('@')) {
                        resultBox.className = 'p-3.5 rounded-xl text-xs font-bold bg-rose-50 border border-rose-200 text-rose-800 flex items-center gap-2';
                        resultBox.innerHTML = '<i class="fa-solid fa-circle-exclamation text-rose-600 text-sm"></i> Por favor ingresa un correo electrónico válido.';
                        resultBox.classList.remove('hidden');
                        return;
                      }

                      // Set Loading State
                      btn.disabled = true;
                      btn.classList.add('opacity-75');
                      icon.className = 'fa-solid fa-spinner fa-spin';

                      resultBox.className = 'p-3.5 rounded-xl text-xs font-bold bg-blue-50 border border-blue-200 text-blue-800 flex items-center gap-2';
                      resultBox.innerHTML = '<i class="fa-solid fa-arrows-rotate fa-spin text-blue-600 text-sm"></i> Enviando correo de prueba a <strong>' + email + '</strong>...';
                      resultBox.classList.remove('hidden');

                      try {
                        const response = await fetch('/api/admin/test-email', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({ email, emailType })
                        });

                        const data = await response.json().catch(() => ({}));

                        if (response.ok && data.success) {
                          resultBox.className = 'p-4 rounded-xl text-xs font-bold bg-emerald-100/90 border border-emerald-300 text-emerald-950 flex flex-col gap-1 shadow-sm';
                          resultBox.innerHTML = `
                            <div class="flex items-center gap-2 text-emerald-900 font-black">
                              <i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>
                              <span>${data.message || '¡Correo enviado exitosamente!'}</span>
                            </div>
                            <div class="text-[11px] text-emerald-800 font-medium pl-6">
                              ID de Mensaje: <code class="bg-white/80 px-1.5 py-0.5 rounded border border-emerald-200 font-mono text-[10px]">${data.messageId || 'N/A'}</code>
                            </div>
                          `;
                        } else {
                          resultBox.className = 'p-4 rounded-xl text-xs font-bold bg-rose-50 border border-rose-200 text-rose-900 flex flex-col gap-1 shadow-sm';
                          resultBox.innerHTML = `
                            <div class="flex items-center gap-2 text-rose-900 font-black">
                              <i class="fa-solid fa-triangle-exclamation text-rose-600 text-base"></i>
                              <span>No se pudo entregar el correo de prueba.</span>
                            </div>
                            <div class="text-[11px] text-rose-700 font-medium pl-6">
                              Detalle: ${data.error || 'Verifica la configuración de Gmail API o el correo del destinatario.'}
                            </div>
                          `;
                        }
                      } catch (err) {
                        resultBox.className = 'p-4 rounded-xl text-xs font-bold bg-rose-50 border border-rose-200 text-rose-900 flex items-center gap-2';
                        resultBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-rose-600 text-base"></i> Error de conexión al procesar el envío.';
                      } finally {
                        btn.disabled = false;
                        btn.classList.remove('opacity-75');
                        icon.className = 'fa-solid fa-paper-plane';
                      }
                    }
                  </script>
                </div>
                <div class="border-t border-slate-100 pt-4 mt-4">
                  <h4 class="text-xs font-bold text-slate-800 mb-3 flex items-center gap-1.5">
                    <i class="fa-solid fa-brain text-purple-500"></i> Inteligencia Artificial (Google Gemini)
                  </h4>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Gemini API Key</label>
                      <div class="relative mt-1">
                        <input type="password" id="geminiApiKey" name="geminiApiKey" value="<%= systemConfig.geminiApiKey || '' %>" placeholder="Escribe tu Gemini API Key..." class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 pr-10 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition text-slate-800">
                        <button type="button" onclick="togglePasswordVisibility('geminiApiKey', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition focus:outline-none flex items-center justify-center">
                          <i class="fa-solid fa-eye text-xs"></i>
                        </button>
                      </div>
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Nombre de Proyecto (ID)</label>
                      <input type="text" name="geminiProjectName" value="<%= systemConfig.geminiProjectName || '' %>" placeholder="projects/459724729976" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                    <div>
                      <label class="text-[9px] font-extrabold uppercase tracking-wider text-slate-400">Número de Proyecto</label>
                      <input type="text" name="geminiProjectNumber" value="<%= systemConfig.geminiProjectNumber || '' %>" placeholder="459724729976" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 px-3.5 text-xs font-medium outline-none focus:bg-white focus:border-blue-500 transition mt-1 text-slate-800">
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <script>
              function togglePasswordVisibility(inputId, button) {
                const input = document.getElementById(inputId);
                const icon = button.querySelector('i');
                if (input.type === 'password') {
                  input.type = 'text';
                  icon.classList.remove('fa-eye');
                  icon.classList.add('fa-eye-slash');
                } else {
                  input.type = 'password';
                  icon.classList.remove('fa-eye-slash');
                  icon.classList.add('fa-eye');
                }
              }
            </script>
          </div>

          <!-- Col 3: Sidebar typography & actions -->
          <div class="space-y-6">
            <!-- Typography Card -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4 text-left">
              <h3 class="text-sm font-extrabold text-slate-900 border-b border-slate-50 pb-2">
                <i class="fa-solid fa-font text-emerald-500 mr-1.5"></i> Tipografías
              </h3>

              <div class="space-y-3">
                <!-- Body Font Select -->
                <div>
                  <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Tipografía de Cuerpo (Texto)</label>
                  <select name="fontFamily" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-3.5 text-xs font-bold mt-1 focus:bg-white focus:border-blue-500 outline-none transition cursor-pointer text-slate-800">
                    <% 
                      const fonts = [
                        'Outfit', 'Inter', 'Roboto', 'Montserrat', 'Poppins', 
                        'Open Sans', 'Lato', 'Lora', 'Playfair Display', 'Geist', 
                        'Plus Jakarta Sans', 'DM Sans', 'Sora', 'Space Grotesk', 
                        'Fira Sans', 'Cabin', 'Merriweather', 'Nunito', 'Quicksand', 
                        'Ubuntu', 'Work Sans', 'Cinzel', 'Syne', 'Manrope', 
                        'Lexend', 'Kanit', 'Rubik', 'Oswald', 'Raleway', 'Cardo'
                      ];
                      fonts.forEach(f => {
                        const selected = (systemConfig.fontFamily === f) ? 'selected' : '';
                    %>
                      <option value="<%= f %>" <%= selected %>><%= f %></option>
                    <% }); %>
                  </select>
                </div>

                <!-- Heading Font Select -->
                <div>
                  <label class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Tipografía de Títulos</label>
                  <select name="headingFontFamily" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-3.5 text-xs font-bold mt-1 focus:bg-white focus:border-blue-500 outline-none transition cursor-pointer text-slate-800">
                    <% 
                      fonts.forEach(f => {
                        const selected = (systemConfig.headingFontFamily === f) ? 'selected' : '';
                    %>
                      <option value="<%= f %>" <%= selected %>><%= f %></option>
                    <% }); %>
                  </select>
                </div>
              </div>

              <!-- Preview Info -->
              <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-100 flex gap-2.5 items-start">
                <i class="fa-solid fa-circle-info text-blue-500 text-sm mt-0.5"></i>
                <p class="text-[10px] text-slate-500 font-semibold leading-relaxed">Las tipografías se cargan en tiempo real desde <b>Google Fonts</b> para asegurar una apariencia premium y rápida.</p>
              </div>
            </div>

            <!-- Submit Button Card -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4">
              <button type="submit" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3.5 rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-xs cursor-pointer">
                <i class="fa-solid fa-floppy-disk text-sm"></i> Guardar Personalización
              </button>
              
              <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider text-center">Los cambios se aplicarán instantáneamente a todo el sitio web.</p>
            </div>
          </div>
        </form>

        <!-- Database Backup Card -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4 text-left">
          <h3 class="text-sm font-extrabold text-slate-900 border-b border-slate-50 pb-2">
            <i class="fa-solid fa-database text-[#0A3C84] mr-1.5"></i> Respaldo de Base de Datos
          </h3>
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <p class="text-xs font-bold text-slate-800">Generar Copia de Seguridad Completa</p>
              <p class="text-[10px] text-slate-450 mt-1 leading-relaxed">Esto generará un archivo SQL completo con todas las tablas, perfiles profesionales, artículos, cursos, usuarios y registros de la plataforma.</p>
            </div>
            <a href="/dashboard/admin/database/backup" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3 px-5 rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-xs text-center cursor-pointer">
              <i class="fa-solid fa-cloud-arrow-down"></i> Descargar Respaldo (SQL)
            </a>
          </div>
        </div>
      </section>



    </main>
  </div>

  <!-- INSPECTION & EDIT MODAL FOR PROFESSIONAL -->
  <div id="inspector-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 items-center justify-center p-4 hidden" style="display: none;">
    <div class="bg-white rounded-3xl w-full max-w-2xl border border-slate-100 shadow-2xl overflow-hidden max-h-[85vh] flex flex-col">
      <!-- Header -->
      <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <div>
          <h3 class="font-extrabold text-sm text-slate-900">Inspección del Perfil del Profesional</h3>
          <p class="text-[10px] text-brand-grayText">Revise y edite la información general y los materiales cargados.</p>
        </div>
        <button onclick="closeInspector()" class="text-slate-400 hover:text-slate-900 text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Scrollable content -->
      <div class="p-6 overflow-y-auto flex flex-col gap-6 text-xs" id="inspector-body">
        
        <!-- Editable details form -->
        <form id="edit-profile-form" action="" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="flex flex-col gap-1">
            <label class="font-bold text-slate-700">Nombre</label>
            <input type="text" name="name" id="insp-name" required class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition">
          </div>
          <div class="flex flex-col gap-1">
            <label class="font-bold text-slate-700">Email</label>
            <input type="email" name="email" id="insp-email" required class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition">
          </div>
          <div class="flex flex-col gap-1">
            <label class="font-bold text-slate-700">Slogan</label>
            <input type="text" name="slogan" id="insp-slogan" class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition">
          </div>
          <div class="flex flex-col gap-1">
            <label class="font-bold text-slate-700">Plan</label>
            <select name="planType" id="insp-plan" class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition">
              <option value="GRATUITO">Gratuito</option>
              <option value="PROFESIONAL">Profesional</option>
              <option value="PREMIUM">Premium</option>
              <option value="VERIFICADO">Verificado</option>
            </select>
          </div>
          <div class="flex flex-col gap-1 md:col-span-2">
            <label class="font-bold text-slate-700">Biografía / Perfil</label>
            <textarea name="bio" id="insp-bio" rows="2" class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition resize-none"></textarea>
          </div>

          <div class="flex flex-col gap-1">
            <label class="font-bold text-slate-700">Provincia</label>
            <input type="text" name="provincia" id="insp-prov" class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition">
          </div>
          <div class="flex flex-col gap-1">
            <label class="font-bold text-slate-700">Ciudad</label>
            <input type="text" name="ciudad" id="insp-city" class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition">
          </div>

          <div class="flex flex-col gap-1">
            <label class="font-bold text-slate-700">Estado de Aprobación</label>
            <select name="status" id="insp-status" class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition">
              <option value="PENDIENTE">PENDIENTE</option>
              <option value="APROBADO">APROBADO</option>
              <option value="RECHAZADO">RECHAZADO</option>
            </select>
          </div>
          <div class="flex items-center gap-2 mt-4">
            <select name="verified" id="insp-verified" class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 outline-none focus:bg-white focus:border-brand-blue transition">
              <option value="false">Sin Verificación</option>
              <option value="true">Verificado (Insignia Azul)</option>
            </select>
          </div>

          <div class="md:col-span-2 flex justify-end gap-2 mt-2">
            <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-6 rounded-xl transition text-xs shadow-md">
              Guardar Cambios del Profesional
            </button>
          </div>
        </form>

        <div class="border-t border-slate-100 pt-5 flex flex-col gap-3">
          <div class="flex items-start justify-between gap-3 flex-col sm:flex-row sm:items-center">
            <div>
              <h4 class="font-extrabold text-sm text-rose-700">Eliminar profesional</h4>
              <p class="text-[10px] text-slate-500">Esto elimina el usuario y su perfil profesional de la base de datos. Úselo solo si está seguro.</p>
            </div>
            <form id="delete-profile-form" action="" method="POST" onsubmit="return confirmDeleteProfessional()" class="w-full sm:w-auto">
              <button type="submit" class="w-full sm:w-auto bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold py-2.5 px-5 rounded-xl transition text-xs border border-rose-200 shadow-sm">
                <i class="fa-solid fa-trash mr-1.5"></i> Eliminar Profesional
              </button>
            </form>
          </div>
        </div>

        <!-- Inspeccionar material subido -->
        <div class="border-t border-slate-100 pt-6 flex flex-col gap-4">
          <h4 class="font-extrabold text-sm text-slate-900 border-b border-slate-50 pb-2">Material Subido por el Profesional</h4>
          
          <!-- Documentos e imágenes -->
          <div>
            <h5 class="font-bold text-xs text-slate-800 mb-2 flex items-center gap-1.5"><i class="fa-solid fa-id-card text-slate-400"></i> Fotos de Cédula</h5>
            <div id="insp-uploaded-images-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
          </div>
          
          <!-- Servicios -->
          <div>
            <h5 class="font-bold text-xs text-slate-800 mb-2 flex items-center gap-1.5"><i class="fa-solid fa-briefcase text-slate-400"></i> Servicios Ofrecidos</h5>
            <div id="insp-services-list" class="flex flex-col gap-2"></div>
          </div>

          <!-- Horarios -->
          <div class="mt-2">
            <h5 class="font-bold text-xs text-slate-800 mb-2 flex items-center gap-1.5"><i class="fa-solid fa-clock text-slate-400"></i> Horarios de Atención</h5>
            <div id="insp-schedules-list" class="grid grid-cols-2 gap-2"></div>
          </div>

          <!-- Artículos -->
          <div class="mt-2">
            <h5 class="font-bold text-xs text-slate-800 mb-2 flex items-center gap-1.5"><i class="fa-solid fa-newspaper text-slate-400"></i> Artículos Académicos</h5>
            <div id="insp-articles-list" class="flex flex-col gap-2"></div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- HERO CAROUSEL CREATION/EDITION MODAL -->
  <div id="carousel-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl w-full max-w-lg border border-slate-100 shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <!-- Header -->
      <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50 font-sans">
        <div>
          <h3 class="font-extrabold text-sm text-slate-900" id="carousel-form-title">Crear Nuevo Slider</h3>
          <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Configuración de Banner Publicitario</p>
        </div>
        <button onclick="closeCarouselModal()" class="text-slate-400 hover:text-slate-900 text-lg cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Scrollable content -->
      <div class="p-6 overflow-y-auto flex flex-col gap-4 font-sans">
        <form action="/dashboard/admin/carousels" method="POST" class="flex flex-col gap-4 text-xs" id="carousel-form">
          <input type="hidden" name="id" id="carousel-id">
          
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Tipo de Slider</label>
            <select name="tipo" id="carousel-tipo" required onchange="toggleProfessionSelect()" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
              <option value="Inicio">Página Principal (Inicio)</option>
              <option value="Profesion">Página de Profesión</option>
            </select>
          </div>

          <!-- Profession Select (visible only when type is Profesion) -->
          <div class="flex flex-col gap-1.5 hidden" id="carousel-profesion-container">
            <label class="text-xs font-bold text-slate-700">Asociar a Profesión</label>
            <select name="profesionId" id="carousel-profesionId" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-slate-700 font-semibold">
              <option value="">Seleccione una Profesión...</option>
              <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
                <% professions.forEach(function(p) { %>
                  <option value="<%= p.id %>"><%= p.nombre %></option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Título del Banner</label>
            <input type="text" name="titulo" id="carousel-titulo" required placeholder="Ej: Conectando profesionales de excelencia" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Subtítulo (Opcional)</label>
            <input type="text" name="subtitulo" id="carousel-subtitulo" placeholder="Ej: El directorio profesional más grande de Ecuador" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Subir Imagen de Fondo</label>
            <input type="file" id="carousel-image-file" accept="image/*" class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-4 file:py-2.5 file:rounded-xl file:text-xs file:font-bold file:cursor-pointer bg-slate-50 border border-slate-100 rounded-xl py-2 px-3 text-slate-700">
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">URL o Base64 de la Imagen</label>
            <input type="text" name="imageUrl" id="carousel-imageUrl" required placeholder="https://images.unsplash.com/... o cargue archivo" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Previsualización de Imagen</label>
            <div class="w-full h-32 rounded-2xl overflow-hidden bg-slate-50 border border-slate-100 flex items-center justify-center relative">
              <img id="carousel-image-preview" src="" class="w-full h-full object-cover hidden">
              <div id="carousel-preview-placeholder" class="text-slate-400 text-[10px] font-bold flex flex-col items-center gap-1.5">
                <i class="fa-solid fa-image text-xl"></i>
                <span>Sin imagen seleccionada</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Enlace de Destino (Link Opcional)</label>
            <input type="text" name="link" id="carousel-link" placeholder="Ej: /directorio o /cursos" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition">
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-700">Orden de Visualización</label>
            <input type="number" name="orden" id="carousel-orden" value="0" class="bg-slate-50 border border-slate-100 rounded-xl py-3 px-4 text-xs outline-none focus:bg-white focus:border-[#0A3C84] transition text-center font-bold">
          </div>

          <div class="flex items-center gap-2">
            <input type="checkbox" name="activo" value="true" id="carousel-activo" checked class="rounded border-slate-350 text-[#0A3C84] focus:ring-[#0A3C84]">
            <label for="carousel-activo" class="text-xs font-bold text-slate-700">Marcar como Activo</label>
          </div>

          <div class="flex justify-end gap-2 mt-4 pt-4 border-t border-slate-100">
            <button type="button" onclick="closeCarouselModal()" class="border border-slate-200 hover:bg-slate-100 text-slate-800 font-bold py-2.5 px-4 rounded-xl transition text-xs cursor-pointer">
              Cancelar
            </button>
            <button type="submit" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-2.5 px-5 rounded-xl transition text-xs shadow-md cursor-pointer">
              Guardar Slider
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- INSCRITOS MODAL -->
  <!-- MODAL: ESTADISTICAS Y ANALITICAS -->
  <div id="event-stats-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden font-sans">
    <div class="bg-white rounded-3xl w-full max-w-4xl border border-slate-100 shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <!-- Header -->
      <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <div>
          <span id="stats-event-type" class="bg-blue-100 text-blue-700 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider">Conversatorio</span>
          <h3 id="stats-event-title" class="font-extrabold text-base text-slate-900 mt-1 max-w-2xl truncate">Estadísticas del Evento</h3>
          <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">Control de registros, accesos de video, ingresos y tareas</p>
        </div>
        <button onclick="closeEventStatsModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 transition cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Content -->
      <div class="p-6 overflow-y-auto flex flex-col gap-6 text-xs">
        
        <!-- KPI Cards Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <!-- KPI: Inscritos -->
          <div class="bg-blue-50/50 border border-blue-100/40 rounded-2xl p-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-users"></i>
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] text-slate-450 font-bold uppercase tracking-wider">Inscritos</span>
              <span id="stats-kpi-enrolled" class="text-lg font-black text-slate-900 mt-0.5">0</span>
            </div>
          </div>

          <!-- KPI: Ingresos Aprobados -->
          <div class="bg-emerald-50/50 border border-emerald-100/40 rounded-2xl p-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-wallet"></i>
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] text-slate-450 font-bold uppercase tracking-wider">Ingresos (Aprobados)</span>
              <span id="stats-kpi-revenue-approved" class="text-lg font-black text-emerald-700 mt-0.5">$0.00</span>
            </div>
          </div>

          <!-- KPI: Ingresos Pendientes -->
          <div class="bg-amber-50/50 border border-amber-100/40 rounded-2xl p-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] text-slate-450 font-bold uppercase tracking-wider">Por Aprobación</span>
              <span id="stats-kpi-revenue-pending" class="text-lg font-black text-amber-700 mt-0.5">$0.00</span>
            </div>
          </div>

          <!-- KPI: Reproducciones -->
          <div class="bg-purple-50/50 border border-purple-100/40 rounded-2xl p-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center text-lg">
              <i class="fa-solid fa-play"></i>
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] text-slate-450 font-bold uppercase tracking-wider">Visualizaciones</span>
              <span id="stats-kpi-views" class="text-lg font-black text-purple-900 mt-0.5">0</span>
            </div>
          </div>
        </div>

        <!-- Tab Controls -->
        <div class="flex border-b border-slate-100 gap-1 mt-2">
          <button id="tab-btn-enrollments" onclick="switchStatsTab('enrollments')" class="px-4 py-2 font-bold text-xs rounded-t-xl transition border-b-2 border-[#0A3C84] text-[#0A3C84] cursor-pointer">
            Alumnos Registrados
          </button>
          <button id="tab-btn-access" onclick="switchStatsTab('access')" class="px-4 py-2 font-bold text-xs rounded-t-xl transition border-b-2 border-transparent text-slate-400 hover:text-slate-650 cursor-pointer">
            Accesos de Video
          </button>
          <button id="tab-btn-tasks" onclick="switchStatsTab('tasks')" class="px-4 py-2 font-bold text-xs rounded-t-xl transition border-b-2 border-transparent text-slate-400 hover:text-slate-650 cursor-pointer hidden">
            Tareas Académicas
          </button>
          <button id="tab-btn-qa" onclick="switchStatsTab('qa')" class="px-4 py-2 font-bold text-xs rounded-t-xl transition border-b-2 border-transparent text-slate-400 hover:text-slate-650 cursor-pointer hidden">
            Q&amp;A
          </button>
          <button id="tab-btn-orders" onclick="switchStatsTab('orders')" class="px-4 py-2 font-bold text-xs rounded-t-xl transition border-b-2 border-transparent text-slate-400 hover:text-slate-650 cursor-pointer">
            Pedidos
          </button>
        </div>

        <!-- Tab Panes -->
        <div class="flex flex-col gap-4">
          <!-- Pane: Enrollments -->
          <div id="stats-pane-enrollments" class="stats-pane flex flex-col gap-4">
            <div class="overflow-x-auto border border-slate-100 rounded-2xl bg-white">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50 text-slate-400 font-bold uppercase border-b border-slate-100">
                  <tr>
                    <th class="px-4 py-3 text-[10px]">Alumno</th>
                    <th class="px-4 py-3 text-[10px]">Email / Celular</th>
                    <th class="px-4 py-3 text-[10px]">Fecha Registro</th>
                    <th class="px-4 py-3 text-[10px] text-center">Estado Certificado</th>
                    <th class="px-4 py-3 text-right text-[10px]">Valor Pagado</th>
                  </tr>
                </thead>
                <tbody id="stats-table-enrollments-body" class="divide-y divide-slate-50 font-medium text-slate-700">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pane: Access -->
          <div id="stats-pane-access" class="stats-pane hidden flex flex-col gap-4">
            <div class="flex flex-col gap-4 border border-slate-100 rounded-2xl p-5 bg-white">
              <h4 class="font-extrabold text-sm text-slate-900 border-b border-slate-50 pb-2">Analíticas por Contenido</h4>
              <div id="stats-list-access" class="flex flex-col gap-4">
                <!-- Rendered dynamically -->
              </div>
            </div>
          </div>

          <!-- Pane: Tasks -->
          <div id="stats-pane-tasks" class="stats-pane hidden flex flex-col gap-4">
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
              <!-- KPI sub: Total -->
              <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-center">
                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Tareas del Curso</span>
                <span id="stats-tasks-total" class="text-xl font-black text-slate-900 mt-1 block">0</span>
              </div>
              <!-- KPI sub: Entregas -->
              <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-center">
                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Entregas Totales</span>
                <span id="stats-tasks-submissions" class="text-xl font-black text-slate-900 mt-1 block">0</span>
              </div>
              <!-- KPI sub: Pendientes -->
              <div class="bg-amber-50/30 border border-amber-100/30 rounded-xl p-4 text-center">
                <span class="text-[9px] font-bold text-amber-600 uppercase tracking-wider block">Pendientes de Nota</span>
                <span id="stats-tasks-pending" class="text-xl font-black text-amber-700 mt-1 block">0</span>
              </div>
              <!-- KPI sub: Aprobadas -->
              <div class="bg-emerald-50/30 border border-emerald-100/30 rounded-xl p-4 text-center">
                <span class="text-[9px] font-bold text-emerald-600 uppercase tracking-wider block">Entregas Aprobadas</span>
                <span id="stats-tasks-approved" class="text-xl font-black text-emerald-700 mt-1 block">0</span>
              </div>
              <!-- KPI sub: Rechazadas -->
              <div class="bg-rose-50/30 border border-rose-100/30 rounded-xl p-4 text-center">
                <span class="text-[9px] font-bold text-rose-600 uppercase tracking-wider block">Entregas Rechazadas</span>
                <span id="stats-tasks-rejected" class="text-xl font-black text-rose-700 mt-1 block">0</span>
              </div>
            </div>
            
            <div class="bg-slate-50 border border-slate-150/50 rounded-2xl p-5 flex flex-col gap-2 mt-2">
              <span class="font-extrabold text-slate-900 text-sm">Resumen de Participación Escolar</span>
              <p class="text-slate-450 leading-relaxed">
                Este panel muestra la cantidad de tareas asignadas en los diferentes módulos y el estado de sus respectivas entregas. Puedes ir a la pestaña **"Entregas"** del curso en la tabla principal para calificar y proveer retroalimentación individual a cada alumno.
              </p>
            </div>
          </div>

          <!-- Pane: Q&A -->
          <div id="stats-pane-qa" class="stats-pane hidden flex flex-col gap-4">
            
            <!-- Top Speaker Filter Bar -->
            <div class="bg-white border border-slate-200/80 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-blue-50 text-[#0A3C84] border border-blue-100 flex items-center justify-center font-bold text-sm shrink-0">
                  <i class="fa-solid fa-filter"></i>
                </div>
                <div>
