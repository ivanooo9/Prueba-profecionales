    // Helper universal de paginación para tablas HTML
    function setupClientSidePaginator(opts) {
      const {
        tbodyId,
        pageSizeSelectId,
        counterId,
        pageIndicatorId,
        prevBtnId,
        nextBtnId,
        searchInputId,
        statusFilterId
      } = opts;

      let currentPage = 1;
      let pageSize = 10;

      function update() {
        const tbody = document.getElementById(tbodyId);
        if (!tbody) return;

        const allRows = Array.from(tbody.children).filter(el => el.tagName === 'TR');
        if (allRows.length === 0) return;

        const searchVal = searchInputId ? (document.getElementById(searchInputId)?.value || '').toLowerCase().trim() : '';
        const statusVal = statusFilterId ? (document.getElementById(statusFilterId)?.value || 'all') : 'all';

        const filteredRows = allRows.filter(tr => {
          if (tr.children.length === 1 && tr.children[0].getAttribute('colspan')) return false; // Skip empty row text
          const name = tr.getAttribute('data-name') || tr.innerText.toLowerCase();
          const email = tr.getAttribute('data-email') || '';
          const status = tr.getAttribute('data-status') || '';

          const matchSearch = !searchVal || name.includes(searchVal) || email.includes(searchVal);
          const matchStatus = statusVal === 'all' || status === statusVal;

          return matchSearch && matchStatus;
        });

        const totalVisible = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(totalVisible / pageSize));

        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;

        allRows.forEach(tr => tr.classList.add('hidden'));
        filteredRows.slice(start, end).forEach(tr => tr.classList.remove('hidden'));

        const counterEl = document.getElementById(counterId);
        if (counterEl) {
          const from = totalVisible === 0 ? 0 : start + 1;
          const to = Math.min(end, totalVisible);
          counterEl.innerText = `Mostrando ${from} - ${to} de ${totalVisible} registros`;
        }

        const indicatorEl = document.getElementById(pageIndicatorId);
        if (indicatorEl) {
          indicatorEl.innerText = `Página ${currentPage} de ${totalPages}`;
        }

        const prevBtn = document.getElementById(prevBtnId);
        const nextBtn = document.getElementById(nextBtnId);
        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
      }

      const prevBtn = document.getElementById(prevBtnId);
      const nextBtn = document.getElementById(nextBtnId);
      const pageSizeSelect = document.getElementById(pageSizeSelectId);
      const searchInput = searchInputId ? document.getElementById(searchInputId) : null;
      const statusFilter = statusFilterId ? document.getElementById(statusFilterId) : null;

      if (prevBtn) prevBtn.addEventListener('click', () => { if (currentPage > 1) { currentPage--; update(); } });
      if (nextBtn) nextBtn.addEventListener('click', () => { currentPage++; update(); });
      if (pageSizeSelect) pageSizeSelect.addEventListener('change', (e) => { pageSize = parseInt(e.target.value, 10) || 10; currentPage = 1; update(); });
      if (searchInput) searchInput.addEventListener('input', () => { currentPage = 1; update(); });
      if (statusFilter) statusFilter.addEventListener('change', () => { currentPage = 1; update(); });

      update();
    }

