    function closeCursoForm() {
      document.getElementById('curso-list-container').classList.remove('hidden');
      document.getElementById('curso-header-container').classList.remove('hidden');
      document.getElementById('curso-form-container').classList.add('hidden');
      document.getElementById('curso-floating-bar').classList.add('hidden');
    }

    function toggleCursoFree() {
      const freeCheckbox = document.getElementById('curso-free');
      const priceInput = document.getElementById('curso-price');
      const studentPriceInput = document.getElementById('curso-descuentoEstudianteUsd');
      if (freeCheckbox) {
        if (freeCheckbox.checked) {
          if (priceInput) {
            priceInput.value = '0.00';
            priceInput.disabled = true;
            priceInput.classList.add('bg-slate-100', 'cursor-not-allowed');
          }
          if (studentPriceInput) {
            studentPriceInput.value = '0.00';
            studentPriceInput.disabled = true;
            studentPriceInput.classList.add('bg-slate-100', 'cursor-not-allowed');
          }
        } else {
          if (priceInput) {
            priceInput.disabled = false;
            priceInput.classList.remove('bg-slate-100', 'cursor-not-allowed');
          }
          if (studentPriceInput) {
            studentPriceInput.disabled = false;
            studentPriceInput.classList.remove('bg-slate-100', 'cursor-not-allowed');
          }
        }
      }
    }

    // Discounts
    function addCursoDiscountRow() {
      cursoDiscounts.push({
        porcentaje: 10,
        fechaInicio: new Date().toISOString().split('T')[0],
        fechaFin: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]
      });
      renderCursoDiscounts();
    }

    function removeCursoDiscountRow(index) {
      cursoDiscounts.splice(index, 1);
      renderCursoDiscounts();
    }

    function renderCursoDiscounts() {
      const container = document.getElementById('curso-discounts-list');
      if (!container) return;
      container.innerHTML = '';

      if (cursoDiscounts.length === 0) {
        container.innerHTML = `
          <span class="text-slate-400 italic text-[11px]">No se han configurado descuentos activos.</span>
        `;
        return;
      }

      cursoDiscounts.forEach((disc, idx) => {
        container.innerHTML += `
          <div class="flex flex-wrap items-center gap-3 bg-slate-50 border border-slate-100 p-3 rounded-2xl">
            <div class="flex-grow min-w-[70px] max-w-[100px] flex flex-col gap-1">
              <label class="text-[9px] font-black text-slate-450 uppercase tracking-widest">Porcentaje (%)</label>
              <input type="number" required min="1" max="100" value="${disc.porcentaje}" oninput="cursoDiscounts[${idx}].porcentaje = parseFloat(this.value || 0)" class="bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-black text-center text-slate-800 outline-none">
            </div>
            
            <div class="flex-grow flex-shrink-0 min-w-[120px] flex flex-col gap-1">
              <label class="text-[9px] font-black text-slate-450 uppercase tracking-widest">Fecha Inicio</label>
              <input type="date" required value="${disc.fechaInicio ? disc.fechaInicio.split('T')[0] : ''}" onchange="cursoDiscounts[${idx}].fechaInicio = this.value" class="bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-bold text-slate-700 outline-none">
            </div>

            <div class="flex-grow flex-shrink-0 min-w-[120px] flex flex-col gap-1">
              <label class="text-[9px] font-black text-slate-450 uppercase tracking-widest">Fecha Fin</label>
              <input type="date" required value="${disc.fechaFin ? disc.fechaFin.split('T')[0] : ''}" onchange="cursoDiscounts[${idx}].fechaFin = this.value" class="bg-white border border-slate-200 rounded-xl py-2 px-3 text-xs font-bold text-slate-700 outline-none">
            </div>

            <button type="button" onclick="removeCursoDiscountRow(${idx})" class="text-rose-500 hover:text-rose-700 hover:bg-rose-50 p-2.5 rounded-xl transition cursor-pointer self-end mb-0.5">
              <i class="fa-solid fa-trash-can text-xs"></i>
            </button>
          </div>
