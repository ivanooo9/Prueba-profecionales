    function removeConversatorioDay(index) {
      conversatorioDays.splice(index, 1);
      // Remove speakers assigned to this day and update indices for subsequent days
      conversatorioSpeakers = conversatorioSpeakers.filter(sp => sp.dayIndex !== index).map(sp => {
        if (sp.dayIndex > index) {
          return { ...sp, dayIndex: sp.dayIndex - 1 };
        }
        return sp;
      });
      renderConversatorioDays();
    }

