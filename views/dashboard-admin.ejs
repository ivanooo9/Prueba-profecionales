    function escapeAdminHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    const allowedSpeakerResourceTypes = ['pdf', 'xlsx', 'csv', 'docx', 'pptx', 'jpg', 'jpeg', 'png'];
    const maxSpeakerResourceSize = 10 * 1024 * 1024;

    function getSpeakerResourceType(filename) {
      const ext = String(filename || '').split('.').pop().toLowerCase();
      return allowedSpeakerResourceTypes.includes(ext) ? ext : '';
    }

    function renderSpeakerResources(resources) {
      const items = Array.isArray(resources) ? resources : [];
      if (items.length === 0) {
        return '<div class="text-[10px] text-slate-400 font-bold bg-white/70 border border-dashed border-slate-150 rounded-xl p-3 text-center">Sin contenido de apoyo todavía.</div>';
      }

      return items.map(resource => {
        const tipo = escapeAdminHtml(resource.tipo || 'link');
        const nombre = escapeAdminHtml(resource.nombre || 'Recurso');
        return `
          <div class="flex items-center justify-between gap-2 bg-white border border-slate-100 rounded-xl px-3 py-2">
            <div class="min-w-0 flex items-center gap-2">
              <i class="fa-solid ${tipo === 'link' ? 'fa-link' : 'fa-file-lines'} text-emerald-600 text-xs"></i>
              <div class="min-w-0">
                <p class="text-[10px] font-black text-slate-700 truncate">${nombre}</p>
                <p class="text-[9px] font-extrabold text-slate-400 uppercase">${tipo}</p>
              </div>
            </div>
            <button type="button" onclick="deleteSpeakerResource(${resource.speakerId}, ${resource.id})" class="text-rose-500 hover:text-rose-700 text-[10px] font-black cursor-pointer">Eliminar</button>
          </div>
        `;
      }).join('');
    }

