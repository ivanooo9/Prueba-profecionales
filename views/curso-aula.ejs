<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bgLight flex flex-col min-h-screen text-slate-800 antialiased font-sans">
  <%- include('partials/header') %>

  <!-- Main Container -->
  <main class="flex-grow max-w-7xl mx-auto w-full px-6 md:px-12 py-12 flex flex-col gap-8">
    
    <!-- Top Classroom Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
      <div>
        <a href="/cursos/<%= curso.id %>" class="inline-flex items-center gap-1 text-slate-500 hover:text-slate-900 transition text-[11px] font-bold font-sans">
          <i class="fa-solid fa-arrow-left"></i> Volver al Detalle del Curso
        </a>
        <h1 class="text-xl md:text-2xl font-black text-slate-900 leading-tight uppercase tracking-tight mt-1.5"><%= curso.titulo %></h1>
        <p class="text-brand-blue text-[11px] font-bold mt-0.5"><%= curso.slogan || 'Aula Virtual de Capacitación Continua' %></p>
      </div>
      
      <div class="bg-gradient-to-br from-[#5A7AF3] to-[#4562DB] text-white py-3 px-5 rounded-2xl shadow-md flex items-center gap-3">
        <i class="fa-solid fa-user-graduate text-lg"></i>
        <div class="text-left font-sans">
          <span class="text-[8px] font-black uppercase tracking-wider text-blue-150 block">Estudiante Activo</span>
          <span class="text-xs font-extrabold leading-none"><%= user.name %></span>
        </div>
      </div>
    </div>

    <!-- Layout Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Panel (Span 8) - Video Player & Lesson Activities -->
      <div class="lg:col-span-8 flex flex-col gap-8">
        
        <!-- Video Player Frame -->
        <div class="w-full aspect-video rounded-3xl overflow-hidden bg-slate-950 border border-slate-200 shadow-lg relative">
          <% if (currentLesson && currentLesson.videoUrl) { %>
            <%- include('partials/custom-video-player', {
              sourceType: 'course-lesson',
              sourceId: currentLesson.id,
              title: currentLesson.titulo,
              autoplay: true
            }) %>
          <% } else { %>
            <div class="w-full h-full flex flex-col items-center justify-center bg-slate-900 text-slate-400 p-6 text-center gap-2">
              <i class="fa-solid fa-video-slash text-4xl mb-1 text-slate-600"></i>
              <span class="text-xs font-bold">Esta lección no incluye video clase. Revise el material adjunto.</span>
            </div>
          <% } %>
        </div>

        <!-- Lesson Description & Info -->
        <% if (currentLesson) { %>
          <div class="bg-white border border-slate-100 rounded-3xl p-6 md:p-8 shadow-sm flex flex-col gap-4">
            <div>
              <span class="text-[10px] font-black text-[#5A7AF3] uppercase tracking-widest leading-none">Clase Seleccionada</span>
              <h2 class="text-xl font-black text-slate-900 mt-1"><%= currentLesson.titulo %></h2>
            </div>
            
            <% if (currentLesson.descripcion) { %>
              <p class="text-slate-500 text-xs md:text-sm font-semibold leading-relaxed pt-2 border-t border-slate-50">
                <%= currentLesson.descripcion %>
              </p>
            <% } %>

            <!-- Resources list (Material de Apoyo) -->
            <% if (currentLesson.resources && currentLesson.resources.length > 0) { %>
              <div class="pt-4 border-t border-slate-50 flex flex-col gap-3">
                <h4 class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Materiales de Apoyo y Documentos</h4>
                <div class="flex flex-wrap gap-3">
                  <% currentLesson.resources.forEach(function(res) { %>
                    <% 
                      let resTargetUrl = res.url || '';
                      if (resTargetUrl.startsWith('http')) {
                        const downloadName = (res.nombre || 'Material_de_Apoyo').replace(/[^a-zA-Z0-9]/g, '_');
                        resTargetUrl = `/download/file?url=${encodeURIComponent(resTargetUrl)}&name=${encodeURIComponent(downloadName)}`;
                      }
                    %>
                    <a href="<%= resTargetUrl %>" download class="bg-slate-50 hover:bg-slate-100 border border-slate-200/60 rounded-xl py-2.5 px-4 text-xs font-bold text-slate-700 flex items-center gap-2 transition shadow-inner">
                      <i class="fa-regular fa-file-pdf text-rose-500 text-sm"></i>
                      <span><%= res.nombre %></span>
                      <i class="fa-solid fa-cloud-arrow-down text-slate-400 text-[10px] ml-1"></i>
                    </a>
                  <% }); %>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>

        <!-- Homework Assignments / Tasks (Tareas) -->
        <% if (currentLesson && currentLesson.tasks && currentLesson.tasks.length > 0) { %>
          <div class="flex flex-col gap-4">
            <h3 class="text-base font-black text-slate-900 uppercase tracking-tight"><i class="fa-solid fa-file-signature text-[#0252A4] mr-1"></i> Actividades y Tareas Entregables</h3>
            
            <div class="flex flex-col gap-5">
              <% currentLesson.tasks.forEach(function(task) { %>
                <% 
                  // Find student submission for this task
                  const sub = submissions.find(s => s.taskId === task.id);
                %>
                <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm flex flex-col gap-4">
                  
                  <!-- Task Header -->
                  <div class="flex justify-between items-start gap-3 flex-wrap">
                    <div>
                      <h4 class="font-black text-slate-900 text-sm"><%= task.titulo %></h4>
                      <span class="text-[9px] text-[#5A7AF3] font-bold bg-[#5A7AF3]/5 border border-[#5A7AF3]/10 px-2 py-0.5 rounded-full mt-1.5 inline-block">Valor de la Tarea: <%= task.puntos %> puntos</span>
                    </div>

                    <!-- Status Badges -->
                    <div>
                      <% if (!sub) { %>
                        <span class="bg-slate-100 text-slate-500 border border-slate-200 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-wider">No entregado</span>
                      <% } else if (sub.estado === 'PENDIENTE') { %>
                        <span class="bg-amber-50 text-amber-600 border border-amber-200 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-wider flex items-center gap-1"><i class="fa-solid fa-spinner animate-spin text-[8px]"></i> En Validación</span>
                      <% } else if (sub.estado === 'APROBADA') { %>
                        <span class="bg-emerald-50 text-emerald-600 border border-emerald-200 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-wider">Calificada</span>
                      <% } else { %>
                        <span class="bg-rose-50 text-rose-600 border border-rose-200 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-wider">Rechazada</span>
                      <% } %>
                    </div>
                  </div>

                  <!-- Task instructions -->
                  <% if (task.descripcion) { %>
                    <p class="text-slate-500 text-xs font-semibold leading-relaxed whitespace-pre-line border-t border-slate-50 pt-2"><%= task.descripcion %></p>
                  <% } %>

                  <% if (task.archivoUrl) { %>
                    <div class="mt-1">
                      <a href="<%= task.archivoUrl %>" target="_blank" class="text-xs font-bold text-[#5A7AF3] hover:underline inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-paperclip text-[11px]"></i> Descargar archivo guía/instrucciones
                      </a>
                    </div>
                  <% } %>

                  <!-- Grading Feedback if checked -->
                  <% if (sub && (sub.estado === 'APROBADA' || sub.estado === 'RECHAZADA')) { %>
                    <div class="bg-slate-50 border border-slate-150 rounded-2xl p-4 text-xs font-bold text-slate-700 flex flex-col gap-2 shadow-inner">
                      <div class="flex items-center justify-between border-b border-slate-200 pb-1.5">
                        <span class="text-[9px] font-black uppercase text-slate-400">Nota del Evaluador:</span>
                        <span class="text-slate-900 font-mono text-sm"><%= sub.calificacion %> / <%= task.puntos %> pts</span>
                      </div>
                      <% if (sub.comentarioFeedback) { %>
                        <div class="text-[10px] text-slate-500 font-semibold leading-relaxed mt-0.5 whitespace-pre-line italic">
                          Feedback: "<%= sub.comentarioFeedback %>"
                        </div>
                      <% } %>
                    </div>
                  <% } %>

                  <!-- Submission Form or info -->
                  <div class="border-t border-slate-50 pt-4 mt-2">
                    <% if (!sub || sub.estado === 'RECHAZADA') { %>
                      <form onsubmit="submitTaskSubmission(event, <%= task.id %>)" class="flex flex-col gap-4 font-sans text-xs">
                        <div class="flex flex-col gap-1.5">
                          <label class="text-[10px] font-black text-slate-450 uppercase tracking-widest">Seleccionar Archivo de Tarea (PDF, Imagen, Documento)</label>
                          <input type="file" id="file-input-<%= task.id %>" required class="text-xs file:bg-slate-150 file:hover:bg-slate-200 file:border-none file:px-3 file:py-2 file:rounded-lg file:text-[10px] file:font-bold file:cursor-pointer bg-slate-50 border border-slate-150 rounded-xl py-2 px-3 text-slate-750">
                          <input type="hidden" id="file-base64-<%= task.id %>">
                        </div>

                        <div class="flex flex-col gap-1.5">
                          <label class="text-[10px] font-black text-slate-455 uppercase tracking-widest">Comentario o Enlace adicional (Opcional)</label>
                          <textarea id="comment-<%= task.id %>" placeholder="Comentarios para el docente..." rows="2" class="bg-slate-50 border border-slate-150 rounded-xl py-3 px-4 text-xs font-bold outline-none focus:bg-white focus:border-[#5A7AF3] transition resize-none"></textarea>
                        </div>

                        <button type="submit" id="submit-btn-<%= task.id %>" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-extrabold py-3.5 px-6 rounded-xl text-xs shadow-md transition self-start cursor-pointer flex items-center gap-1.5">
                          <span>Entregar Tarea</span> <i class="fa-solid fa-paper-plane text-[10px]"></i>
                        </button>
                      </form>
                    <% } else { %>
                      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 text-xs font-bold text-slate-500 bg-slate-50 p-3.5 rounded-2xl border border-slate-100 shadow-inner">
                        <div class="min-w-0">
                          <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block mb-0.5">Archivo Entregado</span>
                          <a href="<%= sub.archivoUrl %>" target="_blank" class="text-[#5A7AF3] hover:underline flex items-center gap-1.5 truncate">
                            <i class="fa-solid fa-file-invoice"></i> Ver Mi Entrega Digital
                          </a>
                        </div>
                        <div class="text-right flex-shrink-0">
                          <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block mb-0.5">Fecha de Entrega</span>
                          <span class="text-slate-800"><%= new Date(sub.fechaEntrega).toLocaleDateString() %> <%= new Date(sub.fechaEntrega).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                        </div>
                      </div>
                    <% } %>
                  </div>

                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

      </div>

      <!-- Right Panel (Span 4) - Course Progress & Navigation Accordion -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        
        <!-- Course Progress Widget -->
        <div class="bg-white border border-slate-100 p-6 rounded-[28px] shadow-sm flex flex-col gap-4">
          <h4 class="text-xs font-black uppercase tracking-widest text-slate-400">Progreso de Formación</h4>
          
          <% 
            // Calculate progress percentage
            let totalTasks = 0;
            let approvedTasks = 0;
            curso.modules.forEach(mod => {
              mod.lessons.forEach(les => {
                totalTasks += les.tasks.length;
              });
            });
            // We can also count total lessons as points, but let's count completed graded submissions
            submissions.forEach(s => {
              if (s.estado === 'APROBADA') approvedTasks++;
            });
            const progressPct = totalTasks > 0 ? Math.round((approvedTasks / totalTasks) * 100) : 100;
          %>
          <div>
            <div class="flex items-center justify-between text-xs font-bold text-slate-800 mb-1.5">
              <span>Tareas Aprobadas</span>
              <span class="font-mono"><%= approvedTasks %> / <%= totalTasks %></span>
            </div>
            
            <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden shadow-inner">
              <div class="bg-gradient-to-r from-emerald-400 to-emerald-500 h-full rounded-full transition-all duration-500" style="width: <%= progressPct %>%"></div>
            </div>
            
            <span class="text-[10px] font-black text-slate-450 mt-2 block uppercase text-right"><%= progressPct %>% completado</span>
          </div>
        </div>

        <!-- Course Syllabus Tree Accordion -->
        <div class="bg-white border border-slate-100 rounded-[28px] p-5 shadow-sm flex flex-col gap-4">
          <h4 class="text-xs font-black uppercase tracking-widest text-slate-900 border-b border-slate-50 pb-3 font-sans">Contenido Programático</h4>
          
          <div class="flex flex-col gap-3">
            <% if (curso.modules && curso.modules.length > 0) { %>
              <% curso.modules.forEach(function(mod, modIdx) { %>
                <div class="flex flex-col gap-1.5">
                  <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none block mt-2 px-1"><%= mod.titulo %></span>
                  
                  <div class="flex flex-col gap-1 mt-1">
                    <% if (mod.lessons && mod.lessons.length > 0) { %>
                      <% mod.lessons.forEach(function(les) { %>
                        <% 
                          const isCurrent = currentLesson && currentLesson.id === les.id;
                          let activeClass = isCurrent 
                            ? "bg-[#5A7AF3]/10 text-[#5A7AF3] border-[#5A7AF3]/20 shadow-sm" 
                            : "bg-slate-50/50 hover:bg-slate-50 text-slate-650 border-slate-100";
                        %>
                        <a href="/cursos/<%= curso.id %>/aula?lessonId=<%= les.id %>" class="px-3 py-2.5 border rounded-xl text-xs font-bold flex items-center justify-between transition <%= activeClass %>">
                          <span class="truncate pr-2"><i class="fa-regular fa-play-circle text-[13px] mr-1.5 flex-shrink-0"></i> <%= les.titulo %></span>
                          <% if (les.tasks && les.tasks.length > 0) { %>
                            <span class="bg-slate-200/60 text-slate-500 font-bold text-[8px] px-1.5 py-0.5 rounded-md flex items-center gap-0.5"><i class="fa-solid fa-file-signature text-[7px]"></i> <%= les.tasks.length %></span>
                          <% } %>
                        </a>
                      <% }); %>
                    <% } else { %>
                      <span class="text-[10px] text-slate-400 italic px-1">Sin lecciones.</span>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="text-slate-400 text-xs italic font-semibold text-center py-6">Temario vacío.</div>
            <% } %>
          </div>
        </div>

      </div>

    </div>

  </main>

  <%- include('partials/footer') %>

  <!-- FILE TO BASE64 SUBMISSION JS SCRIPT -->
  <script>
    // Register file listeners to convert to Base64 in real-time
    <% if (currentLesson && currentLesson.tasks && currentLesson.tasks.length > 0) { %>
      <% currentLesson.tasks.forEach(function(task) { %>
        const input_<%= task.id %> = document.getElementById('file-input-<%= task.id %>');
        if (input_<%= task.id %>) {
          input_<%= task.id %>.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
              const reader = new FileReader();
              reader.onload = function(evt) {
                document.getElementById('file-base64-<%= task.id %>').value = evt.target.result;
              };
              reader.readAsDataURL(file);
            }
          });
        }
      <% }); %>
    <% } %>

    // Submit task via AJAX
    async function submitTaskSubmission(e, taskId) {
      e.preventDefault();
      
      const submitBtn = document.getElementById(`submit-btn-${taskId}`);
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Enviando...</span> <i class="fa-solid fa-spinner animate-spin text-[10px]"></i>';

      const fileBase64 = document.getElementById(`file-base64-${taskId}`).value;
      const comentario = document.getElementById(`comment-${taskId}`).value;

      if (!fileBase64) {
        alert('Debe seleccionar un archivo válido para entregar la tarea.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Entregar Tarea</span> <i class="fa-solid fa-paper-plane text-[10px]"></i>';
        return;
      }

      try {
        const res = await fetch(`/api/cursos/<%= curso.id %>/tasks/${taskId}/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ archivoUrl: fileBase64, comentario })
        });
        const data = await res.json();
        if (data.success) {
          // Success reload page
          window.location.reload();
        } else {
          alert('Error: ' + data.error);
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Entregar Tarea</span> <i class="fa-solid fa-paper-plane text-[10px]"></i>';
        }
      } catch (err) {
        console.error(err);
        alert('Error de red al entregar tarea.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Entregar Tarea</span> <i class="fa-solid fa-paper-plane text-[10px]"></i>';
      }
    }
  </script>
</body>
</html>
