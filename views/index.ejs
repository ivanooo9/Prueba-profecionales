<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-brand-bgLight flex flex-col min-h-screen text-slate-800 antialiased">
  
  <!-- Header / Navbar -->
  <%- include('partials/header') %>

  <!-- Hero Carousel / Slider Section -->
  <section class="relative w-full h-[60vh] md:h-[80vh] bg-black overflow-hidden group book-scroll-section">
    <!-- Slides Container -->
    <div id="hero-slider" class="relative w-full h-full">
      <% 
        let slideIdx = 0;
      %>
      <% if (typeof activeHomePromotions !== 'undefined' && activeHomePromotions && activeHomePromotions.length > 0) { %>
        <% activeHomePromotions.forEach(function(promo) { %>
          <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out <%= slideIdx === 0 ? 'opacity-100' : 'opacity-0' %>" style="background-image: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.65)), url('<%= promo.bannerHome %>'); background-size: cover; background-position: center;">
            <div class="absolute inset-0 flex flex-col justify-center px-6 md:px-16 lg:px-24">
              <span class="bg-[#0A3C84] text-white text-[10px] font-black tracking-widest uppercase px-3 py-1 rounded-md self-start mb-4 select-none">ANUNCIO DESTACADO</span>
              <h1 class="text-white text-4xl md:text-6xl font-extrabold max-w-3xl leading-tight select-none">
                <%= promo.profile.user.name %>
              </h1>
              <h2 class="text-slate-200 text-lg md:text-2xl font-bold max-w-xl leading-snug mt-4 select-none">
                <%= promo.profile.slogan || 'Profesional Calificado y Destacado' %>
              </h2>
              <div class="mt-8">
                <a href="<%= promo.profile.slug ? '/directorio/' + promo.profile.slug : '/directorio' %>" class="bg-[#5A7AF3] hover:bg-[#4562DB] text-white font-extrabold py-3.5 px-8 rounded-full shadow-lg transition text-xs inline-block">
                  Ver Perfil Profesional <i class="fa-solid fa-arrow-right ml-1"></i>
                </a>
              </div>
            </div>
          </div>
          <% slideIdx++; %>
        <% }); %>
      <% } %>

      <% if (typeof carousels !== 'undefined' && carousels && carousels.length > 0) { %>
        <% carousels.forEach(function(slide) { %>
          <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out <%= slideIdx === 0 ? 'opacity-100' : 'opacity-0' %>" style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('<%= slide.imageUrl %>'); background-size: cover; background-position: center;">
            <div class="absolute inset-0 flex flex-col justify-center px-6 md:px-16 lg:px-24">
              <h1 class="text-white text-4xl md:text-6xl font-extrabold max-w-3xl leading-tight select-none">
                <%= slide.titulo %>
              </h1>
              <% if (slide.subtitulo) { %>
                <h2 class="text-slate-200 text-lg md:text-2xl font-bold max-w-xl leading-snug mt-4 select-none">
                  <%= slide.subtitulo %>
                </h2>
              <% } %>
              <% if (slide.link) { %>
                <div class="mt-8">
                  <a href="<%= slide.link %>" class="bg-[#0A3C84] hover:bg-[#082C62] text-white font-extrabold py-3.5 px-8 rounded-full shadow-lg transition text-xs inline-block">
                    Ver más <i class="fa-solid fa-arrow-right ml-1"></i>
                  </a>
                </div>
              <% } %>
            </div>
          </div>
          <% slideIdx++; %>
        <% }); %>
      <% } %>

      <% if (slideIdx === 0) { %>
        <!-- Default Slide 1 -->
        <div class="hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out opacity-100" style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=1200'); background-size: cover; background-position: center;">
          <div class="absolute inset-0 flex flex-col justify-center px-6 md:px-16 lg:px-24">
            <h1 class="text-white text-4xl md:text-6xl font-extrabold max-w-3xl leading-tight select-none">
              Conectando profesionales de excelencia
            </h1>
          </div>
        </div>
        <% slideIdx = 1; %>
      <% } %>
    </div>

    <!-- Arrow Controls -->
    <button id="hero-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/40 hover:bg-black/60 text-white flex items-center justify-center transition border border-white/10 z-10">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <button id="hero-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/40 hover:bg-black/60 text-white flex items-center justify-center transition border border-white/10 z-10">
      <i class="fa-solid fa-chevron-right"></i>
    </button>

    <!-- Indicators -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
      <% for (let i = 0; i < slideIdx; i++) { %>
        <button class="hero-dot w-3 h-3 rounded-full <%= i === 0 ? 'bg-white' : 'bg-white/40' %> transition" data-index="<%= i %>"></button>
      <% } %>
    </div>
  </section>

  <!-- Scroll cue -->
  <div class="relative mt-4 flex justify-center px-6 z-20">
    <button
      type="button"
      id="home-scroll-cue"
      onclick="smoothScrollToHomeServices(event)"
      class="group inline-flex items-center gap-2 rounded-full bg-white/95 dark:bg-slate-800/95 px-5 py-2.5 text-slate-700 dark:text-slate-200 hover:text-brand-blue dark:hover:text-sky-400 transition-all duration-300 shadow-md hover:shadow-lg cursor-pointer select-none border border-slate-150/60 dark:border-slate-700"
      aria-label="Desplazarse a la sección de servicios profesionales"
    >
      <i class="fa-solid fa-chevron-down animate-bounce text-sm text-brand-blue"></i>
      <span class="text-xs font-extrabold tracking-wide">Ver más</span>
    </button>
  </div>

  <!-- Servicios Profesionales (Categories) -->
  <section id="home-services" class="max-w-7xl mx-auto w-full px-6 md:px-12 py-16 border-t border-slate-100" data-reveal="fade-up">
    <div class="flex flex-col items-center text-center mb-10" data-reveal="fade-up">
      <div class="flex items-center gap-3 mb-5 w-full max-w-md">
        <span class="h-px flex-1 bg-gradient-to-r from-transparent via-brand-blue/30 to-brand-blue/70"></span>
        <span class="w-2 h-2 rounded-full bg-brand-blue ring-4 ring-brand-blue/10"></span>
        <span class="h-px flex-1 bg-gradient-to-l from-transparent via-brand-blue/30 to-brand-blue/70"></span>
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-brand-black tracking-tight mb-2">Servicios Profesionales</h2>
      <p class="text-brand-grayText text-sm">Acceso a servicios de profesionales en distintas profesiones y ocupaciones</p>
    </div>

    <!-- Category Carousel Container -->
    <div class="relative w-full px-2 md:px-14" data-reveal="zoom-in" data-reveal-delay="100">
      <div class="overflow-hidden w-full">
        <!-- Carousel Slider -->
        <div id="category-carousel" class="flex gap-4 md:gap-6 overflow-x-auto scroll-smooth snap-x pb-4 scrollbar-none" style="scrollbar-width: none;">
          
          <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
            <% professions.forEach(function(p) { %>
              <% 
                let profImg = p.imagen;
                if (!profImg) {
                  const nameLower = p.nombre.toLowerCase();
                  if (nameLower.includes("salud") || nameLower.includes("medicina")) {
                    profImg = "https://images.unsplash.com/photo-1576091160550-2173dba999ef?q=80&w=500";
                  } else if (nameLower.includes("derecho") || nameLower.includes("leyes")) {
                    profImg = "https://images.unsplash.com/photo-1589829545856-d10d557cf95f?q=80&w=500";
                  } else if (nameLower.includes("tecnología") || nameLower.includes("ingeniería")) {
                    profImg = "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=500";
                  } else if (nameLower.includes("psicología") || nameLower.includes("bienestar")) {
                    profImg = "https://images.unsplash.com/photo-1527689368864-3a821dbccc34?q=80&w=500";
                  } else if (nameLower.includes("finanzas") || nameLower.includes("contabilidad") || nameLower.includes("economía")) {
                    profImg = "https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=500";
                  } else if (nameLower.includes("construcción") || nameLower.includes("arquitectura")) {
                    profImg = "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=500";
                  } else if (nameLower.includes("marketing") || nameLower.includes("diseño")) {
                    profImg = "https://images.unsplash.com/photo-1542744094-3a31f103e35f?q=80&w=500";
                  } else if (nameLower.includes("educación") || nameLower.includes("capacitación")) {
                    profImg = "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=500";
                  } else if (nameLower.includes("oficios") || nameLower.includes("técnicos")) {
                    profImg = "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=500";
                  } else {
                    profImg = "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=500";
                  }
                }
              %>
              <a href="/profesion/<%= encodeURIComponent(p.nombre) %>" class="snap-start w-full sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)] lg:w-[calc(25%-18px)] flex-shrink-0 group cursor-pointer relative h-[380px] rounded-2xl overflow-hidden shadow-[0_0_10px_rgba(15,23,42,0.12)] hover:shadow-[0_0_14px_rgba(15,23,42,0.16)] premium-card-hover">
                <div class="absolute inset-0 bg-cover bg-center transition duration-500 group-hover:scale-105" style="background-image: url('<%= profImg %>');"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                <div class="absolute bottom-6 left-0 right-0 px-6 flex justify-center">
                  <span class="w-full text-center bg-black/60 backdrop-blur-sm group-hover:bg-slate-900/90 text-white font-medium py-3 rounded-xl border border-white/20 transition-colors text-sm">
                    <%= p.nombre %>
                  </span>
                </div>
              </a>
            <% }); %>
          <% } else { %>
            <a href="/profesion/Derecho" class="snap-start w-full sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)] lg:w-[calc(25%-18px)] flex-shrink-0 group cursor-pointer relative h-[380px] rounded-2xl overflow-hidden shadow-[0_0_10px_rgba(15,23,42,0.12)] hover:shadow-[0_0_14px_rgba(15,23,42,0.16)] premium-card-hover">
              <div class="absolute inset-0 bg-cover bg-center transition duration-500 group-hover:scale-105" style="background-image: url('https://images.unsplash.com/photo-1589829545856-d10d557cf95f?q=80&w=500');"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <div class="absolute bottom-6 left-0 right-0 px-6 flex justify-center">
                <span class="w-full text-center bg-black/60 backdrop-blur-sm group-hover:bg-slate-900/90 text-white font-medium py-3 rounded-xl border border-white/20 transition-colors text-sm">
                  Derecho
                </span>
              </div>
            </a>
          <% } %>

        </div>
      </div>

      <!-- Controls (Outside layout) -->
      <button id="cat-prev" class="absolute left-0 md:-left-12 top-1/2 -translate-y-1/2 w-9 h-9 md:w-11 md:h-11 rounded-full bg-[#033E8C] hover:bg-[#022A60] text-white flex items-center justify-center shadow-lg transition-colors border border-white/10 z-10 cursor-pointer">
        <i class="fa-solid fa-chevron-left text-xs md:text-sm"></i>
      </button>
      <button id="cat-next" class="absolute right-0 md:-right-12 top-1/2 -translate-y-1/2 w-9 h-9 md:w-11 md:h-11 rounded-full bg-[#033E8C] hover:bg-[#022A60] text-white flex items-center justify-center shadow-lg transition-colors border border-white/10 z-10 cursor-pointer">
        <i class="fa-solid fa-chevron-right text-xs md:text-sm"></i>
      </button>
    </div>

    <!-- Category Indicator Dots -->
    <div class="flex items-center justify-center gap-1.5 mt-8">
      <% if (typeof professions !== 'undefined' && professions && professions.length > 0) { %>
        <% for (let i = 0; i < Math.ceil(professions.length / 4); i++) { %>
          <button class="cat-dot <%= i === 0 ? 'w-8 bg-brand-blue' : 'w-2 bg-slate-300' %> h-2 rounded-full transition-all duration-300" data-index="<%= i %>"></button>
        <% } %>
      <% } else { %>
        <button class="cat-dot w-8 h-2 rounded-full bg-brand-blue transition-all duration-300" data-index="0"></button>
        <button class="cat-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300" data-index="1"></button>
        <button class="cat-dot w-2 h-2 rounded-full bg-slate-300 transition-all duration-300" data-index="2"></button>
      <% } %>
    </div>
  </section>

  <!-- Profesionales Destacados -->
  <section class="bg-brand-bgLight max-w-7xl mx-auto w-full px-6 md:px-12 py-16 border-t border-slate-100" data-reveal="fade-up">
    <div class="flex flex-col items-center text-center mb-12" data-reveal="fade-up">
      <div class="flex items-center gap-3 mb-5 w-full max-w-md">
        <span class="h-px flex-1 bg-gradient-to-r from-transparent via-brand-blue/30 to-brand-blue/70"></span>
        <span class="w-2 h-2 rounded-full bg-brand-blue ring-4 ring-brand-blue/10"></span>
        <span class="h-px flex-1 bg-gradient-to-l from-transparent via-brand-blue/30 to-brand-blue/70"></span>
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-brand-black tracking-tight mb-2">Profesionales Destacados</h2>
      <p class="text-brand-grayText text-sm max-w-xl">Los mejores profesionales verificados de Ecuador</p>
    </div>

    <!-- Grid Layout with Stagger -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-stagger="true" data-stagger-step="90">
      <% if (typeof featuredProfessionals !== 'undefined' && featuredProfessionals && featuredProfessionals.length > 0) { %>
        <% featuredProfessionals.forEach(function(p) { %>
          <a href="<%= p.slug ? '/directorio/' + p.slug : '/directorio' %>" class="bg-white rounded-3xl border border-slate-100 overflow-hidden shadow-[0_0_10px_rgba(15,23,42,0.12)] hover:shadow-[0_0_14px_rgba(15,23,42,0.16)] flex flex-col relative group cursor-pointer block premium-card-hover" data-reveal="fade-up">
            <!-- Image & Badge -->
            <div class="relative h-80 overflow-hidden bg-slate-100">
              <img src="<%= p.photo || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(p.user ? p.user.name : 'Profesional') + '&background=0A3C84&color=ffffff&size=500&font-size=0.38&bold=true') %>" alt="<%= p.user ? p.user.name : 'Profesional' %>" class="w-full h-full object-cover transition duration-300 group-hover:scale-105">
              
              <!-- Verified medal badge -->
              <% if (p.verified && new Date(p.subscriptionEnds) > new Date()) { %>
                <div class="absolute top-4 right-4 bg-white text-slate-800 px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-md border border-slate-100/50">
                  <i class="fa-solid fa-medal text-amber-500 text-xs"></i>
                  <span class="text-[10px] font-extrabold tracking-wide uppercase">Destacado</span>
                </div>
              <% } %>
            </div>

            <!-- Body -->
            <div class="p-5 flex flex-col flex-grow">
              <h3 class="font-extrabold text-lg text-slate-900 group-hover:text-brand-blue transition mb-0.5 truncate">
                <%= p.user.name %>
              </h3>
              <p class="text-slate-500 text-xs font-semibold mb-3">
                <%= p.slogan || 'Especialista verificado' %>
              </p>
              
              <div class="flex flex-col gap-2 text-slate-600 text-xs font-medium mb-4">
                <!-- Profession/Specialty -->
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-briefcase text-slate-400 w-4"></i>
                  <span><%= p.specialties && p.specialties.length > 0 ? p.specialties[0].specialty.nombre : 'Servicios Generales' %></span>
                </div>
                <!-- Location -->
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-location-dot text-slate-400 w-4"></i>
                  <span><%= p.ciudad || 'Ecuador' %>, <%= p.provincia || 'Ecuador' %></span>
                </div>
              </div>

              <!-- Button -->
              <div class="w-full text-center bg-slate-100 group-hover:bg-brand-lightBlue group-hover:text-brand-blue text-slate-800 font-bold py-2.5 rounded-xl transition text-sm mt-auto block">
                Ver perfil
              </div>
            </div>
          </a>
        <% }); %>
      <% } %>
    </div>
  </section>

  <div data-reveal="fade-up">
    <%- include('partials/agreement-carousel', {
      agreements,
      title: 'Nuestros Convenios',
      carouselId: 'agreements-carousel',
      prevId: 'agr-prev',
      nextId: 'agr-next',
      dotClass: 'agr-dot'
    }) %>
  </div>

  <!-- Bottom CTA Section -->
  <section class="bg-white border-t border-slate-100 py-20 px-6 md:px-12 flex flex-col items-center text-center" data-reveal="zoom-in">
    <div class="max-w-xl flex flex-col items-center gap-4">
      <h2 class="text-3xl md:text-4xl font-extrabold text-brand-black tracking-tight">Conectando Profesionales</h2>
      <p class="text-brand-grayText text-sm leading-relaxed mb-4">Una red que impulsa el crecimiento profesional en Ecuador</p>
      <a href="/directorio" class="inline-flex items-center gap-2 bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-4 px-8 rounded-full shadow-lg hover:shadow-blue-900/10 hover:scale-105 active:scale-95 transition-all text-sm">
        Ver todos los profesionales <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </section>

  <!-- Footer -->
  <div data-reveal="fade-up">
    <%- include('partials/footer') %>
  </div>

  <!-- Vanilla JS Carousels and Sliders Controller -->
  <script>
    (function() {
      // 1. Hero Banner Slider
      const slides = document.querySelectorAll('.hero-slide');
      const dots = document.querySelectorAll('.hero-dot');
      const prevBtn = document.getElementById('hero-prev');
      const nextBtn = document.getElementById('hero-next');
      let currentSlide = 0;
      let slideInterval = null;

      function showSlide(index) {
        if (!slides || slides.length === 0) return;
        slides.forEach((slide, i) => {
          slide.style.opacity = i === index ? '1' : '0';
          slide.style.zIndex = i === index ? '10' : '0';
        });
        dots.forEach((dot, i) => {
          if (i === index) {
            dot.className = 'hero-dot w-6 bg-white rounded-full transition-all duration-300';
          } else {
            dot.className = 'hero-dot w-3 bg-white/40 rounded-full transition-all duration-300';
          }
        });
        currentSlide = index;
      }

      function nextSlide() {
        if (!slides || slides.length <= 1) return;
        let index = (currentSlide + 1) % slides.length;
        showSlide(index);
      }

      function prevSlide() {
        if (!slides || slides.length <= 1) return;
        let index = (currentSlide - 1 + slides.length) % slides.length;
        showSlide(index);
      }

      function startSlideShow() {
        if (!slides || slides.length <= 1) return;
        if (slideInterval) clearInterval(slideInterval);
        slideInterval = setInterval(nextSlide, 5000);
      }

      function resetSlideShow() {
        if (slideInterval) clearInterval(slideInterval);
        startSlideShow();
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          prevSlide();
          resetSlideShow();
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          nextSlide();
          resetSlideShow();
        });
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          showSlide(i);
          resetSlideShow();
        });
      });

      if (slides.length > 0) {
        showSlide(0);
        startSlideShow();
      }

      // 2. Horizontal Scroll Sliders helper (Categorías de Servicios)
      function setupScrollCarousel(carouselId, prevId, nextId, dotsClass) {
        const carousel = document.getElementById(carouselId);
        const prev = document.getElementById(prevId);
        const next = document.getElementById(nextId);
        const dotsList = document.querySelectorAll('.' + dotsClass);
        
        if (!carousel) return;

        function getScrollStep() {
          const firstCard = carousel.querySelector(':scope > *');
          if (firstCard) {
            return firstCard.offsetWidth + 24;
          }
          return Math.max(300, carousel.clientWidth * 0.75);
        }

        if (prev) {
          prev.addEventListener('click', (e) => {
            e.preventDefault();
            carousel.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
          });
        }
        if (next) {
          next.addEventListener('click', (e) => {
            e.preventDefault();
            carousel.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
          });
        }

        carousel.addEventListener('scroll', () => {
          const maxScroll = carousel.scrollWidth - carousel.clientWidth;
          if (maxScroll <= 0) return;
          const currentScroll = carousel.scrollLeft;
          const scrollPercent = currentScroll / maxScroll;
          
          let activeDot = Math.min(Math.round(scrollPercent * (dotsList.length - 1)), dotsList.length - 1);

          dotsList.forEach((dot, i) => {
            if (i === activeDot) {
              dot.classList.add('bg-brand-blue', 'w-8');
              dot.classList.remove('bg-slate-300', 'w-2');
            } else {
              dot.classList.remove('bg-brand-blue', 'w-8');
              dot.classList.add('bg-slate-300', 'w-2');
            }
          });
        });

        dotsList.forEach((dot, i) => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            const maxScroll = carousel.scrollWidth - carousel.clientWidth;
            carousel.scrollTo({
              left: (maxScroll * i) / (dotsList.length - 1 || 1),
              behavior: 'smooth'
            });
          });
        });
      }

      setupScrollCarousel('category-carousel', 'cat-prev', 'cat-next', 'cat-dot');
    })();

    function smoothScrollToHomeServices(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      const target = document.getElementById('home-services');
      if (!target) return;

      const startY = window.pageYOffset || document.documentElement.scrollTop || 0;
      const targetY = target.getBoundingClientRect().top + startY - 30;
      const diff = targetY - startY;
      const duration = 1000;
      let startTimestamp = null;

      function step(timestamp) {
        if (!startTimestamp) startTimestamp = timestamp;
        const elapsed = timestamp - startTimestamp;
        const progress = Math.min(elapsed / duration, 1);
        const ease = progress < 0.5 
          ? 4 * progress * progress * progress 
          : 1 - Math.pow(-2 * progress + 2, 3) / 2;

        window.scrollTo(0, startY + diff * ease);

        if (progress < 1) {
          window.requestAnimationFrame(step);
        }
      }

      window.requestAnimationFrame(step);
    }
  </script>

  <% if (typeof activePopup !== 'undefined' && activePopup) { %>
    <!-- Popup Promocional -->
    <div id="promotional-popup" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center z-50 p-4 transition-all duration-300">
      <div class="bg-white rounded-3xl p-5 max-w-sm w-full shadow-2xl relative border border-slate-100 flex flex-col gap-4 animate-in fade-in zoom-in-95 duration-200">
        <button type="button" onclick="closePromotionalPopup()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-655 text-lg cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="flex items-center justify-between border-b border-slate-50 pb-2">
          <span class="bg-purple-100 text-purple-800 text-[8px] font-black px-2.5 py-0.5 rounded tracking-widest uppercase">RECOMENDADO</span>
        </div>

        <a href="<%= activePopup.popupLink || (activePopup.profile.slug ? '/directorio/' + activePopup.profile.slug : '/directorio') %>" class="aspect-square w-full rounded-2xl overflow-hidden border border-slate-100 bg-slate-50 flex items-center justify-center shadow-sm">
          <img src="<%= activePopup.popupImage %>" class="w-full h-full object-cover">
        </a>

        <div class="flex flex-col gap-2 text-center font-sans">
          <h4 class="font-black text-slate-900 text-xs">¡Conozca más sobre nuestro profesional destacado!</h4>
          <p class="text-[10px] text-slate-500 font-semibold leading-relaxed">Haga clic en la imagen o en el botón de abajo para ver el perfil completo.</p>
          <a href="<%= activePopup.popupLink || (activePopup.profile.slug ? '/directorio/' + activePopup.profile.slug : '/directorio') %>" class="bg-[#0A3C84] text-white font-extrabold text-[10px] py-3 rounded-xl mt-1 shadow-md hover:bg-[#082C62] transition text-center">
            Ver Perfil Profesional
          </a>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const popupId = "promo_popup_<%= activePopup.id %>";
        const hasSeen = sessionStorage.getItem(popupId);
        if (!hasSeen) {
          setTimeout(() => {
            const popup = document.getElementById("promotional-popup");
            if (popup) {
              popup.classList.remove("hidden");
              popup.classList.add("flex");
            }
          }, 1500); // Show popup after 1.5s
        }
      });

      function closePromotionalPopup() {
        const popup = document.getElementById("promotional-popup");
        if (popup) {
          popup.classList.add("hidden");
          popup.classList.remove("flex");
        }
        sessionStorage.setItem("promo_popup_<%= activePopup.id %>", "true");
      }
    </script>
  <% } %>
</body>
</html>
