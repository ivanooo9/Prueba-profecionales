<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Vista previa no disponible' %> | Profesionales Ecuador</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Outfit', 'sans-serif'],
            heading: ['Outfit', 'sans-serif'],
          },
          colors: {
            brand: {
              blue: '#0A3C84',
              secondary: '#0a66c2',
            }
          }
        }
      }
    }
  </script>

  <style>
    :root {
      --primary-color: #0A3C84;
      --secondary-color: #0a66c2;
      --body-font: 'Outfit', sans-serif;
    }
    body {
      font-family: var(--body-font);
    }
  </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center px-4 py-10 antialiased">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-3xl shadow-xl border border-slate-200/70 overflow-hidden">
      <div class="h-1.5 w-full" style="background: var(--primary-color);"></div>

      <div class="px-7 pt-8 pb-7 flex flex-col items-center text-center">
        <div class="w-16 h-16 rounded-2xl bg-amber-50 border border-amber-200/60 flex items-center justify-center mb-5">
          <i class="fa-solid fa-triangle-exclamation text-2xl text-amber-500"></i>
        </div>

        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 leading-tight mb-2">
          <%= typeof title !== 'undefined' ? title : 'Vista previa no disponible' %>
        </h1>

        <p class="text-sm text-slate-500 leading-relaxed max-w-sm mb-7">
          <%= typeof message !== 'undefined' ? message : 'Aún no has creado tu perfil profesional. Configúralo desde la pestaña Editar Perfil Público.' %>
        </p>

        <a
          href="<%= typeof backHref !== 'undefined' ? backHref : '/dashboard/profesional?tab=perfil' %>"
          class="inline-flex items-center gap-2 text-white font-bold text-xs uppercase tracking-wider py-3 px-6 rounded-full shadow-md hover:shadow-lg hover:brightness-95 active:scale-[0.98] transition-all duration-200"
          style="background: var(--primary-color);"
        >
          <i class="fa-solid fa-arrow-left text-[10px]"></i>
          <span>Volver al editor</span>
        </a>
      </div>
    </div>

    <p class="text-center text-[10px] text-slate-400 font-semibold mt-6 uppercase tracking-widest">
      Profesionales Ecuador &middot; Error 404
    </p>
  </div>
</body>
</html>
