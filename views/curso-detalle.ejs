  </div>

  <%- include('partials/footer') %>
  <%- include('partials/transfer-bank-account-js', { activeBankAccounts }) %>

  <!-- FRONTEND SCRIPT LOGIC -->
  <script>
    // Accordion Toggle
    function toggleAccordion(id) {
      const panel = document.getElementById('content-' + id);
      const arrow = document.getElementById('arrow-' + id);
      if (panel.classList.contains('hidden')) {
        panel.classList.remove('hidden');
        arrow.classList.add('rotate-180');
      } else {
        panel.classList.add('hidden');
        arrow.classList.remove('rotate-180');
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const select = document.getElementById('transfer-bank-account');
      if (select) {
        select.addEventListener('change', function() { syncTransferBankAccountPaymentFields('transfer-bank-account', 'transfer-bank-account-card', 'transfer-ref', 'transfer-comprobante', 'transfer-comprobante-dropzone'); });
        syncTransferBankAccountPaymentFields('transfer-bank-account', 'transfer-bank-account-card', 'transfer-ref', 'transfer-comprobante', 'transfer-comprobante-dropzone');
      }
    });

    // Modal Control Helpers
    let userLogged = <%= user ? 'true' : 'false' %>;
    const cursoId = <%= curso.id %>;

    function handleEnrollmentClick() {
      if (!userLogged) {
        openAuthModal();
      } else {
        openPaymentModal();
      }
    }

    // Auth Modals Toggle
    function openAuthModal() {
      document.getElementById('auth-modal').classList.remove('hidden');
      switchAuthTab('login');
    }
    function closeAuthModal() {
      document.getElementById('auth-modal').classList.add('hidden');
    }
    function switchAuthTab(tab) {
      const loginTab = document.getElementById('auth-tab-login');
      const regTab = document.getElementById('auth-tab-register');
      const loginForm = document.getElementById('auth-login-form');
      const regForm = document.getElementById('auth-register-form');

      if (tab === 'login') {
        loginTab.className = "flex-1 text-center py-2 text-[10px] font-black uppercase rounded-lg bg-white text-[#5A7AF3] shadow-sm transition";
        regTab.className = "flex-1 text-center py-2 text-[10px] font-black uppercase rounded-lg text-slate-500 hover:text-slate-800 transition";
        loginForm.classList.remove('hidden');
        regForm.classList.add('hidden');
        document.getElementById('auth-modal-title').innerText = 'Iniciar Sesión';
      } else {
        regTab.className = "flex-1 text-center py-2 text-[10px] font-black uppercase rounded-lg bg-white text-[#5A7AF3] shadow-sm transition";
        loginTab.className = "flex-1 text-center py-2 text-[10px] font-black uppercase rounded-lg text-slate-500 hover:text-slate-800 transition";
        regForm.classList.remove('hidden');
        loginForm.classList.add('hidden');
        document.getElementById('auth-modal-title').innerText = 'Crear Cuenta Estudiante';
      }
    }

    // AJAX login
    document.getElementById('auth-login-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const email = document.getElementById('login-email').value;
      const password = document.getElementById('login-password').value;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const data = await res.json();
        if (data.success) {
          userLogged = true;
          // Set name in input
          document.getElementById('checkout-cert-name').value = data.user.nombreCertificado || data.user.name;
          closeAuthModal();
          openPaymentModal();
        } else {
          alert('Error: ' + (data.error || 'Credenciales incorrectas'));
        }
      } catch (err) {
        console.error(err);
        alert('Error en conexión con el servidor.');
      }
    });

    // AJAX register
    document.getElementById('auth-register-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const name = document.getElementById('register-name').value;
      const email = document.getElementById('register-email').value;
      const password = document.getElementById('register-password').value;

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password })
        });
        const data = await res.json();
        if (data.success) {
          userLogged = true;
          document.getElementById('checkout-cert-name').value = name;
          closeAuthModal();
          openPaymentModal();
        } else {
          alert('Error: ' + (data.error || 'No se pudo crear la cuenta'));
        }
      } catch (err) {
        console.error(err);
        alert('Error en conexión con el servidor.');
      }
    });

    // Payment Modals Control
    function openPaymentModal() {
      document.getElementById('payment-modal').classList.remove('hidden');
      goToCheckoutStep1();
    }
    function closePaymentModal() {
      document.getElementById('payment-modal').classList.add('hidden');
    }

    function goToCheckoutStep1() {
      document.getElementById('payment-step-1').classList.remove('hidden');
      document.getElementById('payment-step-2').classList.add('hidden');
      document.getElementById('checkout-step-tag').innerText = 'Paso 1 de 2';
      document.getElementById('checkout-title').innerText = 'Datos del Certificado';
    }

    function goToCheckoutStep2() {
      const nameVal = document.getElementById('checkout-cert-name').value.trim();
      const errEl = document.getElementById('checkout-cert-name-error');
      
      if (!nameVal) {
        errEl.classList.remove('hidden');
        return;
      }
      errEl.classList.add('hidden');

      // Capitalize Title Case helper
      function toTitleCase(str) {
        return str.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      }
      const formattedName = toTitleCase(nameVal);
      document.getElementById('checkout-cert-name').value = formattedName;
      document.getElementById('checkout-summary-name').innerText = formattedName;

      document.getElementById('payment-step-1').classList.add('hidden');
      document.getElementById('payment-step-2').classList.remove('hidden');
      document.getElementById('checkout-step-tag').innerText = 'Paso 2 de 2';
      document.getElementById('checkout-title').innerText = 'Método de Pago';
      
      switchPaymentPanel('transfer');
    }

    function switchPaymentPanel(panel) {
      const panels = ['transfer', 'payphone', 'kushki'];
      panels.forEach(p => {
        const panelEl = document.getElementById('panel-' + p);
        const btnEl = document.getElementById('tab-btn-' + p);
        
        if (p === panel) {
          panelEl.classList.remove('hidden');
          btnEl.className = "flex-1 text-center py-2 text-[9px] font-black uppercase rounded-lg bg-white text-[#5A7AF3] shadow-sm transition";
        } else {
          panelEl.classList.add('hidden');
          btnEl.className = "flex-1 text-center py-2 text-[9px] font-black uppercase rounded-lg text-slate-500 hover:text-slate-800 transition";
        }
      });
    }

    function readImageAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = error => reject(error);
        reader.readAsDataURL(file);
      });
    }

    // Submit Checkout
    async function submitCheckoutPayment(method) {
      const nombreUsuario = document.getElementById('checkout-cert-name').value.trim();
      
      let payload = {
        paymentMethod: method,
        nombreUsuario,
        ajax: true
      };

      if (method === 'transferencia') {
        const reference = document.getElementById('transfer-ref').value.trim();
        const bancoInput = document.getElementById('transfer-banco');
        const banco = bancoInput ? bancoInput.value.trim() : '';
        const bankAccountSelect = document.getElementById('transfer-bank-account');
        const fileInput = document.getElementById('transfer-comprobante');
        if (bankAccountSelect && !bankAccountSelect.value) {
          alert('Seleccione la cuenta bancaria de destino.');
          return;
        }
        if (!reference || (bancoInput && !banco)) {
          alert('Debe rellenar la referencia bancaria y el banco.');
          return;
        }
        if (!fileInput.files || fileInput.files.length === 0) {
          alert('Por favor, suba la captura de su comprobante de pago.');
          return;
        }
        payload.reference = reference;
        if (bancoInput) payload.banco = banco;
        if (bankAccountSelect) payload.bankAccountId = bankAccountSelect.value;

        const file = fileInput.files[0];
        try {
          payload.comprobante = await readImageAsBase64(file);
        } catch (e) {
          alert('Error al procesar la imagen del comprobante.');
          return;
        }
      } else if (method === 'payphone') {
        // PayPhone se procesa a través de la pasarela real → redirige.
        iniciarPagoPayPhone({ itemType: 'COURSE', itemId: cursoId, baseAmount: Number('<%= price %>'), hasTax: true, productName: '<%= (curso.titulo || '').replace(/'/g, "\\'") %>' });
        return;
      } else if (method === 'kushki') {
        const name = document.getElementById('kushki-card-name').value.trim();
        const number = document.getElementById('kushki-card-number').value.trim();
        const expiry = document.getElementById('kushki-card-expiry').value.trim();
        const cvc = document.getElementById('kushki-card-cvc').value.trim();
        
        if (!name || !number || !expiry || !cvc) {
          alert('Debe rellenar todos los campos de la tarjeta.');
          return;
        }
      }

      try {
        const res = await fetch(`/cursos/${cursoId}/comprar`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          closePaymentModal();
          window.location.href = data.redirect || `/cursos/${cursoId}`;
        } else {
          alert('Error: ' + data.error);
        }
      } catch (err) {
        console.error(err);
        alert('Error en conexión al procesar el pago.');
      }
    }

    function togglePasswordVisibility(id, btn) {
      const input = document.getElementById(id);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }

    // Free Certificate Modal Control
    function openFreeCertModal() {
      const modal = document.getElementById('free-cert-modal');
      const nameInput = document.getElementById('free-cert-name');
      const errEl = document.getElementById('free-cert-name-error');
      if (errEl) errEl.classList.add('hidden');
      modal.classList.remove('hidden');
      if (nameInput) {
        nameInput.focus();
        nameInput.select();
      }
    }

    function closeFreeCertModal() {
      document.getElementById('free-cert-modal').classList.add('hidden');
    }

    function toTitleCaseFree(str) {
      if (!str) return '';
      return str.toLowerCase().split(/\s+/).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    }

    async function submitFreeCertEnrollment() {
      const nameInput = document.getElementById('free-cert-name');
      const errEl = document.getElementById('free-cert-name-error');
      const btnText = document.getElementById('free-cert-btn-text');
      const btnIcon = document.getElementById('free-cert-btn-icon');
      const rawName = nameInput.value.trim();
      const formattedName = toTitleCaseFree(rawName);

      if (!formattedName) {
        errEl.classList.remove('hidden');
        return;
      }
      errEl.classList.add('hidden');
      nameInput.value = formattedName;

      btnText.innerText = "Procesando...";
      btnIcon.className = "fa-solid fa-spinner animate-spin";

      try {
        const res = await fetch(`/cursos/${cursoId}/inscribirse`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ nombreUsuario: formattedName, ajax: true })
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          closeFreeCertModal();
          window.location.href = data.redirect || `/cursos/${cursoId}/aula?success=enrolled`;
        } else {
          const errMsg = data.error || 'No se pudo completar la inscripción gratuita.';
          alert('Error: ' + errMsg);
          btnText.innerText = "Confirmar Inscripción Gratuita";
          btnIcon.className = "fa-solid fa-award";
        }
      } catch (err) {
        console.error(err);
        alert('Error en conexión con el servidor.');
        btnText.innerText = "Confirmar Inscripción Gratuita";
        btnIcon.className = "fa-solid fa-award";
      }
    }
  </script>
  <!-- Modal de Progreso del Certificado (Antes de desbloqueo) -->
  <div id="cert-progress-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 md:p-8 shadow-2xl border border-slate-100 flex flex-col gap-6 relative animate-fade-in">
      <button type="button" onclick="closeCertProgressModal()" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition cursor-pointer">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>

      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl shadow-inner flex-shrink-0">
          <i class="fa-solid fa-award"></i>
        </div>
        <div class="flex flex-col">
          <h3 class="text-base font-black text-slate-900 uppercase tracking-tight">Requisitos del Certificado</h3>
          <span class="text-xs text-slate-500 font-semibold">Progreso actual del curso</span>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-5 flex flex-col gap-3">
        <div class="flex items-center justify-between text-xs font-black text-slate-800">
          <span>Avance de Lecciones</span>
          <span class="text-amber-600 font-mono text-sm"><%= typeof progressPct !== 'undefined' ? progressPct : 0 %>% / <%= curso.porcentajeMinimoCertificado || 50 %>%</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden p-0.5 border border-slate-300/60">
          <div class="bg-gradient-to-r from-amber-500 to-emerald-500 h-full rounded-full transition-all duration-500" style="width: <%= typeof progressPct !== 'undefined' ? progressPct : 0 %>%;"></div>
        </div>
        <p class="text-xs text-slate-600 font-medium leading-relaxed mt-1 font-sans">
          Has completado <strong><%= typeof completedCount !== 'undefined' ? completedCount : 0 %></strong> de <strong><%= typeof totalLessons !== 'undefined' ? totalLessons : 0 %></strong> lecciones. Completa al menos el <strong><%= curso.porcentajeMinimoCertificado || 50 %>%</strong> de las lecciones del curso para desbloquear la emisión de tu certificado.
        </p>
      </div>

      <div class="flex flex-col gap-2">
        <a href="/cursos/<%= curso.id %>/aula<%= typeof nextLessonId !== 'undefined' && nextLessonId ? '?lesson=' + nextLessonId : '' %>" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-6 rounded-2xl text-xs text-center transition flex items-center justify-center gap-2 shadow-md">
          <i class="fa-solid fa-play"></i> <%= typeof ctaButtonLabel !== 'undefined' ? ctaButtonLabel : 'Continuar Curso' %>
        </a>
        <button type="button" onclick="closeCertProgressModal()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold py-3 px-6 rounded-2xl text-xs transition text-center cursor-pointer">
          Cerrar
        </button>
      </div>
    </div>
  </div>

  <script>
    function openCertProgressModal() {
      const modal = document.getElementById('cert-progress-modal');
      if (modal) modal.classList.remove('hidden');
    }
    function closeCertProgressModal() {
      const modal = document.getElementById('cert-progress-modal');
      if (modal) modal.classList.add('hidden');
    }
  </script>

  <script src="/js/comprobante-dropzone.js"></script>
  <script src="/js/payphone-helper.js"></script>
</body>
</html>
