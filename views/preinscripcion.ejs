<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 flex flex-col min-h-screen text-slate-800 antialiased font-sans">
  <%- include('partials/header') %>

  <main class="flex-grow flex flex-col items-center justify-center py-10 px-6 max-w-5xl mx-auto w-full">
    <!-- Breadcrumbs / Migas de Pan (Nielsen H1 & H3) -->
    <div class="w-full max-w-4xl mb-8">
      <nav class="flex items-center justify-between flex-wrap gap-3 bg-white px-5 py-3.5 rounded-2xl border border-slate-200 shadow-sm text-sm" aria-label="Migas de pan">
        <ol class="flex items-center flex-wrap gap-2 text-slate-600 font-medium list-none p-0 m-0">
          <li class="inline-flex items-center">
            <a href="/" class="text-slate-700 hover:text-[#0A3C84] font-semibold transition">Inicio</a>
          </li>
          <li class="text-slate-300">/</li>
          <li class="inline-flex items-center">
            <button type="button" onclick="openAccountTypeModal()" class="text-slate-700 hover:text-[#0A3C84] font-semibold transition cursor-pointer bg-transparent border-0 p-0">Crear Cuenta</button>
          </li>
          <li class="text-slate-300">/</li>
          <li class="inline-flex items-center font-bold text-[#0A3C84]" aria-current="page">
            <span>Planes Profesionales</span>
          </li>
        </ol>
        <button type="button" onclick="openAccountTypeModal()" class="text-slate-500 hover:text-[#0A3C84] text-xs font-semibold transition cursor-pointer bg-transparent border-0 p-0">
          Cambiar perfil
        </button>
      </nav>
    </div>

    <!-- Header Title -->
    <div class="text-center mb-10 space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#0A3C84] tracking-tight">Preinscripción Profesional</h1>
      <p class="text-slate-600 font-normal text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Elige el plan que mejor se adapte a tu práctica para recibir pacientes y facturar digitalmente.
      </p>
    </div>

    <!-- Plans Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 w-full max-w-4xl">
      
      <% plans.forEach(function(plan) { %>
        <% if (plan.popular) { %>
          <!-- Highlighted Premium Plan Card -->
          <div class="bg-white border-2 border-[#1E6BFA] rounded-3xl p-8 sm:p-10 shadow-xl relative flex flex-col justify-between hover:shadow-2xl transition duration-300">
            <!-- Popular Badge -->
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[#1E6BFA] text-white text-xs font-bold uppercase tracking-wider px-5 py-1.5 rounded-full shadow-md">
              MÁS POPULAR
            </div>

            <div>
              <!-- Header Info -->
              <div class="mb-6">
                <h2 class="text-2xl font-extrabold text-slate-900 leading-tight"><%= plan.nombre %></h2>
                <p class="text-sm text-[#1E6BFA] font-medium mt-1"><%= plan.descripcion %></p>
              </div>

              <!-- Price Box -->
              <div class="mb-8 pb-6 border-b border-slate-100">
                <div class="flex items-baseline text-slate-900">
                  <span class="text-4xl sm:text-5xl font-extrabold">$<%= plan.precio.toFixed(0) %></span>
                  <span class="text-base font-semibold text-slate-500 ml-2">USD</span>
                </div>
                <span class="text-xs font-semibold text-[#1E6BFA] block mt-1.5">Pago único - Sin mensualidades</span>
              </div>

              <!-- Features list -->
              <ul class="flex flex-col gap-3.5 text-sm text-slate-700 mb-8">
                <% 
                  const features = plan.caracteristicas.split('\n').filter(Boolean);
                  features.forEach(function(feat) {
                %>
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-check text-blue-600 mt-1 text-sm shrink-0"></i>
                    <span class="leading-relaxed"><%= feat %></span>
                  </li>
                <% }); %>
              </ul>
            </div>

            <!-- CTA Button -->
            <a href="/registro-profesional?planId=<%= plan.id %>" class="w-full bg-[#1E6BFA] hover:bg-[#1554C7] text-white font-bold py-3.5 px-6 rounded-xl text-center text-sm sm:text-base transition shadow-md hover:shadow-lg flex items-center justify-center gap-2">
              Inscribirme Ahora - $<%= plan.precio.toFixed(0) %> USD
            </a>
          </div>
        <% } else { %>
          <!-- Standard Gratis Plan Card -->
          <div class="bg-white border border-slate-200 rounded-3xl p-8 sm:p-10 shadow-md flex flex-col justify-between hover:shadow-lg transition duration-300">
            <div>
              <!-- Header Info -->
              <div class="mb-6">
                <h2 class="text-2xl font-extrabold text-slate-900 leading-tight"><%= plan.nombre %></h2>
                <p class="text-sm text-slate-500 font-medium mt-1"><%= plan.descripcion %></p>
              </div>

              <!-- Price Box -->
              <div class="mb-8 pb-6 border-b border-slate-100">
                <div class="flex items-baseline text-slate-900">
                  <span class="text-4xl sm:text-5xl font-extrabold">$<%= plan.precio.toFixed(0) %></span>
                  <span class="text-base font-semibold text-slate-500 ml-2">USD</span>
                </div>
                <span class="text-xs font-semibold text-slate-500 block mt-1.5">Registro sin costo</span>
              </div>

              <!-- Features list -->
              <ul class="flex flex-col gap-3.5 text-sm text-slate-700 mb-8">
                <% 
                  const features = plan.caracteristicas.split('\n').filter(Boolean);
                  features.forEach(function(feat) {
                %>
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-check text-slate-400 mt-1 text-sm shrink-0"></i>
                    <span class="leading-relaxed"><%= feat %></span>
                  </li>
                <% }); %>
              </ul>
            </div>

            <!-- CTA Button -->
            <a href="/registro-profesional?planId=<%= plan.id %>" class="w-full bg-[#0A3C84] hover:bg-[#082C62] text-white font-bold py-3.5 px-6 rounded-xl text-center text-sm sm:text-base transition shadow-md hover:shadow-lg flex items-center justify-center gap-2">
              Comenzar Registro Gratis
            </a>
          </div>
        <% } %>
      <% }); %>

    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
