<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bienvenida y Configuración Inicial - Referidos | Profesionales Ecuador</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="min-h-full bg-slate-50 text-slate-800 flex flex-col justify-between p-4 md:p-8">

  <div class="max-w-4xl mx-auto w-full my-auto">
    <!-- Header Badge -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 border border-blue-100 text-[#0A3C84] text-xs font-extrabold uppercase tracking-wider mb-4 shadow-sm">
        <i class="fa-solid fa-sparkles text-amber-500"></i> Programa Oficial de Referidos
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-slate-900 mb-3">
        Bienvenido a <span class="text-[#0A3C84]">Profesionales Ecuador</span>
      </h1>
      <p class="text-slate-600 text-sm md:text-base max-w-xl mx-auto font-medium">
        Antes de comenzar a comercializar productos y generar comisiones, por favor completa tu perfil personal, tus datos de cobro bancario y establece tu nueva contraseña personal.
      </p>
    </div>

    <!-- Alert Box -->
    <% if (error) { %>
      <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-3 shadow-sm">
        <i class="fa-solid fa-triangle-exclamation text-lg text-rose-600"></i>
        <span>
          <% if (error === 'missing_password_fields') { %>Debe completar todos los campos de contraseña.<% } %>
          <% if (error === 'password_mismatch') { %>Las nuevas contraseñas no coinciden.<% } %>
          <% if (error === 'password_too_short') { %>La nueva contraseña debe tener al menos 6 caracteres.<% } %>
          <% if (error === 'invalid_current_password') { %>La contraseña temporal ingresada es incorrecta.<% } %>
          <% if (error === 'server_error') { %>Error al guardar la configuración. Por favor intente nuevamente.<% } %>
        </span>
      </div>
    <% } %>

    <!-- Onboarding Form Card (WHITE BACKGROUND) -->
    <div class="bg-white border border-slate-200/80 rounded-3xl p-6 md:p-10 shadow-xl shadow-slate-200/50">
      <form action="/dashboard/referido/configuracion-inicial" method="POST" class="space-y-8">

        <!-- Paso 1: Información Personal -->
        <div>
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4 mb-6">
            <div class="w-9 h-9 rounded-2xl bg-blue-50 text-[#0A3C84] font-black flex items-center justify-center border border-blue-100 text-sm shadow-sm">1</div>
            <div>
              <h2 class="text-base md:text-lg font-black text-slate-900">Información Personal</h2>
              <p class="text-xs text-slate-500 font-medium">Datos del titular de la cuenta comercial de referido</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Nombres *</label>
              <input type="text" name="nombres" value="<%= profile?.nombres || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-blue-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Ej. Juan Carlos">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Apellidos *</label>
              <input type="text" name="apellidos" value="<%= profile?.apellidos || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-blue-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Ej. Pérez Gómez">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Cédula / Pasaporte *</label>
              <input type="text" name="cedula" value="<%= profile?.cedula || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-blue-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Ej. 1723456789">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">WhatsApp / Teléfono *</label>
              <input type="text" name="whatsapp" value="<%= profile?.whatsapp || user.telefono || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-blue-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Ej. 0991234567">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Fecha de Nacimiento (Opcional)</label>
              <input type="date" name="fechaNacimiento" value="<%= profile?.fechaNacimiento ? new Date(profile.fechaNacimiento).toISOString().split('T')[0] : '' %>" class="w-full bg-slate-50 border border-slate-200 focus:border-blue-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Ciudad / Provincia *</label>
              <input type="text" name="ciudad" value="<%= profile?.ciudad || user.ciudad || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-blue-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Ej. Quito, Pichincha">
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Dirección Domiciliaria *</label>
              <input type="text" name="direccion" value="<%= profile?.direccion || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-blue-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Av. Amazonas y Colón, Edf. Ejecutivo">
            </div>
          </div>
        </div>

        <!-- Paso 2: Información Bancaria para Retiros -->
        <div>
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4 mb-6">
            <div class="w-9 h-9 rounded-2xl bg-emerald-50 text-emerald-700 font-black flex items-center justify-center border border-emerald-100 text-sm shadow-sm">2</div>
            <div>
              <h2 class="text-base md:text-lg font-black text-slate-900">Información Bancaria para Cobro de Comisiones</h2>
              <p class="text-xs text-slate-500 font-medium">Cuenta donde recibirás las transferencias directas de tus retiros</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Institución Bancaria *</label>
              <input type="text" name="banco" value="<%= profile?.banco || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Ej. Banco Pichincha">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Tipo de Cuenta *</label>
              <select name="tipoCuenta" class="w-full bg-slate-50 border border-slate-200 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm">
                <option value="Ahorros" <%= profile?.tipoCuenta === 'Ahorros' ? 'selected' : '' %>>Ahorros</option>
                <option value="Corriente" <%= profile?.tipoCuenta === 'Corriente' ? 'selected' : '' %>>Corriente</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Número de Cuenta *</label>
              <input type="text" name="numeroCuenta" value="<%= profile?.numeroCuenta || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="2200123456">
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Nombre del Titular *</label>
              <input type="text" name="titularNombre" value="<%= profile?.titularNombre || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Nombre idéntico al estado de cuenta">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Cédula/RUC del Titular *</label>
              <input type="text" name="titularCedula" value="<%= profile?.titularCedula || '' %>" required class="w-full bg-slate-50 border border-slate-200 focus:border-emerald-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="1723456789">
            </div>
          </div>
        </div>

        <!-- Paso 3: Cambio Obligatorio de Contraseña -->
        <div>
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4 mb-6">
            <div class="w-9 h-9 rounded-2xl bg-amber-50 text-amber-700 font-black flex items-center justify-center border border-amber-100 text-sm shadow-sm">3</div>
            <div>
              <h2 class="text-base md:text-lg font-black text-slate-900">Cambio Obligatorio de Contraseña</h2>
              <p class="text-xs text-slate-500 font-medium">Reemplaza tu contraseña temporal por una contraseña personal y segura</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Contraseña Temporal *</label>
              <input type="password" name="currentPassword" required class="w-full bg-slate-50 border border-slate-200 focus:border-amber-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Contraseña recibida por correo">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Nueva Contraseña *</label>
              <input type="password" name="newPassword" required minlength="6" class="w-full bg-slate-50 border border-slate-200 focus:border-amber-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Mínimo 6 caracteres">
            </div>
            <div>
              <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Confirmar Nueva Contraseña *</label>
              <input type="password" name="confirmPassword" required minlength="6" class="w-full bg-slate-50 border border-slate-200 focus:border-amber-600 focus:bg-white rounded-xl px-4 py-3 text-sm text-slate-900 font-semibold focus:outline-none transition shadow-sm" placeholder="Repite la nueva contraseña">
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-6 border-t border-slate-100 flex items-center justify-end">
          <button type="submit" class="w-full md:w-auto px-8 py-4 rounded-2xl bg-[#0A3C84] hover:bg-[#08316c] text-white font-black text-sm shadow-xl shadow-blue-900/20 transition-all cursor-pointer flex items-center justify-center gap-2.5">
            <i class="fa-solid fa-circle-check text-lg"></i>
            Guardar Configuración y Activar Cuenta
          </button>
        </div>

      </form>
    </div>

    <p class="text-center text-xs text-slate-500 font-semibold mt-6">
      © <%= new Date().getFullYear() %> Profesionales Ecuador. Todos los derechos reservados.
    </p>
  </div>

</body>
</html>
