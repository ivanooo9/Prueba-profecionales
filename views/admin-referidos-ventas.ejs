<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Revisión de Ventas de Referidos | Profesionales Ecuador</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="h-full flex flex-col bg-slate-50 text-slate-800">

  <!-- Top Admin Bar -->
  <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/dashboard/admin" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center font-black text-white text-sm">ADMIN</div>
          <span class="font-extrabold text-base tracking-tight text-white hidden sm:inline">Profesionales<span class="text-sky-400">Ecuador</span></span>
        </a>
        <span class="bg-emerald-500/20 text-emerald-300 text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full border border-emerald-500/30">Módulo Referidos</span>
      </div>

      <nav class="hidden md:flex items-center gap-1">
        <a href="/dashboard/admin/referidos" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/60 transition flex items-center gap-2">
          <i class="fa-solid fa-users-gear text-blue-400"></i> Cuentas Referidos
        </a>
        <a href="/dashboard/admin/referidos/ventas" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white bg-slate-800 border border-slate-700 flex items-center gap-2">
          <i class="fa-solid fa-file-circle-check text-emerald-400"></i> Revisar Ventas
        </a>
        <a href="/dashboard/admin/referidos/comisiones" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/60 transition flex items-center gap-2">
          <i class="fa-solid fa-percent text-sky-400"></i> Reglas Comisiones
        </a>
        <a href="/dashboard/admin/referidos/retiros" class="px-3.5 py-2 rounded-xl text-xs font-bold text-slate-300 hover:text-white hover:bg-slate-800/60 transition flex items-center gap-2">
          <i class="fa-solid fa-money-bill-transfer text-amber-400"></i> Retiros
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/dashboard/admin" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition flex items-center gap-1.5">
          <i class="fa-solid fa-arrow-left"></i> Volver a Admin
        </a>
      </div>
    </div>
  </header>

  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-150 shadow-sm">
      <div>
        <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
          <i class="fa-solid fa-file-circle-check text-emerald-600"></i> Panel de Revisión y Aprobación de Ventas
        </h1>
        <p class="text-xs text-slate-500 mt-1">Al aprobar una venta, el sistema creará/inscribirá automáticamente al cliente final y acreditará la comisión calculada en la billetera del referido.</p>
      </div>

      <!-- State Filters -->
      <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-2xl text-xs font-bold w-full sm:w-auto">
        <a href="/dashboard/admin/referidos/ventas" class="flex-1 sm:flex-none px-3.5 py-1.5 rounded-xl text-center transition <%= selectedEstado === 'TODOS' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-800' %>">Todos</a>
        <a href="/dashboard/admin/referidos/ventas?estado=PENDIENTE" class="flex-1 sm:flex-none px-3.5 py-1.5 rounded-xl text-center transition <%= selectedEstado === 'PENDIENTE' ? 'bg-amber-500 text-slate-950 shadow-sm font-extrabold' : 'text-slate-500 hover:text-slate-800' %>">Pendientes</a>
        <a href="/dashboard/admin/referidos/ventas?estado=APROBADO" class="flex-1 sm:flex-none px-3.5 py-1.5 rounded-xl text-center transition <%= selectedEstado === 'APROBADO' ? 'bg-emerald-600 text-white shadow-sm font-extrabold' : 'text-slate-500 hover:text-slate-800' %>">Aprobadas</a>
        <a href="/dashboard/admin/referidos/ventas?estado=RECHAZADO" class="flex-1 sm:flex-none px-3.5 py-1.5 rounded-xl text-center transition <%= selectedEstado === 'RECHAZADO' ? 'bg-rose-600 text-white shadow-sm font-extrabold' : 'text-slate-500 hover:text-slate-800' %>">Rechazadas</a>
      </div>
    </div>

    <!-- Feedback Alerts -->
    <% if (success === 'sale_approved') { %>
      <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 text-xs font-semibold flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-lg text-emerald-600"></i>
        <span>¡Venta aprobada exitosamente! Se ha procesado el alta del cliente, enviado su correo de acceso y acreditado la comisión a la billetera del referido.</span>
      </div>
    <% } %>
    <% if (success === 'sale_rejected') { %>
      <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 text-xs font-semibold flex items-center gap-3">
        <i class="fa-solid fa-circle-info text-lg text-rose-600"></i>
        <span>La venta ha sido rechazada y se ha notificado al referido.</span>
      </div>
    <% } %>

    <!-- Table Container -->
    <div class="bg-white rounded-3xl border border-slate-150 shadow-sm overflow-hidden">
      <% if (sales.length === 0) { %>
        <div class="text-center py-16 px-4">
          <i class="fa-solid fa-clipboard-check text-4xl text-slate-300 mb-3"></i>
          <h3 class="text-base font-bold text-slate-800">No hay ventas registradas en esta categoría</h3>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs divide-y divide-slate-100">
            <thead class="bg-slate-50 text-slate-400 uppercase text-[10px] tracking-wider font-bold">
              <tr>
                <th class="p-4">Venta ID / Fecha</th>
                <th class="p-4">Referido (Vendedor)</th>
                <th class="p-4">Cliente Final</th>
                <th class="p-4">Producto Adquirido</th>
                <th class="p-4">Valor / Comisión</th>
                <th class="p-4">Comprobante</th>
                <th class="p-4 text-center">Estado</th>
                <th class="p-4 text-center">Acción Admin</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% sales.forEach(function(sale) { %>
                <tr class="hover:bg-slate-50/60 transition">
                  <td class="p-4">
                    <p class="font-black text-slate-900">#<%= sale.id %></p>
                    <p class="text-[10px] text-slate-400"><%= new Date(sale.createdAt).toLocaleDateString('es-EC') %></p>
                  </td>
                  <td class="p-4">
                    <p class="font-bold text-slate-900"><%= sale.referral.nombres ? (sale.referral.nombres + ' ' + (sale.referral.apellidos || '')) : sale.referral.user.name %></p>
                    <p class="text-[10px] text-blue-600 font-semibold"><%= sale.referral.user.email %></p>
                  </td>
                  <td class="p-4">
                    <p class="font-bold text-slate-800"><%= sale.clienteNombre %></p>
                    <p class="text-[10px] text-slate-500"><%= sale.clienteEmail %></p>
                    <p class="text-[10px] text-slate-400">CI: <%= sale.clienteCedula %> | Tel: <%= sale.clienteTelefono %></p>
                  </td>
                  <td class="p-4">
                    <p class="font-bold text-slate-900"><%= sale.productName %></p>
                    <span class="text-[9px] font-black uppercase text-blue-600 bg-blue-50 px-2 py-0.5 rounded"><%= sale.productType %></span>
                  </td>
                  <td class="p-4">
                    <p class="font-black text-slate-900 text-sm">$<%= sale.valorPagado.toFixed(2) %></p>
                    <p class="font-black text-emerald-600 text-xs">Comisión: $<%= sale.comisionCalculada.toFixed(2) %> (<%= sale.comisionPorcentaje %>%)</p>
                  </td>
                  <td class="p-4">
                    <a href="<%= sale.comprobanteUrl %>" target="_blank" class="inline-flex items-center gap-1 text-[11px] font-bold text-blue-600 hover:text-blue-700 bg-blue-50 px-2.5 py-1 rounded-lg">
                      <i class="fa-solid fa-file-invoice text-xs"></i> Ver Adjunto
                    </a>
                  </td>
                  <td class="p-4 text-center">
                    <% if (sale.estado === 'APROBADO') { %>
                      <span class="bg-emerald-100 text-emerald-800 text-[10px] font-black px-3 py-1 rounded-full">Aprobado</span>
                    <% } else if (sale.estado === 'PENDIENTE') { %>
                      <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-3 py-1 rounded-full">Pendiente</span>
                    <% } else { %>
                      <span class="bg-rose-100 text-rose-800 text-[10px] font-black px-3 py-1 rounded-full">Rechazado</span>
                    <% } %>
                  </td>
                  <td class="p-4 text-center">
                    <% if (sale.estado !== 'APROBADO') { %>
                      <div class="flex items-center justify-center gap-1.5">
                        <form action="/dashboard/admin/referidos/ventas/<%= sale.id %>/aprobar" method="POST" class="inline" onsubmit="event.preventDefault(); abrirConfirmacionModal({ title: 'Aprobar Venta de Referido', message: '¿Aprobar venta #<%= sale.id %>? Esto dará de alta al cliente y acreditará la comisión de $<%= sale.comisionCalculada.toFixed(2) %> al referido.', icon: 'fa-solid fa-circle-check text-emerald-600 text-lg', btnText: 'Aprobar Venta', btnClass: 'px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5', form: this });">
                          <button type="submit" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-[10px] font-black shadow-sm transition">
                            <i class="fa-solid fa-check"></i> Aprobar
                          </button>
                        </form>
                        <% if (sale.estado !== 'RECHAZADO') { %>
                          <button onclick="openRejectModal(<%= sale.id %>)" class="px-3 py-1.5 bg-rose-50 text-rose-700 hover:bg-rose-100 rounded-lg text-[10px] font-bold transition">
                            <i class="fa-solid fa-xmark"></i> Rechazar
                          </button>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span class="text-[10px] text-slate-400 font-semibold">Procesada</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </main>

  <!-- Modal Rechazar Venta -->
  <div id="modalRechazar" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 relative shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
        <h3 class="text-base font-black text-rose-600 flex items-center gap-2">
          <i class="fa-solid fa-circle-xmark"></i> Rechazar Registro de Venta
        </h3>
        <button onclick="closeRejectModal()" class="text-slate-400 text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="formRechazar" action="" method="POST" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 uppercase mb-1">Motivo / Observaciones del Rechazo *</label>
          <textarea name="observacionesAdmin" required rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 font-medium text-slate-900 focus:outline-none" placeholder="Ej. El comprobante adjunto es ilegible o el valor depositado no coincide."></textarea>
        </div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
          <button type="button" onclick="closeRejectModal()" class="px-4 py-2 rounded-xl bg-slate-100 font-bold">Cancelar</button>
          <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-extrabold shadow-md">Confirmar Rechazo</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de Confirmación Elegante del Sistema -->
  <div id="modalConfirmacionSistema" class="fixed inset-0 z-[100] bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-7 relative shadow-2xl space-y-4 animate-in fade-in zoom-in-95 duration-200 border border-slate-100">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
          <i id="sysConfirmIcon" class="fa-solid fa-circle-question text-blue-600 text-lg"></i>
          <span id="sysConfirmTitle">Confirmación de Acción</span>
        </h3>
        <button type="button" onclick="closeSysConfirmModal()" class="text-slate-400 text-lg hover:text-slate-600 cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <p id="sysConfirmMessage" class="text-xs text-slate-600 leading-relaxed font-semibold"></p>

      <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
        <button type="button" onclick="closeSysConfirmModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs cursor-pointer transition">
          Cancelar
        </button>
        <button type="button" id="sysConfirmSubmitBtn" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5">
          <i class="fa-solid fa-check"></i> <span id="sysConfirmBtnText">Confirmar</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    let activeConfirmForm = null;

    function abrirConfirmacionModal(options) {
      document.getElementById('sysConfirmTitle').innerText = options.title || 'Confirmar Acción';
      document.getElementById('sysConfirmMessage').innerText = options.message || '¿Deseas proceder con esta acción?';
      document.getElementById('sysConfirmIcon').className = options.icon || 'fa-solid fa-circle-question text-blue-600 text-lg';
      document.getElementById('sysConfirmBtnText').innerText = options.btnText || 'Confirmar';
      
      const submitBtn = document.getElementById('sysConfirmSubmitBtn');
      submitBtn.className = options.btnClass || 'px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs shadow-md transition cursor-pointer flex items-center gap-1.5';
      
      activeConfirmForm = options.form || null;

      const modal = document.getElementById('modalConfirmacionSistema');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeSysConfirmModal() {
      const modal = document.getElementById('modalConfirmacionSistema');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      activeConfirmForm = null;
    }

    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('sysConfirmSubmitBtn')?.addEventListener('click', function() {
        if (activeConfirmForm) {
          const f = activeConfirmForm;
          activeConfirmForm = null;
          closeSysConfirmModal();
          f.submit();
        }
      });
    });

    function openRejectModal(saleId) {
      document.getElementById('formRechazar').action = '/dashboard/admin/referidos/ventas/' + saleId + '/rechazar';
      document.getElementById('modalRechazar').classList.remove('hidden');
      document.getElementById('modalRechazar').classList.add('flex');
    }
    function closeRejectModal() {
      document.getElementById('modalRechazar').classList.add('hidden');
      document.getElementById('modalRechazar').classList.remove('flex');
    }
  </script>

</body>
</html>
