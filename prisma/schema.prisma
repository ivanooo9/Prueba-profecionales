}

// =============================================================
// MÓDULO DE REFERIDOS & COMISIONES
// =============================================================

enum ReferralAccountStatus {
  PENDING_CONFIG
  ACTIVE
  SUSPENDED
}

enum ReferralSaleStatus {
  PENDIENTE
  EN_REVISION
  APROBADO
  RECHAZADO
}

enum WithdrawalStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  PAGADO
}

enum ProductType {
  CONVERSATORIO
  CURSO
  PLAN_AFILIACION
  PLAN_PROMOCION
}

model ReferralProfile {
  id          Int                   @id @default(autoincrement())
  userId      Int                   @unique
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ReferralAccountStatus @default(PENDING_CONFIG)
  activatedAt DateTime?

  // Datos Personales
  nombres         String?
  apellidos       String?
  cedula          String?
  fechaNacimiento DateTime?
  whatsapp        String?
  direccion       String?
  ciudad          String?
  provincia       String?
  pais            String?   @default("Ecuador")

  // Datos Bancarios
  banco         String?
  tipoCuenta    String?
  numeroCuenta  String?
  titularNombre String?
  titularCedula String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales       ReferralSale[]
  wallet      ReferralWallet?
  withdrawals ReferralWithdrawal[]
  auditLogs   ReferralAuditLog[]
}

model ReferralSale {
  id         Int             @id @default(autoincrement())
  referralId Int
  referral   ReferralProfile @relation(fields: [referralId], references: [id], onDelete: Cascade)

  // Cliente Final
  clienteNombre   String
  clienteCedula   String
  clienteEmail    String
  clienteTelefono String

  // Producto Comercializado
  productType    ProductType
  productId      Int?
  productName    String
  valorPagado    Float
  comprobanteUrl String

  // Liquidación de Comisión
  comisionCalculada  Float @default(0.0)
  comisionPorcentaje Float @default(0.0)

  // Estado y Auditoría
  estado             ReferralSaleStatus @default(PENDIENTE)
  observacionesAdmin String?
  aprobadoAt         DateTime?
  aprobadoPorId      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletTransactions ReferralWalletTransaction[]

  @@index([referralId, estado])
}

model ReferralWallet {
  id         Int             @id @default(autoincrement())
  referralId Int             @unique
  referral   ReferralProfile @relation(fields: [referralId], references: [id], onDelete: Cascade)

  saldoPendiente  Float @default(0.0)
  saldoDisponible Float @default(0.0)
  saldoRetirado   Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions ReferralWalletTransaction[]
}

model ReferralWalletTransaction {
  id       Int            @id @default(autoincrement())
  walletId Int
  wallet   ReferralWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  tipo     String // ACREDITACION_VENTA, DEBITO_RETIRO, REINTEGRO_RETIRO, AJUSTE_ADMIN
  monto    Float
  concepto String

  referralSaleId Int?
  referralSale   ReferralSale? @relation(fields: [referralSaleId], references: [id], onDelete: SetNull)

  withdrawalId Int?
  withdrawal   ReferralWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model ReferralWithdrawal {
  id         Int             @id @default(autoincrement())
  referralId Int
  referral   ReferralProfile @relation(fields: [referralId], references: [id], onDelete: Cascade)

  monto                 Float
  banco                 String
  tipoCuenta            String
  numeroCuenta          String
  titularNombre         String
  titularCedula         String
  observacionesReferido String?
  observacionesAdmin    String?
  comprobantePagoUrl    String?

  estado    WithdrawalStatus @default(PENDIENTE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  walletTransactions ReferralWalletTransaction[]

  @@index([referralId, estado])
}

model CommissionConfig {
  id          Int          @id @default(autoincrement())
  isGeneral   Boolean      @default(false)
  productType ProductType?
  productId   Int?
  porcentaje  Float
  isActive    Boolean      @default(true)
  startDate   DateTime?
  endDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isGeneral, productType, productId, isActive])
}

model ReferralAuditLog {
  id         Int              @id @default(autoincrement())
  referralId Int?
  referral   ReferralProfile? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  actorId    Int?
  accion     String
  detalle    String
  createdAt  DateTime         @default(now())
}

// =============================================================
// MÓDULO DE ESTUDIANTES & TRANSICIÓN DE ROLES
// =============================================================

model University {
