  slug                 String?     @unique
  cardPublicToken      String?     @unique
  universityId         Int?
  university           University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  institucionEducativa String // Universidad o Instituto Superior
  carrera              String // Carrera o Área de Estudio
  estadoCarrera        String      @default("EN_CURSO") // EN_CURSO, EGRESADO
  carnetEstudiante     String?
  bio                  String?
  foto                 String? // Base64 o URL
  banner               String? // Base64 o URL
  provincia            String?
  ciudad               String?
  telefono             String?
  linkedinUrl          String?
  githubUrl            String?
  instagramUrl         String?
  facebookUrl          String?
  twitterUrl           String?
  websiteUrl           String?
  tiktokUrl            String?
