datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// MODELOS EXISTENTES DE FACTURACIÓN (COMPATIBLES CON COMERCIO)
// -------------------------------------------------------------

model Issuer {
  id                   Int     @id @default(autoincrement())
  ruc                  String  @unique
  nombres              String
  apellidos            String
  nombreEmpresa        String
  razonSocial          String
  direccion            String
  email                String
  celular              String
  establecimiento      String  @default("001")
  puntoEmision         String  @default("001")
  obligadoContabilidad Boolean @default(false)
  regimen              String  @default("REGIMEN GENERAL")
  ambiente             Int     @default(1) // 1 = Pruebas, 2 = Producción
  firmaElectronica     String? // Ruta al archivo .p12 o codificado en Base64
  codigoSri            String? // Contraseña de la firma .p12
  startSecuencial      String  @default("000000001")

  // Nuevos campos comerciales SaaS
  password         String   @default("123456")
  status           String   @default("ACTIVE") // ACTIVE, SUSPENDED
  planType         String   @default("MONTHLY") // MONTHLY, PAY_PER_INVOICE
  monthlyFee       Float    @default(15.0)
  balance          Float    @default(5.0)
  subscriptionEnds DateTime @default(now())
  logo             String? // Logo de la empresa en Base64

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  invoices        Invoice[]
  paymentRequests PaymentRequest[]

  // Relación con el perfil del profesional (si es emisor independiente)
  professionalProfileId Int?                 @unique
  professionalProfile   ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: SetNull)
}

model SystemConfig {
  id               Int     @id @default(1)
  adminPassword    String  @default("admin1234")
  adminWhatsapp    String  @default("593999999999")
  bankAccounts     String  @default("Banco Pichincha - Ahorros: 2200123456 (Beneficiario: Profesionales Ecuador)\nBanco Guayaquil - Corriente: 10293847 (Beneficiario: Profesionales Ecuador)")
  defaultBalance   Float   @default(5.0)
  systemName       String  @default("Profesionales Ecuador")
  adminEmail       String?
  systemLogo       String? // Logo en formato Base64
  loginLogo        String? // Logo exclusivo para el login y creación de cuenta
  loginTitle       String  @default("Profesionales Ecuador / LATAM")
  loginSubtitle    String  @default("El directorio profesional más grande de Ecuador y Latinoamérica.")
  payphoneToken    String? // API Key / Token de Payphone
  payphoneStoreId  String? // StoreId de la aplicación PayPhone
  taxRate          Float   @default(0) // Porcentaje de IVA/Tax (ej: 15 para 15%)
  kushkiPublicKey  String?
  kushkiPrivateKey String?

  metaDescription    String  @default("Directorio profesional, agendamiento de citas, educación continua y facturación electrónica.")
  metaIcon           String? // Favicon
  googleVerification String?

  // Personalización del Sitio
  footerLogo        String? // Logo del footer en formato Base64
  primaryColor      String  @default("#0A3C84")
  secondaryColor    String  @default("#0a66c2")
  fontFamily        String  @default("Outfit")
  headingFontFamily String  @default("Outfit")
  facebookUrl       String?
  instagramUrl      String?
  youtubeUrl        String?
  tiktokUrl         String?
  linkedinUrl       String?

  // Credenciales externas (Cloudinary & Resend)
  cloudinaryCloudName String?
  cloudinaryApiKey    String?
  cloudinaryApiSecret String?
  resendApiKey        String?
  resendFromEmail     String?

  // Configuración SMTP Tradicional (Fallback / Alternativa a Resend)
  smtpHost   String?
  smtpPort   Int?    @default(587)
  smtpUser   String?
  smtpPass   String?
  smtpSecure Boolean @default(false)

  // Configuración Gemini
  geminiApiKey        String?
  geminiProjectName   String?
  geminiProjectNumber String?

  // Configuración Educación & Ponencias
  tiempoMinimoPonenciaMinutos Int @default(3)

  // Configuración Facturación Electrónica SRI (Límites por defecto)
  freeInvoiceLimit    Int @default(5)
  premiumInvoiceLimit Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id                 Int       @id @default(autoincrement())
  nombres            String
  tipoIdentificacion String // "04" (RUC), "05" (Cédula), "06" (Pasaporte), "07" (Consumidor Final)
  identificacion     String    @unique
  direccion          String
  mail               String
  celular            String
  telefono           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  invoices           Invoice[]
}

model Product {
  id               Int                  @id @default(autoincrement())
  profileId        Int?
  profile          ProfessionalProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  nombre           String
  codigoPrincipal  String
  codigoAuxiliar   String?
  descripcion      String?
  precio           Float
  iva              Float                @default(15.0)
  imagen           String?
  defaultCantidad  Float                @default(1.0)
  defaultDescuento Float                @default(0.0)
  defaultNota1     String?
  defaultNota2     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  invoiceItems     InvoiceItem[]

  @@unique([profileId, codigoPrincipal])
}

model Invoice {
  id            Int      @id @default(autoincrement())
  secuencial    String
  claveAcceso   String?  @unique
  xmlNoFirmado  String?
  xmlAutorizado String?
  pdfRIDE       String?
  estado        String   @default("CREADA") // CREADA, FIRMADA, RECIBIDA, AUTORIZADA, DEVUELTA, RECHAZADA
  fechaEmision  DateTime
  tipoAmbiente  Int      @default(1)
  subtotal0     Float    @default(0.0)
  subtotalIva   Float    @default(0.0)
  valorIva      Float    @default(0.0)
  total         Float
  formaPago     String   @default("01")
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clientId Int
  client   Client        @relation(fields: [clientId], references: [id])
  issuerId Int
  issuer   Issuer        @relation(fields: [issuerId], references: [id])
  items    InvoiceItem[]
}

model InvoiceItem {
  id             Int      @id @default(autoincrement())
  cantidad       Float
  precioUnitario Float
  descuento      Float    @default(0.0)
  total          Float
  notaExtra1     String?
  notaExtra2     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model BankAccount {
  id              Int       @id @default(autoincrement())
  type            String
  institution     String
  accountType     String?
  accountNumber   String?
  taxId           String?
  beneficiaryName String?
  qrImageUrl      String?
  qrImagePublicId String?
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  paymentRequests PaymentRequest[]

  @@index([isActive, deletedAt])
}

model PaymentRequest {
  id                           Int       @id @default(autoincrement())
  ruc                          String
  razonSocial                  String
  monto                        Float
  tipo                         String // "TOPUP", "MEMBERSHIP", "CERTIFICATE", "PROMOTION"
  referencia                   String
  bancoDestino                 String
  comprobante                  String? // Capture / Proof of payment in Base64 or URL
  estado                       String    @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  fechaSolicitud               DateTime  @default(now())
  fechaProcesado               DateTime?
  bankAccountId                Int?
  bankAccountSnapshot          Json?
  bankAccountLabel             String?
  staleAdminEmailLastAttemptAt DateTime?
  staleAdminEmailSentAt        DateTime?

  issuerId Int?
  issuer   Issuer? @relation(fields: [issuerId], references: [id], onDelete: Cascade)

  certificateId Int?
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  promotionId Int?
  promotion   ProfessionalPromotion? @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([bankAccountId])
  @@index([estado, fechaSolicitud])
  @@index([staleAdminEmailSentAt, staleAdminEmailLastAttemptAt])
}

// -------------------------------------------------------------
// MODELOS DE USUARIOS, PERFILES Y SAAS PROFESIONALES
// -------------------------------------------------------------

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String
  name                String
  status              String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  nombreCertificado   String?
  lastCertNameUpdate  DateTime?
  telefono            String?
  ciudad              String?
  requireProfileSetup Boolean   @default(false)
  setupRedirectUrl    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Roles y Permisos
  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  // Relaciones
  professionalProfile           ProfessionalProfile?
  studentProfile                StudentProfile?
  roleTransitionRequests        RoleTransitionRequest[]
  appointments                  Appointment[]
  certificates                  CursoCertificate[]
  acquiredCertificates          Certificate[]
  enrollments                   EventEnrollment[]
  auditLogs                     AuditLog[]
  cursoSubmissions              CursoSubmission[]
  eventAccessLogs               EventAccessLog[]
  payPhoneTransactions          PayPhoneTransaction[]
  sessions                      UserSession[]
  referralProfile               ReferralProfile?
  conversatorioQas              ConversatorioQuestionAnswer[]
  cursoOrders                   CursoOrder[]
  organizationMemberships       OrganizationMember[]
  dentalExecutions              DentalTreatmentExecution[]    @relation("DentalExecutions")
  issuedDentalPrescriptions     DentalPrescription[]          @relation("DentalPrescriptionsIssued")
  uploadedDentalDocuments       DentalDocument[]              @relation("DentalDocumentsUploaded")
  dentalAppointmentsAssigned    DentalAppointment[]           @relation("DentalAppointmentsAssigned")
  issuedDentalConsents          DentalConsent[]               @relation("DentalConsentsIssued")
  legalCasesResponsible         LegalCase[]                   @relation("LegalCasesResponsible")
  legalCasesClosed              LegalCase[]                   @relation("LegalCasesClosed")
  legalCasesArchived            LegalCase[]                   @relation("LegalCasesArchived")
  legalCaseActivitiesCreated    LegalCaseActivity[]           @relation("LegalCaseActivitiesCreated")
  legalTasksAssigned            LegalTask[]                   @relation("LegalTasksAssigned")
  legalDeadlinesResponsible     LegalDeadline[]               @relation("LegalDeadlinesResponsible")
  legalHearingsResponsible      LegalHearing[]                @relation("LegalHearingsResponsible")
  legalDocumentsCreated         LegalDocument[]               @relation("LegalDocumentsCreated")
  legalDocumentVersionsUploaded LegalDocumentVersion[]        @relation("LegalDocumentVersionsUploaded")
  legalFeeAgreementsCreated     LegalFeeAgreement[]           @relation("LegalFeeAgreementsCreated")
  legalPaymentsRegistered       LegalPayment[]                @relation("LegalPaymentsRegistered")
  legalRemindersTarget          LegalReminder[]               @relation("LegalRemindersTargetUser")
  legalRemindersCreated         LegalReminder[]               @relation("LegalRemindersCreatedBy")
  legalNotifications            LegalNotification[]           @relation("LegalNotificationsUser")
  architectureClientsCreated       ArchitectureClient[]          @relation("ArchitectureClientsCreated")
  architectureProjectsLead         ArchitectureProject[]         @relation("ArchitectureProjectsLead")
  architectureProjectsCreated      ArchitectureProject[]         @relation("ArchitectureProjectsCreated")
  architectureProjectsArchived     ArchitectureProject[]         @relation("ArchitectureProjectsArchived")
  architectureTasksAssigned        ArchitectureTask[]            @relation("ArchitectureTasksAssigned")
  architectureTasksCreated         ArchitectureTask[]            @relation("ArchitectureTasksCreated")
  architectureDeliverablesAssigned ArchitectureDeliverable[]     @relation("ArchitectureDeliverablesAssigned")
  architectureDeliverablesCreated  ArchitectureDeliverable[]     @relation("ArchitectureDeliverablesCreated")
  architectureMeetingsLead         ArchitectureMeeting[]         @relation("ArchitectureMeetingsLead")
  architectureMeetingsCreated      ArchitectureMeeting[]         @relation("ArchitectureMeetingsCreated")
  architectureDocumentsCreated    ArchitectureDocument[]        @relation("ArchitectureDocumentsCreated")
  architectureDocVersionsUploaded ArchitectureDocumentVersion[] @relation("ArchitectureDocVersionsUploaded")
  architectureBudgetsCreated       ArchitectureBudget[]          @relation("ArchitectureBudgetsCreated")
  architectureBudgetsApproved      ArchitectureBudget[]          @relation("ArchitectureBudgetsApproved")

  // Profesores / Gestión Académica (TEACHING - Fase 1, Fase 2 y Fase 3)
  academicCoursesTaught            AcademicCourse[]              @relation("AcademicCourseTutorUser")
  academicSubjectsTaught           AcademicSubject[]             @relation("AcademicSubjectTeacherUser")
  academicClassSessionsTaught      AcademicClassSession[]        @relation("AcademicClassSessionTeacherUser")
  academicActivitiesTaught         AcademicActivity[]            @relation("AcademicActivityTeacherUser")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  userId           Int
  tokenId          String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  lastSeenAt       DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt, createdAt])
  @@index([tokenId, userId])
}

model PayPhoneTransaction {
  id                  Int      @id @default(autoincrement())
  paymentId           String? // ID que devuelve PayPhone al preparar
  clientTransactionId String   @unique // UUID generado por nosotros
  status              String   @default("PENDING") // PENDING, APPROVED, CANCELLED
  statusCode          Int? // 1=Pendiente, 2=Cancelado, 3=Aprobado
  amount              Int // Total en centavos
  amountWithoutTax    Int      @default(0)
  amountWithTax       Int      @default(0)
  tax                 Int      @default(0)
  currency            String   @default("USD")
  reference           String // Descripción del pago
  userId              Int
  user                User     @relation(fields: [userId], references: [id])
  itemType            String // Tipo de item: COURSE, CERTIFICATE, MEMBERSHIP, CONVERSATORIO, etc.
  itemId              Int // ID del item comprado
  metadata            Json? // Datos adicionales del item
  payphoneResponse    Json? // Respuesta completa de confirmación
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // ADMIN, PROFESSIONAL, CLIENT
  description String?
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ProfessionalProfile {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String? @unique
  cardPublicToken String? @unique

  // Datos del perfil profesional
  bio       String?
  slogan    String?
  photo     String? // Base64 o URL de foto de perfil
  banner    String? // Base64 o URL de banner/portada
  provincia String?
  ciudad    String?
  direccion String?
  latitud   Float?
  longitud  Float?

  // Nuevos campos de verificación y localización
  cedula          String? @unique
  telefono        String?
  tarifa          Float   @default(0.0)
  callePrincipal  String?
  referencia      String?
  cedulaFrontal   String? // Base64 documento frontal
  cedulaPosterior String? // Base64 documento posterior

  // Redes Sociales
  facebook  String?
  instagram String?
  xTwitter  String?
  linkedin  String?
  tiktok    String?
  youtube   String?
  website   String?
  whatsapp  String?

  status           String   @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  verified         Boolean  @default(false) // Insignia verificada
  planType         String   @default("GRATUITO") // GRATUITO, PROFESIONAL, PREMIUM, VERIFICADO
  subscriptionEnds DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateId Int?
  template   ProfileTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Relaciones
  specialties         ProfessionalProfileSpecialty[]
  services            ProfessionalService[]
  schedules           ProfessionalSchedule[]
  articles            Article[]
  conversatorios      Conversatorio[]
  cursos              Curso[]                        @relation("ProfileCursos")
  docenteCursos       Curso[]                        @relation("DocenteCursos")
  appointments        Appointment[]
  issuer              Issuer?
  products            Product[]
  promotions          ProfessionalPromotion[]
  education           ProfessionalEducation[]
  professionalId      ProfessionalId?
  // Perfil y Billetera Docente (Academia)
  isDocenteActive     Boolean                        @default(false)
  docenteBio          String?
  docenteEspecialidad String?
  banco               String?
  tipoCuenta          String?
  numeroCuenta        String?
  titularNombre       String?
  titularCedula       String?

  docenteWallet      DocenteWallet?
  docenteWithdrawals DocenteWithdrawal[]
  docenteOrders      CursoOrder[]        @relation("DocenteOrders")

  // Ponente & Facturación Electrónica
  isPonente            Boolean               @default(false)
  billingSubscriptions BillingSubscription[]
}

// -------------------------------------------------------------
// MODELOS DE PLANES DE FACTURACIÓN ELECTRÓNICA
// -------------------------------------------------------------

model BillingPlan {
  id           Int      @id @default(autoincrement())
  nombre       String   @unique
  descripcion  String?
  precio       Float    @default(0.0)
  invoiceLimit Int      @default(20) // -1 = Ilimitado, >0 = Cantidad de facturas
  duracionDias Int      @default(30) // Duración en días
  duracionTipo String   @default("MENSUAL") // MENSUAL, ANUAL, PERSONALIZADO
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions BillingSubscription[]
}

model BillingSubscription {
  id           Int                 @id @default(autoincrement())
  profileId    Int
  profile      ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  planId       Int
  plan         BillingPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  startDate    DateTime            @default(now())
  endDate      DateTime
  invoicesUsed Int                 @default(0)
  status       String              @default("ACTIVO") // ACTIVO, EXPIRADO, CANCELADO
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([profileId, status])
}

model Profession {
  id              Int             @id @default(autoincrement())
  nombre          String          @unique
  descripcion     String?
  icono           String?
  imagen          String?
  orden           Int             @default(0)
  specialties     Specialty[]
  cursoCategories CursoCategory[]
  cursos          Curso[]
}

model Specialty {
  id              Int             @id @default(autoincrement())
  professionId    Int
  profession      Profession      @relation(fields: [professionId], references: [id], onDelete: Cascade)
  nombre          String
  descripcion     String?
  imagen          String?
  orden           Int             @default(0)
  cursoCategories CursoCategory[]
  cursos          Curso[]

  profiles ProfessionalProfileSpecialty[]

  @@unique([professionId, nombre])
}

model ProfessionalProfileSpecialty {
  profileId   Int
  profile     ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  specialtyId Int
  specialty   Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([profileId, specialtyId])
}

model ProfessionalService {
  id          Int                 @id @default(autoincrement())
  profileId   Int
  profile     ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  precio      Float?
  imagen      String?
  estado      String              @default("ACTIVO") // ACTIVO, INACTIVO
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProfessionalSchedule {
  id         Int                 @id @default(autoincrement())
  profileId  Int
  profile    ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dia        String // LUNES, MARTES, MIERCOLES, JUEVES, VIERNES, SABADO, DOMINGO
  horaInicio String // Ej: "08:00"
  horaFin    String // Ej: "12:00"
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model Conversatorio {
  id                          Int                  @id @default(autoincrement())
  slug                        String?              @unique
  profileId                   Int?
  profile                     ProfessionalProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  estado                      String               @default("ACTIVO") // ACTIVO, FINALIZADO
  slogan                      String?
  titulo                      String
  areaProfesional             String?
  descripcion                 String?
  fechaInicio                 DateTime
  fechaFin                    DateTime
  horaInicio                  String
  horaFin                     String
  precio                      Float                @default(0.0)
  descuentoEstudianteUsd      Float                @default(0.0)
  gratuito                    Boolean              @default(true)
  permitirCertificadoGratuito Boolean              @default(false)
  certificadoInmediato        Boolean              @default(false)
  porcentajeMinimoCertificado Int                  @default(100)
  capacidad                   Int?
  capacidadIlimitada          Boolean              @default(true)
  usarTiempoMinimoPonencia    Boolean              @default(false)
  tiempoMinimoPonenciaMinutos Int?

  // Geolocalización
  provincia String?
  ciudad    String?
  latitud   Float?
  longitud  Float?
  direccion String?

  // Revista & Multimedia
  revistaPdf      String? // Ruta al PDF
  revistaFlipbook String? // Link interactivo
  revistaPortada  String? // Portada
  banner          String?
  galeria         String? // URLs separadas por comas o JSON
  youtube         String?
  bunnyVideoId    String?
  destacado       Boolean @default(false)
  usePecConvenios Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  itinerary            ConversatorioItinerary[]
  speakers             ConversatorioSpeaker[]
  certificateDesign    CertificateDesign?
  acquiredCertificates Certificate[]
  enrollments          EventEnrollment[]
  accessLogs           EventAccessLog[]
  qas                  ConversatorioQuestionAnswer[]
  agreements           Agreement[]
}

model ConversatorioItinerary {
  id              Int           @id @default(autoincrement())
  conversatorioId Int
  conversatorio   Conversatorio @relation(fields: [conversatorioId], references: [id], onDelete: Cascade)
  nombre          String
  fecha           DateTime
  horaInicio      String
  horaFin         String
  orden           Int           @default(0)
}

model ConversatorioSpeaker {
  id              Int                            @id @default(autoincrement())
  slug            String?
  conversatorioId Int
  conversatorio   Conversatorio                  @relation(fields: [conversatorioId], references: [id], onDelete: Cascade)
  foto            String?
  nombre          String
  profesion       String?
  horario         String?
  slogan          String?
  tema            String?
  descripcion     String?
  redes           String? // JSON de redes sociales
  dayIndex        Int? // Index of the itinerary day this speaker belongs to
  videoUrl        String? // URL de grabación de la ponencia (YouTube)
  bunnyVideoId    String? // Bunny Stream Video ID
  gratuita        Boolean                        @default(false)
  accessLogs      EventAccessLog[]
  resources       ConversatorioSpeakerResource[]
  qas             ConversatorioQuestionAnswer[]
}

model ConversatorioSpeakerResource {
  id        Int                  @id @default(autoincrement())
  speakerId Int
  speaker   ConversatorioSpeaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  nombre    String
  url       String
  tipo      String?
  tamano    Int?
  createdAt DateTime             @default(now())

  @@index([speakerId])
}

model ConversatorioQuestionAnswer {
  id              Int                   @id @default(autoincrement())
  conversatorioId Int
  conversatorio   Conversatorio         @relation(fields: [conversatorioId], references: [id], onDelete: Cascade)
  speakerId       Int?
  speaker         ConversatorioSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  userId          Int?
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  pregunta  String
  respuesta String?
  estado    String   @default("PENDIENTE")
  destacado Boolean  @default(false)
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversatorioId])
  @@index([speakerId])
  @@index([userId])
  @@index([estado])
  @@index([conversatorioId, orden])
}

model Curso {
  id                          Int                  @id @default(autoincrement())
  slug                        String?              @unique
  profileId                   Int?
  profile                     ProfessionalProfile? @relation("ProfileCursos", fields: [profileId], references: [id], onDelete: SetNull)
  estado                      String               @default("ACTIVO") // ACTIVO, FINALIZADO
  slogan                      String?
  titulo                      String
  areaProfesional             String?
  descripcion                 String?
  fechaInicio                 DateTime
  fechaFin                    DateTime
  horaInicio                  String
  horaFin                     String
  precio                      Float                @default(0.0)
  descuentoEstudianteUsd      Float                @default(0.0)
  gratuito                    Boolean              @default(true)
  certificadoInmediato        Boolean              @default(false)
  porcentajeMinimoCertificado Int                  @default(100)
  capacidad                   Int?
  capacidadIlimitada          Boolean              @default(true)
  usarTiempoMinimoPonencia    Boolean              @default(false)
  tiempoMinimoPonenciaMinutos Int?

  // Geolocalización
  provincia String?
  ciudad    String?
  latitud   Float?
  longitud  Float?
  direccion String?

  // Revista & Multimedia
  revistaPdf      String?
  revistaFlipbook String?
  revistaPortada  String?
  banner          String?
  galeria         String?
  youtube         String?
  bunnyVideoId    String?
  destacado       Boolean @default(false)

  // New media and includes configurations
  mediaType    String  @default("imagen") // imagen, video
  mediaUrl     String?
  includesJson String? // JSON array of strings

  // Categorización de Cursos (Profesión, Especialidad, Categoría, Rama de Enseñanza y Palabras Clave)
  professionId Int?
  profession   Profession?          @relation(fields: [professionId], references: [id], onDelete: SetNull)
  specialtyId  Int?
  specialty    Specialty?           @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  categoryId   Int?
  category     CursoCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branchId     Int?
  branch       CursoBranch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  keywords     String?
  // Relación con Docente (Profesional creador)
  docenteId    Int?
  docente      ProfessionalProfile? @relation("DocenteCursos", fields: [docenteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  itinerary            CursoItinerary[]
  speakers             CursoSpeaker[]
  modules              CursoModule[]
  certificates         CursoCertificate[]
  certificateDesign    CertificateDesign?
  acquiredCertificates Certificate[]
  enrollments          EventEnrollment[]
  discounts            CursoDiscount[]
  accessLogs           EventAccessLog[]
  orders               CursoOrder[]
}

model CursoCategory {
  id           Int         @id @default(autoincrement())
  nombre       String
  descripcion  String?
  icono        String?
  professionId Int?
  profession   Profession? @relation(fields: [professionId], references: [id], onDelete: SetNull)
