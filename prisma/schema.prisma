  nombre    String   @unique
  siglas    String?
  tipo      String   @default("UNIVERSIDAD") // UNIVERSIDAD, INSTITUTO_SUPERIOR
  provincia String?
  ciudad    String?
  logo      String?
  sitioWeb  String?
  activo    Boolean  @default(true)
  orden     Int      @default(0)
